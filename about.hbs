<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>lkjscript third-party licenses</title>
</head>
<body>
  <main>
    <h1>lkjscript third-party licenses</h1>
    <p>This file lists licenses discovered in the exact locked production dependency closure for the supported release target. It is generated evidence, not legal advice.</p>
    <h2>License overview</h2>
    <ul>
    {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
    </ul>
    <h2>License texts and packages</h2>
    {{#each licenses}}
      {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
      <section>
        <h4>{{name}}</h4>
        <p>Used by:</p>
        <ul>
        {{#each used_by}}
          <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </section>
    {{/each}}
  </main>
</body>
</html>

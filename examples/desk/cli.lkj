//! Ordinary command arguments and named environment values, with no World authority.
use super::store::{self, Row};
use super::arguments::{option, present, words, durability};
const HELP: &str = "desk: the owner's and the agents' shared notebook.\n\n  desk note TEXT [--from NAME] [--stdin] [--durability=sync|buffered] [--timings]\n  desk ask TEXT [--options A,B,C] [--from NAME] [--stdin] [--durability=sync|buffered]\n  desk close ID [--from NAME] [--durability=sync|buffered]\n  desk inbox [--peek]\n  desk path\n  desk listen-begin\n  desk listen-end\n\nDESK_STATE must name the granted, existing state directory. TZ defaults to UTC.\nThe default sync mode acknowledges after fsync; buffered matches Python's write+close.\n--timings writes phase nanoseconds and the chosen durability to standard error.\nThe host wrapper holds flock on DESK_STATE/listening around listen-begin, its command,\nand listen-end. These marker commands touch alive; desk does not start the child.\n";
fn timing_line(errors: &mut Stderr, command: &str, durable: bool, arguments: usize,
    phases: &store::Timings, elapsed: usize) {
    let policy = if durable { "sync" } else { "buffered" };
    errors.write(format!("desk {command} phases_ns arguments={arguments} lock={} row={} open_repair={} append={} sync={} alive={} total={elapsed} durability={policy}\n",
        phases.lock, phases.row, phases.open, phases.append, phases.sync, phases.alive).as_bytes());
}
fn environment(value: &mut Environment) -> Result<String, String> {
    match value.get() {
        None => Ok(String::new()),
        Some(bytes) => match String::from_utf8(bytes) {
            Ok(text) => Ok(text), Err(_) => Err("granted environment value is not UTF-8".to_string()),
        },
    }
}
pub fn run(args: &mut Arguments, state: &mut Directory, state_env: &mut Environment,
    timezone: &mut Environment, output: &mut Stdout, errors: &mut Stderr, input: &mut Stdin,
    clock: &mut Clock, entropy: &mut Entropy) -> Result<u8, String> {
    let began = store::now(clock)?;
    let mut values = Vec::new();
    let raw = args.args();
    // Arguments grants contain user arguments; the executable name is omitted.
    for index in 0usize..raw.len() {
        match String::from_utf8(raw[index].clone()) {
            Ok(text) => values.push(text), Err(_) => return Err("command argument is not UTF-8".to_string()),
        }
    }
    let command = if values.is_empty() { "help" } else { values[0usize].as_str() };
    let words = words(&values);
    let who = option(&values, "--from", "claude");
    let durable = durability(&values)?;
    let measured = present(&values, "--timings");
    if command == "note" || command == "ask" {
        let mut text = String::new();
        for word in &words {
            if !text.is_empty() { text.push(' '); }
            text.push_str(word);
        }
        if present(&values, "--stdin") {
            let bytes = store::io(input.read_to_end(), "read desk standard input")?;
            let from_input = match String::from_utf8(bytes) {
                Ok(text) => text, Err(_) => return Err("standard input is not UTF-8".to_string()),
            };
            let from_input = std::text::trim(&from_input);
            if !text.is_empty() && !from_input.is_empty() { text.push(' '); }
            text.push_str(from_input);
        }
        if !text.is_empty() {
            let mut row = Row::new(command, &who, &text);
            let options = option(&values, "--options", "");
            if !options.is_empty() {
                row.has_options = true;
                for option in options.as_str().split(',') {
                    let option = std::text::trim(option);
                    if !option.is_empty() { row.options.push(option.to_string()); }
                }
            }
            let arguments = store::now(clock)? - began;
            let mut timings = store::Timings::new();
            let row = store::append_with_policy(state, "notes.jsonl", row, clock, entropy, durable, true, &mut timings)?;
            output.write(format!("{}\n", row.id).as_bytes());
            if measured { timing_line(errors, command, durable, arguments, &timings, store::now(clock)? - began); }
            return Ok(0u8);
        }
    } else if command == "close" && !words.is_empty() {
        let mut row = Row::new("close", &who, "");
        row.reference = words[0usize].clone();
        let arguments = store::now(clock)? - began;
        let mut timings = store::Timings::new();
        store::append_with_policy(state, "notes.jsonl", row, clock, entropy, durable, false, &mut timings)?;
        if measured { timing_line(errors, command, durable, arguments, &timings, store::now(clock)? - began); }
        return Ok(0u8);
    } else if command == "listen-begin" || command == "listen-end" {
        store::touch_alive(state)?;
        return Ok(0u8);
    } else if command == "inbox" {
        let name = environment(timezone)?;
        let offset = std::time::timezone_offset(if name.is_empty() { "UTC" } else { name.as_str() })?;
        let text = store::inbox(state, present(&values, "--peek"), offset)?;
        output.write(text.as_bytes());
        return Ok(0u8);
    } else if command == "path" {
        let path = environment(state_env)?;
        if path.is_empty() { return Err("DESK_STATE must name the granted state directory".to_string()); }
        output.write(format!("{path}\n").as_bytes());
        return Ok(0u8);
    }
    output.write(HELP.as_bytes());
    Ok(if command == "help" { 0u8 } else { 2u8 })
}

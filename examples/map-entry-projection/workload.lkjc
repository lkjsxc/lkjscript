declarations.begin
(units
  (use std builtin)
  (module create map-entry-projection
    (type-alias Payload (record (items (list I64)) (marker I64)))
    (type-alias Entry (record (key I64) (value Payload)))
    (type-alias Answer (record (entries (list Entry)) (total I64)))
    (function create build (visibility private) (effect pure)
      (parameter create input (type (list Entry)))
      (parameter create offset (type I64))
      (parameter create result (type (map I64 Payload))) (returns (map I64 Payload))
      (body (if (call std::less (local offset) (call std::list-length (types Entry) (local input)))
        (let (binding entry (type Entry) (call std::list-get (types Entry) (local input) (local offset)))
          (in (call build (local input) (call std::add (local offset) (i64 1))
            (call std::map-insert (types I64 Payload) (local result)
              (field (local entry) (name key)) (field (local entry) (name value))))))
        (local result))))
    (function create repeat (visibility private) (effect pure)
      (parameter create enumerate (type Bool))
      (parameter create input (type (map I64 Payload)))
      (parameter create remaining (type I64))
      (parameter create total (type I64)) (returns I64)
      (body (if (call std::less (i64 0) (local remaining))
        (call repeat (local enumerate) (local input)
          (call std::subtract (local remaining) (i64 1))
          (call std::add (local total)
            (if (local enumerate)
              (call std::list-length (types Entry) (call std::map-entries (types I64 Payload) (local input)))
              (call std::map-length (types I64 Payload) (local input)))))
        (local total))))
    (function create run (visibility public) (effect pure)
      (parameter create enumerate (type Bool))
      (parameter create input (type (list Entry)))
      (parameter create count (type I64)) (returns Answer)
      (body (let
        (binding lookup (type (map I64 Payload)) (call build (local input) (i64 0) (map I64 Payload)))
        (binding total (type I64) (call repeat (local enumerate) (local lookup) (local count) (i64 0)))
        (in (record structural
          (field entries (call std::map-entries (types I64 Payload) (local lookup)))
          (field total (local total)))))))
    (function create entry (visibility private) (effect pure)
      (parameter create key (type I64)) (parameter create marker (type I64)) (returns Entry)
      (body (record structural (field key (local key))
        (field value (record structural
          (field items (list I64 (local key) (local marker))) (field marker (local marker)))))))
    (test create empty (visibility private)
      (actual (call run (bool true) (list Entry) (i64 3)))
      (expected (record structural (field entries (list Entry)) (field total (i64 0)))))
    (test create zero-repetitions (visibility private)
      (actual (call run (bool true) (list Entry (call entry (i64 7) (i64 11)) (call entry (i64 -4) (i64 17))) (i64 0)))
      (expected (record structural
        (field entries (list Entry (call entry (i64 -4) (i64 17)) (call entry (i64 7) (i64 11))))
        (field total (i64 0)))))
    (test create repeated-projection (visibility private)
      (actual (call run (bool true) (list Entry (call entry (i64 7) (i64 11)) (call entry (i64 -4) (i64 17))) (i64 3)))
      (expected (record structural
        (field entries (list Entry (call entry (i64 -4) (i64 17)) (call entry (i64 7) (i64 11))))
        (field total (i64 6)))))
    (test create length-control (visibility private)
      (actual (call run (bool false) (list Entry (call entry (i64 7) (i64 11)) (call entry (i64 -4) (i64 17))) (i64 3)))
      (expected (record structural
        (field entries (list Entry (call entry (i64 -4) (i64 17)) (call entry (i64 7) (i64 11))))
        (field total (i64 6)))))
    (test create overwrite-retains-order (visibility private)
      (actual (call run (bool true) (list Entry (call entry (i64 7) (i64 11))
        (call entry (i64 -4) (i64 17)) (call entry (i64 7) (i64 22))) (i64 3)))
      (expected (record structural
        (field entries (list Entry (call entry (i64 -4) (i64 17)) (call entry (i64 7) (i64 22))))
        (field total (i64 6)))))
    (component create command (visibility private)
      (port create run (type (function (Bool (list Entry) I64) Answer)) (function run))))
  (target create map-entry-projection (component map-entry-projection::command)
    (runner command) (port map-entry-projection::command::run)))
declarations.end

request base=BASE
declarations.begin
(units
  (use std builtin)
  (module create folds
    (function create tail (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less (local index) (local limit))
        (call tail (types Item State) (local items) (local limit) (call std::add (local index) (i64 1))
          (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index)))
          (local step))
        (local state))))
    (function create four (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less-equal (i64 4) (call std::subtract (local limit) (local index)))
        (let
          (binding a (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index))))
          (binding b (invoke (local step) (local a) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 1)))))
          (binding c (invoke (local step) (local b) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 2)))))
          (binding d (invoke (local step) (local c) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 3)))))
          (in (call four (types Item State) (local items) (local limit)
            (call std::add (local index) (i64 4)) (local d) (local step))))
        (call tail (types Item State) (local items) (local limit) (local index) (local state) (local step)))))
    (function create eight (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less-equal (i64 8) (call std::subtract (local limit) (local index)))
        (let
          (binding a (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index))))
          (binding b (invoke (local step) (local a) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 1)))))
          (binding c (invoke (local step) (local b) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 2)))))
          (binding d (invoke (local step) (local c) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 3)))))
          (binding e (invoke (local step) (local d) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 4)))))
          (binding f (invoke (local step) (local e) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 5)))))
          (binding g (invoke (local step) (local f) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 6)))))
          (binding h (invoke (local step) (local g) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 7)))))
          (in (call eight (types Item State) (local items) (local limit)
            (call std::add (local index) (i64 8)) (local h) (local step))))
        (call tail (types Item State) (local items) (local limit) (local index) (local state) (local step)))))
    (function create fold-four (visibility public)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create initial (type State))
      (parameter create step (type (function (State Item) State))) (returns State) (effect pure)
      (body (call four (types Item State) (local items) (call std::list-length (types Item) (local items))
        (i64 0) (local initial) (local step))))
    (function create fold-eight (visibility public)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create initial (type State))
      (parameter create step (type (function (State Item) State))) (returns State) (effect pure)
      (body (call eight (types Item State) (local items) (call std::list-length (types Item) (local items))
        (i64 0) (local initial) (local step))))
    (function create digits (visibility private)
      (parameter create state (type I64)) (parameter create item (type I64)) (returns I64) (effect pure)
      (body (call std::add (call std::multiply (local state) (i64 10)) (local item))))
    (function create trap-step (visibility private)
      (parameter create state (type I64)) (parameter create item (type I64)) (returns I64) (effect pure)
      (body (call std::list-get (types I64) (list I64) (i64 0))))
    (test create four-and-tail-order (visibility private)
      (actual (call fold-four (types I64 I64)
        (list I64 (i64 1) (i64 2) (i64 3) (i64 4) (i64 5)) (i64 7) (function-value digits)))
      (expected (i64 712345)))
    (test create eight-and-tail-order (visibility private)
      (actual (call fold-eight (types I64 I64)
        (list I64 (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7) (i64 8) (i64 9))
        (i64 0) (function-value digits))) (expected (i64 123456789)))
    (test create four-empty-skips-callback (visibility private)
      (actual (call fold-four (types I64 I64) (list I64) (i64 29) (function-value trap-step)))
      (expected (i64 29)))
    (test create eight-empty-skips-callback (visibility private)
      (actual (call fold-eight (types I64 I64) (list I64) (i64 29) (function-value trap-step)))
      (expected (i64 29)))))
declarations.end

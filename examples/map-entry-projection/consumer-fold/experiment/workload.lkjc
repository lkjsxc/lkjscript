request base=rev_5fb6bcf38c3de65eeb8914390a1d8ef6aef210f2eff8a47c7a537c9b2d1d462e
declarations.begin
(units
  (use std builtin)
  (type-alias Entry (record (key I64) (value I64)))
  (type-alias Table (map I64 I64))
  (module create cost
    (function create populate (visibility private)
      (parameter create size (type I64))
      (parameter create index (type I64))
      (parameter create table (type Table))
      (returns Table) (effect pure)
      (body
        (if (call std::less (local index) (local size))
          (call populate (local size) (call std::add (local index) (i64 1))
            (call std::map-insert (types I64 I64) (local table) (local index)
              (call std::add (call std::multiply (local index) (i64 3)) (i64 7))))
          (local table))))
    (function create add-entry (visibility private)
      (parameter create total (type I64))
      (parameter create entry (type Entry))
      (returns I64) (effect pure)
      (body (call std::add (local total)
        (call std::add (field (local entry) (name key)) (field (local entry) (name value))))))
    (function create lookup-sum (visibility private)
      (parameter create table (type Table))
      (parameter create size (type I64))
      (parameter create index (type I64))
      (parameter create total (type I64))
      (returns I64) (effect pure)
      (body
        (if (call std::less (local index) (local size))
          (call lookup-sum (local table) (local size)
            (call std::add (local index) (i64 1))
            (call std::add (local total)
              (call std::add (local index)
                (call std::map-get-or (types I64 I64) (local table) (local index) (i64 -999999)))))
          (local total))))
    (function create repeat-map (visibility private)
      (parameter create table (type Table))
      (parameter create rounds (type I64))
      (parameter create mode (type I64))
      (parameter create total (type I64))
      (returns I64) (effect pure)
      (body
        (if (call std::less (i64 0) (local rounds))
          (let
            (binding value
              (if (call std::less (local mode) (i64 1))
                (call std::map-length (types I64 I64) (local table))
                (if (call std::less (local mode) (i64 2))
                  (call std::list-length (types Entry)
                    (call std::map-entries (types I64 I64) (local table)))
                  (if (call std::less (local mode) (i64 3))
                    (call std::list-fold-left (types Entry I64)
                      (call std::map-entries (types I64 I64) (local table))
                      (i64 0) (function-value add-entry))
                    (call lookup-sum (local table)
                      (call std::map-length (types I64 I64) (local table)) (i64 0) (i64 0))))))
            (in (call repeat-map (local table)
              (call std::subtract (local rounds) (i64 1)) (local mode)
              (call std::add (local total) (local value)))))
          (local total))))
    (function create repeat-list (visibility private)
      (parameter create entries (type (list Entry)))
      (parameter create rounds (type I64))
      (parameter create total (type I64))
      (returns I64) (effect pure)
      (body
        (if (call std::less (i64 0) (local rounds))
          (call repeat-list (local entries) (call std::subtract (local rounds) (i64 1))
            (call std::add (local total)
              (call std::list-fold-left (types Entry I64) (local entries)
                (i64 0) (function-value add-entry))))
          (local total))))
    (function create measure (visibility public)
      (parameter create size (type I64))
      (parameter create rounds (type I64))
      (parameter create mode (type I64))
      (returns I64) (effect pure)
      (body
        (let (binding table (call populate (local size) (i64 0) (map I64 I64)))
          (in
            (if (call std::less (local mode) (i64 4))
              (call repeat-map (local table) (local rounds) (local mode) (i64 0))
              (call repeat-list (call std::map-entries (types I64 I64) (local table))
                (local rounds) (i64 0)))))))
    (function create snapshot (visibility public)
      (parameter create size (type I64))
      (returns (list Entry)) (effect pure)
      (body (call std::map-entries (types I64 I64)
        (call populate (local size) (i64 0) (map I64 I64)))))
    (test create empty-count (visibility private)
      (actual (call measure (i64 0) (i64 3) (i64 0))) (expected (i64 0)))
    (test create length-control (visibility private)
      (actual (call measure (i64 4) (i64 3) (i64 0))) (expected (i64 12)))
    (test create projected-length (visibility private)
      (actual (call measure (i64 4) (i64 3) (i64 1))) (expected (i64 12)))
    (test create projected-fold (visibility private)
      (actual (call measure (i64 4) (i64 3) (i64 2))) (expected (i64 156)))
    (test create dense-key-fold (visibility private)
      (actual (call measure (i64 4) (i64 3) (i64 3))) (expected (i64 156)))
    (test create reused-list-fold (visibility private)
      (actual (call measure (i64 4) (i64 3) (i64 4))) (expected (i64 156)))
    (test create no-repetitions (visibility private)
      (actual (call measure (i64 4) (i64 0) (i64 2))) (expected (i64 0)))
    (test create complete-snapshot (visibility private)
      (actual (call snapshot (i64 3)))
      (expected (list Entry
        (record structural (field key (i64 0)) (field value (i64 7)))
        (record structural (field key (i64 1)) (field value (i64 10)))
        (record structural (field key (i64 2)) (field value (i64 13))))))
    (component create console (visibility private)
      (port create measure (type (function (I64 I64 I64) I64)) (function measure))
      (port create snapshot (type (function (I64) (list Entry))) (function snapshot))))
  (target create measure (component cost::console) (runner command) (port cost::console::measure))
  (target create snapshot (component cost::console) (runner command) (port cost::console::snapshot)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (type-alias Entry (record (key I64) (value I64)))
  (type-alias Table (map I64 I64))
  (type-alias Counts (record (count I64) (sum I64)))
  (module create blocked
    (function create tail (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less (local index) (local limit))
        (call tail (types Item State) (local items) (local limit) (call std::add (local index) (i64 1))
          (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index))) (local step))
        (local state))))
    (function create four (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less-equal (i64 4) (call std::subtract (local limit) (local index)))
        (let
          (binding a (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index))))
          (binding b (invoke (local step) (local a) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 1)))))
          (binding c (invoke (local step) (local b) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 2)))))
          (binding d (invoke (local step) (local c) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 3)))))
          (in (call four (types Item State) (local items) (local limit) (call std::add (local index) (i64 4)) (local d) (local step))))
        (call tail (types Item State) (local items) (local limit) (local index) (local state) (local step)))))
    (function create eight (visibility private)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create limit (type I64))
      (parameter create index (type I64)) (parameter create state (type State))
      (parameter create step (type (function (State Item) State)))
      (returns State) (effect pure)
      (body (if (call std::less-equal (i64 8) (call std::subtract (local limit) (local index)))
        (let
          (binding a (invoke (local step) (local state) (call std::list-get (types Item) (local items) (local index))))
          (binding b (invoke (local step) (local a) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 1)))))
          (binding c (invoke (local step) (local b) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 2)))))
          (binding d (invoke (local step) (local c) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 3)))))
          (binding e (invoke (local step) (local d) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 4)))))
          (binding f (invoke (local step) (local e) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 5)))))
          (binding g (invoke (local step) (local f) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 6)))))
          (binding h (invoke (local step) (local g) (call std::list-get (types Item) (local items) (call std::add (local index) (i64 7)))))
          (in (call eight (types Item State) (local items) (local limit) (call std::add (local index) (i64 8)) (local h) (local step))))
        (call tail (types Item State) (local items) (local limit) (local index) (local state) (local step)))))
    (function create fold-four (visibility public)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create initial (type State))
      (parameter create step (type (function (State Item) State))) (returns State) (effect pure)
      (body (call four (types Item State) (local items) (call std::list-length (types Item) (local items))
        (i64 0) (local initial) (local step))))
    (function create fold-eight (visibility public)
      (type-parameter create Item) (type-parameter create State)
      (parameter create items (type (list Item))) (parameter create initial (type State))
      (parameter create step (type (function (State Item) State))) (returns State) (effect pure)
      (body (call eight (types Item State) (local items) (call std::list-length (types Item) (local items))
        (i64 0) (local initial) (local step))))
    (function create populate (visibility private)
      (parameter create size (type I64)) (parameter create index (type I64)) (parameter create table (type Table))
      (returns Table) (effect pure)
      (body (if (call std::less (local index) (local size))
        (call populate (local size) (call std::add (local index) (i64 1))
          (call std::map-insert (types I64 I64) (local table) (local index)
            (call std::add (call std::multiply (local index) (i64 3)) (i64 7)))) (local table))))
    (function create add-entry (visibility private)
      (parameter create total (type I64)) (parameter create entry (type Entry)) (returns I64) (effect pure)
      (body (call std::add (local total) (call std::add (field (local entry) (name key)) (field (local entry) (name value))))))
    (function create repeat (visibility private)
      (parameter create items (type (list Entry))) (parameter create rounds (type I64))
      (parameter create mode (type I64)) (parameter create total (type I64)) (returns I64) (effect pure)
      (body (if (call std::less (i64 0) (local rounds))
        (let (binding value (if (call std::less (local mode) (i64 9))
          (call fold-four (types Entry I64) (local items) (i64 0) (function-value add-entry))
          (call fold-eight (types Entry I64) (local items) (i64 0) (function-value add-entry))))
          (in (call repeat (local items) (call std::subtract (local rounds) (i64 1)) (local mode)
            (call std::add (local total) (local value))))) (local total))))
    (function create measure (visibility public)
      (parameter create size (type I64)) (parameter create rounds (type I64)) (parameter create mode (type I64))
      (returns I64) (effect pure)
      (body (if (call std::less (local mode) (i64 8))
        (call traversal::measure (local size) (local rounds) (local mode))
        (call repeat (call std::map-entries (types I64 I64) (call populate (local size) (i64 0) (map I64 I64)))
          (local rounds) (local mode) (i64 0)))))
    (function create digits (visibility private)
      (parameter create state (type I64)) (parameter create item (type I64)) (returns I64) (effect pure)
      (body (call std::add (call std::multiply (local state) (i64 10)) (local item))))
    (function create count-bool (visibility private)
      (parameter create state (type Counts)) (parameter create item (type Bool)) (returns Counts) (effect pure)
      (body (record structural
        (field count (call std::add (field (local state) (name count)) (i64 1)))
        (field sum (call std::add (field (local state) (name sum)) (if (local item) (i64 1) (i64 0)))))))
    (function create trap-step (visibility private)
      (parameter create state (type I64)) (parameter create item (type I64)) (returns I64) (effect pure)
      (body (call std::list-get (types I64) (list I64) (i64 0))))
    (function create trap-probe (visibility public)
      (parameter create active (type Bool)) (parameter create mode (type I64)) (returns I64) (effect pure)
      (body (let (binding items (if (local active) (list I64 (i64 1)) (list I64)))
        (in (if (call std::less (local mode) (i64 1))
          (call fold-four (types I64 I64) (local items) (i64 29) (function-value trap-step))
          (call fold-eight (types I64 I64) (local items) (i64 29) (function-value trap-step)))))))
    (test create four-and-tail-ordered (visibility private)
      (actual (call fold-four (types I64 I64) (list I64 (i64 1) (i64 2) (i64 3) (i64 4) (i64 5)) (i64 7) (function-value digits)))
      (expected (i64 712345)))
    (test create eight-and-tail-ordered (visibility private)
      (actual (call fold-eight (types I64 I64) (list I64 (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7) (i64 8) (i64 9))
        (i64 0) (function-value digits))) (expected (i64 123456789)))
    (test create eight-distinct-item-and-state (visibility private)
      (actual (call fold-eight (types Bool Counts) (list Bool (bool true) (bool false) (bool true) (bool true) (bool false) (bool true) (bool false) (bool false) (bool true))
        (record structural (field count (i64 0)) (field sum (i64 0))) (function-value count-bool)))
      (expected (record structural (field count (i64 9)) (field sum (i64 5)))))
    (test create four-empty-does-not-call (visibility private)
      (actual (call trap-probe (bool false) (i64 0))) (expected (i64 29)))
    (test create eight-empty-does-not-call (visibility private)
      (actual (call trap-probe (bool false) (i64 1))) (expected (i64 29)))
    (test create four-repeated-sum (visibility private)
      (actual (call measure (i64 17) (i64 3) (i64 8))) (expected (i64 1989)))
    (test create eight-repeated-sum (visibility private)
      (actual (call measure (i64 17) (i64 3) (i64 9))) (expected (i64 1989)))
    (component create console (visibility private)
      (port create measure (type (function (I64 I64 I64) I64)) (function measure))
      (port create trap (type (function (Bool I64) I64)) (function trap-probe))))
  (target create blocked (component blocked::console) (runner command) (port blocked::console::measure))
  (target create trap-probe (component blocked::console) (runner command) (port blocked::console::trap)))
declarations.end

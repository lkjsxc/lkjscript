request base=BASE
add.dependency package=FOLD_PACKAGE semantic-revision=FOLD_SEMANTIC package-revision=FOLD_REVISION
declarations.begin
(units
  (use std builtin)
  (use folds FOLD_PACKAGE FOLD_REVISION)
  (type-alias Counts (record (count I64) (sum I64)))
  (module create consumer
    (function create weighted-step (visibility private)
      (parameter create state (type Counts)) (parameter create item (type I64))
      (returns Counts) (effect pure)
      (body (let (binding next (call std::add (field (local state) (name count)) (i64 1)))
        (in (record structural
          (field count (local next))
          (field sum (call std::add (field (local state) (name sum))
            (call std::multiply (local next) (local item)))))))))
    (function create measure (visibility public)
      (parameter create items (type (list I64))) (parameter create initial (type Counts))
      (parameter create mode (type I64)) (returns Counts) (effect pure)
      (body (if (call std::less (local mode) (i64 1))
        (call folds::fold-four (types I64 Counts) (local items) (local initial) (function-value weighted-step))
        (if (call std::less (local mode) (i64 2))
          (call folds::fold-eight (types I64 Counts) (local items) (local initial) (function-value weighted-step))
          (call std::list-fold-left (types I64 Counts) (local items) (local initial) (function-value weighted-step))))))
    (function create trap-step (visibility private)
      (parameter create state (type I64)) (parameter create item (type I64)) (returns I64) (effect pure)
      (body (if (call std::less (local item) (i64 0))
        (call std::list-get (types I64) (list I64) (i64 0))
        (call std::add (local state) (local item)))))
    (function create trap-probe (visibility public)
      (parameter create items (type (list I64))) (parameter create mode (type I64))
      (returns I64) (effect pure)
      (body (if (call std::less (local mode) (i64 1))
        (call folds::fold-four (types I64 I64) (local items) (i64 29) (function-value trap-step))
        (call folds::fold-eight (types I64 I64) (local items) (i64 29) (function-value trap-step)))))
    (test create imported-four-order (visibility private)
      (actual (call measure (list I64 (i64 -3) (i64 0) (i64 5) (i64 2) (i64 2) (i64 -1) (i64 9) (i64 7) (i64 4))
        (record structural (field count (i64 3)) (field sum (i64 11))) (i64 0)))
      (expected (record structural (field count (i64 12)) (field sum (i64 265)))))
    (test create imported-eight-order (visibility private)
      (actual (call measure (list I64 (i64 -3) (i64 0) (i64 5) (i64 2) (i64 2) (i64 -1) (i64 9) (i64 7) (i64 4))
        (record structural (field count (i64 3)) (field sum (i64 11))) (i64 1)))
      (expected (record structural (field count (i64 12)) (field sum (i64 265)))))
    (test create standard-control (visibility private)
      (actual (call measure (list I64 (i64 -3) (i64 0) (i64 5) (i64 2) (i64 2) (i64 -1) (i64 9) (i64 7) (i64 4))
        (record structural (field count (i64 3)) (field sum (i64 11))) (i64 2)))
      (expected (record structural (field count (i64 12)) (field sum (i64 265)))))
    (test create imported-empty-state (visibility private)
      (actual (call measure (list I64) (record structural (field count (i64 3)) (field sum (i64 11))) (i64 1)))
      (expected (record structural (field count (i64 3)) (field sum (i64 11)))))
    (test create four-empty-callback (visibility private)
      (actual (call trap-probe (list I64) (i64 0))) (expected (i64 29)))
    (test create eight-empty-callback (visibility private)
      (actual (call trap-probe (list I64) (i64 1))) (expected (i64 29)))
    (component create console (visibility private)
      (port create measure (type (function ((list I64) Counts I64) Counts)) (function measure))
      (port create trap (type (function ((list I64) I64) I64)) (function trap-probe))))
  (target create imported (component consumer::console) (runner command) (port consumer::console::measure))
  (target create trap-probe (component consumer::console) (runner command) (port consumer::console::trap)))
declarations.end

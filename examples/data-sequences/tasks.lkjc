declarations.begin
(units
  (use std builtin)
  (module create data-tasks
    (type-alias Payload (record (items (list (record (label Text) (values (list I64))))) (flags (list Bool))))
    (type-alias Values (owned-sequence Payload))
    (type-alias Item (owned-product (field rest Values) (field value Payload)))
    (type-alias Joined (owned-product (field left Values) (field right Payload)))
    (type-alias Result (record (before Payload) (displaced Payload) (after Payload) (side Payload)))
    (function create relay (visibility private) (effect (task))
      (parameter create values (type Values) (use consume)) (returns Values) (body (local values)))
    (function create side (visibility private) (effect (task))
      (parameter create value (type Payload)) (returns Payload) (body (local value)))
    (function create view (visibility private) (effect pure)
      (parameter create values (type Values) (use borrow)) (returns Values (borrow-from values))
      (body (local values)))
    (function create read (visibility private) (effect (task))
      (parameter create values (type Values) (use borrow)) (returns Payload)
      (body (borrow-call (call view (local values)) (binding view (type Values))
        (in (call std::data-sequence-get (types Payload) (i64 0) (local view))))))
    (function create main (visibility public) (effect (task))
      (parameter create original (type Payload)) (parameter create replacement (type Payload)) (returns Result)
      (body (let
        (binding values (type Values) (call std::data-sequence-empty (types Payload)))
        (binding values (type Values) (call std::data-sequence-push (types Payload) (local original) (local values)))
        (binding before (type Payload) (call std::data-sequence-get (types Payload) (i64 0) (local values)))
        (binding joined (type Joined) (parallel (call relay (local values)) (call side (local before))))
        (in (unpack-owned (type Joined) (local joined)
          (field left (binding values (type Values))) (field right (binding side (type Payload)))
          (in (let (binding changed (type Item)
            (call std::data-sequence-replace (types Payload) (i64 0) (local replacement) (local values)))
            (in (unpack-owned (type Item) (local changed)
              (field rest (binding values (type Values))) (field value (binding displaced (type Payload)))
              (in (let (binding after (type Payload) (call std::data-sequence-get (types Payload) (i64 0) (local values)))
                (in (sequence (call std::data-sequence-discard (types Payload) (local values))
                  (record structural (field before (local before)) (field displaced (local displaced))
                    (field after (local after)) (field side (local side))))))))))))))))
    (function create shared (visibility public) (effect (task))
      (parameter create original (type Payload)) (parameter create replacement (type Payload))
      (returns (record (left Payload) (right Payload) (after Payload)))
      (body (let
        (binding values (type Values) (call std::data-sequence-empty (types Payload)))
        (binding values (type Values) (call std::data-sequence-push (types Payload) (local original) (local values)))
        (binding reads (type (record (left Payload) (right Payload)))
          (parallel (call read (local values)) (call read (local values))))
        (binding changed (type Item) (call std::data-sequence-replace (types Payload) (i64 0) (local replacement) (local values)))
        (in (unpack-owned (type Item) (local changed)
          (field rest (binding values (type Values))) (field value (binding displaced (type Payload)))
          (in (let (binding after (type Payload) (call std::data-sequence-get (types Payload) (i64 0) (local values)))
            (in (sequence (call std::data-sequence-discard (types Payload) (local values))
              (record structural (field left (field (local reads) (name left)))
                (field right (field (local reads) (name right))) (field after (local after))))))))))))
    (component create command (visibility private)
      (port create main (type (task-function (Payload Payload) Result (row))) (function main))
      (port create shared (type (task-function (Payload Payload) (record (left Payload) (right Payload) (after Payload)) (row))) (function shared))))
  (target create data-transfer (component data-tasks::command) (runner command) (port data-tasks::command::main))
  (target create data-shared (component data-tasks::command) (runner command) (port data-tasks::command::shared)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create data-trace
    (type-alias Values (owned-sequence I64))
    (type-alias Item (owned-product (field rest Values) (field value I64)))
    (type-alias Pop (owned-choice (case empty Values) (case item Item)))
    (type-alias Step (owned-product (field rest Values) (field present Bool) (field value I64)))
    (type-alias Action (record (kind I64) (value I64)))
    (type-alias Event (record (kind I64) (present Bool) (value I64) (length I64)))
    (type-alias Scenario (record (events (list Event)) (remaining (list I64)) (empty I64) (reused I64)))
    ; Codes: 0 push, 1 pop, 2 get first, 3 replace first, 4 clear. Missing items produce absent events.
    (function create step (visibility private) (effect pure)
      (parameter create kind (type I64)) (parameter create input (type I64))
      (parameter create values (type Values) (use consume)) (returns Step)
      (body (if (call std::i64-equal (local kind) (i64 0))
        (let (binding rest (type Values) (call data-sequences::push (types I64) (local input) (local values)))
          (in (pack-owned (type Step) (field rest (local rest)) (field present (bool true)) (field value (local input)))))
        (if (call std::i64-equal (local kind) (i64 1))
          (let (binding popped (type Pop) (call data-sequences::pop (types I64) (local values)))
            (in (match-owned (type Pop) (local popped)
              (case empty (binding rest (type Values))
                (in (pack-owned (type Step) (field rest (local rest)) (field present (bool false)) (field value (i64 0)))))
              (case item (binding item (type Item))
                (in (unpack-owned (type Item) (local item)
                  (field rest (binding rest (type Values))) (field value (binding value (type I64)))
                  (in (pack-owned (type Step) (field rest (local rest)) (field present (bool true)) (field value (local value))))))))))
          (if (call std::i64-equal (local kind) (i64 2))
            (if (call std::less (i64 0) (call data-sequences::length (types I64) (local values)))
              (let (binding value (type I64) (call data-sequences::get (types I64) (i64 0) (local values)))
                (in (pack-owned (type Step) (field rest (local values)) (field present (bool true)) (field value (local value)))))
              (pack-owned (type Step) (field rest (local values)) (field present (bool false)) (field value (i64 0))))
            (if (call std::i64-equal (local kind) (i64 3))
              (if (call std::less (i64 0) (call data-sequences::length (types I64) (local values)))
                (let (binding changed (type Item) (call data-sequences::replace (types I64) (i64 0) (local input) (local values)))
                  (in (unpack-owned (type Item) (local changed)
                    (field rest (binding rest (type Values))) (field value (binding value (type I64)))
                    (in (pack-owned (type Step) (field rest (local rest)) (field present (bool true)) (field value (local value)))))))
                (pack-owned (type Step) (field rest (local values)) (field present (bool false)) (field value (i64 0))))
              (sequence
                (if (call std::i64-equal (local kind) (i64 4)) (unit)
                  (call std::list-get (types Unit) (list Unit) (i64 0)))
                (call data-sequences::discard (types I64) (local values))
                (let (binding rest (type Values) (call data-sequences::empty (types I64)))
                  (in (pack-owned (type Step) (field rest (local rest)) (field present (bool false)) (field value (i64 0))))))))))))
    (function create drain (visibility private) (effect pure)
      (parameter create finished (type (list I64)))
      (parameter create values (type Values) (use consume))
      (returns (owned-product (field rest Values) (field result (list I64))))
      (body (let (binding popped (type Pop) (call data-sequences::pop (types I64) (local values)))
        (in (match-owned (type Pop) (local popped)
          (case empty (binding rest (type Values))
            (in (pack-owned (type (owned-product (field rest Values) (field result (list I64))))
              (field rest (local rest)) (field result (local finished)))))
          (case item (binding item (type Item))
            (in (unpack-owned (type Item) (local item)
              (field rest (binding rest (type Values))) (field value (binding value (type I64)))
              (in (call drain (call std::list-append (types I64) (local finished) (local value)) (local rest)))))))))))
    (function create finish (visibility private) (effect pure)
      (parameter create events (type (list Event)))
      (parameter create values (type Values) (use consume)) (returns Scenario)
      (body (let (binding drained (type (owned-product (field rest Values) (field result (list I64))))
        (call drain (list I64) (local values)))
        (in (unpack-owned (type (owned-product (field rest Values) (field result (list I64)))) (local drained)
          (field rest (binding rest (type Values))) (field result (binding remaining (type (list I64))))
          (in (let
            (binding empty (type I64) (call data-sequences::length (types I64) (local rest)))
            (binding rest (type Values) (call data-sequences::push (types I64) (i64 37) (local rest)))
            (binding reused (type I64) (call data-sequences::get (types I64) (i64 0) (local rest)))
            (in (sequence (call data-sequences::discard (types I64) (local rest))
              (record structural (field events (local events)) (field remaining (local remaining))
                (field empty (local empty)) (field reused (local reused))))))))))))
    (function create visit (visibility private) (effect pure)
      (parameter create actions (type (list Action))) (parameter create offset (type I64))
      (parameter create events (type (list Event)))
      (parameter create values (type Values) (use consume)) (returns Scenario)
      (body (if (call std::less (local offset) (call std::list-length (types Action) (local actions)))
        (let
          (binding action (type Action) (call std::list-get (types Action) (local actions) (local offset)))
          (binding changed (type Step) (call step (field (local action) (name kind)) (field (local action) (name value)) (local values)))
          (in (unpack-owned (type Step) (local changed)
            (field rest (binding rest (type Values))) (field present (binding present (type Bool))) (field value (binding value (type I64)))
            (in (let (binding event (type Event)
              (record structural (field kind (field (local action) (name kind))) (field present (local present))
                (field value (local value)) (field length (call data-sequences::length (types I64) (local rest)))))
              (in (call visit (local actions) (call std::add (local offset) (i64 1))
                (call std::list-append (types Event) (local events) (local event)) (local rest))))))))
        (call finish (local events) (local values)))))
    (function create run (visibility public) (effect pure)
      (parameter create actions (type (list Action))) (returns Scenario)
      (body (let (binding values (type Values) (call data-sequences::empty (types I64)))
        (in (call visit (local actions) (i64 0) (list Event) (local values))))))
    (function create batch (visibility public) (effect pure)
      (parameter create cases (type (list (list Action)))) (returns (list Scenario))
      (body (call std::list-map (types (list Action) Scenario) (local cases) (function-value run))))
    (component create command (visibility private)
      (port create run (type (function ((list Action)) Scenario)) (function run))
      (port create batch (type (function ((list (list Action))) (list Scenario))) (function batch))))
  (target create data-trace (component data-trace::command) (runner command) (port data-trace::command::run))
  (target create data-trace-batch (component data-trace::command) (runner command) (port data-trace::command::batch)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create data-sequences
    (function create empty (visibility public) (effect pure)
      (type-parameter create T (constraint transferable)) (returns (owned-sequence T))
      (body (sequence-empty (type (owned-sequence T)))))
    (function create length (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create values (type (owned-sequence T)) (use borrow)) (returns I64)
      (body (sequence-length (type (owned-sequence T)) (local values))))
    (function create push (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create value (type T))
      (parameter create values (type (owned-sequence T)) (use consume)) (returns (owned-sequence T))
      (body (sequence-push (type (owned-sequence T)) (local value) (local values))))
    (function create pop (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create values (type (owned-sequence T)) (use consume))
      (returns (owned-choice (case empty (owned-sequence T))
        (case item (owned-product (field rest (owned-sequence T)) (field value T)))))
      (body (sequence-pop (type (owned-sequence T)) (local values))))
    (function create get (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64))
      (parameter create values (type (owned-sequence T)) (use borrow)) (returns T)
      (body (sequence-get (type (owned-sequence T)) (local values) (index (local index)))))
    (function create replace (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64)) (parameter create value (type T))
      (parameter create values (type (owned-sequence T)) (use consume))
      (returns (owned-product (field rest (owned-sequence T)) (field value T)))
      (body (sequence-replace (type (owned-sequence T)) (index (local index)) (local value) (local values))))
    (function create discard (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create values (type (owned-sequence T)) (use consume)) (returns Unit) (body (unit)))
    (function create snapshot (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create original (type T)) (parameter create replacement (type T))
      (returns (record (before T) (displaced T) (after T) (removed T) (empty I64)))
      (body (let
        (binding values (type (owned-sequence T)) (call empty (types T)))
        (binding values (type (owned-sequence T)) (call push (types T) (local original) (local values)))
        (binding before (type T) (call get (types T) (i64 0) (local values)))
        (binding changed (type (owned-product (field rest (owned-sequence T)) (field value T)))
          (call replace (types T) (i64 0) (local replacement) (local values)))
        (in (unpack-owned (type (owned-product (field rest (owned-sequence T)) (field value T))) (local changed)
          (field rest (binding values (type (owned-sequence T)))) (field value (binding displaced (type T)))
          (in (let
            (binding after (type T) (call get (types T) (i64 0) (local values)))
            (binding popped (type (owned-choice (case empty (owned-sequence T))
              (case item (owned-product (field rest (owned-sequence T)) (field value T)))))
              (call pop (types T) (local values)))
            (in (match-owned (type (owned-choice (case empty (owned-sequence T))
              (case item (owned-product (field rest (owned-sequence T)) (field value T))))) (local popped)
              (case empty (binding values (type (owned-sequence T)))
                (in (record structural (field before (local before)) (field displaced (local displaced))
                  (field after (local after)) (field removed (local original)) (field empty (i64 -1)))))
              (case item (binding item (type (owned-product (field rest (owned-sequence T)) (field value T))))
                (in (unpack-owned (type (owned-product (field rest (owned-sequence T)) (field value T))) (local item)
                  (field rest (binding values (type (owned-sequence T)))) (field value (binding removed (type T)))
                  (in (let (binding empty (type I64) (call length (types T) (local values)))
                    (in (sequence (call discard (types T) (local values))
                      (record structural (field before (local before)) (field displaced (local displaced))
                        (field after (local after)) (field removed (local removed)) (field empty (local empty)))))))))))))))))))))
declarations.end

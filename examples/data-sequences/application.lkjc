declarations.begin
(units
  (use std builtin)
  (module create data-app
    (type-alias Payload (record (items (list (record (label Text) (values (list I64))))) (flags (list Bool))))
    (type-alias Snapshot (record (before Payload) (displaced Payload) (after Payload) (removed Payload) (empty I64)))
    (type-alias Values (owned-sequence I64))
    (type-alias Item (owned-product (field rest Values) (field value I64)))
    (function create scalar (visibility public) (effect pure)
      (parameter create original (type I64)) (parameter create replacement (type I64))
      (returns (record (before I64) (displaced I64) (after I64) (removed I64) (empty I64)))
      (body (call data-sequences::snapshot (types I64) (local original) (local replacement))))
    (function create boolean (visibility public) (effect pure)
      (parameter create original (type Bool)) (parameter create replacement (type Bool))
      (returns (record (before Bool) (displaced Bool) (after Bool) (removed Bool) (empty I64)))
      (body (call data-sequences::snapshot (types Bool) (local original) (local replacement))))
    (function create nested (visibility public) (effect pure)
      (parameter create original (type Payload)) (parameter create replacement (type Payload)) (returns Snapshot)
      (body (call data-sequences::snapshot (types Payload) (local original) (local replacement))))
    (function create pair (visibility private) (effect pure) (returns Values)
      (body (let
        (binding values (type Values) (call std::data-sequence-empty (types I64)))
        (binding values (type Values) (call std::data-sequence-push (types I64) (i64 7) (local values)))
        (in (call std::data-sequence-push (types I64) (i64 9) (local values))))))
    (function create get (visibility public) (effect pure)
      (parameter create index (type I64)) (returns I64)
      (body (let (binding values (type Values) (call pair))
        (in (call std::data-sequence-get (types I64) (local index) (local values))))))
    (function create replace (visibility public) (effect pure)
      (parameter create index (type I64)) (parameter create value (type I64))
      (returns (record (displaced I64) (current I64) (length I64)))
      (body (let
        (binding values (type Values) (call pair))
        (binding changed (type Item) (call std::data-sequence-replace (types I64) (local index) (local value) (local values)))
        (in (unpack-owned (type Item) (local changed)
          (field rest (binding values (type Values))) (field value (binding displaced (type I64)))
          (in (record structural (field displaced (local displaced))
            (field current (call std::data-sequence-get (types I64) (local index) (local values)))
            (field length (call std::data-sequence-length (types I64) (local values))))))))))
    (function create empty-get (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns I64)
      (body (let (binding values (type Values) (call std::data-sequence-empty (types I64)))
        (in (call std::data-sequence-get (types I64) (i64 0) (local values))))))
    (function create order (visibility public) (effect pure) (returns I64)
      (body (let
        (binding values (type Values) (call pair))
        (binding empty (type Values) (call std::data-sequence-empty (types I64)))
        (binding changed (type Item)
          (sequence-replace (type Values)
            (index (call std::list-get (types I64) (list I64) (i64 0)))
            (sequence-get (type Values) (local empty) (index (i64 0))) (local values)))
        (in (i64 0)))))
    (component create command (visibility private)
      (port create scalar (type (function (I64 I64) (record (before I64) (displaced I64) (after I64) (removed I64) (empty I64)))) (function scalar))
      (port create boolean (type (function (Bool Bool) (record (before Bool) (displaced Bool) (after Bool) (removed Bool) (empty I64)))) (function boolean))
      (port create nested (type (function (Payload Payload) Snapshot)) (function nested))
      (port create get (type (function (I64) I64)) (function get))
      (port create replace (type (function (I64 I64) (record (displaced I64) (current I64) (length I64)))) (function replace))
      (port create empty-get (type (function ((list I64)) I64)) (function empty-get))
      (port create order (type (function () I64)) (function order))))
  (target create data-scalar (component data-app::command) (runner command) (port data-app::command::scalar))
  (target create data-bool (component data-app::command) (runner command) (port data-app::command::boolean))
  (target create data-nested (component data-app::command) (runner command) (port data-app::command::nested))
  (target create data-get (component data-app::command) (runner command) (port data-app::command::get))
  (target create data-replace (component data-app::command) (runner command) (port data-app::command::replace))
  (target create data-empty-get (component data-app::command) (runner command) (port data-app::command::empty-get))
  (target create data-order (component data-app::command) (runner command) (port data-app::command::order)))
declarations.end

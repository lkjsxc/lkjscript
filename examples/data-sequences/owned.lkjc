declarations.begin
(units
  (use std builtin)
  (module create data-owned
    (type-alias Values (owned-sequence OwnedI64Cell))
    (type-alias Item (owned-product (field rest Values) (field value OwnedI64Cell)))
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create read (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create finish (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create observe (visibility private) (effect pure)
      (parameter create index (type I64)) (parameter create values (type Values) (use borrow)) (returns I64)
      (body (borrow-owned-item (type Values) (local values) (index (local index))
        (binding view (type OwnedI64Cell)) (in (call read (local view))))))
    (function create main (visibility public) (effect pure)
      (parameter create original (type I64)) (parameter create replacement (type I64))
      (returns (record (displaced I64) (first I64) (last I64) (length I64)))
      (body (let
        (binding values (type Values) (call std::sequence-empty (types OwnedI64Cell)))
        (binding value (type OwnedI64Cell) (call new (local original)))
        (binding values (type Values) (call std::sequence-push (types OwnedI64Cell) (local value) (local values)))
        (binding value (type OwnedI64Cell) (call new (i64 9)))
        (binding values (type Values) (call std::sequence-push (types OwnedI64Cell) (local value) (local values)))
        (binding replacement (type OwnedI64Cell) (call new (local replacement)))
        (binding changed (type Item) (call std::sequence-replace (types OwnedI64Cell) (i64 0) (local replacement) (local values)))
        (in (unpack-owned (type Item) (local changed)
          (field rest (binding values (type Values))) (field value (binding displaced (type OwnedI64Cell)))
          (in (let
            (binding displaced (type I64) (call finish (local displaced)))
            (binding first (type I64) (call observe (i64 0) (local values)))
            (binding last (type I64) (call observe (i64 1) (local values)))
            (binding length (type I64) (call std::sequence-length (types OwnedI64Cell) (local values)))
            (in (sequence (call std::sequence-discard (types OwnedI64Cell) (local values))
              (record structural (field displaced (local displaced)) (field first (local first))
                (field last (local last)) (field length (local length))))))))))))
    (component create command (visibility private)
      (port create main (type (function (I64 I64) (record (displaced I64) (first I64) (last I64) (length I64)))) (function main))))
  (target create data-owned-replace (component data-owned::command) (runner command) (port data-owned::command::main)))
declarations.end

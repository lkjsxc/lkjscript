declarations.begin
(units
  (module create sequence-carriers
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create get (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create extract (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create n (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create octet (visibility private) (implementation core.buffer.get)
      (parameter create index (type I64))
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64))
    (external create discard (visibility private) (implementation core.buffer.discard)
      (parameter create value (type ByteBuffer) (use consume)) (returns Unit))
    (function create cell-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns OwnedI64Cell) (body (call new (local n))))
    (function create cell-read (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64) (body (call get (local value))))
    (function create cell-finish (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64) (body (call extract (local value))))
    (function create alternate-read (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64) (body (i64 99)))
    (function create buffer-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns ByteBuffer)
      (body (let (binding value (type ByteBuffer) (call empty))
        (in (call push (local n) (local value))))))
    (function create buffer-read (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (call octet (i64 0) (local value))))
    (function create buffer-finish (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use consume)) (returns I64)
      (body (let (binding n (type I64) (call octet (i64 0) (local value)))
        (in (sequence (call discard (local value)) (local n))))))
    (owned-implementation create Scalar (visibility public)
      (contract owned-sequences::Element) (self OwnedI64Cell)
      (method method_86000000000000000000000000000001 cell-create)
      (method method_86000000000000000000000000000002 cell-read)
      (method method_86000000000000000000000000000003 cell-finish))
    (owned-implementation create Alternate (visibility public)
      (contract owned-sequences::Element) (self OwnedI64Cell)
      (method method_86000000000000000000000000000001 cell-create)
      (method method_86000000000000000000000000000002 alternate-read)
      (method method_86000000000000000000000000000003 cell-finish))
    (owned-implementation create Octets (visibility public)
      (contract owned-sequences::Element) (self ByteBuffer)
      (method method_86000000000000000000000000000001 buffer-create)
      (method method_86000000000000000000000000000002 buffer-read)
      (method method_86000000000000000000000000000003 buffer-finish))))
declarations.end

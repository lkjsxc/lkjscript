declarations.begin
(units
  (module create compact-proof-user
    (type-alias Result (record (observed I64) (alternate I64) (restored I64)))
    (external create create-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create read-cell (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create extract-cell (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create observe (visibility private) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (call read-cell (local value))))
    (function create alternate (visibility private) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (i64 99)))
    (owned-implementation create Cell (visibility private)
      (contract compact-proof::Reader) (self OwnedI64Cell)
      (method method_c1000000000000000000000000000001 observe))
    (owned-implementation create Alternate (visibility private)
      (contract compact-proof::Reader) (self OwnedI64Cell)
      (method method_c1000000000000000000000000000001 alternate))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64)) (returns Result)
      (body (let
        (binding value (type OwnedI64Cell) (call create-cell (local n)))
        (binding observed (type I64)
          (implementation-call compact-proof::read24 (types OwnedI64Cell)
            (implementations Cell) (local value)))
        (binding other (type I64)
          (implementation-call compact-proof::read24 (types OwnedI64Cell)
            (implementations Alternate) (local value)))
        (binding restored (type I64) (call extract-cell (local value)))
        (in (record structural
          (field observed (local observed)) (field alternate (local other))
          (field restored (local restored)))))))
    (component create command (visibility private)
      (port create main (type (function (I64) Result)) (function main))))
  (target create compact-proof (component compact-proof-user::command)
    (runner command) (port compact-proof-user::command::main)))
declarations.end

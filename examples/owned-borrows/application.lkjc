declarations.begin
(units
  (module create owned-borrows-app
    (function create marker (visibility public) (effect pure) (returns I64) (body (i64 41)))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create accepted (type Bool))
      (returns (record
        (scalar (record (first I64) (second I64) (tag I64)))
        (alternate (record (first I64) (second I64) (tag I64))) (consumed I64)
        (bytes (record (first I64) (second I64) (tag I64))) (frozen Bytes)
        (nested (record (child I64) (parent (record (first I64) (second I64) (tag I64))) (marker I64)))
        (nested-consumed I64) (choice (record (first I64) (second I64) (consumed I64)))
        (siblings (record (left I64) (right I64)))
        (sibling-consumed (record (left I64) (right I64))) (marker I64)))
      (body (let
        (binding c (type OwnedI64Cell) (call owned-borrow-carriers::cell-create (local n)))
        (binding packet (type (owned-product (field payload OwnedI64Cell) (field tag I64)))
          (call owned-borrows::packet (types OwnedI64Cell) (i64 7) (local c)))
        (binding scalar (type (record (first I64) (second I64) (tag I64)))
          (borrow-owned-field
            (type (owned-product (field payload OwnedI64Cell) (field tag I64))) (local packet)
            (field payload (binding view (type OwnedI64Cell)))
            (in (record structural
              (field first (call owned-borrow-carriers::cell-read (local view)))
              (field second (implementation-call owned-borrows::read-helper (types OwnedI64Cell)
                (implementations concrete@owned-borrow-carriers::Scalar) (local view)))
              (field tag (field (local packet) (name tag)))))))
        (binding alternate (type (record (first I64) (second I64) (tag I64)))
          (implementation-call owned-borrows::read-packet (types OwnedI64Cell)
            (implementations concrete@owned-borrow-carriers::Alternate) (local packet)))
        (binding original (type OwnedI64Cell) (call owned-borrows::take-packet (types OwnedI64Cell) (local packet)))
        (binding consumed (type I64) (call owned-borrow-carriers::cell-finish (local original)))
        (binding b (type ByteBuffer) (call owned-borrow-carriers::buffer-create))
        (binding octets (type (owned-product (field payload ByteBuffer) (field tag I64)))
          (call owned-borrows::packet (types ByteBuffer) (i64 8) (local b)))
        (binding bytes (type (record (first I64) (second I64) (tag I64)))
          (implementation-call owned-borrows::read-packet (types ByteBuffer)
            (implementations concrete@owned-borrow-carriers::Octets) (local octets)))
        (binding b (type ByteBuffer) (call owned-borrows::take-packet (types ByteBuffer) (local octets)))
        (binding frozen (type Bytes) (call owned-borrow-carriers::buffer-finish (local b)))
        (binding c (type OwnedI64Cell) (call owned-borrow-carriers::cell-create (local n)))
        (binding inner (type (owned-product (field payload OwnedI64Cell) (field tag I64)))
          (call owned-borrows::packet (types OwnedI64Cell) (i64 9) (local c)))
        (binding envelope
          (type (owned-product (field packet (owned-product (field payload OwnedI64Cell) (field tag I64))) (field marker I64)))
          (pack-owned
            (type (owned-product (field packet (owned-product (field payload OwnedI64Cell) (field tag I64))) (field marker I64)))
            (field packet (local inner)) (field marker (i64 17))))
        (binding nested (type (record (child I64) (parent (record (first I64) (second I64) (tag I64))) (marker I64)))
          (implementation-call owned-borrows::read-nested (types OwnedI64Cell)
            (implementations concrete@owned-borrow-carriers::Scalar) (local envelope)))
        (binding c (type OwnedI64Cell) (call owned-borrows::take-nested (types OwnedI64Cell) (local envelope)))
        (binding nested-consumed (type I64) (call owned-borrow-carriers::cell-finish (local c)))
        (binding c (type OwnedI64Cell) (call owned-borrow-carriers::cell-create (local n)))
        (binding outcome (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (call owned-borrows::outcome (types OwnedI64Cell) (local accepted) (local n) (local c)))
        (binding first (type I64)
          (match-borrowed-owned
            (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell))) (local outcome)
            (case accepted (binding value (type I64)) (in (local value)))
            (case rejected (binding view (type OwnedI64Cell))
              (in (call owned-borrow-carriers::cell-read (local view))))))
        (binding second (type I64)
          (implementation-call owned-borrows::read-outcome (types OwnedI64Cell)
            (implementations concrete@owned-borrow-carriers::Alternate) (local outcome)))
        (binding recovered (type I64)
          (match-owned
            (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell))) (local outcome)
            (case accepted (binding value (type I64)) (in (local value)))
            (case rejected (binding value (type OwnedI64Cell))
              (in (call owned-borrow-carriers::cell-finish (local value))))))
        (binding left (type OwnedI64Cell) (call owned-borrow-carriers::cell-create (local n)))
        (binding right (type OwnedI64Cell) (call owned-borrow-carriers::cell-create (local n)))
        (binding pair (type (owned-product (field left OwnedI64Cell) (field right OwnedI64Cell)))
          (pack-owned (type (owned-product (field left OwnedI64Cell) (field right OwnedI64Cell)))
            (field left (local left)) (field right (local right))))
        (binding siblings (type (record (left I64) (right I64)))
          (implementation-call owned-borrows::read-siblings (types OwnedI64Cell)
            (implementations concrete@owned-borrow-carriers::Scalar) (local pair)))
        (binding sibling-consumed (type (record (left I64) (right I64)))
          (unpack-owned (type (owned-product (field left OwnedI64Cell) (field right OwnedI64Cell))) (local pair)
            (field left (binding left (type OwnedI64Cell))) (field right (binding right (type OwnedI64Cell)))
            (in (record structural
              (field left (call owned-borrow-carriers::cell-finish (local left)))
              (field right (call owned-borrow-carriers::cell-finish (local right)))))))
        (in (record structural
          (field scalar (local scalar)) (field alternate (local alternate)) (field consumed (local consumed))
          (field bytes (local bytes)) (field frozen (local frozen))
          (field nested (local nested)) (field nested-consumed (local nested-consumed))
          (field choice (record structural (field first (local first)) (field second (local second)) (field consumed (local recovered))))
          (field siblings (local siblings)) (field sibling-consumed (local sibling-consumed))
          (field marker (call marker)))))))
    (component create command (visibility private)
      (port create main
        (type (function (I64 Bool) (record
          (scalar (record (first I64) (second I64) (tag I64)))
          (alternate (record (first I64) (second I64) (tag I64))) (consumed I64)
          (bytes (record (first I64) (second I64) (tag I64))) (frozen Bytes)
          (nested (record (child I64) (parent (record (first I64) (second I64) (tag I64))) (marker I64)))
          (nested-consumed I64) (choice (record (first I64) (second I64) (consumed I64)))
          (siblings (record (left I64) (right I64)))
          (sibling-consumed (record (left I64) (right I64))) (marker I64))))
        (function main))))
  (target create owned-borrows (component owned-borrows-app::command)
    (runner command) (port owned-borrows-app::command::main)))
declarations.end

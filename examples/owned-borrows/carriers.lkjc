declarations.begin
(units
  (module create owned-borrow-carriers
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create get (visibility private) (implementation core.cell.read)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create extract (visibility private) (implementation core.cell.extract)
      (parameter create owner (type OwnedI64Cell) (use consume)) (returns I64))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create length (visibility private) (implementation core.buffer.length)
      (parameter create owner (type ByteBuffer) (use borrow)) (returns I64))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create n (type I64))
      (parameter create owner (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create owner (type ByteBuffer) (use consume)) (returns Bytes))
    (function create cell-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns OwnedI64Cell) (body (call new (local n))))
    (function create cell-read (visibility public) (effect pure)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64) (body (call get (local owner))))
    (function create cell-finish (visibility public) (effect pure)
      (parameter create owner (type OwnedI64Cell) (use consume)) (returns I64) (body (call extract (local owner))))
    (function create alternate-read (visibility public) (effect pure)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64) (body (i64 99)))
    (function create buffer-create (visibility public) (effect pure) (returns ByteBuffer)
      (body (let (binding owner (type ByteBuffer) (call empty))
        (in (call push (i64 73) (local owner))))))
    (function create buffer-read (visibility public) (effect pure)
      (parameter create owner (type ByteBuffer) (use borrow)) (returns I64) (body (call length (local owner))))
    (function create buffer-finish (visibility public) (effect pure)
      (parameter create owner (type ByteBuffer) (use consume)) (returns Bytes) (body (call freeze (local owner))))
    (owned-implementation create Scalar (visibility public)
      (contract owned-borrows::Storage) (self OwnedI64Cell)
      (method method_85000000000000000000000000000001 cell-read))
    (owned-implementation create Alternate (visibility public)
      (contract owned-borrows::Storage) (self OwnedI64Cell)
      (method method_85000000000000000000000000000001 alternate-read))
    (owned-implementation create Octets (visibility public)
      (contract owned-borrows::Storage) (self ByteBuffer)
      (method method_85000000000000000000000000000001 buffer-read))))
declarations.end

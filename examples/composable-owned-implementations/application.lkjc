    (function create finish (visibility private) (effect (task))
      (type-parameter create T (constraint owned transferable))
      (implementation-parameter implparam_8e000000000000000000000000000015
        drain composable-adapters::DrainTask T)
      (parameter create storage (type T) (use consume)) (returns (list I64))
      (body (method-call parameter@finish@implparam_8e000000000000000000000000000015
        composable-adapters::DrainTask method_8e000000000000000000000000000002 (local storage))))
    (function create parallel-drain (visibility public) (effect (task))
      (parameter create inputs (type (list I64)))
      (returns (record (left (list I64)) (right (list I64))))
      (body (let
        (binding cells (type CellFlat)
          (implementation-call generic-storage::flat-build (types OwnedI64Cell)

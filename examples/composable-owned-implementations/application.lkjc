          (implementation-call finish (types BufferFlat)
            (implementations (implementation composable-adapters::Drain (types ByteBuffer BufferFlat)
              (implementations generic-elements::Buffers
                (implementation generic-storage::Flat (types ByteBuffer))))) (local buffers)))))))
    (function create main (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Result)
      (body (record structural
        (field cell-flat (call cell-flat (local inputs)))
        (field buffer-chunked (call buffer-chunked (local inputs)))
        (field product-flat (call product-flat (local inputs)))
        (field product-chunked (call product-chunked (local inputs)))
        (field cell-reverse (call cell-reverse (local inputs)))
        (field cell-nested (call cell-nested (local inputs)))
        (field cell-nested-reverse (call cell-nested-reverse (local inputs))))))
    (component create command (visibility private)
      (port create main (type (function ((list I64)) Result)) (function main))

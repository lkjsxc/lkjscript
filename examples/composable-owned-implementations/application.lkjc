        (binding length (type I64)
          (method-call parameter@scenario@implparam_8e000000000000000000000000000014
            owned-read-results::IndexRead method_8a000000000000000000000000000001 (local storage)))
        (binding selected (type (list I64))
          (if (call std::i64-equal (local length) (i64 0)) (list I64)
            (borrow-call
              (method-call (implementation composable-adapters::Maximum (types T W)
                (implementations parameter@scenario@implparam_8e000000000000000000000000000011
                  parameter@scenario@implparam_8e000000000000000000000000000014))
                composable-adapters::Selection method_8e000000000000000000000000000001 (local storage))
              (binding view (type T))
              (in (list I64
                (method-call parameter@scenario@implparam_8e000000000000000000000000000011
                  owned-worklists::Element method_88000000000000000000000000000002 (local view)))))))
        (binding tied-selected (type (list I64))
          (if (call std::i64-equal (local length) (i64 0)) (list I64)
            (borrow-call
              (method-call (implementation composable-adapters::Maximum (types T W)

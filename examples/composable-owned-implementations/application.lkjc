            (implementations parameter@scenario@implparam_8e000000000000000000000000000011
              parameter@scenario@implparam_8e000000000000000000000000000013) (local storage)))
        (in (unpack-owned (type (owned-product (field rest W) (field values (list I64)))) (local drained)
          (field rest (binding rest (type W))) (field values (binding drained-values (type (list I64))))
          (in (let
            (binding empty-length (type I64)
              (method-call parameter@scenario@implparam_8e000000000000000000000000000014

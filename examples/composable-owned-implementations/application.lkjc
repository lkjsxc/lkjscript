            (binding value (type T)
              (method-call parameter@scenario@implparam_8e000000000000000000000000000011
                owned-worklists::Element method_88000000000000000000000000000001 (i64 17)))
            (binding next (type W)
              (method-call parameter@scenario@implparam_8e000000000000000000000000000013
                owned-worklists::Worklist method_88000000000000000000000000000013 (local value) (local rest)))
            (binding reused (type (owned-product (field rest W) (field values (list I64))))
              (implementation-call owned-worklists::drain (types T W)
                (implementations parameter@scenario@implparam_8e000000000000000000000000000011
                  parameter@scenario@implparam_8e000000000000000000000000000013) (local next)))
            (in (unpack-owned (type (owned-product (field rest W) (field values (list I64)))) (local reused)
              (field rest (binding final-rest (type W))) (field values (binding reused-values (type (list I64))))
              (in (record structural

                composable-adapters::Selection method_8e000000000000000000000000000001 (local storage))
              (binding view (type T))
              (in (list I64
                (method-call parameter@scenario@implparam_8e000000000000000000000000000011
                  owned-worklists::Element method_88000000000000000000000000000002 (local view)))))))
        (binding drained (type (owned-product (field rest W) (field values (list I64))))

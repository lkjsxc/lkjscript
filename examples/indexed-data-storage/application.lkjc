declarations.begin
(units
  (use std builtin)
  (module create indexed-app
    (type-alias ScalarResult (record (before (list I64)) (displaced I64) (after (list I64)) (length I64)))
    (type-alias ScalarResults (record (flat ScalarResult) (chunked ScalarResult)
      (forward-flat ScalarResult) (forward-chunked ScalarResult) (nested-forward ScalarResult) (reverse ScalarResult)))
    (type-alias BoolResult (record (before (list Bool)) (displaced Bool) (after (list Bool)) (length I64)))
    (type-alias Payload (record (labels (list Text)) (values (list (list I64))) (flags (list Bool))))
    (type-alias PayloadResult (record (before (list Payload)) (displaced Payload) (after (list Payload)) (length I64)))
    (record create Packet (visibility public)
      (field create label (type Text)) (field create values (type (list I64))))
    (type-alias PacketResult (record (before (list Packet)) (displaced Packet) (after (list Packet)) (length I64)))
    (type-alias Row (record (label Text) (values (list I64))))
    (type-alias Metadata (record (name Text) (flags (list Bool))))
    (type-alias Item (record (rows (list Row)) (lookup (map I64 Row)) (meta Metadata)))
    (type-alias ItemResult (record (displaced Item) (first Row) (entry Row) (name Text)))
    (owned-record create RetainedItem (visibility public)
      (field create rows (type (list Row)))
      (field create lookup (type (map I64 Row)))
      (field create meta (type Metadata)))
    (function create observe-item (visibility private) (effect pure)
      (parameter create value (type Item)) (returns ItemResult)
      (body (record structural
        (field displaced (local value))
        (field first (call std::list-get (types Row) (field (local value) (name rows)) (i64 0)))
        (field entry (call std::map-get-or (types I64 Row) (field (local value) (name lookup)) (i64 7)
          (record structural (field label (text "missing")) (field values (list I64)))))
        (field name (field (field (local value) (name meta)) (name name))))))
    (function create retain-item (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_a1000000000000000000000000000041 storage indexed-data::IndexedData W (types Item))
      (parameter create input (type (list Item))) (parameter create index (type I64))
      (parameter create replacement (type Item)) (returns ItemResult)
      (body (let
        (binding storage (type W) (implementation-call indexed-data::build (types Item W)
          (implementations parameter@retain-item@implparam_a1000000000000000000000000000041) (local input)))
        (binding changed (type (owned-product (field rest W) (field value Item)))
          (method-call parameter@retain-item@implparam_a1000000000000000000000000000041
            indexed-data::IndexedData method_a1000000000000000000000000000005
            (local index) (local replacement) (local storage)))
        (in (unpack-owned (type (owned-product (field rest W) (field value Item))) (local changed)
          (field value (binding displaced (type Item))) (field rest (binding rest (type W)))
          (in (sequence
            (method-call parameter@retain-item@implparam_a1000000000000000000000000000041
              indexed-data::IndexedData method_a1000000000000000000000000000006 (local rest))
            (call observe-item (local displaced)))))))))
    (function create item-flat (visibility public) (effect pure)
      (parameter create input (type (list Item))) (parameter create index (type I64))
      (parameter create replacement (type Item)) (returns ItemResult)
      (body (implementation-call retain-item (types (owned-sequence Item))
        (implementations (implementation indexed-flat::Flat (types Item)))
        (local input) (local index) (local replacement))))
    (function create item-chunked (visibility public) (effect pure)
      (parameter create input (type (list Item))) (parameter create index (type I64))
      (parameter create replacement (type Item)) (returns ItemResult)
      (body (implementation-call retain-item (types (indexed-chunked::Chunk32 Item))
        (implementations (implementation indexed-chunked::Chunked (types Item)))
        (local input) (local index) (local replacement))))
    (function create item-nominal (visibility public) (effect pure)
      (parameter create value (type Item)) (returns ItemResult)
      (body (let (binding owner (type RetainedItem)
        (pack-owned (type RetainedItem)
          (field meta (field (local value) (name meta)))
          (field rows (field (local value) (name rows)))
          (field lookup (field (local value) (name lookup)))))
        (in (unpack-owned (type RetainedItem) (local owner)
          (field lookup (binding lookup (type (map I64 Row))))
          (field meta (binding meta (type Metadata)))
          (field rows (binding rows (type (list Row))))
          (in (call observe-item (record structural
            (field rows (local rows)) (field lookup (local lookup)) (field meta (local meta))))))))))
    (function create integers (visibility public) (effect pure)
      (parameter create input (type (list I64))) (parameter create index (type I64))
      (parameter create replacement (type I64)) (returns ScalarResults)
      (body (record structural
        (field flat (implementation-call indexed-data::exercise (types I64 (owned-sequence I64))
          (implementations (implementation indexed-flat::Flat (types I64))) (local input) (local index) (local replacement)))
        (field chunked (implementation-call indexed-data::exercise (types I64 (indexed-chunked::Chunk32 I64))
          (implementations (implementation indexed-chunked::Chunked (types I64))) (local input) (local index) (local replacement)))
        (field forward-flat (implementation-call indexed-data::exercise (types I64 (owned-sequence I64))
          (implementations (implementation indexed-forward::Forward (types I64 (owned-sequence I64))
            (implementations (implementation indexed-flat::Flat (types I64))))) (local input) (local index) (local replacement)))
        (field forward-chunked (implementation-call indexed-data::exercise (types I64 (indexed-chunked::Chunk32 I64))
          (implementations (implementation indexed-forward::Forward (types I64 (indexed-chunked::Chunk32 I64))
            (implementations (implementation indexed-chunked::Chunked (types I64))))) (local input) (local index) (local replacement)))
        (field nested-forward (implementation-call indexed-data::exercise (types I64 (owned-sequence I64))
          (implementations (implementation indexed-forward::Forward (types I64 (owned-sequence I64))
            (implementations (implementation indexed-forward::Forward (types I64 (owned-sequence I64))
              (implementations (implementation indexed-flat::Flat (types I64))))))) (local input) (local index) (local replacement)))
        (field reverse (implementation-call indexed-data::exercise (types I64 (owned-sequence I64))
          (implementations (implementation indexed-flat::Reverse (types I64))) (local input) (local index) (local replacement))))))
    (function create booleans (visibility public) (effect pure)
      (parameter create input (type (list Bool))) (parameter create index (type I64))
      (parameter create replacement (type Bool)) (returns (record (flat BoolResult) (chunked BoolResult)))
      (body (record structural
        (field flat (implementation-call indexed-data::exercise (types Bool (owned-sequence Bool))
          (implementations (implementation indexed-flat::Flat (types Bool))) (local input) (local index) (local replacement)))
        (field chunked (implementation-call indexed-data::exercise (types Bool (indexed-chunked::Chunk32 Bool))
          (implementations (implementation indexed-chunked::Chunked (types Bool))) (local input) (local index) (local replacement))))))
    (function create scalar-flat (visibility public) (effect pure)
      (parameter create input (type (list I64))) (parameter create index (type I64))
      (parameter create replacement (type I64)) (returns ScalarResult)
      (body (implementation-call indexed-data::exercise (types I64 (owned-sequence I64))
        (implementations (implementation indexed-flat::Flat (types I64))) (local input) (local index) (local replacement))))
    (function create scalar-chunked (visibility public) (effect pure)
      (parameter create input (type (list I64))) (parameter create index (type I64))
      (parameter create replacement (type I64)) (returns ScalarResult)
      (body (implementation-call indexed-data::exercise (types I64 (indexed-chunked::Chunk32 I64))
        (implementations (implementation indexed-chunked::Chunked (types I64))) (local input) (local index) (local replacement))))
    (function create payloads (visibility public) (effect pure)
      (parameter create input (type (list Payload))) (parameter create index (type I64))
      (parameter create replacement (type Payload)) (returns (record (flat PayloadResult) (chunked PayloadResult)))
      (body (record structural
        (field flat (implementation-call indexed-data::exercise (types Payload (owned-sequence Payload))
          (implementations (implementation indexed-flat::Flat (types Payload))) (local input) (local index) (local replacement)))
        (field chunked (implementation-call indexed-data::exercise (types Payload (indexed-chunked::Chunk32 Payload))
          (implementations (implementation indexed-chunked::Chunked (types Payload))) (local input) (local index) (local replacement))))))
    (function create packets (visibility public) (effect pure)
      (parameter create input (type (list Packet))) (parameter create index (type I64))
      (parameter create replacement (type Packet)) (returns (record (flat PacketResult) (chunked PacketResult)))
      (body (record structural
        (field flat (implementation-call indexed-data::exercise (types Packet (owned-sequence Packet))
          (implementations (implementation indexed-flat::Flat (types Packet))) (local input) (local index) (local replacement)))
        (field chunked (implementation-call indexed-data::exercise (types Packet (indexed-chunked::Chunk32 Packet))
          (implementations (implementation indexed-chunked::Chunked (types Packet))) (local input) (local index) (local replacement))))))
    (function create captured (visibility public) (effect pure)
      (parameter create input (type (list I64))) (parameter create index (type I64)) (returns I64)
      (body (let
        (binding storage (type (owned-sequence I64)) (implementation-call indexed-data::build (types I64 (owned-sequence I64))
          (implementations (implementation indexed-flat::Flat (types I64))) (local input)))
        (binding result (type I64) (method-call
          (implementation indexed-forward::Captured (types I64 (owned-sequence I64))
            (implementations (implementation indexed-flat::Flat (types I64))))
          indexed-forward::CaptureRead method_a1000000000000000000000000000011 (local index) (local storage)))
        (in (sequence (method-call (implementation indexed-flat::Flat (types I64))
          indexed-data::IndexedData method_a1000000000000000000000000000006 (local storage)) (local result))))))
    (component create command (visibility private)
      (port create item-flat (type (function ((list Item) I64 Item) ItemResult)) (function item-flat))
      (port create item-chunked (type (function ((list Item) I64 Item) ItemResult)) (function item-chunked))
      (port create item-nominal (type (function (Item) ItemResult)) (function item-nominal))
      (port create integers (type (function ((list I64) I64 I64) ScalarResults)) (function integers))
      (port create scalar-flat (type (function ((list I64) I64 I64) ScalarResult)) (function scalar-flat))
      (port create scalar-chunked (type (function ((list I64) I64 I64) ScalarResult)) (function scalar-chunked))
      (port create booleans (type (function ((list Bool) I64 Bool) (record (flat BoolResult) (chunked BoolResult)))) (function booleans))
      (port create payloads (type (function ((list Payload) I64 Payload) (record (flat PayloadResult) (chunked PayloadResult)))) (function payloads))
      (port create packets (type (function ((list Packet) I64 Packet) (record (flat PacketResult) (chunked PacketResult)))) (function packets))
      (port create captured (type (function ((list I64) I64) I64)) (function captured))))
  (target create indexed-integers (component indexed-app::command) (runner command) (port indexed-app::command::integers))
  (target create indexed-scalar-flat (component indexed-app::command) (runner command) (port indexed-app::command::scalar-flat))
  (target create indexed-scalar-chunked (component indexed-app::command) (runner command) (port indexed-app::command::scalar-chunked))
  (target create indexed-booleans (component indexed-app::command) (runner command) (port indexed-app::command::booleans))
  (target create indexed-payloads (component indexed-app::command) (runner command) (port indexed-app::command::payloads))
  (target create indexed-packets (component indexed-app::command) (runner command) (port indexed-app::command::packets))
  (target create indexed-item-flat (component indexed-app::command) (runner command) (port indexed-app::command::item-flat))
  (target create indexed-item-chunked (component indexed-app::command) (runner command) (port indexed-app::command::item-chunked))
  (target create indexed-item-nominal (component indexed-app::command) (runner command) (port indexed-app::command::item-nominal))
  (target create indexed-captured (component indexed-app::command) (runner command) (port indexed-app::command::captured)))
declarations.end

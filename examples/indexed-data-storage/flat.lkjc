      (parameter create storage (type (owned-sequence T)) (use borrow)) (returns I64)
      (body (if (call std::i64-equal
        (call std::data-sequence-length (types T) (local storage)) (i64 0)) (i64 0) (i64 1))))
    (function create block-at (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64))
      (parameter create storage (type (owned-sequence T)) (use borrow))
      (returns (owned-sequence T) (borrow-from storage))
      (body (if (call std::less (i64 0)

declarations.begin
(units
  (use std builtin)
  (module create indexed-flat
    (owned-implementation create Flat (visibility public)
      (type-parameter create T (constraint transferable))
      (contract indexed-data::IndexedData) (self (owned-sequence T)) (types T)
      (method method_a1000000000000000000000000000001 std::data-sequence-empty (types T))
      (method method_a1000000000000000000000000000002 std::data-sequence-length (types T))
      (method method_a1000000000000000000000000000003 std::data-sequence-push (types T))
      (method method_a1000000000000000000000000000004 std::data-sequence-get (types T))
      (method method_a1000000000000000000000000000005 std::data-sequence-replace (types T))
      (method method_a1000000000000000000000000000006 std::data-sequence-discard (types T)))
    (function create reverse-get (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64))
      (parameter create storage (type (owned-sequence T)) (use borrow)) (returns T)
      (body (call std::data-sequence-get (types T)
        (call std::subtract (call std::data-sequence-length (types T) (local storage))
          (call std::add (local index) (i64 1))) (local storage))))
    (owned-implementation create Reverse (visibility public)
      (type-parameter create T (constraint transferable))
      (contract indexed-data::IndexedData) (self (owned-sequence T)) (types T)
      (method method_a1000000000000000000000000000001 std::data-sequence-empty (types T))
      (method method_a1000000000000000000000000000002 std::data-sequence-length (types T))
      (method method_a1000000000000000000000000000003 std::data-sequence-push (types T))
      (method method_a1000000000000000000000000000004 reverse-get (types T))
      (method method_a1000000000000000000000000000005 std::data-sequence-replace (types T))
      (method method_a1000000000000000000000000000006 std::data-sequence-discard (types T)))))
declarations.end

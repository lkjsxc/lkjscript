        (if (call std::i64-equal (local index) (i64 0))
          (local storage)
          (sequence (call std::divide (i64 1) (i64 0)) (local storage)))
        (sequence (call std::divide (i64 1) (i64 0)) (local storage)))))
    (owned-implementation create Blocks (visibility public)

declarations.begin
(units
  (use std builtin)
  (module create collection-cost
    (type-alias Payload (record (items (list I64))))
    (type-alias Empty (owned-sequence OwnedI64Cell))
    (type-alias Envelope (owned-product (field payload Payload) (field rest Empty)))
    (function create wrap (visibility private) (effect pure)
      (parameter create payload (type Payload)) (returns Envelope)
      (body (let (binding rest (type Empty) (sequence-empty (type Empty)))
        (in (pack-owned (type Envelope)
          (field payload (local payload)) (field rest (local rest)))))))
    (function create through-owner (visibility private) (effect pure)
      (parameter create payload (type Payload)) (returns Payload)
      (body (let (binding owner (type Envelope) (call wrap (local payload)))
        (in (unpack-owned (type Envelope) (local owner)
          (field payload (binding selected (type Payload)))
          (field rest (binding rest (type Empty)))
          (in (local selected)))))))
    (function create through-pack (visibility private) (effect pure)
      (parameter create payload (type Payload)) (returns Payload)
      (body (let (binding owner (type Envelope) (call wrap (local payload)))
        (in (local payload)))))
    (function create loop-borrow (visibility private) (effect pure)
      (parameter create remaining (type I64)) (parameter create total (type I64))
      (parameter create owner (type Envelope) (use borrow))
      (returns I64)
      (body (if (call std::less (i64 0) (local remaining))
        (call loop-borrow
          (call std::subtract (local remaining) (i64 1))
          (call std::add (local total)
            (call std::list-length (types I64)
              (field (field (local owner) (name payload)) (name items))))
          (local owner))
        (local total))))
    (function create run-borrow (visibility private) (effect pure)
      (parameter create items (type (list I64)))
      (parameter create count (type I64)) (returns I64)
      (body (let (binding owner (type Envelope)
        (call wrap (record structural (field items (local items)))))
        (in (call loop-borrow (local count) (i64 0) (local owner))))))
    (function create loop-read (visibility private) (effect pure)
      (parameter create mode (type I64))
      (parameter create values (type (list Payload)))
      (parameter create lookup (type (map I64 Payload)))
      (parameter create remaining (type I64))
      (parameter create total (type I64)) (returns I64)
      (body (if (call std::less (i64 0) (local remaining))
        (let (binding selected (type Payload)
          (if (call std::less (local mode) (i64 1))
            (call std::list-get (types Payload) (local values) (i64 0))
            (if (call std::less (local mode) (i64 2))
              (call std::map-get-or (types I64 Payload) (local lookup) (i64 7)
                (record structural (field items (list I64))))
              (if (call std::less (local mode) (i64 3))
                (call through-owner (call std::list-get (types Payload) (local values) (i64 0)))
                (call through-pack (call std::list-get (types Payload) (local values) (i64 0)))))))
          (in (call loop-read (local mode) (local values) (local lookup)
            (call std::subtract (local remaining) (i64 1))
            (call std::add (local total)
              (call std::list-length (types I64) (field (local selected) (name items)))))))
        (local total))))
    (function create run (visibility public) (effect pure)
      (parameter create mode (type I64))
      (parameter create items (type (list I64)))
      (parameter create count (type I64)) (returns I64)
      (body (if (call std::less (local mode) (i64 4))
        (let
          (binding payload (type Payload) (record structural (field items (local items))))
          (binding values (type (list Payload)) (list Payload (local payload)))
          (binding lookup (type (map I64 Payload))
            (call std::map-insert (types I64 Payload) (map I64 Payload) (i64 7) (local payload)))
          (in (call loop-read (local mode) (local values) (local lookup) (local count) (i64 0))))
        (call run-borrow (local items) (local count)))))
    (test create list-read (visibility private)
      (actual (call run (i64 0) (list I64 (i64 5) (i64 9)) (i64 3)))
      (expected (i64 6)))
    (test create map-read (visibility private)
      (actual (call run (i64 1) (list I64 (i64 5) (i64 9)) (i64 3)))
      (expected (i64 6)))
    (test create owner-roundtrip (visibility private)
      (actual (call run (i64 2) (list I64 (i64 5) (i64 9)) (i64 3)))
      (expected (i64 6)))
    (test create pack-and-drop (visibility private)
      (actual (call run (i64 3) (list I64 (i64 5) (i64 9)) (i64 3)))
      (expected (i64 6)))
    (test create borrowed-metadata (visibility private)
      (actual (call run (i64 4) (list I64 (i64 5) (i64 9)) (i64 3)))
      (expected (i64 6)))
    (test create empty-payload (visibility private)
      (actual (call run (i64 1) (list I64) (i64 3)))
      (expected (i64 0)))
    (test create no-reads (visibility private)
      (actual (call run (i64 0) (list I64 (i64 5)) (i64 0)))
      (expected (i64 0)))
    (component create command (visibility private)
      (port create run (type (function (I64 (list I64) I64) I64)) (function run))))
  (target create collection-cost (component collection-cost::command)
    (runner command) (port collection-cost::command::run)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create read-carriers
    (type-alias CellFlat (owned-sequence OwnedI64Cell))
    (type-alias CellChunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (type-alias BufferFlat (owned-sequence ByteBuffer))
    (type-alias BufferChunked (owned-product
      (field chunks (owned-sequence (owned-sequence ByteBuffer))) (field size I64)))
    (function create flat-cell-at (visibility public) (effect pure)
      (parameter create index (type I64))
      (parameter create storage (type CellFlat) (use borrow))
      (returns OwnedI64Cell (borrow-from storage))
      (body (borrow-owned-item (type CellFlat) (local storage) (index (local index))
        (binding view (type OwnedI64Cell)) (in (local view)))))
    (function create chunked-cell-at (visibility public) (effect pure)
      (parameter create index (type I64))
      (parameter create storage (type CellChunked) (use borrow))
      (returns OwnedI64Cell (borrow-from storage))
      (body (borrow-owned-field (type CellChunked) (local storage)
        (field chunks (binding chunks (type (owned-sequence (owned-sequence OwnedI64Cell)))))
        (in (borrow-owned-item (type (owned-sequence (owned-sequence OwnedI64Cell))) (local chunks)
          (index (call std::divide (local index) (i64 32)))
          (binding chunk (type (owned-sequence OwnedI64Cell)))
          (in (borrow-owned-item (type (owned-sequence OwnedI64Cell)) (local chunk)
            (index (call std::subtract (local index)
              (call std::multiply (call std::divide (local index) (i64 32)) (i64 32))))
            (binding view (type OwnedI64Cell)) (in (local view)))))))))
    (function create flat-buffer-at (visibility public) (effect pure)
      (parameter create index (type I64))
      (parameter create storage (type BufferFlat) (use borrow))
      (returns ByteBuffer (borrow-from storage))
      (body (borrow-owned-item (type BufferFlat) (local storage) (index (local index))
        (binding view (type ByteBuffer)) (in (local view)))))
    (function create chunked-buffer-at (visibility public) (effect pure)
      (parameter create index (type I64))
      (parameter create storage (type BufferChunked) (use borrow))
      (returns ByteBuffer (borrow-from storage))
      (body (borrow-owned-field (type BufferChunked) (local storage)
        (field chunks (binding chunks (type (owned-sequence (owned-sequence ByteBuffer)))))
        (in (borrow-owned-item (type (owned-sequence (owned-sequence ByteBuffer))) (local chunks)
          (index (call std::divide (local index) (i64 32)))
          (binding chunk (type (owned-sequence ByteBuffer)))
          (in (borrow-owned-item (type (owned-sequence ByteBuffer)) (local chunk)
            (index (call std::subtract (local index)
              (call std::multiply (call std::divide (local index) (i64 32)) (i64 32))))
            (binding view (type ByteBuffer)) (in (local view)))))))))
    (owned-implementation create FlatCellReader (visibility public)
      (contract owned-read-results::IndexRead) (self CellFlat) (types OwnedI64Cell)
      (method method_8a000000000000000000000000000001 worklist-carriers::flat-cell-length)
      (method method_8a000000000000000000000000000002 flat-cell-at))
    (owned-implementation create ChunkedCellReader (visibility public)
      (contract owned-read-results::IndexRead) (self CellChunked) (types OwnedI64Cell)
      (method method_8a000000000000000000000000000001 worklist-carriers::chunked-cell-length)
      (method method_8a000000000000000000000000000002 chunked-cell-at))
    (owned-implementation create FlatBufferReader (visibility public)
      (contract owned-read-results::IndexRead) (self BufferFlat) (types ByteBuffer)
      (method method_8a000000000000000000000000000001 worklist-carriers::flat-buffer-length)
      (method method_8a000000000000000000000000000002 flat-buffer-at))
    (owned-implementation create ChunkedBufferReader (visibility public)
      (contract owned-read-results::IndexRead) (self BufferChunked) (types ByteBuffer)
      (method method_8a000000000000000000000000000001 worklist-carriers::chunked-buffer-length)
      (method method_8a000000000000000000000000000002 chunked-buffer-at))
    (function create cell-key (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (let (binding n (type I64) (call worklist-carriers::cell-read (local value)))
        (in (call std::subtract (local n)
          (call std::multiply (call std::divide (local n) (i64 4)) (i64 4)))))))
    (function create buffer-key (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (let (binding n (type I64) (call worklist-carriers::buffer-read (local value)))
        (in (call std::subtract (local n)
          (call std::multiply (call std::divide (local n) (i64 4)) (i64 4)))))))
    (owned-implementation create CellKeys (visibility public)
      (contract owned-worklists::Element) (self OwnedI64Cell)
      (method method_88000000000000000000000000000001 worklist-carriers::cell-create)
      (method method_88000000000000000000000000000002 cell-key)
      (method method_88000000000000000000000000000003 worklist-carriers::cell-finish))
    (owned-implementation create BufferKeys (visibility public)
      (contract owned-worklists::Element) (self ByteBuffer)
      (method method_88000000000000000000000000000001 worklist-carriers::buffer-create)
      (method method_88000000000000000000000000000002 buffer-key)
      (method method_88000000000000000000000000000003 worklist-carriers::buffer-finish))))
declarations.end

[Unit]
Description=Desk notebook
After=network.target

[Service]
Type=simple
User=coder
Group=coder
WorkingDirectory=/
Environment=DESK_STATE=/home/coder/.local/state/desk
Environment=DESK_BOARD=/home/coder/.local/state/cxloop
Environment=DESK_HANDOFF=/home/coder/.claude/projects/-home-coder-workspace/memory
ExecStart=/home/coder/.local/libexec/lkjscript/desk-service
StandardInput=null
StandardOutput=journal
StandardError=inherit
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/coder/.local/state/desk
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target

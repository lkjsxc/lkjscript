          (local block))
        (local output))))
    (function create scan (visibility private) (effect pure)
      (type-parameter create T (constraint transferable))
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_c7000000000000000000000000000003 reader BlockRead W (types T))

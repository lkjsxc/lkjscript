declarations.begin
(units
  (use std builtin)
  (module create blockread-protected-consume
    (function create invalid (visibility private) (effect pure)
      (parameter create input (type (list I64))) (returns I64)
      (body (let (binding storage (type (owned-sequence I64))
        (call blockread-flat::build (types I64) (local input)))
        (in (borrow-call
          (implementation-call blockread-consumer::forward-block (types I64 (owned-sequence I64))
            (implementations (implementation blockread-flat::Flat (types I64))) (i64 0) (local storage))
          (binding block (type (owned-sequence I64)))
          (in (sequence
            (call blockread-consumer::discard (types (owned-sequence I64)) (local storage))
            (call std::data-sequence-length (types I64) (local block)))))))))))
declarations.end

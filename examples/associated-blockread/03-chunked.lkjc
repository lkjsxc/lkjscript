declarations.begin
(units
  (use std builtin)
  (module create blockread-chunked
    (owned-record create ChunkBlock (visibility public)
      (type-parameter create T (constraint transferable))
      (field create items (type (owned-sequence T))))
    (owned-record create ChunkStorage (visibility public)
      (type-parameter create T (constraint transferable))
      (field create chunks (type (owned-sequence (ChunkBlock T)))))
    (function create fill-block (visibility private) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create input (type (list T))) (parameter create index (type I64))
      (parameter create stop (type I64))
      (parameter create items (type (owned-sequence T)) (use consume)) (returns (owned-sequence T))
      (body (if (call std::less (local index) (call std::list-length (types T) (local input)))
        (if (call std::less (local index) (local stop))
          (let
            (binding next-index (type I64) (call std::add (local index) (i64 1)))
            (binding next-items (type (owned-sequence T))
              (call std::data-sequence-push (types T)
                (call std::list-get (types T) (local input) (local index)) (local items)))
            (in (call fill-block (types T) (local input) (local next-index)
              (local stop) (local next-items))))
          (local items))
        (local items))))
    (function create build-loop (visibility private) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create input (type (list T))) (parameter create start (type I64))
      (parameter create chunks (type (owned-sequence (ChunkBlock T))) (use consume))
      (returns (owned-sequence (ChunkBlock T)))
      (body (if (call std::less (local start) (call std::list-length (types T) (local input)))
        (let
          (binding stop (type I64) (call std::add (local start) (i64 32)))
          (binding empty-items (type (owned-sequence T))
            (call std::data-sequence-empty (types T)))
          (binding items (type (owned-sequence T))
            (call fill-block (types T) (local input) (local start) (local stop)
              (local empty-items)))
          (binding block (type (ChunkBlock T))
            (pack-owned (type (ChunkBlock T)) (field items (local items))))
          (binding next (type (owned-sequence (ChunkBlock T)))
            (call std::sequence-push (types (ChunkBlock T)) (local block) (local chunks)))
          (in (call build-loop (types T) (local input) (call std::add (local start) (i64 32)) (local next))))
        (local chunks))))
    (function create build (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create input (type (list T))) (returns (ChunkStorage T))
      (body (let
        (binding empty-chunks (type (owned-sequence (ChunkBlock T)))
          (call std::sequence-empty (types (ChunkBlock T))))
        (binding chunks (type (owned-sequence (ChunkBlock T)))
          (call build-loop (types T) (local input) (i64 0) (local empty-chunks)))
        (in (pack-owned (type (ChunkStorage T)) (field chunks (local chunks)))))))
    (function create block-count (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create storage (type (ChunkStorage T)) (use borrow)) (returns I64)
      (body (borrow-owned-field (type (ChunkStorage T)) (local storage)
        (field chunks (binding chunks (type (owned-sequence (ChunkBlock T)))))
        (in (call std::sequence-length (types (ChunkBlock T)) (local chunks))))))
    (function create block-at (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64))
      (parameter create storage (type (ChunkStorage T)) (use borrow))
      (returns (ChunkBlock T) (borrow-from storage))
      (body (borrow-owned-field (type (ChunkStorage T)) (local storage)
        (field chunks (binding chunks (type (owned-sequence (ChunkBlock T)))))
        (in (borrow-owned-item (type (owned-sequence (ChunkBlock T))) (local chunks)
          (index (local index)) (binding block (type (ChunkBlock T))) (in (local block)))))))
    (function create block-length (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create block (type (ChunkBlock T)) (use borrow)) (returns I64)
      (body (borrow-owned-field (type (ChunkBlock T)) (local block)
        (field items (binding items (type (owned-sequence T))))
        (in (call std::data-sequence-length (types T) (local items))))))
    (function create block-get (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create index (type I64))
      (parameter create block (type (ChunkBlock T)) (use borrow)) (returns T)
      (body (borrow-owned-field (type (ChunkBlock T)) (local block)
        (field items (binding items (type (owned-sequence T))))
        (in (call std::data-sequence-get (types T) (local index) (local items))))))
    (owned-implementation create Chunked (visibility public)
      (type-parameter create T (constraint transferable))
      (contract blockread-consumer::BlockRead) (self (ChunkStorage T)) (types T)
      (associated-type assoc_type_c7000000000000000000000000000001 (ChunkBlock T))
      (method method_c7000000000000000000000000000001 block-count (types T))
      (method method_c7000000000000000000000000000002 block-at (types T))
      (method method_c7000000000000000000000000000003 block-length (types T))
      (method method_c7000000000000000000000000000004 block-get (types T)))))
declarations.end

<def>
  <name>leibniz</name>
  <fn>
    <params><n/></params>
    <*><4.0/><leibniz-acc><n/><0/><0.0/><1.0/></leibniz-acc></*>
  </fn>
</def>
<def>
  <name>leibniz-acc</name>
  <fn>
    <params><n/><i/><acc/><sign/></params>
    <if>
      <gte><i/><n/></gte>
      <acc/>
      <leibniz-next>
        <n/><i/><acc/><sign/>
      </leibniz-next>
    </if>
  </fn>
</def>
<def>
  <name>leibniz-next</name>
  <fn>
    <params><n/><i/><acc/><sign/></params>
    <leibniz-acc>
      <n/>
      <+><i/><1/></+>
      <add-term><acc/><sign/><i/></add-term>
      <-><0.0/><sign/></->
    </leibniz-acc>
  </fn>
</def>
<def>
  <name>add-term</name>
  <fn>
    <params><acc/><sign/><i/></params>
    <+><acc/><*><sign/><term-of><i/></term-of></*></+>
  </fn>
</def>
<def>
  <name>term-of</name>
  <fn>
    <params><i/></params>
    <div><1.0/><denom><i/></denom></div>
  </fn>
</def>
<def>
  <name>denom</name>
  <fn>
    <params><i/></params>
    <+><*><2.0/><i/></*><1.0/></+>
  </fn>
</def>

add.dependency package=CONTRACT_PACKAGE semantic-revision=CONTRACT_REVISION package-revision=CONTRACT_PACKAGE_REVISION
add.dependency package=CARRIERS_PACKAGE semantic-revision=CARRIERS_REVISION package-revision=CARRIERS_PACKAGE_REVISION
declarations.begin
(units
  (use std builtin)
  (use work-contract CONTRACT_PACKAGE CONTRACT_PACKAGE_REVISION)
  (use work-carriers CARRIERS_PACKAGE CARRIERS_PACKAGE_REVISION)
  (module create work
    (type-alias Pair (owned-product (field left ByteBuffer) (field right OwnedI64Cell)))
    (type-alias Result (record (payload Bytes) (buffer_sum I64) (scalar_sum I64)))
    (function create calculate (visibility private) (effect (task))
      (parameter create mode (type I64)) (parameter create n (type I64))
      (parameter create rounds (type I64)) (parameter create seed (type I64)) (returns Result)
      (body (let
        (binding octets (type ByteBuffer) (call work-carriers::produce-octets (local n) (local seed)))
        (binding scalar (type OwnedI64Cell) (call work-carriers::produce-scalar (local seed)))
        (binding pair (type Pair)
          (if (call std::i64-equal (local mode) (i64 0))
            (implementation-call work-contract::serial-pair (types ByteBuffer OwnedI64Cell)
              (implementations concrete@work-carriers::Octets concrete@work-carriers::Scalar)
              (local n) (local rounds) (local octets) (local scalar))
            (if (call std::i64-equal (local mode) (i64 1))
              (implementation-call work-contract::parallel-pair (types ByteBuffer OwnedI64Cell)
                (implementations concrete@work-carriers::Octets concrete@work-carriers::Scalar)
                (local n) (local rounds) (local octets) (local scalar))
              (implementation-call work-contract::nested-pair (types ByteBuffer OwnedI64Cell)
                (implementations concrete@work-carriers::Octets concrete@work-carriers::Scalar)
                (local n) (local rounds) (local octets) (local scalar)))))
        (in (unpack-owned (type Pair) (local pair)
          (field left (binding octets (type ByteBuffer)))
          (field right (binding scalar (type OwnedI64Cell)))
          (in (let
            (binding buffer-sum (type I64)
              (implementation-call work-contract::read (types ByteBuffer)
                (implementations concrete@work-carriers::Octets) (local octets)))
            (binding scalar-sum (type I64)
              (implementation-call work-contract::read (types OwnedI64Cell)
                (implementations concrete@work-carriers::Scalar) (local scalar)))
            (binding extracted (type I64) (call work-carriers::cell-extract (local scalar)))
            (in (record structural
              (field buffer_sum (local buffer-sum)) (field scalar_sum (local scalar-sum))
              (field payload (call std::buffer-freeze (local octets))))))))))))
    (function create serial (visibility public) (effect (task))
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create seed (type I64)) (returns Result)
      (body (call calculate (i64 0) (local n) (local rounds) (local seed))))
    (function create parallel (visibility public) (effect (task))
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create seed (type I64)) (returns Result)
      (body (call calculate (i64 1) (local n) (local rounds) (local seed))))
    (function create nested (visibility public) (effect (task))
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create seed (type I64)) (returns Result)
      (body (call calculate (i64 2) (local n) (local rounds) (local seed))))
    (component create command (visibility private)
      (port create serial (type (task-function (I64 I64 I64) Result (row))) (function serial))
      (port create parallel (type (task-function (I64 I64 I64) Result (row))) (function parallel))
      (port create nested (type (task-function (I64 I64 I64) Result (row))) (function nested))))
  (target create serial (component work::command) (runner command) (port work::command::serial))
  (target create parallel (component work::command) (runner command) (port work::command::parallel))
  (target create nested (component work::command) (runner command) (port work::command::nested)))
declarations.end

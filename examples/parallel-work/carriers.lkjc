add.dependency package=CONTRACT_PACKAGE semantic-revision=CONTRACT_REVISION package-revision=CONTRACT_PACKAGE_REVISION
declarations.begin
(units
  (use std builtin)
  (use work-contract CONTRACT_PACKAGE CONTRACT_PACKAGE_REVISION)
  (module create work-carriers
    (external create cell-create (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create cell-read (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create cell-replace (visibility private) (implementation core.cell.replace)
      (parameter create n (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell))
    (external create cell-extract (visibility public) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create octet (visibility private) (effect pure)
      (parameter create value (type I64)) (returns I64)
      (body (call std::subtract (local value)
        (call std::multiply (i64 256) (call std::divide (local value) (i64 256))))))
    (function create transform-octet (visibility private) (effect pure)
      (parameter create rounds (type I64)) (parameter create value (type I64)) (returns I64)
      (body (if (call std::less (local rounds) (i64 1)) (local value)
        (call transform-octet (call std::subtract (local rounds) (i64 1))
          (call octet (call std::add (call std::multiply (i64 37) (local value)) (i64 11)))))))
    (function create produce-loop (visibility private) (effect pure)
      (parameter create n (type I64)) (parameter create seed (type I64))
      (parameter create index (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (if (call std::less (local index) (local n))
        (let (binding next (type ByteBuffer)
          (call std::buffer-push (call octet (call std::add (local seed) (local index))) (local value)))
          (in (call produce-loop (local n) (local seed)
            (call std::add (local index) (i64 1)) (local next))))
        (local value))))
    (function create produce-octets (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create seed (type I64)) (returns ByteBuffer)
      (body (let (binding value (type ByteBuffer) (call std::buffer-empty))
        (in (call produce-loop (local n) (local seed) (i64 0) (local value))))))
    (function create produce-scalar (visibility public) (effect pure)
      (parameter create seed (type I64)) (returns OwnedI64Cell) (body (call cell-create (local seed))))
    (function create octets-loop (visibility private) (effect pure)
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create index (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (if (call std::less (local index) (local n))
        (let
          (binding transformed (type I64)
            (call transform-octet (local rounds) (call std::buffer-get (local index) (local value))))
          (binding next (type ByteBuffer) (call std::buffer-push (local transformed) (local value)))
          (in (call octets-loop (local n) (local rounds)
            (call std::add (local index) (i64 1)) (local next))))
        (local value))))
    (function create apply-octets (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (call octets-loop (local n) (local rounds) (i64 0) (local value))))
    (function create checksum-loop (visibility private) (effect pure)
      (parameter create n (type I64)) (parameter create index (type I64))
      (parameter create total (type I64))
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (if (call std::less (local index) (local n))
        (call checksum-loop (local n) (call std::add (local index) (i64 1))
          (call std::add (local total)
            (call std::multiply (call std::add (local index) (i64 1))
              (call std::buffer-get (call std::add (local n) (local index)) (local value))))
          (local value))
        (local total))))
    (function create read-octets (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (call checksum-loop (call std::divide (call std::buffer-length (local value)) (i64 2))
        (i64 0) (i64 0) (local value))))
    (function create scalar-loop (visibility private) (effect pure)
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create seed (type I64)) (parameter create index (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell)
      (body (if (call std::less (local index) (local n))
        (let
          (binding transformed (type I64)
            (call transform-octet (local rounds) (call octet (call std::add (local seed) (local index)))))
          (binding next (type OwnedI64Cell)
            (call cell-replace
              (call std::add (call cell-read (local value))
                (call std::multiply (call std::add (local index) (i64 1)) (local transformed)))
              (local value)))
          (in (call scalar-loop (local n) (local rounds) (local seed)
            (call std::add (local index) (i64 1)) (local next))))
        (local value))))
    (function create apply-scalar (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create rounds (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell)
      (body (let
        (binding seed (type I64) (call cell-read (local value)))
        (binding cleared (type OwnedI64Cell) (call cell-replace (i64 0) (local value)))
        (in (call scalar-loop (local n) (local rounds) (local seed) (i64 0) (local cleared))))))
    (function create read-scalar (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (call cell-read (local value))))
    (owned-implementation create Octets (visibility public) (contract work-contract::Work) (self ByteBuffer)
      (method method_95000000000000000000000000000001 apply-octets)
      (method method_95000000000000000000000000000002 read-octets))
    (owned-implementation create Scalar (visibility public) (contract work-contract::Work) (self OwnedI64Cell)
      (method method_95000000000000000000000000000001 apply-scalar)
      (method method_95000000000000000000000000000002 read-scalar))))
declarations.end

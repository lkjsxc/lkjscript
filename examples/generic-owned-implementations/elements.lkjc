declarations.begin
(units
  (use std builtin)
  (module create generic-elements
    (type-alias Inner (owned-product (field cell OwnedI64Cell) (field tag I64)))
    (type-alias Product (owned-product (field payload Inner) (field stamp I64)))
    (external create new-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create read-cell (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create extract-cell (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create cell-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns OwnedI64Cell) (body (call new-cell (local n))))
    (function create cell-observe (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (call read-cell (local value))))
    (function create cell-finish (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64)
      (body (call extract-cell (local value))))
    (function create buffer-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns ByteBuffer)
      (body (let (binding value (type ByteBuffer) (call std::buffer-empty))
        (in (call std::buffer-push (local n) (local value))))))
    (function create buffer-observe (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (call std::buffer-get (i64 0) (local value))))
    (function create buffer-finish (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use consume)) (returns I64)
      (body (let (binding n (type I64) (call std::buffer-get (i64 0) (local value)))
        (in (sequence (call std::buffer-discard (local value)) (local n))))))
    (function create product-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns Product)
      (body (let
        (binding cell (type OwnedI64Cell) (call new-cell (local n)))
        (binding payload (type Inner)
          (pack-owned (type Inner) (field cell (local cell)) (field tag (i64 5))))
        (in (pack-owned (type Product)
          (field payload (local payload)) (field stamp (i64 7)))))))
    (function create product-observe (visibility public) (effect pure)
      (parameter create value (type Product) (use borrow)) (returns I64)
      (body (borrow-owned-field (type Product) (local value)
        (field payload (binding payload (type Inner)))
        (in (borrow-owned-field (type Inner) (local payload)
          (field cell (binding cell (type OwnedI64Cell)))
          (in (call std::add (call read-cell (local cell))
            (call std::add (field (local payload) (name tag))
              (field (local value) (name stamp))))))))))
    (function create product-finish (visibility public) (effect pure)
      (parameter create value (type Product) (use consume)) (returns I64)
      (body (unpack-owned (type Product) (local value)
        (field payload (binding payload (type Inner))) (field stamp (binding stamp (type I64)))
        (in (unpack-owned (type Inner) (local payload)
          (field cell (binding cell (type OwnedI64Cell))) (field tag (binding tag (type I64)))
          (in (call std::add (call extract-cell (local cell))
            (call std::add (local tag) (local stamp)))))))))
    (function create cell-key (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (let (binding n (type I64) (call cell-observe (local value)))
        (in (call std::subtract (local n) (call std::multiply (call std::divide (local n) (i64 4)) (i64 4)))))))
    (function create buffer-key (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (let (binding n (type I64) (call buffer-observe (local value)))
        (in (call std::subtract (local n) (call std::multiply (call std::divide (local n) (i64 4)) (i64 4)))))))
    (function create product-key (visibility public) (effect pure)
      (parameter create value (type Product) (use borrow)) (returns I64)
      (body (let (binding n (type I64) (call product-observe (local value)))
        (in (call std::subtract (local n) (call std::multiply (call std::divide (local n) (i64 4)) (i64 4)))))))
    (owned-implementation create Cells (visibility public)
      (contract owned-worklists::Element) (self OwnedI64Cell)
      (method method_88000000000000000000000000000001 cell-create)
      (method method_88000000000000000000000000000002 cell-observe)
      (method method_88000000000000000000000000000003 cell-finish))
    (owned-implementation create Buffers (visibility public)
      (contract owned-worklists::Element) (self ByteBuffer)
      (method method_88000000000000000000000000000001 buffer-create)
      (method method_88000000000000000000000000000002 buffer-observe)
      (method method_88000000000000000000000000000003 buffer-finish))
    (owned-implementation create Products (visibility public)
      (contract owned-worklists::Element) (self Product)
      (method method_88000000000000000000000000000001 product-create)
      (method method_88000000000000000000000000000002 product-observe)
      (method method_88000000000000000000000000000003 product-finish))
    (owned-implementation create CellKeys (visibility public)
      (contract owned-worklists::Element) (self OwnedI64Cell)
      (method method_88000000000000000000000000000001 cell-create)
      (method method_88000000000000000000000000000002 cell-key)
      (method method_88000000000000000000000000000003 cell-finish))
    (owned-implementation create BufferKeys (visibility public)
      (contract owned-worklists::Element) (self ByteBuffer)
      (method method_88000000000000000000000000000001 buffer-create)
      (method method_88000000000000000000000000000002 buffer-key)
      (method method_88000000000000000000000000000003 buffer-finish))
    (owned-implementation create ProductKeys (visibility public)
      (contract owned-worklists::Element) (self Product)
      (method method_88000000000000000000000000000001 product-create)
      (method method_88000000000000000000000000000002 product-key)
      (method method_88000000000000000000000000000003 product-finish))))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create generic-owned-app
    (type-alias CellFlat (owned-sequence OwnedI64Cell))
    (type-alias CellChunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (type-alias BufferFlat (owned-sequence ByteBuffer))
    (type-alias BufferChunked (owned-product
      (field chunks (owned-sequence (owned-sequence ByteBuffer))) (field size I64)))
    (type-alias Product (owned-product
      (field payload (owned-product (field cell OwnedI64Cell) (field tag I64))) (field stamp I64)))
    (type-alias ProductFlat (owned-sequence Product))
    (type-alias ProductChunked (owned-product
      (field chunks (owned-sequence (owned-sequence Product))) (field size I64)))
    (type-alias Scenario (record (length I64) (selected (list I64))
      (tied-selected (list I64)) (drained (list I64)) (empty-length I64) (reused (list I64)) (moved (list I64))))
    (type-alias Result (record
      (cell-flat Scenario) (cell-chunked Scenario) (buffer-flat Scenario) (buffer-chunked Scenario)
      (product-flat Scenario) (product-chunked Scenario) (cell-reverse Scenario)))
    (function create transfer (visibility private) (effect pure)
      (type-parameter create T (constraint owned)) (type-parameter create W (constraint owned))
      (type-parameter create V (constraint owned))
      (implementation-parameter implparam_8c000000000000000000000000000001 element owned-worklists::Element T)
      (implementation-parameter implparam_8c000000000000000000000000000002 source owned-worklists::Worklist W (types T))
      (implementation-parameter implparam_8c000000000000000000000000000003 destination owned-worklists::Worklist V (types T))
      (parameter create inputs (type (list I64))) (returns (list I64))
      (body (let
        (binding source (type W)
          (implementation-call owned-worklists::build (types T W)
            (implementations parameter@transfer@implparam_8c000000000000000000000000000001
              parameter@transfer@implparam_8c000000000000000000000000000002) (local inputs)))
        (binding destination (type V)
          (method-call parameter@transfer@implparam_8c000000000000000000000000000003
            owned-worklists::Worklist method_88000000000000000000000000000011))
        (binding moved (type (owned-product (field source W) (field destination V)))
          (implementation-call owned-worklists::move-all (types T W V)
            (implementations parameter@transfer@implparam_8c000000000000000000000000000002
              parameter@transfer@implparam_8c000000000000000000000000000003)
            (local source) (local destination)))
        (in (unpack-owned (type (owned-product (field source W) (field destination V))) (local moved)
          (field source (binding empty-source (type W))) (field destination (binding destination (type V)))
          (in (let (binding drained (type (owned-product (field rest V) (field values (list I64))))
            (implementation-call owned-worklists::drain (types T V)
              (implementations parameter@transfer@implparam_8c000000000000000000000000000001
                parameter@transfer@implparam_8c000000000000000000000000000003) (local destination)))
            (in (unpack-owned (type (owned-product (field rest V) (field values (list I64)))) (local drained)
              (field rest (binding rest (type V))) (field values (binding values (type (list I64))))
              (in (local values)))))))))))
    (function create scenario (visibility private) (effect pure)
      (type-parameter create T (constraint owned)) (type-parameter create W (constraint owned))
      (type-parameter create V (constraint owned))
      (implementation-parameter implparam_8a000000000000000000000000000011 element owned-worklists::Element T)
      (implementation-parameter implparam_8a000000000000000000000000000012 keys owned-worklists::Element T)
      (implementation-parameter implparam_8a000000000000000000000000000013 work owned-worklists::Worklist W (types T))
      (implementation-parameter implparam_8a000000000000000000000000000014 reader owned-read-results::IndexRead W (types T))
      (implementation-parameter implparam_8c000000000000000000000000000004 destination owned-worklists::Worklist V (types T))
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (let
        (binding storage (type W)
          (implementation-call owned-worklists::build (types T W)
            (implementations parameter@scenario@implparam_8a000000000000000000000000000011
              parameter@scenario@implparam_8a000000000000000000000000000013) (local inputs)))
        (binding length (type I64)
          (method-call parameter@scenario@implparam_8a000000000000000000000000000014
            owned-read-results::IndexRead method_8a000000000000000000000000000001 (local storage)))
        (binding selected (type (list I64))
          (if (call std::i64-equal (local length) (i64 0)) (list I64)
            (borrow-call
              (implementation-call owned-read-results::select-max (types T W)
                (implementations parameter@scenario@implparam_8a000000000000000000000000000011
                  parameter@scenario@implparam_8a000000000000000000000000000014) (local storage))
              (binding view (type T))
              (in (list I64
                (method-call parameter@scenario@implparam_8a000000000000000000000000000011
                  owned-worklists::Element method_88000000000000000000000000000002 (local view)))))))
        (binding tied-selected (type (list I64))
          (if (call std::i64-equal (local length) (i64 0)) (list I64)
            (borrow-call
              (implementation-call owned-read-results::select-max (types T W)
                (implementations parameter@scenario@implparam_8a000000000000000000000000000012
                  parameter@scenario@implparam_8a000000000000000000000000000014) (local storage))
              (binding view (type T))
              (in (list I64
                (method-call parameter@scenario@implparam_8a000000000000000000000000000011
                  owned-worklists::Element method_88000000000000000000000000000002 (local view)))))))
        (binding drained (type (owned-product (field rest W) (field values (list I64))))
          (implementation-call owned-worklists::drain (types T W)
            (implementations parameter@scenario@implparam_8a000000000000000000000000000011
              parameter@scenario@implparam_8a000000000000000000000000000013) (local storage)))
        (in (unpack-owned (type (owned-product (field rest W) (field values (list I64)))) (local drained)
          (field rest (binding rest (type W))) (field values (binding drained-values (type (list I64))))
          (in (let
            (binding empty-length (type I64)
              (method-call parameter@scenario@implparam_8a000000000000000000000000000014
                owned-read-results::IndexRead method_8a000000000000000000000000000001 (local rest)))
            (binding value (type T)
              (method-call parameter@scenario@implparam_8a000000000000000000000000000011
                owned-worklists::Element method_88000000000000000000000000000001 (i64 17)))
            (binding next (type W)
              (method-call parameter@scenario@implparam_8a000000000000000000000000000013
                owned-worklists::Worklist method_88000000000000000000000000000013 (local value) (local rest)))
            (binding reused (type (owned-product (field rest W) (field values (list I64))))
              (implementation-call owned-worklists::drain (types T W)
                (implementations parameter@scenario@implparam_8a000000000000000000000000000011
                  parameter@scenario@implparam_8a000000000000000000000000000013) (local next)))
            (in (unpack-owned (type (owned-product (field rest W) (field values (list I64)))) (local reused)
              (field rest (binding final-rest (type W))) (field values (binding reused-values (type (list I64))))
              (in (record structural
                (field length (local length)) (field selected (local selected)) (field tied-selected (local tied-selected))
                (field drained (local drained-values)) (field empty-length (local empty-length))
                (field reused (local reused-values))
                (field moved
                  (implementation-call transfer (types T W V)
                    (implementations parameter@scenario@implparam_8a000000000000000000000000000011
                      parameter@scenario@implparam_8a000000000000000000000000000013
                      parameter@scenario@implparam_8c000000000000000000000000000004)
                    (local inputs))))))))))))))
    (function create cell-flat (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types OwnedI64Cell CellFlat CellChunked)
        (implementations concrete@generic-elements::Cells concrete@generic-elements::CellKeys
          (implementation generic-storage::Flat (types OwnedI64Cell)) (implementation generic-storage::FlatReader (types OwnedI64Cell))
          (implementation generic-storage::Chunked (types OwnedI64Cell))) (local inputs))))
    (function create cell-chunked (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types OwnedI64Cell CellChunked CellFlat)
        (implementations concrete@generic-elements::Cells concrete@generic-elements::CellKeys
          (implementation generic-storage::Chunked (types OwnedI64Cell)) (implementation generic-storage::ChunkedReader (types OwnedI64Cell))
          (implementation generic-storage::Flat (types OwnedI64Cell))) (local inputs))))
    (function create buffer-flat (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types ByteBuffer BufferFlat BufferChunked)
        (implementations concrete@generic-elements::Buffers concrete@generic-elements::BufferKeys
          (implementation generic-storage::Flat (types ByteBuffer)) (implementation generic-storage::FlatReader (types ByteBuffer))
          (implementation generic-storage::Chunked (types ByteBuffer))) (local inputs))))
    (function create buffer-chunked (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types ByteBuffer BufferChunked BufferFlat)
        (implementations concrete@generic-elements::Buffers concrete@generic-elements::BufferKeys
          (implementation generic-storage::Chunked (types ByteBuffer)) (implementation generic-storage::ChunkedReader (types ByteBuffer))
          (implementation generic-storage::Flat (types ByteBuffer))) (local inputs))))
    (function create product-flat (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types Product ProductFlat ProductChunked)
        (implementations generic-elements::Products generic-elements::ProductKeys
          (implementation generic-storage::Flat (types Product)) (implementation generic-storage::FlatReader (types Product))
          (implementation generic-storage::Chunked (types Product))) (local inputs))))
    (function create product-chunked (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types Product ProductChunked ProductFlat)
        (implementations generic-elements::Products generic-elements::ProductKeys
          (implementation generic-storage::Chunked (types Product)) (implementation generic-storage::ChunkedReader (types Product))
          (implementation generic-storage::Flat (types Product))) (local inputs))))
    (function create cell-reverse (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Scenario)
      (body (implementation-call scenario (types OwnedI64Cell CellFlat CellChunked)
        (implementations generic-elements::Cells generic-elements::CellKeys
          (implementation generic-storage::Flat (types OwnedI64Cell)) (implementation generic-storage::ReverseReader (types OwnedI64Cell))
          (implementation generic-storage::Chunked (types OwnedI64Cell))) (local inputs))))
    (function create direct-length (visibility public) (effect pure) (returns I64)
      (body (let (binding values (type ProductFlat)
        (implementation-call generic-storage::flat-build (types Product)
          (implementations generic-elements::Products) (list I64 (i64 42))))
        (in (method-call (implementation generic-storage::FlatReader (types Product))
          owned-read-results::IndexRead method_8a000000000000000000000000000001 (local values))))))
    (function create measure (visibility private) (effect (task))
      (type-parameter create T (constraint owned transferable))
      (parameter create storage (type (owned-sequence T)) (use consume)) (returns I64)
      (body (method-call (implementation generic-storage::SequenceTask (types T))
        generic-storage::LengthTask method_8c000000000000000000000000000001 (local storage))))
    (function create parallel-measure (visibility private) (effect (task))
      (type-parameter create T (constraint owned transferable))
      (type-parameter create U (constraint owned transferable))
      (parameter create left (type (owned-sequence T)) (use consume))
      (parameter create right (type (owned-sequence U)) (use consume))
      (returns (record (left I64) (right I64)))
      (body (parallel (call measure (types T) (local left))
        (call measure (types U) (local right)))))
    (function create parallel-lengths (visibility public) (effect (task))
      (parameter create inputs (type (list I64))) (returns (record (left I64) (right I64)))
      (body (let
        (binding cells (type CellFlat)
          (implementation-call generic-storage::flat-build (types OwnedI64Cell)
            (implementations generic-elements::Cells) (local inputs)))
        (binding buffers (type BufferFlat)
          (implementation-call generic-storage::flat-build (types ByteBuffer)
            (implementations generic-elements::Buffers) (local inputs)))
        (in (call parallel-measure (types OwnedI64Cell ByteBuffer) (local cells) (local buffers))))))
    (function create main (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns Result)
      (body (record structural
        (field cell-flat (call cell-flat (local inputs)))
        (field cell-chunked (call cell-chunked (local inputs)))
        (field buffer-flat (call buffer-flat (local inputs)))
        (field buffer-chunked (call buffer-chunked (local inputs)))
        (field product-flat (call product-flat (local inputs)))
        (field product-chunked (call product-chunked (local inputs)))
        (field cell-reverse (call cell-reverse (local inputs))))))
    (component create command (visibility private)
      (port create main (type (function ((list I64)) Result)) (function main))
      (port create cell-flat (type (function ((list I64)) Scenario)) (function cell-flat))
      (port create cell-chunked (type (function ((list I64)) Scenario)) (function cell-chunked))
      (port create buffer-flat (type (function ((list I64)) Scenario)) (function buffer-flat))
      (port create buffer-chunked (type (function ((list I64)) Scenario)) (function buffer-chunked))
      (port create product-flat (type (function ((list I64)) Scenario)) (function product-flat))
      (port create product-chunked (type (function ((list I64)) Scenario)) (function product-chunked))
      (port create cell-reverse (type (function ((list I64)) Scenario)) (function cell-reverse))
      (port create direct-length (type (function () I64)) (function direct-length))
      (port create parallel-lengths (type (task-function ((list I64)) (record (left I64) (right I64)) (row)))
        (function parallel-lengths))))
  (target create generic-owned-implementations (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::main))
  (target create generic-cell-flat (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::cell-flat))
  (target create generic-cell-chunked (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::cell-chunked))
  (target create generic-buffer-flat (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::buffer-flat))
  (target create generic-buffer-chunked (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::buffer-chunked))
  (target create generic-product-flat (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::product-flat))
  (target create generic-product-chunked (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::product-chunked))
  (target create generic-cell-reverse (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::cell-reverse))
  (target create generic-direct-length (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::direct-length))
  (target create generic-parallel-lengths (component generic-owned-app::command)
    (runner command) (port generic-owned-app::command::parallel-lengths)))
declarations.end

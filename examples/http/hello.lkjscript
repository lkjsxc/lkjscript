import/ "examples/http/resp.lkjscript" /import
import/ "std/net/tcp-listen.lkjscript" /import
import/ "std/net/tcp-accept.lkjscript" /import
import/ "std/net/tcp-recv.lkjscript" /import
import/ "std/net/tcp-send.lkjscript" /import
def/
  name/ "serve-once" /name
  fn/
    sig/ Handle -> Nil /sig
    params/ lis Handle /params
    serve-cli/ tcp-accept/ lis /tcp-accept /serve-cli
  /fn
/def
def/
  name/ "serve-cli" /name
  fn/
    sig/ Handle -> Nil /sig
    params/ cli Handle /params
    do/
      tcp-recv/ cli /tcp-recv
      tcp-send/ cli hello-resp/ /hello-resp /tcp-send
      close/ cli /close
    /do
  /fn
/def
do/
  let/
    bind/ lis tcp-listen/ 8080 /tcp-listen /bind
    do/
      serve-once/ lis /serve-once
      close/ lis /close
    /do
  /let
/do

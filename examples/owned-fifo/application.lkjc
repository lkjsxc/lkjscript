declarations.begin
(units
  (use std builtin)
  (module create fifo-app
    (type-alias Action (record (kind I64) (value I64)))
    (type-alias Event (record (kind I64) (present Bool) (value I64) (length I64)))
    (type-alias Scenario (record (events (list Event)) (remaining (list I64)) (empty-length I64) (reused (list I64))))
    (type-alias Packet (owned-product (field payload ByteBuffer) (field stamp I64)))
    (type-alias Cells (owned-product (field incoming (owned-sequence OwnedI64Cell)) (field outgoing (owned-sequence OwnedI64Cell))))
    (type-alias CellItem (owned-product (field rest Cells) (field value OwnedI64Cell)))
    (type-alias CellPop (owned-choice (case empty Cells) (case item CellItem)))
    (type-alias Forwarded (record (peek I64) (removed I64) (empty I64)))
    (function create cells (visibility public) (effect pure)
      (parameter create actions (type (list Action))) (returns Scenario)
      (body (implementation-call fifo-trace::run (types OwnedI64Cell)
        (implementations fifo-elements::Cells) (local actions))))
    (function create buffers (visibility public) (effect pure)
      (parameter create actions (type (list Action))) (returns Scenario)
      (body (implementation-call fifo-trace::run (types ByteBuffer)
        (implementations fifo-elements::Buffers) (local actions))))
    (function create packets (visibility public) (effect pure)
      (parameter create actions (type (list Action))) (returns Scenario)
      (body (implementation-call fifo-trace::run (types Packet)
        (implementations fifo-elements::Packets) (local actions))))
    (function create cells-batch (visibility public) (effect pure)
      (parameter create cases (type (list (list Action)))) (returns (list Scenario))
      (body (call std::list-map (types (list Action) Scenario) (local cases) (function-value cells))))
    (function create buffers-batch (visibility public) (effect pure)
      (parameter create cases (type (list (list Action)))) (returns (list Scenario))
      (body (call std::list-map (types (list Action) Scenario) (local cases) (function-value buffers))))
    (function create packets-batch (visibility public) (effect pure)
      (parameter create cases (type (list (list Action)))) (returns (list Scenario))
      (body (call std::list-map (types (list Action) Scenario) (local cases) (function-value packets))))
    (function create forwarded-front (visibility private) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create queue (type (owned-product
        (field incoming (owned-sequence T)) (field outgoing (owned-sequence T)))) (use borrow))
      (returns T (borrow-from queue))
      (body (borrow-call (call std::fifo-front (types T) (local queue))
        (binding value (type T)) (in (local value)))))
    (function create forwarded (visibility public) (effect pure)
      (parameter create n (type I64)) (returns Forwarded)
      (body (let
        (binding queue (type Cells) (call std::fifo-empty (types OwnedI64Cell)))
        (binding value (type OwnedI64Cell) (call fifo-elements::cell-new (local n)))
        (binding queue (type Cells) (call std::fifo-push (types OwnedI64Cell) (local value) (local queue)))
        (binding peek (type I64) (borrow-call (call forwarded-front (types OwnedI64Cell) (local queue))
          (binding value (type OwnedI64Cell)) (in (call fifo-elements::cell-read (local value)))))
        (binding popped (type CellPop) (call std::fifo-pop (types OwnedI64Cell) (local queue)))
        (in (match-owned (type CellPop) (local popped)
          (case empty (binding rest (type Cells))
            (in (record structural (field peek (i64 0)) (field removed (i64 0)) (field empty (i64 -1)))))
          (case item (binding item (type CellItem))
            (in (unpack-owned (type CellItem) (local item)
              (field rest (binding rest (type Cells))) (field value (binding value (type OwnedI64Cell)))
              (in (record structural (field peek (local peek))
                (field removed (call fifo-elements::cell-finish (local value)))
                (field empty (call std::fifo-length (types OwnedI64Cell) (local rest)))))))))))))
    (function create empty-front (visibility public) (effect pure)
      (parameter create inputs (type (list I64))) (returns I64)
      (body (let (binding queue (type Cells) (call std::fifo-empty (types OwnedI64Cell)))
        (in (borrow-call (call forwarded-front (types OwnedI64Cell) (local queue))
          (binding value (type OwnedI64Cell)) (in (call fifo-elements::cell-read (local value))))))))
    (component create command (visibility private)
      (port create cells-batch (type (function ((list (list Action))) (list Scenario))) (function cells-batch))
      (port create buffers-batch (type (function ((list (list Action))) (list Scenario))) (function buffers-batch))
      (port create packets-batch (type (function ((list (list Action))) (list Scenario))) (function packets-batch))
      (port create cells (type (function ((list Action)) Scenario)) (function cells))
      (port create buffers (type (function ((list Action)) Scenario)) (function buffers))
      (port create packets (type (function ((list Action)) Scenario)) (function packets))
      (port create forwarded (type (function (I64) Forwarded)) (function forwarded))
      (port create empty-front (type (function ((list I64)) I64)) (function empty-front))))
  (target create fifo-cells-batch (component fifo-app::command) (runner command) (port fifo-app::command::cells-batch))
  (target create fifo-buffers-batch (component fifo-app::command) (runner command) (port fifo-app::command::buffers-batch))
  (target create fifo-packets-batch (component fifo-app::command) (runner command) (port fifo-app::command::packets-batch))
  (target create fifo-cells (component fifo-app::command) (runner command) (port fifo-app::command::cells))
  (target create fifo-buffers (component fifo-app::command) (runner command) (port fifo-app::command::buffers))
  (target create fifo-packets (component fifo-app::command) (runner command) (port fifo-app::command::packets))
  (target create fifo-forwarded (component fifo-app::command) (runner command) (port fifo-app::command::forwarded))
  (target create fifo-empty-front (component fifo-app::command) (runner command) (port fifo-app::command::empty-front)))
declarations.end

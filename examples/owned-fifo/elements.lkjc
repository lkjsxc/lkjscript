declarations.begin
(units
  (use std builtin)
  (module create fifo-elements
    (type-alias Packet (owned-product (field payload ByteBuffer) (field stamp I64)))
    (external create raw-cell-new (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create raw-cell-read (visibility private) (implementation core.cell.read)
      (parameter create cell (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create raw-cell-finish (visibility private) (implementation core.cell.extract)
      (parameter create cell (type OwnedI64Cell) (use consume)) (returns I64))
    (function create cell-new (visibility public) (effect pure)
      (parameter create n (type I64)) (returns OwnedI64Cell)
      (body (call raw-cell-new (local n))))
    (function create cell-read (visibility public) (effect pure)
      (parameter create cell (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (call raw-cell-read (local cell))))
    (function create cell-finish (visibility public) (effect pure)
      (parameter create cell (type OwnedI64Cell) (use consume)) (returns I64)
      (body (call raw-cell-finish (local cell))))
    (function create buffer-new (visibility public) (effect pure)
      (parameter create n (type I64)) (returns ByteBuffer)
      (body (let (binding buffer (type ByteBuffer) (call std::buffer-empty))
        (binding buffer (type ByteBuffer) (call std::buffer-push (local n) (local buffer)))
        (in (call std::buffer-push (call std::subtract (i64 255) (local n)) (local buffer))))))
    (function create buffer-read (visibility public) (effect pure)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64)
      (body (call std::add (call std::multiply (call std::buffer-get (i64 0) (local buffer)) (i64 256))
        (call std::buffer-get (i64 1) (local buffer)))))
    (function create buffer-finish (visibility public) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns I64)
      (body (let (binding bytes (type Bytes) (call std::buffer-freeze (local buffer)))
        (in (call std::add (call std::multiply (call std::bytes-get (local bytes) (i64 0)) (i64 256))
          (call std::bytes-get (local bytes) (i64 1)))))))
    (function create packet-new (visibility public) (effect pure)
      (parameter create n (type I64)) (returns Packet)
      (body (let (binding buffer (type ByteBuffer) (call buffer-new (local n)))
        (in (pack-owned (type Packet) (field payload (local buffer)) (field stamp (i64 31)))))))
    (function create packet-read (visibility public) (effect pure)
      (parameter create packet (type Packet) (use borrow)) (returns I64)
      (body (borrow-owned-field (type Packet) (local packet)
        (field payload (binding buffer (type ByteBuffer)))
        (in (call std::add (call buffer-read (local buffer)) (field (local packet) (name stamp)))))))
    (function create packet-finish (visibility public) (effect pure)
      (parameter create packet (type Packet) (use consume)) (returns I64)
      (body (unpack-owned (type Packet) (local packet)
        (field payload (binding buffer (type ByteBuffer))) (field stamp (binding stamp (type I64)))
        (in (call std::add (call buffer-finish (local buffer)) (local stamp))))))
    (owned-implementation create Cells (visibility public)
      (contract fifo-support::Element) (self OwnedI64Cell)
      (method method_94000000000000000000000000000001 cell-new)
      (method method_94000000000000000000000000000002 cell-read)
      (method method_94000000000000000000000000000003 cell-finish))
    (owned-implementation create Buffers (visibility public)
      (contract fifo-support::Element) (self ByteBuffer)
      (method method_94000000000000000000000000000001 buffer-new)
      (method method_94000000000000000000000000000002 buffer-read)
      (method method_94000000000000000000000000000003 buffer-finish))
    (owned-implementation create Packets (visibility public)
      (contract fifo-support::Element) (self Packet)
      (method method_94000000000000000000000000000001 packet-new)
      (method method_94000000000000000000000000000002 packet-read)
      (method method_94000000000000000000000000000003 packet-finish))))
declarations.end

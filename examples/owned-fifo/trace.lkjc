declarations.begin
(units
  (use std builtin)
  (module create fifo-trace
    (type-alias Action (record (kind I64) (value I64)))
    (type-alias Event (record (kind I64) (present Bool) (value I64) (length I64)))
    (type-alias Scenario (record (events (list Event)) (remaining (list I64)) (empty-length I64) (reused (list I64))))
    (function create finish (visibility private) (effect pure)

declarations.begin
(units
  (use std builtin)
  (module create worklist-carriers
    (type-alias CellFlat (owned-sequence OwnedI64Cell))
    (type-alias CellChunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (type-alias BufferFlat (owned-sequence ByteBuffer))
    (type-alias BufferChunked (owned-product
      (field chunks (owned-sequence (owned-sequence ByteBuffer))) (field size I64)))
    (type-alias CellFlatPop (owned-choice (case empty CellFlat)
      (case item (owned-product (field rest CellFlat) (field value OwnedI64Cell)))))
    (type-alias CellChunkedPop (owned-choice (case empty CellChunked)
      (case item (owned-product (field rest CellChunked) (field value OwnedI64Cell)))))
    (type-alias BufferFlatPop (owned-choice (case empty BufferFlat)
      (case item (owned-product (field rest BufferFlat) (field value ByteBuffer)))))
    (type-alias BufferChunkedPop (owned-choice (case empty BufferChunked)
      (case item (owned-product (field rest BufferChunked) (field value ByteBuffer)))))
    (external create new-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create read-cell (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create extract-cell (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create cell-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns OwnedI64Cell) (body (call new-cell (local n))))
    (function create cell-read (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (call read-cell (local value))))
    (function create cell-finish (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64)
      (body (call extract-cell (local value))))
    (function create buffer-create (visibility public) (effect pure)
      (parameter create n (type I64)) (returns ByteBuffer)
      (body (let (binding value (type ByteBuffer) (call std::buffer-empty))
        (in (call std::buffer-push (local n) (local value))))))
    (function create buffer-read (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64)
      (body (call std::buffer-get (i64 0) (local value))))
    (function create buffer-finish (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use consume)) (returns I64)
      (body (let (binding n (type I64) (call std::buffer-get (i64 0) (local value)))
        (in (sequence (call std::buffer-discard (local value)) (local n))))))
    (owned-implementation create Scalar (visibility public)
      (contract owned-worklists::Element) (self OwnedI64Cell)
      (method method_88000000000000000000000000000001 cell-create)
      (method method_88000000000000000000000000000002 cell-read)
      (method method_88000000000000000000000000000003 cell-finish))
    (owned-implementation create Octets (visibility public)
      (contract owned-worklists::Element) (self ByteBuffer)
      (method method_88000000000000000000000000000001 buffer-create)
      (method method_88000000000000000000000000000002 buffer-read)
      (method method_88000000000000000000000000000003 buffer-finish))
    (function create flat-cell-empty (visibility public) (effect pure) (returns CellFlat)
      (body (sequence-empty (type CellFlat))))
    (function create flat-cell-length (visibility public) (effect pure)
      (parameter create values (type CellFlat) (use borrow)) (returns I64)
      (body (sequence-length (type CellFlat) (local values))))
    (function create flat-cell-push (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use consume))
      (parameter create values (type CellFlat) (use consume)) (returns CellFlat)
      (body (sequence-push (type CellFlat) (local value) (local values))))
    (function create flat-cell-pop (visibility public) (effect pure)
      (parameter create values (type CellFlat) (use consume)) (returns CellFlatPop)
      (body (sequence-pop (type CellFlat) (local values))))
    (owned-implementation create FlatCells (visibility public)
      (contract owned-worklists::Worklist) (self CellFlat) (types OwnedI64Cell)
      (method method_88000000000000000000000000000011 flat-cell-empty)
      (method method_88000000000000000000000000000012 flat-cell-length)
      (method method_88000000000000000000000000000013 flat-cell-push)
      (method method_88000000000000000000000000000014 flat-cell-pop))
    (function create chunked-cell-empty (visibility public) (effect pure) (returns CellChunked)
      (body (call owned-worklists::chunk-empty (types OwnedI64Cell))))
    (function create chunked-cell-length (visibility public) (effect pure)
      (parameter create values (type CellChunked) (use borrow)) (returns I64)
      (body (call owned-worklists::chunk-length (types OwnedI64Cell) (local values))))
    (function create chunked-cell-push (visibility public) (effect pure)
      (parameter create value (type OwnedI64Cell) (use consume))
      (parameter create values (type CellChunked) (use consume)) (returns CellChunked)
      (body (call owned-worklists::chunk-push (types OwnedI64Cell) (local value) (local values))))
    (function create chunked-cell-pop (visibility public) (effect pure)
      (parameter create values (type CellChunked) (use consume)) (returns CellChunkedPop)
      (body (call owned-worklists::chunk-pop (types OwnedI64Cell) (local values))))
    (owned-implementation create ChunkedCells (visibility public)
      (contract owned-worklists::Worklist) (self CellChunked) (types OwnedI64Cell)
      (method method_88000000000000000000000000000011 chunked-cell-empty)
      (method method_88000000000000000000000000000012 chunked-cell-length)
      (method method_88000000000000000000000000000013 chunked-cell-push)
      (method method_88000000000000000000000000000014 chunked-cell-pop))
    (function create flat-buffer-empty (visibility public) (effect pure) (returns BufferFlat)
      (body (sequence-empty (type BufferFlat))))
    (function create flat-buffer-length (visibility public) (effect pure)
      (parameter create values (type BufferFlat) (use borrow)) (returns I64)
      (body (sequence-length (type BufferFlat) (local values))))
    (function create flat-buffer-push (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use consume))
      (parameter create values (type BufferFlat) (use consume)) (returns BufferFlat)
      (body (sequence-push (type BufferFlat) (local value) (local values))))
    (function create flat-buffer-pop (visibility public) (effect pure)
      (parameter create values (type BufferFlat) (use consume)) (returns BufferFlatPop)
      (body (sequence-pop (type BufferFlat) (local values))))
    (owned-implementation create FlatBuffers (visibility public)
      (contract owned-worklists::Worklist) (self BufferFlat) (types ByteBuffer)
      (method method_88000000000000000000000000000011 flat-buffer-empty)
      (method method_88000000000000000000000000000012 flat-buffer-length)
      (method method_88000000000000000000000000000013 flat-buffer-push)
      (method method_88000000000000000000000000000014 flat-buffer-pop))
    (function create chunked-buffer-empty (visibility public) (effect pure) (returns BufferChunked)
      (body (call owned-worklists::chunk-empty (types ByteBuffer))))
    (function create chunked-buffer-length (visibility public) (effect pure)
      (parameter create values (type BufferChunked) (use borrow)) (returns I64)
      (body (call owned-worklists::chunk-length (types ByteBuffer) (local values))))
    (function create chunked-buffer-push (visibility public) (effect pure)
      (parameter create value (type ByteBuffer) (use consume))
      (parameter create values (type BufferChunked) (use consume)) (returns BufferChunked)
      (body (call owned-worklists::chunk-push (types ByteBuffer) (local value) (local values))))
    (function create chunked-buffer-pop (visibility public) (effect pure)
      (parameter create values (type BufferChunked) (use consume)) (returns BufferChunkedPop)
      (body (call owned-worklists::chunk-pop (types ByteBuffer) (local values))))
    (owned-implementation create ChunkedBuffers (visibility public)
      (contract owned-worklists::Worklist) (self BufferChunked) (types ByteBuffer)
      (method method_88000000000000000000000000000011 chunked-buffer-empty)
      (method method_88000000000000000000000000000012 chunked-buffer-length)
      (method method_88000000000000000000000000000013 chunked-buffer-push)
      (method method_88000000000000000000000000000014 chunked-buffer-pop))))
declarations.end

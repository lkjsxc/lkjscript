declarations.begin
(units
  (use std builtin)
  (module create dependency-plan
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Diagnostic (record (code Text) (owner I64) (target I64)))
    (type-alias Component (record (members (list I64)) (cyclic Bool)))
    (type-alias Analysis (record (components (list Component))
      (reachable (list I64)) (unreachable (list I64))))
    (type-alias PlannedComponent (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Plan (record (components (list PlannedComponent)) (stages (list (list I64)))))
    (type-alias PlannedAnalysis (record (components (list PlannedComponent)) (stages (list (list I64)))
      (reachable (list I64)) (unreachable (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias Graph (record (dependencies Links) (dependents Links)
      (remaining Positions) (seen (map I64 (map I64 Bool)))))
    (type-alias Traversal (record (complete Bool) (levels Positions)))
    (type-alias Flat (owned-sequence OwnedI64Cell))
    (type-alias Chunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (variant create Outcome (visibility public)
      (case create valid (payload PlannedAnalysis))
      (case create invalid (payload Diagnostic))
      (case create capacity (payload Text))
      (case create inconsistent (payload Text)))

    (function create analyze (visibility public) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_ca030000000000000000000000000001
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create proposal (type Proposal)) (returns Outcome)
      (body (match (implementation-call dependency-components::analyze (types W)
        (implementations parameter@analyze@implparam_ca030000000000000000000000000001)
        (local proposal))
        (arm dependency-components::Outcome::invalid (payload diagnostic Diagnostic)
          (variant Outcome::invalid (local diagnostic)))
        (arm dependency-components::Outcome::capacity (payload dimension Text)
          (variant Outcome::capacity (local dimension)))
        (arm dependency-components::Outcome::valid (payload analysis Analysis)
          (let
            (binding components (type (list Component)) (field (local analysis) (name components)))
            (binding graph (type Graph) (call plan-edges::condense
              (field (local proposal) (name nodes)) (local components)))
            (binding traversal (type Traversal) (call plan-stages::assign
              (call std::list-length (types Component) (local components))
              (field (local graph) (name dependents)) (field (local graph) (name remaining))))
            (in (if (field (local traversal) (name complete))
              (let (binding plan (type Plan) (call plan-presentation::build (local components)
                (field (local graph) (name dependencies)) (field (local traversal) (name levels))))
                (in (variant Outcome::valid (record structural
                  (field components (field (local plan) (name components)))
                  (field stages (field (local plan) (name stages)))
                  (field reachable (field (local analysis) (name reachable)))
                  (field unreachable (field (local analysis) (name unreachable)))))))
              (variant Outcome::inconsistent (text "incomplete-component-order")))))))))
    (function create flat (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (returns Outcome)
      (body (implementation-call analyze (types Flat)
        (implementations concrete@worklist-carriers::FlatCells) (local proposal))))
    (function create chunked (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (returns Outcome)
      (body (implementation-call analyze (types Chunked)
        (implementations concrete@worklist-carriers::ChunkedCells) (local proposal))))
    (function create example (visibility private) (effect pure) (returns Proposal)
      (body (record structural (field roots (list I64 (i64 10)))
        (field nodes (list Node
          (record structural (field id (i64 10)) (field successors (list I64 (i64 20) (i64 30) (i64 20))))
          (record structural (field id (i64 20)) (field successors (list I64 (i64 40))))
          (record structural (field id (i64 30)) (field successors (list I64 (i64 40))))
          (record structural (field id (i64 40)) (field successors (list I64 (i64 20))))
          (record structural (field id (i64 50)) (field successors (list I64 (i64 50))))
          (record structural (field id (i64 60)) (field successors (list I64))))))))
    (function create expected (visibility private) (effect pure) (returns Outcome)
      (body (variant Outcome::valid (record structural
        (field components (list PlannedComponent
          (record structural (field members (list I64 (i64 10))) (field cyclic (bool false))
            (field dependencies (list I64 (i64 20) (i64 30))))
          (record structural (field members (list I64 (i64 20) (i64 40))) (field cyclic (bool true))
            (field dependencies (list I64)))
          (record structural (field members (list I64 (i64 30))) (field cyclic (bool false))
            (field dependencies (list I64 (i64 20))))
          (record structural (field members (list I64 (i64 50))) (field cyclic (bool true))
            (field dependencies (list I64)))
          (record structural (field members (list I64 (i64 60))) (field cyclic (bool false))
            (field dependencies (list I64)))))
        (field stages (list (list I64) (list I64 (i64 20) (i64 50) (i64 60))
          (list I64 (i64 30)) (list I64 (i64 10))))
        (field reachable (list I64 (i64 10) (i64 20) (i64 30) (i64 40)))
        (field unreachable (list I64 (i64 50) (i64 60)))))))
    (test create example-flat (visibility private)
      (actual (call flat (call example))) (expected (call expected)))
    (test create example-chunked (visibility private)
      (actual (call chunked (call example))) (expected (call expected)))
    (test create empty (visibility private)
      (actual (call flat (record structural (field roots (list I64)) (field nodes (list Node)))))
      (expected (variant Outcome::valid (record structural
        (field components (list PlannedComponent)) (field stages (list (list I64)))
        (field reachable (list I64)) (field unreachable (list I64))))))
    (component create command (visibility private)
      (port create flat (type (function (Proposal) Outcome)) (function flat))
      (port create chunked (type (function (Proposal) Outcome)) (function chunked))))
  (target create dependency-plan-flat (component dependency-plan::command)
    (runner command) (port dependency-plan::command::flat))
  (target create dependency-plan-chunked (component dependency-plan::command)
    (runner command) (port dependency-plan::command::chunked)))
declarations.end

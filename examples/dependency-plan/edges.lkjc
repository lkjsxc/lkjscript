declarations.begin
(units
  (use std builtin)
  (module create plan-edges
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Component (record (members (list I64)) (cyclic Bool)))
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias Seen (map I64 (map I64 Bool)))
    (type-alias Graph (record (dependencies Links) (dependents Links)
      (remaining Positions) (seen Seen)))

    ; Positions belong only to this complete, validated component partition.
    ; Signed identities are keys, never sentinels or arithmetic operands.
    (function create members (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create rank (type I64)) (parameter create positions (type Positions))
      (returns Positions)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (call members (local ids) (call std::add (local offset) (i64 1)) (local rank)
          (call std::map-insert (types I64 I64) (local positions)
            (call std::list-get (types I64) (local ids) (local offset)) (local rank)))
        (local positions))))
    (function create index (visibility private) (effect pure)
      (parameter create components (type (list Component))) (parameter create offset (type I64))
      (parameter create positions (type Positions)) (returns Positions)
      (body (if (call std::less (local offset) (call std::list-length (types Component) (local components)))
        (let (binding component (type Component)
          (call std::list-get (types Component) (local components) (local offset)))
          (in (call index (local components) (call std::add (local offset) (i64 1))
            (call members (field (local component) (name members)) (i64 0) (local offset) (local positions)))))
        (local positions))))

    (function create insert (visibility private) (effect pure)
      (parameter create source (type I64)) (parameter create target (type I64))
      (parameter create graph (type Graph)) (returns Graph)
      (body (let
        (binding seen (type Seen) (field (local graph) (name seen)))
        (binding previous (type (map I64 Bool))
          (call std::map-get-or (types I64 (map I64 Bool)) (local seen) (local source) (map I64 Bool)))
        (binding same (type Bool) (if (call std::less (local source) (local target)) (bool false)
          (if (call std::less (local target) (local source)) (bool false) (bool true))))
        (in (if (local same) (local graph)
          (if (call std::map-get-or (types I64 Bool) (local previous) (local target) (bool false))
            (local graph)
            (let
              (binding dependencies (type Links) (field (local graph) (name dependencies)))
              (binding dependents (type Links) (field (local graph) (name dependents)))
              (binding remaining (type Positions) (field (local graph) (name remaining)))
              (binding targets (type (list I64))
                (call std::map-get-or (types I64 (list I64)) (local dependencies) (local source) (list I64)))
              (binding users (type (list I64))
                (call std::map-get-or (types I64 (list I64)) (local dependents) (local target) (list I64)))
              (in (record structural
                (field dependencies (call std::map-insert (types I64 (list I64)) (local dependencies)
                  (local source) (call std::list-append (types I64) (local targets) (local target))))
                (field dependents (call std::map-insert (types I64 (list I64)) (local dependents)
                  (local target) (call std::list-append (types I64) (local users) (local source))))
                (field remaining (call std::map-insert (types I64 I64) (local remaining) (local source)
                  (call std::add (call std::map-get-or (types I64 I64) (local remaining) (local source) (i64 0)) (i64 1))))
                (field seen (call std::map-insert (types I64 (map I64 Bool)) (local seen) (local source)
                  (call std::map-insert (types I64 Bool) (local previous) (local target) (bool true)))))))))))))

    (function create successors (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create source (type I64)) (parameter create positions (type Positions))
      (parameter create graph (type Graph)) (returns Graph)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (let
          (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
          (binding target (type I64)
            (call std::map-get-or (types I64 I64) (local positions) (local id) (i64 -1)))
          (in (call successors (local ids) (call std::add (local offset) (i64 1))
            (local source) (local positions) (call insert (local source) (local target) (local graph)))))
        (local graph))))
    (function create nodes (visibility private) (effect pure)
      (parameter create input (type (list Node))) (parameter create offset (type I64))
      (parameter create positions (type Positions)) (parameter create graph (type Graph))
      (returns Graph)
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local input)))
        (let
          (binding node (type Node) (call std::list-get (types Node) (local input) (local offset)))
          (binding source (type I64) (call std::map-get-or (types I64 I64) (local positions)
            (field (local node) (name id)) (i64 -1)))
          (in (call nodes (local input) (call std::add (local offset) (i64 1)) (local positions)
            (call successors (field (local node) (name successors)) (i64 0)
              (local source) (local positions) (local graph)))))
        (local graph))))
    (function create condense (visibility public) (effect pure)
      (parameter create input (type (list Node))) (parameter create components (type (list Component)))
      (returns Graph)
      (body (call nodes (local input) (i64 0)
        (call index (local components) (i64 0) (map I64 I64))
        (record structural (field dependencies (map I64 (list I64)))
          (field dependents (map I64 (list I64))) (field remaining (map I64 I64))
          (field seen (map I64 (map I64 Bool)))))))))
declarations.end

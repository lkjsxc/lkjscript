declarations.begin
(units
  (use std builtin)
  (module create plan-batch
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Outcome dependency-plan::Outcome)
    (type-alias Flat (owned-sequence OwnedI64Cell))
    (type-alias Chunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (function create collect-with-storage (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (type-parameter create Ints (constraint owned))
      (type-parameter create Flags (constraint owned))
      (implementation-parameter implparam_a4000000000000000000000000000001
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (implementation-parameter implparam_a4000000000000000000000000000002 ints indexed-data::IndexedData Ints (types I64))
      (implementation-parameter implparam_a4000000000000000000000000000003 flags indexed-data::IndexedData Flags (types Bool))
      (implementation-parameter implparam_a5000000000000000000000000000006 reader indexed-data::BlockRead Ints (types I64))
      (parameter create proposals (type (list Proposal))) (parameter create offset (type I64))
      (parameter create output (type (list Outcome))) (returns (list Outcome))
      (body (if (call std::less (local offset) (call std::list-length (types Proposal) (local proposals)))
        (let (binding outcome (type Outcome) (implementation-call dependency-plan::analyze-with-storage (types W Ints Flags)
          (implementations parameter@collect-with-storage@implparam_a4000000000000000000000000000001
            parameter@collect-with-storage@implparam_a4000000000000000000000000000002 parameter@collect-with-storage@implparam_a4000000000000000000000000000003
              parameter@collect-with-storage@implparam_a5000000000000000000000000000006)
          (call std::list-get (types Proposal) (local proposals) (local offset))))
          (in (implementation-call collect-with-storage (types W Ints Flags)
            (implementations parameter@collect-with-storage@implparam_a4000000000000000000000000000001
            parameter@collect-with-storage@implparam_a4000000000000000000000000000002 parameter@collect-with-storage@implparam_a4000000000000000000000000000003
              parameter@collect-with-storage@implparam_a5000000000000000000000000000006)
            (local proposals) (call std::add (local offset) (i64 1))
            (call std::list-append (types Outcome) (local output) (local outcome)))))
        (local output))))
    (function create collect (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_ca040000000000000000000000000001
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create proposals (type (list Proposal))) (parameter create offset (type I64))
      (parameter create output (type (list Outcome))) (returns (list Outcome))
      (body (if (call std::less (local offset) (call std::list-length (types Proposal) (local proposals)))
        (let (binding outcome (type Outcome) (implementation-call dependency-plan::analyze (types W)
          (implementations parameter@collect@implparam_ca040000000000000000000000000001)
          (call std::list-get (types Proposal) (local proposals) (local offset))))
          (in (implementation-call collect (types W)
            (implementations parameter@collect@implparam_ca040000000000000000000000000001)
            (local proposals) (call std::add (local offset) (i64 1))
            (call std::list-append (types Outcome) (local output) (local outcome)))))
        (local output))))
    (function create flat (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect (types Flat)
        (implementations concrete@worklist-carriers::FlatCells)
        (local proposals) (i64 0) (list Outcome))))
    (function create chunked (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect (types Chunked)
        (implementations concrete@worklist-carriers::ChunkedCells)
        (local proposals) (i64 0) (list Outcome))))
    (function create storage-flat-flat (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect-with-storage
        (types Flat (owned-sequence I64) (owned-sequence Bool))
        (implementations concrete@worklist-carriers::FlatCells
          (implementation indexed-flat::Flat (types I64))
          (implementation indexed-flat::Flat (types Bool))
              (implementation indexed-flat::Blocks (types I64)))
        (local proposals) (i64 0) (list Outcome))))
    (function create storage-flat-chunked (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect-with-storage
        (types Flat (owned-sequence I64) (indexed-chunked::Chunk32 Bool))
        (implementations concrete@worklist-carriers::FlatCells
          (implementation indexed-flat::Flat (types I64))
          (implementation indexed-chunked::Chunked (types Bool))
              (implementation indexed-flat::Blocks (types I64)))
        (local proposals) (i64 0) (list Outcome))))
    (function create storage-chunked-flat (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect-with-storage
        (types Flat (indexed-chunked::Chunk32 I64) (owned-sequence Bool))
        (implementations concrete@worklist-carriers::FlatCells
          (implementation indexed-chunked::Chunked (types I64))
          (implementation indexed-flat::Flat (types Bool))
              (implementation indexed-chunked::Blocks (types I64)))
        (local proposals) (i64 0) (list Outcome))))
    (function create storage-chunked-chunked (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect-with-storage
        (types Flat (indexed-chunked::Chunk32 I64) (indexed-chunked::Chunk32 Bool))
        (implementations concrete@worklist-carriers::FlatCells
          (implementation indexed-chunked::Chunked (types I64))
          (implementation indexed-chunked::Chunked (types Bool))
              (implementation indexed-chunked::Blocks (types I64)))
        (local proposals) (i64 0) (list Outcome))))
    (test create empty-flat (visibility private)
      (actual (call flat (list Proposal))) (expected (list Outcome)))
    (test create empty-chunked (visibility private)
      (actual (call chunked (list Proposal))) (expected (list Outcome)))
    (component create command (visibility private)
      (port create flat (type (function ((list Proposal)) (list Outcome))) (function flat))
      (port create chunked (type (function ((list Proposal)) (list Outcome))) (function chunked))
      (port create storage-flat-flat (type (function ((list Proposal)) (list Outcome))) (function storage-flat-flat))
      (port create storage-flat-chunked (type (function ((list Proposal)) (list Outcome))) (function storage-flat-chunked))
      (port create storage-chunked-flat (type (function ((list Proposal)) (list Outcome))) (function storage-chunked-flat))
      (port create storage-chunked-chunked (type (function ((list Proposal)) (list Outcome))) (function storage-chunked-chunked))))
  (target create dependency-plan-batch-flat (component plan-batch::command)
    (runner command) (port plan-batch::command::flat))
  (target create dependency-plan-batch-chunked (component plan-batch::command)
    (runner command) (port plan-batch::command::chunked))
  (target create dependency-plan-batch-storage-flat-flat (component plan-batch::command)
    (runner command) (port plan-batch::command::storage-flat-flat))
  (target create dependency-plan-batch-storage-flat-chunked (component plan-batch::command)
    (runner command) (port plan-batch::command::storage-flat-chunked))
  (target create dependency-plan-batch-storage-chunked-flat (component plan-batch::command)
    (runner command) (port plan-batch::command::storage-chunked-flat))
  (target create dependency-plan-batch-storage-chunked-chunked (component plan-batch::command)
    (runner command) (port plan-batch::command::storage-chunked-chunked)))
declarations.end

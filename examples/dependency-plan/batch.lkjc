declarations.begin
(units
  (use std builtin)
  (module create plan-batch
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Outcome dependency-plan::Outcome)
    (type-alias Flat (owned-sequence OwnedI64Cell))
    (type-alias Chunked (owned-product
      (field chunks (owned-sequence (owned-sequence OwnedI64Cell))) (field size I64)))
    (function create collect (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_ca040000000000000000000000000001
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create proposals (type (list Proposal))) (parameter create offset (type I64))
      (parameter create output (type (list Outcome))) (returns (list Outcome))
      (body (if (call std::less (local offset) (call std::list-length (types Proposal) (local proposals)))
        (let (binding outcome (type Outcome) (implementation-call dependency-plan::analyze (types W)
          (implementations parameter@collect@implparam_ca040000000000000000000000000001)
          (call std::list-get (types Proposal) (local proposals) (local offset))))
          (in (implementation-call collect (types W)
            (implementations parameter@collect@implparam_ca040000000000000000000000000001)
            (local proposals) (call std::add (local offset) (i64 1))
            (call std::list-append (types Outcome) (local output) (local outcome)))))
        (local output))))
    (function create flat (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect (types Flat)
        (implementations concrete@worklist-carriers::FlatCells)
        (local proposals) (i64 0) (list Outcome))))
    (function create chunked (visibility public) (effect pure)
      (parameter create proposals (type (list Proposal))) (returns (list Outcome))
      (body (implementation-call collect (types Chunked)
        (implementations concrete@worklist-carriers::ChunkedCells)
        (local proposals) (i64 0) (list Outcome))))
    (test create empty-flat (visibility private)
      (actual (call flat (list Proposal))) (expected (list Outcome)))
    (test create empty-chunked (visibility private)
      (actual (call chunked (list Proposal))) (expected (list Outcome)))
    (component create command (visibility private)
      (port create flat (type (function ((list Proposal)) (list Outcome))) (function flat))
      (port create chunked (type (function ((list Proposal)) (list Outcome))) (function chunked))))
  (target create dependency-plan-batch-flat (component plan-batch::command)
    (runner command) (port plan-batch::command::flat))
  (target create dependency-plan-batch-chunked (component plan-batch::command)
    (runner command) (port plan-batch::command::chunked)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create plan-stages
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias State (record (remaining Positions) (levels Positions) (queue (list I64)) (valid Bool)))
    (type-alias Traversal (record (complete Bool) (levels Positions)))

    (function create invalid (visibility private) (effect pure)
      (parameter create state (type State)) (returns State)
      (body (record structural (field remaining (field (local state) (name remaining)))
        (field levels (field (local state) (name levels))) (field queue (field (local state) (name queue)))
        (field valid (bool false)))))
    (function create refused (visibility private) (effect pure) (returns Traversal)
      (body (record structural (field complete (bool false)) (field levels (map I64 I64)))))
    (function create seed (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create offset (type I64))
      (parameter create remaining (type Positions)) (parameter create queue (type (list I64)))
      (returns (list I64))
      (body (if (call std::less (local offset) (local count))
        (call seed (local count) (call std::add (local offset) (i64 1)) (local remaining)
          (if (call std::less (i64 0)
            (call std::map-get-or (types I64 I64) (local remaining) (local offset) (i64 0)))
            (local queue) (call std::list-append (types I64) (local queue) (local offset))))
        (local queue))))

    ; A dependent becomes ready exactly after its last distinct dependency.
    ; Negative counters cannot enqueue a second successful copy of a component.
    (function create release (visibility private) (effect pure)
      (parameter create users (type (list I64))) (parameter create offset (type I64))
      (parameter create level (type I64)) (parameter create state (type State)) (returns State)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types I64) (local users)))
          (let
            (binding user (type I64) (call std::list-get (types I64) (local users) (local offset)))
            (binding remaining (type Positions) (field (local state) (name remaining)))
            (binding before (type I64)
              (call std::map-get-or (types I64 I64) (local remaining) (local user) (i64 0)))
            (in (if (call std::less (i64 0) (local before))
              (let
                (binding levels (type Positions) (field (local state) (name levels)))
                (binding queue (type (list I64)) (field (local state) (name queue)))
                (binding count (type I64) (call std::subtract (local before) (i64 1)))
                (binding previous (type I64)
                  (call std::map-get-or (types I64 I64) (local levels) (local user) (i64 0)))
                (binding next-level (type I64) (call std::add (local level) (i64 1)))
                (in (call release (local users) (call std::add (local offset) (i64 1)) (local level)
                  (record structural (field valid (bool true))
                    (field remaining (call std::map-insert (types I64 I64) (local remaining) (local user) (local count)))
                    (field levels (call std::map-insert (types I64 I64) (local levels) (local user)
                      (if (call std::less (local previous) (local next-level)) (local next-level) (local previous))))
                    (field queue (if (call std::less (i64 0) (local count)) (local queue)
                      (call std::list-append (types I64) (local queue) (local user))))))))
              (call invalid (local state)))))
          (local state))
        (local state))))
    (function create ready (visibility private) (effect pure)
      (parameter create current (type I64)) (parameter create count (type I64))
      (parameter create remaining (type Positions)) (parameter create seen (type (map I64 Bool)))
      (returns Bool)
      (body (if (call std::less (local current) (i64 0)) (bool false)
        (if (call std::less (local current) (local count))
          (if (call std::map-get-or (types I64 Bool) (local seen) (local current) (bool false)) (bool false)
            (let (binding pending (type I64)
              (call std::map-get-or (types I64 I64) (local remaining) (local current) (i64 0)))
              (in (if (call std::less (local pending) (i64 0)) (bool false)
                (if (call std::less (i64 0) (local pending)) (bool false) (bool true))))))
          (bool false)))))
    (function create visit (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create dependents (type Links))
      (parameter create offset (type I64)) (parameter create seen (type (map I64 Bool)))
      (parameter create state (type State)) (returns Traversal)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types I64) (field (local state) (name queue))))
          (if (call std::less (local offset) (local count))
            (let (binding current (type I64)
              (call std::list-get (types I64) (field (local state) (name queue)) (local offset)))
              (in (if (call ready (local current) (local count) (field (local state) (name remaining)) (local seen))
                (let
                  (binding level (type I64) (call std::map-get-or (types I64 I64)
                    (field (local state) (name levels)) (local current) (i64 0)))
                  (binding users (type (list I64))
                    (call std::map-get-or (types I64 (list I64)) (local dependents) (local current) (list I64)))
                  (in (call visit (local count) (local dependents) (call std::add (local offset) (i64 1))
                    (call std::map-insert (types I64 Bool) (local seen) (local current) (bool true))
                    (call release (local users) (i64 0) (local level) (local state)))))
                (call refused))))
            (call refused))
          (if (call std::less (local offset) (local count)) (call refused)
            (record structural (field complete (bool true)) (field levels (field (local state) (name levels))))))
        (call refused))))
    (function create assign (visibility public) (effect pure)
      (parameter create count (type I64)) (parameter create dependents (type Links))
      (parameter create remaining (type Positions)) (returns Traversal)
      (body (if (call std::less (local count) (i64 0)) (call refused)
        (call visit (local count) (local dependents) (i64 0) (map I64 Bool)
          (record structural (field valid (bool true))
            (field remaining (local remaining)) (field levels (map I64 I64))
            (field queue (call seed (local count) (i64 0) (local remaining) (list I64))))))))

    ; These are internal-construction adversaries, not accepted proposal variants.
    (test create stalled-derived-cycle (visibility private)
      (actual (field (call assign (i64 2)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 1))) (entry (i64 1) (list I64 (i64 0))))
        (map I64 I64 (entry (i64 0) (i64 1)) (entry (i64 1) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create partial-derived-stall (visibility private)
      (actual (field (call assign (i64 3) (map I64 (list I64))
        (map I64 I64 (entry (i64 1) (i64 1)) (entry (i64 2) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create duplicate-derived-release (visibility private)
      (actual (field (call assign (i64 3)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 1) (i64 1))))
        (map I64 I64 (entry (i64 1) (i64 1)) (entry (i64 2) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create unknown-derived-target (visibility private)
      (actual (field (call assign (i64 2)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 9))))
        (map I64 I64 (entry (i64 1) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create negative-derived-count (visibility private)
      (actual (field (call assign (i64 1) (map I64 (list I64))
        (map I64 I64 (entry (i64 0) (i64 -1)))) (name complete)))
      (expected (bool false)))
    (test create empty-derived-graph (visibility private)
      (actual (call assign (i64 0) (map I64 (list I64)) (map I64 I64)))
      (expected (record structural (field complete (bool true)) (field levels (map I64 I64)))))))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create plan-stages
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias Ints (owned-sequence I64))
    (type-alias Flags (owned-sequence Bool))
    (type-alias IntItem (owned-product (field rest Ints) (field value I64)))
    (type-alias FlagItem (owned-product (field rest Flags) (field value Bool)))
    (type-alias State (owned-product
      (field levels Ints) (field queue Ints) (field remaining Ints)
      (field seen Flags) (field valid Bool)))
    (type-alias Traversal (record (complete Bool) (levels Positions)))

    (function create refused (visibility private) (effect pure) (returns Traversal)
      (body (record structural (field complete (bool false)) (field levels (map I64 I64)))))
    (function create make (visibility private) (effect pure)
      (parameter create valid (type Bool))
      (parameter create remaining (type Ints) (use consume))
      (parameter create levels (type Ints) (use consume))
      (parameter create seen (type Flags) (use consume))
      (parameter create queue (type Ints) (use consume)) (returns State)
      (body (pack-owned (type State)
        (field remaining (local remaining)) (field levels (local levels))
        (field seen (local seen)) (field queue (local queue)) (field valid (local valid)))))

    ; Missing counters mean zero; unrelated map keys do not become components.
    (function create initialize (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create offset (type I64))
      (parameter create counters (type Positions))
      (parameter create remaining (type Ints) (use consume))
      (parameter create levels (type Ints) (use consume))
      (parameter create seen (type Flags) (use consume))
      (parameter create queue (type Ints) (use consume)) (returns State)
      (body (if (call std::less (local offset) (local count))
        (let
          (binding pending (type I64)
            (call std::map-get-or (types I64 I64) (local counters) (local offset) (i64 0)))
          (binding remaining (type Ints)
            (call std::data-sequence-push (types I64) (local pending) (local remaining)))
          (binding levels (type Ints) (call std::data-sequence-push (types I64) (i64 0) (local levels)))
          (binding seen (type Flags) (call std::data-sequence-push (types Bool) (bool false) (local seen)))
          (binding queue (type Ints) (if (call std::less (i64 0) (local pending))
            (local queue) (call std::data-sequence-push (types I64) (local offset) (local queue))))
          (in (call initialize (local count) (call std::add (local offset) (i64 1)) (local counters)
            (local remaining) (local levels) (local seen) (local queue))))
        (call make (bool true) (local remaining) (local levels) (local seen) (local queue)))))

    ; A checked scalar replacement returns the updated vector and old value.
    (function create update-one (visibility private) (effect pure)
      (parameter create user (type I64)) (parameter create before (type I64))
      (parameter create level (type I64))
      (parameter create remaining (type Ints) (use consume))
      (parameter create levels (type Ints) (use consume))
      (parameter create seen (type Flags) (use consume))
      (parameter create queue (type Ints) (use consume)) (returns State)
      (body (let
        (binding pending (type I64) (call std::subtract (local before) (i64 1)))
        (binding previous (type I64)
          (call std::data-sequence-get (types I64) (local user) (local levels)))
        (binding next-level (type I64) (call std::add (local level) (i64 1)))
        (binding changed (type IntItem)
          (call std::data-sequence-replace (types I64) (local user) (local pending) (local remaining)))
        (in (unpack-owned (type IntItem) (local changed)
          (field rest (binding remaining (type Ints)))
          (field value (binding old-count (type I64)))
          (in (let (binding changed (type IntItem)
            (call std::data-sequence-replace (types I64) (local user)
              (if (call std::less (local previous) (local next-level))
                (local next-level) (local previous)) (local levels)))
            (in (unpack-owned (type IntItem) (local changed)
              (field rest (binding levels (type Ints)))
              (field value (binding old-level (type I64)))
              (in (let (binding queue (type Ints) (if (call std::less (i64 0) (local pending))
                (local queue) (call std::data-sequence-push (types I64) (local user) (local queue))))
                (in (call make (bool true) (local remaining) (local levels) (local seen) (local queue))))))))))))))
    (function create release-one (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create user (type I64))
      (parameter create level (type I64))
      (parameter create state (type State) (use consume)) (returns State)
      (body (unpack-owned (type State) (local state)
        (field levels (binding levels (type Ints)))
        (field queue (binding queue (type Ints)))
        (field remaining (binding remaining (type Ints)))
        (field seen (binding seen (type Flags)))
        (field valid (binding valid (type Bool)))
        (in (if (call std::less (local user) (i64 0))
          (call make (bool false) (local remaining) (local levels) (local seen) (local queue))
          (if (call std::less (local user) (local count))
            (let (binding before (type I64)
              (call std::data-sequence-get (types I64) (local user) (local remaining)))
              (in (if (call std::less (i64 0) (local before))
                (call update-one (local user) (local before) (local level)
                  (local remaining) (local levels) (local seen) (local queue))
                (call make (bool false) (local remaining) (local levels) (local seen) (local queue)))))
            (call make (bool false) (local remaining) (local levels) (local seen) (local queue))))))))
    ; Append a component only when its last distinct dependency finishes.
    (function create release (visibility private) (effect pure)
      (parameter create count (type I64))
      (parameter create users (type (list I64))) (parameter create offset (type I64))
      (parameter create level (type I64))
      (parameter create state (type State) (use consume)) (returns State)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types I64) (local users)))
          (let
            (binding user (type I64) (call std::list-get (types I64) (local users) (local offset)))
            (binding next (type State) (call release-one (local count) (local user) (local level) (local state)))
            (in (call release (local count) (local users)
              (call std::add (local offset) (i64 1)) (local level) (local next))))
          (local state))
        (local state))))

    (function create ready (visibility private) (effect pure)
      (parameter create current (type I64)) (parameter create count (type I64))
      (parameter create remaining (type Ints) (use borrow))
      (parameter create seen (type Flags) (use borrow)) (returns Bool)
      (body (if (call std::less (local current) (i64 0)) (bool false)
        (if (call std::less (local current) (local count))
          (if (call std::data-sequence-get (types Bool) (local current) (local seen)) (bool false)
            (let (binding pending (type I64)
              (call std::data-sequence-get (types I64) (local current) (local remaining)))
              (in (if (call std::less (local pending) (i64 0)) (bool false)
                (if (call std::less (i64 0) (local pending)) (bool false) (bool true))))))
          (bool false)))))
    ; Dependency-free levels remain absent from the original sparse result map.
    (function create materialize (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create offset (type I64))
      (parameter create output (type Positions))
      (parameter create levels (type Ints) (use borrow)) (returns Positions)
      (body (if (call std::less (local offset) (local count))
        (let (binding level (type I64)
          (call std::data-sequence-get (types I64) (local offset) (local levels)))
          (in (call materialize (local count) (call std::add (local offset) (i64 1))
            (if (call std::less (i64 0) (local level))
              (call std::map-insert (types I64 I64) (local output) (local offset) (local level))
              (local output)) (local levels))))
        (local output))))
    (function create visit (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create dependents (type Links))
      (parameter create head (type I64))
      (parameter create state (type State) (use consume)) (returns Traversal)
      (body (unpack-owned (type State) (local state)
        (field levels (binding levels (type Ints)))
        (field queue (binding queue (type Ints)))
        (field remaining (binding remaining (type Ints)))
        (field seen (binding seen (type Flags)))
        (field valid (binding valid (type Bool)))
        (in (if (local valid)
          (if (call std::less (local head) (call std::data-sequence-length (types I64) (local queue)))
            (if (call std::less (local head) (local count))
              (let (binding current (type I64)
                (call std::data-sequence-get (types I64) (local head) (local queue)))
                (in (if (call ready (local current) (local count) (local remaining) (local seen))
                  (let
                    (binding level (type I64)
                      (call std::data-sequence-get (types I64) (local current) (local levels)))
                    (binding users (type (list I64))
                      (call std::map-get-or (types I64 (list I64)) (local dependents) (local current) (list I64)))
                    (binding changed (type FlagItem)
                      (call std::data-sequence-replace (types Bool) (local current) (bool true) (local seen)))
                    (in (unpack-owned (type FlagItem) (local changed)
                      (field rest (binding seen (type Flags))) (field value (binding previous (type Bool)))
                      (in (let
                        (binding next (type State)
                          (call make (bool true) (local remaining) (local levels) (local seen) (local queue)))
                        (binding next (type State) (call release (local count) (local users) (i64 0) (local level) (local next)))
                        (in (call visit (local count) (local dependents)
                          (call std::add (local head) (i64 1)) (local next))))))))
                  (call refused))))
              (call refused))
            (if (call std::less (local head) (local count)) (call refused)
              (record structural (field complete (bool true))
                (field levels (call materialize (local count) (i64 0) (map I64 I64) (local levels))))))
          (call refused))))))
    (function create assign (visibility public) (effect pure)
      (parameter create count (type I64)) (parameter create dependents (type Links))
      (parameter create remaining (type Positions)) (returns Traversal)
      (body (if (call std::less (local count) (i64 0)) (call refused)
        (let
          (binding counters (type Ints) (call std::data-sequence-empty (types I64)))
          (binding levels (type Ints) (call std::data-sequence-empty (types I64)))
          (binding seen (type Flags) (call std::data-sequence-empty (types Bool)))
          (binding queue (type Ints) (call std::data-sequence-empty (types I64)))
          (binding state (type State) (call initialize (local count) (i64 0) (local remaining)
            (local counters) (local levels) (local seen) (local queue)))
          (in (call visit (local count) (local dependents) (i64 0) (local state)))))))

    ; Internal-construction adversaries, not accepted proposal variants.
    (test create stalled-derived-cycle (visibility private)
      (actual (field (call assign (i64 2)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 1))) (entry (i64 1) (list I64 (i64 0))))
        (map I64 I64 (entry (i64 0) (i64 1)) (entry (i64 1) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create partial-derived-stall (visibility private)
      (actual (field (call assign (i64 3) (map I64 (list I64))
        (map I64 I64 (entry (i64 1) (i64 1)) (entry (i64 2) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create duplicate-derived-release (visibility private)
      (actual (field (call assign (i64 3)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 1) (i64 1))))
        (map I64 I64 (entry (i64 1) (i64 1)) (entry (i64 2) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create unknown-derived-target (visibility private)
      (actual (field (call assign (i64 2)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 9))))
        (map I64 I64 (entry (i64 1) (i64 1)))) (name complete)))
      (expected (bool false)))
    (test create negative-derived-count (visibility private)
      (actual (field (call assign (i64 1) (map I64 (list I64))
        (map I64 I64 (entry (i64 0) (i64 -1)))) (name complete)))
      (expected (bool false)))
    (test create empty-derived-graph (visibility private)
      (actual (call assign (i64 0) (map I64 (list I64)) (map I64 I64)))
      (expected (record structural (field complete (bool true)) (field levels (map I64 I64)))))
    (test create negative-component-count (visibility private)
      (actual (call assign (i64 -1) (map I64 (list I64)) (map I64 I64)))
      (expected (record structural (field complete (bool false)) (field levels (map I64 I64)))))
    (test create negative-derived-target (visibility private)
      (actual (call assign (i64 1)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 -1)))) (map I64 I64)))
      (expected (record structural (field complete (bool false)) (field levels (map I64 I64)))))
    (test create leaf-levels-remain-sparse (visibility private)
      (actual (call assign (i64 3)
        (map I64 (list I64) (entry (i64 0) (list I64 (i64 2))))
        (map I64 I64 (entry (i64 2) (i64 1)) (entry (i64 9) (i64 -1)))))
      (expected (record structural (field complete (bool true))
        (field levels (map I64 I64 (entry (i64 2) (i64 1)))))))))
declarations.end

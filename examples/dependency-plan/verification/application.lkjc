declarations.begin
(units
  (use std builtin)
  (module create verified-plan
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Diagnostic (record (code Text) (owner I64) (target I64)))
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Plan (record (components (list Row)) (stages (list (list I64)))
      (reachable (list I64)) (unreachable (list I64))))
    (type-alias Outcome dependency-plan::Outcome)
    (type-alias Verification dependency-verifier::Verification)
    ; Forward only the exact immutable claim passed to the selected verifier.
    ; There is no separate caller-supplied original result that could disagree.
    (function create retain-checked (visibility private) (effect pure)
      (parameter create proposal (type Proposal))
      (parameter create claim (type dependency-verifier::ClaimedDependencyOutcome)) (returns Outcome)
      (body (match (call dependency-verifier::verify-dependency-outcome (local proposal) (local claim))
        (arm dependency-verifier::OutcomeVerification::verified (payload unused Unit)
          (match (local claim)
            (arm dependency-verifier::ClaimedDependencyOutcome::valid (payload plan Plan)
              (variant dependency-plan::Outcome::valid (local plan)))
            (arm dependency-verifier::ClaimedDependencyOutcome::invalid (payload diagnostic Diagnostic)
              (variant dependency-plan::Outcome::invalid (local diagnostic)))
            (arm dependency-verifier::ClaimedDependencyOutcome::capacity (payload dimension Text)
              (variant dependency-plan::Outcome::capacity (local dimension)))))
        (arm dependency-verifier::OutcomeVerification::rejected (payload reason Text)
          (variant dependency-plan::Outcome::inconsistent (local reason))))))
    (function create checked (visibility private) (effect pure)
      (parameter create proposal (type Proposal)) (parameter create outcome (type Outcome)) (returns Outcome)
      (body (match (local outcome)
        (arm dependency-plan::Outcome::invalid (payload diagnostic Diagnostic)
          (call retain-checked (local proposal)
            (variant dependency-verifier::ClaimedDependencyOutcome::invalid (local diagnostic))))
        (arm dependency-plan::Outcome::capacity (payload dimension Text)
          (call retain-checked (local proposal)
            (variant dependency-verifier::ClaimedDependencyOutcome::capacity (local dimension))))
        (arm dependency-plan::Outcome::inconsistent (payload reason Text)
          (variant dependency-plan::Outcome::inconsistent (local reason)))
        (arm dependency-plan::Outcome::valid (payload plan Plan)
          (call retain-checked (local proposal)
            (variant dependency-verifier::ClaimedDependencyOutcome::valid (local plan)))))))
    (function create flat (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (returns Outcome)
      (body (call checked (local proposal) (call dependency-plan::flat (local proposal)))))
    (function create chunked (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (returns Outcome)
      (body (call checked (local proposal) (call dependency-plan::chunked (local proposal)))))
    (function create verify (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (parameter create plan (type Plan)) (returns Verification)
      (body (call dependency-verifier::verify-dependency-plan (local proposal) (local plan))))

    (function create pair (visibility private) (effect pure)
      (parameter create forward (type Bool)) (parameter create reverse (type Bool)) (returns Proposal)
      (body (record structural (field roots (list I64))
        (field nodes (list Node
          (record structural (field id (i64 0))
            (field successors (if (local forward) (list I64 (i64 1)) (list I64))))
          (record structural (field id (i64 1))
            (field successors (if (local reverse) (list I64 (i64 0)) (list I64)))))))))
    (function create merged (visibility private) (effect pure) (returns Plan)
      (body (record structural
        (field components (list Row (record structural (field members (list I64 (i64 0) (i64 1)))
          (field cyclic (bool true)) (field dependencies (list I64)))))
        (field stages (list (list I64) (list I64 (i64 0))))
        (field reachable (list I64)) (field unreachable (list I64 (i64 0) (i64 1))))))
    (test create merged-strong-component (visibility private)
      (actual (call verify (call pair (bool true) (bool true)) (call merged)))
      (expected (variant dependency-verifier::Verification::verified (unit))))
    (test create reject-one-way-outgoing (visibility private)
      (actual (call verify (call pair (bool true) (bool false)) (call merged)))
      (expected (variant dependency-verifier::Verification::rejected (text "component-connectivity"))))
    (test create reject-one-way-incoming (visibility private)
      (actual (call verify (call pair (bool false) (bool true)) (call merged)))
      (expected (variant dependency-verifier::Verification::rejected (text "component-connectivity"))))
    (test create reject-disconnected-merge (visibility private)
      (actual (call verify (call pair (bool false) (bool false)) (call merged)))
      (expected (variant dependency-verifier::Verification::rejected (text "component-connectivity"))))
    (test create checked-producer-rejects-false-result (visibility private)
      (actual (call checked (call pair (bool true) (bool false))
        (variant dependency-plan::Outcome::valid (call merged))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "component-connectivity"))))
    (function create missing (visibility private) (effect pure) (returns Proposal)
      (body (record structural (field roots (list I64 (i64 90) (i64 80))) (field nodes (list Node)))))
    (function create diagnostic (visibility private) (effect pure)
      (parameter create code (type Text)) (parameter create owner (type I64))
      (parameter create target (type I64)) (returns Diagnostic)
      (body (record structural (field code (local code)) (field owner (local owner)) (field target (local target)))))
    (test create checked-rejects-false-invalid (visibility private)
      (actual (call checked (call pair (bool false) (bool false))
        (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-root") (i64 -1) (i64 90)))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-outcome"))))
    (test create checked-rejects-false-capacity (visibility private)
      (actual (call checked (call pair (bool false) (bool false))
        (variant dependency-plan::Outcome::capacity (text "nodes"))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-outcome"))))
    (test create checked-preserves-exact-invalid (visibility private)
      (actual (call checked (call missing)
        (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-root") (i64 -1) (i64 90)))))
      (expected (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-root") (i64 -1) (i64 90)))))
    (test create checked-rejects-later-missing-root (visibility private)
      (actual (call checked (call missing)
        (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-root") (i64 -1) (i64 80)))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-diagnostic"))))
    (test create checked-rejects-wrong-owner (visibility private)
      (actual (call checked (call missing)
        (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-root") (i64 0) (i64 90)))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-diagnostic"))))
    (test create checked-rejects-wrong-code (visibility private)
      (actual (call checked (call missing)
        (variant dependency-plan::Outcome::invalid (call diagnostic (text "missing-successor") (i64 -1) (i64 90)))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-diagnostic"))))
    (test create checked-rejects-valid-for-invalid (visibility private)
      (actual (call checked (call missing) (variant dependency-plan::Outcome::valid (call merged))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "source-outcome"))))
    (test create checked-preserves-internal-failure (visibility private)
      (actual (call checked (call missing) (variant dependency-plan::Outcome::inconsistent (text "internal-failure"))))
      (expected (variant dependency-plan::Outcome::inconsistent (text "internal-failure"))))
    (component create command (visibility private)
      (port create flat (type (function (Proposal) Outcome)) (function flat))
      (port create chunked (type (function (Proposal) Outcome)) (function chunked))))
  (target create dependency-plan-checked-flat (component verified-plan::command)
    (runner command) (port verified-plan::command::flat))
  (target create dependency-plan-checked-chunked (component verified-plan::command)
    (runner command) (port verified-plan::command::chunked)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create plan-verify-stages
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias State (record (valid Bool) (count I64) (levels Positions)))
    (function create refused (visibility private) (effect pure) (returns State)
      (body (record structural (field valid (bool false)) (field count (i64 0)) (field levels (map I64 I64)))))
    (function create peers (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create stage (type I64)) (parameter create previous (type I64))
      (parameter create leaders (type Positions)) (parameter create state (type State)) (returns State)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
          (let
            (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
            (binding rank (type I64)
              (call std::map-get-or (types I64 I64) (local leaders) (local id) (i64 -1)))
            (binding levels (type Positions) (field (local state) (name levels)))
            (in (if (call std::less (local previous) (local rank))
              (if (call std::less (call std::map-get-or (types I64 I64) (local levels) (local rank) (i64 -1)) (i64 0))
                (call peers (local ids) (call std::add (local offset) (i64 1)) (local stage) (local rank)
                  (local leaders) (record structural (field valid (bool true))
                    (field count (call std::add (field (local state) (name count)) (i64 1)))
                    (field levels (call std::map-insert (types I64 I64) (local levels) (local rank) (local stage)))))
                (call refused)) (call refused))))
          (local state)) (local state))))
    (function create rows (visibility private) (effect pure)
      (parameter create stages (type (list (list I64)))) (parameter create offset (type I64))
      (parameter create leaders (type Positions)) (parameter create state (type State)) (returns State)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types (list I64)) (local stages)))
          (let (binding ids (type (list I64)) (call std::list-get (types (list I64)) (local stages) (local offset)))
            (in (if (call std::less (i64 0) (call std::list-length (types I64) (local ids)))
              (call rows (local stages) (call std::add (local offset) (i64 1)) (local leaders)
                (call peers (local ids) (i64 0) (local offset) (i64 -1) (local leaders) (local state)))
              (call refused))))
          (local state)) (local state))))
    (function create index (visibility public) (effect pure)
      (parameter create stages (type (list (list I64)))) (parameter create leaders (type Positions))
      (parameter create count (type I64)) (returns State)
      (body (if (call std::less (local count) (call std::list-length (types (list I64)) (local stages))) (call refused)
        (let (binding state (type State) (call rows (local stages) (i64 0) (local leaders)
          (record structural (field valid (bool true)) (field count (i64 0)) (field levels (map I64 I64)))))
          (in (if (call plan-verify-data::same (local count) (field (local state) (name count)))
            (local state) (call refused)))))))

    ; Verify the defining level equations. Do not reproduce the producer's queue,
    ; reverse-dependency counts or readiness transitions.
    (function create required (visibility private) (effect pure)
      (parameter create dependencies (type (list I64))) (parameter create offset (type I64))
      (parameter create leaders (type Positions)) (parameter create levels (type Positions))
      (parameter create maximum (type I64)) (returns I64)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local dependencies)))
        (let
          (binding id (type I64) (call std::list-get (types I64) (local dependencies) (local offset)))
          (binding rank (type I64) (call std::map-get-or (types I64 I64) (local leaders) (local id) (i64 -1)))
          (binding level (type I64) (call std::map-get-or (types I64 I64) (local levels) (local rank) (i64 -1)))
          (in (if (call std::less (local level) (i64 0)) (i64 -1)
            (call required (local dependencies) (call std::add (local offset) (i64 1)) (local leaders) (local levels)
              (if (call std::less (local maximum) (call std::add (local level) (i64 1)))
                (call std::add (local level) (i64 1)) (local maximum))))))
        (local maximum))))
    (function create valid (visibility public) (effect pure)
      (parameter create components (type (list Row))) (parameter create leaders (type Positions))
      (parameter create levels (type Positions)) (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types Row) (local components)))
        (let
          (binding row (type Row) (call std::list-get (types Row) (local components) (local offset)))
          (binding actual (type I64) (call std::map-get-or (types I64 I64) (local levels) (local offset) (i64 -1)))
          (binding expected (type I64) (call required (field (local row) (name dependencies))
            (i64 0) (local leaders) (local levels) (i64 0)))
          (in (if (call std::less (local actual) (i64 0)) (bool false)
            (if (call plan-verify-data::same (local actual) (local expected))
              (call valid (local components) (local leaders) (local levels) (call std::add (local offset) (i64 1)))
              (bool false)))))
        (bool true))))))
declarations.end

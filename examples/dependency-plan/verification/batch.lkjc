declarations.begin
(units
  (use std builtin)
  (module create verified-plan-batch
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Outcome dependency-plan::Outcome)
    (function create plans (visibility private) (effect pure)
      (parameter create input (type (list Proposal))) (parameter create offset (type I64))
      (parameter create chunked (type Bool)) (parameter create output (type (list Outcome)))
      (returns (list Outcome))
      (body (if (call std::less (local offset) (call std::list-length (types Proposal) (local input)))
        (let
          (binding proposal (type Proposal) (call std::list-get (types Proposal) (local input) (local offset)))
          (binding next (type Outcome) (if (local chunked)
            (call verified-plan::chunked (local proposal)) (call verified-plan::flat (local proposal))))
          (in (call plans (local input) (call std::add (local offset) (i64 1)) (local chunked)
            (call std::list-append (types Outcome) (local output) (local next)))))
        (local output))))
    (function create flat (visibility public) (effect pure)
      (parameter create input (type (list Proposal))) (returns (list Outcome))
      (body (call plans (local input) (i64 0) (bool false) (list Outcome))))
    (function create chunked (visibility public) (effect pure)
      (parameter create input (type (list Proposal))) (returns (list Outcome))
      (body (call plans (local input) (i64 0) (bool true) (list Outcome))))
    (test create empty-flat (visibility private)
      (actual (call flat (list Proposal))) (expected (list Outcome)))
    (test create empty-chunked (visibility private)
      (actual (call chunked (list Proposal))) (expected (list Outcome)))
    (component create command (visibility private)
      (port create flat (type (function ((list Proposal)) (list Outcome))) (function flat))
      (port create chunked (type (function ((list Proposal)) (list Outcome))) (function chunked))))
  (target create dependency-plan-checked-batch-flat (component verified-plan-batch::command)
    (runner command) (port verified-plan-batch::command::flat))
  (target create dependency-plan-checked-batch-chunked (component verified-plan-batch::command)
    (runner command) (port verified-plan-batch::command::chunked)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create plan-verify
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Proposal (record (roots (list I64)) (nodes (list Node))))
    (type-alias Diagnostic (record (code Text) (owner I64) (target I64)))
    (type-alias Partition (record (reachable (list I64)) (unreachable (list I64))))
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Plan (record (components (list Row)) (stages (list (list I64)))
      (reachable (list I64)) (unreachable (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias Index (record (valid Bool) (last I64) (count I64)
      (membership Positions) (leaders Positions)))
    (type-alias Graph (record (forward Links) (reverse Links) (dependencies Links)
      (pairs (map I64 (map I64 Bool))) (loops (map I64 Bool))))
    (type-alias Stages (record (valid Bool) (count I64) (levels Positions)))
    (variant create Verification (visibility public)
      (case create verified (payload Unit))
      (case create rejected (payload Text))
      (case create invalid (payload Diagnostic))
      (case create capacity (payload Text)))

    (function create inspect (visibility private) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create plan (type Plan))
      (parameter create indexed (type Index)) (returns Verification)
      (body (let
        (binding rows (type (list Row)) (field (local plan) (name components)))
        (binding membership (type Positions) (field (local indexed) (name membership)))
        (binding leaders (type Positions) (field (local indexed) (name leaders)))
        (binding graph (type Graph) (call plan-verify-edges::build (local nodes) (local membership) (local rows)))
        (in (if (call plan-verify-edges::dependencies-valid (local rows)
          (field (local graph) (name dependencies)) (i64 0))
          (if (call plan-verify-edges::cyclic-valid (local rows) (field (local graph) (name loops)) (i64 0))
            (let (binding stages (type Stages) (call plan-verify-stages::index
              (field (local plan) (name stages)) (local leaders) (call std::list-length (types Row) (local rows))))
              (in (if (field (local stages) (name valid))
                (if (call plan-verify-stages::valid (local rows) (local leaders) (field (local stages) (name levels)) (i64 0))
                  (if (call plan-verify-walk::connected (local rows) (field (local graph) (name forward))
                    (field (local graph) (name reverse)) (local membership) (i64 0))
                    (variant Verification::verified (unit))
                    (variant Verification::rejected (text "component-connectivity")))
                  (variant Verification::rejected (text "component-stages")))
                (variant Verification::rejected (text "component-stages")))))
            (variant Verification::rejected (text "component-cyclic")))
          (variant Verification::rejected (text "component-dependencies")))))))
    (function create admitted (visibility private) (effect pure)
      (parameter create proposal (type Proposal)) (parameter create plan (type Plan))
      (parameter create partition (type Partition)) (returns Verification)
      (body (let
        (binding nodes (type (list Node)) (field (local proposal) (name nodes)))
        (binding indexed (type Index) (call plan-verify-members::index (local nodes) (field (local plan) (name components))))
        (in (if (field (local indexed) (name valid))
          (if (call plan-verify-data::same-list (field (local plan) (name reachable)) (field (local partition) (name reachable)))
            (if (call plan-verify-data::same-list (field (local plan) (name unreachable)) (field (local partition) (name unreachable)))
              (call inspect (local nodes) (local plan) (local indexed))
              (variant Verification::rejected (text "reachability")))
            (variant Verification::rejected (text "reachability")))
          (variant Verification::rejected (text "component-members")))))))
    (function create verify-dependency-plan (visibility public) (effect pure)
      (parameter create proposal (type Proposal)) (parameter create plan (type Plan)) (returns Verification)
      (body (match (call provisional-graph::flat (local proposal))
        (arm provisional-graph::Outcome::invalid (payload diagnostic Diagnostic)
          (variant Verification::invalid (local diagnostic)))
        (arm provisional-graph::Outcome::capacity (payload dimension Text)
          (variant Verification::capacity (local dimension)))
        (arm provisional-graph::Outcome::valid (payload partition Partition)
          (call admitted (local proposal) (local plan) (local partition))))))
    (type-alias Sample (record (proposal Proposal) (plan Plan)))
    (function create checks (visibility private) (effect pure)
      (parameter create input (type (list Sample))) (parameter create offset (type I64))
      (parameter create output (type (list Verification))) (returns (list Verification))
      (body (if (call std::less (local offset) (call std::list-length (types Sample) (local input)))
        (let
          (binding sample (type Sample) (call std::list-get (types Sample) (local input) (local offset)))
          (binding next (type Verification) (call verify-dependency-plan
            (field (local sample) (name proposal)) (field (local sample) (name plan))))
          (in (call checks (local input) (call std::add (local offset) (i64 1))
            (call std::list-append (types Verification) (local output) (local next)))))
        (local output))))
    (function create verify-batch (visibility public) (effect pure)
      (parameter create input (type (list Sample))) (returns (list Verification))
      (body (call checks (local input) (i64 0) (list Verification))))
    (test create empty-batch (visibility private)
      (actual (call verify-batch (list Sample))) (expected (list Verification)))
    (component create command (visibility private)
      (port create verify (type (function (Proposal Plan) Verification)) (function verify-dependency-plan))
      (port create batch (type (function ((list Sample)) (list Verification))) (function verify-batch))))
  (target create dependency-plan-verify (component plan-verify::command)
    (runner command) (port plan-verify::command::verify))
  (target create dependency-plan-verify-batch (component plan-verify::command)
    (runner command) (port plan-verify::command::batch)))
declarations.end

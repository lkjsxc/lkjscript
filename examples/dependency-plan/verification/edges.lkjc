declarations.begin
(units
  (use std builtin)
  (module create plan-verify-edges
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias Pairs (map I64 (map I64 Bool)))
    (type-alias Graph (record (forward Links) (reverse Links) (dependencies Links)
      (pairs Pairs) (loops (map I64 Bool))))
    (function create append (visibility private) (effect pure)
      (parameter create links (type Links)) (parameter create key (type I64))
      (parameter create value (type I64)) (returns Links)
      (body (call std::map-insert (types I64 (list I64)) (local links) (local key)
        (call std::list-append (types I64)
          (call std::map-get-or (types I64 (list I64)) (local links) (local key) (list I64)) (local value)))))
    (function create distinct (visibility private) (effect pure)
      (parameter create source (type I64)) (parameter create target (type I64))
      (parameter create rows (type (list Row))) (parameter create graph (type Graph)) (returns Graph)
      (body (if (call plan-verify-data::same (local source) (local target)) (local graph)
        (let
          (binding pairs (type Pairs) (field (local graph) (name pairs)))
          (binding previous (type (map I64 Bool))
            (call std::map-get-or (types I64 (map I64 Bool)) (local pairs) (local source) (map I64 Bool)))
          (in (if (call std::map-get-or (types I64 Bool) (local previous) (local target) (bool false))
            (local graph)
            (let (binding leader (type I64) (call std::list-get (types I64)
              (field (call std::list-get (types Row) (local rows) (local target)) (name members)) (i64 0)))
              (in (record structural
                (field forward (field (local graph) (name forward)))
                (field reverse (field (local graph) (name reverse)))
                (field loops (field (local graph) (name loops)))
                (field dependencies (call append (field (local graph) (name dependencies)) (local source) (local leader)))
                (field pairs (call std::map-insert (types I64 (map I64 Bool)) (local pairs) (local source)
                  (call std::map-insert (types I64 Bool) (local previous) (local target) (bool true)))))))))))))
    (function create targets (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create source (type I64)) (parameter create membership (type Positions))
      (parameter create rows (type (list Row))) (parameter create graph (type Graph)) (returns Graph)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (let
          (binding target (type I64) (call std::list-get (types I64) (local ids) (local offset)))
          (binding source-rank (type I64)
            (call std::map-get-or (types I64 I64) (local membership) (local source) (i64 -1)))
          (binding target-rank (type I64)
            (call std::map-get-or (types I64 I64) (local membership) (local target) (i64 -1)))
          (binding next (type Graph) (record structural
            (field forward (field (local graph) (name forward)))
            (field reverse (call append (field (local graph) (name reverse)) (local target) (local source)))
            (field dependencies (field (local graph) (name dependencies)))
            (field pairs (field (local graph) (name pairs)))
            (field loops (if (call plan-verify-data::same (local source) (local target))
              (call std::map-insert (types I64 Bool) (field (local graph) (name loops)) (local source) (bool true))
              (field (local graph) (name loops))))))
          (in (call targets (local ids) (call std::add (local offset) (i64 1)) (local source)
            (local membership) (local rows) (call distinct (local source-rank) (local target-rank) (local rows) (local next)))))
        (local graph))))
    (function create nodes (visibility private) (effect pure)
      (parameter create input (type (list Node))) (parameter create offset (type I64))
      (parameter create membership (type Positions)) (parameter create rows (type (list Row)))
      (parameter create graph (type Graph)) (returns Graph)
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local input)))
        (let
          (binding node (type Node) (call std::list-get (types Node) (local input) (local offset)))
          (binding id (type I64) (field (local node) (name id)))
          (binding successors (type (list I64)) (field (local node) (name successors)))
          (binding next (type Graph) (record structural
            (field forward (call std::map-insert (types I64 (list I64))
              (field (local graph) (name forward)) (local id) (local successors)))
            (field reverse (field (local graph) (name reverse)))
            (field dependencies (field (local graph) (name dependencies)))
            (field pairs (field (local graph) (name pairs))) (field loops (field (local graph) (name loops)))))
          (in (call nodes (local input) (call std::add (local offset) (i64 1)) (local membership) (local rows)
            (call targets (local successors) (i64 0) (local id) (local membership) (local rows) (local next)))))
        (local graph))))
    (function create build (visibility public) (effect pure)
      (parameter create input (type (list Node))) (parameter create membership (type Positions))
      (parameter create rows (type (list Row))) (returns Graph)
      (body (call nodes (local input) (i64 0) (local membership) (local rows)
        (record structural (field forward (map I64 (list I64))) (field reverse (map I64 (list I64)))
          (field dependencies (map I64 (list I64))) (field pairs (map I64 (map I64 Bool)))
          (field loops (map I64 Bool))))))
    (function create dependencies-valid (visibility public) (effect pure)
      (parameter create rows (type (list Row))) (parameter create dependencies (type Links))
      (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types Row) (local rows)))
        (if (call plan-verify-data::same-list
          (field (call std::list-get (types Row) (local rows) (local offset)) (name dependencies))
          (call std::map-get-or (types I64 (list I64)) (local dependencies) (local offset) (list I64)))
          (call dependencies-valid (local rows) (local dependencies) (call std::add (local offset) (i64 1))) (bool false))
        (bool true))))
    (function create cyclic-valid (visibility public) (effect pure)
      (parameter create rows (type (list Row))) (parameter create loops (type (map I64 Bool)))
      (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types Row) (local rows)))
        (let
          (binding row (type Row) (call std::list-get (types Row) (local rows) (local offset)))
          (binding ids (type (list I64)) (field (local row) (name members)))
          (binding expected (type Bool) (if (call std::less (i64 1) (call std::list-length (types I64) (local ids)))
            (bool true) (call std::map-get-or (types I64 Bool) (local loops)
              (call std::list-get (types I64) (local ids) (i64 0)) (bool false))))
          (in (if (call plan-verify-data::same-bool (local expected) (field (local row) (name cyclic)))
            (call cyclic-valid (local rows) (local loops) (call std::add (local offset) (i64 1))) (bool false))))
        (bool true))))))
declarations.end

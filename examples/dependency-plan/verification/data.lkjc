declarations.begin
(units
  (use std builtin)
  (module create plan-verify-data
    (type-alias Node (record (id I64) (successors (list I64))))
    (function create same (visibility public) (effect pure)
      (parameter create left (type I64)) (parameter create right (type I64)) (returns Bool)
      (body (if (call std::less (local left) (local right)) (bool false)
        (if (call std::less (local right) (local left)) (bool false) (bool true)))))
    (function create same-bool (visibility public) (effect pure)
      (parameter create left (type Bool)) (parameter create right (type Bool)) (returns Bool)
      (body (if (local left) (local right) (if (local right) (bool false) (bool true)))))
    (function create items (visibility private) (effect pure)
      (parameter create left (type (list I64))) (parameter create right (type (list I64)))
      (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local left)))
        (if (call same (call std::list-get (types I64) (local left) (local offset))
          (call std::list-get (types I64) (local right) (local offset)))
          (call items (local left) (local right) (call std::add (local offset) (i64 1))) (bool false))
        (bool true))))
    (function create same-list (visibility public) (effect pure)
      (parameter create left (type (list I64))) (parameter create right (type (list I64)))
      (returns Bool)
      (body (if (call same (call std::list-length (types I64) (local left))
        (call std::list-length (types I64) (local right)))
        (call items (local left) (local right) (i64 0)) (bool false))))
    (function create positions (visibility public) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create offset (type I64))
      (parameter create output (type (map I64 I64))) (returns (map I64 I64))
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local nodes)))
        (call positions (local nodes) (call std::add (local offset) (i64 1))
          (call std::map-insert (types I64 I64) (local output)
            (field (call std::list-get (types Node) (local nodes) (local offset)) (name id)) (local offset)))
        (local output))))))
declarations.end

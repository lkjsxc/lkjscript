declarations.begin
(units
  (use std builtin)
  (module create nominal-tasks
    (type-alias Packet (nominal::Packet OwnedI64Cell))
    (type-alias Joined (owned-product (field left Packet) (field right I64)))
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create value (type I64)) (returns OwnedI64Cell))
    (external create read (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create finish (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create relay (visibility private) (effect (task))
      (parameter create packet (type Packet) (use consume)) (returns Packet) (body (local packet)))
    (function create side (visibility private) (effect (task))
      (parameter create n (type I64)) (returns I64) (body (local n)))
    (function create main (visibility public) (effect (task))
      (parameter create n (type I64)) (returns (record (stamp I64) (payload I64) (side I64)))
      (body (let
        (binding value (type OwnedI64Cell) (call new (local n)))
        (binding packet (type Packet) (call nominal::make (types OwnedI64Cell) (local n) (local value)))
        (binding joined (type Joined) (parallel (call relay (local packet)) (call side (local n))))
        (in (unpack-owned (type Joined) (local joined)
          (field left (binding packet (type Packet))) (field right (binding side (type I64)))
          (in (let
            (binding stamp (type I64)
              (implementation-call nominal::observe (types Packet)
                (implementations (implementation nominal::PacketReader (types OwnedI64Cell)))
                (local packet)))
            (binding value (type OwnedI64Cell) (call nominal::take (types OwnedI64Cell) (local packet)))
            (binding payload (type I64) (call finish (local value)))
            (in (record structural (field stamp (local stamp)) (field payload (local payload))
              (field side (local side)))))))))))
    (function create trap (visibility public) (effect pure)
      (parameter create values (type (list I64))) (returns I64)
      (body (let
        (binding value (type OwnedI64Cell) (call new (i64 7)))
        (binding packet (type Packet) (call nominal::make (types OwnedI64Cell) (i64 7) (local value)))
        (in (borrow-call (call nominal::view (types OwnedI64Cell) (local packet))
          (binding view (type OwnedI64Cell))
          (in (call std::list-get (types I64) (local values) (i64 -1))))))))
    (function create burn (visibility private) (effect pure)
      (parameter create count (type I64)) (parameter create packet (type Packet) (use consume)) (returns I64)
      (body (if (call std::i64-equal (local count) (i64 0))
        (let (binding value (type OwnedI64Cell) (call nominal::take (types OwnedI64Cell) (local packet)))
          (in (call finish (local value))))
        (call burn (call std::subtract (local count) (i64 1)) (local packet)))))
    (function create fuel (visibility public) (effect pure)
      (parameter create count (type I64)) (returns I64)
      (body (let
        (binding value (type OwnedI64Cell) (call new (i64 42)))
        (binding packet (type Packet) (call nominal::make (types OwnedI64Cell) (i64 42) (local value)))
        (in (call burn (local count) (local packet))))))
    (component create command (visibility private)
      (port create main (type (task-function (I64) (record (stamp I64) (payload I64) (side I64)) (row))) (function main))
      (port create trap (type (function ((list I64)) I64)) (function trap))
      (port create fuel (type (function (I64) I64)) (function fuel))))
  (target create nominal-transfer (component nominal-tasks::command) (runner command) (port nominal-tasks::command::main))
  (target create nominal-trap (component nominal-tasks::command) (runner command) (port nominal-tasks::command::trap))
  (target create nominal-fuel (component nominal-tasks::command) (runner command) (port nominal-tasks::command::fuel)))
declarations.end

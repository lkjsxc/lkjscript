declarations.begin
(units
  (module create owned-nominals
    (owned-record create Packet (visibility public)
      (type-parameter create T (constraint owned))
      (field create value (type T))
      (field create stamp (type I64)))
    (owned-record create Twin (visibility public)
      (type-parameter create T (constraint owned))
      (field create value (type T))
      (field create stamp (type I64)))
    (owned-record create Envelope (visibility public)
      (type-parameter create T (constraint owned))
      (field create packet (type (Packet T)))
      (field create note (type Text)))
    (owned-record create Empty (visibility public))
    (owned-record create Data (visibility public)
      (type-parameter create T (constraint transferable))
      (field create value (type T)))
    (owned-record create Phantom (visibility public)
      (type-parameter create T (constraint owned)))
    (owned-record create Marker (visibility public)
      (type-parameter create T (constraint transferable)))
    (owned-contract create Reader (visibility public)
      (self Self) (type-parameter create Self (constraint owned))
      (method method_9b000000000000000000000000000001 stamp
        (parameters (Self borrow)) (returns I64) (effect pure)))
    (function create make (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create stamp (type I64))
      (parameter create value (type T) (use consume)) (returns (Packet T))
      (body (pack-owned (type (Packet T))
        (field value (local value)) (field stamp (local stamp)))))
    (function create stamp (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type (Packet T)) (use borrow)) (returns I64)
      (body (field (local packet) Packet::stamp)))
    (owned-implementation create PacketReader (visibility public)
      (type-parameter create T (constraint owned))
      (contract Reader) (self (Packet T))
      (method method_9b000000000000000000000000000001 stamp (types T)))
    (function create observe (visibility public) (effect pure)
      (type-parameter create S (constraint owned))
      (implementation-parameter implparam_9b000000000000000000000000000001 reader Reader S)
      (parameter create value (type S) (use borrow)) (returns I64)
      (body (method-call parameter@observe@implparam_9b000000000000000000000000000001
        Reader method_9b000000000000000000000000000001 (local value))))
    (function create view (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type (Packet T)) (use borrow))
      (returns T (borrow-from packet))
      (body (borrow-owned-field (type (Packet T)) (local packet)
        (field value (binding view (type T))) (in (local view)))))
    (function create take (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type (Packet T)) (use consume)) (returns T)
      (body (unpack-owned (type (Packet T)) (local packet)
        (field value (binding value (type T)))
        (field stamp (binding ignored (type I64))) (in (local value)))))
    (function create wrap (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type (Packet T)) (use consume)) (returns (Envelope T))
      (body (pack-owned (type (Envelope T))
        (field packet (local packet)) (field note (text "retained owner")))))
    (function create nested-view (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create envelope (type (Envelope T)) (use borrow))
      (returns T (borrow-from envelope))
      (body (borrow-owned-field (type (Envelope T)) (local envelope)
        (field packet (binding packet (type (Packet T))))
        (in (borrow-call (call view (types T) (local packet))
          (binding value (type T)) (in (local value)))))))
    (function create unwrap (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create envelope (type (Envelope T)) (use consume)) (returns (Packet T))
      (body (unpack-owned (type (Envelope T)) (local envelope)
        (field packet (binding packet (type (Packet T))))
        (field note (binding ignored (type Text))) (in (local packet)))))
    (function create empty (visibility public) (effect pure) (returns Empty)
      (body (pack-owned (type Empty))))
    (function create finish-empty (visibility public) (effect pure)
      (parameter create value (type Empty) (use consume)) (returns Unit)
      (body (unpack-owned (type Empty) (local value) (in (unit)))))
    (function create data (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create value (type T)) (returns (Data T))
      (body (pack-owned (type (Data T)) (field value (local value)))))
    (function create data-read (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create value (type (Data T)) (use borrow)) (returns T)
      (body (field (local value) Data::value)))
    (function create finish-data (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create value (type (Data T)) (use consume)) (returns T)
      (body (unpack-owned (type (Data T)) (local value)
        (field value (binding result (type T))) (in (local result)))))
    (function create phantom (visibility public) (effect pure)
      (type-parameter create T (constraint owned)) (returns (Phantom T))
      (body (pack-owned (type (Phantom T)))))
    (function create finish-phantom (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create value (type (Phantom T)) (use consume)) (returns Unit)
      (body (unpack-owned (type (Phantom T)) (local value) (in (unit)))))
    (function create marker (visibility public) (effect pure)
      (type-parameter create T (constraint transferable)) (returns (Marker T))
      (body (pack-owned (type (Marker T)))))
    (function create finish-marker (visibility public) (effect pure)
      (type-parameter create T (constraint transferable))
      (parameter create value (type (Marker T)) (use consume)) (returns Unit)
      (body (unpack-owned (type (Marker T)) (local value) (in (unit)))))))
declarations.end

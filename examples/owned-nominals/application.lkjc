declarations.begin
(units
  (module create nominal-consumer
    (type-alias Packet (nominal::Packet OwnedI64Cell))
    (type-alias Envelope (nominal::Envelope OwnedI64Cell))
    (type-alias Result (record (stamp I64) (direct I64) (nested I64) (payload I64)))
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create value (type I64)) (returns OwnedI64Cell))
    (external create read (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create finish (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64)) (returns Result)
      (body (let
        (binding value (type OwnedI64Cell) (call new (local n)))
        (binding packet (type Packet) (call nominal::make (types OwnedI64Cell) (local n) (local value)))
        (binding stamp (type I64)
          (implementation-call nominal::observe (types Packet)
            (implementations (implementation nominal::PacketReader (types OwnedI64Cell)))
            (local packet)))
        (binding direct (type I64)
          (borrow-call (call nominal::view (types OwnedI64Cell) (local packet))
            (binding view (type OwnedI64Cell)) (in (call read (local view)))))
        (binding envelope (type Envelope) (call nominal::wrap (types OwnedI64Cell) (local packet)))
        (binding nested (type I64)
          (borrow-call (call nominal::nested-view (types OwnedI64Cell) (local envelope))
            (binding view (type OwnedI64Cell)) (in (call read (local view)))))
        (binding packet (type Packet) (call nominal::unwrap (types OwnedI64Cell) (local envelope)))
        (binding value (type OwnedI64Cell) (call nominal::take (types OwnedI64Cell) (local packet)))
        (binding payload (type I64) (call finish (local value)))
        (in (record structural (field stamp (local stamp)) (field direct (local direct))
          (field nested (local nested)) (field payload (local payload)))))))
    (function create data-main (visibility public) (effect pure)
      (parameter create value (type (record (name Text) (values (list I64)))))
      (returns (record (before (record (name Text) (values (list I64))))
        (after (record (name Text) (values (list I64))))))
      (body (let
        (binding empty (type nominal::Empty) (call nominal::empty))
        (binding phantom (type (nominal::Phantom Packet)) (call nominal::phantom (types Packet)))
        (binding marker (type (nominal::Marker (record (name Text) (values (list I64)))))
          (call nominal::marker (types (record (name Text) (values (list I64))))))
        (binding data (type (nominal::Data (record (name Text) (values (list I64)))))
          (call nominal::data (types (record (name Text) (values (list I64)))) (local value)))
        (binding before (type (record (name Text) (values (list I64))))
          (call nominal::data-read (types (record (name Text) (values (list I64)))) (local data)))
        (binding after (type (record (name Text) (values (list I64))))
          (call nominal::finish-data (types (record (name Text) (values (list I64)))) (local data)))
        (in (sequence (call nominal::finish-empty (local empty))
          (call nominal::finish-phantom (types Packet) (local phantom))
          (call nominal::finish-marker (types (record (name Text) (values (list I64)))) (local marker))
          (record structural (field before (local before)) (field after (local after))))))))
    (component create command (visibility private)
      (port create main (type (function (I64) Result)) (function main))
      (port create data (type (function ((record (name Text) (values (list I64))))
        (record (before (record (name Text) (values (list I64))))
          (after (record (name Text) (values (list I64))))))) (function data-main))))
  (target create nominal-main (component nominal-consumer::command) (runner command) (port nominal-consumer::command::main))
  (target create nominal-data (component nominal-consumer::command) (runner command) (port nominal-consumer::command::data)))
declarations.end

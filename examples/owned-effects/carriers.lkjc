declarations.begin
(units
  (module create owned-effect-carriers
    (external create new (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create get (visibility private) (implementation core.cell.read)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create put (visibility private) (implementation core.cell.replace)
      (parameter create n (type I64))
      (parameter create owner (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create length (visibility private) (implementation core.buffer.length)
      (parameter create owner (type ByteBuffer) (use borrow)) (returns I64))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create n (type I64))
      (parameter create owner (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create owner (type ByteBuffer) (use consume)) (returns Bytes))
    (function create cell-create (visibility public)
      (parameter create n (type I64)) (returns OwnedI64Cell) (effect pure)
      (body (call new (local n))))
    (function create cell-read (visibility public)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64) (effect pure)
      (body (call get (local owner))))
    (function create cell-replace (visibility public)
      (parameter create n (type I64))
      (parameter create owner (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell) (effect pure)
      (body (call put (local n) (local owner))))
    (function create cell-finish (visibility public)
      (parameter create owner (type OwnedI64Cell) (use consume)) (returns I64) (effect pure)
      (body (call get (local owner))))
    (function create alternate-read (visibility public)
      (parameter create owner (type OwnedI64Cell) (use borrow)) (returns I64) (effect pure)
      (body (i64 99)))
    (function create buffer-create (visibility public) (returns ByteBuffer) (effect pure)
      (body (let (binding owner (type ByteBuffer) (call empty))
        (in (call push (i64 73) (local owner))))))
    (function create buffer-read (visibility public)
      (parameter create owner (type ByteBuffer) (use borrow)) (returns I64) (effect pure)
      (body (call length (local owner))))
    (function create buffer-replace (visibility public)
      (parameter create n (type I64))
      (parameter create owner (type ByteBuffer) (use consume)) (returns ByteBuffer) (effect pure)
      (body (call push (local n) (local owner))))
    (function create buffer-finish (visibility public)
      (parameter create owner (type ByteBuffer) (use consume)) (returns Bytes) (effect pure)
      (body (call freeze (local owner))))
    (owned-implementation create Scalar (visibility public)
      (contract owned-effects::Storage) (self OwnedI64Cell)
      (method method_84000000000000000000000000000001 cell-read)
      (method method_84000000000000000000000000000002 cell-replace))
    (owned-implementation create Alternate (visibility public)
      (contract owned-effects::Storage) (self OwnedI64Cell)
      (method method_84000000000000000000000000000001 alternate-read)
      (method method_84000000000000000000000000000002 cell-replace))
    (owned-implementation create Octets (visibility public)
      (contract owned-effects::Storage) (self ByteBuffer)
      (method method_84000000000000000000000000000001 buffer-read)
      (method method_84000000000000000000000000000002 buffer-replace))))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create owned-effects-app
    (function create increment-a (visibility private)
      (parameter create n (type I64)) (returns I64)
      (effect (task (requirement command::clock-a)))
      (body (sequence
        (capability-call command::clock-a std::WallClock::utc-milliseconds)
        (call std::add (local n) (i64 1)))))
    (function create increment-b (visibility private)
      (parameter create n (type I64)) (returns I64)
      (effect (task (requirement command::clock-b)))
      (body (sequence
        (capability-call command::clock-b std::WallClock::utc-milliseconds)
        (call std::add (local n) (i64 1)))))
    (function create main (visibility public)
      (returns (record (scalar I64) (rebound I64) (alternate I64) (bytes Bytes)))
      (effect (task (requirement command::clock-a) (requirement command::clock-b)))
      (body (let
        (binding cell (type OwnedI64Cell) (call owned-effect-carriers::cell-create (i64 42)))
        (binding first (type OwnedI64Cell)
          (implementation-call owned-effects::transform (types OwnedI64Cell)
            (effects (row (requirement command::clock-b))) (requirements command::clock-a)
            (implementations concrete@owned-effect-carriers::Scalar)
            (function-value increment-b) (local cell)))
        (binding scalar (type I64) (call owned-effect-carriers::cell-finish (local first)))
        (binding other (type OwnedI64Cell) (call owned-effect-carriers::cell-create (i64 42)))
        (binding second (type OwnedI64Cell)
          (implementation-call owned-effects::relay (types OwnedI64Cell)
            (effects (row (requirement command::clock-a))) (requirements command::clock-b)
            (implementations concrete@owned-effect-carriers::Scalar)
            (function-value increment-a) (local other)))
        (binding rebound (type I64) (call owned-effect-carriers::cell-finish (local second)))
        (binding opaque (type OwnedI64Cell) (call owned-effect-carriers::cell-create (i64 42)))
        (binding third (type OwnedI64Cell)
          (implementation-call owned-effects::nested-relay (types OwnedI64Cell)
            (effects (row (requirement command::clock-b))) (requirements command::clock-a)
            (implementations concrete@owned-effect-carriers::Alternate)
            (function-value increment-b) (local opaque)))
        (binding alternate (type I64) (call owned-effect-carriers::cell-finish (local third)))
        (binding octets (type ByteBuffer) (call owned-effect-carriers::buffer-create))
        (binding fourth (type ByteBuffer)
          (implementation-call owned-effects::nested-relay (types ByteBuffer)
            (effects (row (requirement command::clock-a))) (requirements command::clock-b)
            (implementations concrete@owned-effect-carriers::Octets)
            (function-value increment-a) (local octets)))
        (binding bytes (type Bytes) (call owned-effect-carriers::buffer-finish (local fourth)))
        (in (record structural
          (field scalar (local scalar)) (field rebound (local rebound))
          (field alternate (local alternate)) (field bytes (local bytes)))))))
    (component create command (visibility private)
      (requirement create clock-a (interface std::WallClock)
        (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 4 calls)))
      (requirement create clock-b (interface std::WallClock)
        (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 4 calls)))
      (port create main
        (type (task-function () (record (scalar I64) (rebound I64) (alternate I64) (bytes Bytes))
          (row (requirement clock-a) (requirement clock-b)))) (function main))))
  (target create owned-effects (component owned-effects-app::command)
    (runner command) (port owned-effects-app::command::main)))
declarations.end

request base=BASE
add.dependency package=pkg_10000000000000000000000000000001 semantic-revision=rev_0c24feeba2cf086edecde1241930f4a8019f0c1c7f5a6dfe72b187f02662a5bb package-revision=package_revision_9694ca1acf820bd3e05276d9822dbc4cc7e48ec8138685f5efa97f291a5dd049
declarations.begin
(units
  (use std builtin)
  (module create policy
    (function create python-extension (visibility public)
      (parameter create extension (type Text))
      (returns Bool) (effect pure)
      (body (call std::bool-or
        (call std::bool-or
          (call std::text-equal (local extension) (text "py"))
          (call std::text-equal (local extension) (text "pY")))
        (call std::bool-or
          (call std::text-equal (local extension) (text "Py"))
          (call std::text-equal (local extension) (text "PY"))))))
    (function create ascii-equal (visibility private)
      (parameter create value (type I64))
      (parameter create lowercase (type I64))
      (returns Bool) (effect pure)
      (body (call std::bool-or
        (call std::i64-equal (local value) (local lowercase))
        (call std::i64-equal (local value)
          (call std::subtract (local lowercase) (i64 32))))))
    (function create word-at (visibility private)
      (parameter create bytes (type (list I64)))
      (parameter create position (type I64))
      (parameter create limit (type I64))
      (parameter create word (type (list I64)))
      (parameter create offset (type I64))
      (returns Bool) (effect pure)
      (body
        (if (call std::i64-equal (local offset) (call std::list-length (types I64) (local word)))
          (bool true)
          (let (binding index (call std::add (local position) (local offset)))
            (in (if (call std::less (local index) (local limit))
              (if (call ascii-equal
                (call std::list-get (types I64) (local bytes) (local index))
                (call std::list-get (types I64) (local word) (local offset)))
                (call word-at (local bytes) (local position) (local limit) (local word)
                  (call std::add (local offset) (i64 1)))
                (bool false))
              (bool false)))))))
    (function create search-first-line (visibility private)
      (parameter create bytes (type (list I64)))
      (parameter create position (type I64))
      (parameter create limit (type I64))
      (returns Bool) (effect pure)
      (body
        (if (call std::less (local position) (local limit))
          (if (call std::i64-equal (call std::list-get (types I64) (local bytes) (local position)) (i64 10))
            (bool false)
            (if (call word-at (local bytes) (local position) (local limit)
              (list I64 (i64 112) (i64 121) (i64 116) (i64 104) (i64 111) (i64 110)) (i64 0))
              (bool true)
              (call search-first-line (local bytes) (call std::add (local position) (i64 1)) (local limit))))
          (bool false))))
    (function create python-shebang (visibility public)
      (parameter create bytes (type (list I64)))
      (returns Bool) (effect pure)
      (body
        (let (binding length (call std::list-length (types I64) (local bytes)))
          (in (if (call std::less (local length) (i64 2)) (bool false)
            (if (call std::bool-and
              (call std::i64-equal (call std::list-get (types I64) (local bytes) (i64 0)) (i64 35))
              (call std::i64-equal (call std::list-get (types I64) (local bytes) (i64 1)) (i64 33)))
              (call search-first-line (local bytes) (i64 2)
                (if (call std::less (local length) (i64 512)) (local length) (i64 512)))
              (bool false)))))))
    (function create extensions (visibility public)
      (parameter create values (type (list Text)))
      (returns (list Bool)) (effect pure)
      (body (call std::list-map (types Text Bool) (local values) (function-value python-extension))))
    (function create shebangs (visibility public)
      (parameter create values (type (list (list I64))))
      (returns (list Bool)) (effect pure)
      (body (call std::list-map (types (list I64) Bool) (local values) (function-value python-shebang))))
    (test create extension-cases (visibility private)
      (actual (call extensions (list Text (text "py") (text "pY") (text "Py") (text "PY"))))
      (expected (list Bool (bool true) (bool true) (bool true) (bool true))))
    (test create other-extensions (visibility private)
      (actual (call extensions (list Text (text "") (text "pyc") (text ".py") (text "py ") (text "ｐｙ") (text "rs"))))
      (expected (list Bool (bool false) (bool false) (bool false) (bool false) (bool false) (bool false))))
    (test create empty-batches (visibility private)
      (actual (call extensions (list Text))) (expected (list Bool)))
    (test create empty-prefix (visibility private)
      (actual (call python-shebang (list I64))) (expected (bool false)))
    (test create lone-hash (visibility private)
      (actual (call python-shebang (list I64 (i64 35)))) (expected (bool false)))
    (test create empty-shebang (visibility private)
      (actual (call python-shebang (list I64 (i64 35) (i64 33)))) (expected (bool false)))
    (test create lowercase-shebang (visibility private)
      (actual (call python-shebang (list I64 (i64 35) (i64 33) (i64 112) (i64 121) (i64 116) (i64 104) (i64 111) (i64 110))))
      (expected (bool true)))
    (test create mixed-case-raw-shebang (visibility private)
      (actual (call python-shebang (list I64 (i64 35) (i64 33) (i64 255) (i64 80) (i64 121) (i64 84) (i64 104) (i64 79) (i64 110) (i64 0))))
      (expected (bool true)))
    (test create non-shebang (visibility private)
      (actual (call python-shebang (list I64 (i64 112) (i64 121) (i64 116) (i64 104) (i64 111) (i64 110))))
      (expected (bool false)))
    (test create second-line-ignored (visibility private)
      (actual (call python-shebang (list I64 (i64 35) (i64 33) (i64 10) (i64 112) (i64 121) (i64 116) (i64 104) (i64 111) (i64 110))))
      (expected (bool false)))
    (test create newline-inside-word (visibility private)
      (actual (call python-shebang (list I64 (i64 35) (i64 33) (i64 112) (i64 121) (i64 10) (i64 116) (i64 104) (i64 111) (i64 110))))
      (expected (bool false)))
    (component create console (visibility private)
      (port create extensions (type (function ((list Text)) (list Bool))) (function extensions))
      (port create shebangs (type (function ((list (list I64))) (list Bool))) (function shebangs))))
  (target create extensions (component policy::console) (runner command) (port policy::console::extensions))
  (target create shebangs (component policy::console) (runner command) (port policy::console::shebangs)))
declarations.end

// Run with a compiler executable and an existing empty work directory.
// This suite uses only lkjscript capabilities and leaves that directory empty.
mod static_view_edit_tests;
mod diagnostic_edits;
mod borrow_edit_tests;
mod consumer_edit_tests;
mod iterator_edit_tests;
mod runtime_diagnostic_tests;
mod array_trim_edit_tests;
struct Outcome {
    status: i64,
    output: Vec<u8>,
    errors: Vec<u8>,
    result: Vec<u8>,
}

struct Config {
    directory: String,
    options: Vec<Vec<u8>>,
}

struct Report {
    failures: Vec<String>,
}

impl Report {
    fn require(&mut self, condition: bool, message: String) {
        if !condition {
            self.failures.push(message);
        }
    }

    fn equal(&mut self, label: &str, stream: &str, actual: &[u8], expected: &[u8]) {
        if actual != expected {
            let mut index = 0usize;
            while index < actual.len() && index < expected.len() && actual[index] == expected[index]
            {
                index = index + 1;
            }
            self.failures.push(format!(
                "{label}: {stream} differs at byte {index}; expected {} bytes, got {} bytes",
                expected.len(),
                actual.len()
            ));
        }
    }

    fn outcome(
        &mut self,
        label: &str,
        actual: &Outcome,
        status: i64,
        output: &[u8],
        errors: &[u8],
    ) {
        if actual.status != status {
            self.failures.push(format!(
                "{label}: expected status {status}, got {}; stderr {}",
                actual.status,
                display_bytes(&actual.errors)
            ));
        }
        self.equal(label, "stdout", &actual.output, output);
        self.equal(label, "stderr", &actual.errors, errors);
        self.equal(label, "driver result descriptor", &actual.result, b"");
    }
}

fn display_bytes(bytes: &[u8]) -> String {
    let mut text = String::new();
    for byte in bytes {
        if *byte >= 32 && *byte < 127 {
            text.push(*byte as char);
        } else {
            text.push_str(&format!("\\x{:02x}", *byte));
        }
    }
    text
}

fn contains(bytes: &[u8], needle: &[u8]) -> bool {
    if needle.len() > bytes.len() {
        return false;
    }
    let mut index = 0usize;
    while index <= bytes.len() - needle.len() {
        if &bytes[index..index + needle.len()] == needle {
            return true;
        }
        index = index + 1;
    }
    false
}

fn io_result<T>(result: Result<T, i64>, label: &str) -> Result<T, String> {
    match result {
        Ok(value) => Ok(value),
        Err(errno) => Err(format!("{label}: errno {errno}")),
    }
}

fn text(bytes: Vec<u8>, label: &str) -> Result<String, String> {
    match String::from_utf8(bytes) {
        Ok(value) => Ok(value),
        Err(_) => Err(format!("{label} is not UTF-8")),
    }
}

fn temporary(world: &mut World) -> Result<File, String> {
    io_result(world.temporary_file(), &format!("temporary file"))
}

fn invoke(
    world: &mut World,
    executable: &File,
    arguments: &[Vec<u8>],
    input: &[u8],
) -> Result<Outcome, String> {
    let mut stdin: File = temporary(world)?;
    let mut stdout: File = temporary(world)?;
    let mut stderr: File = temporary(world)?;
    let mut result: File = temporary(world)?;
    if let Err(errno) = stdin.write_all(input) {
        return Err(format!("input write: errno {errno}"));
    }
    io_result(stdin.rewind(), &format!("input rewind"))?;
    let mut process = world.process();
    let mut child = io_result(
        process.spawn_file(executable, arguments, &stdin, &stdout, &stderr, &result),
        &format!("spawn compiler"),
    )?;
    let status = io_result(child.wait(), &format!("wait compiler"))?;
    io_result(stdout.rewind(), &format!("output rewind"))?;
    io_result(stderr.rewind(), &format!("error rewind"))?;
    io_result(result.rewind(), &format!("result rewind"))?;
    let output = io_result(stdout.read_to_end(), &format!("output read"))?;
    let errors = io_result(stderr.read_to_end(), &format!("error read"))?;
    let result = io_result(result.read_to_end(), &format!("result read"))?;
    Ok(Outcome {
        status,
        output,
        errors,
        result,
    })
}

fn path(config: &Config, name: &str) -> String {
    format!("{}/{name}", config.directory)
}

fn command(config: &Config, verb: &str, name: &str) -> Vec<Vec<u8>> {
    let mut arguments = vec![
        verb.as_bytes().to_vec(),
        path(config, name).as_bytes().to_vec(),
    ];
    let mut index = 0usize;
    while index < config.options.len() {
        let name = String::from_utf8(config.options[index].clone()).unwrap();
        if verb == "batch" || (name != "--store" && name != "--store-key") {
            arguments.push(config.options[index].clone());
            arguments.push(config.options[index + 1usize].clone());
        }
        index += 2usize;
    }
    arguments
}

fn option(arguments: &mut Vec<Vec<u8>>, name: &str, value: &str) {
    arguments.push(name.as_bytes().to_vec());
    arguments.push(value.as_bytes().to_vec());
}

fn write(directory: &mut Directory, name: &str, bytes: &[u8]) -> Result<(), String> {
    let mut file = match directory.create(name) {
        Ok(file) => file,
        Err(errno) => return Err(format!("create {name}: errno {errno}")),
    };
    match file.write_all(bytes) {
        Ok(()) => Ok(()),
        Err(errno) => Err(format!("write {name}: errno {errno}")),
    }
}

fn read(directory: &mut Directory, name: &str) -> Result<Vec<u8>, String> {
    let mut file = match directory.open(name) {
        Ok(file) => file,
        Err(errno) => return Err(format!("open {name}: errno {errno}")),
    };
    io_result(file.read_to_end(), &format!("read {name}"))
}

fn compile_ir(
    world: &mut World,
    executable: &File,
    config: &Config,
    report: &mut Report,
    source: &str,
    output: &str,
) -> Result<(), String> {
    let arguments = command(config, "check", source);
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome(&format!("check {source}"), &result, 0, b"", b"");
    let mut arguments = command(config, "ir", source);
    option(&mut arguments, "-o", &path(config, output));
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome(&format!("ir {source}"), &result, 0, b"", b"");
    let arguments = command(config, "check", output);
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome(&format!("check {output}"), &result, 0, b"", b"");
    Ok(())
}

struct ValueRequest {
    name: String,
    entry: String,
    expected: String,
}
fn bytes_hex(bytes: &[u8]) -> String {
    let digits = b"0123456789abcdef";
    let mut result = String::new();
    for byte in bytes {
        result.push(digits[(*byte >> 4u8) as usize] as char);
        result.push(digits[(*byte & 15u8) as usize] as char);
    }
    result
}
fn run_values(
    world: &mut World, executable: &File, config: &Config, report: &mut Report,
    cases: &[ValueRequest],
) -> Result<(), String> {
    let mut requests = String::new();
    for case in cases {
        requests.push_str(&format!("run\t{}\t{}\n", case.entry, path(config, &case.name)));
    }
    let mut directory = io_result(world.directory(&config.directory), "value batch directory")?;
    write(&mut directory, "values.batch", requests.as_bytes())?;
    let mut arguments = command(config, "batch", "values.batch");
    option(&mut arguments, "--engines", "native,interpreter");
    arguments.push(b"--stats"[..].to_vec());
    let actual = invoke(world, executable, &arguments, b"")?;
    report.require(actual.status == 0 && actual.result.is_empty(),
        format!("value batch failed: {} {}", actual.status, display_bytes(&actual.errors)));
    let output = text(actual.output, "value batch output")?;
    let mut records = 0usize;
    for line in output.as_str().lines() {
        if line.is_empty() { continue; }
        let fields = std::json::parse(line.as_bytes())
            .map_err(|_| -> String { "malformed value batch JSON".to_string() })?;
        let index = records / 2usize;
        if index >= cases.len() { return Err("extra value batch record".to_string()); }
        let engine = if records % 2usize == 0usize { "native" } else { "interpreter" };
        let expected = bytes_hex(cases[index].expected.as_bytes());
        report.require(fields.get("index").and_then(|v: &std::json::Value| v.as_usize()) == Some(index)
            && fields.get("engine").and_then(|v: &std::json::Value| v.as_str()) == Some(engine)
            && fields.get("checkStatus").and_then(|v: &std::json::Value| v.as_usize()) == Some(0usize)
            && fields.get("status").and_then(|v: &std::json::Value| v.as_usize()) == Some(0usize)
            && fields.get("stdoutHex").and_then(|v: &std::json::Value| v.as_str()) == Some(expected.as_str())
            && fields.get("stderrHex").and_then(|v: &std::json::Value| v.as_str()) == Some("")
            && fields.get("stderr").and_then(|v: &std::json::Value| v.as_str()) == Some(""),
            format!("run {} {} {engine}: {line}", cases[index].name, cases[index].entry));
        records += 1usize;
    }
    report.require(records == cases.len() * 2usize, "missing value batch records".to_string());
    let details = text(actual.errors, "value batch diagnostics")?;
    let mut statistics = 0usize;
    for line in details.as_str().lines() {
        if line.starts_with("LKJSCRIPT_STATS ") {
            world.stdout().write(format!("{line}\n").as_bytes());
            statistics += 1usize;
        } else if !line.is_empty() {
            report.failures.push(format!("unexpected value batch diagnostic: {line}"));
        }
    }
    report.require(statistics == 1usize, "missing value batch statistics".to_string());
    Ok(())
}
fn run_value(
    world: &mut World, executable: &File, config: &Config, report: &mut Report,
    name: &str, entry: &str, expected: &str,
) -> Result<(), String> {
    let cases = vec![ValueRequest {
        name: name.to_string(), entry: entry.to_string(), expected: expected.to_string(),
    }];
    run_values(world, executable, config, report, &cases)
}

fn pair(first: &str, second: &str) -> Vec<String> {
    vec![first.to_string(), second.to_string()]
}

struct Scalar {
    name: String,
    kind: String,
    expression: String,
    expected: String,
}

fn scalar(name: &str, kind: &str, expression: &str, expected: &str) -> Scalar {
    Scalar {
        name: name.to_string(),
        kind: kind.to_string(),
        expression: expression.to_string(),
        expected: expected.to_string(),
    }
}

fn scalars() -> Vec<Scalar> {
    vec![
        scalar("probe", "i64", "42", "42\n"),
        scalar("i8_min", "i8", "-128", "-128\n"),
        scalar("i8_max", "i8", "127", "127\n"),
        scalar("u8_max", "u8", "255", "255\n"),
        scalar("i16_min", "i16", "-32768", "-32768\n"),
        scalar("i16_max", "i16", "32767", "32767\n"),
        scalar("u16_max", "u16", "65535", "65535\n"),
        scalar("i32_min", "i32", "-2147483648", "-2147483648\n"),
        scalar("i32_max", "i32", "2147483647", "2147483647\n"),
        scalar("u32_max", "u32", "4294967295", "4294967295\n"),
        scalar(
            "i64_min",
            "i64",
            "-9223372036854775808",
            "-9223372036854775808\n",
        ),
        scalar(
            "i64_max",
            "i64",
            "9223372036854775807",
            "9223372036854775807\n",
        ),
        scalar(
            "u64_max",
            "u64",
            "18446744073709551615",
            "18446744073709551615\n",
        ),
        scalar(
            "isize_min",
            "isize",
            "-9223372036854775808",
            "-9223372036854775808\n",
        ),
        scalar(
            "usize_max",
            "usize",
            "18446744073709551615",
            "18446744073709551615\n",
        ),
        scalar("boolean_true", "bool", "true", "true\n"),
        scalar("boolean_false", "bool", "false", "false\n"),
        scalar("unicode", "char", "'🦀'", "🦀\n"),
        scalar("character_zero", "char", "'\\0'", "\0\n"),
        scalar(
            "float_zero",
            "f64",
            "f64::from_bits(0)",
            "f64:0x0000000000000000\n",
        ),
        scalar(
            "float_negative_zero",
            "f64",
            "f64::from_bits(0x8000000000000000)",
            "f64:0x8000000000000000\n",
        ),
        scalar(
            "float_infinity",
            "f64",
            "f64::from_bits(0x7ff0000000000000)",
            "f64:0x7ff0000000000000\n",
        ),
        scalar(
            "float_nan",
            "f64",
            "f64::from_bits(0x7ff8000000000042)",
            "f64:0x7ff8000000000042\n",
        ),
        scalar(
            "float_signaling_nan",
            "f64",
            "f64::from_bits(0xfff0000000000001)",
            "f64:0xfff0000000000001\n",
        ),
        scalar("unit", "()", "()", ""),
    ]
}

fn occurrences(bytes: &[u8], needle: &[u8]) -> usize {
    let mut count = 0usize;
    let mut index = 0usize;
    while index + needle.len() <= bytes.len() {
        if &bytes[index..index + needle.len()] == needle {
            count = count + 1;
            index = index + needle.len();
        } else {
            index = index + 1;
        }
    }
    count
}

fn rewrite_diagnostics(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    diagnostic_edits::self_test();
    let cases: Vec<(String, String, String, String)> = vec![
        ("split-edit.lkj".to_string(), include_str!("../tests/diagnostics/string_split.lkj").to_string(), "probe".to_string(), "2\n".to_string()),
        ("empty-edit.lkj".to_string(), include_str!("../tests/diagnostics/empty_slice_argument.lkj").to_string(), "probe".to_string(), "0\n".to_string()),
        ("const-edit.lkj".to_string(), include_str!("../tests/diagnostics/local_const_declaration.lkj").to_string(), "probe".to_string(), "7\n".to_string()),
        ("iteration-edit.lkj".to_string(), include_str!("../tests/diagnostics/owned_array_iteration.lkj").to_string(), "probe".to_string(), "3\n".to_string()),
        ("split-custom-count.lkj".to_string(), r#"trait Count { fn count(self) -> usize; }
impl<'a> Count for std::str::Split<'a, char> {
    fn count(self) -> usize { 99usize }
}
pub fn probe() -> usize { "a\nb".to_string().split('\n').count() }
"#.to_string(), "probe".to_string(), "99\n".to_string()),
        ("split-once.lkj".to_string(), r#"fn text(calls: &mut i64) -> String { *calls += 1; "a\nb".to_string() }
pub fn probe() -> i64 {
    let mut calls = 0i64;
    let count = text(&mut calls).split('\n').count();
    calls * 100i64 + count as i64
}"#.to_string(), "probe".to_string(), "102\n".to_string()),
        ("iteration-once.lkj".to_string(), r#"fn item(calls: &mut u64, value: u64) -> u64 { *calls = *calls * 10u64 + value; value }
pub fn probe() -> u64 {
    let mut calls = 0u64;
    let mut sum = 0u64;
    for value in [item(&mut calls, 1u64), item(&mut calls, 2u64)] { sum += value; }
    calls * 100u64 + sum
}"#.to_string(), "probe".to_string(), "1203\n".to_string()),
        ("const-π.lkj".to_string(), r#"// π: edits count bytes and preserve the public function and its attributes.
#[allow(dead_code)]
pub fn probe() -> i64 { const VALUE: i64 = 7; VALUE }
"#.to_string(), "probe".to_string(), "7\n".to_string()),
        ("array-edit.lkj".to_string(), include_str!("../tests/diagnostics/array_to_vec.lkj").to_string(), "probe".to_string(), "4\n".to_string()),
        ("string-edit.lkj".to_string(), include_str!("../tests/diagnostics/string_parse.lkj").to_string(), "probe".to_string(), "123\n".to_string()),
        ("map-edit.lkj".to_string(), include_str!("../tests/diagnostics/map_err_closure_context.lkj").to_string(), "probe".to_string(), "true\n".to_string()),
        ("quote\"-π.lkj".to_string(), r#"// π 😀: offsets count UTF-8 bytes.
fn bytes(calls: &mut i64) -> [u8; 4] { *calls += 1; [1u8, 2u8, 3u8, 4u8] }
pub fn probe() -> i64 {
    let mut calls = 0i64;
    let values = bytes(&mut calls).to_vec();
    calls * 100i64 + values.len() as i64
}"#.to_string(), "probe".to_string(), "104\n".to_string()),
        ("string-once.lkj".to_string(), r#"fn text(calls: &mut i64) -> String { *calls += 1; "123".to_string() }
pub fn probe() -> i64 {
    let mut calls = 0i64;
    let value = text(&mut calls).parse::<u16>().unwrap();
    calls * 1000i64 + value as i64
}"#.to_string(), "probe".to_string(), "1123\n".to_string()),
        ("map-once.lkj".to_string(), r#"fn scenario(world: &mut World, bad: bool) {
    let __lkjscript_result_0 = 2i64;
    let __lkjscript_value_0 = 5i64;
    let result: Result<i64, i64> = if bad { Err(7i64) } else { Ok(42i64) };
    let good = { world.stdout().write(b"R"); result }
        .map_err(|_| "invalid".to_string()).is_ok();
    assert!(__lkjscript_result_0 + __lkjscript_value_0 == 7i64);
    if good { world.stdout().write(b"O"); } else { world.stdout().write(b"E"); }
}
pub fn main(mut world: World) { scenario(&mut world, false); scenario(&mut world, true); world.stdout().write(b"\n"); }
"#.to_string(), "main".to_string(), "RORE\n".to_string()),
    ];
    for (name, source, entry, expected) in cases {
        write(directory, &name, source.as_bytes())?;
        let checked = invoke(world, executable, &command(config, "check", &name), b"")?;
        if checked.status != 1 {
            return Err(format!("diagnostic edit fixture {name} did not reject before its rewrite"));
        }
        let required = match name.as_str() {
            "split-edit.lkj" => "String.split requires a str receiver",
            "empty-edit.lkj" => "empty array literal [] needs an element type",
            "const-edit.lkj" => "local const declarations are unsupported",
            "iteration-edit.lkj" => "owned-array iteration requires an IntoIterator implementation",
            _ => "",
        };
        report.require(
            contains(&checked.errors, b"docs/language.md") && contains(&checked.errors, required.as_bytes()),
            format!("diagnostic edit fixture {name} omitted its construct, rule or language reference"),
        );
        let rewritten = diagnostic_edits::apply(&source, &checked.errors, &path(config, &name))?;
        write(directory, &name, rewritten.as_bytes())?;
        run_value(world, executable, config, report, &name, &entry, &expected)?;
    }
    let unchanged: Vec<(String, String)> = vec![
        ("nested-const.lkj".to_string(), r#"mod nested {
    pub fn value() -> i64 { const VALUE: i64 = 7; VALUE }
}
pub fn probe() -> i64 { nested::value() }
"#.to_string()),
        ("captured-const.lkj".to_string(), r#"pub fn probe(input: i64) -> i64 { const VALUE: i64 = input; VALUE }
"#.to_string()),
        ("shadowed-const.lkj".to_string(), r#"pub fn probe(VALUE: i64) -> i64 { const VALUE: i64 = 7; VALUE }
"#.to_string()),
        ("array-place.lkj".to_string(), r#"pub fn probe() -> u64 {
    let values = [1u64, 2u64];
    let mut sum = 0u64;
    for value in values { sum += value; }
    sum
}"#.to_string()),
        ("shadowed-string.lkj".to_string(), r#"struct String { value: u64 }
pub fn probe() -> usize { String { value: 1u64 }.split('\n').count() }
"#.to_string()),
        ("borrowed-map.lkj".to_string(), r#"pub fn probe() -> bool {
    let value = String::from_utf8(Vec::new());
    (&value).map_err(|_| "invalid".to_string()).is_ok()
}"#.to_string()),
        ("map-captures.lkj".to_string(), r#"struct Marker { output: Stdout }
impl Drop for Marker { fn drop(&mut self) { self.output.write(b"D"); } }
fn consumed(mut marker: Marker) { marker.output.write(b"C"); }
pub fn main(mut world: World) {
    let marker = Marker { output: world.stdout() };
    let _good = String::from_utf8(vec![255u8]).map_err(move |_| {
        consumed(marker);
        "invalid".to_string()
    }).is_ok();
}"#.to_string()),
        ("map-return.lkj".to_string(), r#"pub fn probe() -> bool {
    String::from_utf8(vec![255u8]).map_err(|_| {
        if true { return "early".to_string(); }
        "invalid".to_string()
    }).is_ok()
}"#.to_string()),
        ("map-question.lkj".to_string(), r#"pub fn probe() -> bool {
    String::from_utf8(vec![255u8]).map_err(|_| {
        let input: Result<i64, i64> = Err(7i64);
        let _value = input?;
        Ok::<_, i64>("invalid".to_string())
    }).is_ok()
}"#.to_string()),
    ];
    for (name, source) in unchanged {
        write(directory, &name, source.as_bytes())?;
        let rejected = invoke(world, executable, &command(config, "check", &name), b"")?;
        report.require(
            rejected.status == 1 && !contains(&rejected.errors, b"LKJSCRIPT_EDITS "),
            format!("unsafe or context-dependent diagnostic rewrite for {name}: {}", display_bytes(&rejected.errors)),
        );
    }
    // A user implementation reaches ordinary resolution before any rewrite is
    // considered. Do not diagnose the literal array merely from its syntax.
    let implemented = r#"impl IntoIterator for [u64; 2] {
    type IntoIter = std::iter::IntoIter<u64>;
    fn into_iter(self) -> std::iter::IntoIter<u64> { vec![self[0], self[1]].into_iter() }
}
pub fn probe() -> u64 {
    let mut sum = 0u64;
    for value in [1u64, 2u64] { sum += value; }
    sum
}
"#;
    write(directory, "array-implemented.lkj", implemented.as_bytes())?;
    run_value(world, executable, config, report, "array-implemented.lkj", "probe", "3\n")?;
    Ok(())
}

fn diagnostics(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    rewrite_diagnostics(world, executable, directory, config, report)?;
    static_view_edit_tests::run(world, executable, directory, config, report)?;
    array_trim_edit_tests::run(world, executable, directory, config, report)?;
    borrow_edit_tests::run(world, executable, directory, config, report)?;
    consumer_edit_tests::run(world, executable, directory, config, report)?;
    iterator_edit_tests::run(world, executable, directory, config, report)?;
    runtime_diagnostic_tests::run(world, executable, directory, config, report)?;
    write(directory, "recovered.lkj", b"fn broken() { let = 1; } fn probe() -> i64 { 42 }")?;
    write(directory, "independent.lkj", b"fn first() -> i64 { true }\nfn second() -> bool { 1i64 }\n")?;
    for name in pair("recovered.lkj", "independent.lkj") {
        let mut arguments = command(config, "build", &name);
        option(&mut arguments, "-o", &path(config, "rejected-artifact"));
        let result = invoke(world, executable, &arguments, b"")?;
        report.require(
            result.status == 1 && result.output.is_empty(),
            format!("build {name}: rejection status/stdout differs"),
        );
        if name == "recovered.lkj" {
            report.require(contains(&result.errors, b": E_PARSE "), format!("build {name}: missing parse diagnostic"));
        } else {
            report.require(
                occurrences(&result.errors, b": E_TYPE ") == 2 && contains(&result.errors, b"E_BLOCKED"),
                format!("build {name}: independent errors or blocking diagnostic missing: {}", display_bytes(&result.errors)),
            );
        }
        report.require(
            directory.open("rejected-artifact").is_err(),
            format!("build {name} published a rejected artifact"),
        );
    }
    write(directory, "four-errors.lkj", include_str!("../tests/diagnostics/four_errors.lkj").as_bytes())?;
    let arguments = command(config, "check", "four-errors.lkj");
    let result = invoke(world, executable, &arguments, b"")?;
    report.require(result.status == 1, "four independent diagnostics: expected rejection".to_string());
    for code in vec!["E_TYPE".to_string(), "E_NAME".to_string(), "E_BORROW".to_string(), "E_MOVE".to_string()] {
        report.require(
            contains(&result.errors, format!(": {code} ").as_bytes()),
            format!("four independent diagnostics: missing {code}"),
        );
    }
    let callable = "fn invalid<'a, F: FnMut(&'a mut i64) -> i64>(mut function: F, value: &'a mut i64) -> i64 {\n    let result = function(value);\n    *value = 0;\n    result\n}\nfn probe() -> i64 { 42 }\n";
    write(directory, "retained-callable.lkj", callable.as_bytes())?;
    let arguments = command(config, "check", "retained-callable.lkj");
    let result = invoke(world, executable, &arguments, b"")?;
    report.require(
        result.status == 1
            && contains(&result.errors, b":3:5: E_BORROW value.*:")
            && contains(&result.errors, b"created at 2:18"),
        format!("retained callable omitted place or either source location: {}", display_bytes(&result.errors)),
    );
    write(directory, "view-entry.lkj", include_str!("../tests/conformance/pass/inline_view_values.lkj").as_bytes())?;
    for engine in pair("native", "interpreter") {
        let mut arguments = command(config, "run", "view-entry.lkj");
        option(&mut arguments, "--entry", "text");
        option(&mut arguments, "--engine", &engine);
        let result = invoke(world, executable, &arguments, b"")?;
        report.require(
            result.status == 1 && result.output.is_empty()
                && contains(&result.errors, b"E_ENTRY host entry result must be unit or a scalar"),
            format!("view entry {engine}: result was not rejected before execution"),
        );
    }
    let recursion = "fn direct(n: i64) -> i64 { if n == 0 { 0 } else { 1 + direct(n - 1) } }\nfn left(n: i64) -> i64 { if n == 0 { 0 } else { 1 + right(n - 1) } }\nfn right(n: i64) -> i64 { if n == 0 { 0 } else { 1 + left(n - 1) } }\nfn probe() -> i64 { direct(100000) + left(100000) }\n";
    write(directory, "recursion.lkj", recursion.as_bytes())?;
    let mut arguments = command(config, "run", "recursion.lkj");
    option(&mut arguments, "--engine", "native");
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome("native direct and mutual recursion", &result, 0, b"200000\n", b"");
    let cleanup = "struct Node { depth: i64 }\nfn destroy(depth: i64) { let node = Node { depth }; }\nimpl Drop for Node { fn drop(&mut self) { if self.depth > 0 { destroy(self.depth - 1); } } }\n#[test] fn deep_cleanup() { destroy(30000); }\n";
    write(directory, "recursive-drop.lkj", cleanup.as_bytes())?;
    let mut arguments = command(config, "test", "recursive-drop.lkj");
    option(&mut arguments, "--engine", "native");
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome("native recursive cleanup", &result, 0, b"ok 1 tests\n", b"");
    Ok(())
}

fn exercise(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    let cases = scalars();
    let mut source = String::new();
    for case in &cases {
        source.push_str(&format!(
            "fn {}() -> {} {{ {} }}\n",
            case.name, case.kind, case.expression
        ));
    }
    write(directory, "scalars.lkj", source.as_bytes())?;
    compile_ir(
        world,
        executable,
        config,
        report,
        "scalars.lkj",
        "scalars.lkjir",
    )?;
    run_value(
        world,
        executable,
        config,
        report,
        "scalars.lkj",
        "probe",
        "42\n",
    )?;
    let mut values = Vec::new();
    for case in &cases {
        values.push(ValueRequest {
            name: "scalars.lkjir".to_string(), entry: case.name.clone(), expected: case.expected.clone(),
        });
    }
    run_values(world, executable, config, report, &values)?;
    let original = read(directory, "scalars.lkjir")?;
    let arguments = command(config, "ir", "scalars.lkjir");
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome("IR text roundtrip", &result, 0, &original, b"");
    let mut arguments = command(config, "check", "scalars.lkj");
    arguments.push("--stats".as_bytes().to_vec());
    let result = invoke(world, executable, &arguments, b"")?;
    report.require(
        result.status == 0 && result.output.is_empty(),
        "check --stats failed".to_string(),
    );
    report.require(
        contains(&result.errors, b"LKJSCRIPT_STATS {")
            && contains(&result.errors, b"\"total_ms\":")
            && contains(&result.errors, b"\"type_ms\":"),
        "check --stats omitted phase timings".to_string(),
    );

    let io_source = "fn main(mut world: World) {\n    let arguments = world.args();\n    let mut input = world.stdin();\n    let bytes = input.read_to_end().unwrap();\n    let mut out = world.stdout();\n    out.write(b\"prefix\\0\\xff\\n\");\n    out.write(&bytes);\n    for argument in arguments { out.write(b\"[\"); out.write(&argument); out.write(b\"]\"); }\n    let mut errors = world.stderr();\n    errors.write(b\"error\\0\\xfe\\n\");\n    world.set_exit_status(7);\n}\n";
    write(directory, "streams.lkj", io_source.as_bytes())?;
    compile_ir(
        world,
        executable,
        config,
        report,
        "streams.lkj",
        "streams.lkjir",
    )?;
    let program_arguments = vec!["hello".as_bytes().to_vec(), Vec::new(), vec![255u8, 120u8]];
    let input = b"input\0\xff\n";
    let expected_output = b"prefix\0\xff\ninput\0\xff\n[hello][][\xffx]";
    let expected_errors = b"error\0\xfe\n";
    for name in pair("streams.lkj", "streams.lkjir") {
        for engine in pair("native", "interpreter") {
            let mut arguments = command(config, "run", &name);
            option(&mut arguments, "--engine", &engine);
            arguments.push("--".as_bytes().to_vec());
            for argument in &program_arguments {
                arguments.push(argument.clone());
            }
            let result = invoke(world, executable, &arguments, input)?;
            report.outcome(
                &format!("binary streams {name} {engine}"),
                &result,
                7,
                expected_output,
                expected_errors,
            );
        }
        let artifact = if name == "streams.lkj" {
            "from-source"
        } else {
            "from-ir"
        };
        let mut arguments = command(config, "build", &name);
        option(&mut arguments, "-o", &path(config, artifact));
        let result = invoke(world, executable, &arguments, b"")?;
        report.outcome(&format!("build {name}"), &result, 0, b"", b"");
        let built = io_result(directory.open(artifact), &format!("open {artifact}"))?;
        let result = invoke(world, &built, &program_arguments, input)?;
        report.outcome(
            &format!("standalone {artifact}"),
            &result,
            7,
            expected_output,
            expected_errors,
        );
    }
    let from_source = read(directory, "from-source")?;
    let from_ir = read(directory, "from-ir")?;
    report.equal("source and IR build", "artifact", &from_source, &from_ir);

    let trap_source = "fn main(mut world: World) {\n    let mut out = world.stdout();\n    out.write(b\"before\\0\"); world.stderr().write(b\"prefix\\0\\xff\");\n    let maximum: i64 = 9223372036854775807;\n    let answer = maximum + 1;\n}\n";
    write(directory, "trap.lkj", trap_source.as_bytes())?;
    compile_ir(world, executable, config, report, "trap.lkj", "trap.lkjir")?;
    for name in pair("trap.lkj", "trap.lkjir") {
        for engine in pair("native", "interpreter") {
            let mut arguments = command(config, "run", &name);
            option(&mut arguments, "--engine", &engine);
            let result = invoke(world, executable, &arguments, b"")?;
            let label = format!("trap {name} {engine}");
            report.require(
                result.status == 1,
                format!("{label}: expected status 1, got {}", result.status),
            );
            report.equal(&label, "stdout before trap", &result.output, b"before\0");
            report.require(
                contains(&result.errors, b"prefix\0\xff"),
                format!("{label}: missing stderr bytes before trap"),
            );
            let location = ":5: R0001 ";
            report.require(
                contains(&result.errors, location.as_bytes()),
                format!(
                    "{label}: missing exact code and line: {}",
                    display_bytes(&result.errors)
                ),
            );
        }
    }

    io_result(
        directory.create_directory("assets"),
        &format!("create assets"),
    )?;
    write(directory, "assets/text.txt", b"embed\n")?;
    write(directory, "assets/data.bin", b"\0\xff\x7f*")?;
    let include_source = "fn probe() -> i64 {\n    let text = include_str!(\"assets/text.txt\");\n    let bytes = include_bytes!(\"assets/data.bin\");\n    assert_eq!(text, \"embed\\n\");\n    assert_eq!(bytes.len(), 4);\n    assert_eq!(bytes[0], 0u8);\n    assert_eq!(bytes[3], 42u8);\n    bytes[1] as i64 + text.len() as i64\n}\n";
    write(directory, "includes.lkj", include_source.as_bytes())?;
    compile_ir(
        world,
        executable,
        config,
        report,
        "includes.lkj",
        "includes.lkjir",
    )?;
    run_value(
        world,
        executable,
        config,
        report,
        "includes.lkj",
        "probe",
        "261\n",
    )?;
    io_result(
        directory.remove("assets/text.txt"),
        &format!("remove embedded text"),
    )?;
    io_result(
        directory.remove("assets/data.bin"),
        &format!("remove embedded bytes"),
    )?;
    run_value(
        world,
        executable,
        config,
        report,
        "includes.lkjir",
        "probe",
        "261\n",
    )?;

    let self_spawn = include_str!("../tests/fixtures/world/self_spawn.lkj");
    write(directory, "self-spawn.lkj", self_spawn.as_bytes())?;
    compile_ir(
        world,
        executable,
        config,
        report,
        "self-spawn.lkj",
        "self-spawn.lkjir",
    )?;
    run_value(
        world,
        executable,
        config,
        report,
        "self-spawn.lkj",
        "main",
        "42\n",
    )?;
    run_value(
        world,
        executable,
        config,
        report,
        "self-spawn.lkjir",
        "main",
        "42\n",
    )?;
    let mut arguments = command(config, "run", "self-spawn.lkjir");
    option(&mut arguments, "--engine", "interpreter");
    arguments.push("--unchecked-ir".as_bytes().to_vec());
    arguments.push("--".as_bytes().to_vec());
    arguments.push("unchecked".as_bytes().to_vec());
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome(
        "unchecked IR cannot emit native executable",
        &result,
        0,
        b"unchecked ok\n",
        b"",
    );
    let mut arguments = command(config, "run", "scalars.lkjir");
    option(&mut arguments, "--engine", "interpreter");
    option(
        &mut arguments,
        "--runtime-source",
        &path(config, "unneeded-runtime.lkj"),
    );
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome(
        "interpreter executable preparation is lazy",
        &result,
        0,
        b"42\n",
        b"",
    );

    let tests = "#[test]\nfn first() { assert_eq!(6 * 7, 42); }\n#[test]\nfn second() { let values = vec![3, 4]; assert_eq!(values[0] + values[1], 7); }\nfn probe() -> i64 { 42 }\n";
    write(directory, "tests.lkj", tests.as_bytes())?;
    compile_ir(world, executable, config, report, "tests.lkj", "tests.lkjir")?;
    for name in pair("tests.lkj", "tests.lkjir") {
        for engine in pair("native", "interpreter") {
            let mut arguments = command(config, "test", &name);
            option(&mut arguments, "--engine", &engine);
            let result = invoke(world, executable, &arguments, b"")?;
            report.outcome(
                &format!("test {name} {engine}"),
                &result,
                0,
                b"ok 2 tests\n",
                b"",
            );
        }
        let arguments = command(config, "test", &name);
        let result = invoke(world, executable, &arguments, b"")?;
        report.outcome(
            &format!("test {name} both routes"),
            &result,
            0,
            b"ok 4 tests\n",
            b"",
        );
    }

    write(directory, "invalid.lkj", b"fn probe() -> i64 { true }\n")?;
    write(directory, "invalid.lkjir", b"lkjscript-ir 999\n")?;
    write(directory, "preserved", b"existing artifact\0\xff")?;
    for name in pair("invalid.lkj", "invalid.lkjir") {
        let diagnostic = if name == "invalid.lkj" {
            "E_TYPE"
        } else {
            "E_IR"
        };
        let arguments = command(config, "check", &name);
        let result = invoke(world, executable, &arguments, b"")?;
        report.require(
            result.status == 1 && contains(&result.errors, diagnostic.as_bytes()),
            format!(
                "check {name}: expected diagnostic {diagnostic}, got {}",
                display_bytes(&result.errors)
            ),
        );
        for artifact in pair("absent", "preserved") {
            let mut arguments = command(config, "build", &name);
            option(&mut arguments, "-o", &path(config, &artifact));
            let result = invoke(world, executable, &arguments, b"")?;
            report.require(
                result.status == 1 && contains(&result.errors, diagnostic.as_bytes()),
                format!(
                    "build {name}: expected diagnostic {diagnostic}, got {}",
                    display_bytes(&result.errors)
                ),
            );
        }
        report.require(
            directory.open("absent").is_err(),
            format!("build {name} published a rejected artifact"),
        );
        let preserved = read(directory, "preserved")?;
        report.equal(
            &format!("build {name}"),
            "existing artifact",
            &preserved,
            b"existing artifact\0\xff",
        );
    }
    diagnostics(world, executable, directory, config, report)?;
    authority_exercise(world, executable, directory, config, report)?;
    Ok(())
}

fn clean(directory: &mut Directory) -> Result<(), String> {
    let names: Vec<Vec<u8>> = match directory.list() {
        Ok(names) => names,
        Err(errno) => return Err(format!("cleanup list: errno {errno}")),
    };
    for bytes in names {
        let name = text(bytes, "cleanup name")?;
        match directory.open_directory(&name) {
            Ok(mut child) => {
                clean(&mut child)?;
                drop(child);
                io_result(
                    directory.remove_directory(&name),
                    &format!("cleanup directory {name}"),
                )?;
            }
            Err(_) => {
                io_result(directory.remove(&name), &format!("cleanup file {name}"))?;
            }
        }
    }
    Ok(())
}

fn open_executable(world: &mut World, path: &str) -> Result<File, String> {
    let mut slash = None;
    let bytes = path.as_bytes();
    let mut index = 0usize;
    while index < bytes.len() {
        if bytes[index] == b'/' {
            slash = Some(index);
        }
        index = index + 1;
    }
    let parent: String = match slash {
        Some(0) => "/".to_string(),
        Some(at) => path[..at].to_string(),
        None => ".".to_string(),
    };
    let name: String = match slash {
        Some(at) => path[at + 1..].to_string(),
        None => path.to_string(),
    };
    let mut directory = io_result(world.directory(&parent), &format!("compiler directory"))?;
    match directory.open(&name) {
        Ok(file) => Ok(file),
        Err(errno) => Err(format!("open compiler: errno {errno}")),
    }
}

fn run(world: &mut World, report: &mut Report) -> Result<(), String> {
    let arguments = world.args();
    if arguments.len() < 2 {
        return Err("usage: toolchain-test COMPILER EMPTY-DIRECTORY [--library-dir DIR] [--runtime-source PATH] [--store DIR --store-key PATH]".to_string());
    }
    let compiler = text(arguments[0].clone(), "compiler path")?;
    let directory_path = text(arguments[1].clone(), "work directory")?;
    let mut options = Vec::new();
    let mut index = 2usize;
    while index < arguments.len() {
        let name = text(arguments[index].clone(), "option")?;
        if (name != "--library-dir" && name != "--runtime-source" && name != "--store" && name != "--store-key") || index + 1 == arguments.len() {
            return Err(format!("unsupported or incomplete harness option {name}"));
        }
        options.push(arguments[index].clone());
        options.push(arguments[index + 1].clone());
        index = index + 2;
    }
    let executable = open_executable(world, &compiler)?;
    let mut directory = io_result(world.directory(&directory_path), &format!("work directory"))?;
    let names = io_result(directory.list(), &format!("work directory list"))?;
    if !names.is_empty() {
        return Err("work directory must be empty".to_string());
    }
    let config = Config {
        directory: directory_path,
        options,
    };
    let outcome = exercise(world, &executable, &mut directory, &config, report);
    let cleanup = clean(&mut directory);
    if let Err(problem) = outcome {
        report.failures.push(problem);
    }
    if let Err(problem) = cleanup {
        report.failures.push(problem);
    }
    Ok(())
}

fn main(mut world: World) {
    let mut report = Report {
        failures: Vec::new(),
    };
    if let Err(problem) = run(&mut world, &mut report) {
        report.failures.push(problem);
    }
    if report.failures.is_empty() {
        let mut output = world.stdout();
        output.write(b"ok toolchain\n");
    } else {
        let mut errors = world.stderr();
        for failure in report.failures {
            errors.write(format!("FAIL {failure}\n").as_bytes());
        }
        world.set_exit_status(1);
    }
}

struct AuthorityCase {
    name: String,
    source: String,
    entry: String,
    required: String,
    forbidden: String,
}
fn authority_case(
    name: &str,
    source: &str,
    entry: &str,
    required: &str,
    forbidden: &str,
) -> AuthorityCase {
    AuthorityCase {
        name: name.to_string(),
        source: source.to_string(),
        entry: entry.to_string(),
        required: required.to_string(),
        forbidden: forbidden.to_string(),
    }
}
fn authority_cases() -> Vec<AuthorityCase> {
    vec![
        authority_case("pure.lkj", include_str!("../tests/fixtures/authority/pure.lkj"), "probe",
            "declared authority:\n  none\n;owned cleanup):\n  none\n", "world_;stdout_write;directory_close"),
        authority_case("typed_names.lkj", include_str!("../tests/fixtures/authority/typed_names.lkj"), "main",
            "send: Stdout (--grant send);tree: Directory (--grant tree=PATH);timer: Clock (--grant timer);stdout_write;clock_read;directory_close [structural cleanup]", "world_"),
        authority_case("unused_grants.lkj", include_str!("../tests/fixtures/authority/unused_grants.lkj"), "main",
            "input: Stdin (--grant input);errors: Stderr (--grant errors);time: Clock (--grant time);launch: Process (--grant launch);owned cleanup):\n  none\n", "stdin_read;stderr_write;clock_read;process_spawn"),
        authority_case("recursive.lkj", include_str!("../tests/fixtures/authority/recursive.lkj"), "main",
            "stdout_write", "world_"),
        authority_case("custom_cleanup.lkj", include_str!("../tests/fixtures/authority/custom_cleanup.lkj"), "main",
            "[custom Drop];stdout_write;directory_close [structural cleanup]", "world_"),
        authority_case("file_cleanup.lkj", include_str!("../tests/fixtures/authority/file_cleanup.lkj"), "main",
            "directory_open;file_close [structural cleanup];directory_close [structural cleanup]", "world_"),
        authority_case("connector.lkj", include_str!("../tests/fixtures/authority/connector.lkj"), "main",
            "target: Connector (--grant target=ADDRESS);connector_connect;file_close [structural cleanup]", "world_;listener_"),
        authority_case("readiness.lkj", include_str!("../tests/fixtures/authority/readiness.lkj"), "main",
            "ready: Readiness (--grant ready);clock: Clock (--grant clock);listener_set_nonblocking;readiness_watch_listener;readiness_wait;readiness_unwatch_listener;readiness_close [structural cleanup];listener_close [structural cleanup]", "world_;connector_"),
        authority_case("listener_nodelay.lkj", include_str!("../tests/fixtures/authority/listener_nodelay.lkj"), "main",

            "incoming: Listener (--grant incoming=ADDRESS);listener_accept_nodelay;file_close [structural cleanup];listener_close [structural cleanup]", "world_;connector_"),
        authority_case("listener_cleanup.lkj", include_str!("../tests/fixtures/authority/listener_cleanup.lkj"), "main",
            "incoming: Listener (--grant incoming=ADDRESS);listener_address;listener_close [structural cleanup]", "world_"),
        authority_case("world.lkj", include_str!("../tests/fixtures/authority/world.lkj"), "main",
            "World (implicit full authority);world_stdout;stdout_write", "--grant"),
        authority_case("unrelated_ir.lkjir", include_str!("../tests/fixtures/authority/unrelated_ir.lkjir"), "probe",
            "declared authority:\n  none\n;owned cleanup):\n  none\n;reachable functions (1; each listed once):\n  probe\n", "world_;Unused;unrelated"),
        authority_case("outer_break_ir.lkjir", include_str!("../tests/fixtures/authority/outer_break_ir.lkjir"), "probe",
            "declared authority:\n  none\n;owned cleanup):\n  none\n;reachable functions (1; each listed once):\n  probe\n", "world_;Unused;unrelated"),
        authority_case("reject_file.lkj", include_str!("../tests/fixtures/authority/reject_file.lkj"), "main",
            "accept Directory and open the file inside the entry", ""),
        authority_case("reject_child.lkj", include_str!("../tests/fixtures/authority/reject_child.lkj"), "main", "", ""),
        authority_case("reject_reference.lkj", include_str!("../tests/fixtures/authority/reject_reference.lkj"), "main", "", ""),
        authority_case("reject_aggregate.lkj", include_str!("../tests/fixtures/authority/reject_aggregate.lkj"), "main", "", ""),
        authority_case("reject_world_mixed.lkj", include_str!("../tests/fixtures/authority/reject_world_mixed.lkj"), "main", "", ""),
        authority_case("reject_duplicate_name.lkjir", include_str!("../tests/fixtures/authority/reject_duplicate_name.lkjir"), "main", "", ""),
        authority_case("typed_read.lkj", include_str!("../tests/fixtures/authority/typed_read.lkj"), "main",
            "send: Stdout (--grant send);tree: Directory (--grant tree=PATH);timer: Clock (--grant timer);stdout_write;clock_read;directory_open;file_read;file_close", "world_"),
        authority_case("many_parameters.lkj", include_str!("../tests/fixtures/authority/many_parameters.lkj"), "main",
            "tree: Directory (--grant tree=PATH);other: Directory (--grant other=PATH);stdout_write;stdin_read;stderr_write;directory_open;file_read", "world_"),
    ]
}
fn authority_rejected_build(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
    source: &str,
    entry: &str,
    grants: &[String],
) -> Result<(), String> {
    write(
        directory,
        "authority-preserved",
        b"existing authority artifact\0\xff",
    )?;
    for artifact in pair("authority-absent", "authority-preserved") {
        let mut arguments = command(config, "build", source);
        option(&mut arguments, "--entry", entry);
        for grant in grants {
            option(&mut arguments, "--grant", grant);
        }
        option(&mut arguments, "-o", &path(config, &artifact));
        let result = invoke(world, executable, &arguments, b"")?;
        report.require(
            result.status == 1
                && result.output.is_empty()
                && result.result.is_empty()
                && contains(&result.errors, b"E_ENTRY"),
            format!(
                "grant rejection build {source}/{artifact}: {} {}",
                result.status,
                display_bytes(&result.errors)
            ),
        );
    }
    report.require(
        directory.open("authority-absent").is_err(),
        format!("grant rejection {source} published an artifact"),
    );
    report.equal(
        &format!("grant rejection {source}"),
        "existing artifact",
        &read(directory, "authority-preserved")?,
        b"existing authority artifact\0\xff",
    );
    Ok(())
}
fn authority_queries(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    let no_grants: Vec<String> = Vec::new();
    for case in authority_cases() {
        let source = format!("authority-{}", case.name);
        let roundtrip = format!("authority-{}.roundtrip.lkjir", case.name);
        write(directory, &source, case.source.as_bytes())?;
        let mut arguments = command(config, "ir", &source);
        option(&mut arguments, "-o", &path(config, &roundtrip));
        let result = invoke(world, executable, &arguments, b"")?;
        report.outcome(&format!("authority IR {}", case.name), &result, 0, b"", b"");
        if result.status != 0 {
            continue;
        }
        let mut original: Vec<u8> = Vec::new();
        for input in pair(&source, &roundtrip) {
            let mut arguments = command(config, "authority", &input);
            option(&mut arguments, "--entry", &case.entry);
            let result = invoke(world, executable, &arguments, b"")?;
            let label = format!("authority {input}");
            if case.name.starts_with("reject_") {
                report.require(
                    result.status == 1
                        && result.output.is_empty()
                        && result.result.is_empty()
                        && contains(&result.errors, b"E_ENTRY"),
                    format!(
                        "{label}: missing entry rejection: {} {}",
                        result.status,
                        display_bytes(&result.errors)
                    ),
                );
                for required in case.required.as_str().split(';') {
                    if !required.is_empty() {
                        report.require(
                            contains(&result.errors, required.as_bytes()),
                            format!("{label}: missing rejection rewrite {required}"),
                        );
                    }
                }
                authority_rejected_build(
                    world,
                    executable,
                    directory,
                    config,
                    report,
                    &input,
                    &case.entry,
                    &no_grants,
                )?;
                continue;
            }
            report.require(
                result.status == 0 && result.errors.is_empty() && result.result.is_empty(),
                format!(
                    "{label}: query failed: {} {}",
                    result.status,
                    display_bytes(&result.errors)
                ),
            );
            if input == source {
                original = result.output.clone();
            } else {
                report.equal(&label, "source/IR report", &result.output, &original);
            }
            for required in case.required.as_str().split(';') {
                if !required.is_empty() {
                    report.require(
                        contains(&result.output, required.as_bytes()),
                        format!("{label}: missing report text {required}"),
                    );
                }
            }
            for forbidden in case.forbidden.as_str().split(';') {
                if !forbidden.is_empty() {
                    report.require(
                        !contains(&result.output, forbidden.as_bytes()),
                        format!("{label}: included unreachable authority {forbidden}"),
                    );
                }
            }
            if case.name == "recursive.lkj" {
                report.require(
                    occurrences(&result.output, b"  recursive\n") == 1,
                    format!("{label}: recursive function was not listed exactly once"),
                );
            }
        }
    }
    Ok(())
}
fn authority_grants(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    let no_arguments: Vec<Vec<u8>> = Vec::new();
    write(directory, "authority-input", b"granted\0\xff\n")?;
    io_result(
        directory.create_directory("authority-other"),
        "create second authority directory",
    )?;
    write(directory, "authority-other/authority-input", b"second\n")?;
    let directory_grant = format!("tree={}", config.directory);
    let grants: Vec<String> = vec![
        "send".to_string(),
        directory_grant.clone(),
        "timer".to_string(),
    ];
    for source in pair(
        "authority-typed_read.lkj",
        "authority-typed_read.lkj.roundtrip.lkjir",
    ) {
        for engine in pair("native", "interpreter") {
            let mut arguments = command(config, "run", &source);
            option(&mut arguments, "--engine", &engine);
            for grant in &grants {
                option(&mut arguments, "--grant", grant);
            }
            let result = invoke(world, executable, &arguments, b"")?;
            report.outcome(
                &format!("typed grant {source}/{engine}"),
                &result,
                0,
                b"granted\0\xff\n",
                b"",
            );
        }
        let artifact: &str = if source.ends_with(".lkj") {
            "authority-built-source"
        } else {
            "authority-built-ir"
        };
        let mut arguments = command(config, "build", &source);
        for grant in &grants {
            option(&mut arguments, "--grant", grant);
        }
        option(&mut arguments, "-o", &path(config, artifact));
        let result = invoke(world, executable, &arguments, b"")?;
        report.outcome(&format!("typed grant build {source}"), &result, 0, b"", b"");
        if result.status == 0 {
            let built: File = io_result(directory.open(artifact), "open granted artifact")?;
            let result = invoke(world, &built, &no_arguments, b"")?;
            report.outcome(
                &format!("typed grant standalone {source}"),
                &result,
                0,
                b"granted\0\xff\n",
                b"",
            );
        }
    }
    report.equal(
        "typed grants source/IR",
        "artifact",
        &read(directory, "authority-built-source")?,
        &read(directory, "authority-built-ir")?,
    );
    let many: Vec<String> = vec![
        "first".to_string(),
        "errors".to_string(),
        "timer".to_string(),
        "launch".to_string(),
        "input".to_string(),
        "second".to_string(),
        directory_grant.clone(),
        format!("other={}", path(config, "authority-other")),
    ];
    for engine in pair("native", "interpreter") {
        let mut arguments = command(config, "run", "authority-many_parameters.lkj");
        option(&mut arguments, "--engine", &engine);
        for grant in &many {
            option(&mut arguments, "--grant", grant);
        }
        let result = invoke(world, executable, &arguments, b"input\0\xff")?;
        report.outcome(
            &format!("eight grant stack arguments {engine}"),
            &result,
            0,
            b"first|input\0\xff|granted\0\xff\n|second\n",
            b"error\n",
        );
    }
    let bad: Vec<Vec<String>> = vec![
        Vec::new(),
        vec!["send".to_string(), directory_grant.clone()],
        vec![
            "send".to_string(),
            directory_grant.clone(),
            "timer".to_string(),
            "unknown".to_string(),
        ],
        vec![
            "send".to_string(),
            directory_grant.clone(),
            "timer".to_string(),
            "send".to_string(),
        ],
        vec![
            "send=1".to_string(),
            directory_grant.clone(),
            "timer".to_string(),
        ],
        vec!["send".to_string(), "tree".to_string(), "timer".to_string()],
        vec!["send".to_string(), "tree=".to_string(), "timer".to_string()],
        vec![
            "send".to_string(),
            directory_grant,
            "timer=monotonic".to_string(),
        ],
    ];
    for (index, grants) in bad.iter().enumerate() {
        for engine in pair("native", "interpreter") {
            let mut arguments = command(config, "run", "authority-typed_read.lkj");
            option(&mut arguments, "--engine", &engine);
            for grant in grants {
                option(&mut arguments, "--grant", grant);
            }
            let result = invoke(world, executable, &arguments, b"")?;
            report.require(
                result.status == 1
                    && result.output.is_empty()
                    && result.result.is_empty()
                    && contains(&result.errors, b"E_ENTRY"),
                format!(
                    "invalid grants {index}/{engine}: {} {}",
                    result.status,
                    display_bytes(&result.errors)
                ),
            );
        }
        authority_rejected_build(
            world,
            executable,
            directory,
            config,
            report,
            "authority-typed_read.lkj",
            "main",
            grants,
        )?;
    }
    for invalid in pair("incoming=localhost:0", "incoming=127.0.0.1:65536") {
        authority_rejected_build(world, executable, directory, config, report,
            "authority-listener_cleanup.lkj", "main", &vec![invalid])?;
    }
    for source in pair("authority-pure.lkj", "authority-world.lkj") {
        let entry = if source == "authority-pure.lkj" {
            "probe"
        } else {
            "main"
        };
        authority_rejected_build(
            world,
            executable,
            directory,
            config,
            report,
            &source,
            entry,
            &vec!["unused".to_string()],
        )?;
    }
    Ok(())
}
fn authority_exercise(
    world: &mut World,
    executable: &File,
    directory: &mut Directory,
    config: &Config,
    report: &mut Report,
) -> Result<(), String> {
    authority_queries(world, executable, directory, config, report)?;
    let mut arguments = command(config, "test", "authority-typed_names.lkj");
    option(&mut arguments, "--jobs", "1");
    let result = invoke(world, executable, &arguments, b"")?;
    report.require(result.status == 0 && result.errors.is_empty() && result.result.is_empty()
        && contains(&result.output, b"1 cases, 2 route checks, 0 pending"),
        format!("check-only typed entry discovery: {} {}", result.status, display_bytes(&result.errors)));
    authority_grants(world, executable, directory, config, report)?;
    authority_server(world, executable, config, report)
}

fn authority_server(
    world: &mut World, executable: &File, config: &Config, report: &mut Report,
) -> Result<(), String> {
    let source = "examples/http.lkj";
    let roundtrip = path(config, "authority-http.lkjir");
    let mut arguments = vec!["ir".as_bytes().to_vec(), source.as_bytes().to_vec()];
    for option in &config.options { arguments.push(option.clone()); }
    option(&mut arguments, "-o", &roundtrip);
    let result = invoke(world, executable, &arguments, b"")?;
    report.outcome("HTTP authority checked IR", &result, 0, b"", b"");
    if result.status != 0 { return Ok(()); }
    let required: Vec<String> = vec![
        "output: Stdout (--grant output)".to_string(),
        "root: Directory (--grant root=PATH)".to_string(),
        "listener: Listener (--grant listener=ADDRESS)".to_string(),
        "clock: Clock (--grant clock)".to_string(),
        "listener_address".to_string(), "listener_accept".to_string(),
        "directory_open".to_string(), "file_read".to_string(), "file_write".to_string(),
        "file_close [structural cleanup]".to_string(), "clock_read".to_string(),
        "stdout_write".to_string(),
    ];
    let mut original: Vec<u8> = Vec::new();
    for input in pair(source, &roundtrip) {
        let mut arguments = vec!["authority".as_bytes().to_vec(), input.as_bytes().to_vec()];
        for option in &config.options { arguments.push(option.clone()); }
        let result = invoke(world, executable, &arguments, b"")?;
        report.require(result.status == 0 && result.errors.is_empty() && result.result.is_empty(),
            format!("HTTP authority {input}: {} {}", result.status, display_bytes(&result.errors)));
        for text in &required {
            report.require(contains(&result.output, text.as_bytes()),
                format!("HTTP authority {input}: missing {text}"));
        }
        report.require(!contains(&result.output, b"world_")
            && !contains(&result.output, b"implicit full authority"),
            format!("HTTP authority {input}: reported undeclared World authority"));
        if input == source { original = result.output; }
        else { report.equal("HTTP authority", "source/IR report", &result.output, &original); }
    }
    Ok(())
}

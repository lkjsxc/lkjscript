//! Deterministic inputs for the interrupted create/replace publication fixture.
//! The gate checks every generated byte with an independent implementation.
use std::json::{self, Value};

fn write(output: &mut Directory, path: &str, bytes: &[u8]) -> Result<(), String> {
    let mut file = output.create(path).map_err(|errno: i64| -> String { format!("{path}: create errno {errno}") })?;
    file.write_all(bytes).map_err(|errno: i64| -> String { format!("{path}: write errno {errno}") })
}

fn padding(character: char) -> String {
    let mut text = String::from("// ");
    for _ in 0usize..16384usize { text.push(character); }
    text.push('\n');
    text
}

fn generate(output: &mut Directory) -> Result<(), String> {
    let old_padding = padding('x');
    let new_padding = padding('y');
    let mut main = String::new();
    let mut operations = Vec::new();
    for index in 0usize..16usize {
        main.push_str(&format!("mod old{index};\n"));
        let source = format!("{old_padding}pub fn value() -> i64 {{ {index}i64 }}\n");
        write(output, &format!("old/old{index}.lkj"), source.as_bytes())?;
        operations.push(Value::Object(vec![
            ("id".to_string(), Value::String(format!("old{index}::value"))),
            ("op".to_string(), Value::String("replace-body".to_string())),
            ("source".to_string(), Value::String(format!("{{ {}i64 }}", 1000usize + index))),
        ]));
        operations.push(Value::Object(vec![
            ("id".to_string(), Value::String("crate".to_string())),
            ("op".to_string(), Value::String("add-item".to_string())),
            ("projection".to_string(), Value::Object(vec![
                ("path".to_string(), Value::String(format!("fresh{index}.lkj"))),
                ("source".to_string(), Value::String(format!("{new_padding}pub fn value() -> i64 {{ {}i64 }}\n", 2000usize + index))),
            ])),
            ("source".to_string(), Value::String(format!("mod fresh{index};"))),
        ]));
    }
    main.push_str("pub fn main() -> i64 { old0::value() }\n");
    write(output, "old/main.lkj", main.as_bytes())?;
    operations.push(Value::Object(vec![
        ("id".to_string(), Value::String("main".to_string())),
        ("op".to_string(), Value::String("replace-body".to_string())),
        ("source".to_string(), Value::String("{ old0::value() + fresh0::value() }".to_string())),
    ]));
    // Canonical field order is part of the existing fixture's byte contract.
    let request = Value::Object(vec![
        ("operations".to_string(), Value::Array(operations)),
        ("version".to_string(), Value::from_usize(1usize)),
    ]);
    let text = json::stringify(&request).map_err(|problem| -> String { format!("{problem}") })?;
    write(output, "request.json", format!("{text}\n").as_bytes())
}

pub fn main(mut arguments: Arguments, mut output: Directory, mut errors: Stderr, mut status: ExitStatus) {
    let result = if arguments.args().is_empty() { generate(&mut output) }
        else { Err("unexpected arguments".to_string()) };
    if let Err(problem) = result {
        errors.write(format!("create-kill fixture: {problem}\n").as_bytes());
        status.set_status(1);
    }
}

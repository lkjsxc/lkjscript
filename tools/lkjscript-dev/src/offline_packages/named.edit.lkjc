reference.package as=$standard source=builtin
reference.owner as=$add package=$standard class=declaration name=add
reference.owner as=$module package=local class=module name=application
reference.owner as=$main package=local class=declaration name=main parent=$module
reference.owner as=$input package=local class=parameter name=input parent=$main
expression.local as=$read value=$input
expression.i64 as=$one value=1
expression.call as=$body function=$add
expression.argument parent=$body index=0 expression=$read
expression.argument parent=$body index=1 expression=$one
rename.owner owner=$main name=calculate
replace.body function=$main body=$body

reference.owner as=$participant package=$std class=declaration name=data-cell-update-in-transaction
reference.owner as=$edit-update-T package=local class=type-parameter parent=$update name=T
reference.owner as=$edit-update-E package=local class=effect-parameter parent=$update name=E
reference.owner as=$edit-space package=local class=parameter parent=$update name=space
reference.owner as=$edit-default package=local class=parameter parent=$update name=default
reference.owner as=$edit-transform package=local class=parameter parent=$update name=transform
reference.owner as=$edit-key package=local class=parameter parent=$update name=key
type.parameter as=@UpdateT parameter=$edit-update-T
effect.row as=@UpdateE
effect.parameter parent=@UpdateE index=0 parameter=$edit-update-E
expression.block as=$edited-update-body
  (transaction-outcome parameter:$R (types @UpdateT)
    (outcome $Outcome $Reason $Committed $Aborted $ConditionFailed $Conflict)
    (binding cell-update)
    (sequence
      (call $participant (types @UpdateT) (effects @UpdateE) (requirements parameter:$R)
        (local $edit-space) (local $edit-default) (local $edit-transform) (local $edit-key))
      (call $participant (types @UpdateT) (effects @UpdateE) (requirements parameter:$R)
        (local $edit-space) (local $edit-default) (local $edit-transform) (local $edit-key))))
expression.end
replace.body function=$update body=$edited-update-body

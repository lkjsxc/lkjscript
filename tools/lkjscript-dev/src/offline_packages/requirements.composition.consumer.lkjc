declarations.begin
(units
  (use std builtin)
  (module create shop (as $shop-module)
    (record create Stock (as $stock-type) (visibility public)
      (field create available (as $stock-available) (type I64))
      (field create reserved (as $stock-reserved) (type I64)))
    (record create Receipt (visibility public)
      (field create credit (type I64))
      (field create stock (type Stock)))
    (type-alias Outcome (std::TransactionOutcome Receipt))
    (type-alias NumberOutcome (std::TransactionOutcome I64))
    (constant create cell-key (visibility private) (type (list std::DataKeyPart))
      (value (list std::DataKeyPart (variant std::DataKeyPart::Text (text "account")))))
    (constant create initial-stock (visibility private) (type Stock)
      (value (record Stock (field Stock::available (i64 8)) (field Stock::reserved (i64 0)))))
    (function create reserve (visibility private)
      (parameter create value (type Stock))
      (returns Stock) (effect (task))
      (body (record Stock
        (field Stock::available (call std::add (field (local value) Stock::available) (i64 -2)))
        (field Stock::reserved (call std::add (field (local value) Stock::reserved) (i64 2))))))
    (function create identity-number (visibility private)
      (parameter create value (type I64)) (returns I64) (effect (task))
      (body (local value)))
    (function create trapped-stock (visibility private)
      (parameter create value (type Stock)) (returns Stock) (effect (task))
      (body (sequence (call std::divide (i64 1) (i64 0)) (local value))))
    (function create marked-credit (visibility private)
      (parameter create value (type I64))
      (returns I64) (effect (task (requirement stores::other)))
      (body (sequence
        (transaction stores::other (binding marker-owner)
          (capability-call stores::other std::DataStore::put
            (static-text "marker") (constant cell-key)
            (call std::data-encode (types Text) (text "survived"))
            (variant std::DataExpectation::Missing)))
        (call std::add (local value) (i64 -30)))))
    (function create initialize (visibility private)
      (returns Bool) (effect (task (requirement stores::shared)))
      (body (transaction stores::shared (binding initialize-owner)
        (sequence
          (capability-call stores::shared std::DataStore::put
            (static-text "credit") (constant cell-key)
            (call std::data-encode (types I64) (i64 100)) (variant std::DataExpectation::Missing))
          (capability-call stores::shared std::DataStore::put
            (static-text "stock") (constant cell-key)
            (call std::data-encode (types Stock) (constant initial-stock)) (variant std::DataExpectation::Missing))))))
    (function create read (visibility private)
      (returns Receipt) (effect (task (requirement stores::shared)))
      (body (record Receipt
        (field Receipt::credit
          (call std::data-decode-or (types I64)
            (field (call std::list-get (types std::DataEntry)
              (capability-call stores::shared std::DataStore::get (static-text "credit") (constant cell-key))
              (i64 0)) std::DataEntry::value) (i64 -999)))
        (field Receipt::stock
          (call std::data-decode-or (types Stock)
            (field (call std::list-get (types std::DataEntry)
              (capability-call stores::shared std::DataStore::get (static-text "stock") (constant cell-key))
              (i64 0)) std::DataEntry::value) (constant initial-stock))))))
    (function create credit-tail (visibility private)
      (requirement-parameter create R (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::require-transaction))
      (returns I64) (effect (task (requirement R)))
      (body (invoke
        (bind (function-value $credit-adjust (requirements R)) (i64 -30))
        (constant cell-key))))
    (function create compose (visibility private)
      (returns Outcome) (effect (task (requirement stores::shared)))
      (body (transaction-outcome stores::shared (types Receipt)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding purchase)
        (record Receipt
          (field Receipt::credit (call credit-tail (requirements stores::shared)))
          (field Receipt::stock
            (call $stock-stage (types Stock) (effects (row)) (requirements stores::shared)
              (constant initial-stock) (function-value reserve) (constant cell-key)))))))
    (function create repeated (visibility private)
      (returns NumberOutcome) (effect (task (requirement stores::shared)))
      (body (transaction-outcome stores::shared (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding repeated-owner)
        (sequence
          (call $credit-adjust (requirements stores::shared) (i64 -30) (constant cell-key))
          (call $credit-adjust (requirements stores::shared) (i64 -10) (constant cell-key))))))
    (function create failed-condition (visibility private)
      (returns NumberOutcome) (effect (task (requirement stores::shared)))
      (body (transaction-outcome stores::shared (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding failed-owner)
        (sequence
          (call $credit-adjust (requirements stores::shared) (i64 -30) (constant cell-key))
          (call $stock-stage (types Stock) (effects (row)) (requirements stores::shared)
            (constant initial-stock) (function-value reserve) (constant cell-key))
          (capability-call stores::shared std::DataStore::put
            (static-text "credit") (constant cell-key)
            (call std::data-encode (types I64) (i64 1)) (variant std::DataExpectation::Missing))
          (i64 70)))))
    (function create trapped (visibility private)
      (returns (std::TransactionOutcome Stock)) (effect (task (requirement stores::shared)))
      (body (transaction-outcome stores::shared (types Stock)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding trapped-owner)
        (sequence
          (call $credit-adjust (requirements stores::shared) (i64 -30) (constant cell-key))
          (call $stock-stage (types Stock) (effects (row)) (requirements stores::shared)
            (constant initial-stock) (function-value trapped-stock) (constant cell-key))))))
    (function create independent (visibility private)
      (returns NumberOutcome) (effect (task (requirement stores::shared) (requirement stores::other)))
      (body (transaction-outcome stores::shared (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding independent-owner)
        (sequence
          (call $credit-adjust (requirements stores::shared) (i64 -30) (constant cell-key))
          (capability-call stores::shared std::DataStore::put
            (static-text "credit") (constant cell-key)
            (call std::data-encode (types I64) (i64 1)) (variant std::DataExpectation::Missing))
          (call std::data-cell-update-in-transaction (types I64)
            (effects (row (requirement stores::other))) (requirements stores::shared)
            (static-text "credit") (i64 100) (function-value marked-credit) (constant cell-key))))))
    (function create absent-owner (visibility private)
      (returns I64) (effect (task (requirement stores::shared) (requirement stores::other)))
      (body (call std::data-cell-update-in-transaction (types I64)
        (effects (row (requirement stores::other))) (requirements stores::shared)
        (static-text "credit") (i64 100) (function-value marked-credit) (constant cell-key))))
    (function create unrelated-owner (visibility private)
      (returns NumberOutcome) (effect (task (requirement stores::shared) (requirement stores::other)))
      (body (transaction-outcome stores::other (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding unrelated-owner) (call absent-owner))))
    (function create descriptor-after-owner (visibility private)
      (returns I64) (effect (task (requirement stores::shared) (requirement stores::other)))
      (body (let
        (binding retained (type (task-function ((list std::DataKeyPart)) I64 (row (requirement stores::shared) (requirement stores::other))))
          (bind (function-value std::data-cell-update-in-transaction (types I64)
            (effects (row (requirement stores::other))) (requirements stores::shared))
            (static-text "credit") (i64 100) (function-value marked-credit)))
        (in (sequence
          (transaction stores::shared (binding exited-owner) (bool true))
          (invoke (local retained) (constant cell-key)))))))
    (function create standalone (visibility private)
      (returns NumberOutcome) (effect (task (requirement stores::shared)))
      (body (call std::data-cell-try-update (types I64) (effects (row)) (requirements stores::shared)
        (static-text "credit") (i64 100) (function-value identity-number) (constant cell-key))))
    (function create nested-owner (visibility private)
      (returns (std::TransactionOutcome NumberOutcome)) (effect (task (requirement stores::shared)))
      (body (transaction-outcome stores::shared (types NumberOutcome)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding outer-owner) (call standalone))))
    (component create stores (visibility private)
      (requirement create shared (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::transaction std::DataStore::require-transaction)
        (limits (maximum_calls 100 calls)))
      (requirement create other (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::transaction std::DataStore::require-transaction)
        (limits (maximum_calls 100 calls)))
      (port create initialize (type (task-function () Bool (row (requirement shared)))) (function initialize))
      (port create read (type (task-function () Receipt (row (requirement shared)))) (function read))
      (port create compose (type (task-function () Outcome (row (requirement shared)))) (function compose))
      (port create repeated (type (task-function () NumberOutcome (row (requirement shared)))) (function repeated))
      (port create failed-condition (type (task-function () NumberOutcome (row (requirement shared)))) (function failed-condition))
      (port create trapped (type (task-function () (std::TransactionOutcome Stock) (row (requirement shared)))) (function trapped))
      (port create independent (type (task-function () NumberOutcome (row (requirement stores::shared) (requirement stores::other)))) (function independent))
      (port create absent-owner (type (task-function () I64 (row (requirement stores::shared) (requirement stores::other)))) (function absent-owner))
      (port create unrelated-owner (type (task-function () NumberOutcome (row (requirement stores::shared) (requirement stores::other)))) (function unrelated-owner))
      (port create descriptor-after-owner (type (task-function () I64 (row (requirement stores::shared) (requirement stores::other)))) (function descriptor-after-owner))
      (port create standalone (type (task-function () NumberOutcome (row (requirement shared)))) (function standalone))
      (port create nested-owner (type (task-function () (std::TransactionOutcome NumberOutcome) (row (requirement shared)))) (function nested-owner))))
  (target create initialize (component shop::stores) (runner command) (port shop::stores::initialize))
  (target create read (component shop::stores) (runner command) (port shop::stores::read))
  (target create compose (component shop::stores) (runner command) (port shop::stores::compose))
  (target create repeated (component shop::stores) (runner command) (port shop::stores::repeated))
  (target create failed-condition (component shop::stores) (runner command) (port shop::stores::failed-condition))
  (target create trapped (component shop::stores) (runner command) (port shop::stores::trapped))
  (target create independent (component shop::stores) (runner command) (port shop::stores::independent))
  (target create absent-owner (component shop::stores) (runner command) (port shop::stores::absent-owner))
  (target create unrelated-owner (component shop::stores) (runner command) (port shop::stores::unrelated-owner))
  (target create descriptor-after-owner (component shop::stores) (runner command) (port shop::stores::descriptor-after-owner))
  (target create standalone (component shop::stores) (runner command) (port shop::stores::standalone))
  (target create nested-owner (component shop::stores) (runner command) (port shop::stores::nested-owner)))
declarations.end

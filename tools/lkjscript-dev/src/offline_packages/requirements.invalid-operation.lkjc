reference.owner as=$DataEntry package=$std class=declaration name=DataEntry
reference.owner as=$DataKeyPart package=$std class=declaration name=DataKeyPart
reference.owner as=$get package=$std class=operation parent=$DataStore name=get
reference.owner as=$module package=local class=module name=typed-cells
type.named as=@Entry declaration=$DataEntry
type.list as=@Entries item=@Entry
type.named as=@KeyPart declaration=$DataKeyPart
add.requirement-parameter as=$R declaration=$bad name=R interface=$DataStore
expression.static-text as=$space value=typed-cell
expression.list as=$key item=@KeyPart
expression.capability-call as=$body requirement=parameter:$R operation=$get
expression.argument parent=$body index=0 expression=$space
expression.argument parent=$body index=1 expression=$key

reference.owner as=$participant package=$std class=declaration name=data-cell-update-in-transaction
reference.owner as=$edit-update-T package=local class=type-parameter parent=$update name=T
reference.owner as=$edit-update-E package=local class=effect-parameter parent=$update name=E
reference.owner as=$edit-space package=local class=parameter parent=$update name=space
reference.owner as=$edit-default package=local class=parameter parent=$update name=default
reference.owner as=$edit-transform package=local class=parameter parent=$update name=transform
reference.owner as=$edit-key package=local class=parameter parent=$update name=key
type.parameter as=@UpdateT parameter=$edit-update-T
effect.row as=@UpdateE
effect.parameter parent=@UpdateE index=0 parameter=$edit-update-E
expression.local as=$first-space value=$edit-space
expression.local as=$first-default value=$edit-default
expression.local as=$first-transform value=$edit-transform
expression.local as=$first-key value=$edit-key
expression.call as=$first-update function=$participant
type.argument parent=$first-update index=0 type=@UpdateT
effect.argument parent=$first-update index=0 effect=@UpdateE
requirement.argument parent=$first-update index=0 requirement=parameter:$R
expression.argument parent=$first-update index=0 expression=$first-space
expression.argument parent=$first-update index=1 expression=$first-default
expression.argument parent=$first-update index=2 expression=$first-transform
expression.argument parent=$first-update index=3 expression=$first-key
expression.local as=$second-space value=$edit-space
expression.local as=$second-default value=$edit-default
expression.local as=$second-transform value=$edit-transform
expression.local as=$second-key value=$edit-key
expression.call as=$second-update function=$participant
type.argument parent=$second-update index=0 type=@UpdateT
effect.argument parent=$second-update index=0 effect=@UpdateE
requirement.argument parent=$second-update index=0 requirement=parameter:$R
expression.argument parent=$second-update index=0 expression=$second-space
expression.argument parent=$second-update index=1 expression=$second-default
expression.argument parent=$second-update index=2 expression=$second-transform
expression.argument parent=$second-update index=3 expression=$second-key
expression.sequence as=$both-updates
expression.argument parent=$both-updates index=0 expression=$first-update
expression.argument parent=$both-updates index=1 expression=$second-update
expression.transaction-outcome as=$edited-update-body requirement=parameter:$R binding=$edit-transaction name=cell-update type=@UpdateT outcome=$Outcome abort-reason=$Reason committed=$Committed aborted=$Aborted condition-failed=$ConditionFailed conflict=$Conflict body=$both-updates
replace.body function=$update body=$edited-update-body

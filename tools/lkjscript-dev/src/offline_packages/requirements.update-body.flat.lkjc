reference.owner as=$edit-equal package=$std class=declaration name=i64-equal
reference.owner as=$edit-decode package=$std class=declaration name=data-decode-or
reference.owner as=$edit-encode package=$std class=declaration name=data-encode
reference.owner as=$edit-update-T package=local class=type-parameter parent=$update name=T
reference.owner as=$edit-space package=local class=parameter parent=$update name=space
reference.owner as=$edit-default package=local class=parameter parent=$update name=default
reference.owner as=$edit-transform package=local class=parameter parent=$update name=transform
reference.owner as=$edit-key package=local class=parameter parent=$update name=key
type.named as=@EditEntry declaration=$edit-DataEntry
type.list as=@EditEntries item=@EditEntry
type.parameter as=@UpdateT parameter=$edit-update-T
expression.local as=$edit-space-read value=$edit-space
expression.local as=$edit-key-read value=$edit-key
expression.capability-call as=$edit-read requirement=parameter:$R operation=$get
expression.argument parent=$edit-read index=0 expression=$edit-space-read
expression.argument parent=$edit-read index=1 expression=$edit-key-read
expression.local as=$edit-entries-count value=$edit-entries
expression.call as=$edit-count function=$edit-length
type.argument parent=$edit-count index=0 type=@EditEntry
expression.argument parent=$edit-count index=0 expression=$edit-entries-count
expression.i64 as=$edit-zero value=0
expression.call as=$edit-is-absent function=$edit-equal
expression.argument parent=$edit-is-absent index=0 expression=$edit-count
expression.argument parent=$edit-is-absent index=1 expression=$edit-zero
expression.local as=$edit-absent-value value=$edit-absent
expression.local as=$edit-default-value value=$edit-default
expression.local as=$edit-entries-decode value=$edit-entries
expression.i64 as=$edit-decode-index value=0
expression.call as=$edit-first-entry function=$edit-first
type.argument parent=$edit-first-entry index=0 type=@EditEntry
expression.argument parent=$edit-first-entry index=0 expression=$edit-entries-decode
expression.argument parent=$edit-first-entry index=1 expression=$edit-decode-index
expression.field as=$edit-stored-bytes value=$edit-first-entry field=$edit-entry-value
expression.local as=$edit-decode-default value=$edit-default
expression.call as=$edit-decoded function=$edit-decode
type.argument parent=$edit-decoded index=0 type=@UpdateT
expression.argument parent=$edit-decoded index=0 expression=$edit-stored-bytes
expression.argument parent=$edit-decoded index=1 expression=$edit-decode-default
expression.if as=$edit-old condition=$edit-absent-value when-true=$edit-default-value when-false=$edit-decoded
expression.local as=$edit-transform-first value=$edit-transform
expression.invoke as=$edit-once function=$edit-transform-first
expression.argument parent=$edit-once index=0 expression=$edit-old
expression.local as=$edit-transform-second value=$edit-transform
expression.invoke as=$edit-twice function=$edit-transform-second
expression.argument parent=$edit-twice index=0 expression=$edit-once
expression.local as=$edit-encoded-value value=$edit-candidate
expression.call as=$edit-encoded function=$edit-encode
type.argument parent=$edit-encoded index=0 type=@UpdateT
expression.argument parent=$edit-encoded index=0 expression=$edit-encoded-value
expression.variant as=$edit-missing case=$edit-Missing
expression.local as=$edit-entries-revision value=$edit-entries
expression.i64 as=$edit-revision-index value=0
expression.call as=$edit-revision-entry function=$edit-first
type.argument parent=$edit-revision-entry index=0 type=@EditEntry
expression.argument parent=$edit-revision-entry index=0 expression=$edit-entries-revision
expression.argument parent=$edit-revision-entry index=1 expression=$edit-revision-index
expression.field as=$edit-revision value=$edit-revision-entry field=$edit-entry-revision
expression.variant as=$edit-exact case=$edit-Exact payload=$edit-revision
expression.local as=$edit-absent-condition value=$edit-absent
expression.if as=$edit-condition condition=$edit-absent-condition when-true=$edit-missing when-false=$edit-exact
expression.local as=$edit-space-write value=$edit-space
expression.local as=$edit-key-write value=$edit-key
expression.capability-call as=$edit-write requirement=parameter:$R operation=$put

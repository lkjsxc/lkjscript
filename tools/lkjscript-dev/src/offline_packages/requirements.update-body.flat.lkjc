expression.let as=$edit-algorithm body=$edit-candidate-result
expression.binding parent=$edit-algorithm index=0 as=$edit-entries name=entries type=@EditEntries value=$edit-read
expression.binding parent=$edit-algorithm index=1 as=$edit-absent name=absent type=bool value=$edit-is-absent
expression.binding parent=$edit-algorithm index=2 as=$edit-candidate name=candidate type=@UpdateT value=$edit-twice
expression.binding parent=$edit-algorithm index=3 as=$edit-matched name=primary-condition-matched type=bool value=$edit-write
expression.transaction-outcome as=$edited-update-body requirement=parameter:$R binding=$edit-transaction name=cell-update type=@UpdateT outcome=$Outcome abort-reason=$Reason committed=$Committed aborted=$Aborted condition-failed=$ConditionFailed conflict=$Conflict body=$edit-algorithm
replace.body function=$update body=$edited-update-body

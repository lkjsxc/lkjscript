reference.package as=$std source=builtin
reference.owner as=$DataStore package=$std class=declaration name=DataStore
reference.owner as=$DataEntry package=$std class=declaration name=DataEntry
reference.owner as=$DataExpectation package=$std class=declaration name=DataExpectation
reference.owner as=$DataKeyPart package=$std class=declaration name=DataKeyPart
reference.owner as=$get package=$std class=operation parent=$DataStore name=get
reference.owner as=$put package=$std class=operation parent=$DataStore name=put
reference.owner as=$transaction package=$std class=operation parent=$DataStore name=transaction
reference.owner as=$entry-value package=$std class=field parent=$DataEntry name=value
reference.owner as=$entry-revision package=$std class=field parent=$DataEntry name=revision
reference.owner as=$Missing package=$std class=case parent=$DataExpectation name=Missing
reference.owner as=$Exact package=$std class=case parent=$DataExpectation name=Exact
reference.owner as=$length package=$std class=declaration name=list-length
reference.owner as=$first package=$std class=declaration name=list-get
reference.owner as=$equal package=$std class=declaration name=i64-equal
reference.owner as=$decode package=$std class=declaration name=data-decode-or
reference.owner as=$encode package=$std class=declaration name=data-encode
create.module as=$cells name=typed-cells
create.record as=$Attempt module=$cells name=UpdateAttempt visibility=public
add.type-parameter as=$Value declaration=$Attempt name=Value
type.parameter as=@Value parameter=$Value
add.field as=$candidate-field record=$Attempt name=candidate type=@Value
add.field as=$matched-field record=$Attempt name=primary_condition_matched type=bool
type.named as=@Entry declaration=$DataEntry
type.list as=@Entries item=@Entry
type.named as=@KeyPart declaration=$DataKeyPart
type.list as=@Key item=@KeyPart
add.type-parameter as=$T declaration=$update name=T
add.effect-parameter as=$E declaration=$update name=E
add.requirement-parameter as=$R declaration=$update name=R interface=$DataStore
requirement-parameter.operation parent=$R index=0 operation=$get
requirement-parameter.operation parent=$R index=1 operation=$put
requirement-parameter.operation parent=$R index=2 operation=$transaction
type.parameter as=@T parameter=$T
type.application as=@Attempt declaration=$Attempt
type.argument parent=@Attempt index=0 type=@T
effect.row as=@E
effect.parameter parent=@E index=0 parameter=$E
type.task-function as=@Transform result=@T effect=@E
type.argument parent=@Transform index=0 type=@T
add.parameter as=$space function=$update name=space type=static-text
add.parameter as=$default function=$update name=default type=@T
add.parameter as=$transform function=$update name=transform type=@Transform
add.parameter as=$key function=$update name=key type=@Key
expression.local as=$space-read value=$space
expression.local as=$key-read value=$key
expression.capability-call as=$entries-read requirement=parameter:$R operation=$get
expression.argument parent=$entries-read index=0 expression=$space-read
expression.argument parent=$entries-read index=1 expression=$key-read
expression.local as=$entries-value value=$entries
expression.call as=$entry-count function=$length
type.argument parent=$entry-count index=0 type=@Entry
expression.argument parent=$entry-count index=0 expression=$entries-value
expression.i64 as=$zero value=0
expression.call as=$is-absent function=$equal
expression.argument parent=$is-absent index=0 expression=$entry-count
expression.argument parent=$is-absent index=1 expression=$zero
expression.local as=$absent-value value=$absent
expression.local as=$default-value value=$default
expression.call as=$first-entry function=$first
type.argument parent=$first-entry index=0 type=@Entry
expression.local as=$entries-decode value=$entries
expression.i64 as=$decode-index value=0
expression.argument parent=$first-entry index=0 expression=$entries-decode
expression.argument parent=$first-entry index=1 expression=$decode-index
expression.field as=$stored-bytes value=$first-entry field=$entry-value
expression.call as=$decoded function=$decode
type.argument parent=$decoded index=0 type=@T
expression.argument parent=$decoded index=0 expression=$stored-bytes
expression.local as=$decode-default value=$default
expression.argument parent=$decoded index=1 expression=$decode-default
expression.if as=$old condition=$absent-value when-true=$default-value when-false=$decoded
expression.local as=$transform-value value=$transform
expression.invoke as=$transformed function=$transform-value
expression.argument parent=$transformed index=0 expression=$old
expression.local as=$candidate-value value=$candidate
expression.call as=$encoded function=$encode
type.argument parent=$encoded index=0 type=@T
expression.argument parent=$encoded index=0 expression=$candidate-value
expression.variant as=$missing-condition case=$Missing
expression.call as=$revision-entry function=$first
type.argument parent=$revision-entry index=0 type=@Entry
expression.local as=$entries-revision value=$entries
expression.i64 as=$revision-index value=0
expression.argument parent=$revision-entry index=0 expression=$entries-revision
expression.argument parent=$revision-entry index=1 expression=$revision-index
expression.field as=$revision value=$revision-entry field=$entry-revision
expression.variant as=$exact-condition case=$Exact payload=$revision
expression.local as=$absent-condition value=$absent
expression.if as=$condition condition=$absent-condition when-true=$missing-condition when-false=$exact-condition
expression.capability-call as=$primary-write requirement=parameter:$R operation=$put
expression.local as=$space-write value=$space
expression.local as=$key-write value=$key
expression.argument parent=$primary-write index=0 expression=$space-write
expression.argument parent=$primary-write index=1 expression=$key-write
expression.argument parent=$primary-write index=2 expression=$encoded
expression.argument parent=$primary-write index=3 expression=$condition
expression.local as=$matched-value value=$matched
expression.record as=$attempt type=$Attempt
type.argument parent=$attempt index=0 type=@T
expression.local as=$candidate-result value=$candidate
expression.record-field parent=$attempt index=0 field=$candidate-field value=$candidate-result
expression.record-field parent=$attempt index=1 field=$matched-field value=$matched-value
expression.let as=$algorithm body=$attempt
expression.binding parent=$algorithm index=0 as=$entries name=entries type=@Entries value=$entries-read
expression.binding parent=$algorithm index=1 as=$absent name=absent type=bool value=$is-absent
expression.binding parent=$algorithm index=2 as=$candidate name=candidate type=@T value=$transformed
expression.binding parent=$algorithm index=3 as=$matched name=primary-condition-matched type=bool value=$primary-write
expression.transaction as=$update-body requirement=parameter:$R binding=$tx name=cell-attempt body=$algorithm
create.function as=$update module=$cells name=attempt-update visibility=public result=@Attempt effect=task body=$update-body
effect.requirement parent=$update index=0 requirement=parameter:$R
effect.parameter parent=$update index=0 parameter=$E
add.type-parameter as=$factory-T declaration=$factory name=T constraint=capture-safe
add.effect-parameter as=$factory-E declaration=$factory name=E
add.requirement-parameter as=$factory-R declaration=$factory name=R interface=$DataStore
requirement-parameter.operation parent=$factory-R index=0 operation=$get
requirement-parameter.operation parent=$factory-R index=1 operation=$put
requirement-parameter.operation parent=$factory-R index=2 operation=$transaction
type.parameter as=@FactoryT parameter=$factory-T
type.application as=@FactoryAttempt declaration=$Attempt
type.argument parent=@FactoryAttempt index=0 type=@FactoryT
effect.row as=@FactoryE
effect.parameter parent=@FactoryE index=0 parameter=$factory-E
effect.row as=@FactoryRow
effect.parameter parent=@FactoryRow index=0 parameter=$factory-E
effect.requirement parent=@FactoryRow index=0 requirement=parameter:$factory-R
type.task-function as=@FactoryTransform result=@FactoryT effect=@FactoryE
type.argument parent=@FactoryTransform index=0 type=@FactoryT
type.task-function as=@Updater result=@FactoryAttempt effect=@FactoryRow
type.argument parent=@Updater index=0 type=@Key
add.parameter as=$factory-space function=$factory name=space type=static-text
add.parameter as=$factory-default function=$factory name=default type=@FactoryT
add.parameter as=$factory-transform function=$factory name=transform type=@FactoryTransform
expression.function-value as=$update-function function=$update
type.argument parent=$update-function index=0 type=@FactoryT
effect.argument parent=$update-function index=0 effect=@FactoryE
requirement.argument parent=$update-function index=0 requirement=parameter:$factory-R
expression.local as=$factory-space-value value=$factory-space
expression.local as=$factory-default-value value=$factory-default
expression.local as=$factory-transform-value value=$factory-transform
expression.bind as=$factory-body callee=$update-function
expression.argument parent=$factory-body index=0 expression=$factory-space-value
expression.argument parent=$factory-body index=1 expression=$factory-default-value
expression.argument parent=$factory-body index=2 expression=$factory-transform-value
create.function as=$factory module=$cells name=make-cell-updater visibility=public result=@Updater effect=pure body=$factory-body

reference.owner as=$texts package=local class=requirement parent=$component name=settings-store
reference.owner as=$suffix package=local class=declaration parent=$module name=append-configured-suffix
reference.package as=$std source=builtin
reference.owner as=$KeyPart package=$std class=declaration name=DataKeyPart
reference.owner as=$from-static package=$std class=declaration name=text-from-static
type.named as=@KeyPart declaration=$KeyPart
effect.row as=@Empty
expression.static-text as=$space value=typed-cell
expression.static-text as=$default-static value=a
expression.call as=$default function=$from-static
expression.argument parent=$default index=0 expression=$default-static
expression.function-value as=$callback function=$suffix
expression.list as=$key item=@KeyPart
expression.call as=$invalid function=$update
type.argument parent=$invalid index=0 type=text
effect.argument parent=$invalid index=0 effect=@Empty
requirement.argument parent=$invalid index=0 requirement=$texts
expression.argument parent=$invalid index=0 expression=$space

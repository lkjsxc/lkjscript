reference.package as=$std source=builtin
reference.owner as=$Outcome package=$std class=declaration name=TransactionOutcome
reference.owner as=$Reason package=$std class=declaration name=TransactionAbortReason
reference.owner as=$Committed package=$std class=case parent=$Outcome name=Committed
reference.owner as=$Aborted package=$std class=case parent=$Outcome name=Aborted
reference.owner as=$ConditionFailed package=$std class=case parent=$Reason name=ConditionFailed
reference.owner as=$Conflict package=$std class=case parent=$Reason name=Conflict
reference.owner as=$DataStore package=$std class=declaration name=DataStore
reference.owner as=$Configuration package=$std class=declaration name=Configuration
reference.owner as=$DataKeyPart package=$std class=declaration name=DataKeyPart
reference.owner as=$DataExpectation package=$std class=declaration name=DataExpectation
reference.owner as=$get package=$std class=operation parent=$DataStore name=get
reference.owner as=$put package=$std class=operation parent=$DataStore name=put
reference.owner as=$transaction package=$std class=operation parent=$DataStore name=transaction
reference.owner as=$guard package=$std class=operation parent=$DataStore name=require-transaction
reference.owner as=$schema-read package=$std class=operation parent=$DataStore name=schema-read
reference.owner as=$config-text package=$std class=operation parent=$Configuration name=text
reference.owner as=$text-key package=$std class=case parent=$DataKeyPart name=Text
reference.owner as=$Missing package=$std class=case parent=$DataExpectation name=Missing
reference.owner as=$add package=$std class=declaration name=add
reference.owner as=$concat package=$std class=declaration name=text-concat
reference.owner as=$divide package=$std class=declaration name=divide
reference.owner as=$encode package=$std class=declaration name=data-encode
reference.owner as=$try-update package=$library class=declaration name=try-update
reference.owner as=$make-updater package=$library class=declaration name=make-cell-updater
create.module as=$module name=cell-consumer
create.component as=$component name=cells module=$module visibility=public
add.requirement as=$numbers component=$component name=counters interface=$DataStore
requirement.operation parent=$numbers index=0 operation=$get
requirement.operation parent=$numbers index=1 operation=$put
requirement.operation parent=$numbers index=2 operation=$transaction
requirement.operation parent=$numbers index=3 operation=$schema-read
requirement.operation parent=$numbers index=4 operation=$guard
requirement.limit parent=$numbers index=0 name=maximum_calls maximum=100 unit=calls
add.requirement as=$texts component=$component name=settings-store interface=$DataStore
requirement.operation parent=$texts index=0 operation=$get
requirement.operation parent=$texts index=1 operation=$put
requirement.operation parent=$texts index=2 operation=$transaction
requirement.operation parent=$texts index=3 operation=$guard
requirement.limit parent=$texts index=0 name=maximum_calls maximum=100 unit=calls
add.requirement as=$config component=$component name=suffix-config interface=$Configuration
requirement.operation parent=$config index=0 operation=$config-text
requirement.limit parent=$config index=0 name=maximum_calls maximum=100 unit=calls
type.named as=@KeyPart declaration=$DataKeyPart
type.list as=@Key item=@KeyPart
type.application as=@NumberOutcome declaration=$Outcome
type.argument parent=@NumberOutcome index=0 type=i64
type.application as=@TextOutcome declaration=$Outcome
type.argument parent=@TextOutcome index=0 type=text
effect.row as=@Empty
effect.row as=@Numbers
effect.requirement parent=@Numbers index=0 requirement=$numbers
effect.row as=@Configuration
effect.requirement parent=@Configuration index=0 requirement=$config
effect.row as=@Texts
effect.requirement parent=@Texts index=0 requirement=$texts
effect.requirement parent=@Texts index=1 requirement=$config
add.parameter as=$plus-input function=$plus name=value type=i64
expression.block as=$plus-body
  (call $add (local $plus-input) (i64 3))
expression.end
create.function as=$plus module=$module name=plus-three visibility=private result=i64 effect=task body=$plus-body
add.parameter as=$suffix-input function=$suffix name=value type=text
expression.block as=$suffix-body
  (call $concat
    (local $suffix-input)
    (capability-call $config $config-text (static-text "suffix")))
expression.end
create.function as=$suffix module=$module name=append-configured-suffix visibility=private result=text effect=task body=$suffix-body
effect.requirement parent=$suffix index=0 requirement=$config
add.parameter as=$direct-key function=$direct name=key type=text
expression.block as=$direct-body
  (call $try-update (types i64) (effects @Empty) (requirements $numbers)
    (static-text "typed-cell")
    (i64 10)
    (function-value $plus)
    (list @KeyPart (variant $text-key (local $direct-key))))
expression.end
create.function as=$direct module=$module name=number-direct visibility=private result=@NumberOutcome effect=task body=$direct-body
effect.requirement parent=$direct index=0 requirement=$numbers
type.task-function as=@NumberPort result=@NumberOutcome effect=@Numbers
type.argument parent=@NumberPort index=0 type=text
add.port as=$direct-port component=$component name=number-direct type=@NumberPort function=$direct
create.target as=$direct-target name=number-direct component=$component port=$direct-port runner=command
add.parameter as=$bound-key function=$bound name=key type=text
expression.block as=$bound-body
  (invoke
    (bind
      (call $make-updater (types i64) (effects @Empty) (requirements $numbers)
        (static-text "typed-cell")
        (i64 10)
        (function-value $plus))
      (list @KeyPart (variant $text-key (local $bound-key)))))
expression.end
create.function as=$bound module=$module name=number-bound visibility=private result=@NumberOutcome effect=task body=$bound-body
effect.requirement parent=$bound index=0 requirement=$numbers
add.port as=$bound-port component=$component name=number-bound type=@NumberPort function=$bound
create.target as=$bound-target name=number-bound component=$component port=$bound-port runner=command
add.parameter as=$text-key-input function=$text-direct name=key type=text
expression.block as=$text-body
  (call $try-update (types text) (effects @Configuration) (requirements $texts)
    (static-text "typed-cell")
    (text "a")
    (function-value $suffix)
    (list @KeyPart (variant $text-key (local $text-key-input))))
expression.end
create.function as=$text-direct module=$module name=text-direct visibility=private result=@TextOutcome effect=task body=$text-body
effect.requirement parent=$text-direct index=0 requirement=$texts
effect.requirement parent=$text-direct index=1 requirement=$config
type.task-function as=@TextPort result=@TextOutcome effect=@Texts
type.argument parent=@TextPort index=0 type=text
add.port as=$text-direct-port component=$component name=text-direct type=@TextPort function=$text-direct
create.target as=$text-direct-target name=text-direct component=$component port=$text-direct-port runner=command
add.parameter as=$text-bound-key function=$text-bound name=key type=text
expression.block as=$text-bound-body
  (invoke
    (bind
      (call $make-updater (types text) (effects @Configuration) (requirements $texts)
        (static-text "typed-cell")
        (text "a")
        (function-value $suffix))
      (list @KeyPart (variant $text-key (local $text-bound-key)))))
expression.end
create.function as=$text-bound module=$module name=text-bound visibility=private result=@TextOutcome effect=task body=$text-bound-body
effect.requirement parent=$text-bound index=0 requirement=$texts
effect.requirement parent=$text-bound index=1 requirement=$config
add.port as=$text-bound-port component=$component name=text-bound type=@TextPort function=$text-bound
create.target as=$text-bound-target name=text-bound component=$component port=$text-bound-port runner=command
add.parameter as=$false-input function=$false-transform name=value type=i64
expression.block as=$false-transform-body
  (sequence
    (capability-call $numbers $schema-read (static-text "typed-cell"))
    (capability-call $numbers $put
      (static-text "typed-cell")
      (list @KeyPart (variant $text-key (text "aux")))
      (call $encode (types i64) (i64 999))
      (variant $Missing))
    (call $add (local $false-input) (i64 3)))
expression.end
create.function as=$false-transform module=$module name=false-auxiliary-condition visibility=private result=i64 effect=task body=$false-transform-body
effect.requirement parent=$false-transform index=0 requirement=$numbers
add.parameter as=$false-main-key function=$false-main name=key type=text
expression.block as=$false-main-body
  (call $try-update (types i64) (effects @Numbers) (requirements $numbers)
    (static-text "typed-cell")
    (i64 10)
    (function-value $false-transform)
    (list @KeyPart (variant $text-key (local $false-main-key))))
expression.end
create.function as=$false-main module=$module name=false-attempt visibility=private result=@NumberOutcome effect=task body=$false-main-body
effect.requirement parent=$false-main index=0 requirement=$numbers
add.port as=$false-port component=$component name=false-attempt type=@NumberPort function=$false-main
create.target as=$false-target name=false-attempt component=$component port=$false-port runner=command
add.parameter as=$trap-input function=$trap-transform name=value type=i64
expression.block as=$trap-transform-body
  (sequence
    (capability-call $numbers $put
      (static-text "typed-cell")
      (list @KeyPart (variant $text-key (text "trap-aux")))
      (call $encode (types i64) (i64 888))
      (variant $Missing))
    (call $divide (i64 1) (i64 0)))
expression.end
create.function as=$trap-transform module=$module name=auxiliary-write-then-trap visibility=private result=i64 effect=task body=$trap-transform-body
effect.requirement parent=$trap-transform index=0 requirement=$numbers
add.parameter as=$trap-main-key function=$trap-main name=key type=text
expression.block as=$trap-main-body
  (call $try-update (types i64) (effects @Numbers) (requirements $numbers)
    (static-text "typed-cell")
    (i64 10)
    (function-value $trap-transform)
    (list @KeyPart (variant $text-key (local $trap-main-key))))
expression.end
create.function as=$trap-main module=$module name=trapped-attempt visibility=private result=@NumberOutcome effect=task body=$trap-main-body
effect.requirement parent=$trap-main index=0 requirement=$numbers
add.port as=$trap-port component=$component name=trapped-attempt type=@NumberPort function=$trap-main
create.target as=$trap-target name=trapped-attempt component=$component port=$trap-port runner=command
expression.block as=$seed-transaction
  (transaction $numbers (binding seed-auxiliary)
    (capability-call $numbers $put
      (static-text "typed-cell")
      (list @KeyPart (variant $text-key (text "aux")))
      (call $encode (types i64) (i64 41))
      (variant $Missing)))
expression.end
create.function as=$seed module=$module name=seed-auxiliary visibility=private result=bool effect=task body=$seed-transaction
effect.requirement parent=$seed index=0 requirement=$numbers
type.task-function as=@SeedPort result=bool effect=@Numbers
add.port as=$seed-port component=$component name=seed-auxiliary type=@SeedPort function=$seed
create.target as=$seed-target name=seed-auxiliary component=$component port=$seed-port runner=command

#!/usr/bin/env python3
"""Run the maintained service against isolated PostgreSQL and retain bounded evidence."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import http.client
import json
import os
from pathlib import Path
import secrets
import selectors
import shutil
import signal
import socket
import subprocess
import sys
import time
from typing import Any
from urllib.parse import urlencode


ROOT = Path(__file__).resolve().parents[1]
APPLICATION = ROOT / "applications" / "lkjournal"
ARTIFACT = APPLICATION / "lkjournal.lkja"
SERVICE_DESCRIPTOR = APPLICATION / "service.deployment.json"
WORKER_DESCRIPTOR = APPLICATION / "worker.deployment.json"
LOG_ROOT = ROOT / ".artifacts" / "service"
POSTGRES_IMAGE = "postgres:16-alpine"
MAXIMUM_PROCESS_LOG_BYTES = 16 * 1024 * 1024
MAXIMUM_BACKUP_BYTES = 64 * 1024 * 1024


class AcceptanceFailure(Exception):
    """Stable acceptance failure with no sensitive values."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AcceptanceFailure(message)


def run(
    command: list[str],
    *,
    input_bytes: bytes | None = None,
    timeout: float = 60.0,
) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(
        command,
        cwd=ROOT,
        input=input_bytes,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )
    if result.returncode != 0:
        raise AcceptanceFailure(
            f"command failed with exit {result.returncode}: {command[0]} {command[1] if len(command) > 1 else ''}"
        )
    return result


def free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
        listener.bind(("127.0.0.1", 0))
        return int(listener.getsockname()[1])


def write_descriptor(source: Path, destination: Path, port: int | None) -> None:
    descriptor = json.loads(source.read_text())
    descriptor["artifact"] = "lkjournal.lkja"
    if port is not None:
        descriptor["listen"] = f"127.0.0.1:{port}"
    destination.write_text(json.dumps(descriptor, indent=2, sort_keys=True) + "\n")


class ManagedProcess:
    def __init__(
        self,
        command: list[str],
        directory: Path,
        environment: dict[str, str],
        log_prefix: Path,
    ) -> None:
        self.stdout_path = log_prefix.with_suffix(".stdout.log")
        self.stderr_path = log_prefix.with_suffix(".stderr.log")
        self.process = subprocess.Popen(
            command,
            cwd=directory,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
        self.lines: list[dict[str, Any]] = []
        self.retained = False

    def ready(self, timeout: float = 30.0) -> dict[str, Any]:
        assert self.process.stdout is not None
        selector = selectors.DefaultSelector()
        selector.register(self.process.stdout, selectors.EVENT_READ)
        events = selector.select(timeout)
        selector.close()
        if not events:
            raise AcceptanceFailure("runner did not publish readiness before the deadline")
        line = self.process.stdout.readline()
        if not line:
            raise AcceptanceFailure("runner exited before publishing readiness")
        self.stdout_path.write_bytes(line)
        try:
            event = json.loads(line)
        except json.JSONDecodeError as error:
            raise AcceptanceFailure("runner readiness was not machine JSON") from error
        require(event.get("ok") is True and event.get("event") == "ready", "runner readiness rejected")
        self.lines.append(event)
        return event

    def stop(self, timeout: float = 35.0) -> dict[str, Any]:
        if self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGINT)
        try:
            stdout, stderr = self.process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired as error:
            os.killpg(self.process.pid, signal.SIGKILL)
            self.process.communicate(timeout=5)
            raise AcceptanceFailure("runner did not stop within its declared grace") from error
        require(self.process.returncode == 0, "runner returned a nonzero exit status")
        existing = self.stdout_path.read_bytes() if self.stdout_path.exists() else b""
        require(
            len(existing) + len(stdout) <= MAXIMUM_PROCESS_LOG_BYTES
            and len(stderr) <= MAXIMUM_PROCESS_LOG_BYTES,
            "runner log exceeded the retained bound",
        )
        self.stdout_path.write_bytes(existing + stdout)
        self.stderr_path.write_bytes(stderr)
        self.retained = True
        for line in stdout.splitlines():
            try:
                self.lines.append(json.loads(line))
            except json.JSONDecodeError as error:
                raise AcceptanceFailure("runner stop output was not machine JSON") from error
        stopped = next(
            (event for event in reversed(self.lines) if event.get("event") == "stopped"),
            None,
        )
        require(stopped is not None and stopped.get("ok") is True, "runner omitted a successful stop receipt")
        return stopped

    def terminate_if_running(self) -> None:
        if self.retained:
            return
        if self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGKILL)
        stdout, stderr = self.process.communicate(timeout=5)
        existing = self.stdout_path.read_bytes() if self.stdout_path.exists() else b""
        self.stdout_path.write_bytes((existing + stdout)[:MAXIMUM_PROCESS_LOG_BYTES])
        self.stderr_path.write_bytes(stderr[:MAXIMUM_PROCESS_LOG_BYTES])
        self.retained = True


def request(
    port: int,
    method: str,
    path: str,
    body: bytes = b"",
    headers: dict[str, str] | None = None,
) -> tuple[int, bytes, int]:
    status, payload, elapsed, _ = request_observed(port, method, path, body, headers)
    return status, payload, elapsed


def request_observed(
    port: int,
    method: str,
    path: str,
    body: bytes = b"",
    headers: dict[str, str] | None = None,
) -> tuple[int, bytes, int, dict[str, str]]:
    started = time.perf_counter_ns()
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=35)
    try:
        connection.request(method, path, body=body, headers=headers or {})
        response = connection.getresponse()
        payload = response.read()
        return (
            response.status,
            payload,
            time.perf_counter_ns() - started,
            {name.lower(): value for name, value in response.getheaders()},
        )
    finally:
        connection.close()


def json_body(payload: bytes) -> Any:
    try:
        return json.loads(payload)
    except json.JSONDecodeError as error:
        raise AcceptanceFailure("service response was not JSON") from error


def postgres_scalar(container: str, database: str, statement: str) -> str:
    result = run(
        [
            "docker",
            "exec",
            container,
            "psql",
            "-U",
            "postgres",
            "-d",
            database,
            "-Atc",
            statement,
        ]
    )
    return result.stdout.decode().strip()


def wait_for_postgres(container: str, host_port: int) -> None:
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        result = subprocess.run(
            ["docker", "exec", container, "pg_isready", "-U", "postgres", "-d", "lkjournal"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            try:
                with socket.create_connection(("127.0.0.1", host_port), timeout=0.25):
                    return
            except OSError:
                pass
        time.sleep(0.25)
    raise AcceptanceFailure("PostgreSQL did not become ready")


def assert_clean_shutdown(event: dict[str, Any]) -> None:
    shutdown = event["receipt"]["shutdown"]
    require(shutdown["admission_stopped"] is True, "shutdown did not stop admission")
    require(shutdown["remaining_tasks"] == 0, "shutdown retained tasks")
    require(shutdown["cleanup_failures"] == [], "shutdown reported cleanup failure")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", default="target/release/lkjscript")
    arguments = parser.parse_args()
    binary = Path(arguments.binary)
    if not binary.is_absolute():
        binary = ROOT / binary

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    run_directory = LOG_ROOT / f"{stamp}-{os.getpid()}"
    run_directory.mkdir(parents=True)
    receipt_path = run_directory / "receipt.json"
    container = f"lkjscript-service-{os.getpid()}-{secrets.token_hex(4)}"
    database_password = secrets.token_hex(16)
    bootstrap_token = secrets.token_hex(16)
    application_password = "acceptance-password"
    processes: list[ManagedProcess] = []
    container_started = False
    started = time.perf_counter_ns()
    receipt: dict[str, Any] = {
        "contract_version": 1,
        "status": "failed",
        "postgres_image": POSTGRES_IMAGE,
        "run_directory": str(run_directory.relative_to(ROOT)),
    }

    try:
        require(binary.is_file(), f"runner binary is absent: {binary.relative_to(ROOT)}")
        require(shutil.which("docker") is not None, "Docker is unavailable")
        image = subprocess.run(
            ["docker", "image", "inspect", POSTGRES_IMAGE],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        require(image.returncode == 0, f"required local image is unavailable: {POSTGRES_IMAGE}")

        shutil.copyfile(ARTIFACT, run_directory / "lkjournal.lkja")
        service_port = free_port()
        write_descriptor(SERVICE_DESCRIPTOR, run_directory / "service.json", service_port)
        write_descriptor(WORKER_DESCRIPTOR, run_directory / "worker.json", None)

        run(
            [
                "docker",
                "run",
                "--rm",
                "--name",
                container,
                "-e",
                f"POSTGRES_PASSWORD={database_password}",
                "-e",
                "POSTGRES_DB=lkjournal",
                "-p",
                "127.0.0.1::5432",
                "-d",
                POSTGRES_IMAGE,
            ]
        )
        container_started = True
        port_result = run(["docker", "port", container, "5432/tcp"])
        postgres_port = int(port_result.stdout.decode().strip().rsplit(":", 1)[1])
        wait_for_postgres(container, postgres_port)
        database_url = (
            f"postgresql://postgres:{database_password}@127.0.0.1:{postgres_port}/lkjournal"
        )
        environment = os.environ.copy()
        environment["LKJOURNAL_BOOTSTRAP_TOKEN"] = bootstrap_token
        environment["LKJOURNAL_DATABASE_URL"] = database_url

        service = ManagedProcess(
            [str(binary), "serve", "--deployment", "service.json"],
            run_directory,
            environment,
            run_directory / "service-first",
        )
        processes.append(service)
        ready = service.ready()
        require(ready["deployment"]["secret_names"] == ["bootstrap-token", "database-url"], "secret names changed")

        timings: dict[str, int] = {}
        status, body, timings["health"] = request(service_port, "GET", "/health")
        require(status == 200 and body == b"ready", "health route failed")
        status, _, timings["bootstrap_denial"] = request(
            service_port,
            "POST",
            "/initialize?" + urlencode({"actor": "operator"}),
            b"body-must-not-be-read",
        )
        require(status == 403, "bootstrap denial changed")
        status, body, timings["initialize"], response_headers = request_observed(
            service_port,
            "POST",
            "/initialize?" + urlencode({"actor": "operator"}),
            application_password.encode(),
            {"Authorization": f"Bearer {bootstrap_token}"},
        )
        receipt["initialization_transport"] = {
            "status": status,
            "body_bytes": len(body),
            "body_sha256": hashlib.sha256(body).hexdigest(),
            "failure_class": response_headers.get("x-lkjscript-failure-class"),
            "failure_code": response_headers.get("x-lkjscript-failure-code"),
        }
        initialization = json_body(body)
        receipt["initialization_observation"] = {
            "status": status,
            "actor_inserted": initialization.get("actor_inserted"),
            "error": initialization.get("error"),
        }
        require(
            status == 200 and initialization.get("actor_inserted") is True,
            "initialization failed",
        )
        status, body, timings["login"] = request(
            service_port,
            "POST",
            "/login?" + urlencode({"actor": "operator"}),
            application_password.encode(),
        )
        login = json_body(body)
        require(status == 200 and login["actor"] == "operator", "login failed")
        token = login["token"]
        authorization = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}

        create_input = json.dumps(
            {"title": "Acceptance entry", "body": "# Initial\nLive service evidence."},
            separators=(",", ":"),
        ).encode()
        status, body, timings["create"] = request(
            service_port, "POST", "/resources", create_input, authorization
        )
        created = json_body(body)
        require(status == 201 and created["revision"] == 0, "resource creation failed")
        resource_id = created["id"]

        status, body, timings["list"] = request(
            service_port, "GET", "/resources", headers=authorization
        )
        listed = json_body(body)
        require(status == 200 and len(listed) == 1 and listed[0]["id"] == resource_id, "resource list failed")
        status, body, timings["read"] = request(
            service_port,
            "GET",
            "/resource?" + urlencode({"id": resource_id}),
            headers=authorization,
        )
        require(status == 200 and json_body(body)["revision"] == 0, "resource read failed")

        update_input = json.dumps(
            {"title": "Acceptance entry revised", "body": "# Revised", "base": 0},
            separators=(",", ":"),
        ).encode()
        status, body, timings["update"] = request(
            service_port,
            "POST",
            "/resource/update?" + urlencode({"id": resource_id}),
            update_input,
            authorization,
        )
        require(status == 200 and json_body(body)["revision"] == 1, "exact-base update failed")
        status, _, timings["stale_update"] = request(
            service_port,
            "POST",
            "/resource/update?" + urlencode({"id": resource_id}),
            update_input,
            authorization,
        )
        require(status == 409, "stale update did not reject")
        status, body, timings["history"] = request(
            service_port,
            "GET",
            "/resource/history?" + urlencode({"id": resource_id}),
            headers=authorization,
        )
        require(status == 200 and len(json_body(body)) == 2, "immutable history failed")
        status, _, timings["unauthenticated"] = request(
            service_port, "GET", "/resource?" + urlencode({"id": resource_id})
        )
        require(status == 401, "unauthenticated request did not reject")
        status, _, timings["strict_json"] = request(
            service_port,
            "POST",
            "/resources",
            b'{"title":"x","body":"y","foreign":true}',
            authorization,
        )
        require(status == 400, "unknown JSON field did not reject")

        object_payload = b"z" * 200_000
        status, body, timings["object_put"] = request(
            service_port,
            "POST",
            "/objects?" + urlencode({"name": "acceptance-200k.bin"}),
            object_payload,
            authorization,
        )
        require(status == 201 and json_body(body)["bytes"] == len(object_payload), "object publication failed")
        object_path = run_directory / "state" / "objects" / "lkjournal" / "operator" / "acceptance-200k.bin"
        require(object_path.read_bytes() == object_payload, "published object bytes disagree")

        worker = ManagedProcess(
            [str(binary), "worker", "--deployment", "worker.json"],
            run_directory,
            environment,
            run_directory / "worker",
        )
        processes.append(worker)
        worker.ready()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            state = postgres_scalar(
                container,
                "lkjournal",
                "SELECT state FROM lkjscript_durable_jobs WHERE job_id = '" + resource_id + "';",
            )
            if state == "completed":
                break
            time.sleep(0.1)
        require(state == "completed", "worker did not complete the durable job")
        worker_stopped = worker.stop()
        require(worker_stopped["receipt"]["productive_iterations"] >= 1, "worker reported no productive work")
        assert_clean_shutdown(worker_stopped)

        service_stopped = service.stop()
        assert_clean_shutdown(service_stopped)

        backup = run(
            ["docker", "exec", container, "pg_dump", "-U", "postgres", "-d", "lkjournal", "--format=custom"],
            timeout=60,
        ).stdout
        require(0 < len(backup) <= MAXIMUM_BACKUP_BYTES, "database backup size is invalid")
        (run_directory / "lkjournal.pgcustom").write_bytes(backup)
        run(["docker", "exec", container, "createdb", "-U", "postgres", "lkjournal_restore"])
        run(
            ["docker", "exec", "-i", container, "pg_restore", "-U", "postgres", "-d", "lkjournal_restore", "--exit-on-error"],
            input_bytes=backup,
            timeout=60,
        )

        restored_port = free_port()
        write_descriptor(SERVICE_DESCRIPTOR, run_directory / "service-restored.json", restored_port)
        restored_environment = environment.copy()
        restored_environment["LKJOURNAL_DATABASE_URL"] = (
            f"postgresql://postgres:{database_password}@127.0.0.1:{postgres_port}/lkjournal_restore"
        )
        restored = ManagedProcess(
            [str(binary), "serve", "--deployment", "service-restored.json"],
            run_directory,
            restored_environment,
            run_directory / "service-restored",
        )
        processes.append(restored)
        restored.ready()
        status, body, timings["restored_read"] = request(
            restored_port,
            "GET",
            "/resource?" + urlencode({"id": resource_id}),
            headers=authorization,
        )
        require(status == 200 and json_body(body)["revision"] == 1, "restored service disagrees")
        restored_stopped = restored.stop()
        assert_clean_shutdown(restored_stopped)

        receipt.update(
            {
                "status": "passed",
                "artifact_digest": ready["deployment"]["artifact_digest"],
                "routes_checked": 13,
                "resource_revision": 1,
                "history_entries": 2,
                "object_bytes": len(object_payload),
                "worker_productive_iterations": worker_stopped["receipt"]["productive_iterations"],
                "database_backup_bytes": len(backup),
                "restored_read": "equal",
                "shutdown_cleanup_failures": 0,
                "request_elapsed_nanoseconds": timings,
                "secrets": "redacted",
            }
        )
    except (AcceptanceFailure, OSError, subprocess.SubprocessError) as error:
        receipt["error"] = {"class": type(error).__name__, "message": str(error)}
    finally:
        for process in processes:
            process.terminate_if_running()
        if container_started:
            subprocess.run(
                ["docker", "stop", "--time", "5", container],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        receipt["elapsed_nanoseconds"] = time.perf_counter_ns() - started
        receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")

    summary = {
        "contract_version": 1,
        "status": receipt["status"],
        "receipt": str(receipt_path.relative_to(ROOT)),
    }
    if receipt["status"] != "passed":
        summary["error"] = receipt.get("error", {"class": "unknown"})
    print(json.dumps(summary, separators=(",", ":"), sort_keys=True))
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())

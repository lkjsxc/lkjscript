declarations.begin
(units
  (module create artifact-manifest
    (function create typed
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create width (type I64))
      (parameter create tag (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::push (local tag) (local out)))
          (in
            (call wire::range (local data) (local at) (call ci::add (local at) (local width)) (local a))))))
    (function create owner-tag
      (visibility public)
      (effect pure)
      (parameter create ordinal (type I64))
      (returns I64)
      (body
        (if
          (call ci::lt (local ordinal) (i64 2))
          (call ci::add (local ordinal) (i64 2))
          (if
            (call ci::eq (local ordinal) (i64 2))
            (i64 17)
            (if
              (call ci::lt (local ordinal) (i64 12))
              (call ci::add (local ordinal) (i64 1))
              (if
                (call ci::lt (local ordinal) (i64 14))
                (call ci::add (local ordinal) (i64 3))
                (call ci::add (local ordinal) (i64 4))))))))
    (function create map-root
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a
            (type ByteBuffer)
            (call wire::range (local data) (local at) (call ci::add (local at) (i64 32)) (local out)))
          (binding b
            (type ByteBuffer)
            (call wire::unsigned (call ci::field64 (local data) (local at) (i64 32)) (local a)))
          (binding c (type ByteBuffer) (call ci::push (i64 1) (local b)))
          (in
            (call
              wire::range
              (local data)
              (call ci::add (local at) (i64 40))
              (call ci::add (local at) (i64 72))
              (local c))))))
    (function create unit-root
      (visibility private)
      (effect pure)
      (parameter create page (type Bytes))
      (parameter create content (type Bytes))
      (parameter create count (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::append (local page) (i64 0) (local out)))
          (binding b (type ByteBuffer) (call wire::unsigned (local count) (local a)))
          (binding c (type ByteBuffer) (call ci::push (i64 1) (local b)))
          (in (call ci::append (local content) (i64 0) (local c))))))
    (function create owners
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local data)))
          (local out)
          (let
            (binding ordinal (call ci::u32 (local data) (local at)))
            (binding a (type ByteBuffer) (call wire::unsigned (local ordinal) (local out)))
            (binding b
              (type ByteBuffer)
              (call
                typed
                (local data)
                (call ci::add (local at) (i64 8))
                (i64 16)
                (call owner-tag (local ordinal))
                (local a)))
            (binding c
              (type ByteBuffer)
              (call wire::unsigned (call ci::field32 (local data) (local at) (i64 4)) (local b)))
            (binding d
              (type ByteBuffer)
              (call typed (local data) (call ci::add (local at) (i64 24)) (i64 32) (i64 1) (local c)))
            (in (call owners (local data) (call ci::add (local at) (i64 56)) (local d)))))))
    (function create compilation
      (visibility public)
      (effect pure)
      (parameter create meta (type Bytes))
      (parameter create page (type Bytes))
      (parameter create content (type Bytes))
      (parameter create count (type I64))
      (returns Bytes)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b (type ByteBuffer) (call ci::le (i64 16843009) (i64 4) (local a)))
          (binding c (type ByteBuffer) (call typed (local meta) (i64 0) (i64 16) (i64 1) (local b)))
          (binding d (type ByteBuffer) (call typed (local meta) (i64 16) (i64 16) (i64 18) (local c)))
          (binding e (type ByteBuffer) (call typed (local meta) (i64 64) (i64 32) (i64 255) (local d)))
          (binding f (type ByteBuffer) (call typed (local meta) (i64 32) (i64 32) (i64 11) (local e)))
          (binding g (type ByteBuffer) (call typed (local meta) (i64 96) (i64 32) (i64 10) (local f)))
          (binding h (type ByteBuffer) (call typed (local meta) (i64 128) (i64 32) (i64 12) (local g)))
          (binding i (type ByteBuffer) (call ci::push (i64 0) (local h)))
          (binding j
            (type ByteBuffer)
            (call unit-root (local page) (local content) (local count) (local i)))
          (in
            (call
              wire::envelope
              (text "LKJCMNFT")
              (text "lkjscript.compilation-manifest-envelope")
              (call ci::freeze (local j)))))))
    (function create artifact
      (visibility public)
      (effect pure)
      (parameter create meta (type Bytes))
      (parameter create compilation (type Bytes))
      (parameter create closure (type Bytes))
      (parameter create count (type I64))
      (parameter create bytes (type I64))
      (returns Bytes)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b (type ByteBuffer) (call ci::le (i64 4311810305) (i64 5) (local a)))
          (binding c (type ByteBuffer) (call typed (local meta) (i64 16) (i64 16) (i64 18) (local b)))
          (binding d (type ByteBuffer) (call ci::push (i64 1) (local c)))
          (binding e (type ByteBuffer) (call typed (local meta) (i64 0) (i64 16) (i64 1) (local d)))
          (binding f (type ByteBuffer) (call typed (local meta) (i64 16) (i64 16) (i64 18) (local e)))
          (binding g (type ByteBuffer) (call typed (local meta) (i64 32) (i64 32) (i64 11) (local f)))
          (binding h (type ByteBuffer) (call typed (local meta) (i64 64) (i64 32) (i64 255) (local g)))
          (binding i (type ByteBuffer) (call typed (local meta) (i64 96) (i64 32) (i64 10) (local h)))
          (binding j (type ByteBuffer) (call typed (local meta) (i64 128) (i64 32) (i64 12) (local i)))
          (binding k (type ByteBuffer) (call map-root (local meta) (i64 160) (local j)))
          (binding l (type ByteBuffer) (call ci::append (local compilation) (i64 0) (local k)))
          (binding m
            (type ByteBuffer)
            (call wire::unsigned (call ci::u64 (local meta) (i64 304)) (local l)))
          (binding n (type ByteBuffer) (call owners (local meta) (i64 312) (local m)))
          (binding o (type ByteBuffer) (call map-root (local meta) (i64 232) (local n)))
          (binding p (type ByteBuffer) (call ci::append (local closure) (i64 0) (local o)))
          (binding q (type ByteBuffer) (call wire::unsigned (local count) (local p)))
          (binding r (type ByteBuffer) (call wire::unsigned (local bytes) (local q)))
          (in
            (call
              wire::envelope
              (text "LKJAMNFT")
              (text "lkjscript.artifact-manifest-envelope")
              (call ci::freeze (local r)))))))
    (function create container
      (visibility public)
      (effect pure)
      (parameter create manifest (type Bytes))
      (parameter create count (type I64))
      (parameter create segments (type Bytes))
      (returns Bytes)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b
            (type ByteBuffer)
            (call ci::append (call ci::text-bytes (text "LKJARTFC")) (i64 0) (local a)))
          (binding c (type ByteBuffer) (call ci::le (i64 1) (i64 4) (local b)))
          (binding d
            (type ByteBuffer)
            (call wire::be (call ci::length (local manifest)) (i64 8) (local c)))
          (binding e (type ByteBuffer) (call wire::be (local count) (i64 8) (local d)))
          (binding f
            (type ByteBuffer)
            (call
              ci::append
              (call wire::digest (text "lkjscript.artifact-manifest.v14") (local manifest))
              (i64 0)
              (local e)))
          (binding g (type ByteBuffer) (call ci::append (local manifest) (i64 0) (local f)))
          (binding h (type ByteBuffer) (call ci::append (local segments) (i64 0) (local g)))
          (binding core (call ci::freeze (local h)))
          (binding tail
            (call
              ci::concat
              (call wire::digest (text "lkjscript.artifact-bundle.complete") (local core))
              (call ci::text-bytes (text "LKJAEND!"))))
          (in (call ci::concat (local core) (local tail))))))))
declarations.end

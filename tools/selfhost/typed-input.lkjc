declarations.begin
(units
  (module create typed-input
    (external create add (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create sub (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create mul (visibility private) (implementation core.i64.multiply)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create equal (visibility private) (implementation core.i64.equal)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create length (visibility private) (implementation core.bytes.length)
      (parameter create data (type Bytes)) (returns I64))
    (external create octet (visibility private) (implementation core.bytes.get)
      (parameter create data (type Bytes)) (parameter create at (type I64)) (returns I64))
    (external create slice (visibility private) (implementation core.bytes.slice)
      (parameter create data (type Bytes)) (parameter create start (type I64))
      (parameter create end (type I64)) (returns Bytes))
    (external create same (visibility private) (implementation core.bytes.equal)
      (parameter create left (type Bytes)) (parameter create right (type Bytes)) (returns Bool))
    (external create text-bytes (visibility private) (implementation core.bytes.from-text)
      (parameter create text (type Text)) (returns Bytes))
    (external create append (visibility private) (implementation core.list.append)
      (type-parameter create T)
      (parameter create values (type (list T))) (parameter create value (type T)) (returns (list T)))
    (external create size (visibility private) (implementation core.list.length)
      (type-parameter create T) (parameter create values (type (list T))) (returns I64))
    (external create item (visibility private) (implementation core.list.get)
      (type-parameter create T) (parameter create values (type (list T)))
      (parameter create index (type I64)) (returns T))

    (record create ReadError (visibility public)
      (field create at (type I64)) (field create message (type Text)))
    (record create Directory (visibility private)
      (field create data (type Bytes)) (field create owners (type I64))
      (field create count (type I64)) (field create ids (type I64))
      (field create spans (type I64)) (field create objects (type I64)))
    (record create TypeEntry (visibility public)
      (field create index (type I64)) (field create digest (type Bytes)) (field create image (type Bytes)))
    (variant create OpenResult (visibility private)
      (case create ready (payload Directory)) (case create error (payload ReadError)))
    (variant create EntryResult (visibility private)
      (case create ready (payload TypeEntry)) (case create error (payload ReadError)))
    (variant create TableResult (visibility public)
      (case create ready (payload (list TypeEntry))) (case create error (payload ReadError)))
    (variant create Lookup (visibility public)
      (case create found (payload TypeEntry)) (case create missing))

    (function create error (visibility private) (effect pure)
      (parameter create at (type I64)) (parameter create message (type Text)) (returns ReadError)
      (body (record ReadError (field ReadError::at (local at)) (field ReadError::message (local message)))))
    (function create u32 (visibility private) (effect pure)
      (parameter create data (type Bytes)) (parameter create at (type I64)) (returns I64)
      (body (call add (call octet (local data) (local at))
        (call mul (i64 256) (call add (call octet (local data) (call add (local at) (i64 1)))
          (call mul (i64 256) (call add (call octet (local data) (call add (local at) (i64 2)))
            (call mul (i64 256) (call octet (local data) (call add (local at) (i64 3)))))))))))
    (function create fits (visibility private) (effect pure)
      (parameter create data (type Bytes)) (parameter create at (type I64))
      (parameter create count (type I64)) (returns Bool)
      (body (if (call less (local at) (i64 0)) (bool false)
        (if (call less (local count) (i64 0)) (bool false)
          (if (call less (call length (local data)) (local at)) (bool false)
            (if (call less (call sub (call length (local data)) (local at)) (local count))
              (bool false) (bool true)))))))
    (function create open (visibility private) (effect pure)
      (parameter create data (type Bytes)) (returns OpenResult)
      (body (if (call fits (local data) (i64 0) (i64 128))
        (if (call same (call slice (local data) (i64 0) (i64 8)) (call text-bytes (text "LKJSG002")))
          (if (call equal (call u32 (local data) (i64 112)) (i64 3))
            (if (call equal (call u32 (local data) (i64 8)) (call length (local data)))
              (let
                (binding owners (call u32 (local data) (i64 12)))
                (binding count (call u32 (local data) (i64 16)))
                (binding ids (call u32 (local data) (i64 84)))
                (binding spans (call u32 (local data) (i64 92)))
                (binding objects (call u32 (local data) (i64 96)))
                (in (if (call fits (local data) (local ids) (call mul (local count) (i64 32)))
                  (if (call fits (local data) (local spans) (call mul (call add (local owners) (local count)) (i64 8)))
                    (if (call fits (local data) (local objects) (i64 0))
                      (variant OpenResult::ready (record Directory
                        (field Directory::data (local data)) (field Directory::owners (local owners))
                        (field Directory::count (local count)) (field Directory::ids (local ids))
                        (field Directory::spans (local spans)) (field Directory::objects (local objects))))
                      (variant OpenResult::error (call error (i64 96) (text "object directory outside input"))))
                    (variant OpenResult::error (call error (i64 92) (text "span directory outside input"))))
                  (variant OpenResult::error (call error (i64 84) (text "type directory outside input"))))))
              (variant OpenResult::error (call error (i64 8) (text "carrier length differs from input"))))
            (variant OpenResult::error (call error (i64 112) (text "unsupported carrier profile"))))
          (variant OpenResult::error (call error (i64 0) (text "invalid carrier magic"))))
        (variant OpenResult::error (call error (i64 0) (text "truncated carrier header"))))))
    (function create read-entry (visibility private) (effect pure)
      (parameter create directory (type Directory)) (parameter create index (type I64)) (returns EntryResult)
      (body (let
        (binding data (field (local directory) Directory::data))
        (binding span (call add (field (local directory) Directory::spans)
          (call mul (call add (field (local directory) Directory::owners) (local index)) (i64 8))))
        (binding start (call u32 (local data) (local span)))
        (binding count (call u32 (local data) (call add (local span) (i64 4))))
        (binding digest-at (call add (field (local directory) Directory::ids) (call mul (local index) (i64 32))))
        (in (if (call less (local start) (field (local directory) Directory::objects))
          (variant EntryResult::error (call error (local span) (text "type image precedes object data")))
          (if (call fits (local data) (local start) (local count))
            (variant EntryResult::ready (record TypeEntry
              (field TypeEntry::index (local index))
              (field TypeEntry::digest (call slice (local data) (local digest-at) (call add (local digest-at) (i64 32))))
              (field TypeEntry::image (call slice (local data) (local start) (call add (local start) (local count))))))
            (variant EntryResult::error (call error (local span) (text "type image outside input")))))))))
    (function create collect (visibility private) (effect pure)
      (parameter create directory (type Directory)) (parameter create index (type I64))
      (parameter create entries (type (list TypeEntry))) (returns TableResult)
      (body (if (call equal (local index) (field (local directory) Directory::count))
        (variant TableResult::ready (local entries))
        (match (call read-entry (local directory) (local index))
          (arm EntryResult::error (payload problem ReadError) (variant TableResult::error (local problem)))
          (arm EntryResult::ready (payload entry TypeEntry)
            (call collect (local directory) (call add (local index) (i64 1))
              (call append (types TypeEntry) (local entries) (local entry))))))))
    (function create read (visibility public) (effect pure)
      (parameter create data (type Bytes)) (returns TableResult)
      (body (match (call open (local data))
        (arm OpenResult::error (payload problem ReadError) (variant TableResult::error (local problem)))
        (arm OpenResult::ready (payload directory Directory)
          (call collect (local directory) (i64 0) (list TypeEntry))))))
    (function create lookup-from (visibility private) (effect pure)
      (parameter create entries (type (list TypeEntry))) (parameter create digest (type Bytes))
      (parameter create index (type I64)) (returns Lookup)
      (body (if (call equal (local index) (call size (types TypeEntry) (local entries)))
        (variant Lookup::missing)
        (let (binding entry (call item (types TypeEntry) (local entries) (local index)))
          (in (if (call same (field (local entry) TypeEntry::digest) (local digest))
            (variant Lookup::found (local entry))
            (call lookup-from (local entries) (local digest) (call add (local index) (i64 1)))))))))
    (function create lookup (visibility public) (effect pure)
      (parameter create entries (type (list TypeEntry))) (parameter create digest (type Bytes)) (returns Lookup)
      (body (call lookup-from (local entries) (local digest) (i64 0))))

    (external create divide
      (visibility private)
      (implementation core.i64.divide)
      (parameter create a (type I64))
      (parameter create b (type I64))
      (returns I64))

    (external create read-word
      (visibility private)
      (implementation core.bytes.read-i64-le)
      (parameter create data (type Bytes))
      (parameter create start (type I64))
      (returns I64))

    (variant create TypeKind
      (visibility public)
      (case create unit)
      (case create bool)
      (case create i64)
      (case create bytes)
      (case create text)
      (case create static-text)
      (case create secret)
      (case create type-parameter)
      (case create named)
      (case create capability-resource)
      (case create structural-record)
      (case create list)
      (case create map)
      (case create option)
      (case create result)
      (case create stream)
      (case create function)
      (case create applied)
      (case create task-function)
      (case create f64)
      (case create byte-buffer)
      (case create owned-i64-cell)
      (case create owned-product)
      (case create owned-choice)
      (case create owned-sequence)
      (case create associated-contract-member)
      (case create associated-witness-projection)
      (case create read-view-applied)
      (case create associated-read-view-member)
      (case create associated-read-view-projection)
      (case create region-brand)
      (case create region)
      (case create rel-ptr)
      (case create region-slice)
      (case create region-cap))

    (record create TypeShape
      (visibility public)
      (field create kind (type TypeKind))
      (field create children (type (list Bytes))))

    (variant create ShapeResult
      (visibility public)
      (case create ready (payload TypeShape))
      (case create error (payload ReadError)))

    (record create Cursor
      (visibility private)
      (field create data (type Bytes))
      (field create at (type I64))
      (field create end (type I64))
      (field create children (type (list Bytes))))

    (variant create ReadStep
      (visibility private)
      (case create ready (payload Cursor))
      (case create error (payload ReadError)))

    (record create ReadNumber
      (visibility private)
      (field create cursor (type Cursor))
      (field create value (type I64)))

    (variant create NumberResult
      (visibility private)
      (case create ready (payload ReadNumber))
      (case create error (payload ReadError)))

    (function create cursor-at
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create at (type I64))
      (returns Cursor)
      (body
        (record Cursor
          (field Cursor::data (field (local cursor) Cursor::data))
          (field Cursor::at (local at))
          (field Cursor::end (field (local cursor) Cursor::end))
          (field Cursor::children (field (local cursor) Cursor::children)))))

    (function create within
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns Bool)
      (body
        (if
          (call less (local count) (i64 0))
          (bool false)
          (if
            (call less (field (local cursor) Cursor::end) (field (local cursor) Cursor::at))
            (bool false)
            (if
              (call less
                (call sub (field (local cursor) Cursor::end) (field (local cursor) Cursor::at))
                (local count))
              (bool false)
              (bool true))))))

    (function create advance
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns ReadStep)
      (body
        (if
          (call within (local cursor) (local count))
          (variant ReadStep::ready
            (call cursor-at (local cursor) (call add (field (local cursor) Cursor::at) (local count))))
          (variant ReadStep::error (call error (field (local cursor) Cursor::at) (text "truncated type metadata"))))))

    (function create take-byte
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns NumberResult)
      (body
        (if
          (call within (local cursor) (i64 1))
          (variant NumberResult::ready
            (record ReadNumber
              (field ReadNumber::cursor
                (call cursor-at (local cursor) (call add (field (local cursor) Cursor::at) (i64 1))))
              (field ReadNumber::value
                (call octet (field (local cursor) Cursor::data) (field (local cursor) Cursor::at)))))
          (variant NumberResult::error (call error (field (local cursor) Cursor::at) (text "truncated type byte"))))))

    (function create take-little
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create width (type I64))
      (parameter create minimum (type I64))
      (returns NumberResult)
      (body
        (if
          (call within (local cursor) (local width))
          (let
            (binding value
              (if
                (call equal (local width) (i64 2))
                (call add
                  (call octet (field (local cursor) Cursor::data) (field (local cursor) Cursor::at))
                  (call mul
                    (i64 256)
                    (call octet
                      (field (local cursor) Cursor::data)
                      (call add (field (local cursor) Cursor::at) (i64 1)))))
                (if
                  (call equal (local width) (i64 4))
                  (call u32 (field (local cursor) Cursor::data) (field (local cursor) Cursor::at))
                  (call read-word (field (local cursor) Cursor::data) (field (local cursor) Cursor::at)))))
            (in
              (if
                (call less (local value) (local minimum))
                (variant NumberResult::error
                  (call error
                    (field (local cursor) Cursor::at)
                    (text "noncanonical or unrepresentable unsigned integer")))
                (variant NumberResult::ready
                  (record ReadNumber
                    (field ReadNumber::cursor
                      (call cursor-at (local cursor) (call add (field (local cursor) Cursor::at) (local width))))
                    (field ReadNumber::value (local value)))))))
          (variant NumberResult::error
            (call error (field (local cursor) Cursor::at) (text "truncated unsigned integer"))))))

    (function create take-size
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns NumberResult)
      (body
        (match
          (call take-byte (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant NumberResult::error (local problem)))
          (arm NumberResult::ready
            (payload prefix ReadNumber)
            (if
              (call less (field (local prefix) ReadNumber::value) (i64 251))
              (variant NumberResult::ready (local prefix))
              (if
                (call equal (field (local prefix) ReadNumber::value) (i64 251))
                (call take-little (field (local prefix) ReadNumber::cursor) (i64 2) (i64 251))
                (if
                  (call equal (field (local prefix) ReadNumber::value) (i64 252))
                  (call take-little (field (local prefix) ReadNumber::cursor) (i64 4) (i64 65536))
                  (if
                    (call equal (field (local prefix) ReadNumber::value) (i64 253))
                    (call take-little (field (local prefix) ReadNumber::cursor) (i64 8) (i64 4294967296))
                    (variant NumberResult::error
                      (call error (field (local cursor) Cursor::at) (text "invalid unsigned integer prefix")))))))))))

    (function create skip-id
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create domain (type I64))
      (returns ReadStep)
      (body
        (if
          (call within (local cursor) (i64 17))
          (if
            (call equal
              (call octet (field (local cursor) Cursor::data) (field (local cursor) Cursor::at))
              (local domain))
            (variant ReadStep::ready
              (call cursor-at (local cursor) (call add (field (local cursor) Cursor::at) (i64 17))))
            (variant ReadStep::error (call error (field (local cursor) Cursor::at) (text "invalid identity domain"))))
          (variant ReadStep::error (call error (field (local cursor) Cursor::at) (text "truncated identity"))))))

    (function create skip-ids
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create domains (type (list I64)))
      (parameter create index (type I64))
      (returns ReadStep)
      (body
        (if
          (call equal (local index) (call size (types I64) (local domains)))
          (variant ReadStep::ready (local cursor))
          (match
            (call skip-id (local cursor) (call item (types I64) (local domains) (local index)))
            (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
            (arm ReadStep::ready
              (payload next Cursor)
              (call skip-ids (local next) (local domains) (call add (local index) (i64 1))))))))

    (function create take-child
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (if
          (call within (local cursor) (i64 33))
          (if
            (call equal (call octet (field (local cursor) Cursor::data) (field (local cursor) Cursor::at)) (i64 2))
            (variant ReadStep::ready
              (record Cursor
                (field Cursor::data (field (local cursor) Cursor::data))
                (field Cursor::at (call add (field (local cursor) Cursor::at) (i64 33)))
                (field Cursor::end (field (local cursor) Cursor::end))
                (field Cursor::children
                  (call append
                    (types Bytes)
                    (field (local cursor) Cursor::children)
                    (call slice
                      (field (local cursor) Cursor::data)
                      (call add (field (local cursor) Cursor::at) (i64 1))
                      (call add (field (local cursor) Cursor::at) (i64 33)))))))
            (variant ReadStep::error
              (call error (field (local cursor) Cursor::at) (text "invalid type digest domain"))))
          (variant ReadStep::error
            (call error (field (local cursor) Cursor::at) (text "truncated child type digest"))))))

    (function create take-children
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns ReadStep)
      (body
        (if
          (call equal (local count) (i64 0))
          (variant ReadStep::ready (local cursor))
          (match
            (call take-child (local cursor))
            (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
            (arm ReadStep::ready
              (payload next Cursor)
              (call take-children (local next) (call sub (local count) (i64 1))))))))

    (function create take-array
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-size (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload count ReadNumber)
            (if
              (call less
                (call divide
                  (call sub
                    (field (field (local count) ReadNumber::cursor) Cursor::end)
                    (field (field (local count) ReadNumber::cursor) Cursor::at))
                  (i64 33))
                (field (local count) ReadNumber::value))
              (variant ReadStep::error
                (call error (field (local cursor) Cursor::at) (text "child count exceeds remaining type image")))
              (call take-children (field (local count) ReadNumber::cursor) (field (local count) ReadNumber::value)))))))

    (function create skip-name
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-size (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload length ReadNumber)
            (call advance (field (local length) ReadNumber::cursor) (field (local length) ReadNumber::value))))))

    (function create take-fields-from
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns ReadStep)
      (body
        (if
          (call equal (local count) (i64 0))
          (variant ReadStep::ready (local cursor))
          (match
            (call skip-name (local cursor))
            (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
            (arm ReadStep::ready
              (payload named Cursor)
              (match
                (call take-child (local named))
                (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
                (arm ReadStep::ready
                  (payload next Cursor)
                  (call take-fields-from (local next) (call sub (local count) (i64 1))))))))))

    (function create take-fields
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-size (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload count ReadNumber)
            (if
              (call less
                (call divide
                  (call sub
                    (field (field (local count) ReadNumber::cursor) Cursor::end)
                    (field (field (local count) ReadNumber::cursor) Cursor::at))
                  (i64 34))
                (field (local count) ReadNumber::value))
              (variant ReadStep::error
                (call error (field (local cursor) Cursor::at) (text "field count exceeds remaining type image")))
              (call take-fields-from (field (local count) ReadNumber::cursor) (field (local count) ReadNumber::value)))))))

    (function create skip-scope
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-byte (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload scope ReadNumber)
            (if
              (call equal (field (local scope) ReadNumber::value) (i64 0))
              (match
                (call take-byte (field (local scope) ReadNumber::cursor))
                (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
                (arm NumberResult::ready
                  (payload binder ReadNumber)
                  (if
                    (call equal (field (local binder) ReadNumber::value) (i64 0))
                    (call skip-ids
                      (field (local binder) ReadNumber::cursor)
                      (list I64 (i64 18) (i64 3) (i64 24))
                      (i64 0))
                    (if
                      (call equal (field (local binder) ReadNumber::value) (i64 1))
                      (call skip-ids
                        (field (local binder) ReadNumber::cursor)
                        (list I64 (i64 18) (i64 3) (i64 21) (i64 24))
                        (i64 0))
                      (if
                        (call less (field (local binder) ReadNumber::value) (i64 4))
                        (call skip-ids
                          (field (local binder) ReadNumber::cursor)
                          (list I64 (i64 18) (i64 3) (i64 23) (i64 24))
                          (i64 0))
                        (variant ReadStep::error
                          (call error
                            (field (field (local scope) ReadNumber::cursor) Cursor::at)
                            (text "invalid read scope binder"))))))))
              (if
                (call equal (field (local scope) ReadNumber::value) (i64 1))
                (call skip-ids (field (local scope) ReadNumber::cursor) (list I64 (i64 18) (i64 3) (i64 8)) (i64 0))
                (variant ReadStep::error
                  (call error (field (local cursor) Cursor::at) (text "invalid read scope argument")))))))))

    (function create skip-region-mode
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-byte (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload mode ReadNumber)
            (if
              (call equal (field (local mode) ReadNumber::value) (i64 1))
              (call skip-scope (field (local mode) ReadNumber::cursor))
              (if
                (call less (field (local mode) ReadNumber::value) (i64 4))
                (variant ReadStep::ready (field (local mode) ReadNumber::cursor))
                (variant ReadStep::error
                  (call error (field (local cursor) Cursor::at) (text "invalid region capability mode")))))))))

    (function create skip-requirements
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns ReadStep)
      (body
        (if
          (call equal (local count) (i64 0))
          (variant ReadStep::ready (local cursor))
          (match
            (call take-byte (local cursor))
            (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
            (arm NumberResult::ready
              (payload operand ReadNumber)
              (match
                (if
                  (call equal (field (local operand) ReadNumber::value) (i64 0))
                  (call skip-ids (field (local operand) ReadNumber::cursor) (list I64 (i64 18) (i64 10)) (i64 0))
                  (if
                    (call equal (field (local operand) ReadNumber::value) (i64 1))
                    (call skip-ids (field (local operand) ReadNumber::cursor) (list I64 (i64 18) (i64 20)) (i64 0))
                    (variant ReadStep::error
                      (call error (field (local cursor) Cursor::at) (text "invalid requirement operand")))))
                (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
                (arm ReadStep::ready
                  (payload next Cursor)
                  (call skip-requirements (local next) (call sub (local count) (i64 1))))))))))

    (function create skip-effect-parameters
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create count (type I64))
      (returns ReadStep)
      (body
        (if
          (call equal (local count) (i64 0))
          (variant ReadStep::ready (local cursor))
          (match
            (call skip-ids (local cursor) (list I64 (i64 18) (i64 19)) (i64 0))
            (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
            (arm ReadStep::ready
              (payload next Cursor)
              (call skip-effect-parameters (local next) (call sub (local count) (i64 1))))))))

    (function create skip-effects
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (call take-size (local cursor))
          (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm NumberResult::ready
            (payload requirements ReadNumber)
            (if
              (call less
                (call divide
                  (call sub
                    (field (field (local requirements) ReadNumber::cursor) Cursor::end)
                    (field (field (local requirements) ReadNumber::cursor) Cursor::at))
                  (i64 35))
                (field (local requirements) ReadNumber::value))
              (variant ReadStep::error
                (call error (field (local cursor) Cursor::at) (text "requirement count exceeds remaining type image")))
              (match
                (call skip-requirements
                  (field (local requirements) ReadNumber::cursor)
                  (field (local requirements) ReadNumber::value))
                (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
                (arm ReadStep::ready
                  (payload required Cursor)
                  (match
                    (call take-size (local required))
                    (arm NumberResult::error (payload problem ReadError) (variant ReadStep::error (local problem)))
                    (arm NumberResult::ready
                      (payload parameters ReadNumber)
                      (if
                        (call less
                          (call divide
                            (call sub
                              (field (field (local parameters) ReadNumber::cursor) Cursor::end)
                              (field (field (local parameters) ReadNumber::cursor) Cursor::at))
                            (i64 34))
                          (field (local parameters) ReadNumber::value))
                        (variant ReadStep::error
                          (call error
                            (field (local required) Cursor::at)
                            (text "effect parameter count exceeds remaining type image")))
                        (call skip-effect-parameters
                          (field (local parameters) ReadNumber::cursor)
                          (field (local parameters) ReadNumber::value))))))))))))

    (function create function-body
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create task (type Bool))
      (returns ReadStep)
      (body
        (match
          (call take-array (local cursor))
          (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm ReadStep::ready
            (payload parameters Cursor)
            (match
              (call take-child (local parameters))
              (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
              (arm ReadStep::ready
                (payload result Cursor)
                (if (local task) (call skip-effects (local result)) (variant ReadStep::ready (local result)))))))))

    (function create applied-body
      (visibility private)
      (effect pure)
      (parameter create cursor (type Cursor))
      (parameter create scoped (type Bool))
      (returns ReadStep)
      (body
        (match
          (call skip-ids (local cursor) (list I64 (i64 18) (i64 3)) (i64 0))
          (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
          (arm ReadStep::ready
            (payload declaration Cursor)
            (match
              (call take-array (local declaration))
              (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
              (arm ReadStep::ready
                (payload arguments Cursor)
                (if (local scoped) (call skip-scope (local arguments)) (variant ReadStep::ready (local arguments)))))))))

    (function create read-body
      (visibility private)
      (effect pure)
      (parameter create kind (type TypeKind))
      (parameter create cursor (type Cursor))
      (returns ReadStep)
      (body
        (match
          (local kind)
          (arm TypeKind::unit (variant ReadStep::ready (local cursor)))
          (arm TypeKind::bool (variant ReadStep::ready (local cursor)))
          (arm TypeKind::i64 (variant ReadStep::ready (local cursor)))
          (arm TypeKind::bytes (variant ReadStep::ready (local cursor)))
          (arm TypeKind::text (variant ReadStep::ready (local cursor)))
          (arm TypeKind::static-text (variant ReadStep::ready (local cursor)))
          (arm TypeKind::secret (variant ReadStep::ready (local cursor)))
          (arm TypeKind::type-parameter (call skip-ids (local cursor) (list I64 (i64 17)) (i64 0)))
          (arm TypeKind::named (call skip-ids (local cursor) (list I64 (i64 18) (i64 3)) (i64 0)))
          (arm TypeKind::capability-resource (call skip-ids (local cursor) (list I64 (i64 18) (i64 3)) (i64 0)))
          (arm TypeKind::structural-record (call take-fields (local cursor)))
          (arm TypeKind::list (call take-child (local cursor)))
          (arm TypeKind::map (call take-children (local cursor) (i64 2)))
          (arm TypeKind::option (call take-child (local cursor)))
          (arm TypeKind::result (call take-children (local cursor) (i64 2)))
          (arm TypeKind::stream (call take-child (local cursor)))
          (arm TypeKind::function (call function-body (local cursor) (bool false)))
          (arm TypeKind::applied (call applied-body (local cursor) (bool false)))
          (arm TypeKind::task-function (call function-body (local cursor) (bool true)))
          (arm TypeKind::f64 (variant ReadStep::ready (local cursor)))
          (arm TypeKind::byte-buffer (variant ReadStep::ready (local cursor)))
          (arm TypeKind::owned-i64-cell (variant ReadStep::ready (local cursor)))
          (arm TypeKind::owned-product (call take-fields (local cursor)))
          (arm TypeKind::owned-choice (call take-fields (local cursor)))
          (arm TypeKind::owned-sequence (call take-child (local cursor)))
          (arm TypeKind::associated-contract-member
            (call skip-ids (local cursor) (list I64 (i64 18) (i64 3) (i64 23)) (i64 0)))
          (arm TypeKind::associated-witness-projection
            (call skip-ids (local cursor) (list I64 (i64 18) (i64 3) (i64 22) (i64 18) (i64 3) (i64 23)) (i64 0)))
          (arm TypeKind::read-view-applied (call applied-body (local cursor) (bool true)))
          (arm TypeKind::associated-read-view-member
            (match
              (call skip-ids (local cursor) (list I64 (i64 18) (i64 3) (i64 23)) (i64 0))
              (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
              (arm ReadStep::ready (payload member Cursor) (call skip-scope (local member)))))
          (arm TypeKind::associated-read-view-projection
            (match
              (call skip-ids (local cursor) (list I64 (i64 18) (i64 3) (i64 22) (i64 18) (i64 3) (i64 23)) (i64 0))
              (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
              (arm ReadStep::ready (payload projection Cursor) (call skip-scope (local projection)))))
          (arm TypeKind::region-brand (call skip-ids (local cursor) (list I64 (i64 18) (i64 3) (i64 8)) (i64 0)))
          (arm TypeKind::region (call take-child (local cursor)))
          (arm TypeKind::rel-ptr (call take-children (local cursor) (i64 2)))
          (arm TypeKind::region-slice (call take-children (local cursor) (i64 2)))
          (arm TypeKind::region-cap
            (match
              (call take-child (local cursor))
              (arm ReadStep::error (payload problem ReadError) (variant ReadStep::error (local problem)))
              (arm ReadStep::ready (payload region Cursor) (call skip-region-mode (local region))))))))

    (function create decode-image
      (visibility public)
      (effect pure)
      (parameter create image (type Bytes))
      (returns ShapeResult)
      (body
        (if
          (call fits (local image) (i64 0) (i64 52))
          (if
            (call same (call slice (local image) (i64 0) (i64 8)) (call text-bytes (text "LKJTYPES")))
            (if
              (call equal (call octet (local image) (i64 8)) (i64 1))
              (if
                (call equal (call octet (local image) (i64 9)) (i64 0))
                (if
                  (call equal (call read-word (local image) (i64 10)) (call sub (call length (local image)) (i64 50)))
                  (if
                    (call equal (call octet (local image) (i64 18)) (i64 1))
                    (if
                      (call less (call octet (local image) (i64 19)) (i64 35))
                      (let
                        (binding kind
                          (call item
                            (types TypeKind)
                            (list TypeKind
                              (variant TypeKind::unit)
                              (variant TypeKind::bool)
                              (variant TypeKind::i64)
                              (variant TypeKind::bytes)
                              (variant TypeKind::text)
                              (variant TypeKind::static-text)
                              (variant TypeKind::secret)
                              (variant TypeKind::type-parameter)
                              (variant TypeKind::named)
                              (variant TypeKind::capability-resource)
                              (variant TypeKind::structural-record)
                              (variant TypeKind::list)
                              (variant TypeKind::map)
                              (variant TypeKind::option)
                              (variant TypeKind::result)
                              (variant TypeKind::stream)
                              (variant TypeKind::function)
                              (variant TypeKind::applied)
                              (variant TypeKind::task-function)
                              (variant TypeKind::f64)
                              (variant TypeKind::byte-buffer)
                              (variant TypeKind::owned-i64-cell)
                              (variant TypeKind::owned-product)
                              (variant TypeKind::owned-choice)
                              (variant TypeKind::owned-sequence)
                              (variant TypeKind::associated-contract-member)
                              (variant TypeKind::associated-witness-projection)
                              (variant TypeKind::read-view-applied)
                              (variant TypeKind::associated-read-view-member)
                              (variant TypeKind::associated-read-view-projection)
                              (variant TypeKind::region-brand)
                              (variant TypeKind::region)
                              (variant TypeKind::rel-ptr)
                              (variant TypeKind::region-slice)
                              (variant TypeKind::region-cap))
                            (call octet (local image) (i64 19))))
                        (binding cursor
                          (record Cursor
                            (field Cursor::data (local image))
                            (field Cursor::at (i64 20))
                            (field Cursor::end (call sub (call length (local image)) (i64 32)))
                            (field Cursor::children (list Bytes))))
                        (in
                          (match
                            (call read-body (local kind) (local cursor))
                            (arm ReadStep::error
                              (payload problem ReadError)
                              (variant ShapeResult::error (local problem)))
                            (arm ReadStep::ready
                              (payload complete Cursor)
                              (if
                                (call equal (field (local complete) Cursor::at) (field (local complete) Cursor::end))
                                (variant ShapeResult::ready
                                  (record TypeShape
                                    (field TypeShape::kind (local kind))
                                    (field TypeShape::children (field (local complete) Cursor::children))))
                                (variant ShapeResult::error
                                  (call error (field (local complete) Cursor::at) (text "trailing type payload"))))))))
                      (variant ShapeResult::error (call error (i64 19) (text "unknown type constructor"))))
                    (variant ShapeResult::error (call error (i64 18) (text "unsupported type contract version"))))
                  (variant ShapeResult::error (call error (i64 10) (text "type payload length differs from image"))))
                (variant ShapeResult::error (call error (i64 8) (text "unsupported type envelope epoch"))))
              (variant ShapeResult::error (call error (i64 8) (text "unsupported type envelope epoch"))))
            (variant ShapeResult::error (call error (i64 0) (text "invalid type envelope magic"))))
          (variant ShapeResult::error (call error (i64 0) (text "truncated type image"))))))))
declarations.end

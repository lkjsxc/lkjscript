              (field pool (field (local signature) (name pool)))
              (field slots (field (local signature) (name slots)))
              (field locals (field (local signature) (name count)))
              (field pc (i64 0))
              (field fragment (call ci::text-bytes (text "")))))
          (binding out (type ByteBuffer) (call ci::empty))
          (in
            (call walk (local graph) (local parents) (local mapping) (local root) (local initial) (local out))))))))
declarations.end

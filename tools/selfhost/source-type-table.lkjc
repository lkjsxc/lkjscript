declarations.begin
(units (module create source-type-table
  (function create count (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (returns I64)
    (body (call ci::u32 (local graph) (i64 16))))
  (function create data (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns Bytes)
    (body (call source-table::data (local graph)
      (call ci::add (call source-table::count (local graph)) (local row)))))
  (function create lookup (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create value (type Bytes))
    (parameter create at (type I64)) (returns I64)
    (body (call source-index::lookup (local graph) (call ci::u32 (local graph) (i64 84))
      (call count (local graph)) (i64 32) (i64 32)
      (call ci::slice (local value) (call ci::add (local at) (i64 1))
        (call ci::add (local at) (i64 33))))))
  (function create append-items (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create value (type Bytes))
    (parameter create at (type I64)) (parameter create remaining (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call ci::eq (local remaining) (i64 0)) (local out)
      (let (binding next (type ByteBuffer)
        (call ci::le (call lookup (local graph) (local value) (local at)) (i64 4) (local out)))
        (in (call append-items (local graph) (local value) (call ci::add (local at) (i64 33))
          (call ci::sub (local remaining) (i64 1)) (local next)))))))
  (function create append-array (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create value (type Bytes))
    (parameter create at (type I64)) (parameter create extra (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let (binding array (call source-table::array (local value) (local at)))
      (in (call append-items (local graph) (local value) (field (local array) (name next))
        (call ci::add (field (local array) (name value)) (local extra)) (local out))))))
  (function create append-fields (visibility private) (effect pure)
    (parameter create graph (type Bytes)) (parameter create value (type Bytes))
    (parameter create at (type I64)) (parameter create remaining (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call ci::eq (local remaining) (i64 0)) (local out)
      (let
        (binding type-at (call source-link-ref::name-end (local value) (local at)))
        (binding next (type ByteBuffer) (call append-items (local graph) (local value)
          (local type-at) (i64 1) (local out)))
        (in (call append-fields (local graph) (local value) (call ci::add (local type-at) (i64 33))
          (call ci::sub (local remaining) (i64 1)) (local next)))))))
  (function create child-count (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns I64)
    (body (let
      (binding value (call data (local graph) (local row)))
      (binding form (call ci::get (local value) (i64 19)))
      (in (if (call ci::eq (local form) (i64 11)) (i64 1)
        (if (call ci::either (call ci::eq (local form) (i64 10))
              (call ci::either (call ci::eq (local form) (i64 16)) (call ci::eq (local form) (i64 17))))
          (let (binding array (call source-table::array (local value)
            (if (call ci::eq (local form) (i64 17)) (i64 54) (i64 20))))
            (in (call ci::add (field (local array) (name value))
              (if (call ci::eq (local form) (i64 16)) (i64 1) (i64 0)))))
          (i64 0)))))))
  (function create children (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns Bytes)
    (body (let
      (binding value (call data (local graph) (local row)))
      (binding form (call ci::get (local value) (i64 19)))
      (binding empty (type ByteBuffer) (call ci::empty))
      (binding out (type ByteBuffer)
        (if (call ci::eq (local form) (i64 10))
          (let (binding array (call source-table::array (local value) (i64 20)))
            (in (call append-fields (local graph) (local value)
              (field (local array) (name next)) (field (local array) (name value)) (local empty))))
          (if (call ci::eq (local form) (i64 11))
            (call append-items (local graph) (local value) (i64 20) (i64 1) (local empty))
            (if (call ci::eq (local form) (i64 16))
              (call append-array (local graph) (local value) (i64 20) (i64 1) (local empty))
              (if (call ci::eq (local form) (i64 17))
                (call append-array (local graph) (local value) (i64 54) (i64 0) (local empty))
                (local empty))))))
      (in (call ci::freeze (local out))))))
  (function create contains (visibility package) (effect pure)
    (parameter create values (type Bytes)) (parameter create at (type I64))
    (parameter create wanted (type I64)) (returns Bool)
    (body (if (call ci::eq (local at) (call ci::length (local values))) (bool false)
      (if (call ci::eq (call ci::u32 (local values) (local at)) (local wanted)) (bool true)
        (call contains (local values) (call ci::add (local at) (i64 4)) (local wanted))))))
  (function create push (visibility package) (effect pure)
    (parameter create values (type Bytes)) (parameter create value (type I64)) (returns Bytes)
    (body (let
      (binding empty (type ByteBuffer) (call ci::empty))
      (binding next (type ByteBuffer) (call ci::le (local value) (i64 4) (local empty)))
      (in (call ci::concat (local values) (call ci::freeze (local next)))))))))
declarations.end

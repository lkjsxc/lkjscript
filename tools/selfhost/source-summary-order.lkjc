    (function create group-end
      (visibility package)
      (effect pure)
      (parameter create rows (type Bytes))
      (parameter create width (type I64))
      (parameter create owner (type I64))
      (parameter create at (type I64))
      (returns I64)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local rows)))
          (local at)
          (if
            (call ci::eq (call ci::u64 (local rows) (local at)) (local owner))
            (call source-summary-order::group-end
              (local rows)
              (local width)
              (local owner)
              (call ci::add (local at) (local width)))
            (local at)))))
    (function create directory-loop
      (visibility package)

      (parameter create rows (type Bytes))
      (parameter create width (type I64))
      (parameter create count (type I64))
      (parameter create owner (type I64))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns Bytes)
      (body
        (if
          (call ci::eq (local owner) (local count))
          (call ci::freeze (local out))
          (let
            (binding end
              (call source-summary-order::group-end (local rows) (local width) (local owner) (local at)))
            (in
              (let
                (binding summary-buffer-9
                  (type ByteBuffer)
                  (let
                    (binding summary-buffer-8 (type ByteBuffer) (call ci::le (local at) (i64 8) (local out)))
                    (in (call ci::le (local end) (i64 8) (local summary-buffer-8)))))
                (in
                  (call source-summary-order::directory-loop
                    (local rows)
                    (local width)
                    (local count)
                    (call ci::add (local owner) (i64 1))
                    (local end)

                  (binding aligned (type ByteBuffer) (call ci::pad (local start) (i64 0) (local out)))
                  (binding emitted
                    (type ByteBuffer)
                    (if
                      (call ci::lt (local code) (i64 11))
                      (call primitive (local code) (local aligned))
                      (call objects::primitive (local code) (local aligned))))
                  (in
                    (if
                      (call ci::lt
                        (call ci::add (local start) (i64 512))
                        (call ci::size (local emitted)))
                      (call layout-failure (local emitted))
                      (call builtins (call ci::add (local code) (i64 1)) (local emitted)))))))))))))
declarations.end

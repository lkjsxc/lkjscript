          (field finite (bool false))
          (field high (i64 0))
          (field low (i64 0))
          (field observed-high (i64 0))
          (field observed-low (i64 0))
          (field saturated (bool false)))))
    (function create finite-words
      (visibility public)
      (effect pure)
      (parameter create high (type I64))
      (parameter create low (type I64))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::both
            (call ci::both
              (call ci::lt (i64 -1) (local high))
              (call ci::lt (local high) (i64 4294967296)))
            (call ci::both (call ci::lt (i64 -1) (local low)) (call ci::lt (local low) (i64 4294967296))))
          (record structural
            (field code (i64 0))
            (field finite (bool true))
            (field high (local high))
            (field low (local low))
            (field observed-high (i64 0))
            (field observed-low (i64 0))
            (field saturated (bool false)))
          (call fail (call unbounded) (i64 6)))))
    (function create finite
      (visibility public)
      (effect pure)
      (parameter create amount (type I64))
      (returns

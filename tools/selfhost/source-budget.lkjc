    (function create insufficient
      (visibility public)
      (effect pure)
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (parameter create amount (type I64))
      (returns Bool)
      (body
        (if
          (call ci::either (call failed (local work)) (call ci::lt (local amount) (i64 0)))
          (bool true)
          (if
            (field (local work) (name finite))
            (let
              (binding high (call ci::div (local amount) (i64 4294967296)))
              (binding low (call ci::sub (local amount) (call ci::mul (local high) (i64 4294967296))))
              (in
                (if
                  (call ci::lt (field (local work) (name high)) (local high))
                  (bool true)
                  (if
                    (call ci::eq (field (local work) (name high)) (local high))
                    (call ci::lt (field (local work) (name low)) (local low))
                    (bool false)))))
            (bool false)))))
    (function create charge
      (visibility public)
      (effect pure)
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (parameter create amount (type I64))

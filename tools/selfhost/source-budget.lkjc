declarations.begin
(units
  (module create source-budget
    (function create unbounded
      (visibility public)
      (effect pure)
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body

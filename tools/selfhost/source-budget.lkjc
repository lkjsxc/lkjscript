          (let
            (binding high (call ci::div (local amount) (i64 4294967296)))
            (binding low (call ci::sub (local amount) (call ci::mul (local high) (i64 4294967296))))
            (binding borrow
              (if (call ci::lt (field (local work) (name low)) (local low)) (i64 1) (i64 0)))
            (binding observed-low (call ci::add (field (local work) (name observed-low)) (local low)))
            (binding carry (call ci::div (local observed-low) (i64 4294967296)))
            (binding observed-high
              (call ci::add
                (field (local work) (name observed-high))
                (call ci::add (local high) (local carry))))
            (binding saturated
              (call ci::either
                (field (local work) (name saturated))
                (call ci::lt (i64 4294967295) (local observed-high))))
            (in
              (record structural
                (field code (i64 0))
                (field finite (field (local work) (name finite)))
                (field high
                  (if
                    (field (local work) (name finite))
                    (call ci::sub
                      (call ci::sub (field (local work) (name high)) (local high))
                      (local borrow))
                    (i64 0)))
                (field low
                  (if
                    (field (local work) (name finite))
                    (call ci::add
                      (call ci::sub (field (local work) (name low)) (local low))
                      (call ci::mul (local borrow) (i64 4294967296)))
                    (i64 0)))
                (field observed-high (if (local saturated) (i64 4294967295) (local observed-high)))
                (field observed-low
                  (if
                    (local saturated)
                    (i64 4294967295)
                    (call ci::sub (local observed-low) (call ci::mul (local carry) (i64 4294967296)))))
                (field saturated (local saturated))))))))
    (function create from-carrier
      (visibility public)

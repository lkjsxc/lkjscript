declarations.begin
(units
  (module create source-unit-lower-nominal
    (function create member
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create owner (type I64))
      (parameter create kind (type I64))
      (parameter create pool (type Bytes))
      (returns (record (code I64) (pool Bytes) (member I64) (presence I64) (type I64)))
      (body
        (let
          (binding domain (if (call ci::eq (local kind) (i64 2)) (i64 4) (i64 5)))
          (binding wanted (if (call ci::eq (local kind) (i64 2)) (i64 12) (i64 13)))
          (binding checked
            (call source-link-ref::owner-ref
              (local graph)
              (local data)
              (local at)
              (local domain)
              (local wanted)))
          (in
            (if
              (call ci::lt (local checked) (i64 0))
              (record structural
                (field code (call ci::sub (i64 0) (local checked)))
                (field pool (call ci::text-bytes (text "")))
                (field member (i64 0))
                (field presence (i64 0))
                (field type (i64 0)))
              (let
                (binding row
                  (call source-table::owner (local graph) (local data) (local at) (local domain)))
                (binding value (call source-table::data (local graph) (local row)))
                (binding parent-check
                  (call source-link-ref::owner-ref
                    (local graph)
                    (local value)
                    (i64 39)
                    (i64 2)
                    (local kind)))
                (in
                  (if
                    (call ci::lt (local parent-check) (i64 0))
                    (record structural
                      (field code (call ci::sub (i64 0) (local parent-check)))
                      (field pool (call ci::text-bytes (text "")))
                      (field member (i64 0))
                      (field presence (i64 0))
                      (field type (i64 0)))
                    (if
                      (call ci::eq
                        (call source-table::owner (local graph) (local value) (i64 39) (i64 2))
                        (local owner))
                      (let
                        (binding end (call source-link-ref::name-end (local value) (i64 56)))
                        (in
                          (if
                            (call ci::lt (local end) (i64 0))
                            (record structural
                              (field code (i64 12))
                              (field pool (call ci::text-bytes (text "")))
                              (field member (i64 0))
                              (field presence (i64 0))
                              (field type (i64 0)))
                            (let
                              (binding presence
                                (if
                                  (call ci::eq (local kind) (i64 2))
                                  (i64 1)
                                  (call ci::get (local value) (local end))))
                              (binding type-at
                                (if
                                  (call ci::eq (local kind) (i64 2))
                                  (local end)
                                  (call ci::add (local end) (i64 1))))
                              (binding type-check
                                (if
                                  (call ci::eq (local presence) (i64 1))
                                  (call source-link-ref::type-ref
                                    (local graph)
                                    (local value)
                                    (local type-at))
                                  (local type-at)))
                              (in
                                (if
                                  (call ci::either
                                    (call ci::eq (local presence) (i64 0))
                                    (call ci::either
                                      (call ci::eq (local presence) (i64 1))
                                      (bool false)))
                                  (if
                                    (call ci::lt (local type-check) (i64 0))
                                    (record structural
                                      (field code (call ci::sub (i64 0) (local type-check)))
                                      (field pool (call ci::text-bytes (text "")))
                                      (field member (i64 0))
                                      (field presence (i64 0))
                                      (field type (i64 0)))
                                    (let
                                      (binding member
                                        (call source-unit-tables::intern
                                          (local pool)
                                          (call ci::sub (local kind) (i64 1))
                                          (call source-unit-tables::local-ref (local graph) (local row))
                                          (i64 0)
                                          (i64 32)))
                                      (in
                                        (if
                                          (call ci::eq (field (local member) (name code)) (i64 0))
                                          (let
                                            (binding type
                                              (if
                                                (call ci::eq (local presence) (i64 1))
                                                (call source-unit-tables::type
                                                  (field (local member) (name pool))
                                                  (local value)
                                                  (local type-at))
                                                (record structural
                                                  (field code (i64 0))
                                                  (field index (i64 0))
                                                  (field pool (field (local member) (name pool))))))
                                            (in
                                              (if
                                                (call ci::eq (field (local type) (name code)) (i64 0))
                                                (record structural
                                                  (field code (i64 0))
                                                  (field pool (field (local type) (name pool)))
                                                  (field member (field (local member) (name index)))
                                                  (field presence (local presence))
                                                  (field type (field (local type) (name index))))
                                                (record structural
                                                  (field code (field (local type) (name code)))
                                                  (field pool (call ci::text-bytes (text "")))
                                                  (field member (i64 0))
                                                  (field presence (i64 0))
                                                  (field type (i64 0))))))
                                          (record structural
                                            (field code (field (local member) (name code)))
                                            (field pool (call ci::text-bytes (text "")))
                                            (field member (i64 0))
                                            (field presence (i64 0))
                                            (field type (i64 0)))))))
                                  (record structural
                                    (field code (i64 12))
                                    (field pool (call ci::text-bytes (text "")))
                                    (field member (i64 0))
                                    (field presence (i64 0))
                                    (field type (i64 0)))))))))
                      (record structural
                        (field code (i64 15))
                        (field pool (call ci::text-bytes (text "")))
                        (field member (i64 0))
                        (field presence (i64 0))
                        (field type (i64 0))))))))))))
    (function create abort
      (visibility private)
      (effect pure)
      (parameter create code (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (pool Bytes) (rows Bytes)))
      (body
        (let
          (binding discarded (call ci::discard (local out)))
          (in
            (record structural
              (field code (local code))
              (field pool (call ci::text-bytes (text "")))
              (field rows (call ci::text-bytes (text ""))))))))
    (function create members
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create left (type I64))
      (parameter create owner (type I64))
      (parameter create kind (type I64))
      (parameter create pool (type Bytes))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (pool Bytes) (rows Bytes)))
      (body
        (if
          (call ci::eq (local left) (i64 0))
          (record structural
            (field code (i64 0))
            (field pool (local pool))
            (field rows (call ci::freeze (local out))))
          (let
            (binding item
              (call member
                (local graph)
                (local data)
                (local at)
                (local owner)
                (local kind)
                (local pool)))
            (in
              (if
                (call ci::eq (field (local item) (name code)) (i64 0))
                (if
                  (call source-unit-tables::room
                    (call ci::size (local out))
                    (if (call ci::eq (local kind) (i64 2)) (i64 16) (i64 24)))
                  (let
                    (binding a
                      (type ByteBuffer)
                      (call ci::le (field (local item) (name member)) (i64 8) (local out)))
                    (binding b
                      (type ByteBuffer)
                      (if
                        (call ci::eq (local kind) (i64 3))
                        (call ci::le (field (local item) (name presence)) (i64 8) (local a))
                        (local a)))
                    (binding c
                      (type ByteBuffer)
                      (call ci::le (field (local item) (name type)) (i64 8) (local b)))
                    (in
                      (call members
                        (local graph)
                        (local data)
                        (call ci::add (local at) (i64 17))
                        (call ci::sub (local left) (i64 1))
                        (local owner)
                        (local kind)
                        (field (local item) (name pool))
                        (local c))))
                  (call abort (i64 3) (local out)))
                (call abort (field (local item) (name code)) (local out))))))))
    (function create assemble
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create owner (type I64))
      (parameter create kind (type I64))
      (parameter create count (type I64))
      (parameter create parts (type (record (code I64) (pool Bytes) (rows Bytes))))
      (returns (record (code I64) (descriptor Bytes)))
      (body
        (if
          (call ci::eq (field (local parts) (name code)) (i64 0))
          (let
            (binding tables (call source-unit-tables::project (field (local parts) (name pool))))
            (binding base
              (call source-unit-tables::add
                (i64 272)
                (call ci::length (field (local tables) (name bytes)))))
            (binding start (call source-unit-tables::add (local base) (i64 16)))
            (binding end
              (call source-unit-tables::add
                (local start)
                (call ci::length (field (local parts) (name rows)))))
            (in
              (if
                (call ci::both
                  (call ci::eq (field (local tables) (name code)) (i64 0))
                  (call ci::lte (i64 0) (local end)))
                (let
                  (binding a (type ByteBuffer) (call ci::empty))
                  (binding b (type ByteBuffer) (call ci::le (local start) (i64 8) (local a)))
                  (binding c (type ByteBuffer) (call ci::le (local count) (i64 8) (local b)))
                  (binding d
                    (type ByteBuffer)
                    (call wire::range
                      (field (local parts) (name rows))
                      (i64 0)
                      (call ci::length (field (local parts) (name rows)))
                      (local c)))
                  (binding payload (call ci::freeze (local d)))
                  (in
                    (call source-unit-lower::assemble
                      (local graph)
                      (local owner)
                      (field (local tables) (name bytes))
                      (call ci::text-bytes (text ""))
                      (local payload)
                      (call ci::add (local kind) (i64 1)))))
                (record structural
                  (field code (i64 3))
                  (field descriptor (call ci::text-bytes (text "")))))))
          (record structural
            (field code (field (local parts) (name code)))
            (field descriptor (call ci::text-bytes (text "")))))))
    (function create prepare
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create owner (type I64))
      (returns (record (code I64) (descriptor Bytes)))
      (body
        (let
          (binding kind (call source-table::kind (local graph) (local owner)))
          (binding data (call source-table::data (local graph) (local owner)))
          (binding name-end (call source-link-ref::name-end (local data) (i64 56)))
          (in
            (if
              (call ci::lt (local name-end) (i64 0))
              (record structural
                (field code (i64 12))
                (field descriptor (call ci::text-bytes (text ""))))
              (let
                (binding parameters
                  (call source-table::array (local data) (call ci::add (local name-end) (i64 2))))
                (in
                  (if
                    (call ci::either
                      (call ci::eq (local kind) (i64 2))
                      (call ci::either (call ci::eq (local kind) (i64 3)) (bool false)))
                    (if
                      (call ci::eq (field (local parameters) (name value)) (i64 0))
                      (let
                        (binding items
                          (call source-table::array (local data) (field (local parameters) (name next))))
                        (binding out (type ByteBuffer) (call ci::empty))
                        (binding parts
                          (call members
                            (local graph)
                            (local data)
                            (field (local items) (name next))
                            (field (local items) (name value))
                            (local owner)
                            (local kind)
                            (call ci::text-bytes (text ""))
                            (local out)))
                        (in
                          (call assemble
                            (local graph)
                            (local owner)
                            (local kind)
                            (field (local items) (name value))
                            (local parts))))
                      (record structural
                        (field code (i64 13))
                        (field descriptor (call ci::text-bytes (text "")))))
                    (record structural
                      (field code (i64 13))
                      (field descriptor (call ci::text-bytes (text ""))))))))))))))

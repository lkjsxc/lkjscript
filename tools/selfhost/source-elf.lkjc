declarations.begin
(units
  (module create source-elf
    (function create failure
      (visibility private)
      (effect pure)
      (parameter create code (type I64))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (record structural (field diagnostic (local code)) (field image (call ci::text-bytes (text ""))))))
    (function create compile-carrier
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create selector (type Bytes))
      (parameter create mode (type I64))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding prepared (call source-scalar::prepare (local graph)))
          (in
            (if
              (call ci::eq (field (local prepared) (name code)) (i64 0))
              (let
                (binding target
                  (call source-table::owner (local graph) (local selector) (i64 0) (i64 12)))
                (in
                  (if
                    (call ci::lt (local target) (i64 0))
                    (call failure (i64 19))
                    (if
                      (call ci::eq (call source-table::kind (local graph) (local target)) (i64 20))
                      (if
                        (call ci::eq (local mode) (i64 0))
                        (let
                          (binding lowered
                            (call
                              source-scalar-emit::lower
                              (local graph)
                              (field (local prepared) (name facts))
                              (field (local prepared) (name parents))
                              (field (local prepared) (name types))
                              (field (local prepared) (name mapping))
                              (field (local prepared) (name custody))
                              (local target)))
                          (in
                            (if
                              (call ci::eq (field (local lowered) (name code)) (i64 0))
                              (call elf::compile-elf (field (local lowered) (name input)))
                              (call failure (field (local lowered) (name code))))))
                        (call
                          source-artifact::compile-admitted
                          (local graph)
                          (field (local prepared) (name facts))
                          (field (local prepared) (name parents))
                          (field (local prepared) (name types))
                          (field (local prepared) (name mapping))
                          (field (local prepared) (name custody))))
                      (call failure (i64 19))))))
              (call failure (field (local prepared) (name code))))))))
    (function create compile
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding request (call source-request::read (local graph)))
          (in
            (if
              (call ci::eq (field (local request) (name code)) (i64 0))
              (call
                compile-carrier
                (field (local request) (name graph))
                (field (local request) (name target))
                (field (local request) (name mode)))
              (call failure (field (local request) (name code))))))))
    (component create compiler
      (visibility public)
      (port create compile
        (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function compile))))
  (target create compile-source-elf
    (component source-elf::compiler)
    (runner command)
    (port source-elf::compiler::compile)))
declarations.end

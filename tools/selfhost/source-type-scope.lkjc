                      (binding left (field (local found) (name work)))
                      (binding scoped
                        (if
                          (call source-budget::failed (local left))
                          (local left)
                          (call owner-effect
                            (local graph)
                            (local rows)
                            (local data)
                            (local row)
                            (field (local found) (name declaration))
                            (local left))))
                      (in
                        (if
                          (call source-budget::failed (local scoped))
                          (local scoped)
                          (call types
                            (local graph)
                            (local rows)
                            (field (local found) (name declaration))
                            (local roots)
                            (i64 0)
                            (call ci::text-bytes (text ""))
                            (local scoped))))))))
              (in

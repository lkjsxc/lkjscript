          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local at) (call ci::length (local pending)))
          (local work)
          (let
            (binding row (call ci::u32 (local pending) (local at)))
            (binding cost (call ci::add (i64 1) (call ci::div (call ci::length (local seen)) (i64 4))))
            (in
              (if

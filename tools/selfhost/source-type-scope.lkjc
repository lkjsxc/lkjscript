              (binding cost (call ci::add (i64 1) (field (local selected) (name count))))
              (binding remaining (call source-budget::charge (local work) (local cost)))
              (binding next
                (if
                  (call source-budget::failed (local remaining))
                  (call source-budget::fail (local remaining) (i64 6))

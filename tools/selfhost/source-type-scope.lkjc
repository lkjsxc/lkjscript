                            (call ci::eq
                              (call source-table::parent
                                (local rows)
                                (call source-table::owner (local graph) (local data) (i64 20) (i64 3)))
                              (local declaration))
                            (bool true)))
                        (binding left
                          (if
                            (local scoped)

              (finite Bool)
              (high I64)
              (low I64)
              (observed-high I64)
              (observed-low I64)
              (saturated Bool)))))
      (body
        (if
          (call source-budget::insufficient (local work) (i64 1))
          (record structural
            (field declaration (local row))
            (field work (call source-budget::fail (local work) (i64 6))))
          (if
            (call ci::eq (local row) (call source-table::count (local graph)))

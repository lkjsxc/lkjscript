                  (record structural
                    (field declaration (local row))
                    (field work (call source-budget::charge (local work) (i64 1))))
                  (call context
                    (local graph)
                    (local rows)
                    (call source-table::parent (local rows) (local row))
                    (call source-budget::charge (local work) (i64 1))))))))))
    (function create types
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create rows (type Bytes))
      (parameter create declaration (type I64))
      (parameter create pending (type Bytes))
      (parameter create at (type I64))
      (parameter create seen (type Bytes))
      (parameter create work
        (type

          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local row) (call source-table::count (local graph)))
          (local work)
          (if

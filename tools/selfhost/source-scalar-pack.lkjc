declarations.begin
(units
  (module create source-scalar-pack
    (function create node-capacity
      (visibility package)
      (effect pure)
      (parameter create function-count (type I64))
      (returns I64)
      (body
        (if
          (call ci::both
            (call ci::lt (i64 0) (local function-count))
            (call ci::lt (local function-count) (i64 115292150460684693)))
          (call ci::div
            (call ci::sub (i64 9223372036854775423) (call ci::mul (local function-count) (i64 80)))
            (i64 64))
          (i64 -1))))
    (function create failure
      (visibility private)
      (effect pure)
      (returns (record (code I64) (input Bytes)))
      (body (record structural (field code (i64 13)) (field input (call ci::text-bytes (text ""))))))
    (function create words
      (visibility private)
      (effect pure)
      (parameter create values (type (list I64)))
      (parameter create index (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local index) (call ci::list-size (types I64) (local values)))
          (local out)
          (let
            (binding next
              (type ByteBuffer)
              (call ci::le
                (call ci::list-get (types I64) (local values) (local index))
                (i64 8)
                (local out)))
            (in (call words (local values) (call ci::add (local index) (i64 1)) (local next)))))))
    (function create signed
      (visibility package)
      (effect pure)
      (parameter create value (type I64))
      (returns Bytes)
      (body
        (let
          (binding negative (call ci::lt (local value) (i64 0)))
          (binding magnitude (if (local negative) (call ci::sub (i64 -1) (local value)) (local value)))
          (binding high (call ci::div (local magnitude) (i64 4294967296)))
          (binding low (call ci::sub (local magnitude) (call ci::mul (local high) (i64 4294967296))))
          (binding lower (if (local negative) (call ci::sub (i64 4294967295) (local low)) (local low)))
          (binding upper (if (local negative) (call ci::sub (i64 4294967295) (local high)) (local high)))
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b (type ByteBuffer) (call ci::le (local lower) (i64 4) (local a)))
          (binding c (type ByteBuffer) (call ci::le (local upper) (i64 4) (local b)))
          (in (call ci::freeze (local c))))))
    (function create prefix
      (visibility private)
      (effect pure)
      (parameter create length (type I64))
      (parameter create function-count (type I64))
      (returns Bytes)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b
            (type ByteBuffer)
            (call ci::append (call ci::text-bytes (text "LKJCI001")) (i64 0) (local a)))
          (binding c (type ByteBuffer) (call ci::le (i64 6) (i64 4) (local b)))
          (binding d (type ByteBuffer) (call ci::le (i64 0) (i64 4) (local c)))
          (binding e (type ByteBuffer) (call ci::le (local length) (i64 8) (local d)))
          (binding f (type ByteBuffer) (call ci::le (local function-count) (i64 8) (local e)))
          (binding g (type ByteBuffer) (call ci::le (i64 0) (i64 8) (local f)))
          (in (call ci::freeze (local g))))))
    (function create body
      (visibility private)
      (effect pure)
      (parameter create functions (type Bytes))
      (parameter create nodes (type Bytes))
      (parameter create blob (type Bytes))
      (parameter create function-count (type I64))
      (parameter create node-count (type I64))
      (parameter create node-offset (type I64))
      (parameter create blob-offset (type I64))
      (parameter create entry (type I64))
      (returns Bytes)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b
            (type ByteBuffer)
            (call words
              (list I64
                (i64 160)
                (i64 7)
                (i64 384)
                (local function-count)
                (local node-offset)
                (i64 0)
                (local node-count)
                (local blob-offset)
                (call ci::length (local blob))
                (local entry)
                (i64 0))
              (i64 0)
              (local a)))
          (binding c
            (type ByteBuffer)
            (call words
              (list I64
                (i64 1)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 2)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 3)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 4)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 5)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 6)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 7)
                (i64 1)
                (i64 0)
                (i64 0))
              (i64 0)
              (local b)))
          (binding d (type ByteBuffer) (call ci::append (local functions) (i64 0) (local c)))
          (binding e (type ByteBuffer) (call ci::append (local nodes) (i64 0) (local d)))
          (binding f (type ByteBuffer) (call ci::append (local blob) (i64 0) (local e)))
          (in (call ci::freeze (local f))))))
    (function create assemble
      (visibility private)
      (effect pure)
      (parameter create functions (type Bytes))
      (parameter create nodes (type Bytes))
      (parameter create blob (type Bytes))
      (parameter create function-count (type I64))
      (parameter create node-count (type I64))
      (parameter create entry (type I64))
      (parameter create node-offset (type I64))
      (parameter create blob-offset (type I64))
      (parameter create length (type I64))
      (returns (record (code I64) (input Bytes)))
      (body
        (let
          (binding head (call prefix (local length) (local function-count)))
          (binding content
            (call body
              (local functions)
              (local nodes)
              (local blob)
              (local function-count)
              (local node-count)
              (local node-offset)
              (local blob-offset)
              (local entry)))
          (binding checksum (call ci::digest (call ci::concat (local head) (local content))))
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b (type ByteBuffer) (call ci::append (local head) (i64 0) (local a)))
          (binding c (type ByteBuffer) (call ci::append (local checksum) (i64 0) (local b)))
          (binding d (type ByteBuffer) (call ci::append (local content) (i64 0) (local c)))
          (in (record structural (field code (i64 0)) (field input (call ci::freeze (local d))))))))
    (function create checked
      (visibility private)
      (effect pure)
      (parameter create functions (type Bytes))
      (parameter create nodes (type Bytes))
      (parameter create blob (type Bytes))
      (parameter create function-count (type I64))
      (parameter create node-count (type I64))
      (parameter create entry (type I64))
      (returns (record (code I64) (input Bytes)))
      (body
        (let
          (binding function-bytes (call ci::length (local functions)))
          (binding node-bytes (call ci::length (local nodes)))
          (binding blob-size (call ci::length (local blob)))
          (in
            (if
              (call ci::eq (call ci::div (local function-bytes) (i64 80)) (local function-count))
              (if
                (call ci::eq (call ci::mul (local function-count) (i64 80)) (local function-bytes))
                (if
                  (call ci::eq (call ci::div (local node-bytes) (i64 64)) (local node-count))
                  (if
                    (call ci::eq (call ci::mul (local node-count) (i64 64)) (local node-bytes))
                    (if
                      (call ci::lt (i64 9223372036854775423) (local function-bytes))
                      (call failure)
                      (let
                        (binding node-offset (call ci::add (i64 384) (local function-bytes)))
                        (in
                          (if
                            (call ci::lt
                              (call ci::sub (i64 9223372036854775807) (local node-offset))
                              (local node-bytes))
                            (call failure)
                            (let
                              (binding blob-offset (call ci::add (local node-offset) (local node-bytes)))
                              (in
                                (if
                                  (call ci::lt
                                    (call ci::sub (i64 9223372036854775807) (local blob-offset))
                                    (local blob-size))
                                  (call failure)
                                  (call assemble
                                    (local functions)
                                    (local nodes)
                                    (local blob)
                                    (local function-count)
                                    (local node-count)
                                    (local entry)
                                    (local node-offset)
                                    (local blob-offset)
                                    (call ci::add (local blob-offset) (local blob-size))))))))))
                    (call failure))
                  (call failure))
                (call failure))
              (call failure))))))
    (function create encode
      (visibility package)
      (effect pure)
      (parameter create functions (type Bytes))
      (parameter create nodes (type Bytes))
      (parameter create blob (type Bytes))
      (parameter create function-count (type I64))
      (parameter create node-count (type I64))
      (parameter create entry (type I64))
      (returns (record (code I64) (input Bytes)))
      (body
        (if
          (call ci::both
            (call ci::lt (i64 0) (local function-count))
            (call ci::lt (i64 0) (local node-count)))
          (if
            (call ci::both
              (call ci::lt (i64 -1) (local entry))
              (call ci::lt (local entry) (local function-count)))
            (call checked
              (local functions)
              (local nodes)
              (local blob)
              (local function-count)
              (local node-count)
              (local entry))
            (call failure))
          (call failure))))
    (function create value-type
      (visibility package)
      (effect pure)
      (parameter create identity (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::le (local identity) (i64 8) (local out)))
          (in (call ci::le (i64 0) (i64 8) (local a))))))))
declarations.end

declarations.begin
(units (module create source-table
  (function create count (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (returns I64)
    (body (call ci::u32 (local graph) (i64 12))))
  (function create data (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns Bytes)
    (body (let
      (binding span (call ci::add (call ci::u32 (local graph) (i64 92)) (call ci::mul (local row) (i64 8))))
      (binding start (call ci::u32 (local graph) (local span)))
      (in (call ci::slice (local graph) (local start)
        (call ci::add (local start) (call ci::u32 (local graph) (call ci::add (local span) (i64 4)))))))))
  (function create kind (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns I64)
    (body (call ci::get (local graph)
      (call ci::add (call ci::u32 (local graph) (i64 80))
        (call ci::add (call ci::mul (local row) (i64 50)) (i64 17))))))
  (function create owner (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create data (type Bytes))
    (parameter create at (type I64)) (parameter create domain (type I64)) (returns I64)
    (body (call source-index::lookup-owner (local graph)
      (call ci::u32 (local graph) (i64 80)) (call count (local graph))
      (local data) (local at) (local domain))))
  (function create array (visibility package) (effect pure)
    (parameter create data (type Bytes)) (parameter create at (type I64))
    (returns (record (code I64) (next I64) (value I64)))
    (body (call source-read::unsigned (local data) (local at)
      (call ci::sub (call ci::length (local data)) (i64 32)))))
  (function create skip (visibility package) (effect pure)
    (parameter create data (type Bytes)) (parameter create at (type I64))
    (parameter create width (type I64)) (returns I64)
    (body (let (binding parsed (call array (local data) (local at)))
      (in (call ci::add (field (local parsed) (name next))
        (call ci::mul (field (local parsed) (name value)) (local width)))))))
  (function create edge (visibility package) (effect pure)
    (parameter create child (type I64)) (parameter create parent (type I64))
    (parameter create position (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let
      (binding a (type ByteBuffer) (call ci::le (local child) (i64 4) (local out)))
      (binding b (type ByteBuffer) (call ci::le (local parent) (i64 4) (local a)))
      (in (call ci::le (local position) (i64 4) (local b))))))
  (function create column (visibility package) (effect pure)
    (parameter create rows (type Bytes)) (parameter create row (type I64))
    (parameter create offset (type I64)) (returns I64)
    (body (call ci::u32 (local rows) (call ci::add
      (call ci::mul (local row) (i64 12)) (local offset)))))
  (function create parent (visibility package) (effect pure)
    (parameter create rows (type Bytes)) (parameter create row (type I64)) (returns I64)
    (body (call column (local rows) (local row) (i64 4))))
  (function create start (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64)) (returns I64)
    (body (call ci::u32 (local graph)
      (call ci::add (call ci::u32 (local graph) (i64 92)) (call ci::mul (local row) (i64 8))))))

  (function create sequence-cursor-failure
    (visibility private)
    (effect pure)
    (parameter create code (type I64))
    (returns (record (code I64) (next I64) (start I64) (length I64)))
    (body
      (record structural
        (field code (local code))
        (field next (i64 0))
        (field start (i64 0))
        (field length (i64 0)))))
  (function create sequence-cursor
    (visibility package)
    (effect pure)
    (parameter create graph (type Bytes))
    (parameter create row (type I64))
    (returns (record (code I64) (next I64) (start I64) (length I64)))
    (body
      (let
        (binding size (call ci::length (local graph)))
        (in
          (if
            (call source-read::range (local graph) (i64 0) (i64 96) (local size))
            (let
              (binding count (call count (local graph)))
              (binding directory (call ci::u32 (local graph) (i64 80)))
              (binding spans (call ci::u32 (local graph) (i64 92)))
              (in
                (if
                  (if
                    (call ci::both (call ci::lt (i64 -1) (local row)) (call ci::lt (local row) (local count)))
                    (if
                      (call source-read::items-fit
                        (local graph)
                        (local directory)
                        (local size)
                        (local count)
                        (i64 50))
                      (call source-read::items-fit
                        (local graph)
                        (local spans)
                        (local size)
                        (local count)
                        (i64 8))
                      (bool false))
                    (bool false))
                  (if
                    (call ci::eq (call kind (local graph) (local row)) (i64 17))
                    (let
                      (binding span (call ci::add (local spans) (call ci::mul (local row) (i64 8))))
                      (binding start (call ci::u32 (local graph) (local span)))
                      (binding length (call ci::u32 (local graph) (call ci::add (local span) (i64 4))))
                      (in
                        (if
                          (if
                            (call ci::lt (i64 49) (local length))
                            (call source-read::range (local graph) (local start) (local length) (local size))
                            (bool false))
                          (let
                            (binding end (call ci::add (local start) (call ci::sub (local length) (i64 32))))
                            (in
                              (if
                                (call source-read::range (local graph) (local start) (i64 38) (local end))
                                (if
                                  (call ci::eq
                                    (call ci::get (local graph) (call ci::add (local start) (i64 37)))
                                    (i64 9))
                                  (call source-read::sequence-span
                                    (local graph)
                                    (call ci::add (local start) (i64 38))
                                    (local end))
                                  (call sequence-cursor-failure (i64 14)))
                                (call sequence-cursor-failure (i64 12)))))
                          (call sequence-cursor-failure (i64 12)))))
                    (call sequence-cursor-failure (i64 14)))
                  (call sequence-cursor-failure (i64 12)))))
            (call sequence-cursor-failure (i64 12)))))))
  (function create sequence-last
    (visibility package)
    (effect pure)
    (parameter create graph (type Bytes))
    (parameter create parent (type I64))
    (parameter create position (type I64))
    (returns I64)
    (body
      (let
        (binding cursor (call sequence-cursor (local graph) (local parent)))
        (in
          (if
            (if
              (call ci::eq (field (local cursor) (name code)) (i64 0))
              (call ci::both
                (call ci::lt (i64 -1) (local position))
                (call ci::lt (local position) (field (local cursor) (name length))))
              (bool false))
            (if
              (call ci::eq (call ci::add (local position) (i64 1)) (field (local cursor) (name length)))
              (i64 1)
              (i64 0))
            (i64 -1))))))
  (function create sequence-state
    (visibility private)
    (effect pure)
    (parameter create code (type I64))
    (parameter create row (type I64))
    (parameter create enter (type Bool))
    (parameter create last (type Bool))
    (returns (record (code I64) (row I64) (enter Bool) (last Bool)))
    (body
      (record structural
        (field code (local code))
        (field row (local row))
        (field enter (local enter))
        (field last (local last)))))
  (function create sequence-step
    (visibility package)
    (effect pure)
    (parameter create graph (type Bytes))
    (parameter create parent (type I64))
    (parameter create position (type I64))
    (returns (record (code I64) (row I64) (enter Bool) (last Bool)))
    (body
      (let
        (binding cursor (call sequence-cursor (local graph) (local parent)))
        (in
          (if
            (call ci::eq (field (local cursor) (name code)) (i64 0))
            (if
              (call ci::both
                (call ci::lt (i64 -2) (local position))
                (call ci::lt (local position) (field (local cursor) (name length))))
              (let
                (binding next (call ci::add (local position) (i64 1)))
                (in
                  (if
                    (call ci::eq (local next) (field (local cursor) (name length)))
                    (call sequence-state (i64 0) (local parent) (bool false) (bool false))
                    (let
                      (binding at
                        (call ci::add
                          (field (local cursor) (name start))
                          (call ci::mul (local next) (i64 17))))
                      (in
                        (if
                          (call ci::lt
                            (i64 -1)
                            (call source-read::typed
                              (local graph)
                              (local at)
                              (field (local cursor) (name next))
                              (i64 9)
                              (i64 17)))
                          (let
                            (binding selected (call owner (local graph) (local graph) (local at) (i64 9)))
                            (in
                              (if
                                (call ci::both
                                  (call ci::lt (i64 -1) (local selected))
                                  (call ci::lt (local selected) (call count (local graph))))
                                (if
                                  (call ci::eq (call kind (local graph) (local selected)) (i64 17))
                                  (call sequence-state
                                    (i64 0)
                                    (local selected)
                                    (bool true)
                                    (call ci::eq
                                      (call ci::add (local next) (i64 1))
                                      (field (local cursor) (name length))))
                                  (call sequence-state (i64 14) (local parent) (bool false) (bool false)))
                                (call sequence-state (i64 14) (local parent) (bool false) (bool false)))))
                          (call sequence-state (i64 12) (local parent) (bool false) (bool false))))))))
              (call sequence-state (i64 19) (local parent) (bool false) (bool false)))
            (call sequence-state (field (local cursor) (name code)) (local parent) (bool false) (bool false)))))))
))
declarations.end

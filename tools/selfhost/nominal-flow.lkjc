declarations.begin
(units
  (module create nominal-flow
    (function create variant-step
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create at (type I64))
      (parameter create i (type I64))
      (returns Bool)
      (body
        (let
          (binding ty (call flow::field (local data) (local at) (i64 8)))
          (binding ordinal (call flow::field (local data) (local at) (i64 16)))
          (binding present (call flow::field (local data) (local at) (i64 24)))
          (in
            (if
              (call types::variant (local data) (local ty))
              (if
                (call ci::both
                  (call ci::lte (i64 0) (local ordinal))
                  (call ci::lt (local ordinal) (call types::arity (local data) (local ty))))
                (if
                  (call ci::eq
                    (local present)
                    (call types::case-presence (local data) (local ty) (local ordinal)))
                  (if
                    (call ci::eq (local present) (i64 0))
                    (call flow::regular
                      (local data)
                      (local f)
                      (local at)
                      (local i)
                      (i64 0)
                      (local ty)
                      (bool false)
                      (i64 -1))
                    (if
                      (call ci::eq (local present) (i64 1))
                      (if
                        (call ci::lt (i64 0) (call flow::field (local data) (local at) (i64 56)))
                        (if
                          (call ci::both
                            (call ci::eq
                              (call values::top (local data) (local f) (local at))
                              (call types::case-payload (local data) (local ty) (local ordinal)))
                            (if
                              (call values::top-borrow (local data) (local f) (local at))
                              (bool false)
                              (bool true)))
                          (call flow::regular
                            (local data)
                            (local f)
                            (local at)
                            (local i)
                            (i64 1)
                            (local ty)
                            (bool false)
                            (i64 -1))
                          (bool false))
                        (bool false))
                      (bool false)))
                  (bool false))
                (bool false))
              (bool false))))))
    (function create distinct
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create rows (type I64))
      (parameter create remaining (type I64))
      (parameter create local (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local remaining) (i64 0))
          (bool true)
          (let
            (binding previous (call ci::sub (local remaining) (i64 1)))
            (binding row (call ci::add (local rows) (call ci::mul (local previous) (i64 32))))
            (in
              (if
                (call ci::both
                  (call ci::eq (call ci::u64 (local data) (call ci::add (local row) (i64 16))) (i64 1))
                  (call ci::eq
                    (call ci::u64 (local data) (call ci::add (local row) (i64 24)))
                    (local local)))
                (bool false)
                (call distinct (local data) (local rows) (local previous) (local local))))))))
    (function create arms
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create at (type I64))
      (parameter create ty (type I64))
      (parameter create rows (type I64))
      (parameter create count (type I64))
      (parameter create index (type I64))
      (parameter create previous (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local index) (local count))
          (bool true)
          (let
            (binding row (call ci::add (local rows) (call ci::mul (local index) (i64 32))))
            (binding ordinal (call ci::u64 (local data) (local row)))
            (binding target (call ci::u64 (local data) (call ci::add (local row) (i64 8))))
            (binding present (call ci::u64 (local data) (call ci::add (local row) (i64 16))))
            (binding local (call ci::u64 (local data) (call ci::add (local row) (i64 24))))
            (in
              (if
                (call ci::both
                  (call ci::eq (local ordinal) (local index))
                  (call ci::both
                    (call ci::both
                      (call ci::lt (local previous) (local target))
                      (call ci::lt (local target) (call flow::field (local data) (local f) (i64 40))))
                    (call ci::eq
                      (local present)
                      (call types::case-presence (local data) (local ty) (local index)))))
                (let
                  (binding next
                    (call flow::node
                      (local data)
                      (call ci::add (call flow::field (local data) (local f) (i64 32)) (local target))))
                  (binding before (call flow::field (local data) (local at) (i64 48)))
                  (binding after (call flow::field (local data) (local next) (i64 48)))
                  (binding valid
                    (if
                      (call ci::eq (local present) (i64 0))
                      (call ci::eq (local local) (i64 0))
                      (if
                        (call ci::eq (local present) (i64 1))
                        (if
                          (call distinct (local data) (local rows) (local index) (local local))
                          (call custody::payload
                            (local data)
                            (local f)
                            (local before)
                            (local after)
                            (local local)
                            (call types::case-payload (local data) (local ty) (local index)))
                          (bool false))
                        (bool false))))
                  (in
                    (if
                      (local valid)
                      (if
                        (call flow::edge
                          (local data)
                          (local f)
                          (local at)
                          (local target)
                          (call ci::sub (call flow::field (local data) (local at) (i64 56)) (i64 1))
                          (i64 0)
                          (bool false)
                          (if (call ci::eq (local present) (i64 1)) (local local) (i64 -1)))
                        (call arms
                          (local data)
                          (local f)
                          (local at)
                          (local ty)
                          (local rows)
                          (local count)
                          (call ci::add (local index) (i64 1))
                          (local target))
                        (bool false))
                      (bool false))))
                (bool false)))))))
    (function create match-step
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create at (type I64))
      (parameter create i (type I64))
      (returns Bool)
      (body
        (let
          (binding ty (call flow::field (local data) (local at) (i64 8)))
          (binding count (call flow::field (local data) (local at) (i64 16)))
          (binding rows (call flow::field (local data) (local at) (i64 24)))
          (in
            (if
              (call types::variant (local data) (local ty))
              (if
                (call ci::both
                  (call ci::lt (i64 0) (local count))
                  (call ci::eq (local count) (call types::arity (local data) (local ty))))
                (if
                  (call ci::lt (i64 0) (call flow::field (local data) (local at) (i64 56)))
                  (if
                    (call ci::both
                      (call ci::eq (call values::top (local data) (local f) (local at)) (local ty))
                      (if
                        (call values::top-borrow (local data) (local f) (local at))
                        (bool false)
                        (bool true)))
                    (call arms
                      (local data)
                      (local f)
                      (local at)
                      (local ty)
                      (local rows)
                      (local count)
                      (i64 0)
                      (local i))
                    (bool false))
                  (bool false))
                (bool false))
              (bool false))))))
    (function create step
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create at (type I64))
      (parameter create i (type I64))
      (parameter create tag (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local tag) (i64 22))
          (call variant-step (local data) (local f) (local at) (local i))
          (if
            (call ci::eq (local tag) (i64 23))
            (call match-step (local data) (local f) (local at) (local i))
            (bool false)))))))
declarations.end

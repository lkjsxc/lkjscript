declarations.begin
(units
  (module create source-type-dag
    (function create append-edges
      (visibility private)
      (effect pure)
      (parameter create parent (type I64))
      (parameter create children (type Bytes))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local children)))
          (local out)
          (let
            (binding a (type ByteBuffer) (call ci::le (local parent) (i64 4) (local out)))
            (binding b
              (type ByteBuffer)
              (call ci::le (call ci::u32 (local children) (local at)) (i64 4) (local a)))
            (in
              (call append-edges
                (local parent)
                (local children)
                (call ci::add (local at) (i64 4))
                (local b)))))))
    (function create build
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create row (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (parameter create out (type ByteBuffer) (use consume))
      (returns
        (record
          (rows Bytes)
          (work
            (record
              (code I64)
              (finite Bool)
              (high I64)
              (low I64)
              (observed-high I64)
              (observed-low I64)
              (saturated Bool)))))
      (body
        (if
          (call ci::eq (local row) (call source-type-table::count (local graph)))
          (record structural (field rows (call ci::freeze (local out))) (field work (local work)))
          (let
            (binding cost
              (call ci::add (i64 1) (call source-type-table::child-count (local graph) (local row))))
            (in
              (if
                (call source-budget::insufficient (local work) (local cost))
                (record structural
                  (field rows (call ci::freeze (local out)))
                  (field work (call source-budget::fail (local work) (i64 6))))
                (let
                  (binding next
                    (type ByteBuffer)
                    (call append-edges
                      (local row)
                      (call source-type-table::children (local graph) (local row))
                      (i64 0)
                      (local out)))
                  (in
                    (call build
                      (local graph)
                      (call ci::add (local row) (i64 1))
                      (call source-budget::charge (local work) (local cost))
                      (local next))))))))))
    (function create dependencies
      (visibility private) (effect pure)
      (parameter create edges (type Bytes))
      (parameter create at (type I64))
      (parameter create node (type I64))
      (parameter create total (type I64))
      (parameter create work (type (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool))))
      (returns (record (count I64) (work (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool)))))
      (body
        (if (call ci::eq (local at) (call ci::length (local edges)))
          (record structural (field count (local total)) (field work (local work)))
          (if (call source-budget::insufficient (local work) (i64 1))
            (record structural (field count (local total))
              (field work (call source-budget::fail (local work) (i64 6))))
            (call dependencies (local edges) (call ci::add (local at) (i64 8)) (local node)
              (call ci::add (local total)
                (if (call ci::eq (call ci::u32 (local edges) (local at)) (local node))
                  (i64 1) (i64 0)))
              (call source-budget::charge (local work) (i64 1)))))))
    (function create initialize
      (visibility private) (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create node (type I64))
      (parameter create work (type (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool))))
      (parameter create pending (type ByteBuffer) (use consume))
      (parameter create ready (type ByteBuffer) (use consume))
      (returns (record (pending Bytes) (ready Bytes) (work (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool)))))
      (body
        (if (call ci::either (call ci::eq (local node) (local count))
              (call source-budget::failed (local work)))
          (record structural
            (field pending (call ci::freeze (local pending)))
            (field ready (call ci::freeze (local ready)))
            (field work (local work)))
          (if (call source-budget::insufficient (local work) (i64 1))
            (call initialize (local edges) (local count) (local node) (call source-budget::fail (local work) (i64 6)) (local pending) (local ready))
            (let
              (binding found (call dependencies (local edges) (i64 0) (local node) (i64 0)
                (call source-budget::charge (local work) (i64 1))))
              (binding left (field (local found) (name work)))
              (in
                (if (call source-budget::failed (local left))
                  (call initialize (local edges) (local count) (local node) (local left) (local pending) (local ready))
                  (let
                    (binding total (field (local found) (name count)))
                    (binding counts (type ByteBuffer) (call ci::le (local total) (i64 8) (local pending)))
                    (binding queue (type ByteBuffer)
                      (if (call ci::eq (local total) (i64 0))
                        (call ci::le (local node) (i64 4) (local ready)) (local ready)))
                    (in
                      (call initialize (local edges) (local count) (call ci::add (local node) (i64 1)) (local left) (local counts) (local queue)))))))))))
    (function create replace
      (visibility private) (effect pure)
      (parameter create pending (type Bytes))
      (parameter create node (type I64))
      (parameter create value (type I64))
      (returns Bytes)
      (body
        (let
          (binding at (call ci::mul (local node) (i64 8)))
          (binding empty (type ByteBuffer) (call ci::empty))
          (binding prefix (type ByteBuffer)
            (call ci::append-slice (local pending) (i64 0) (local at) (local empty)))
          (binding changed (type ByteBuffer) (call ci::le (local value) (i64 8) (local prefix)))
          (binding suffix (type ByteBuffer)
            (call ci::append-slice (local pending) (call ci::add (local at) (i64 8))
              (call ci::length (local pending)) (local changed)))
          (in (call ci::freeze (local suffix))))))
    (function create release
      (visibility private) (effect pure)
      (parameter create edges (type Bytes))
      (parameter create at (type I64))
      (parameter create node (type I64))
      (parameter create pending (type Bytes))
      (parameter create ready (type Bytes))
      (parameter create work (type (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool))))
      (returns (record (pending Bytes) (ready Bytes) (work (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool)))))
      (body
        (if (call ci::either (call ci::eq (local at) (call ci::length (local edges)))
              (call source-budget::failed (local work)))
          (record structural (field pending (local pending)) (field ready (local ready))
            (field work (local work)))
          (if (call source-budget::insufficient (local work) (i64 1))
            (call release (local edges) (local at) (local node) (local pending) (local ready)
              (call source-budget::fail (local work) (i64 6)))
            (let
              (binding remaining (call source-budget::charge (local work) (i64 1)))
              (in
                (if (call ci::eq (call ci::u32 (local edges) (call ci::add (local at) (i64 4))) (local node))
                  (let
                    (binding cost (call ci::div (call ci::length (local pending)) (i64 8)))
                    (in
                      (if (call source-budget::insufficient (local remaining) (local cost))
                        (call release (local edges) (local at) (local node) (local pending) (local ready)
                          (call source-budget::fail (local remaining) (i64 6)))
                        (let
                          (binding parent (call ci::u32 (local edges) (local at)))
                          (binding next (call ci::sub
                            (call ci::u64 (local pending) (call ci::mul (local parent) (i64 8))) (i64 1)))
                          (in
                            (call release (local edges) (call ci::add (local at) (i64 8)) (local node)
                              (call replace (local pending) (local parent) (local next))
                              (if (call ci::eq (local next) (i64 0))
                                (call source-type-table::push (local ready) (local parent)) (local ready))
                              (call source-budget::charge (local remaining) (local cost))))))))
                  (call release (local edges) (call ci::add (local at) (i64 8)) (local node)
                    (local pending) (local ready) (local remaining)))))))))
    (function create drain
      (visibility private) (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create at (type I64))
      (parameter create processed (type I64))
      (parameter create pending (type Bytes))
      (parameter create ready (type Bytes))
      (parameter create work (type (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool))))
      (returns (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool)))
      (body
        (if (call source-budget::failed (local work))
          (local work)
          (if (call ci::eq (local at) (call ci::length (local ready)))
            (if (call ci::eq (local processed) (local count)) (local work)
              (call source-budget::fail (local work) (i64 17)))
            (if (call source-budget::insufficient (local work) (i64 1))
              (call source-budget::fail (local work) (i64 6))
              (let
                (binding next (call release (local edges) (i64 0)
                  (call ci::u32 (local ready) (local at)) (local pending) (local ready)
                  (call source-budget::charge (local work) (i64 1))))
                (in
                  (call drain (local edges) (local count) (call ci::add (local at) (i64 4))
                    (call ci::add (local processed) (i64 1))
                    (field (local next) (name pending)) (field (local next) (name ready))
                    (field (local next) (name work))))))))))
    (function create endpoints
      (visibility private)
      (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create at (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local at) (call ci::length (local edges)))
          (local work)
          (if
            (call source-budget::insufficient (local work) (i64 1))
            (call source-budget::fail (local work) (i64 6))
            (if
              (call ci::both
                (call ci::lt (call ci::u32 (local edges) (local at)) (local count))
                (call ci::lt
                  (call ci::u32 (local edges) (call ci::add (local at) (i64 4)))
                  (local count)))
              (call endpoints
                (local edges)
                (local count)
                (call ci::add (local at) (i64 8))
                (call source-budget::charge (local work) (i64 1)))
              (call source-budget::fail (local work) (i64 17)))))))
    (function create prove
      (visibility package) (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create work (type (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool))))
      (returns (record (code I64) (finite Bool) (high I64) (low I64) (observed-high I64) (observed-low I64) (saturated Bool)))
      (body
        (if
          (call ci::either (call ci::lt (local count) (i64 0))
            (call ci::lt (i64 4294967295) (local count)))
          (call source-budget::fail (local work) (i64 17))
          (if
            (call ci::eq
              (call ci::mul (call ci::div (call ci::length (local edges)) (i64 8)) (i64 8))
              (call ci::length (local edges)))
            (let
              (binding remaining (call endpoints (local edges) (local count) (i64 0) (local work)))
              (in
                (if (call source-budget::failed (local remaining))
                  (local remaining)
                  (let
                    (binding pending (type ByteBuffer) (call ci::empty))
                    (binding ready (type ByteBuffer) (call ci::empty))
                    (binding initialized (call initialize (local edges) (local count) (i64 0) (local remaining) (local pending) (local ready)))
                    (in
                      (call drain (local edges) (local count) (i64 0) (i64 0)
                        (field (local initialized) (name pending)) (field (local initialized) (name ready))
                        (field (local initialized) (name work))))))))
            (call source-budget::fail (local work) (i64 17))))))
    (function create check
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (let
          (binding empty (type ByteBuffer) (call ci::empty))
          (binding built (call build (local graph) (i64 0) (local work) (local empty)))
          (binding remaining (field (local built) (name work)))
          (in
            (if
              (call source-budget::failed (local remaining))
              (local remaining)
              (call prove
                (field (local built) (name rows))
                (call source-type-table::count (local graph))
                (local remaining)))))))))
declarations.end

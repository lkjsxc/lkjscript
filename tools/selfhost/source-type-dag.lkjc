declarations.begin
(units
  (module create source-type-dag
    (function create append-edges
      (visibility private)
      (effect pure)
      (parameter create parent (type I64))
      (parameter create children (type Bytes))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local children)))
          (local out)
          (let
            (binding a (type ByteBuffer) (call ci::le (local parent) (i64 4) (local out)))
            (binding b
              (type ByteBuffer)
              (call ci::le (call ci::u32 (local children) (local at)) (i64 4) (local a)))
            (in
              (call append-edges
                (local parent)
                (local children)
                (call ci::add (local at) (i64 4))
                (local b)))))))
    (function create build
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create row (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (parameter create out (type ByteBuffer) (use consume))
      (returns
        (record
          (rows Bytes)
          (work
            (record
              (code I64)
              (finite Bool)
              (high I64)
              (low I64)
              (observed-high I64)
              (observed-low I64)
              (saturated Bool)))))
      (body
        (if
          (call ci::eq (local row) (call source-type-table::count (local graph)))
          (record structural (field rows (call ci::freeze (local out))) (field work (local work)))
          (let
            (binding cost
              (call ci::add (i64 1) (call source-type-table::child-count (local graph) (local row))))
            (in
              (if
                (call source-budget::insufficient (local work) (local cost))
                (record structural
                  (field rows (call ci::freeze (local out)))
                  (field work (call source-budget::fail (local work) (i64 6))))
                (let
                  (binding next
                    (type ByteBuffer)
                    (call append-edges
                      (local row)
                      (call source-type-table::children (local graph) (local row))
                      (i64 0)
                      (local out)))
                  (in
                    (call build
                      (local graph)
                      (call ci::add (local row) (i64 1))
                      (call source-budget::charge (local work) (local cost))
                      (local next))))))))))
    (function create height
      (visibility private)
      (effect pure)
      (parameter create known (type Bytes))
      (parameter create at (type I64))
      (parameter create node (type I64))
      (returns I64)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local known)))
          (i64 -1)
          (if
            (call ci::eq (call ci::u32 (local known) (local at)) (local node))
            (call ci::u32 (local known) (call ci::add (local at) (i64 4)))
            (call height (local known) (call ci::add (local at) (i64 8)) (local node))))))
    (function create successors
      (visibility private)
      (effect pure)
      (parameter create edges (type Bytes))
      (parameter create at (type I64))
      (parameter create node (type I64))
      (parameter create known (type Bytes))
      (parameter create best (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (height I64)
          (work
            (record
              (code I64)
              (finite Bool)
              (high I64)
              (low I64)
              (observed-high I64)
              (observed-low I64)
              (saturated Bool)))))
      (body
        (if
          (call ci::eq (local at) (call ci::length (local edges)))
          (record structural (field height (local best)) (field work (local work)))
          (let
            (binding selected (call ci::eq (call ci::u32 (local edges) (local at)) (local node)))
            (binding cost
              (call ci::add
                (i64 1)
                (if (local selected) (call ci::div (call ci::length (local known)) (i64 8)) (i64 0))))
            (in
              (if
                (call source-budget::insufficient (local work) (local cost))
                (record structural
                  (field height (i64 -1))
                  (field work (call source-budget::fail (local work) (i64 6))))
                (let
                  (binding child
                    (if
                      (local selected)
                      (call height
                        (local known)
                        (i64 0)
                        (call ci::u32 (local edges) (call ci::add (local at) (i64 4))))
                      (i64 -2)))
                  (binding next (call ci::add (local child) (i64 1)))
                  (binding remaining (call source-budget::charge (local work) (local cost)))
                  (in
                    (if
                      (call ci::eq (local child) (i64 -1))
                      (record structural (field height (i64 -1)) (field work (local remaining)))
                      (call successors
                        (local edges)
                        (call ci::add (local at) (i64 8))
                        (local node)
                        (local known)
                        (if (call ci::lt (local best) (local next)) (local next) (local best))
                        (local remaining)))))))))))
    (function create settle
      (visibility private)
      (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create node (type I64))
      (parameter create known (type Bytes))
      (parameter create before (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local node) (local count))
          (if
            (call ci::eq (call ci::length (local known)) (call ci::mul (local count) (i64 8)))
            (local work)
            (if
              (call ci::eq (call ci::length (local known)) (local before))
              (call source-budget::fail (local work) (i64 17))
              (call settle
                (local edges)
                (local count)
                (i64 0)
                (local known)
                (call ci::length (local known))
                (local work))))
          (let
            (binding cost (call ci::add (i64 1) (call ci::div (call ci::length (local known)) (i64 8))))
            (in
              (if
                (call source-budget::insufficient (local work) (local cost))
                (call source-budget::fail (local work) (i64 6))
                (let
                  (binding remaining (call source-budget::charge (local work) (local cost)))
                  (in
                    (if
                      (call ci::lt (call height (local known) (i64 0) (local node)) (i64 0))
                      (let
                        (binding result
                          (call successors
                            (local edges)
                            (i64 0)
                            (local node)
                            (local known)
                            (i64 0)
                            (local remaining)))
                        (binding depth (field (local result) (name height)))
                        (binding left (field (local result) (name work)))
                        (in
                          (if
                            (call source-budget::failed (local left))
                            (local left)
                            (if
                              (call ci::lt (i64 256) (local depth))
                              (call source-budget::fail (local left) (i64 17))
                              (let
                                (binding updated
                                  (if
                                    (call ci::lt (local depth) (i64 0))
                                    (local known)
                                    (call source-type-table::push
                                      (call source-type-table::push (local known) (local node))
                                      (local depth))))
                                (in
                                  (call settle
                                    (local edges)
                                    (local count)
                                    (call ci::add (local node) (i64 1))
                                    (local updated)
                                    (local before)
                                    (local left))))))))
                      (call settle
                        (local edges)
                        (local count)
                        (call ci::add (local node) (i64 1))
                        (local known)
                        (local before)
                        (local remaining)))))))))))
    (function create endpoints
      (visibility private)
      (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create at (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local at) (call ci::length (local edges)))
          (local work)
          (if
            (call source-budget::insufficient (local work) (i64 1))
            (call source-budget::fail (local work) (i64 6))
            (if
              (call ci::both
                (call ci::lt (call ci::u32 (local edges) (local at)) (local count))
                (call ci::lt
                  (call ci::u32 (local edges) (call ci::add (local at) (i64 4)))
                  (local count)))
              (call endpoints
                (local edges)
                (local count)
                (call ci::add (local at) (i64 8))
                (call source-budget::charge (local work) (i64 1)))
              (call source-budget::fail (local work) (i64 17)))))))
    (function create prove
      (visibility package)
      (effect pure)
      (parameter create edges (type Bytes))
      (parameter create count (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::either
            (call ci::lt (local count) (i64 0))
            (call ci::lt (i64 4294967295) (local count)))
          (call source-budget::fail (local work) (i64 17))
          (if
            (call ci::eq
              (call ci::mul (call ci::div (call ci::length (local edges)) (i64 8)) (i64 8))
              (call ci::length (local edges)))
            (let
              (binding remaining (call endpoints (local edges) (local count) (i64 0) (local work)))
              (in
                (if
                  (call source-budget::failed (local remaining))
                  (local remaining)
                  (call settle
                    (local edges)
                    (local count)
                    (i64 0)
                    (call ci::text-bytes (text ""))
                    (i64 0)
                    (local remaining)))))
            (call source-budget::fail (local work) (i64 17))))))
    (function create check
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (let
          (binding empty (type ByteBuffer) (call ci::empty))
          (binding built (call build (local graph) (i64 0) (local work) (local empty)))
          (binding remaining (field (local built) (name work)))
          (in
            (if
              (call source-budget::failed (local remaining))
              (local remaining)
              (call prove
                (field (local built) (name rows))
                (call source-type-table::count (local graph))
                (local remaining)))))))))
declarations.end

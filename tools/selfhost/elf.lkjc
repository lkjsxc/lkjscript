            (call ci::append
              (call ci::text-bytes (text "normalized_integer_overflow\n"))
              (i64 0)
              (local ag)))
          (binding ai (type ByteBuffer) (call ci::pad (i64 4672) (i64 0) (local ah)))
          (binding aj
            (type ByteBuffer)
            (call ci::append
              (call ci::text-bytes (text "normalized_integer_division\n"))
              (i64 0)
              (local ai)))
          (binding ak (type ByteBuffer) (call ci::pad (i64 4736) (i64 0) (local aj)))
          (binding al
            (type ByteBuffer)
            (call ci::append (call ci::text-bytes (text "native_argument\n")) (i64 0) (local ak)))

declarations.begin
(units
  (module create elf
    (function create header
      (visibility private)
      (effect pure)
      (parameter create n (type I64))
      (parameter create binary (type Bool))
      (returns ByteBuffer)
      (body
        (let
          (binding size (local n))
          (binding a (type ByteBuffer) (call ci::empty))
          (binding b
            (type ByteBuffer)
            (call ci::append
              (call ci::octets (list I64 (i64 127) (i64 69) (i64 76) (i64 70) (i64 2) (i64 1) (i64 1)))
              (i64 0)
              (local a)))
          (binding c (type ByteBuffer) (call ci::pad (i64 16) (i64 0) (local b)))
          (binding d (type ByteBuffer) (call ci::le (i64 2) (i64 2) (local c)))
          (binding e (type ByteBuffer) (call ci::le (i64 62) (i64 2) (local d)))
          (binding f (type ByteBuffer) (call ci::le (i64 1) (i64 4) (local e)))
          (binding g (type ByteBuffer) (call ci::le (i64 4198400) (i64 8) (local f)))
          (binding h (type ByteBuffer) (call ci::le (i64 64) (i64 8) (local g)))
          (binding i (type ByteBuffer) (call ci::pad (i64 52) (i64 0) (local h)))
          (binding j (type ByteBuffer) (call ci::le (i64 64) (i64 2) (local i)))
          (binding k (type ByteBuffer) (call ci::le (i64 56) (i64 2) (local j)))
          (binding l (type ByteBuffer) (call ci::le (i64 2) (i64 2) (local k)))
          (binding m (type ByteBuffer) (call ci::pad (i64 64) (i64 0) (local l)))
          (binding o (type ByteBuffer) (call ci::le (i64 1) (i64 4) (local m)))
          (binding p (type ByteBuffer) (call ci::le (i64 5) (i64 4) (local o)))
          (binding q (type ByteBuffer) (call ci::pad (i64 80) (i64 0) (local p)))
          (binding r (type ByteBuffer) (call ci::le (i64 4194304) (i64 8) (local q)))
          (binding s (type ByteBuffer) (call ci::le (i64 4194304) (i64 8) (local r)))
          (binding t (type ByteBuffer) (call ci::le (local size) (i64 8) (local s)))
          (binding u (type ByteBuffer) (call ci::le (local size) (i64 8) (local t)))
          (binding v (type ByteBuffer) (call ci::le (i64 4096) (i64 8) (local u)))
          (binding w (type ByteBuffer) (call ci::le (i64 1685382481) (i64 4) (local v)))
          (binding x (type ByteBuffer) (call ci::le (i64 6) (i64 4) (local w)))
          (binding y (type ByteBuffer) (call ci::pad (i64 168) (i64 0) (local x)))
          (binding z (type ByteBuffer) (call ci::le (i64 16) (i64 8) (local y)))
          (binding phase-header (type ByteBuffer)
            (if (local binary) (call phase::header (local z)) (local z)))
          (in (call ci::pad (i64 4096) (i64 0) (local phase-header))))))
    (function create raw
      (visibility public)
      (effect pure)
      (parameter create values (type (list I64)))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body (call ci::append (call ci::octets (local values)) (i64 0) (local out))))
    (function create jump
      (visibility public)
      (effect pure)
      (parameter create target (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a (type ByteBuffer) (call ci::push (i64 233) (local out)))
          (in (call ci::rel (local target) (local a))))))
    (function create condition
      (visibility public)
      (effect pure)
      (parameter create code (type I64))
      (parameter create target (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a (type ByteBuffer) (call raw (list I64 (i64 15) (local code)) (local out)))
          (in (call ci::rel (local target) (local a))))))
    (function create trap
      (visibility public)
      (effect pure)
      (parameter create message (type I64))
      (parameter create length (type I64))
      (parameter create status (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding recovery (type ByteBuffer) (call phase::trap (local message) (local out)))
          (binding a
            (type ByteBuffer)
            (call raw
              (list I64 (i64 191) (i64 2) (i64 0) (i64 0) (i64 0) (i64 72) (i64 141) (i64 53))
              (local recovery)))
          (binding b (type ByteBuffer) (call ci::rel (local message) (local a)))
          (binding c (type ByteBuffer) (call ci::push (i64 186) (local b)))
          (binding d (type ByteBuffer) (call ci::le (local length) (i64 4) (local c)))
          (binding e (type ByteBuffer) (call raw (list I64 (i64 65) (i64 184)) (local d)))
          (binding f (type ByteBuffer) (call ci::le (local status) (i64 4) (local e)))
          (in (call jump (i64 4480) (local f))))))
    (function create runtime-closure
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create layout (type Bytes))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding c (type ByteBuffer) (call jump (i64 49152) (local out)))
          (binding d (type ByteBuffer) (call ci::pad (i64 4160) (i64 144) (local c)))
          (binding e
            (type ByteBuffer)
            (call trap
              (i64 4608)
              (call ci::length (call ci::text-bytes (text "normalized_integer_overflow\n")))
              (i64 70)
              (local d)))
          (binding f (type ByteBuffer) (call ci::pad (i64 4224) (i64 144) (local e)))
          (binding g
            (type ByteBuffer)
            (call trap
              (i64 4672)
              (call ci::length (call ci::text-bytes (text "normalized_integer_division\n")))
              (i64 70)
              (local f)))
          (binding h (type ByteBuffer) (call ci::pad (i64 4288) (i64 144) (local g)))
          (binding i
            (type ByteBuffer)
            (call trap
              (i64 4736)
              (call ci::length (call ci::text-bytes (text "native_argument\n")))
              (i64 64)
              (local h)))
          (binding j (type ByteBuffer) (call ci::pad (i64 4352) (i64 144) (local i)))
          (binding k
            (type ByteBuffer)
            (call raw
              (list I64
                (i64 72)
                (i64 131)
                (i64 236)
                (i64 32)
                (i64 72)
                (i64 141)
                (i64 116)
                (i64 36)
                (i64 32)
                (i64 69)
                (i64 49)
                (i64 201)
                (i64 72)
                (i64 133)
                (i64 192))
              (local j)))
          (binding l (type ByteBuffer) (call condition (i64 137) (i64 4384) (local k)))
          (binding m
            (type ByteBuffer)
            (call raw (list I64 (i64 65) (i64 255) (i64 193) (i64 72) (i64 247) (i64 216)) (local l)))
          (binding n (type ByteBuffer) (call ci::pad (i64 4384) (i64 144) (local m)))
          (binding o
            (type ByteBuffer)
            (call raw
              (list I64
                (i64 187)
                (i64 10)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 49)
                (i64 210)
                (i64 72)
                (i64 247)
                (i64 243)
                (i64 128)
                (i64 194)
                (i64 48)
                (i64 72)
                (i64 255)
                (i64 206)
                (i64 136)
                (i64 22)
                (i64 72)
                (i64 133)
                (i64 192))
              (local n)))
          (binding p (type ByteBuffer) (call condition (i64 133) (i64 4389) (local o)))
          (binding q (type ByteBuffer) (call raw (list I64 (i64 69) (i64 133) (i64 201)) (local p)))
          (binding r (type ByteBuffer) (call condition (i64 132) (i64 4432) (local q)))
          (binding s
            (type ByteBuffer)
            (call raw (list I64 (i64 72) (i64 255) (i64 206) (i64 198) (i64 6) (i64 45)) (local r)))
          (binding t (type ByteBuffer) (call ci::pad (i64 4432) (i64 144) (local s)))
          (binding u
            (type ByteBuffer)
            (call raw
              (list I64
                (i64 72)
                (i64 141)
                (i64 84)
                (i64 36)
                (i64 32)
                (i64 72)
                (i64 41)
                (i64 242)
                (i64 191)
                (i64 1)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 69)
                (i64 49)
                (i64 192))
              (local t)))
          (binding v (type ByteBuffer) (call jump (i64 4480) (local u)))
          (binding w (type ByteBuffer) (call ci::pad (i64 4480) (i64 144) (local v)))
          (binding x
            (type ByteBuffer)
            (call raw
              (list I64
                (i64 184)
                (i64 1)
                (i64 0)
                (i64 0)
                (i64 0)
                (i64 15)
                (i64 5)
                (i64 72)
                (i64 131)
                (i64 248)
                (i64 252))
              (local w)))
          (binding y (type ByteBuffer) (call condition (i64 132) (i64 4480) (local x)))
          (binding z (type ByteBuffer) (call raw (list I64 (i64 72) (i64 133) (i64 192)) (local y)))
          (binding aa (type ByteBuffer) (call condition (i64 142) (i64 4560) (local z)))
          (binding ab
            (type ByteBuffer)
            (call raw (list I64 (i64 72) (i64 1) (i64 198) (i64 72) (i64 41) (i64 194)) (local aa)))
          (binding ac (type ByteBuffer) (call condition (i64 133) (i64 4480) (local ab)))
          (binding ad

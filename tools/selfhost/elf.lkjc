    (function create compile-elf
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding code (call ci::validate (local data)))
          (in
            (if
              (call ci::eq (local code) (i64 0))
              (if
                (call ci::eq (call ci::u32 (local data) (i64 112)) (i64 1))
                (call artifact::compile-admitted (local data))
                (let
                  (binding layout (call machine::layout (local data)))
                  (in
                    (if
                      (call ci::eq (field (local layout) (name code)) (i64 0))
                      (call emit-admitted (local data) (field (local layout) (name bytes)))
                      (call rejected (field (local layout) (name code)))))))
              (call rejected (local code)))))))
    (component create compiler
      (visibility public)
      (port create compile-elf
        (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function compile-elf)))
    (function create wide-jump
      (visibility public)
      (effect pure)
      (parameter create target (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding a
            (type ByteBuffer)
            (call asm::imm (i64 11) (call ci::add (i64 4194304) (local target)) (local out)))
          (in (call raw (list I64 (i64 65) (i64 255) (i64 227)) (local a))))))
    (function create wide-condition
      (visibility public)
      (effect pure)
      (parameter create code (type I64))
      (parameter create target (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding even
            (call ci::eq (local code) (call ci::mul (call ci::div (local code) (i64 2)) (i64 2))))
          (binding inverse (call ci::add (local code) (if (local even) (i64 -15) (i64 -17))))
          (binding a (type ByteBuffer) (call raw (list I64 (local inverse) (i64 13)) (local out)))
          (in (call wide-jump (local target) (local a))))))
    (function create rejected
      (visibility private)
      (effect pure)
      (parameter create code (type I64))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (record structural (field diagnostic (local code)) (field image (call ci::text-bytes (text ""))))))
    (function create emit-admitted
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create layout (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding n
            (call ci::add
              (call machine::data-start (local data) (local layout))
              (call ci::u64 (local data) (i64 136))))
          (binding a (type ByteBuffer) (call header (local n)
            (call ci::eq (call flow::field (local data)
              (call flow::declaration (local data) (call ci::u64 (local data) (i64 144))) (i64 16)) (i64 1))))
          (binding b (type ByteBuffer) (call runtime-closure (local data) (local layout) (local a)))
          (binding runtime (call runtime::emit (local data) (local layout) (local b)))
          (in
            (if
              (call ci::eq (field (local runtime) (name code)) (i64 0))
              (let
                (binding empty (type ByteBuffer) (call ci::empty))
                (binding prefix
                  (type ByteBuffer)
                  (call ci::append (field (local runtime) (name bytes)) (i64 0) (local empty)))
                (binding image (call machine::emit (local data) (local layout) (i64 0) (local prefix)))
                (in
                  (if
                    (call ci::eq (call ci::length (local image)) (local n))
                    (record structural (field diagnostic (i64 0)) (field image (local image)))
                    (call rejected (i64 3)))))
              (call rejected (field (local runtime) (name code)))))))))
  (target create compile-elf
    (component elf::compiler)
    (runner command)
    (port elf::compiler::compile-elf)))
declarations.end

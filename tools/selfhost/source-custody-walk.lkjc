                      (if (call ci::eq (local tag) (i64 8))
                        (call aggregate-next (local input) (call source-custody-machine::parent (local frame) (local current))
                          (call ci::add (field (local frame) (name index)) (i64 1)))
                        (call after-function (local current) (local frame))))))))))))))
    (function create step
      (visibility package) (effect pure)
      (parameter create input (type (record (graph Bytes) (parents Bytes) (types Bytes)
        (mapping Bytes) (facts Bytes) (owner I64))))
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (if (field (local current) (name enter))
        (call source-custody-machine::prepend (call enter (local input) (local current))
          (call source-custody-state::event (i64 2) (field (local current) (name row)) (field (local current) (name row))
            (field (local current) (name mode)) (field (local current) (name state))))
        (call resume (local input) (local current)))))
  ))
declarations.end

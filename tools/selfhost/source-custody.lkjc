declarations.begin
(units
  (module create source-custody
    (function create outcome
      (visibility private) (effect pure)
      (parameter create code (type I64)) (parameter create evidence (type Bytes))
      (returns (record (code I64) (evidence Bytes)))
      (body (record structural (field code (local code)) (field evidence (local evidence)))))
    (function create walk
      (visibility private) (effect pure)
      (parameter create input (type (record (graph Bytes) (parents Bytes) (types Bytes)
        (mapping Bytes) (facts Bytes) (owner I64))))
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (evidence Bytes)))
      (body (if (call ci::eq (field (local current) (name code)) (i64 0))
        (if (call source-custody-state::room (call ci::size (local out))
            (call ci::length (field (local current) (name events))))
          (let (binding next (type ByteBuffer) (call ci::append (field (local current) (name events)) (i64 0) (local out)))
            (in (if (if (field (local current) (name enter)) (bool false)
                (call ci::eq (call ci::length (field (local current) (name stack))) (i64 0)))
              (call outcome (i64 0) (call ci::freeze (local next)))
              (call walk (local input) (call source-custody-walk::step (local input) (local current)) (local next)))))
          (let (binding disposed (call ci::discard (local out)))
            (in (call outcome (i64 13) (call source-custody-state::empty)))))
        (let (binding disposed (call ci::discard (local out)))
          (in (call outcome (field (local current) (name code)) (call source-custody-state::empty)))))))
    (function create function
      (visibility private) (effect pure)
      (parameter create graph (type Bytes)) (parameter create parents (type Bytes))
      (parameter create types (type Bytes)) (parameter create mapping (type Bytes))
      (parameter create facts (type Bytes)) (parameter create row (type I64))
      (parameter create state (type Bytes))
      (returns (record (code I64) (evidence Bytes)))
      (body (let
        (binding data (call source-table::data (local graph) (local row)))
        (binding parts (call source-scalar-profile::function-parts (local graph) (local row)))
        (binding body (call source-table::owner (local graph) (local data) (field (local parts) (name body)) (i64 9)))
        (binding owned (call source-custody-signature::owned (call source-custody-signature::result-type (local graph) (local mapping) (local row))))
        (binding mode (if (local owned) (i64 2) (i64 0)))
        (binding frame (call source-custody-frame::push (call source-custody-state::empty) (i64 9)
          (local row) (local mode) (i64 0) (i64 0) (if (local owned) (i64 1) (i64 0)) (call source-custody-state::empty)))
        (in (if (call ci::eq (field (local frame) (name code)) (i64 0))
          (let (binding out (type ByteBuffer) (call ci::empty))
            (in (call walk
              (record structural (field graph (local graph)) (field parents (local parents))
                (field types (local types)) (field mapping (local mapping)) (field facts (local facts)) (field owner (local row)))
              (call source-custody-machine::prepend
                (call source-custody-machine::go (local body) (local mode) (local state) (field (local frame) (name stack)))
                (call source-custody-state::event (i64 1) (local row) (local row) (local mode) (local state)))
              (local out))))
          (call outcome (field (local frame) (name code)) (call source-custody-state::empty)))))))
    (function create owners
      (visibility private) (effect pure)
      (parameter create graph (type Bytes)) (parameter create parents (type Bytes))
      (parameter create types (type Bytes)) (parameter create mapping (type Bytes))
      (parameter create facts (type Bytes)) (parameter create row (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (evidence Bytes)))
      (body (if (call ci::eq (local row) (call source-table::count (local graph)))
        (call outcome (i64 0) (call ci::freeze (local out)))
        (let
          (binding kind (call source-table::kind (local graph) (local row)))
          (binding checked (if (call ci::either (call ci::eq (local kind) (i64 5)) (call ci::eq (local kind) (i64 6)))
            (let (binding signature (call source-custody-signature::start (local graph) (local mapping) (local row)))
              (in (if (call ci::eq (field (local signature) (name code)) (i64 0))
                (if (call ci::eq (local kind) (i64 5))
                  (call outcome (call source-custody-signature::external (local graph) (local types) (local mapping) (local row))
                    (call source-custody-state::empty))
                  (call function (local graph) (local parents) (local types) (local mapping) (local facts) (local row)
                    (field (local signature) (name state))))
                (call outcome (field (local signature) (name code)) (call source-custody-state::empty)))))
            (call outcome (i64 0) (call source-custody-state::empty))))
          (in (if (call ci::eq (field (local checked) (name code)) (i64 0))
            (if (call source-custody-state::room (call ci::size (local out))
                (call ci::length (field (local checked) (name evidence))))
              (let (binding next (type ByteBuffer) (call ci::append (field (local checked) (name evidence)) (i64 0) (local out)))
                (in (call owners (local graph) (local parents) (local types) (local mapping) (local facts)
                  (call ci::add (local row) (i64 1)) (local next))))
              (let (binding disposed (call ci::discard (local out)))
                (in (call outcome (i64 13) (call source-custody-state::empty)))))
            (let (binding disposed (call ci::discard (local out)))
              (in (call outcome (field (local checked) (name code)) (call source-custody-state::empty))))))))))
    (function create prepare
      (visibility package) (effect pure)
      (parameter create graph (type Bytes)) (parameter create parents (type Bytes))
      (parameter create types (type Bytes)) (parameter create mapping (type Bytes))
      (parameter create facts (type Bytes))
      (returns (record (code I64) (evidence Bytes)))
      (body (let (binding out (type ByteBuffer) (call ci::empty))
        (in (call owners (local graph) (local parents) (local types) (local mapping) (local facts) (i64 0) (local out))))))
  ))
declarations.end

declarations.begin
(units
  (module create wire
    (function create be
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (parameter create count (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local count) (i64 0))
          (local out)
          (let
            (binding rest (call ci::div (local value) (i64 256)))
            (binding prefix
              (type ByteBuffer)
              (call be (local rest) (call ci::sub (local count) (i64 1)) (local out)))
            (in
              (call ci::push
                (call ci::sub (local value) (call ci::mul (local rest) (i64 256)))
                (local prefix)))))))
    (function create unsigned
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::lt (local value) (i64 251))
          (call ci::push (local value) (local out))
          (if
            (call ci::lt (local value) (i64 65536))
            (let
              (binding prefix (type ByteBuffer) (call ci::push (i64 251) (local out)))
              (in (call ci::le (local value) (i64 2) (local prefix))))
            (if
              (call ci::lt (local value) (i64 4294967296))
              (let
                (binding prefix (type ByteBuffer) (call ci::push (i64 252) (local out)))
                (in (call ci::le (local value) (i64 4) (local prefix))))
              (let
                (binding prefix (type ByteBuffer) (call ci::push (i64 253) (local out)))
                (in (call ci::le (local value) (i64 8) (local prefix)))))))))
    (function create signed
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding negative (call ci::lt (local value) (i64 0)))
          (binding magnitude
            (if (local negative) (call ci::sub (i64 -1) (local value)) (local value)))
          (binding high (call ci::div (local magnitude) (i64 4294967296)))
          (binding low
            (call ci::add
              (call ci::mul
                (i64 2)
                (call ci::sub (local magnitude) (call ci::mul (local high) (i64 4294967296))))
              (if (local negative) (i64 1) (i64 0))))
          (binding carry (call ci::div (local low) (i64 4294967296)))
          (binding upper (call ci::add (call ci::mul (local high) (i64 2)) (local carry)))
          (binding lower (call ci::sub (local low) (call ci::mul (local carry) (i64 4294967296))))
          (in
            (if
              (call ci::eq (local upper) (i64 0))
              (call unsigned (local lower) (local out))
              (let
                (binding prefix (type ByteBuffer) (call ci::push (i64 253) (local out)))
                (binding a (type ByteBuffer) (call ci::le (local lower) (i64 4) (local prefix)))
                (in (call ci::le (local upper) (i64 4) (local a)))))))))
    (function create range
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create start (type I64))
      (parameter create end (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local start) (local end))
          (local out)
          (let
            (binding a
              (type ByteBuffer)
              (call ci::push (call ci::get (local data) (local start)) (local out)))
            (in
              (call range (local data) (call ci::add (local start) (i64 1)) (local end) (local a)))))))
    (function create digest
      (visibility public)
      (effect pure)
      (parameter create context (type Text))
      (parameter create data (type Bytes))
      (returns Bytes)
      (body
        (let
          (binding prefix
            (type ByteBuffer)
            (let
              (binding wire-temp-0 (call ci::length (local data)))
              (binding wire-temp-1 (i64 8))
              (binding wire-temp-2 (type ByteBuffer) (call ci::empty))
              (in (call be (local wire-temp-0) (local wire-temp-1) (local wire-temp-2)))))
          (in
            (call ci::derive
              (local context)
              (call ci::concat (call ci::freeze (local prefix)) (local data)))))))
    (function create envelope
      (visibility public)
      (effect pure)
      (parameter create magic (type Text))
      (parameter create context (type Text))
      (parameter create data (type Bytes))
      (returns Bytes)
      (body
        (let
          (binding a
            (type ByteBuffer)
            (let
              (binding wire-temp-3 (call ci::text-bytes (local magic)))
              (binding wire-temp-4 (i64 0))
              (binding wire-temp-5 (type ByteBuffer) (call ci::empty))
              (in (call ci::append (local wire-temp-3) (local wire-temp-4) (local wire-temp-5)))))
          (binding b (type ByteBuffer) (call ci::le (i64 1) (i64 2) (local a)))
          (binding c
            (type ByteBuffer)
            (call ci::le (call ci::length (local data)) (i64 8) (local b)))
          (binding d (type ByteBuffer) (call ci::append (local data) (i64 0) (local c)))
          (binding core (call ci::freeze (local d)))
          (in (call ci::concat (local core) (call digest (local context) (local core)))))))))
declarations.end

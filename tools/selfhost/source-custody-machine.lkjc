declarations.begin
(units
  (module create source-custody-machine
    (function create action
      (visibility package) (effect pure)
      (parameter create code (type I64)) (parameter create row (type I64))
      (parameter create enter (type Bool)) (parameter create mode (type I64))
      (parameter create owned (type Bool)) (parameter create terminal (type Bool))
      (parameter create state (type Bytes)) (parameter create stack (type Bytes))
      (parameter create events (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (record structural
        (field code (local code)) (field row (local row)) (field enter (local enter))
        (field mode (local mode)) (field owned (local owned)) (field terminal (local terminal))
        (field state (local state)) (field stack (local stack)) (field events (local events)))))
    (function create go
      (visibility package) (effect pure)
      (parameter create row (type I64)) (parameter create mode (type I64))
      (parameter create state (type Bytes)) (parameter create stack (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (call action (i64 0) (local row) (bool true) (local mode) (bool false) (bool false)
        (local state) (local stack) (call source-custody-state::empty))))
    (function create fail
      (visibility package) (effect pure)
      (parameter create code (type I64)) (parameter create row (type I64))
      (parameter create state (type Bytes)) (parameter create stack (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (call action (local code) (local row) (bool false) (i64 0) (bool false) (bool false)
        (local state) (local stack) (call source-custody-state::empty))))
    (function create prepend
      (visibility package) (effect pure)
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (parameter create events (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (if (call source-custody-state::room (call ci::length (local events))
          (call ci::length (field (local current) (name events))))
        (call action (field (local current) (name code)) (field (local current) (name row))
          (field (local current) (name enter)) (field (local current) (name mode))
          (field (local current) (name owned)) (field (local current) (name terminal))
          (field (local current) (name state)) (field (local current) (name stack))
          (call ci::concat (local events) (field (local current) (name events))))
        (call fail (i64 13) (field (local current) (name row))
          (field (local current) (name state)) (field (local current) (name stack))))))
    (function create finish
      (visibility package) (effect pure)
      (parameter create row (type I64)) (parameter create mode (type I64))
      (parameter create owned (type Bool)) (parameter create terminal (type Bool))
      (parameter create state (type Bytes)) (parameter create stack (type Bytes))
      (parameter create events (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (if (if (local owned) (call ci::eq (local mode) (i64 2)) (bool true))
        (call prepend
          (call action (i64 0) (local row) (bool false) (local mode) (local owned) (local terminal)
            (local state) (local stack)
            (call source-custody-state::event (i64 16) (local row) (local row)
              (call ci::add (if (local owned) (i64 1) (i64 0)) (if (local terminal) (i64 2) (i64 0))) (local state)))
          (local events))
        (call fail (i64 19) (local row) (local state) (local stack)))))
    (function create descend
      (visibility package) (effect pure)
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (parameter create tag (type I64)) (parameter create index (type I64))
      (parameter create mark (type I64)) (parameter create extra (type I64))
      (parameter create payload (type Bytes)) (parameter create child (type I64))
      (parameter create mode (type I64)) (parameter create state (type Bytes))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (let (binding frame (call source-custody-frame::push
        (field (local current) (name stack)) (local tag) (field (local current) (name row))
        (field (local current) (name mode)) (local index) (local mark) (local extra) (local payload)))
        (in (if (call ci::eq (field (local frame) (name code)) (i64 0))
          (call go (local child) (local mode) (local state) (field (local frame) (name stack)))
          (call fail (field (local frame) (name code)) (field (local current) (name row))
            (local state) (field (local current) (name stack))))))))
    (function create parent
      (visibility package) (effect pure)
      (parameter create frame (type (record (tag I64) (row I64) (mode I64) (index I64)
        (mark I64) (extra I64) (payload Bytes) (rest Bytes))))
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (call action (i64 0) (field (local frame) (name row)) (bool false)
        (field (local frame) (name mode)) (field (local current) (name owned))
        (field (local current) (name terminal)) (field (local current) (name state))
        (field (local frame) (name rest)) (call source-custody-state::empty))))
  ))
declarations.end

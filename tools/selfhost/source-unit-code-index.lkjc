              (call less (local data) (call ci::sub (local at) (i64 24)) (local at))
              (call unique (local data) (call ci::add (local at) (i64 24)))
              (bool false))))))
    (function create prepare
      (visibility package)
      (effect pure)
      (parameter create trace (type Bytes))
      (parameter create count (type I64))
      (returns (record (code I64) (bytes Bytes)))
      (body
        (if
          (call ci::both
            (call ci::lte (i64 0) (local count))
            (call ci::lte (local count) (i64 4294967296)))
          (let
            (binding empty (type ByteBuffer) (call ci::empty))
            (binding collected (call scan (local trace) (i64 0) (i64 0) (local count) (local empty)))
            (in
              (if
                (call ci::eq (field (local collected) (name code)) (i64 0))
                (let
                  (binding sorted (call sort (field (local collected) (name bytes)) (i64 1)))
                  (in
                    (if
                      (call unique (local sorted) (i64 0))
                      (record structural (field code (i64 0)) (field bytes (local sorted)))
                      (record structural
                        (field code (i64 3))
                        (field bytes (call ci::text-bytes (text "")))))))
                (local collected))))
          (record structural (field code (i64 3)) (field bytes (call ci::text-bytes (text "")))))))
    (function create find
      (visibility private)
      (effect pure)
      (parameter create index (type Bytes))
      (parameter create owner (type I64))
      (parameter create label (type I64))
      (parameter create left (type I64))
      (parameter create right (type I64))
      (returns I64)
      (body
        (if

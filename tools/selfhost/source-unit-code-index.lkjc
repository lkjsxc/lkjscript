          (i64 -1)
          (let
            (binding middle
              (call ci::add
                (local left)
                (call ci::div (call ci::sub (local right) (local left)) (i64 2))))
            (binding at (call ci::mul (local middle) (i64 24)))
            (binding a (call ci::u64 (local index) (local at)))
            (binding b (call ci::u64 (local index) (call ci::add (local at) (i64 8))))
            (in
              (if
                (call ci::lt (local a) (local owner))
                (call find

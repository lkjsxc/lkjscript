(units
  (module create source-unit-code-index
    (function create failure
      (visibility private)
      (effect pure)
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (bytes Bytes)))
      (body
        (let
          (binding discarded (call ci::discard (local out)))
          (in (record structural (field code (i64 3)) (field bytes (call ci::text-bytes (text ""))))))))
    (function create metadata
      (visibility private)
      (effect pure)
      (parameter create trace (type Bytes))
      (parameter create cursor (type I64))
      (parameter create count (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local count) (i64 0))
          (bool true)
          (if
            (call ci::eq (local count) (i64 3))
            (call ci::both
              (call ci::lte (i64 0) (call ci::u64 (local trace) (call ci::add (local cursor) (i64 48))))
              (if
                (call ci::eq
                  (call ci::u64 (local trace) (call ci::add (local cursor) (i64 56)))
                  (i64 0))
                (call ci::eq
                  (call ci::u64 (local trace) (call ci::add (local cursor) (i64 64)))
                  (i64 0))
                (call ci::both
                  (call ci::eq
                    (call ci::u64 (local trace) (call ci::add (local cursor) (i64 56)))
                    (i64 1))
                  (call ci::lte
                    (i64 0)
                    (call ci::u64 (local trace) (call ci::add (local cursor) (i64 64)))))))
            (bool false)))))
    (function create scan
      (visibility private)
      (effect pure)
      (parameter create trace (type Bytes))
      (parameter create cursor (type I64))
      (parameter create pc (type I64))
      (parameter create count (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (bytes Bytes)))
      (body
        (if
          (call ci::eq (local cursor) (call ci::length (local trace)))
          (if
            (call ci::eq (local pc) (local count))
            (record structural (field code (i64 0)) (field bytes (call ci::freeze (local out))))
            (call failure (local out)))
          (if
            (call ci::lte (i64 48) (call ci::sub (call ci::length (local trace)) (local cursor)))
            (let
              (binding tag (call ci::u64 (local trace) (local cursor)))
              (binding items (call ci::u64 (local trace) (call ci::add (local cursor) (i64 40))))
              (binding width (call source-unit-code-pack::width (local tag)))
              (binding remaining
                (call ci::sub (call ci::sub (call ci::length (local trace)) (local cursor)) (i64 48)))
              (in
                (if
                  (call ci::both
                    (call ci::lte (i64 0) (local items))
                    (call ci::lte (local items) (call ci::div (local remaining) (local width))))
                  (if
                    (call ci::eq
                      (call ci::u64 (local trace) (call ci::add (local cursor) (i64 32)))
                      (i64 0))
                    (let
                      (binding next
                        (call ci::add
                          (call ci::add (local cursor) (i64 48))
                          (call ci::mul (local items) (local width))))
                      (in
                        (if
                          (call ci::eq (local tag) (i64 0))
                          (if
                            (call ci::both
                              (call ci::both
                                (call ci::lte
                                  (i64 0)
                                  (call ci::u64 (local trace) (call ci::add (local cursor) (i64 8))))
                                (call ci::lte
                                  (i64 0)
                                  (call ci::u64 (local trace) (call ci::add (local cursor) (i64 16)))))
                              (call ci::both
                                (call ci::lt (local pc) (local count))
                                (call ci::both
                                  (call ci::eq
                                    (call ci::u64 (local trace) (call ci::add (local cursor) (i64 24)))
                                    (local pc))
                                  (call metadata (local trace) (local cursor) (local items)))))
                            (if
                              (call source-unit-tables::room (call ci::size (local out)) (i64 24))
                              (let
                                (binding owner
                                  (type ByteBuffer)
                                  (call ci::le
                                    (call ci::u64 (local trace) (call ci::add (local cursor) (i64 8)))
                                    (i64 8)
                                    (local out)))
                                (binding label
                                  (type ByteBuffer)
                                  (call ci::le
                                    (call ci::u64 (local trace) (call ci::add (local cursor) (i64 16)))
                                    (i64 8)
                                    (local owner)))
                                (binding entry
                                  (type ByteBuffer)
                                  (call ci::le (local cursor) (i64 8) (local label)))
                                (in
                                  (call scan
                                    (local trace)
                                    (local next)
                                    (local pc)
                                    (local count)
                                    (local entry))))
                              (call failure (local out)))
                            (call failure (local out)))
                          (if
                            (call ci::both
                              (call ci::lt (i64 0) (local tag))
                              (call ci::lt (local pc) (local count)))
                            (call scan
                              (local trace)
                              (local next)
                              (call ci::add (local pc) (i64 1))
                              (local count)
                              (local out))
                            (call failure (local out))))))
                    (call failure (local out)))
                  (call failure (local out)))))
            (call failure (local out))))))
    (function create less
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create left (type I64))
      (parameter create right (type I64))
      (returns Bool)
      (body
        (let
          (binding a (call ci::u64 (local data) (local left)))
          (binding b (call ci::u64 (local data) (local right)))
          (in
            (if
              (call ci::lt (local a) (local b))
              (bool true)
              (if
                (call ci::eq (local a) (local b))
                (call ci::lt
                  (call ci::u64 (local data) (call ci::add (local left) (i64 8)))
                  (call ci::u64 (local data) (call ci::add (local right) (i64 8))))
                (bool false)))))))
    (function create merge
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create left (type I64))
      (parameter create left-end (type I64))
      (parameter create right (type I64))
      (parameter create right-end (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local left) (local left-end))
          (call ci::append-slice (local data) (local right) (local right-end) (local out))
          (if
            (call ci::eq (local right) (local right-end))
            (call ci::append-slice (local data) (local left) (local left-end) (local out))
            (if
              (call less (local data) (local right) (local left))
              (let
                (binding next
                  (type ByteBuffer)
                  (call ci::append-slice
                    (local data)
                    (local right)
                    (call ci::add (local right) (i64 24))
                    (local out)))
                (in
                  (call merge
                    (local data)
                    (local left)
                    (local left-end)
                    (call ci::add (local right) (i64 24))
                    (local right-end)
                    (local next))))
              (let
                (binding next
                  (type ByteBuffer)
                  (call ci::append-slice
                    (local data)
                    (local left)
                    (call ci::add (local left) (i64 24))
                    (local out)))
                (in
                  (call merge
                    (local data)
                    (call ci::add (local left) (i64 24))
                    (local left-end)
                    (local right)
                    (local right-end)
                    (local next)))))))))
    (function create run-end
      (visibility private)
      (effect pure)
      (parameter create start (type I64))
      (parameter create width (type I64))
      (parameter create count (type I64))
      (returns I64)
      (body
        (call ci::add
          (local start)
          (if
            (call ci::lt (local width) (call ci::sub (local count) (local start)))
            (local width)
            (call ci::sub (local count) (local start))))))
    (function create runs
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create start (type I64))
      (parameter create width (type I64))
      (parameter create count (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local start) (local count))
          (local out)
          (let
            (binding middle (call run-end (local start) (local width) (local count)))
            (binding end (call run-end (local middle) (local width) (local count)))
            (binding next
              (type ByteBuffer)
              (call merge
                (local data)
                (call ci::mul (local start) (i64 24))
                (call ci::mul (local middle) (i64 24))
                (call ci::mul (local middle) (i64 24))
                (call ci::mul (local end) (i64 24))
                (local out)))
            (in (call runs (local data) (local end) (local width) (local count) (local next)))))))
    (function create sort
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create width (type I64))
      (returns Bytes)
      (body
        (let
          (binding count (call ci::div (call ci::length (local data)) (i64 24)))
          (in
            (if
              (call ci::lte (local count) (local width))
              (local data)
              (let
                (binding empty (type ByteBuffer) (call ci::empty))
                (binding merged
                  (type ByteBuffer)
                  (call runs (local data) (i64 0) (local width) (local count) (local empty)))
                (binding next (call ci::freeze (local merged)))
                (binding next-width
                  (if
                    (call ci::lt (local width) (call ci::sub (local count) (local width)))
                    (call ci::mul (local width) (i64 2))
                    (local count)))
                (in (call sort (local next) (local next-width)))))))))
    (function create unique
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local at) (call ci::length (local data)))
          (bool true)
          (if
            (call ci::eq (local at) (i64 0))
            (call unique (local data) (call ci::add (local at) (i64 24)))

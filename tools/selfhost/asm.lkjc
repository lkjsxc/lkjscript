            (call ci::push (call ci::add (i64 78) (call ci::div (local base) (i64 8))) (local out)))
          (binding b (type ByteBuffer) (call ci::push (i64 141) (local a)))
          (binding c (type ByteBuffer) (call ci::push (i64 156) (local b)))
          (binding d
            (type ByteBuffer)
            (call ci::push (call ci::add (i64 24) (call low (local base))) (local c)))
          (in (call word (i64 0) (local d))))))
    (function create memory
      (visibility public)
      (effect pure)

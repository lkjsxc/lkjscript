declarations.begin
(units
  (module create asm
    (function create low
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (returns I64)
      (body (call ci::sub (local value) (call ci::mul (call ci::div (local value) (i64 8)) (i64 8)))))
    (function create rex
      (visibility public)
      (effect pure)
      (parameter create wide (type Bool))
      (parameter create reg (type I64))
      (parameter create base (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (call ci::push
          (call ci::add
            (if (local wide) (i64 72) (i64 64))
            (call ci::add
              (call ci::mul (call ci::div (local reg) (i64 8)) (i64 4))
              (call ci::div (local base) (i64 8))))
          (local out))))
    (function create word
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (call ci::le
          (if
            (call ci::lt (local value) (i64 0))
            (call ci::add (local value) (i64 4294967296))

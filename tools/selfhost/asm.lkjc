          (i64 4)
          (local out))))
    (function create opcode
      (visibility public)
      (effect pure)
      (parameter create value (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::lt (local value) (i64 256))
          (call ci::push (local value) (local out))
          (let
            (binding high (call ci::div (local value) (i64 256)))
            (binding a (type ByteBuffer) (call ci::push (local high) (local out)))
            (in
              (call ci::push
                (call ci::sub (local value) (call ci::mul (local high) (i64 256)))
                (local a)))))))
    (function create imm
      (visibility public)
      (effect pure)
      (parameter create dst (type I64))
      (parameter create value (type I64))
      (parameter create out (type ByteBuffer) (use consume))

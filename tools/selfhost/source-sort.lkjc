declarations.begin
(units (module create source-sort
  (function create merge (visibility private) (effect pure)
    (parameter create left (type Bytes)) (parameter create a (type I64))
    (parameter create right (type Bytes)) (parameter create b (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call ci::eq (local a) (call ci::length (local left)))
      (call wire::range (local right) (local b) (call ci::length (local right)) (local out))
      (if (call ci::eq (local b) (call ci::length (local right)))
        (call wire::range (local left) (local a) (call ci::length (local left)) (local out))
        (if (call ci::lt (call ci::u32 (local right) (local b))
              (call ci::u32 (local left) (local a)))
          (let (binding next (type ByteBuffer)
            (call wire::range (local right) (local b) (call ci::add (local b) (i64 12)) (local out)))
            (in (call merge (local left) (local a) (local right)
              (call ci::add (local b) (i64 12)) (local next))))
          (let (binding next (type ByteBuffer)
            (call wire::range (local left) (local a) (call ci::add (local a) (i64 12)) (local out)))
            (in (call merge (local left) (call ci::add (local a) (i64 12))
              (local right) (local b) (local next)))))))))
  (function create rows (visibility package) (effect pure)
    (parameter create data (type Bytes)) (returns Bytes)
    (body (if (call ci::lt (call ci::length (local data)) (i64 24)) (local data)
      (let
        (binding middle (call ci::mul
          (call ci::div (call ci::div (call ci::length (local data)) (i64 12)) (i64 2)) (i64 12)))
        (binding left (call rows (call ci::slice (local data) (i64 0) (local middle))))
        (binding right (call rows (call ci::slice (local data) (local middle) (call ci::length (local data)))))
        (binding empty (type ByteBuffer) (call ci::empty))
        (binding merged (type ByteBuffer)
          (call merge (local left) (i64 0) (local right) (i64 0) (local empty)))
        (in (call ci::freeze (local merged)))))))))
declarations.end

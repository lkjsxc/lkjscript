      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding count (call ci::div (call ci::length (local rows)) (i64 56)))
          (binding bytes (call artifact-order::byte-count (local rows) (i64 0) (i64 0)))
          (binding packed-size (call pack::encoded-size (local count) (local bytes)))

      (parameter create facts (type Bytes))
      (parameter create map-pages (type Bytes))
      (parameter create compilation (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (if
          (call pool-extent (call ci::length (local pool)) (call ci::length (local map-pages)))
          (if
            (call pool-extent

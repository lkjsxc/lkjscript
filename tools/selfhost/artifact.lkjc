                  (call pool-extent
                    (call ci::add (local used) (i64 8))
                    (call ci::length (local image)))
                  (let
                    (binding a
                      (type ByteBuffer)
                      (call ci::le (call ci::length (local image)) (i64 8) (local out)))
                    (binding b (type ByteBuffer) (call ci::append (local image) (i64 0) (local a)))
                    (in
                      (call unit-pool
                        (local data)
                        (call ci::add (local i) (i64 1))
                        (local count)
                        (local b))))
                  (sequence
                    (call ci::discard (local out))
                    (record structural
                      (field diagnostic (i64 3))
                      (field pool (call ci::text-bytes (text ""))))))
                (sequence
                  (call ci::discard (local out))

(units
  (module create artifact
    (function create pool-extent
      (visibility public)
      (effect pure)
      (parameter create base (type I64))
      (parameter create size (type I64))
      (returns Bool)
      (body
        (if
          (call ci::lt (local base) (i64 0))
          (bool false)
          (if
            (call ci::lt (local size) (i64 0))
            (bool false)
            (if
              (call ci::lt (i64 9223372036854775807) (local base))
              (bool false)
              (if
                (call ci::lt (call ci::sub (i64 9223372036854775807) (local base)) (local size))
                (bool false)
                (bool true)))))))
    (function create unit-pool
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create i (type I64))
      (parameter create count (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (diagnostic I64) (pool Bytes)))
      (body
        (if
          (call ci::eq (local i) (local count))
          (record structural (field diagnostic (i64 0)) (field pool (call ci::freeze (local out))))
          (let
            (binding at
              (call ci::add (call ci::u64 (local data) (i64 72)) (call ci::mul (local i) (i64 16))))
            (binding offset (call ci::u64 (local data) (local at)))
            (binding size (call ci::field64 (local data) (local at) (i64 8)))
            (binding unit
              (call ci::slice
                (local data)
                (local offset)
                (call ci::add (local offset) (local size))))
            (binding image (field (call unit-wire::encode-unit (local unit) (i64 0)) (name image)))
            (binding used (call ci::size (local out)))
            (in
              (if
                (call pool-extent (local used) (i64 8))

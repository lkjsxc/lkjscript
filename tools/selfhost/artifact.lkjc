          (binding b (type ByteBuffer) (call ci::le (i64 1) (i64 4) (local a)))
          (binding c (type ByteBuffer) (call ci::le (local offset) (i64 8) (local b)))
          (binding d (type ByteBuffer) (call ci::le (local size) (i64 8) (local c)))
          (in (call ci::append (local digest) (i64 0) (local d))))))
    (function create page-facts
      (visibility private)
      (effect pure)
      (parameter create pool (type Bytes))
      (parameter create at (type I64))
      (parameter create base (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (diagnostic I64) (rows Bytes)))
      (body
        (if
          (call ci::eq (local at) (call ci::length (local pool)))

declarations.begin
(units
  (module create aggregate
    (function create sequence
      (visibility private)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create layout (type Bytes))
      (parameter create at (type I64))
      (parameter create record (type Bool))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding count (call flow::field (local data) (local at) (i64 16)))
          (binding a
            (type ByteBuffer)
            (call asm::imm
              (i64 7)
              (call ci::mul (call ci::add (local count) (i64 1)) (i64 8))
              (local out)))
          (binding b (type ByteBuffer) (call machine::wide-call (i64 5120) (local a)))
          (binding c (type ByteBuffer) (call asm::imm (i64 9) (local count) (local b)))
          (binding d (type ByteBuffer) (call asm::store (i64 0) (i64 0) (i64 9) (local c)))
          (binding e
            (type ByteBuffer)
            (if
              (local record)
              (call asm::imm
                (i64 8)
                (call machine::data-address
                  (local data)
                  (local layout)
                  (call flow::field (local data) (local at) (i64 24)))
                (local d))
              (local d)))
          (binding f
            (type ByteBuffer)
            (call asm::binary (bool true) (i64 133) (i64 9) (i64 9) (local e)))
          (binding branch (call ci::size (local f)))
          (binding target (call ci::add (local branch) (if (local record) (i64 91) (i64 77))))
          (binding g (type ByteBuffer) (call elf::condition (i64 132) (local target) (local f)))
          (binding loop (call ci::size (local g)))
          (binding polled (type ByteBuffer) (call machine::wide-call (i64 51712) (local g)))
          (binding h
            (type ByteBuffer)
            (call elf::raw (list I64 (i64 73) (i64 255) (i64 201) (i64 89)) (local polled)))
          (binding i
            (type ByteBuffer)
            (if
              (local record)
              (let
                (binding x (type ByteBuffer) (call asm::mov (i64 7) (i64 9) (local h)))
                (binding y
                  (type ByteBuffer)
                  (call asm::shift (bool true) (i64 4) (i64 7) (i64 3) (local x)))
                (binding z
                  (type ByteBuffer)
                  (call asm::binary (bool true) (i64 1) (i64 7) (i64 8) (local y)))
                (in (call asm::load (i64 2) (i64 7) (i64 0) (local z))))
              (call asm::mov (i64 2) (i64 9) (local h))))
          (binding j (type ByteBuffer) (call asm::shift (bool true) (i64 4) (i64 2) (i64 3) (local i)))
          (binding k (type ByteBuffer) (call asm::lea (i64 7) (i64 0) (i64 8) (local j)))
          (binding l (type ByteBuffer) (call asm::binary (bool true) (i64 1) (i64 7) (i64 2) (local k)))
          (binding m (type ByteBuffer) (call asm::store (i64 7) (i64 0) (i64 1) (local l)))
          (binding n
            (type ByteBuffer)
            (call asm::binary (bool true) (i64 133) (i64 9) (i64 9) (local m)))
          (binding o (type ByteBuffer) (call elf::condition (i64 133) (local loop) (local n)))
          (in (call ci::push (i64 80) (local o))))))
    (function create instruction
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create layout (type Bytes))
      (parameter create at (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding tag (call flow::field (local data) (local at) (i64 0)))
          (in
            (if
              (call ci::eq (local tag) (i64 12))
              (let
                (binding a (type ByteBuffer) (call asm::imm (i64 7) (i64 16) (local out)))
                (binding b (type ByteBuffer) (call machine::wide-call (i64 5120) (local a)))
                (binding c
                  (type ByteBuffer)
                  (call asm::imm (i64 1) (call flow::field (local data) (local at) (i64 16)) (local b)))
                (binding d (type ByteBuffer) (call asm::store (i64 0) (i64 0) (i64 1) (local c)))
                (binding e
                  (type ByteBuffer)
                  (call asm::imm
                    (i64 1)
                    (call machine::data-address
                      (local data)
                      (local layout)
                      (call flow::field (local data) (local at) (i64 8)))
                    (local d)))
                (binding f (type ByteBuffer) (call asm::store (i64 0) (i64 8) (i64 1) (local e)))
                (in (call ci::push (i64 80) (local f))))
              (if
                (call ci::lt (local tag) (i64 15))
                (call sequence
                  (local data)
                  (local layout)
                  (local at)
                  (call ci::eq (local tag) (i64 14))
                  (local out))
                (let
                  (binding a (type ByteBuffer) (call ci::push (i64 88) (local out)))
                  (binding b
                    (type ByteBuffer)
                    (call asm::load
                      (i64 0)
                      (i64 0)
                      (call ci::mul
                        (call ci::add (call flow::field (local data) (local at) (i64 16)) (i64 1))
                        (i64 8))
                      (local a)))
                  (in (call ci::push (i64 80) (local b))))))))))))
declarations.end

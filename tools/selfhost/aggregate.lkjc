declarations.begin
(units (module create aggregate
  (function create sequence (visibility private) (effect pure)
    (parameter create data (type Bytes)) (parameter create at (type I64)) (parameter create record (type Bool))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let (binding start (call ci::size (local out)))
      (binding count (call flow::field (local data) (local at) (i64 8)))
      (binding a (type ByteBuffer) (call asm::imm (i64 7) (call ci::mul (call ci::add (local count) (i64 1)) (i64 8)) (local out)))
      (binding b (type ByteBuffer) (call machine::call (i64 5120) (local a)))
      (binding c (type ByteBuffer) (call asm::imm (i64 9) (local count) (local b)))
      (binding d (type ByteBuffer) (call asm::store (i64 0) (i64 0) (i64 9) (local c)))
      (binding e (type ByteBuffer) (if (local record) (call asm::imm (i64 8)
          (call machine::data-address (local data) (call flow::field (local data) (local at) (i64 12))) (local d)) (local d)))
      (binding f (type ByteBuffer) (call asm::binary (bool true) (i64 133) (i64 9) (i64 9) (local e)))
      (binding g (type ByteBuffer) (call elf::condition (i64 132) (call ci::add (local start) (i64 120)) (local f)))
      (binding h (type ByteBuffer) (call ci::pad (call ci::add (local start) (i64 72)) (i64 144) (local g)))
      (binding i (type ByteBuffer) (call elf::raw (list I64 (i64 73) (i64 255) (i64 201) (i64 89)) (local h)))
      (binding j (type ByteBuffer) (if (local record)
        (let (binding x (type ByteBuffer) (call asm::mov (i64 7) (i64 8) (local i)))
          (binding y (type ByteBuffer) (call asm::binary (bool true) (i64 1) (i64 7) (i64 9) (local x)))
          (in (call asm::memory (bool true) (i64 4022) (i64 2) (i64 7) (i64 0) (local y))))
        (call asm::mov (i64 2) (i64 9) (local i))))
      (binding k (type ByteBuffer) (call asm::shift (bool true) (i64 4) (i64 2) (i64 3) (local j)))
      (binding l (type ByteBuffer) (call asm::lea (i64 7) (i64 0) (i64 8) (local k)))
      (binding m (type ByteBuffer) (call asm::binary (bool true) (i64 1) (i64 7) (i64 2) (local l)))
      (binding n (type ByteBuffer) (call asm::store (i64 7) (i64 0) (i64 1) (local m)))
      (binding o (type ByteBuffer) (call asm::binary (bool true) (i64 133) (i64 9) (i64 9) (local n)))
      (binding p (type ByteBuffer) (call elf::condition (i64 133) (call ci::add (local start) (i64 72)) (local o)))
      (binding q (type ByteBuffer) (call ci::pad (call ci::add (local start) (i64 120)) (i64 144) (local p)))
      (in (call ci::push (i64 80) (local q))))))
  (function create instruction (visibility public) (effect pure)
    (parameter create data (type Bytes)) (parameter create at (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let (binding tag (call flow::field (local data) (local at) (i64 0)))
      (in (if (call ci::eq (local tag) (i64 12))
        (let (binding a (type ByteBuffer) (call asm::imm (i64 7) (i64 16) (local out)))
          (binding b (type ByteBuffer) (call machine::call (i64 5120) (local a)))
          (binding c (type ByteBuffer) (call asm::imm (i64 1) (call flow::field (local data) (local at) (i64 8)) (local b)))
          (binding d (type ByteBuffer) (call asm::store (i64 0) (i64 0) (i64 1) (local c)))
          (binding e (type ByteBuffer) (call asm::imm (i64 1) (call machine::data-address (local data) (call flow::field (local data) (local at) (i64 4))) (local d)))
          (binding f (type ByteBuffer) (call asm::store (i64 0) (i64 8) (i64 1) (local e)))
          (in (call ci::push (i64 80) (local f))))
        (if (call ci::lt (local tag) (i64 15)) (call sequence (local data) (local at) (call ci::eq (local tag) (i64 14)) (local out))
          (let (binding a (type ByteBuffer) (call ci::push (i64 88) (local out)))
            (binding b (type ByteBuffer) (call asm::load (i64 0) (i64 0)
              (call ci::mul (call ci::add (call flow::field (local data) (local at) (i64 8)) (i64 1)) (i64 8)) (local a)))
            (in (call ci::push (i64 80) (local b))))))))))
))
declarations.end

declarations.begin
(units (module create source-custody-lower
  (function create result (visibility private) (effect pure)
    (parameter create code (type I64)) (parameter create tag (type I64))
    (parameter create b (type I64)) (parameter create state (type I64))
    (parameter create forced (type I64)) (parameter create live (type I64))
    (returns (record (code I64) (tag I64) (b I64) (state I64) (forced I64) (live I64)))
    (body (record structural (field code (local code)) (field tag (local tag))
      (field b (local b)) (field state (local state))
      (field forced (local forced)) (field live (local live)))))
  (function create state-tag (visibility private) (effect pure)
    (parameter create tag (type I64)) (returns I64)
    (body (if (call ci::either (call ci::lt (local tag) (i64 5)) (call ci::eq (local tag) (i64 12))) (i64 2)
      (if (call ci::eq (local tag) (i64 5)) (i64 5)
        (if (call ci::eq (local tag) (i64 6)) (i64 7)
          (if (call ci::eq (local tag) (i64 8)) (i64 8)
            (if (call ci::either (call ci::eq (local tag) (i64 9)) (call ci::eq (local tag) (i64 10))) (i64 12)
              (if (call ci::eq (local tag) (i64 11)) (i64 14) (i64 16)))))))))
  (function create selected (visibility private) (effect pure)
    (parameter create evidence (type Bytes)) (parameter create entries (type Bytes))
    (parameter create directory (type Bytes)) (parameter create tag (type I64))
    (parameter create anchor (type I64)) (parameter create row (type I64))
    (returns I64)
    (body (if (call ci::eq (local tag) (i64 7))
      (let (binding repair (call source-custody-index::latest
        (local evidence) (local entries) (local directory) (local row) (i64 10) (i64 -1) (i64 -1)))
        (in (if (call ci::lt (local repair) (i64 0))
          (call source-custody-index::find (local evidence) (local entries) (local directory)
            (local row) (i64 9) (i64 -1) (i64 -1)) (local repair))))
      (call source-custody-index::find (local evidence) (local entries) (local directory)
        (local anchor) (call state-tag (local tag))
        (if (call ci::eq (local tag) (i64 6)) (local row) (i64 -1)) (i64 -1)))))
  (function create qualifier (visibility package) (effect pure)
    (parameter create evidence (type Bytes)) (parameter create entries (type Bytes))
    (parameter create directory (type Bytes)) (parameter create row (type I64))
    (returns I64)
    (body (if (call ci::lt (call source-custody-index::find
      (local evidence) (local entries) (local directory) (local row) (i64 4) (i64 -1) (i64 -1)) (i64 0))
      (i64 0) (i64 1))))
  (function create local-qualifier (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create row (type I64))
    (returns I64)
    (body (if (call ci::eq (call source-table::kind (local graph) (local row)) (i64 15))
      (if (call ci::eq (call source-custody-signature::mode (local graph) (local row)) (i64 1))
        (i64 1) (i64 0)) (i64 0))))
  (function create instruction (visibility package) (effect pure)
    (parameter create facts (type Bytes)) (parameter create evidence (type Bytes))
    (parameter create entries (type Bytes)) (parameter create directory (type Bytes))
    (parameter create tag (type I64)) (parameter create b (type I64))
    (parameter create anchor (type I64)) (parameter create row (type I64))
    (returns (record (code I64) (tag I64) (b I64) (state I64) (forced I64) (live I64)))
    (body (let (binding state (call selected (local evidence) (local entries) (local directory)
      (local tag) (local anchor) (local row)))
      (in (if (call ci::lt (local state) (i64 0))
        (call result (i64 19) (local tag) (local b) (i64 0) (i64 -1) (i64 0))
        (if (call ci::both (call ci::eq (local tag) (i64 4))
              (call ci::eq (call source-scalar-infer::fact (local facts) (local anchor)) (i64 6)))
          (let (binding moved (call source-custody-index::find
            (local evidence) (local entries) (local directory) (local anchor) (i64 3) (i64 -1) (i64 -1)))
            (in (if (call ci::lt (local moved) (i64 0))
              (let (binding borrowed (call qualifier (local evidence) (local entries) (local directory) (local anchor)))
                (in (call result (if (call ci::eq (local borrowed) (i64 1)) (i64 0) (i64 19))
                  (i64 4) (local borrowed) (local state) (i64 -1) (i64 0))))
              (call result (i64 0) (i64 16) (i64 0) (local state) (i64 -1) (i64 0)))))
          (call result (i64 0)
            (if (call ci::eq (local tag) (i64 10))
              (if (call ci::eq (call ci::u64 (local evidence) (call ci::add (local state) (i64 24))) (i64 1))
                (i64 10) (i64 9)) (local tag))
            (local b) (local state)
            (if (call ci::eq (local tag) (i64 5)) (local anchor) (i64 -1)) (i64 0))))))))
))
declarations.end

declarations.begin
(units (module create source-custody-drop
  (function create outcome (visibility private) (effect pure)
    (parameter create code (type I64)) (parameter create count (type I64))
    (parameter create out (type ByteBuffer) (use consume))
    (returns (record (code I64) (count I64) (rows Bytes)))
    (body (record structural (field code (local code)) (field count (local count))
      (field rows (call ci::freeze (local out))))))
  (function create event (visibility private) (effect pure)
    (parameter create tag (type I64)) (parameter create slot (type I64))
    (parameter create anchor (type I64))
    (returns (record (row I64) (enter Bool) (tag I64) (a I64) (b I64) (value I64) (anchor I64) (extra I64)))
    (body (record structural (field row (local anchor)) (field enter (bool false))
      (field tag (local tag)) (field a (local slot)) (field b (i64 0))
      (field value (i64 0)) (field anchor (local anchor)) (field extra (i64 0)))))
  (function create walk (visibility private) (effect pure)
    (parameter create graph (type Bytes)) (parameter create facts (type Bytes))
    (parameter create parents (type Bytes)) (parameter create plan (type Bytes))
    (parameter create locals (type Bytes)) (parameter create start (type I64))
    (parameter create count (type I64)) (parameter create parameters (type I64))
    (parameter create owner (type I64)) (parameter create evidence (type Bytes))
    (parameter create entries (type Bytes)) (parameter create anchor (type I64))
    (parameter create at (type I64)) (parameter create end (type I64))
    (parameter create operands (type Bytes)) (parameter create drop-operands (type Bytes))
    (parameter create limit (type I64)) (parameter create emitted (type I64))
    (parameter create out (type ByteBuffer) (use consume))
    (returns (record (code I64) (count I64) (rows Bytes)))
    (body (if (call ci::eq (local at) (local end))
      (call outcome (i64 0) (local emitted) (local out))
      (let
        (binding selected (call source-custody-index::offset (local entries) (local at)))
        (binding tag (call ci::u64 (local evidence) (local selected)))
        (in (if (call ci::either (call ci::eq (local tag) (i64 6)) (call ci::eq (local tag) (i64 10)))
          (let
            (binding local (call ci::u64 (local evidence) (call ci::add (local selected) (i64 16))))
            (binding slot (call source-scalar-plan::slot (local plan) (local local)))
            (binding move-size (call source-scalar-trace::node-size (local count) (call ci::length (local operands)) (i64 0)))
            (binding drop-size (call source-scalar-trace::node-size (local count) (call ci::length (local drop-operands)) (i64 0)))
            (in (if (call ci::either (call ci::lt (local move-size) (i64 0)) (call ci::lt (local drop-size) (i64 0)))
              (call outcome (i64 13) (local emitted) (local out))
              (if (call ci::lt (call ci::sub (local limit) (call ci::size (local out))) (local move-size))
                (call outcome (i64 13) (local emitted) (local out))
                (if (call ci::lt (call ci::sub (call ci::sub (local limit) (call ci::size (local out))) (local move-size)) (local drop-size))
                  (call outcome (i64 13) (local emitted) (local out))
                  (if (call ci::either (call ci::lt (local slot) (i64 0)) (if (call ci::lt (local slot) (local count)) (bool false) (bool true)))
                    (call outcome (i64 19) (local emitted) (local out))
                    (let
                      (binding moved (type ByteBuffer)
                        (call source-scalar-trace::node (local graph) (local facts)
                          (call event (i64 16) (local slot) (local anchor)) (local operands)
                          (local parents) (local locals) (local start) (local count) (local parameters) (local owner)
                          (local evidence) (local selected) (local local) (i64 1) (local out)))
                      (binding dropped (type ByteBuffer)
                        (call source-scalar-trace::node (local graph) (local facts)
                          (call event (i64 6) (i64 0) (local anchor)) (local drop-operands)
                          (local parents) (local locals) (local start) (local count) (local parameters) (local owner)
                          (local evidence) (local selected) (i64 -1) (i64 0) (local moved)))
                      (in (call walk (local graph) (local facts) (local parents) (local plan)
                        (local locals) (local start) (local count) (local parameters) (local owner)
                        (local evidence) (local entries) (local anchor) (call ci::add (local at) (i64 12)) (local end)
                        (local operands) (local drop-operands) (local limit) (call ci::add (local emitted) (i64 2))
                        (local dropped))))))))))
          (call walk (local graph) (local facts) (local parents) (local plan)
            (local locals) (local start) (local count) (local parameters) (local owner)
            (local evidence) (local entries) (local anchor) (call ci::add (local at) (i64 12)) (local end)
            (local operands) (local drop-operands) (local limit) (local emitted) (local out))))))))
  (function create block (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create facts (type Bytes))
    (parameter create parents (type Bytes)) (parameter create plan (type Bytes))
    (parameter create locals (type Bytes)) (parameter create start (type I64))
    (parameter create count (type I64)) (parameter create parameters (type I64))
    (parameter create owner (type I64)) (parameter create evidence (type Bytes))
    (parameter create entries (type Bytes)) (parameter create directory (type Bytes))
    (parameter create anchor (type I64)) (parameter create limit (type I64))
    (returns (record (code I64) (count I64) (rows Bytes)))
    (body (if (call ci::eq (call source-custody-index::count-drops
      (local evidence) (local entries) (local directory) (local anchor)) (i64 0))
      (record structural (field code (i64 0)) (field count (i64 0)) (field rows (call ci::text-bytes (text ""))))
      (let
        (binding operands (call source-scalar-state::operands (local graph) (local parents) (local facts)
          (local evidence) (local entries) (local directory) (local anchor) (local owner) (i64 16)
          (call source-scalar-infer::fact (local facts) (local anchor))))
        (in (if (call ci::both (call ci::eq (field (local operands) (name code)) (i64 0))
            (if (call ci::lt (i64 9223372036854775791) (call ci::length (field (local operands) (name bytes)))) (bool false) (bool true)))
          (let
            (binding stack (field (local operands) (name bytes)))
            (binding drop-buffer (type ByteBuffer) (call ci::empty))
            (binding extended (type ByteBuffer) (call ci::append (local stack) (i64 0) (local drop-buffer)))
            (binding with-buffer (type ByteBuffer) (call source-scalar-pack::value-type (i64 6) (local extended)))
            (binding drop-stack (call ci::freeze (local with-buffer)))
            (binding out (type ByteBuffer) (call ci::empty))
            (in (call walk (local graph) (local facts) (local parents) (local plan)
              (local locals) (local start) (local count) (local parameters) (local owner)
              (local evidence) (local entries) (local anchor)
              (call source-custody-index::start (local directory) (local anchor))
              (call source-custody-index::end (local directory) (local anchor))
              (local stack) (local drop-stack) (local limit) (i64 0) (local out))))
          (record structural (field code (if (call ci::eq (field (local operands) (name code)) (i64 0)) (i64 13) (field (local operands) (name code))))
            (field count (i64 0)) (field rows (call ci::text-bytes (text ""))))))))))
))
declarations.end

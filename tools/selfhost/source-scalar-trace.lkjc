declarations.begin
(units
  (module create source-scalar-trace
    (function create failure
      (visibility private) (effect pure)
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (rows Bytes)))
      (body (record structural (field code (i64 13)) (field rows (call ci::freeze (local out))))))

    (function create types
      (visibility private) (effect pure)
      (parameter create facts (type Bytes))
      (parameter create locals (type Bytes))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (parameter create index (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body (if (call ci::eq (local index) (local count))
        (local out)
        (let
          (binding owner
            (call source-scalar-plan::local-owner (local locals) (call ci::add (local start) (local index))))
          (binding next (type ByteBuffer) (call ci::push (call ci::get (local facts) (local owner)) (local out)))
          (in
            (call types (local facts) (local locals) (local start) (local count)
              (call ci::add (local index) (i64 1)) (local next)))))))

    (function create node
      (visibility private) (effect pure)
      (parameter create event (type (record (row I64) (enter Bool) (tag I64) (a I64) (b I64) (value I64) (anchor I64) (extra I64))))
      (parameter create operands (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create locals (type Bytes))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (parameter create parameters (type I64))
      (parameter create owner (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body (let
        (binding a (type ByteBuffer) (call ci::le (field (local event) (name tag)) (i64 4) (local out)))
        (binding b (type ByteBuffer) (call ci::le (field (local event) (name a)) (i64 4) (local a)))
        (binding c (type ByteBuffer) (call ci::le (field (local event) (name b)) (i64 4) (local b)))
        (binding d (type ByteBuffer) (call ci::le (i64 0) (i64 4) (local c)))
        (binding e (type ByteBuffer)
          (call ci::append (call source-scalar-pack::signed (field (local event) (name value))) (i64 0) (local d)))
        (binding f (type ByteBuffer) (call ci::le (i64 0) (i64 4) (local e)))
        (binding g (type ByteBuffer) (call ci::le (call ci::length (local operands)) (i64 4) (local f)))
        (binding h (type ByteBuffer)
          (call source-scalar-state::flags (local parents) (local locals) (local start) (local count)
            (local parameters) (i64 0) (field (local event) (name anchor)) (local owner) (local g)))
        (in (call ci::append (local operands) (i64 0) (local h))))))

    (function create walk
      (visibility private) (effect pure)
      (parameter create graph (type Bytes))
      (parameter create facts (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create locals (type Bytes))
      (parameter create function (type I64))
      (parameter create start (type I64))
      (parameter create row (type I64))
      (parameter create enter (type Bool))
      (parameter create pc (type I64))
      (parameter create limit (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (rows Bytes)))
      (body (if
        (call ci::eq (local function) (call source-scalar-plan::function-count (local functions)))
        (record structural (field code (i64 0)) (field rows (call ci::freeze (local out))))
        (let
          (binding owner (call source-scalar-plan::function-owner (local functions) (local function)))
          (binding count (call source-scalar-plan::local-count (local functions) (local function)))
          (in
            (if (call ci::eq (local row) (call source-table::count (local graph)))
              (if (call ci::lt (call ci::sub (local limit) (call ci::size (local out))) (local count))
                (call failure (local out))
                (let
                  (binding source (call source-table::data (local graph) (local owner)))
                  (binding parts (call source-scalar-profile::function-parts (local graph) (local owner)))
                  (binding body
                    (call source-table::owner (local graph) (local source)
                      (field (local parts) (name body)) (i64 9)))
                  (binding next (type ByteBuffer)
                    (call types (local facts) (local locals) (local start) (local count) (i64 0) (local out)))
                  (in
                    (call walk (local graph) (local facts) (local parents) (local plan)
                      (local functions) (local locals) (local function) (local start)
                      (local body) (bool true) (i64 0) (local limit) (local next)))))
              (let
                (binding event
                  (call source-scalar-cursor::next (local graph) (local parents) (local facts) (local plan)
                    (local row) (local enter) (local pc)))
                (in
                  (if (call ci::eq (field (local event) (name tag)) (i64 0))
                    (call walk (local graph) (local facts) (local parents) (local plan)
                      (local functions) (local locals) (local function) (local start)
                      (field (local event) (name row)) (field (local event) (name enter))
                      (local pc) (local limit) (local out))
                    (if
                      (call ci::lt (local pc) (call source-scalar-plan::node-count (local plan) (local owner)))
                      (let
                        (binding operands
                          (call source-scalar-state::operands (local graph) (local parents) (local facts)
                            (field (local event) (name anchor)) (local owner)
                            (field (local event) (name tag)) (field (local event) (name extra))))
                        (in
                          (if (call ci::eq (field (local operands) (name code)) (i64 0))
                            (let
                              (binding increment
                                (call ci::add (i64 32)
                                  (call ci::add (local count) (call ci::length (field (local operands) (name bytes))))))
                              (in
                                (if (call ci::lt (call ci::sub (local limit) (call ci::size (local out))) (local increment))
                                  (call failure (local out))
                                  (let
                                    (binding next (type ByteBuffer)
                                      (call node (local event) (field (local operands) (name bytes))
                                        (local parents) (local locals) (local start) (local count)
                                        (call source-scalar-plan::parameter-count (local functions) (local function))
                                        (local owner) (local out)))
                                    (binding next-pc (call ci::add (local pc) (i64 1)))
                                    (in
                                      (if (call ci::eq (field (local event) (name tag)) (i64 11))
                                        (if
                                          (call ci::eq (local next-pc)
                                            (call source-scalar-plan::node-count (local plan) (local owner)))
                                          (call walk (local graph) (local facts) (local parents) (local plan)
                                            (local functions) (local locals) (call ci::add (local function) (i64 1))
                                            (call ci::add (local start) (local count))
                                            (call source-table::count (local graph)) (bool true) (i64 0)
                                            (local limit) (local next))
                                          (call failure (local next)))
                                        (call walk (local graph) (local facts) (local parents) (local plan)
                                          (local functions) (local locals) (local function) (local start)
                                          (field (local event) (name row)) (field (local event) (name enter))
                                          (local next-pc) (local limit) (local next))))))))
                            (call failure (local out)))))
                      (call failure (local out))))))))))))

    (function create encode
      (visibility package) (effect pure)
      (parameter create graph (type Bytes))
      (parameter create facts (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create locals (type Bytes))
      (returns (record (code I64) (rows Bytes)))
      (body
        (let
          (binding owner-count (call source-table::count (local graph)))
          (binding trace-limit (call ci::sub (i64 8386432) (call ci::mul (call source-scalar-plan::function-count (local functions)) (i64 40))))
          (binding trace-buffer (type ByteBuffer) (call ci::empty))
          (in
            (call walk
              (local graph)
              (local facts)
              (local parents)
              (local plan)
              (local functions)
              (local locals)
              (i64 0)
              (i64 0)
              (local owner-count)
              (bool true)
              (i64 0)
              (local trace-limit)
              (local trace-buffer))))))
  ))
declarations.end

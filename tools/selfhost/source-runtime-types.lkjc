  (function create prepare (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create types (type Bytes))
    (parameter create source-map (type Bytes)) (parameter create facts (type Bytes))
    (returns (record (code I64) (facts Bytes) (fields Bytes) (mapping Bytes) (records Bytes)))
    (body (let
      (binding map-buffer (type ByteBuffer) (call ci::empty))
      (binding record-buffer (type ByteBuffer) (call ci::empty))
      (binding indexed (call index (local types) (i64 1) (i64 8) (local map-buffer) (local record-buffer)))
      (binding fact-buffer (type ByteBuffer) (call ci::empty))
      (binding field-buffer (type ByteBuffer) (call ci::empty))
      (binding converted (call facts (local graph) (local types) (local source-map) (local facts)

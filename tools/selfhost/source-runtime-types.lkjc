        (field fields (field (local converted) (name fields)))
        (field mapping (field (local indexed) (name mapping)))
        (field records (field (local indexed) (name records))))))))
  (function create quad (visibility private) (effect pure)
    (parameter create a (type I64)) (parameter create b (type I64))
    (parameter create c (type I64)) (parameter create d (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)

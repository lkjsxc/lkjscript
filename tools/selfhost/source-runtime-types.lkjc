      (binding third (type ByteBuffer) (call ci::le (local c) (i64 8) (local second)))
      (in (call ci::le (local d) (i64 8) (local third))))))
  (function create field-rows (visibility private) (effect pure)
    (parameter create types (type Bytes)) (parameter create mapping (type Bytes))
    (parameter create semantic (type I64)) (parameter create runtime (type I64))

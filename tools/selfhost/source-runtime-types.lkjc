    (parameter create index (type I64)) (parameter create count (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call ci::eq (local index) (local count)) (local out)
      (let (binding next (type ByteBuffer) (call ci::append

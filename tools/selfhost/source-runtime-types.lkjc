              (call ci::slice (local data) (field (local name) (name next))
                (call ci::add (field (local name) (name next)) (field (local name) (name value)))))))
          (i64 0)))) (i64 0))))
  (function create facts (visibility private) (effect pure)
    (parameter create graph (type Bytes)) (parameter create types (type Bytes))
    (parameter create source-map (type Bytes)) (parameter create semantic (type Bytes))

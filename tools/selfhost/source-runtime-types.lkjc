        (binding at (call ci::mul (local middle) (i64 16)))
        (binding key (call ci::u64 (local mapping) (local at)))
        (in (if (call ci::eq (local key) (local identity))
          (call ci::u64 (local mapping) (call ci::add (local at) (i64 8)))
          (if (call ci::lt (local identity) (local key))
            (call find (local mapping) (local identity) (local low) (local middle))
            (call find (local mapping) (local identity)
              (call ci::add (local middle) (i64 1)) (local high)))))))))
  (function create identity (visibility package) (effect pure)

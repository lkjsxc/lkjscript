              (in (call field-rows (local types) (local mapping) (local semantic) (local runtime)
                (call ci::add (local index) (i64 1)) (local count) (call ci::add (local at) (local size)) (local next)))))
          (record structural (field code (i64 13)) (field next (local at)) (field rows (call ci::freeze (local out)))))))))

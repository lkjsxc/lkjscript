declarations.begin
(units
  (module create source-custody-call
    (function create tail-owner
      (visibility private) (effect pure)
      (parameter create graph (type Bytes)) (parameter create parents (type Bytes))
      (parameter create row (type I64)) (returns I64)
      (body (let
        (binding parent (call source-table::parent (local parents) (local row)))
        (binding kind (call source-table::kind (local graph) (local parent)))
        (in (if (call ci::eq (local kind) (i64 6)) (local parent)
          (if (call ci::eq (local kind) (i64 17))
            (let
              (binding data (call source-table::data (local graph) (local parent)))
              (binding op (call ci::get (local data) (i64 37)))
              (binding position (call source-table::column (local parents) (local row) (i64 8)))
              (binding tail (if (call ci::eq (local op) (i64 7)) (call ci::lt (i64 0) (local position))
                (if (call ci::eq (local op) (i64 8))
                  (call ci::eq (local position) (field (call source-table::array (local data) (i64 38)) (name value)))
                  (if (call ci::eq (local op) (i64 9))
                    (call ci::eq (call ci::add (local position) (i64 1))
                      (field (call source-table::array (local data) (i64 38)) (name value))) (bool false)))))
              (in (if (local tail) (call tail-owner (local graph) (local parents) (local parent)) (i64 -1))))
            (i64 -1)))))))
    (function create release
      (visibility private) (effect pure)
      (parameter create graph (type Bytes)) (parameter create mapping (type Bytes))
      (parameter create row (type I64)) (parameter create target (type I64))
      (parameter create remaining (type I64)) (parameter create state (type Bytes))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (code I64) (state Bytes) (events Bytes)))
      (body (if (call ci::eq (local remaining) (i64 0))
        (call source-custody-state::outcome (i64 0) (local state) (call ci::freeze (local out)))
        (let
          (binding index (call ci::sub (local remaining) (i64 1)))
          (binding parameter (call source-custody-signature::parameter (local graph) (local target) (local index)))
          (in (if (call ci::eq (call source-custody-signature::mode (local graph) (local parameter)) (i64 1))
            (let
              (binding call-data (call source-table::data (local graph) (local row)))
              (binding argument (call source-scalar-cursor::array-child (local graph) (local call-data)
                (call source-scalar-cursor::arguments (local call-data)) (local index) (i64 9)))
              (binding owner (call source-custody-signature::local-owner (local graph)
                (call source-table::data (local graph) (local argument))))
              (binding released (call source-custody-state::release (local state) (local owner) (local row)))
              (binding events (field (local released) (name events)))
              (in (if (call ci::eq (field (local released) (name code)) (i64 0))
                (if (call source-custody-state::room (call ci::size (local out)) (call ci::length (local events)))
                  (let (binding more (type ByteBuffer) (call ci::append (local events) (i64 0) (local out)))
                    (in (call release (local graph) (local mapping) (local row) (local target) (local index)
                      (field (local released) (name state)) (local more))))
                  (call source-custody-state::outcome (i64 13) (local state) (call ci::freeze (local out))))
                (call source-custody-state::outcome (field (local released) (name code)) (local state) (call ci::freeze (local out))))))
            (call release (local graph) (local mapping) (local row) (local target) (local index) (local state) (local out))))))))
    (function create complete
      (visibility private) (effect pure)
      (parameter create input (type (record (graph Bytes) (parents Bytes) (types Bytes)
        (mapping Bytes) (facts Bytes) (owner I64))))
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (parameter create target (type I64))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (let
        (binding graph (field (local input) (name graph)))
        (binding row (field (local current) (name row)))
        (binding result (call source-scalar-infer::fact (field (local input) (name facts)) (local row)))
        (binding tail (call ci::both
          (call ci::eq (call tail-owner (local graph) (field (local input) (name parents)) (local row)) (field (local input) (name owner)))
          (call ci::both
            (call ci::eq (local result) (call source-custody-signature::result-type (local graph)
              (field (local input) (name mapping)) (field (local input) (name owner))))
            (call source-custody-state::clear (field (local current) (name state)) (i64 0)))))
        (binding out (type ByteBuffer) (call ci::empty))
        (binding released (call release (local graph) (field (local input) (name mapping)) (local row) (local target)
          (call source-custody-signature::count (local graph) (local target)) (field (local current) (name state)) (local out)))
        (in (if (call ci::eq (field (local released) (name code)) (i64 0))
          (call source-custody-machine::prepend
            (call source-custody-machine::finish (local row) (field (local current) (name mode))
              (call source-custody-signature::owned (local result)) (local tail)
              (field (local released) (name state)) (field (local current) (name stack)) (field (local released) (name events)))
            (call source-custody-state::event (i64 12) (local row) (local target)
              (if (local tail) (i64 1) (i64 0)) (field (local current) (name state))))
          (call source-custody-machine::fail (field (local released) (name code)) (local row)
            (field (local current) (name state)) (field (local current) (name stack))))))))
    (function create next
      (visibility package) (effect pure)
      (parameter create input (type (record (graph Bytes) (parents Bytes) (types Bytes)
        (mapping Bytes) (facts Bytes) (owner I64))))
      (parameter create current (type (record (code I64) (row I64) (enter Bool) (mode I64)
        (owned Bool) (terminal Bool) (state Bytes) (stack Bytes) (events Bytes))))
      (parameter create index (type I64))
      (returns (record (code I64) (row I64) (enter Bool) (mode I64) (owned Bool)
        (terminal Bool) (state Bytes) (stack Bytes) (events Bytes)))
      (body (let
        (binding graph (field (local input) (name graph)))
        (binding row (field (local current) (name row)))
        (binding data (call source-table::data (local graph) (local row)))
        (binding target (call source-table::owner (local graph) (local data) (i64 57) (i64 2)))
        (binding count (call source-custody-signature::count (local graph) (local target)))
        (in (if (call ci::eq (local index) (local count)) (call complete (local input) (local current) (local target))
          (let
            (binding parameter (call source-custody-signature::parameter (local graph) (local target) (local index)))
            (binding expected (call source-custody-signature::parameter-type (local graph) (field (local input) (name mapping)) (local parameter)))
            (binding mode (call source-custody-signature::mode (local graph) (local parameter)))
            (binding argument (call source-scalar-cursor::array-child (local graph) (local data)
              (call source-scalar-cursor::arguments (local data)) (local index) (i64 9)))
            (binding actual (call source-table::data (local graph) (local argument)))
            (binding valid (if (call source-custody-signature::owned (local expected))
              (if (call ci::eq (call ci::get (local actual) (i64 37)) (i64 5))
                (call ci::eq (call source-custody-signature::local-type (local graph) (field (local input) (name mapping))
                  (call source-custody-signature::local-owner (local graph) (local actual))) (local expected))
                (bool false))
              (call ci::eq (local mode) (i64 0))))
            (in (if (local valid)
              (call source-custody-machine::descend (local current) (i64 7) (local index) (i64 0) (i64 0)
                (call source-custody-state::empty) (local argument) (local mode) (field (local current) (name state)))
              (call source-custody-machine::fail (i64 19) (local row)
                (field (local current) (name state)) (field (local current) (name stack)))))))))))
  ))
declarations.end

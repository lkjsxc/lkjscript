    (parameter create at (type I64)) (parameter create count (type I64))
    (parameter create parent (type I64)) (parameter create position (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call ci::eq (local count) (i64 0)) (local out)

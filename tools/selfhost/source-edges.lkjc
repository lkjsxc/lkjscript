        (in (call items (local graph) (local data) (call ci::add (local at) (i64 17))
          (call ci::sub (local count) (i64 1)) (local domain) (local parent)
          (call ci::add (local position) (i64 1)) (local next)))))))
  (function create array (visibility package) (effect pure)

  (function create expression (visibility package) (effect pure)
    (parameter create graph (type Bytes)) (parameter create data (type Bytes))
    (parameter create parent (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let (binding op (call ci::get (local data) (i64 37)))
      (in (if (call ci::lt (local op) (i64 7)) (local out)
        (if (call ci::eq (local op) (i64 7))
          (call items (local graph) (local data) (i64 38) (i64 3) (i64 9) (local parent) (i64 0) (local out))
          (if (call ci::eq (local op) (i64 8))
            (let
              (binding parsed (call source-table::array (local data) (i64 38)))
              (binding next (type ByteBuffer) (call items (local graph) (local data)

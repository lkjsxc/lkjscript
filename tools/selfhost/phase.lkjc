declarations.begin
(units (module create phase
  (function create fits (visibility private) (effect pure)
    (parameter create part (type (record (code I64) (bytes Bytes))))
    (parameter create width (type I64)) (returns Bool)
    (body (call ci::both (call ci::eq (field (local part) (name code)) (i64 0))
      (call ci::lte (call ci::length (field (local part) (name bytes))) (local width)))))
  (function create header (visibility public) (effect pure)
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let
      (binding a (type ByteBuffer) (call ci::pad (i64 256) (i64 0) (local out)))
      (binding b (type ByteBuffer) (call ci::append (call ci::text-bytes (text "LKJPH001")) (i64 0) (local a)))
      (binding c (type ByteBuffer) (call ci::le (i64 64) (i64 8) (local b)))
      (binding d (type ByteBuffer) (call ci::le (i64 160) (i64 8) (local c)))
      (binding e (type ByteBuffer) (call ci::le (i64 24) (i64 8) (local d)))
      (binding f (type ByteBuffer) (call ci::le (i64 4247040) (i64 8) (local e)))
      (binding g (type ByteBuffer) (call ci::le (i64 4251136) (i64 8) (local f)))
      (binding h (type ByteBuffer) (call ci::le (i64 1) (i64 8) (local g)))
      (in (call ci::le (i64 0) (i64 8) (local h))))))
  (function create trap (visibility public) (effect pure)
    (parameter create message (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let
      (binding a (type ByteBuffer) (call ci::push (i64 184) (local out)))
      (binding b (type ByteBuffer) (call ci::le (local message) (i64 4) (local a)))
      (in (call machine::call (i64 57856) (local b))))))
  (function create emit (visibility public) (effect pure)
    (parameter create data (type Bytes)) (parameter create layout (type Bytes))
    (parameter create prefix (type (record (code I64) (bytes Bytes))))
    (returns (record (code I64) (bytes Bytes)))
    (body (let
      (binding start-code (call phase-code::start (local data) (local layout)))
      (binding allocate-code (call phase-code::allocate))
      (binding dispose-code (call phase-code::dispose))
      (binding poll-code (call phase-code::poll))
      (binding copy-code (call phase-code::copy))
      (binding abort-code (call phase-code::abort))
      (binding invoke-code (call phase-code::invoke (local data) (local layout)))
      (binding release-code (call phase-code::release))
      (binding trap-code (call phase-code::trap))
      (in (if (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::both (call ci::eq (field (local prefix) (name code)) (i64 0)) (call ci::eq (call ci::length (field (local prefix) (name bytes))) (i64 49152))) (call fits (local start-code) (i64 512))) (call fits (local allocate-code) (i64 1024))) (call fits (local dispose-code) (i64 1024))) (call fits (local poll-code) (i64 256))) (call fits (local copy-code) (i64 512))) (call fits (local abort-code) (i64 256))) (call fits (local invoke-code) (i64 4096))) (call fits (local release-code) (i64 1024))) (call fits (local trap-code) (i64 7680)))
        (let
          (binding empty (type ByteBuffer) (call ci::empty))
          (binding out-0 (type ByteBuffer) (call ci::append (field (local prefix) (name bytes)) (i64 0) (local empty)))
          (binding pad-0 (type ByteBuffer) (call ci::pad (i64 49152) (i64 0) (local out-0)))
          (binding out-1 (type ByteBuffer) (call ci::append (field (local start-code) (name bytes)) (i64 0) (local pad-0)))
          (binding pad-1 (type ByteBuffer) (call ci::pad (i64 49664) (i64 0) (local out-1)))
          (binding out-2 (type ByteBuffer) (call ci::append (field (local allocate-code) (name bytes)) (i64 0) (local pad-1)))
          (binding pad-2 (type ByteBuffer) (call ci::pad (i64 50688) (i64 0) (local out-2)))
          (binding out-3 (type ByteBuffer) (call ci::append (field (local dispose-code) (name bytes)) (i64 0) (local pad-2)))
          (binding pad-3 (type ByteBuffer) (call ci::pad (i64 51712) (i64 0) (local out-3)))
          (binding out-4 (type ByteBuffer) (call ci::append (field (local poll-code) (name bytes)) (i64 0) (local pad-3)))
          (binding pad-4 (type ByteBuffer) (call ci::pad (i64 51968) (i64 0) (local out-4)))
          (binding out-5 (type ByteBuffer) (call ci::append (field (local copy-code) (name bytes)) (i64 0) (local pad-4)))
          (binding pad-5 (type ByteBuffer) (call ci::pad (i64 52480) (i64 0) (local out-5)))
          (binding out-6 (type ByteBuffer) (call ci::append (field (local abort-code) (name bytes)) (i64 0) (local pad-5)))
          (binding pad-6 (type ByteBuffer) (call ci::pad (i64 52736) (i64 0) (local out-6)))
          (binding out-7 (type ByteBuffer) (call ci::append (field (local invoke-code) (name bytes)) (i64 0) (local pad-6)))
          (binding pad-7 (type ByteBuffer) (call ci::pad (i64 56832) (i64 0) (local out-7)))
          (binding out-8 (type ByteBuffer) (call ci::append (field (local release-code) (name bytes)) (i64 0) (local pad-7)))
          (binding pad-8 (type ByteBuffer) (call ci::pad (i64 57856) (i64 0) (local out-8)))
          (binding out-9 (type ByteBuffer) (call ci::append (field (local trap-code) (name bytes)) (i64 0) (local pad-8)))
          (binding final (type ByteBuffer) (call ci::pad (i64 65536) (i64 0) (local out-9)))
          (in (record structural (field code (i64 0)) (field bytes (call ci::freeze (local final))))))
        (record structural (field code (i64 3)) (field bytes (call ci::text-bytes (text "")))))))))
))
declarations.end

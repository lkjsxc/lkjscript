    (function create mode
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create mapping (type Bytes))
      (parameter create row (type I64))
      (returns I64)
      (body
        (let
          (binding selected (call context (local graph) (local parents) (local mapping) (local row)))

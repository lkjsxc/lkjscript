    (function create record-loop
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create cursor (type I64))
      (parameter create left (type I64))
      (parameter create pool (type Bytes))
      (parameter create extra (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (if
          (call ci::eq (local left) (i64 0))
          (record structural
            (field code (i64 0))
            (field index (i64 0))
            (field pool (local pool))
            (field extra (local extra)))
          (let
            (binding selected
              (if
                (call ci::eq (call ci::get (local data) (local cursor)) (i64 0))
                (call source-unit-tables::reference
                  (local pool)
                  (i64 1)
                  (local data)
                  (call ci::add (local cursor) (i64 1)))
                (call source-unit-tables::name
                  (local pool)
                  (i64 7)
                  (local data)
                  (call ci::add (local cursor) (i64 1)))))
            (binding after
              (if
                (call ci::eq (call ci::get (local data) (local cursor)) (i64 0))
                (call ci::add (local cursor) (i64 52))
                (call ci::add
                  (call source-link-ref::name-end (local data) (call ci::add (local cursor) (i64 1)))
                  (i64 17))))
            (in
              (if
                (call ci::eq (field (local selected) (name code)) (i64 0))
                (if
                  (call source-unit-tables::room (call ci::length (local extra)) (i64 16))
                  (call record-loop
                    (local data)
                    (local after)
                    (call ci::sub (local left) (i64 1))
                    (field (local selected) (name pool))
                    (call ci::concat
                      (local extra)
                      (call ci::concat
                        (call source-unit-tables::word (call ci::get (local data) (local cursor)))
                        (call source-unit-tables::word (field (local selected) (name index))))))
                  (record structural
                    (field code (i64 3))
                    (field index (i64 0))
                    (field pool (local pool))
                    (field extra (call ci::text-bytes (text "")))))
                (record structural
                  (field code (i64 3))
                  (field index (i64 0))
                  (field pool (local pool))
                  (field extra (call ci::text-bytes (text ""))))))))))
    (function create record
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create pool (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (let
          (binding presence (call ci::get (local data) (i64 38)))
          (binding arguments
            (call source-table::array
              (local data)
              (if (call ci::eq (local presence) (i64 0)) (i64 39) (i64 73))))
          (in
            (if
              (call ci::eq (field (local arguments) (name value)) (i64 0))
              (let
                (binding nominal
                  (if
                    (call ci::eq (local presence) (i64 1))
                    (call source-unit-tables::reference (local pool) (i64 0) (local data) (i64 39))
                    (record structural
                      (field code (i64 0))
                      (field index (i64 0))
                      (field pool (local pool)))))
                (binding items
                  (call source-table::array (local data) (field (local arguments) (name next))))
                (in
                  (if
                    (call ci::eq (field (local nominal) (name code)) (i64 0))
                    (let
                      (binding members
                        (call record-loop
                          (local data)
                          (field (local items) (name next))
                          (field (local items) (name value))
                          (field (local nominal) (name pool))
                          (call ci::text-bytes (text ""))))
                      (in
                        (record structural
                          (field code (field (local members) (name code)))
                          (field index (field (local nominal) (name index)))
                          (field pool (field (local members) (name pool)))
                          (field extra (field (local members) (name extra))))))
                    (record structural
                      (field code (field (local nominal) (name code)))
                      (field index (i64 0))
                      (field pool (local pool))
                      (field extra (call ci::text-bytes (text "")))))))
              (record structural
                (field code (i64 13))
                (field index (i64 0))
                (field pool (local pool))
                (field extra (call ci::text-bytes (text "")))))))))
    (function create single
      (visibility package)
      (effect pure)
      (parameter create selected (type (record (code I64) (index I64) (pool Bytes))))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (record structural
          (field code (field (local selected) (name code)))
          (field index (field (local selected) (name index)))
          (field pool (field (local selected) (name pool)))
          (field extra (call ci::text-bytes (text ""))))))
    (function create expression
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create pool (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (let
          (binding op (call ci::get (local data) (i64 37)))
          (in
            (if
              (call ci::eq (local op) (i64 14))
              (call variant (local data) (local pool))
              (if
                (call ci::either (call ci::eq (local op) (i64 10)) (call ci::eq (local op) (i64 11)))
                (call call (local data) (local pool))
                (if
                  (call ci::eq (local op) (i64 13))
                  (call record (local data) (local pool))
                  (if
                    (call ci::eq (local op) (i64 15))
                    (if
                      (call ci::eq (call ci::get (local data) (i64 55)) (i64 0))
                      (call single
                        (call source-unit-tables::reference (local pool) (i64 1) (local data) (i64 56)))
                      (call single
                        (call source-unit-tables::name (local pool) (i64 7) (local data) (i64 56))))
                    (if
                      (call ci::eq (local op) (i64 16))
                      (call single (call source-unit-tables::type (local pool) (local data) (i64 38)))
                      (if
                        (call ci::either
                          (call ci::eq (local op) (i64 3))
                          (call ci::eq (local op) (i64 4)))
                        (call single
                          (call source-unit-tables::name (local pool) (i64 9) (local data) (i64 39)))
                        (record structural
                          (field code (i64 0))
                          (field index (i64 0))
                          (field pool (local pool))
                          (field extra (call ci::text-bytes (text ""))))))))))))))
    (function create binding
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create pool (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (let
          (binding annotation (call ci::add (call source-link-ref::name-end (local data) (i64 39)) (i64 19)))
          (in

declarations.begin
(units
  (module create source-unit-code-tables
    (function create result
      (visibility package)
      (effect pure)
      (parameter create code (type I64))
      (parameter create index (type I64))
      (parameter create pool (type Bytes))
      (parameter create extra (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (record structural
          (field code (local code))
          (field index (local index))
          (field pool (local pool))
          (field extra (local extra)))))
    (function create arguments-loop
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create cursor (type I64))
      (parameter create left (type I64))
      (parameter create pool (type Bytes))
      (parameter create index (type I64))
      (parameter create extra (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body
        (if
          (call ci::eq (local left) (i64 0))
          (record structural
            (field code (i64 0))
            (field index (local index))
            (field pool (local pool))
            (field extra (local extra)))
          (let
            (binding selected (call source-unit-tables::type (local pool) (local data) (local cursor)))
            (in
              (if
                (call ci::eq (field (local selected) (name code)) (i64 0))
                (if
                  (call source-unit-tables::room (call ci::length (local extra)) (i64 8))
                  (call arguments-loop
                    (local data)
                    (call ci::add (local cursor) (i64 33))
                    (call ci::sub (local left) (i64 1))
                    (field (local selected) (name pool))
                    (local index)
                    (call ci::concat
                      (local extra)
                      (call source-unit-tables::word (field (local selected) (name index)))))
                  (record structural
                    (field code (i64 3))
                    (field index (i64 0))
                    (field pool (local pool))
                    (field extra (call ci::text-bytes (text "")))))
                (record structural
                  (field code (i64 3))
                  (field index (i64 0))
                  (field pool (local pool))
                  (field extra (call ci::text-bytes (text ""))))))))))
    (function create call
      (visibility package)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create pool (type Bytes))
      (returns (record (code I64) (index I64) (pool Bytes) (extra Bytes)))
      (body

                (field index (i64 0))
                (field pool (local pool))
                (field extra (call ci::text-bytes (text "")))))))))
    (function create slot
      (visibility package)
      (effect pure)
      (parameter create slots (type Bytes))
      (parameter create owner (type I64))
      (parameter create cursor (type I64))
      (returns I64)
      (body
        (if
          (call ci::eq (local cursor) (call ci::length (local slots)))
          (i64 -1)
          (if
            (call ci::eq (call ci::u64 (local slots) (local cursor)) (local owner))
            (call ci::u64 (local slots) (call ci::add (local cursor) (i64 8)))
            (call slot (local slots) (local owner) (call ci::add (local cursor) (i64 16)))))))
    (function create memory
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create mapping (type Bytes))
      (parameter create owner (type I64))
      (returns Bool)
      (body
        (call source-custody-signature::owned
          (call source-custody-signature::local-type (local graph) (local mapping) (local owner)))))
    (function create context
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create mapping (type Bytes))
      (parameter create row (type I64))
      (returns I64)
      (body
        (let
          (binding parent (call source-table::parent (local parents) (local row)))
          (in
            (if
              (call ci::eq (call source-table::kind (local graph) (local parent)) (i64 17))
              (let
                (binding op
                  (call ci::get
                    (local graph)
                    (call ci::add (call source-table::start (local graph) (local parent)) (i64 37))))
                (binding position (call source-table::column (local parents) (local row) (i64 8)))
                (in
                  (if
                    (call ci::eq (local op) (i64 9))
                    (let
                      (binding last
                        (call source-table::sequence-last (local graph) (local parent) (local position)))
                      (in
                        (if
                          (call ci::lt (local last) (i64 0))
                          (i64 -1)
                          (if
                            (call ci::eq (local last) (i64 1))
                            (call context (local graph) (local parents) (local mapping) (local parent))
                            (i64 0)))))
                    (let
                      (binding record (call source-table::data (local graph) (local parent)))
                      (in
                        (if
                          (call ci::eq (local op) (i64 10))
                          (call source-custody-signature::mode
                            (local graph)
                            (call source-custody-signature::parameter
                              (local graph)
                              (call source-table::owner (local graph) (local record) (i64 57) (i64 2))
                              (local position)))
                          (if
                            (call ci::eq (local op) (i64 15))
                            (let
                              (binding child (call source-table::data (local graph) (local row)))
                              (in
                                (if
                                  (call ci::eq (call ci::get (local child) (i64 37)) (i64 5))
                                  (if
                                    (call memory
                                      (local graph)
                                      (local mapping)
                                      (call source-custody-signature::local-owner (local graph) (local child)))
                                    (i64 1)
                                    (i64 0))
                                  (i64 0))))
                            (if
                              (if
                                (call ci::either
                                  (call ci::eq (local op) (i64 7))
                                  (call ci::either (call ci::eq (local op) (i64 18)) (bool false)))
                                (call ci::lt (i64 0) (local position))
                                (if
                                  (call ci::eq (local op) (i64 8))
                                  (call ci::eq
                                    (local position)
                                    (field (call source-table::array (local record) (i64 38)) (name value)))
                                  (bool false)))
                              (call context (local graph) (local parents) (local mapping) (local parent))

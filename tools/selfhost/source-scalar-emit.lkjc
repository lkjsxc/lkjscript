declarations.begin
(units
  (module create source-scalar-emit
    (function create failure
      (visibility private)
      (effect pure)
      (parameter create code (type I64))
      (returns (record (code I64) (input Bytes)))
      (body (record structural (field code (local code)) (field input (call ci::text-bytes (text ""))))))
    (function create span
      (visibility private)
      (effect pure)
      (parameter create trace (type Bytes))
      (parameter create at (type I64))
      (parameter create remaining (type I64))
      (parameter create locals (type I64))
      (parameter create blob (type I64))
      (returns (record (next I64) (blob I64)))
      (body
        (if
          (call ci::eq (local remaining) (i64 0))
          (record structural (field next (local at)) (field blob (local blob)))
          (let
            (binding state
              (call ci::add
                (local locals)
                (call ci::mul (call ci::u64 (local trace) (call ci::add (local at) (i64 56))) (i64 16))))
            (in
              (call span
                (local trace)
                (call ci::add (call ci::add (local at) (i64 64)) (local state))
                (call ci::sub (local remaining) (i64 1))
                (local locals)
                (call ci::add (local blob) (local state))))))))
    (function create function-row
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create index (type I64))
      (parameter create first (type I64))
      (parameter create blob (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (let
          (binding owner (call source-scalar-plan::function-owner (local functions) (local index)))
          (binding a
            (type ByteBuffer)
            (call source-scalar-plan::edge
              (i64 0)
              (call source-scalar-profile::function-result (local graph) (local owner))
              (call source-scalar-plan::parameter-count (local functions) (local index))
              (local out)))
          (binding b
            (type ByteBuffer)
            (call source-scalar-plan::edge
              (call source-scalar-plan::local-count (local functions) (local index))
              (local first)
              (call source-scalar-plan::node-count (local plan) (local owner))
              (local a)))
          (binding c
            (type ByteBuffer)
            (call source-scalar-plan::edge
              (call source-scalar-profile::external-code (local graph) (local owner))
              (local blob)
              (i64 0)
              (local b)))
          (in (call ci::le (i64 0) (i64 8) (local c))))))
    (function create function-table
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create trace (type Bytes))
      (parameter create index (type I64))
      (parameter create at (type I64))
      (parameter create blob (type I64))
      (parameter create first (type I64))
      (parameter create blob-start (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns Bytes)
      (body
        (if
          (call ci::eq (local index) (call source-scalar-plan::function-count (local functions)))
          (call ci::freeze (local out))
          (let
            (binding owner (call source-scalar-plan::function-owner (local functions) (local index)))
            (binding locals (call source-scalar-plan::local-count (local functions) (local index)))
            (binding nodes (call source-scalar-plan::node-count (local plan) (local owner)))
            (binding extent
              (call span
                (local trace)
                (call ci::add (local at) (call ci::mul (local locals) (i64 16)))
                (local nodes)
                (local locals)
                (call ci::add (local blob) (call ci::mul (local locals) (i64 16)))))
            (binding next
              (type ByteBuffer)
              (call function-row
                (local graph)
                (local plan)
                (local functions)
                (local index)
                (local first)
                (call ci::add (local blob-start) (local blob))
                (local out)))
            (in
              (call function-table
                (local graph)
                (local plan)
                (local functions)
                (local trace)
                (call ci::add (local index) (i64 1))
                (field (local extent) (name next))
                (field (local extent) (name blob))
                (call ci::add (local first) (local nodes))
                (local blob-start)
                (local next)))))))
    (function create section-node
      (visibility private)
      (effect pure)
      (parameter create trace (type Bytes))
      (parameter create at (type I64))
      (parameter create size (type I64))
      (parameter create state (type I64))
      (parameter create mode (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (if
          (call ci::eq (local mode) (i64 0))
          (let
            (binding a
              (type ByteBuffer)
              (call ci::append
                (call ci::slice (local trace) (local at) (call ci::add (local at) (i64 48)))
                (i64 0)
                (local out)))
            (binding b (type ByteBuffer) (call ci::le (local state) (i64 8) (local a)))
            (in
              (call ci::append
                (call ci::slice
                  (local trace)
                  (call ci::add (local at) (i64 56))
                  (call ci::add (local at) (i64 64)))
                (i64 0)
                (local b))))
          (call ci::append
            (call ci::slice
              (local trace)
              (call ci::add (local at) (i64 64))
              (call ci::add (call ci::add (local at) (i64 64)) (local size)))
            (i64 0)
            (local out)))))
    (function create section
      (visibility private)
      (effect pure)
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create trace (type Bytes))
      (parameter create mode (type I64))
      (parameter create index (type I64))
      (parameter create node (type I64))
      (parameter create at (type I64))
      (parameter create blob (type I64))
      (parameter create blob-start (type I64))
      (parameter create out (type ByteBuffer) (use consume))
      (returns Bytes)
      (body
        (if
          (call ci::eq (local index) (call source-scalar-plan::function-count (local functions)))
          (call ci::freeze (local out))
          (let
            (binding locals (call source-scalar-plan::local-count (local functions) (local index)))
            (in
              (if
                (call ci::eq (local node) (i64 -1))
                (let
                  (binding next
                    (type ByteBuffer)
                    (if
                      (call ci::eq (local mode) (i64 0))
                      (local out)
                      (call ci::append
                        (call ci::slice
                          (local trace)
                          (local at)
                          (call ci::add (local at) (call ci::mul (local locals) (i64 16))))
                        (i64 0)
                        (local out))))
                  (in
                    (call section
                      (local plan)
                      (local functions)
                      (local trace)
                      (local mode)
                      (local index)
                      (i64 0)
                      (call ci::add (local at) (call ci::mul (local locals) (i64 16)))
                      (call ci::add (local blob) (call ci::mul (local locals) (i64 16)))
                      (local blob-start)
                      (local next))))
                (if
                  (call ci::eq
                    (local node)
                    (call source-scalar-plan::node-count
                      (local plan)
                      (call source-scalar-plan::function-owner (local functions) (local index))))
                  (call section
                    (local plan)
                    (local functions)
                    (local trace)
                    (local mode)
                    (call ci::add (local index) (i64 1))
                    (i64 -1)
                    (local at)
                    (local blob)
                    (local blob-start)
                    (local out))
                  (let
                    (binding size
                      (call ci::add
                        (local locals)
                        (call ci::mul
                          (call ci::u64 (local trace) (call ci::add (local at) (i64 56)))
                          (i64 16))))
                    (binding next
                      (type ByteBuffer)
                      (call section-node
                        (local trace)
                        (local at)
                        (local size)
                        (call ci::add (local blob-start) (local blob))
                        (local mode)
                        (local out)))
                    (in
                      (call section
                        (local plan)
                        (local functions)
                        (local trace)
                        (local mode)
                        (local index)
                        (call ci::add (local node) (i64 1))
                        (call ci::add (call ci::add (local at) (i64 64)) (local size))
                        (call ci::add (local blob) (local size))
                        (local blob-start)
                        (local next)))))))))))
    (function create finish
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create plan (type Bytes))
      (parameter create functions (type Bytes))
      (parameter create trace (type Bytes))
      (parameter create entry (type I64))
      (parameter create nodes (type I64))
      (returns (record (code I64) (input Bytes)))
      (body
        (let
          (binding count (call source-scalar-plan::function-count (local functions)))
          (binding blob-start
            (call ci::add
              (i64 384)
              (call ci::add (call ci::mul (local count) (i64 80)) (call ci::mul (local nodes) (i64 64)))))
          (binding declarations
            (let
              (binding function-buffer (type ByteBuffer) (call ci::empty))
              (in
                (call function-table
                  (local graph)
                  (local plan)
                  (local functions)
                  (local trace)
                  (i64 0)
                  (i64 0)
                  (i64 0)
                  (i64 0)
                  (local blob-start)
                  (local function-buffer)))))
          (binding instructions
            (let
              (binding node-buffer (type ByteBuffer) (call ci::empty))
              (in
                (call section
                  (local plan)
                  (local functions)
                  (local trace)
                  (i64 0)
                  (i64 0)
                  (i64 -1)
                  (i64 0)
                  (i64 0)
                  (local blob-start)
                  (local node-buffer)))))
          (binding blob
            (let
              (binding blob-buffer (type ByteBuffer) (call ci::empty))
              (in
                (call section
                  (local plan)
                  (local functions)
                  (local trace)
                  (i64 1)
                  (i64 0)
                  (i64 -1)
                  (i64 0)
                  (i64 0)
                  (local blob-start)
                  (local blob-buffer)))))
          (in
            (call source-scalar-pack::encode
              (local declarations)
              (local instructions)
              (local blob)
              (local count)
              (local nodes)
              (local entry))))))
    (function create lower
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create facts (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create target (type I64))
      (returns (record (code I64) (input Bytes)))
      (body
        (let
          (binding plan
            (call source-scalar-plan::prepare (local graph) (local parents) (local facts) (local target)))
          (in
            (if
              (call ci::eq (field (local plan) (name code)) (i64 0))
              (let
                (binding trace
                  (call source-scalar-trace::encode
                    (local graph)
                    (local facts)
                    (local parents)
                    (field (local plan) (name rows))
                    (field (local plan) (name functions))
                    (field (local plan) (name locals))))
                (in
                  (if
                    (call ci::eq (field (local trace) (name code)) (i64 0))
                    (call finish
                      (local graph)
                      (field (local plan) (name rows))
                      (field (local plan) (name functions))
                      (field (local trace) (name rows))
                      (field (local plan) (name entry))
                      (field (local plan) (name nodes)))
                    (call failure (field (local trace) (name code))))))
              (call failure (field (local plan) (name code))))))))))
declarations.end

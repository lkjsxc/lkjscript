declarations.begin
(units
  (module create source-scalar
    (function create failure
      (visibility private)
      (effect pure)
      (parameter create code (type I64))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (record structural
          (field code (local code))
          (field facts (call ci::text-bytes (text "")))
          (field parents (call ci::text-bytes (text "")))
          (field types (call ci::text-bytes (text "")))
          (field mapping (call ci::text-bytes (text "")))
          (field custody (call ci::text-bytes (text ""))))))
    (function create infer
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create types (type Bytes))
      (parameter create mapping (type Bytes))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (let
          (binding profile (call source-scalar-profile::check (local graph) (local types) (local mapping)))
          (in
            (if
              (call ci::eq (local profile) (i64 0))
              (let
                (binding inferred
                  (call source-scalar-infer::check (local graph) (local types) (local mapping)))
                (in
                  (if
                    (call ci::eq (field (local inferred) (name code)) (i64 0))
                    (call admit
                      (local graph)
                      (local parents)
                      (field (local inferred) (name types))
                      (local mapping)
                      (field (local inferred) (name rows)))
                    (call failure (field (local inferred) (name code))))))
              (call failure (local profile)))))))
    (function create finish
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (let
          (binding prepared (call source-value-types::prepare (local graph)))
          (in
            (if
              (call ci::eq (field (local prepared) (name code)) (i64 0))
              (call infer
                (local graph)
                (local parents)
                (field (local prepared) (name types))
                (field (local prepared) (name mapping)))
              (call failure (field (local prepared) (name code))))))))
    (function create scope
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (let
          (binding scoped (call source-scope::check (local graph) (local parents) (local work)))
          (binding named
            (if
              (call source-budget::failed (local scoped))
              (local scoped)
              (call source-namespace::check (local graph) (local scoped) (local parents))))
          (binding typed
            (if
              (call source-budget::failed (local named))
              (local named)
              (call source-type-scope::check (local graph) (local parents) (local named))))
          (binding nominal
            (if
              (call source-budget::failed (local typed))
              (local typed)
              (call source-nominal::check (local graph) (local typed))))
          (in
            (if
              (call source-budget::failed (local nominal))
              (call failure (field (local nominal) (name code)))
              (call finish (local graph) (local parents)))))))
    (function create prepare
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (if
          (call ci::lt (call ci::length (local graph)) (i64 128))
          (call failure (i64 12))
          (let
            (binding prepared (call source-members::prepare (local graph)))
            (in
              (if
                (call ci::eq (field (local prepared) (name code)) (i64 0))
                (call scope
                  (local graph)
                  (field (local prepared) (name rows))
                  (call source-budget::from-carrier (local graph)))
                (call failure (field (local prepared) (name code)))))))))
    (function create validate
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns I64)
      (body (field (call prepare (local graph)) (name code))))
    (function create inspect
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body
        (let
          (binding prepared (call prepare (local graph)))
          (in
            (record structural
              (field diagnostic (field (local prepared) (name code)))
              (field image
                (if
                  (call ci::eq (field (local prepared) (name code)) (i64 0))
                  (call ci::slice (local graph) (i64 48) (i64 80))
                  (call ci::text-bytes (text "")))))))))
    (function create admit
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create parents (type Bytes))
      (parameter create types (type Bytes))
      (parameter create mapping (type Bytes))
      (parameter create facts (type Bytes))
      (returns
        (record (code I64) (facts Bytes) (parents Bytes) (types Bytes) (mapping Bytes) (custody Bytes)))
      (body
        (let
          (binding checked
            (call source-custody::prepare
              (local graph)
              (local parents)
              (local types)
              (local mapping)
              (local facts)))
          (in
            (if
              (call ci::eq (field (local checked) (name code)) (i64 0))
              (record structural
                (field code (i64 0))
                (field facts (local facts))
                (field parents (local parents))
                (field types (local types))
                (field mapping (local mapping))
                (field custody (field (local checked) (name evidence))))
              (call failure (field (local checked) (name code))))))))))
declarations.end

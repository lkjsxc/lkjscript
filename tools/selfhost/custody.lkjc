declarations.begin
(units
  (module create custody
    (function create local-types
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create i (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local i) (call flow::field (local data) (local f) (i64 24)))
          (bool true)
          (if
            (call types::values
              (local data)
              (call flow::local-cell (local data) (local f) (local i))
              (i64 1)
              (call ci::lt (local i) (call flow::field (local data) (local f) (i64 16))))
            (call local-types (local data) (local f) (call ci::add (local i) (i64 1)))
            (bool false)))))
    (function create edge
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create before (type I64))
      (parameter create after (type I64))
      (parameter create store (type I64))
      (parameter create i (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local i) (call flow::field (local data) (local f) (i64 24)))
          (bool true)
          (let
            (binding av (call ci::get (local data) (call ci::add (local after) (local i))))
            (binding bv (call ci::get (local data) (call ci::add (local before) (local i))))
            (binding cell (call flow::local-cell (local data) (local f) (local i)))
            (binding owned
              (call ci::both
                (call ci::eq (call types::identity (local data) (local cell)) (i64 6))
                (if (call types::borrowed (local data) (local cell)) (bool false) (bool true))))
            (binding valid
              (if
                (call ci::eq (local store) (call ci::sub (i64 -2) (local i)))
                (call ci::eq (local av) (i64 0))
                (if
                  (local owned)
                  (call ci::eq (local av) (if (call ci::eq (local i) (local store)) (i64 1) (local bv)))
                  (call ci::either
                    (call ci::eq (local i) (local store))
                    (call ci::lt (local av) (call ci::add (local bv) (i64 1)))))))
            (in
              (if
                (local valid)
                (call edge
                  (local data)
                  (local f)
                  (local before)
                  (local after)
                  (local store)
                  (call ci::add (local i) (i64 1)))
                (bool false)))))))
    (function create no-borrow
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create at (type I64))
      (parameter create count (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local count) (i64 0))
          (bool true)
          (if
            (call types::borrowed (local data) (local at))
            (bool false)
            (call no-borrow
              (local data)
              (call ci::add (local at) (i64 16))
              (call ci::sub (local count) (i64 1)))))))
    (function create released
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create state (type I64))
      (parameter create i (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local i) (call flow::field (local data) (local f) (i64 24)))
          (bool true)
          (let
            (binding cell (call flow::local-cell (local data) (local f) (local i)))
            (in
              (if
                (call ci::both
                  (call ci::eq (call types::identity (local data) (local cell)) (i64 6))
                  (call ci::both
                    (if (call types::borrowed (local data) (local cell)) (bool false) (bool true))
                    (call ci::eq
                      (call ci::get (local data) (call ci::add (local state) (local i)))
                      (i64 1))))
                (bool false)
                (call released (local data) (local f) (local state) (call ci::add (local i) (i64 1)))))))))
    (function create movable
      (visibility public)
      (effect pure)
      (parameter create data (type Bytes))
      (parameter create f (type I64))
      (parameter create at (type I64))
      (returns Bool)
      (body
        (call no-borrow
          (local data)
          (call flow::stack-cell (local data) (local f) (local at) (i64 0))
          (call flow::field (local data) (local at) (i64 56)))))))
declarations.end

declarations.begin
(units
  (module create source-forest
    (function create rooted
      (visibility private)
      (effect pure)
      (parameter create rows (type Bytes))
      (parameter create row (type I64))
      (parameter create count (type I64))
      (returns Bool)
      (body
        (if
          (call ci::eq (local row) (local count))
          (bool true)
          (if
            (call ci::eq (call source-table::parent (local rows) (local row)) (local count))
            (call rooted (local rows) (call ci::add (local row) (i64 1)) (local count))
            (bool false)))))
    (function create jump
      (visibility private)
      (effect pure)
      (parameter create rows (type Bytes))
      (parameter create row (type I64))
      (parameter create count (type I64))
      (parameter create all-rooted (type Bool))
      (parameter create out (type ByteBuffer) (use consume))
      (returns (record (rows Bytes) (rooted Bool)))
      (body
        (if
          (call ci::eq (local row) (local count))
          (record structural
            (field rows (call ci::freeze (local out)))
            (field rooted (local all-rooted)))
          (let
            (binding parent (call source-table::parent (local rows) (local row)))
            (binding ancestor
              (if
                (call ci::eq (local parent) (local count))
                (local count)
                (call source-table::parent (local rows) (local parent))))
            (binding next
              (type ByteBuffer)
              (call source-table::edge (local row) (local ancestor) (i64 0) (local out)))
            (in
              (call jump
                (local rows)
                (call ci::add (local row) (i64 1))
                (local count)
                (if (call ci::eq (local ancestor) (local count)) (local all-rooted) (bool false))
                (local next)))))))

    (function create prove
      (visibility package)
      (effect pure)
      (parameter create rows (type Bytes))
      (parameter create count (type I64))
      (parameter create distance (type I64))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call source-budget::insufficient (local work) (local count))
          (call source-budget::fail (local work) (i64 6))
          (let
            (binding remaining (call source-budget::charge (local work) (local count)))
            (in
              (if
                (call ci::lt (local distance) (local count))
                (let
                  (binding empty (type ByteBuffer) (call ci::empty))
                  (binding jumped
                    (call jump (local rows) (i64 0) (local count) (bool true) (local empty)))
                  (in
                    (if
                      (field (local jumped) (name rooted))
                      (local remaining)
                      (call prove
                        (field (local jumped) (name rows))
                        (local count)
                        (call ci::mul (local distance) (i64 2))
                        (local remaining)))))
                (if
                  (call rooted (local rows) (i64 0) (local count))
                  (local remaining)
                  (call source-budget::fail (local remaining) (i64 15)))))))))))
declarations.end

declarations.begin
(units
  (module create source-nominal
    (function create members
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create row (type I64))
      (parameter create edges (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body
        (if
          (call ci::eq (local row) (call source-table::count (local graph)))
          (call source-nominal-cycle::prove (local edges) (local work))
          (if
            (call source-budget::insufficient (local work) (i64 1))
            (call source-budget::fail (local work) (i64 6))
            (let
              (binding kind (call source-table::kind (local graph) (local row)))
              (binding remaining (call source-budget::charge (local work) (i64 1)))
              (binding checked
                (if
                  (call ci::either
                    (call ci::eq (local kind) (i64 12))
                    (call ci::eq (local kind) (i64 13)))
                  (let
                    (binding data (call source-table::data (local graph) (local row)))
                    (binding at (call source-link-ref::name-end (local data) (i64 56)))
                    (binding is-field (call ci::eq (local kind) (i64 12)))
                    (in
                      (if
                        (if
                          (local is-field)
                          (bool true)
                          (call ci::eq (call ci::get (local data) (local at)) (i64 1)))
                        (call source-nominal-flow::syntax
                          (local graph)
                          (call source-nominal-queue::push
                            (call ci::text-bytes (text ""))
                            (call source-type-table::lookup
                              (local graph)
                              (local data)
                              (if (local is-field) (local at) (call ci::add (local at) (i64 1)))))
                          (i64 0)
                          (local edges)
                          (local remaining))
                        (record structural (field work (local remaining)) (field edges (local edges))))))
                  (record structural (field work (local remaining)) (field edges (local edges)))))
              (in
                (if
                  (call source-budget::failed (field (local checked) (name work)))
                  (field (local checked) (name work))
                  (call members
                    (local graph)
                    (call ci::add (local row) (i64 1))
                    (field (local checked) (name edges))
                    (field (local checked) (name work))))))))))
    (function create check
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns
        (record
          (code I64)
          (finite Bool)
          (high I64)
          (low I64)
          (observed-high I64)
          (observed-low I64)
          (saturated Bool)))
      (body (call members (local graph) (i64 0) (call ci::text-bytes (text "")) (local work))))
    (function create with-policy
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create work
        (type
          (record
            (code I64)
            (finite Bool)
            (high I64)
            (low I64)
            (observed-high I64)
            (observed-low I64)
            (saturated Bool))))
      (returns I64)
      (body
        (let
          (binding prior (call source-type-scope::admit (local graph) (local work)))
          (binding checked
            (if
              (call source-budget::failed (local prior))
              (local prior)
              (call check (local graph) (local prior))))
          (in
            (if (call source-budget::failed (local checked)) (field (local checked) (name code)) (i64 0))))))
    (function create validate
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns I64)
      (body
        (if
          (call ci::lt (call ci::length (local graph)) (i64 128))
          (i64 12)
          (call with-policy (local graph) (call source-budget::from-carrier (local graph))))))
    (function create with-work
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create work (type I64))
      (returns I64)
      (body (call with-policy (local graph) (call source-budget::finite (local work)))))))
declarations.end

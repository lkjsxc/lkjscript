declarations.begin
(units
  (module create source-links
    (function create validate
      (visibility public)
      (effect pure)
      (parameter create graph (type Bytes))
      (returns I64)
      (body
        (let
          (binding admitted (call source-graph::validate (local graph)))
          (in
            (if
              (call ci::eq (local admitted) (i64 0))
              (let
                (binding result
                  (call walk
                    (local graph)
                    (i64 0)
                    (call ci::add
                      (call ci::u32 (local graph) (i64 12))
                      (call ci::u32 (local graph) (i64 16)))))
                (in
                  (if
                    (call ci::lt (local result) (i64 0))
                    (call ci::sub (i64 0) (local result))
                    (if (call ci::eq (local result) (i64 0)) (i64 0) (i64 12)))))
              (local admitted))))))
    (function create walk
      (visibility private)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create index (type I64))
      (parameter create count (type I64))
      (returns I64)
      (body
        (if
          (call ci::eq (local index) (local count))
          (i64 0)
          (let
            (binding span
              (call ci::add (call ci::u32 (local graph) (i64 92)) (call ci::mul (local index) (i64 8))))
            (binding start (call ci::u32 (local graph) (local span)))
            (binding size (call ci::u32 (local graph) (call ci::add (local span) (i64 4))))
            (binding data
              (call ci::slice (local graph) (local start) (call ci::add (local start) (local size))))
            (binding cursor
              (if
                (call ci::lt (local index) (call ci::u32 (local graph) (i64 12)))
                (call source-link-owner::read (local graph) (local data))
                (call source-link-expr::read-type (local graph) (local data))))
            (in
              (if
                (call ci::lt (local cursor) (i64 0))
                (local cursor)
                (if
                  (call ci::eq (local cursor) (call ci::sub (local size) (i64 32)))
                  (call walk (local graph) (call ci::add (local index) (i64 1)) (local count))
                  (i64 -12))))))))))
declarations.end

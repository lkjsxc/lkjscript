declarations.begin
(units (module create phase-asm
  (function create target (visibility private) (effect pure)
    (parameter create labels (type Bytes)) (parameter create key (type I64))
    (parameter create index (type I64)) (returns I64)
    (body (if (call ci::eq (local index) (call ci::length (local labels))) (i64 -1)
      (if (call ci::eq (call ci::u64 (local labels) (local index)) (local key))
        (call ci::u64 (local labels) (call ci::add (local index) (i64 8)))
        (call target (local labels) (local key) (call ci::add (local index) (i64 16)))))))
  (function create count-label (visibility private) (effect pure)
    (parameter create labels (type Bytes)) (parameter create key (type I64))
    (parameter create index (type I64)) (parameter create count (type I64)) (returns I64)
    (body (if (call ci::eq (local index) (call ci::length (local labels))) (local count)
      (call count-label (local labels) (local key) (call ci::add (local index) (i64 16))
        (call ci::add (local count)
          (if (call ci::eq (call ci::u64 (local labels) (local index)) (local key)) (i64 1) (i64 0)))))))
  (function create one (visibility private) (effect pure)
    (parameter create ops (type (list I64))) (parameter create index (type I64))
    (parameter create labels (type Bytes)) (parameter create base (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (let
      (binding op (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 0))))
      (binding a (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 1))))
      (binding b (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 2))))
      (binding c (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 3))))
      (in (if (call ci::eq (local op) (i64 0))
        (local out)
        (if (call ci::eq (local op) (i64 1))
        (call asm::imm (local a) (local b) (local out))
        (if (call ci::eq (local op) (i64 2))
        (call asm::mov (local a) (local b) (local out))
        (if (call ci::eq (local op) (i64 3))
        (call asm::binary (bool true) (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 4))
        (call asm::group (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 5))
        (call asm::load (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 6))
        (call asm::store (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 7))
        (call asm::lea (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 8))
        (call asm::stack (bool false) (local a) (local out))
        (if (call ci::eq (local op) (i64 9))
        (call asm::stack (bool true) (local a) (local out))
        (if (call ci::eq (local op) (i64 10))
        (call elf::jump (call ci::sub (call target (local labels) (local a) (i64 0)) (local base)) (local out))
        (if (call ci::eq (local op) (i64 11))
        (call elf::condition (call ci::add (i64 128) (local a)) (call ci::sub (call target (local labels) (local b) (i64 0)) (local base)) (local out))
        (if (call ci::eq (local op) (i64 12))
        (call machine::call (call ci::sub (call target (local labels) (local a) (i64 0)) (local base)) (local out))
        (if (call ci::eq (local op) (i64 13))
        (call ci::push (i64 195) (local out))
        (if (call ci::eq (local op) (i64 14))
        (call elf::raw (list I64 (i64 15) (i64 5)) (local out))
        (if (call ci::eq (local op) (i64 15))
        (call elf::raw (list I64 (i64 252) (i64 243) (i64 164)) (local out))
        (if (call ci::eq (local op) (i64 16))
        (call asm::imm (local a) (call ci::add (i64 4194304) (call target (local labels) (local b) (i64 0))) (local out))
        (if (call ci::eq (local op) (i64 17))
        (call machine::wide-call (local a) (local out))
        (if (call ci::eq (local op) (i64 18))
        (call asm::shift (bool true) (local a) (local b) (local c) (local out))
        (if (call ci::eq (local op) (i64 19))
        (call ci::le (local a) (local b) (local out))
        (if (call ci::eq (local op) (i64 20))
        (call asm::memory (bool true) (i64 4022) (local a) (local b) (i64 0) (local out))
        (if (call ci::eq (local op) (i64 21))
        (call asm::memory (bool false) (i64 136) (local b) (local a) (i64 0) (local out))
        (if (call ci::eq (local op) (i64 22))
        (call elf::jump (call ci::sub (local a) (local base)) (local out))
        (if (call ci::eq (local op) (i64 23))
        (call machine::call (call ci::sub (local a) (local base)) (local out))
        (local out)))))))))))))))))))))))))))))
  (function create labels (visibility private) (effect pure)
    (parameter create ops (type (list I64))) (parameter create index (type I64))
    (parameter create position (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns Bytes)
    (body (if (call ci::eq (local index) (call ci::list-size (types I64) (local ops)))
      (call ci::freeze (local out))
      (if (call ci::eq (call ci::list-get (types I64) (local ops) (local index)) (i64 0))
        (let
          (binding key (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 1))))
          (binding a (type ByteBuffer) (call ci::le (local key) (i64 8) (local out)))
          (binding b (type ByteBuffer) (call ci::le (local position) (i64 8) (local a)))
          (in (call labels (local ops) (call ci::add (local index) (i64 5)) (local position) (local b))))
        (let
          (binding empty (type ByteBuffer) (call ci::empty))
          (binding scratch (type ByteBuffer)
            (call one (local ops) (local index) (call ci::text-bytes (text "")) (i64 0) (local empty)))
          (binding size (call ci::size (local scratch)))
          (binding discarded (call ci::discard (local scratch)))
          (in (call labels (local ops) (call ci::add (local index) (i64 5))
            (call ci::add (local position) (local size)) (local out))))))))
  (function create valid (visibility private) (effect pure)
    (parameter create ops (type (list I64))) (parameter create labels (type Bytes))
    (parameter create index (type I64)) (returns Bool)
    (body (if (call ci::eq (local index) (call ci::list-size (types I64) (local ops))) (bool true)
      (let
        (binding op (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 0))))
        (binding a (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 1))))
        (binding b (call ci::list-get (types I64) (local ops) (call ci::add (local index) (i64 2))))
        (binding reference
          (if (call ci::either (call ci::eq (local op) (i64 11)) (call ci::eq (local op) (i64 16)))
            (local b) (local a)))
        (binding needs-label
          (call ci::either
            (call ci::either (call ci::eq (local op) (i64 0)) (call ci::eq (local op) (i64 10)))
            (call ci::either (call ci::eq (local op) (i64 11))
              (call ci::either (call ci::eq (local op) (i64 12)) (call ci::eq (local op) (i64 16))))))
        (in (if
          (call ci::both
            (call ci::both (call ci::lt (i64 -1) (local op)) (call ci::lt (local op) (i64 24)))
            (if (local needs-label)
              (call ci::eq (call count-label (local labels) (local reference) (i64 0) (i64 0)) (i64 1))
              (bool true)))
          (call valid (local ops) (local labels) (call ci::add (local index) (i64 5)))
          (bool false)))))))
  (function create write (visibility private) (effect pure)
    (parameter create ops (type (list I64))) (parameter create labels (type Bytes))
    (parameter create base (type I64)) (parameter create index (type I64))
    (parameter create out (type ByteBuffer) (use consume)) (returns Bytes)
    (body (if (call ci::eq (local index) (call ci::list-size (types I64) (local ops)))
      (call ci::freeze (local out))
      (let
        (binding next (type ByteBuffer)
          (call one (local ops) (local index) (local labels) (local base) (local out)))
        (in (call write (local ops) (local labels) (local base)
          (call ci::add (local index) (i64 5)) (local next)))))))
  (function create assemble (visibility public) (effect pure)
    (parameter create ops (type (list I64))) (parameter create base (type I64))
    (returns (record (code I64) (bytes Bytes)))
    (body (if
      (call ci::eq (call ci::list-size (types I64) (local ops))
        (call ci::mul (call ci::div (call ci::list-size (types I64) (local ops)) (i64 5)) (i64 5)))
      (let
        (binding label-buffer (type ByteBuffer) (call ci::empty))
        (binding table (call labels (local ops) (i64 0) (local base) (local label-buffer)))
        (in (if (call valid (local ops) (local table) (i64 0))
          (let
            (binding code-buffer (type ByteBuffer) (call ci::empty))
            (binding code-bytes (call write (local ops) (local table) (local base) (i64 0) (local code-buffer)))
            (in (record structural (field code (i64 0)) (field bytes (local code-bytes)))))
          (record structural (field code (i64 3)) (field bytes (call ci::text-bytes (text "")))))))
      (record structural (field code (i64 3)) (field bytes (call ci::text-bytes (text "")))))))
))
declarations.end

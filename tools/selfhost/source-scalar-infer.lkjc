                  (field types (field (local next) (name types))))
                (if
                  (call ci::lt (field (local next) (name pending)) (local previous))
                  (call rounds
                    (local graph)
                    (field (local next) (name types))
                    (local mapping)
                    (field (local next) (name rows))
                    (field (local next) (name pending)))
                  (record structural
                    (field code (i64 19))
                    (field rows (call ci::text-bytes (text "")))
                    (field types (local types)))))
              (record structural
                (field code (field (local next) (name code)))
                (field rows (call ci::text-bytes (text "")))
                (field types (local types))))))))
    (function create check
      (visibility package)
      (effect pure)
      (parameter create graph (type Bytes))
      (parameter create types (type Bytes))

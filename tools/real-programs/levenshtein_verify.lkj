//! Produce the upstream report. The gate verifies its bytes independently.
use std::bytes;
use std::collections::BTreeSet;
use std::json::{self, Value};
use std::sha256;

const COMMIT: &str = "9c4730b1973d4e61e187f8fe6d5f299ad5c991fc";
const MARKER: &[u8] = b"\n// UPSTREAM INTEGRATION TESTS: exact bodies, package header removed.\n";
const HEADER: &[u8] = b"extern crate levenshtein;\nuse levenshtein::levenshtein;\n";
const NORMALIZED: &[u8] = b"std::iter::range_from(1)";
const ORIGINAL: &[u8] = b"(1..)";

fn require(condition: bool, reason: &str) -> Result<(), String> {
    if condition { Ok(()) } else { Err(reason.to_string()) }
}

fn read(source: &mut ReadDirectory, name: &str) -> Result<Vec<u8>, String> {
    let mut file = source.open(name).map_err(|errno: i64| -> String { format!("{name}: errno {errno}") })?;
    file.read_to_end().map_err(|errno: i64| -> String { format!("{name}: errno {errno}") })
}

// The predecessor compares JSON numbers after binary64 conversion, but
// schema/adaptation strings literally. Line counts use Number(string).
// Compare decimal input against the exact rounding interval of an integer;
// this avoids rounding twice via an approximate floating-point parser.
struct Decimal {
    digits: Vec<u8>,
    point: i64,
}

fn digit(byte: u8) -> bool { byte >= b'0' && byte <= b'9' }

fn normalized(digits: &[u8], point: i64) -> Decimal {
    let mut first = 0usize;
    while first < digits.len() && digits[first] == b'0' { first += 1usize; }
    let mut end = digits.len();
    while end > first && digits[end-1usize] == b'0' { end -= 1usize; }
    Decimal { digits: digits[first..end].to_vec(), point: point - first as i64 }
}

fn compare(a: &Decimal, b: &Decimal) -> i32 {
    if a.digits.is_empty() { return if b.digits.is_empty() { 0i32 } else { -1i32 }; }
    if b.digits.is_empty() { return 1i32; }
    if a.point < b.point { return -1i32; }
    if a.point > b.point { return 1i32; }
    let mut i = 0usize;
    while i < a.digits.len() || i < b.digits.len() {
        let x = if i < a.digits.len() { a.digits[i] } else { b'0' };
        let y = if i < b.digits.len() { b.digits[i] } else { b'0' };
        if x < y { return -1i32; }
        if x > y { return 1i32; }
        i += 1usize;
    }
    0i32
}

// Parse a decimal magnitude and sign. Saturating the exponent beyond the
// entire input length plus 2048 cannot change any binary64 integer verdict.
fn decimal(raw: &[u8]) -> Option<(Decimal,bool)> {
    let mut i = 0usize;
    let mut negative = false;
    if i < raw.len() && (raw[i] == b'+' || raw[i] == b'-') {
        negative = raw[i] == b'-'; i += 1usize;
    }
    let mut digits = Vec::new();
    while i < raw.len() && digit(raw[i]) { digits.push(raw[i]); i += 1usize; }
    let point = digits.len() as i64;
    if i < raw.len() && raw[i] == b'.' {
        i += 1usize;
        while i < raw.len() && digit(raw[i]) { digits.push(raw[i]); i += 1usize; }
    }
    if digits.is_empty() { return None; }
    let mut exponent = 0i64;
    if i < raw.len() && (raw[i] == b'e' || raw[i] == b'E') {
        i += 1usize;
        let mut minus = false;
        if i < raw.len() && (raw[i] == b'+' || raw[i] == b'-') {
            minus = raw[i] == b'-'; i += 1usize;
        }
        let start = i;
        let limit = raw.len() as i64 + 2048i64;
        while i < raw.len() && digit(raw[i]) {
            if exponent < limit {
                exponent = exponent * 10i64 + (raw[i] - b'0') as i64;
                if exponent > limit { exponent = limit; }
            }
            i += 1usize;
        }
        if i == start { return None; }
        if minus { exponent = -exponent; }
    }
    if i != raw.len() { return None; }
    Some((normalized(&digits, point + exponent),negative))
}

// Exact decimal expansion of numerator / 2^power. Generate digits in
// reverse order so multiplication by five needs only single-digit carries.
fn dyadic(numerator: u64, power: usize) -> Decimal {
    let mut n = numerator;
    let mut reversed = Vec::new();
    while n > 0u64 { reversed.push((n % 10u64) as u8); n /= 10u64; }
    let mut p = 0usize;
    while p < power {
        let mut carry = 0u8;
        let mut index = 0usize;
        while index < reversed.len() {
            let product = reversed[index] * 5u8 + carry;
            reversed[index] = product % 10u8;
            carry = product / 10u8;
            index += 1usize;
        }
        if carry != 0u8 { reversed.push(carry); }
        p += 1usize;
    }
    let mut digits = Vec::new();
    let mut i = reversed.len();
    while i > 0usize { i -= 1usize; digits.push(reversed[i] + b'0'); }
    normalized(&digits, digits.len() as i64 - power as i64)
}

fn decimal_equals(raw: &[u8], actual: usize) -> bool {
    let parsed = match decimal(raw) { Some(value) => value, None => return false };
    let value = &parsed.0;
    if actual == 0usize {
        if value.digits.is_empty() { return true; }
        // Half the least positive subnormal rounds to zero (also for -0).
        return compare(value, &dyadic(1u64, 1075usize)) <= 0i32;
    }
    if parsed.1 || value.digits.is_empty() { return false; }
    // A Node Buffer cannot have >= 2^53 bytes. Every possible positive
    // predecessor line count is an exactly representable binary64 integer.
    let n = actual as u64;
    if n >= (1u64 << 53u64) { return false; }
    let mut e = 0u32;
    let mut top = n;
    while top > 1u64 { top = top >> 1u64; e += 1u32; }
    let high_power = 53u32 - e;
    let low_power = if n == (1u64 << (e as u64)) { high_power + 1u32 } else { high_power };
    let low = dyadic((n << (low_power as u64)) - 1u64, low_power as usize);
    let high = dyadic((n << (high_power as u64)) + 1u64, high_power as usize);
    // The integer's significand is even unless its spacing is exactly one
    // and the integer is odd. Midpoint ties then round to the neighbor.
    let even = e < 52u32 || n % 2u64 == 0u64;
    let a = compare(value, &low);
    let b = compare(value, &high);
    (a > 0i32 || (a == 0i32 && even)) && (b < 0i32 || (b == 0i32 && even))
}

fn js_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9u32 && n <= 13u32) || n == 32u32 || n == 0xa0u32 || n == 0x1680u32
        || (n >= 0x2000u32 && n <= 0x200au32) || n == 0x2028u32 || n == 0x2029u32
        || n == 0x202fu32 || n == 0x205fu32 || n == 0x3000u32 || n == 0xfeffu32
}

fn number_string_equals(input: &str, actual: usize) -> bool {
    let mut start = 0usize;
    let mut end = 0usize;
    let mut at = 0usize;
    let mut seen = false;
    for c in input.chars() {
        let width = c.len_utf8();
        if !js_space(c) {
            if !seen { start = at; seen = true; }
            end = at + width;
        }
        at += width;
    }
    if !seen { return actual == 0usize; }
    let raw = &input.as_bytes()[start..end];
    if raw.len() > 2usize && raw[0usize] == b'0' {
        let radix = match raw[1usize] {
            b'x' | b'X' => 16u64, b'b' | b'B' => 2u64, b'o' | b'O' => 8u64, _ => 0u64,
        };
        if radix != 0u64 {
            let mut n = 0u64;
            for b in &raw[2usize..] {
                let d = match *b {
                    b'0'..=b'9' => (*b-b'0') as u64,
                    b'a'..=b'f' => (*b-b'a'+10u8) as u64,
                    b'A'..=b'F' => (*b-b'A'+10u8) as u64,
                    _ => return false,
                };
                if d >= radix { return false; }
                if n > (actual as u64) / radix { return false; }
                n = n * radix + d;
                if n > actual as u64 { return false; }
            }
            return n == actual as u64;
        }
    }
    decimal_equals(raw,actual)
}

fn field_is(object: &Value, key: &str, expected: &str) -> bool {
    object.get(key).and_then(|value: &Value| value.as_str()) == Some(expected)
}

fn count_is(object: &Value, key: &str, actual: usize, numeric_strings: bool) -> bool {
    let expected = format!("{actual}");
    match object.get(key) {
        Some(Value::String(s)) => s.as_str() == expected.as_str()
            || (numeric_strings && number_string_equals(s.as_str(),actual)),
        Some(Value::Number(n)) => n.as_str() == expected.as_str() || decimal_equals(n.as_bytes(),actual),
        _ => false,
    }
}

fn find(input: &[u8], needle: &[u8]) -> Option<usize> {
    let mut at = 0usize;
    while at < input.len() {
        if bytes::starts_with(&input[at..], needle) { return Some(at); }
        at += 1usize;
    }
    None
}

fn unique(input: &[u8], needle: &[u8], reason: &str) -> Result<usize, String> {
    let at = find(input, needle).ok_or(reason.to_string())?;
    require(find(&input[at + needle.len()..], needle).is_none(), reason)?;
    Ok(at)
}

struct FileFacts {
    digest: String,
    bytes: usize,
    lines: usize,
}

fn verify_file(files: &Value, path: &str, input: &[u8]) -> Result<FileFacts, String> {
    let expected = files.get(path).and_then(|value: &Value| value.as_str()).unwrap_or("");
    if expected.len() != 64usize || !expected.as_bytes().iter()
        .all(|byte: &u8| (*byte >= b'0' && *byte <= b'9') || (*byte >= b'a' && *byte <= b'f')) {
        return Err(format!("invalid hash for {path}"));
    }
    let digest = sha256::hex_digest(input);
    if digest.as_str() != expected {
        return Err(format!("upstream bytes differ: {path}"));
    }
    Ok(FileFacts {
        digest,
        bytes: input.len(),
        lines: input.iter().filter(|byte: &&u8| **byte == b'\n').count(),
    })
}

fn ident_start(b: u8) -> bool {
    b == b'_' || (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z')
}

fn line_break(b: u8) -> bool { b == b'\n' || b == b'\r' }

fn test_name(input: &[u8]) -> Option<String> {
    let prefix = b"#[test]\nfn ";
    if !bytes::starts_with(input,prefix) { return None; }
    let start = prefix.len();
    if start >= input.len() || !ident_start(input[start]) { return None; }
    let mut end = start+1usize;
    while end < input.len() && (ident_start(input[end]) || digit(input[end])) { end += 1usize; }
    if !bytes::starts_with(&input[end..], b"() {") { return None; }
    Some(String::from_utf8(input[start..end].to_vec()).unwrap())
}

// The oracle scans Latin-1 bytes with multiline regexes. Keep CR/LF
// anchors, space/tab indentation and Latin-1 \s distinct. In particular,
// assertion whitespace may cross lines; projection bytes need not be UTF-8.
fn assertion(input: &[u8]) -> bool {
    let mut at = 0usize;
    while at < input.len() && (input[at] == b' ' || input[at] == b'\t') { at += 1usize; }
    let rest = &input[at..];
    if bytes::starts_with(rest,b"assert!") { at += 7usize; }
    else if bytes::starts_with(rest,b"assert_eq!") || bytes::starts_with(rest,b"assert_ne!") { at += 10usize; }
    else { return false; }
    while at < input.len() {
        let b = input[at];
        if (b >= 9u8 && b <= 13u8) || b == b' ' || b == 0xa0u8 { at += 1usize; }
        else { break; }
    }
    at < input.len() && input[at] == b'('
}

fn test_inventory(tests: &[u8], manifest: &Value) -> Result<(Vec<String>, usize), String> {
    let expected = manifest.get("test_names").and_then(|value: &Value| value.as_array())
        .ok_or("manifest must name eight tests".to_string())?;
    require(expected.len() == 8usize && expected.iter().all(|value: &Value| value.as_str().is_some()),
        "manifest must name eight tests")?;

    let mut names = Vec::new();
    let mut attributes = 0usize;
    let mut assertions = 0usize;
    let mut i = 0usize;
    while i < tests.len() {
        if i == 0usize || line_break(tests[i-1usize]) {
            let rest = &tests[i..];
            if bytes::starts_with(rest,b"#[test]") &&
                (rest.len() == 7usize || line_break(rest[7usize])) {
                attributes += 1usize;
            }
            if let Some(name) = test_name(rest) { names.push(name); }
            if assertion(rest) { assertions += 1usize; }
        }
        i += 1usize;
    }
    require(names.len() == 8usize && attributes == 8usize, "projection must contain eight tests")?;
    let mut unique_names: BTreeSet<String> = BTreeSet::new();
    for (index, name) in names.iter().enumerate() {
        require(expected[index].as_str() == Some(name.as_str()), "ordered test names differ")?;
        unique_names.insert(name.clone());
    }
    require(unique_names.len() == names.len(), "duplicate test name")?;
    require(assertions > 0usize, "no upstream assertions")?;
    Ok((names, assertions))
}

fn file_json(path: &str, file: &FileFacts) -> String {
    let byte_count = file.bytes;
    let line_count = file.lines;
    let digest = file.digest.as_str();
    format!("      \"{path}\": {{\n         \"bytes\": {byte_count},\n         \"lines\": {line_count},\n         \"sha256\": \"{digest}\"\n      }}")
}

fn render(license: &FileFacts, library: &FileFacts, tests: &FileFacts,
    projection: &[u8], names: &[String], assertion_count: usize) -> String {
    let license = file_json("license", license);
    let library = file_json("src/lib.rs", library);
    let tests = file_json("tests/lib.rs", tests);
    let mut test_names = String::new();
    for name in names {
        if !test_names.is_empty() { test_names.push_str(",\n"); }
        test_names.push_str(format!("      \"{name}\"").as_str());
    }
    let test_count = names.len();
    let projection_digest = sha256::hex_digest(projection);
    let commit = COMMIT;
    format!(r#"{{
   "assertion_count": {assertion_count},
   "commit": "{commit}",
   "exact_upstream_bytes": true,
   "files": {{
{license},
{library},
{tests}
   }},
   "inverse_range_replacements": 1,
   "kind": "levenshtein-upstream-provenance",
   "projection_sha256": "{projection_digest}",
   "restored_header_lines": 2,
   "schema": 1,
   "test_count": {test_count},
   "test_names": [
{test_names}
   ]
}}
"#)
}

pub fn provenance(source: &mut ReadDirectory) -> Result<String, String> {
    let manifest = json::parse(&read(source, "upstream.json")?)
        .map_err(|problem| -> String { format!("{problem}") })?;
    let projection = read(source, "upstream.lkj")?;
    let license = read(source, "LICENSE")?;

    require(manifest.as_object().is_some(), "manifest must be an object")?;
    require(count_is(&manifest, "schema", 1usize, false), "unsupported manifest schema")?;
    require(field_is(&manifest, "name", "levenshtein"), "wrong package name")?;
    require(field_is(&manifest, "version", "1.0.5"), "wrong package version")?;
    require(field_is(&manifest, "origin", "https://github.com/wooorm/levenshtein-rs"), "wrong source origin")?;
    require(field_is(&manifest, "commit", COMMIT), "wrong pinned commit")?;
    require(field_is(&manifest, "license", "MIT"), "wrong license identity")?;
    let files = manifest.get("files").filter(|value: &&Value| value.as_object().is_some())
        .ok_or("missing file hashes".to_string())?;
    let adaptation = manifest.get("adaptation").filter(|value: &&Value| value.as_object().is_some())
        .ok_or("missing adaptation contract".to_string())?;
    require(count_is(adaptation, "range_expression", 1usize, false), "range adaptation count must be one")?;
    require(count_is(adaptation, "integration_header_lines", 2usize, false), "integration header count must be two")?;

    let boundary = unique(&projection, MARKER, "projection must contain exactly one integration boundary")?;
    let normalized = &projection[..boundary];
    let tests = &projection[boundary + MARKER.len()..];
    require(!normalized.is_empty() && !tests.is_empty(), "empty projection section")?;
    let range = unique(normalized, NORMALIZED, "library must contain exactly one normalized range expression")?;
    require(find(normalized, ORIGINAL).is_none(), "library contains an unexpected original range expression")?;

    let mut library = Vec::new();
    bytes::append_bytes(&mut library, &normalized[..range]);
    bytes::append_bytes(&mut library, ORIGINAL);
    bytes::append_bytes(&mut library, &normalized[range + NORMALIZED.len()..]);
    let mut upstream_tests = Vec::new();
    bytes::append_bytes(&mut upstream_tests, HEADER);
    bytes::append_bytes(&mut upstream_tests, tests);

    let license_facts = verify_file(files, "license", &license)?;
    let library_facts = verify_file(files, "src/lib.rs", &library)?;
    let test_facts = verify_file(files, "tests/lib.rs", &upstream_tests)?;
    require(count_is(&manifest, "source_lines", library_facts.lines, true), "source line count differs")?;
    require(count_is(&manifest, "test_lines", test_facts.lines, true), "test line count differs")?;
    let (names, assertions) = test_inventory(tests, &manifest)?;
    Ok(render(&license_facts, &library_facts, &test_facts, &projection, &names, assertions))
}

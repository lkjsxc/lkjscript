      (parameter create positions (type (list I64))) (parameter create offset (type I64))
      (parameter create work (type W) (use consume)) (returns W)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local positions)))
        (let
          (binding position (type I64) (call std::list-get (types I64) (local positions) (local offset)))
          (binding frame (type OwnedI64Cell) (call worklist-carriers::cell-create (local position)))
          (binding next (type W)
            (method-call parameter@queue@implparam_c8020000000000000000000000000001
              owned-worklists::Worklist method_88000000000000000000000000000013
              (local frame) (local work)))
          (in (implementation-call queue (types W)
            (implementations parameter@queue@implparam_c8020000000000000000000000000001)
            (local positions) (call std::add (local offset) (i64 1)) (local next))))
        (local work))))

    ; Labels are bounded internal positions. -1 is absence, not an authored ID.
    ; Duplicate pending entries are consumed; each node's edges are expanded once.
    (function create walk (visibility private) (effect pure)
      (type-parameter create W (constraint owned))

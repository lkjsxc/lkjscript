                  (call std::map-get-or (types I64 I64) (local labels) (local position) (i64 -1)) (i64 0))
                  (let
                    (binding predecessors (type (list I64))
                      (call std::map-get-or (types I64 (list I64)) (local reverse) (local position) (list I64)))
                    (binding next (type W) (implementation-call queue (types W)
                      (implementations parameter@walk@implparam_c8020000000000000000000000000002)
                      (local predecessors) (i64 0) (local rest)))
                    (in (implementation-call walk (types W)
                      (implementations parameter@walk@implparam_c8020000000000000000000000000002)
                      (local reverse) (local label)
                      (call std::map-insert (types I64 I64) (local labels) (local position) (local label))
                      (local next))))
                  (implementation-call walk (types W)
                    (implementations parameter@walk@implparam_c8020000000000000000000000000002)
                    (local reverse) (local label) (local labels) (local rest))))))))))))))

    (function create forest (visibility private) (effect pure)

declarations.begin
(units (use plan-stages pkg_7f2c7a229f1a9f475f0b208e6a40a323 package_revision_868454cb96f9ac3d915b725bd0627450d762dd73b4204ed88649b6cb03d3691e))
declarations.end
declarations.begin
(units
  (use std builtin)
  (module create component-data
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Reverse (map I64 (list I64)))
    (type-alias Members (map I64 (list I64)))
    (type-alias Loops (map I64 Bool))
    (type-alias Component (record (members (list I64)) (cyclic Bool)))

    (function create index (visibility private) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create offset (type I64))
      (parameter create positions (type Positions)) (returns Positions)
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local nodes)))
        (let (binding node (type Node) (call std::list-get (types Node) (local nodes) (local offset)))
          (in (call index (local nodes) (call std::add (local offset) (i64 1))
            (call std::map-insert (types I64 I64) (local positions)
              (field (local node) (name id)) (local offset)))))
        (local positions))))
    (function create positions (visibility public) (effect pure)
      (parameter create nodes (type (list Node))) (returns Positions)
      (body (call index (local nodes) (i64 0) (map I64 I64))))

    (function create incoming (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create source (type I64)) (parameter create positions (type Positions))
      (parameter create reverse (type Reverse)) (returns Reverse)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (let
          (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
          (binding target (type I64)
            (call std::map-get-or (types I64 I64) (local positions) (local id) (i64 -1)))
          (binding previous (type (list I64))
            (call std::map-get-or (types I64 (list I64)) (local reverse) (local target) (list I64)))
          (in (call incoming (local ids) (call std::add (local offset) (i64 1))
            (local source) (local positions)
            (call std::map-insert (types I64 (list I64)) (local reverse) (local target)
              (call std::list-append (types I64) (local previous) (local source))))))
        (local reverse))))
    (function create transpose (visibility private) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create offset (type I64))
      (parameter create positions (type Positions)) (parameter create reverse (type Reverse))
      (returns Reverse)
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local nodes)))
        (let
          (binding node (type Node) (call std::list-get (types Node) (local nodes) (local offset)))
          (binding next (type Reverse) (call incoming (field (local node) (name successors))
            (i64 0) (local offset) (local positions) (local reverse)))
          (in (call transpose (local nodes) (call std::add (local offset) (i64 1))
            (local positions) (local next))))
        (local reverse))))
    (function create reverse (visibility public) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create positions (type Positions))
      (returns Reverse)
      (body (call transpose (local nodes) (i64 0) (local positions) (map I64 (list I64)))))

    (function create self-loop (visibility private) (effect pure)
      (parameter create id (type I64)) (parameter create successors (type (list I64)))
      (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local successors)))
        (let
          (binding target (type I64) (call std::list-get (types I64) (local successors) (local offset)))
          (binding same (type Bool) (if (call std::less (local id) (local target)) (bool false)
            (if (call std::less (local target) (local id)) (bool false) (bool true))))
          (in (if (local same) (bool true)
            (call self-loop (local id) (local successors) (call std::add (local offset) (i64 1))))))
        (bool false))))

    (function create emit (visibility private) (effect pure)
      (parameter create members (type Members)) (parameter create loops (type Loops))
      (parameter create order (type (list I64))) (parameter create offset (type I64))
      (parameter create output (type (list Component))) (returns (list Component))
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local order)))
        (let
          (binding label (type I64) (call std::list-get (types I64) (local order) (local offset)))
          (binding group (type (list I64))
            (call std::map-get-or (types I64 (list I64)) (local members) (local label) (list I64)))
          (binding cyclic (type Bool) (if (call std::less (i64 1) (call std::list-length (types I64) (local group)))
            (bool true) (call std::map-get-or (types I64 Bool) (local loops) (local label) (bool false))))
          (in (call emit (local members) (local loops) (local order)
            (call std::add (local offset) (i64 1))
            (call std::list-append (types Component) (local output)
              (record structural (field members (local group)) (field cyclic (local cyclic)))))))
        (local output))))

    ; Group only after both passes; neither DFS order nor labels become identity.
    (function create collect (visibility private) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create labels (type Positions))
      (parameter create offset (type I64)) (parameter create members (type Members))
      (parameter create loops (type Loops)) (parameter create order (type (list I64)))
      (returns (list Component))
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local nodes)))
        (let
          (binding node (type Node) (call std::list-get (types Node) (local nodes) (local offset)))
          (binding label (type I64)
            (call std::map-get-or (types I64 I64) (local labels) (local offset) (i64 -1)))
          (binding previous (type (list I64))
            (call std::map-get-or (types I64 (list I64)) (local members) (local label) (list I64)))
          (binding next-order (type (list I64))
            (if (call std::less (i64 0) (call std::list-length (types I64) (local previous)))
              (local order) (call std::list-append (types I64) (local order) (local label))))
          (binding cyclic (type Bool)
            (if (call std::map-get-or (types I64 Bool) (local loops) (local label) (bool false))
              (bool true) (call self-loop (field (local node) (name id))
                (field (local node) (name successors)) (i64 0))))
          (in (call collect (local nodes) (local labels) (call std::add (local offset) (i64 1))
            (call std::map-insert (types I64 (list I64)) (local members) (local label)
              (call std::list-append (types I64) (local previous) (field (local node) (name id))))
            (call std::map-insert (types I64 Bool) (local loops) (local label) (local cyclic))
            (local next-order))))
        (call emit (local members) (local loops) (local order) (i64 0) (list Component)))))
    (function create summarize (visibility public) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create labels (type Positions))
      (returns (list Component))
      (body (call collect (local nodes) (local labels) (i64 0)
        (map I64 (list I64)) (map I64 Bool) (list I64))))))
declarations.end

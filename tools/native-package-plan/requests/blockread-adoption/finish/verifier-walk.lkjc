declarations.begin
(units (use worklist-carriers pkg_da6c35a66052e6eb317abd2a0ad0c8ff package_revision_754a9ae4f2bd2f80ef62dddfb678ef75391df722e21283b7d7b17ae008142a9f))
declarations.end
declarations.begin
(units
  (use std builtin)
  (module create plan-verify-walk
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Links (map I64 (list I64)))
    (type-alias Positions (map I64 I64))
    (type-alias State (record (queue (list I64)) (seen (map I64 Bool))))
    (function create enqueue (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create rank (type I64)) (parameter create membership (type Positions))
      (parameter create state (type State)) (returns State)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (let
          (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
          (binding same (type Bool) (call plan-verify-data::same (local rank)
            (call std::map-get-or (types I64 I64) (local membership) (local id) (i64 -1))))
          (binding seen (type (map I64 Bool)) (field (local state) (name seen)))
          (in (if (local same)
            (if (call std::map-get-or (types I64 Bool) (local seen) (local id) (bool false))
              (call enqueue (local ids) (call std::add (local offset) (i64 1))
                (local rank) (local membership) (local state))
              (call enqueue (local ids) (call std::add (local offset) (i64 1))
                (local rank) (local membership) (record structural
                  (field queue (call std::list-append (types I64) (field (local state) (name queue)) (local id)))
                  (field seen (call std::map-insert (types I64 Bool) (local seen) (local id) (bool true))))))
            (call enqueue (local ids) (call std::add (local offset) (i64 1))
              (local rank) (local membership) (local state)))))
        (local state))))
    (function create walk (visibility private) (effect pure)
      (parameter create links (type Links)) (parameter create rank (type I64))
      (parameter create membership (type Positions)) (parameter create offset (type I64))
      (parameter create state (type State)) (returns I64)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (field (local state) (name queue))))
        (let
          (binding id (type I64) (call std::list-get (types I64) (field (local state) (name queue)) (local offset)))
          (binding adjacent (type (list I64))
            (call std::map-get-or (types I64 (list I64)) (local links) (local id) (list I64)))
          (in (call walk (local links) (local rank) (local membership) (call std::add (local offset) (i64 1))
            (call enqueue (local adjacent) (i64 0) (local rank) (local membership) (local state)))))
        (local offset))))
    (function create count (visibility private) (effect pure)
      (parameter create links (type Links)) (parameter create rank (type I64))
      (parameter create membership (type Positions)) (parameter create leader (type I64))
      (returns I64)
      (body (call walk (local links) (local rank) (local membership) (i64 0)
        (record structural (field queue (list I64 (local leader)))
          (field seen (map I64 Bool (entry (local leader) (bool true))))))))
    ; Reach every member from the leader, then reach the leader from every member.
    ; Each member is queued once per direction. No finish-order or LIFO law is used.
    (function create connected (visibility public) (effect pure)
      (parameter create rows (type (list Row))) (parameter create forward (type Links))
      (parameter create reverse (type Links)) (parameter create membership (type Positions))
      (parameter create offset (type I64)) (returns Bool)
      (body (if (call std::less (local offset) (call std::list-length (types Row) (local rows)))
        (let
          (binding ids (type (list I64))
            (field (call std::list-get (types Row) (local rows) (local offset)) (name members)))
          (binding size (type I64) (call std::list-length (types I64) (local ids)))
          (binding leader (type I64) (call std::list-get (types I64) (local ids) (i64 0)))
          (in (if (call std::less (i64 1) (local size))
            (if (call plan-verify-data::same (local size)
              (call count (local forward) (local offset) (local membership) (local leader)))
              (if (call plan-verify-data::same (local size)
                (call count (local reverse) (local offset) (local membership) (local leader)))
                (call connected (local rows) (local forward) (local reverse) (local membership)
                  (call std::add (local offset) (i64 1))) (bool false)) (bool false))
            (call connected (local rows) (local forward) (local reverse) (local membership)
              (call std::add (local offset) (i64 1))))))
        (bool true))))))
declarations.end

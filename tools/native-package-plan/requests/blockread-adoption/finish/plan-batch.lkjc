            parameter@collect-with-storage@implparam_a4000000000000000000000000000002 parameter@collect-with-storage@implparam_a4000000000000000000000000000003
              parameter@collect-with-storage@implparam_a5000000000000000000000000000006)
            (local proposals) (call std::add (local offset) (i64 1))

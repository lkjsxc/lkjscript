(units
  (use std builtin)
  (module create component-order
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Seen (map I64 Bool))

    ; Frames contain bounded node positions, never arithmetic on authored IDs.
    ; [0,n) enters a node; [n,2n) finishes it after its descendants.
    (function create queue (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_c8010000000000000000000000000001
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create positions (type Positions))
      (parameter create work (type W) (use consume)) (returns W)
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
        (let
          (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
          (binding position (type I64)
            (call std::map-get-or (types I64 I64) (local positions) (local id) (i64 -1)))
          (binding frame (type OwnedI64Cell) (call worklist-carriers::cell-create (local position)))
          (binding next (type W)
            (method-call parameter@queue@implparam_c8010000000000000000000000000001
              owned-worklists::Worklist method_88000000000000000000000000000013
              (local frame) (local work)))
          (in (implementation-call queue (types W)
            (implementations parameter@queue@implparam_c8010000000000000000000000000001)
            (local ids) (call std::add (local offset) (i64 1)) (local positions) (local next))))
        (local work))))

    ; Mark on entry, not while scheduling siblings: an edge between pending
    ; siblings must still become a DFS tree edge before a finish event is emitted.
    (function create walk (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_c8010000000000000000000000000002
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create nodes (type (list Node))) (parameter create positions (type Positions))
      (parameter create seen (type Seen)) (parameter create order (type (list I64)))
      (parameter create work (type W) (use consume))
      (returns (owned-product (field work W) (field seen Seen) (field order (list I64))))
      (body (let (binding outcome
        (type (owned-choice (case empty W)
          (case item (owned-product (field rest W) (field value OwnedI64Cell)))))
        (method-call parameter@walk@implparam_c8010000000000000000000000000002
          owned-worklists::Worklist method_88000000000000000000000000000014 (local work)))
        (in (match-owned (type (owned-choice (case empty W)
          (case item (owned-product (field rest W) (field value OwnedI64Cell))))) (local outcome)
          (case empty (binding rest (type W))
            (in (pack-owned (type (owned-product (field work W) (field seen Seen) (field order (list I64))))
              (field work (local rest)) (field seen (local seen)) (field order (local order)))))
          (case item (binding item (type (owned-product (field rest W) (field value OwnedI64Cell))))
            (in (unpack-owned (type (owned-product (field rest W) (field value OwnedI64Cell))) (local item)
              (field rest (binding rest (type W))) (field value (binding frame (type OwnedI64Cell)))
              (in (let
                (binding event (type I64) (call worklist-carriers::cell-finish (local frame)))
                (binding size (type I64) (call std::list-length (types Node) (local nodes)))
                (in (if (call std::less (local event) (local size))
                  (if (call std::map-get-or (types I64 Bool) (local seen) (local event) (bool false))
                    (implementation-call walk (types W)
                      (implementations parameter@walk@implparam_c8010000000000000000000000000002)
                      (local nodes) (local positions) (local seen) (local order) (local rest))
                    (let
                      (binding node (type Node) (call std::list-get (types Node) (local nodes) (local event)))
                      (binding finish (type OwnedI64Cell)
                        (call worklist-carriers::cell-create (call std::add (local size) (local event))))
                      (binding pending (type W)
                        (method-call parameter@walk@implparam_c8010000000000000000000000000002
                          owned-worklists::Worklist method_88000000000000000000000000000013
                          (local finish) (local rest)))
                      (binding next (type W) (implementation-call queue (types W)
                        (implementations parameter@walk@implparam_c8010000000000000000000000000002)
                        (field (local node) (name successors)) (i64 0) (local positions) (local pending)))
                      (in (implementation-call walk (types W)
                        (implementations parameter@walk@implparam_c8010000000000000000000000000002)
                        (local nodes) (local positions)
                        (call std::map-insert (types I64 Bool) (local seen) (local event) (bool true))
                        (local order) (local next)))))
                  (implementation-call walk (types W)
                    (implementations parameter@walk@implparam_c8010000000000000000000000000002)
                    (local nodes) (local positions) (local seen)
                    (call std::list-append (types I64) (local order)
                      (call std::subtract (local event) (local size)))
                    (local rest))))))))))))))

    (function create forest (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_c8010000000000000000000000000003
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create nodes (type (list Node))) (parameter create positions (type Positions))
      (parameter create offset (type I64)) (parameter create seen (type Seen))
      (parameter create order (type (list I64))) (parameter create work (type W) (use consume))
      (returns (list I64))
      (body (if (call std::less (local offset) (call std::list-length (types Node) (local nodes)))
        (if (call std::map-get-or (types I64 Bool) (local seen) (local offset) (bool false))
          (implementation-call forest (types W)
            (implementations parameter@forest@implparam_c8010000000000000000000000000003)
            (local nodes) (local positions) (call std::add (local offset) (i64 1))
            (local seen) (local order) (local work))
          (let
            (binding frame (type OwnedI64Cell) (call worklist-carriers::cell-create (local offset)))
            (binding pending (type W)
              (method-call parameter@forest@implparam_c8010000000000000000000000000003
                owned-worklists::Worklist method_88000000000000000000000000000013
                (local frame) (local work)))
            (binding visited (type (owned-product (field work W) (field seen Seen) (field order (list I64))))
              (implementation-call walk (types W)
                (implementations parameter@forest@implparam_c8010000000000000000000000000003)
                (local nodes) (local positions) (local seen) (local order) (local pending)))
            (in (unpack-owned (type (owned-product (field work W) (field seen Seen) (field order (list I64))))
              (local visited) (field work (binding work (type W)))
              (field seen (binding seen (type Seen))) (field order (binding order (type (list I64))))
              (in (implementation-call forest (types W)
                (implementations parameter@forest@implparam_c8010000000000000000000000000003)
                (local nodes) (local positions) (call std::add (local offset) (i64 1))
                (local seen) (local order) (local work)))))))
        (local order))))

    ; Internal companion API: the application validates the complete graph first.
    (function create finish (visibility public) (effect pure)
      (type-parameter create W (constraint owned))
      (implementation-parameter implparam_c8010000000000000000000000000004
        work owned-worklists::Worklist W (types OwnedI64Cell))
      (parameter create nodes (type (list Node))) (parameter create positions (type Positions))
      (returns (list I64))
      (body (let (binding work (type W)
        (method-call parameter@finish@implparam_c8010000000000000000000000000004
          owned-worklists::Worklist method_88000000000000000000000000000011))
        (in (implementation-call forest (types W)
          (implementations parameter@finish@implparam_c8010000000000000000000000000004)
          (local nodes) (local positions) (i64 0) (map I64 Bool) (list I64) (local work))))))))

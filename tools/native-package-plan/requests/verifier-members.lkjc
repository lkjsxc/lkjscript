declarations.begin
(units (use worklist-carriers pkg_d2c6ea605e6acb8fcdd0e21aa152b7c2 package_revision_3826223cfd2e6a05b6ea328a0a7bb4eda1706045d322decaa41313174ff27581))
declarations.end
declarations.begin
(units
  (use std builtin)
  (module create plan-verify-members
    (type-alias Node (record (id I64) (successors (list I64))))
    (type-alias Row (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Members (record (valid Bool) (last I64) (count I64) (membership Positions)))
    (type-alias Index (record (valid Bool) (last I64) (count I64)
      (membership Positions) (leaders Positions)))
    (function create refused (visibility private) (effect pure) (returns Index)
      (body (record structural (field valid (bool false)) (field last (i64 -1)) (field count (i64 0))
        (field membership (map I64 I64)) (field leaders (map I64 I64)))))
    (function create member-refused (visibility private) (effect pure) (returns Members)
      (body (record structural (field valid (bool false)) (field last (i64 -1))
        (field count (i64 0)) (field membership (map I64 I64)))))

    ; Map values are nonnegative positions. No signed node ID is a sentinel.
    (function create members (visibility private) (effect pure)
      (parameter create ids (type (list I64))) (parameter create offset (type I64))
      (parameter create rank (type I64)) (parameter create positions (type Positions))
      (parameter create state (type Members)) (returns Members)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types I64) (local ids)))
          (let
            (binding id (type I64) (call std::list-get (types I64) (local ids) (local offset)))
            (binding position (type I64)
              (call std::map-get-or (types I64 I64) (local positions) (local id) (i64 -1)))
            (binding membership (type Positions) (field (local state) (name membership)))
            (in (if (call std::less (field (local state) (name last)) (local position))
              (if (call std::less (call std::map-get-or (types I64 I64)
                (local membership) (local id) (i64 -1)) (i64 0))
                (call members (local ids) (call std::add (local offset) (i64 1))
                  (local rank) (local positions) (record structural
                    (field valid (bool true)) (field last (local position))
                    (field count (call std::add (field (local state) (name count)) (i64 1)))
                    (field membership (call std::map-insert (types I64 I64)
                      (local membership) (local id) (local rank)))))
                (call member-refused))
              (call member-refused))))
          (local state))
        (local state))))
    (function create groups (visibility private) (effect pure)
      (parameter create rows (type (list Row))) (parameter create offset (type I64))
      (parameter create positions (type Positions)) (parameter create state (type Index))
      (returns Index)
      (body (if (field (local state) (name valid))
        (if (call std::less (local offset) (call std::list-length (types Row) (local rows)))
          (let (binding ids (type (list I64))
            (field (call std::list-get (types Row) (local rows) (local offset)) (name members)))
            (in (if (call std::less (i64 0) (call std::list-length (types I64) (local ids)))
              (let
                (binding leader (type I64) (call std::list-get (types I64) (local ids) (i64 0)))
                (binding position (type I64)
                  (call std::map-get-or (types I64 I64) (local positions) (local leader) (i64 -1)))
                (in (if (call std::less (field (local state) (name last)) (local position))
                  (let (binding checked (type Members) (call members (local ids) (i64 0)
                    (local offset) (local positions) (record structural (field valid (bool true))
                      (field last (i64 -1)) (field count (field (local state) (name count)))
                      (field membership (field (local state) (name membership))))))
                    (in (call groups (local rows) (call std::add (local offset) (i64 1)) (local positions)
                      (record structural (field valid (field (local checked) (name valid)))
                        (field last (local position)) (field count (field (local checked) (name count)))
                        (field membership (field (local checked) (name membership)))
                        (field leaders (call std::map-insert (types I64 I64)
                          (field (local state) (name leaders)) (local leader) (local offset)))))))
                  (call refused))))
              (call refused))))
          (local state))
        (local state))))
    (function create index (visibility public) (effect pure)
      (parameter create nodes (type (list Node))) (parameter create rows (type (list Row)))
      (returns Index)
      (body (if (call std::less (call std::list-length (types Node) (local nodes))
        (call std::list-length (types Row) (local rows))) (call refused)
        (let (binding state (type Index) (call groups (local rows) (i64 0)
          (call plan-verify-data::positions (local nodes) (i64 0) (map I64 I64))
          (record structural (field valid (bool true)) (field last (i64 -1)) (field count (i64 0))
            (field membership (map I64 I64)) (field leaders (map I64 I64)))))
          (in (if (call plan-verify-data::same (field (local state) (name count))
            (call std::list-length (types Node) (local nodes))) (local state) (call refused)))))))))
declarations.end

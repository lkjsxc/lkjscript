declarations.begin
(units
  (use std builtin)
  (module create plan-presentation
    (type-alias Component (record (members (list I64)) (cyclic Bool)))
    (type-alias PlannedComponent (record (members (list I64)) (cyclic Bool) (dependencies (list I64))))
    (type-alias Positions (map I64 I64))
    (type-alias Links (map I64 (list I64)))
    (type-alias State (record (units (list PlannedComponent)) (stages Links) (maximum I64)))
    (type-alias Plan (record (components (list PlannedComponent)) (stages (list (list I64)))))

    (function create representative (visibility private) (effect pure)
      (parameter create components (type (list Component))) (parameter create rank (type I64))
      (returns I64)
      (body (call std::list-get (types I64)
        (field (call std::list-get (types Component) (local components) (local rank)) (name members)) (i64 0))))
    (function create identities (visibility private) (effect pure)
      (parameter create components (type (list Component))) (parameter create ranks (type (list I64)))
      (parameter create offset (type I64)) (parameter create output (type (list I64)))
      (returns (list I64))
      (body (if (call std::less (local offset) (call std::list-length (types I64) (local ranks)))
        (call identities (local components) (local ranks) (call std::add (local offset) (i64 1))
          (call std::list-append (types I64) (local output)
            (call representative (local components) (call std::list-get (types I64) (local ranks) (local offset)))))
        (local output))))
    (function create collect (visibility private) (effect pure)
      (parameter create components (type (list Component))) (parameter create dependencies (type Links))
      (parameter create levels (type Positions)) (parameter create offset (type I64))
      (parameter create state (type State)) (returns State)
      (body (if (call std::less (local offset) (call std::list-length (types Component) (local components)))
        (let
          (binding component (type Component)
            (call std::list-get (types Component) (local components) (local offset)))
          (binding level (type I64) (call std::map-get-or (types I64 I64) (local levels) (local offset) (i64 0)))
          (binding stages (type Links) (field (local state) (name stages)))
          (binding previous (type (list I64))
            (call std::map-get-or (types I64 (list I64)) (local stages) (local level) (list I64)))
          (binding maximum (type I64) (field (local state) (name maximum)))
          (in (call collect (local components) (local dependencies) (local levels)
            (call std::add (local offset) (i64 1))
            (record structural
              (field units (call std::list-append (types PlannedComponent) (field (local state) (name units))
                (record structural (field members (field (local component) (name members)))
                  (field cyclic (field (local component) (name cyclic)))
                  (field dependencies (call identities (local components)
                    (call std::map-get-or (types I64 (list I64)) (local dependencies) (local offset) (list I64))
                    (i64 0) (list I64))))))
              (field stages (call std::map-insert (types I64 (list I64)) (local stages) (local level)
                (call std::list-append (types I64) (local previous) (call representative (local components) (local offset)))))
              (field maximum (if (call std::less (local maximum) (local level)) (local level) (local maximum)))))))
        (local state))))
    (function create emit (visibility private) (effect pure)
      (parameter create stages (type Links)) (parameter create maximum (type I64))
      (parameter create offset (type I64)) (parameter create output (type (list (list I64))))
      (returns (list (list I64)))
      (body (if (call std::less (local maximum) (local offset)) (local output)
        (call emit (local stages) (local maximum) (call std::add (local offset) (i64 1))
          (call std::list-append (types (list I64)) (local output)
            (call std::map-get-or (types I64 (list I64)) (local stages) (local offset) (list I64)))))))
    (function create build (visibility public) (effect pure)
      (parameter create components (type (list Component))) (parameter create dependencies (type Links))
      (parameter create levels (type Positions)) (returns Plan)
      (body (let (binding state (type State)
        (call collect (local components) (local dependencies) (local levels) (i64 0)
          (record structural (field units (list PlannedComponent)) (field stages (map I64 (list I64))) (field maximum (i64 -1)))))
        (in (record structural (field components (field (local state) (name units)))
          (field stages (call emit (field (local state) (name stages))
            (field (local state) (name maximum)) (i64 0) (list (list I64)))))))))))
declarations.end

request base=BASE
declarations.begin
(units
  (use std builtin)
  (module edit GUIDES guides
    (record create Owner (visibility public)
      (field create kind (type Text))
      (field create name (type Text))
      (field create parent (type Text))
      (field create reference (type Text)))
    (record create Found (visibility public)
      (field create count (type I64))
      (field create reference (type Text)))
    (record create Selection (visibility public)
      (field create kind (type Text))
      (field create label (type Text))
      (field create found (type Found)))
    (record create Document (visibility public)
      (field create valid (type Bool))
      (field create content (type Text)))
    (record create Standard (visibility public)
      (field create package (type Text))
      (field create revision (type Text))
      (field create records (type Text)))
    (record create Limit (visibility public)
      (field create name (type Text))
      (field create maximum (type I64)))
    (function create collect-owner (visibility private)
      (parameter create kind (type Text))
      (parameter create name (type Text))
      (parameter create parent (type Text))
      (parameter create found (type Found))
      (parameter create owner (type Owner))
      (returns Found) (effect pure)
      (body (if (call std::bool-and
          (call std::text-equal (local kind) (field (local owner) Owner::kind))
          (call std::bool-and
            (call std::text-equal (local name) (field (local owner) Owner::name))
            (call std::text-equal (local parent) (field (local owner) Owner::parent))))
        (record Found
          (field Found::count (call std::add (field (local found) Found::count) (i64 1)))
          (field Found::reference (field (local owner) Owner::reference)))
        (local found))))
    (function create find-owner (visibility public)
      (parameter create owners (type (list Owner)))
      (parameter create kind (type Text))
      (parameter create name (type Text))
      (parameter create parent (type Text))
      (returns Found) (effect pure)
      (body (call std::list-fold-left (types Owner Found) (local owners)
        (record Found (field Found::count (i64 0)) (field Found::reference (text "")))
        (bind (function-value collect-owner) (local kind) (local name) (local parent)))))
    (function create select-owner (visibility private)
      (parameter create owners (type (list Owner)))
      (parameter create kind (type Text))
      (parameter create name (type Text))
      (parameter create parent (type Text))
      (parameter create label (type Text))
      (returns Selection) (effect pure)
      (body (record Selection
        (field Selection::kind (local kind)) (field Selection::label (local label))
        (field Selection::found
          (call find-owner (local owners) (local kind) (local name) (local parent))))))
    (function create selection-valid (visibility private)
      (parameter create item (type Selection))
      (returns Bool) (effect pure)
      (body (call std::bool-and
        (call std::i64-equal (field (field (local item) Selection::found) Found::count) (i64 1))
        (call std::bool-not (call std::text-empty
          (field (field (local item) Selection::found) Found::reference))))))
    (function create check-selection (visibility private)
      (parameter create valid (type Bool))
      (parameter create item (type Selection))
      (returns Bool) (effect pure)
      (body (call std::bool-and (local valid) (call selection-valid (local item)))))
    (function create selection-row (visibility private)
      (parameter create item (type Selection))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell (call guides::code (field (local item) Selection::kind))
        (call guides::code (field (local item) Selection::label))
        (call guides::code (field (field (local item) Selection::found) Found::reference)))))
    (function create selection-error (visibility private)
      (parameter create item (type Selection))
      (returns Text) (effect pure)
      (body (if (call selection-valid (local item)) (text "")
        (call markup::join (list Text (field (local item) Selection::kind) (text "/")
          (field (local item) Selection::label) (text ": matches=")
          (call std::i64-to-text (field (field (local item) Selection::found) Found::count))
          (text "; a unique nonempty reference is required\n"))))))
    (function create reference-table (visibility private)
      (parameter create references (type (list Selection)))
      (returns Text) (effect pure)
      (body (call markup::table
        (list Text (text "Kind") (text "Name") (text "Exact reference"))
        (call std::list-map (types Selection (list markup::Cell))
          (local references) (function-value selection-row)))))
    (function create checked-document (visibility private)
      (parameter create content (type Text))
      (parameter create references (type (list Selection)))
      (returns Document) (effect pure)
      (body (let
        (binding valid (call std::list-fold-left (types Selection Bool)
          (local references) (bool true) (function-value check-selection)))
        (in (record Document (field Document::valid (local valid))
          (field Document::content (if (local valid) (local content)
            (call markup::join (call std::list-map (types Selection Text)
              (local references) (function-value selection-error))))))))))
    (function create registry-body (visibility private)
      (parameter create records (type Text))
      (returns Text) (effect pure)
      (body (call markup::join (list Text
        (text "The following compact records are the executable-owned current public capability.\n\n")
        (call markup::code-block (local records))))))
    (function create change-grammar (visibility public)
      (parameter create build (type guides::Build))
      (parameter create sections (type (list Text)))
      (returns Text) (effect pure)
      (body (call markup::join (list Text (call guides::header (local build))
        (text "# Change request grammar\n\nNative declaration units, compact records and structural expression bodies lower into the same reviewed typed intent. A saved request is a proposal; accepted meaning remains the program authority. Units collect declarations before resolving names, provide lexical parameters and inline types, and allocate private expression/type labels and child indexes. Exact dependency changes and deliberate rename, move or deletion remain explicit compact operations.\n\n## Create and resume a declaration\n\nCreate an empty project with `lkjscript new author --template minimal --name demo`, then read its exact revision with `lkjscript --project author status`. Save this literal request as `hello.lkjc`, replacing only `REVISION` with that observed revision:\n\n```text\nrequest base=REVISION\ndeclarations.begin\n(units\n  (module create app\n    (record create Greeting (visibility public)\n      (field create message (type Text)))\n    (function create hello (visibility public)\n      (parameter create name (type Text))\n      (returns Greeting) (effect pure)\n      (body (record Greeting (field Greeting::message (local name)))))\n    (test create example (visibility private)\n      (actual (call hello (text \"hello\")))\n      (expected (record Greeting (field Greeting::message (text \"hello\")))))))\ndeclarations.end\n```\n\nRun `lkjscript --project author change plan --input-file hello.lkjc`, review the complete plan, then run `change apply --input-file hello.lkjc --plan TOKEN` against the same project with its returned token. Run `check` to execute graph tests differentially. No standard dependency is needed for this example.\n\nFind the module with `lkjscript --project author query find module app`. Use its exact `mod_...` identity in `lkjscript --project author change draft --owner MODULE --output edit.lkjc`. The destination must be absent and outside accepted project storage. A module expands its own declarations; separate repeatable selections may name connected declarations or targets. Referenced outside declarations are exact references, not copied definitions.\n\nThe draft includes its repository, package and base revision, complete edit units and exact contract-child bindings. Without an edit, `change plan --input-file edit.lkjc` reports `outcome=unchanged`, with no publication token. After changing a body or adding an explicit `parameter create ...`, plan and apply the complete repair with the returned token. Existing parameter entries stay `edit EXACT_ID NAME`; omissions are errors, and changing a displayed name does not authorize a rename. Unselected owners survive. Deleting the original authoring inputs does not prevent another draft from accepted meaning.\n\nGenerated structural aliases are interned notation. Original aliases, comments and formatting are not stored. Positional parameters and generic/effect/requirement contracts retain canonical order; keyed fields, cases and match arms use canonical identity order. Expression evaluation order remains explicit. Drafts preserve the accepted body when untouched; a real body replacement follows the existing expression/binding retirement contract.\n\nFor the standard library, discover `package builtin inspect`, export its exact transport, and stage it with `package dependency stage --transport DIGEST --input-file PATH`. Add its observed package, semantic revision and package revision with `add.dependency`. Then `(use std builtin)` supplies typed names such as `std::add`, `std::list-fold-left`, and `std::DataStore::get`. An ordinary supplier uses `(use lib PACKAGE PACKAGE_REVISION)` and its public exported names, for example `lib::Summary`. Private dependency members reject. No ambient lookup, wildcard import, implicit upgrade, effect inference or grant is introduced.\n\nAn edited request has one atomic semantic publication boundary. Output capacity, cancellation and an existing draft destination cannot publish a partial draft. A later failed build does not undo an accepted change. Artifacts built through `build --output FILE` require a compatible runtime; they are not self-contained executables.\n\nWith an ordinary reference/declaration prelude for `$add`, this block exports one expression root for `create.function ... body=$body` or `replace.body function=FUNCTION body=$body`:\n\n```text\nexpression.block as=$body\n  (let\n    (binding value (type i64) (i64 2))\n    (binding value (type i64) (call $add (local value) (i64 3)))\n    (in (local value)))\nexpression.end\n```\n\nThe second initializer reads the earlier `value`; the body reads the new binding. Each occurrence and binder has distinct ownership. Only the root is exported, and it must be consumed exactly once. Nested nodes cannot be addressed by outer flat edges. All 22 structural forms, explicit application clauses, lexical rules and flat fields are advertised below. The [change input specification](../spec/semantic-cli.md#structural-expression-bodies) explains framing, review and compatibility.\n\n## Evolve an existing input\n\nUse `set.parameter-type parameter=OWNER type=TYPE` to preserve an existing parameter's identity, parent, name, position, use mode and requirement binding. `set.function-contract` changes a function's result and effect. Both validate the complete final candidate; repair affected calls, bodies and ports explicitly in that same request. Foreign package owners remain immutable.\n\nFor a command that currently accepts one F64 sample, bind `$module`, `$function`, `$input` and `$port` with `reference.owner` in the current project, and prepend `request base=REVISION` with its actual status revision. This changes the sample to an enabled reading and repairs the body and port together:\n\n```text\ncreate.record as=$Reading module=$module name=Reading visibility=public\nadd.field as=$value record=$Reading name=value type=f64\nadd.field as=$enabled record=$Reading name=enabled type=bool\ntype.named as=@Reading declaration=$Reading\nset.parameter-type parameter=$input type=@Reading\nexpression.block as=$body\n  (if (field (local $input) $enabled)\n    (field (local $input) $value)\n    (f64 0.0))\nexpression.end\nreplace.body function=$function body=$body\ntype.function as=@Input result=f64\ntype.argument parent=@Input index=0 type=@Reading\nset.port-contract port=$port type=@Input\n```\n\nReview the complete input with `change plan --input-file PATH`, then submit the identical input with `change apply --input-file PATH --plan TOKEN`. Inspection shows the retained parameter with its new type. Omitted repairs, stale reviews and changed inputs reject before publication. Identity continuity does not imply caller or wire compatibility; retain older exact packages and matching bundles/descriptors for recovery. See the [input evolution contract](../spec/semantic-cli.md#evolving-callable-inputs).\n\n")
        (call registry-body (call markup::join (local sections)))))))
    (function create function-definition (visibility public)
      (parameter create build (type guides::Build))
      (parameter create records (type Text))
      (returns Text) (effect pure)
      (body (call markup::join (list Text (call guides::header (local build))
        (text "# Revision-pinned function definition projection\n\n")
        (call registry-body (local records))))))
    (function create deployment (visibility public)
      (parameter create build (type guides::Build))
      (parameter create records (type Text))
      (returns Text) (effect pure)
      (body (call markup::join (list Text (call guides::header (local build))
        (text "# Deployment descriptor schema\n\n") (call registry-body (local records))))))
    (function create builtin-standard (visibility public)
      (parameter create build (type guides::Build))
      (parameter create standard (type Standard))
      (returns Text) (effect pure)
      (body (call markup::join (list Text (call guides::header (local build))
        (text "# Built-in standard package public interface\n\nPackage <code>")
        (call std::html-escape-text (field (local standard) Standard::package))
        (text "</code> at exact package revision <code>")
        (call std::html-escape-text (field (local standard) Standard::revision))
        (text "</code>.\n\n") (text "The records below are implementation-free public interface projections. Exact `reference` values are accepted by compact change records.\n\n## Typed cells and transaction ownership\n\nDiscover the two ordinary generic tasks with `lkjscript package builtin query owners --name data-cell-update-in-transaction` and `lkjscript package builtin query owners --name data-cell-try-update`, then inspect their exact exported owners. Both accept space, fallback, task transform and key, in that order, with explicit T/E/R applications.\n\n| Function | Required DataStore operations | Result |\n|---|---|---|\n| `data-cell-update-in-transaction` | `get`, `put`, `require-transaction` | Tentative T inside the caller's matching transaction |\n| `data-cell-try-update` | The participant operations plus `transaction` | Completed `TransactionOutcome<T>` |\n\nThe participant first calls `require-transaction() -> Unit`, an idempotent task operation with no external visibility. An absent or unrelated canonical transaction fails before the helper reads data or invokes its callback. It then reads staged data, uses the explicit fallback for missing or incompatible typed encoding, calls the transform once and conditionally writes against the observed entry revision. A failed condition suppresses the owner's entire publication even if helpers return values afterward. Only the standalone wrapper owns `transaction-outcome`; invoking it inside the same canonical transaction still rejects.\n\nUnit is no transaction token, and retained descriptors are checked when invoked. Ordinary argument effects can precede entry; independent callback effects can survive a parent abort. There is no automatic retry. Fallback is caller policy, not schema migration or recovery from operational failure. The functions do not constrain T to capture-safe; binding and encoding enforce their own existing rules. See the [data capability specification](../spec/data-capabilities.md#explicit-participation-and-typed-cells).\n\n")
        (call markup::code-block (field (local standard) Standard::records))))))
    (function create stateful-references (visibility private)
      (parameter create owners (type (list Owner)))
      (returns (list Selection)) (effect pure)
      (body (let
        (binding stream (call find-owner (local owners) (text "interface") (text "ByteStream") (text "")))
        (binding data (call find-owner (local owners) (text "interface") (text "DataStore") (text "")))
        (in (list Selection
          (call select-owner (local owners) (text "interface") (text "ByteStream") (text "") (text "byte-stream"))
          (call select-owner (local owners) (text "operation") (text "read-all") (field (local stream) Found::reference) (text "read-all"))
          (call select-owner (local owners) (text "interface") (text "DataStore") (text "") (text "data"))
          (call select-owner (local owners) (text "operation") (text "schema-read") (field (local data) Found::reference) (text "schema-read"))
          (call select-owner (local owners) (text "operation") (text "transaction") (field (local data) Found::reference) (text "transaction"))
          (call select-owner (local owners) (text "operation") (text "schema-set") (field (local data) Found::reference) (text "schema-set"))
          (call select-owner (local owners) (text "operation") (text "get") (field (local data) Found::reference) (text "get"))
          (call select-owner (local owners) (text "operation") (text "scan") (field (local data) Found::reference) (text "scan"))
          (call select-owner (local owners) (text "operation") (text "put") (field (local data) Found::reference) (text "put"))
          (call select-owner (local owners) (text "operation") (text "delete") (field (local data) Found::reference) (text "delete"))
          (call select-owner (local owners) (text "external") (text "json-decode-or") (text "") (text "json-decode-or"))
          (call select-owner (local owners) (text "external") (text "json-encode") (text "") (text "json-encode"))
          (call select-owner (local owners) (text "external") (text "list-length") (text "") (text "list-length"))
          (call select-owner (local owners) (text "external") (text "list-get") (text "") (text "list-get"))
          (call select-owner (local owners) (text "variant") (text "DataKeyPart") (text "") (text "data-key-part"))
          (call select-owner (local owners) (text "record") (text "DataEntry") (text "") (text "data-entry"))
          (call select-owner (local owners) (text "external") (text "data-encode") (text "") (text "data-encode"))
          (call select-owner (local owners) (text "external") (text "data-decode-or") (text "") (text "data-decode-or")))))))
    (function create stateful-http (visibility public)
      (parameter create build (type guides::Build))
      (parameter create owners (type (list Owner)))
      (returns Document) (effect pure)
      (body (let (binding references (call stateful-references (local owners)))
        (in (call checked-document
          (call markup::join (list Text (call guides::header (local build))
            (text "# Stateful HTTP authoring walkthrough\n\nThis is a generated composition guide, not a second authoring authority. Start from `new --template minimal`, discover the exact built-in binding and owner references, export and stage that immutable transport, and submit dependency, component, requirements, function-backed HTTP port, target, and application policy in one bounded compact request. Secret values never enter semantic records or this guide.\n\n## Current exact capability and declaration references\n\n") (call reference-table (local references))
            (text "\n## Composition\n\n")
            (call markup::code-block (text "walkthrough.bootstrap template=minimal owners=0 dependencies=0\nwalkthrough.dependency operation=add.dependency binding=package+semantic-revision+package-revision transport=builtin-export+dependency-stage\nwalkthrough.topology operations=create.component+add.requirement+add.port+create.target+add.http-route port=function-backed route=GET+/ runner=http\nwalkthrough.request parameter=$request projection=\"method,path,query_parameters,headers,body\"\nwalkthrough.body form=field+capability-call stream-operation=read-all maximum=65536 unit=bytes\nwalkthrough.json form=call+type.argument+field decoder=json-decode-or strict=\"duplicate,trailing,shape reject\" encoder=json-encode\nwalkthrough.data form=transaction+capability-call operations=\"schema-read,schema-set,get,scan,put,delete\" keys=static-space+typed-key-parts values=canonical-typed-data-bytes\nwalkthrough.response form=structural-record fields=\"status:i64,headers:list<{name:text,value:bytes}>,body:bytes\" policy=graph-owned\nwalkthrough.grant requirement=data adapter=data root=deployment-relative-local-directory secret-value=none limits=\"keys,values,transactions,scans,live-resources\"\n"))
            (text "\n\nThe transport stage must leave semantic `HEAD` unchanged. Use reviewed `change plan`, export and decode the complete logical plan, then apply the exact plan token and idempotently re-prepare it. Run `check`, clean/incremental `build`, and `serve --deployment` only after publication. Runtime work reads the artifact and cannot advance project authority.\n")))
          (local references))))))
    (function create limit-row (visibility private)
      (parameter create item (type Limit))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell (call guides::code (field (local item) Limit::name))
        (call guides::prose (call std::i64-to-text (field (local item) Limit::maximum))))))
    (function create relay-references (visibility private)
      (parameter create owners (type (list Owner)))
      (returns (list Selection)) (effect pure)
      (body (let
        (binding client (call find-owner (local owners) (text "interface") (text "HttpClient") (text "")))
        (in (list Selection
          (call select-owner (local owners) (text "interface") (text "HttpClient") (text "") (text "HttpClient"))
          (call select-owner (local owners) (text "operation") (text "get")
            (field (local client) Found::reference) (text "get")))))))
    (function create relay-information (visibility public)
      (parameter create build (type guides::Build))
      (parameter create template (type guides::Template))
      (parameter create owners (type (list Owner)))
      (parameter create limits (type (list Limit)))
      (returns Document) (effect pure)
      (body (let (binding references (call relay-references (local owners)))
        (in (call checked-document
          (call markup::join (list Text (call guides::header (local build))
            (text "# Nostr relay-information authoring walkthrough\n\nThis generated composition guide describes the closed NIP-11 information slice. The typed graph selects only request headers and response policy; one strict deployment grant owns the immutable endpoint, address class, TLS trust, and transport limits. It is not a second authoring authority and does not implement WebSocket or NIP-01.\n\n## Exact recipe and capability\n\n")
            (call markup::table
              (list Text (text "Template") (text "Purpose") (text "Runner")
                (text "Starter deployment") (text "Recommended artifact output"))
              (list (list markup::Cell) (call guides::template-row (local template))))
            (text "\n") (call markup::code-block
              (text "new DEST --template nostr-relay-info [--name NAME] --relay-url URL\n"))
            (text "\n") (call reference-table (local references))
            (text "\n") (call markup::code-block
              (text "argument: ordered-list<{name:text,value:bytes}>\nresult: {status:i64,headers:list<{name:text,value:bytes}>,body:bytes}\n"))
            (text "\n## Closed behavior\n\n") (call markup::code-block (text "relay-info.normalization secure=\"wss->https,https->https\" development=\"ws->http,http->http\" plaintext=loopback-only reject=\"userinfo,query,fragment,noncanonical-authority\"\nrelay-info.request inbound=\"GET /relay-info\" outbound=\"GET exact-deployment-endpoint\" accept=application/nostr+json body=none\nrelay-info.response success=\"status=200+base-media-type=application/nostr+json\" body=bounded-byte-exact failure=\"local-status=502 body=bad-gateway\" remote-detail=redacted\nrelay-info.transport protocol=http/1.1 redirects=never retries=never decompression=never proxy=none credentials=none\n"))
            (text "\n## Default transport limits\n\n")
            (call markup::table (list Text (text "Limit") (text "Maximum"))
              (call std::list-map (types Limit (list markup::Cell)) (local limits) (function-value limit-row)))
            (text "\n## Lifecycle\n\n") (call markup::code-block (text "relay-info.lifecycle inspect=status+query+inspect verify=check derive=\"build --output generated/application.lkja\" execute=\"serve --deployment service.deployment.json\"\n"))
            (text "\n\nRead `deployment.md` for the executable-owned strict adapter schema and global maxima. Read the normative outbound-client specification for DNS/address classification, TLS trust, cancellation, cleanup, and security nonclaims.\n"))) (local references))))))
    (test create missing-owner (visibility private)
      (actual (call find-owner (list Owner) (text "interface") (text "Absent") (text "")))
      (expected (record Found (field Found::count (i64 0)) (field Found::reference (text "")))))
    (test create unique-owner (visibility private)
      (actual (call find-owner
        (list Owner (record Owner (field Owner::kind (text "operation")) (field Owner::name (text "get"))
          (field Owner::parent (text "client")) (field Owner::reference (text "selected"))))
        (text "operation") (text "get") (text "client")))
      (expected (record Found (field Found::count (i64 1)) (field Found::reference (text "selected")))))
    (test create wrong-parent (visibility private)
      (actual (call find-owner
        (list Owner (record Owner (field Owner::kind (text "operation")) (field Owner::name (text "get"))
          (field Owner::parent (text "data")) (field Owner::reference (text "not-client"))))
        (text "operation") (text "get") (text "client")))
      (expected (record Found (field Found::count (i64 0)) (field Found::reference (text "")))))
    (test create duplicate-owner-rejects (visibility private)
      (actual (call selection-valid (call select-owner
        (list Owner
          (record Owner (field Owner::kind (text "interface")) (field Owner::name (text "HttpClient"))
            (field Owner::parent (text "")) (field Owner::reference (text "first")))
          (record Owner (field Owner::kind (text "interface")) (field Owner::name (text "HttpClient"))
            (field Owner::parent (text "")) (field Owner::reference (text "second"))))
        (text "interface") (text "HttpClient") (text "") (text "HttpClient"))))
      (expected (bool false)))
    (test create empty-reference-rejects (visibility private)
      (actual (call selection-valid (record Selection
        (field Selection::kind (text "interface")) (field Selection::label (text "empty"))
        (field Selection::found (record Found (field Found::count (i64 1)) (field Found::reference (text "")))))))
      (expected (bool false)))
    (test create reference-escape (visibility private)
      (actual (call registry-body (text "```<script>&\n")))
      (expected (text "The following compact records are the executable-owned current public capability.\n\n<pre>```&lt;script&gt;&amp;\n</pre>\n")))
    (test create empty-registry (visibility private)
      (actual (call registry-body (text "")))
      (expected (text "The following compact records are the executable-owned current public capability.\n\n<pre></pre>\n")))
    (test create limit-text (visibility private)
      (actual (call limit-row (record Limit (field Limit::name (text "test")) (field Limit::maximum (i64 8192)))))
      (expected (list markup::Cell
        (record markup::Cell (field markup::Cell::value (text "test")) (field markup::Cell::code (bool true)))
        (record markup::Cell (field markup::Cell::value (text "8192")) (field markup::Cell::code (bool false))))))
    (component create references-console (visibility private)
      (port create change-grammar (type (function (guides::Build (list Text)) Text)) (function change-grammar))
      (port create function-definition (type (function (guides::Build Text) Text)) (function function-definition))
      (port create deployment (type (function (guides::Build Text) Text)) (function deployment))
      (port create builtin-standard (type (function (guides::Build Standard) Text)) (function builtin-standard))
      (port create stateful-http (type (function (guides::Build (list Owner)) Document)) (function stateful-http))
      (port create relay-information (type (function (guides::Build guides::Template (list Owner) (list Limit)) Document))
        (function relay-information))))
  (target create change-grammar (component guides::references-console) (runner command)
    (port guides::references-console::change-grammar))
  (target create function-definition (component guides::references-console) (runner command)
    (port guides::references-console::function-definition))
  (target create deployment (component guides::references-console) (runner command)
    (port guides::references-console::deployment))
  (target create builtin-standard (component guides::references-console) (runner command)
    (port guides::references-console::builtin-standard))
  (target create stateful-http (component guides::references-console) (runner command)
    (port guides::references-console::stateful-http))
  (target create relay-information (component guides::references-console) (runner command)
    (port guides::references-console::relay-information)))
declarations.end

request base=BASE
add.dependency package=pkg_10000000000000000000000000000001 semantic-revision=rev_0c24feeba2cf086edecde1241930f4a8019f0c1c7f5a6dfe72b187f02662a5bb package-revision=package_revision_9694ca1acf820bd3e05276d9822dbc4cc7e48ec8138685f5efa97f291a5dd049
declarations.begin
(units
  (use std builtin)
  (module create markup
    (record create Cell (visibility public)
      (field create value (type Text))
      (field create code (type Bool)))
    (function create join-range (visibility private)
      (parameter create chunks (type (list Text)))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (returns Text) (effect pure)
      (body
        (if (call std::i64-equal (local count) (i64 0)) (text "")
          (if (call std::i64-equal (local count) (i64 1))
            (call std::list-get (types Text) (local chunks) (local start))
            (let
              (binding half (call std::divide (local count) (i64 2)))
              (in
                (call std::text-concat
                  (call join-range (local chunks) (local start) (local half))
                  (call join-range (local chunks) (call std::add (local start) (local half))
                    (call std::subtract (local count) (local half))))))))))
    (function create join (visibility public)
      (parameter create chunks (type (list Text)))
      (returns Text) (effect pure)
      (body (call join-range (local chunks) (i64 0)
        (call std::list-length (types Text) (local chunks)))))
    (function create cell (visibility private)
      (parameter create item (type Cell))
      (returns Text) (effect pure)
      (body (call join (list Text
        (if (field (local item) Cell::code) (text "<td><code>") (text "<td>"))
        (call std::html-escape-text (field (local item) Cell::value))
        (if (field (local item) Cell::code) (text "</code></td>") (text "</td>"))))))
    (function create heading (visibility private)
      (parameter create value (type Text))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<th>")
        (call std::html-escape-text (local value)) (text "</th>")))))
    (function create row (visibility private)
      (parameter create cells (type (list Cell)))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<tr>")
        (call join (call std::list-map (types Cell Text) (local cells) (function-value cell)))
        (text "</tr>\n")))))
    (function create table (visibility public)
      (parameter create headings (type (list Text)))
      (parameter create rows (type (list (list Cell))))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<table>\n<thead>\n<tr>")
        (call join (call std::list-map (types Text Text) (local headings) (function-value heading)))
        (text "</tr>\n</thead>\n<tbody>\n")
        (call join (call std::list-map (types (list Cell) Text) (local rows) (function-value row)))
        (text "</tbody>\n</table>\n")))))
    (function create code-block (visibility public)
      (parameter create value (type Text))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<pre>")
        (call std::html-escape-text (local value)) (text "</pre>\n")))))
    (test create empty-join (visibility private)
      (actual (call join (list Text))) (expected (text "")))
    (test create singleton-join (visibility private)
      (actual (call join (list Text (text "hello")))) (expected (text "hello")))
    (test create ordered-join (visibility private)
      (actual (call join (list Text (text "a") (text "") (text "b") (text "c") (text "d"))))
      (expected (text "abcd")))
    (test create unicode-join (visibility private)
      (actual (call join (list Text (text "日本") (text "語") (text "🌱"))))
      (expected (text "日本語🌱")))
    (test create code-block-escape (visibility private)
      (actual (call code-block (text "<script>&`|\n")))
      (expected (text "<pre>&lt;script&gt;&amp;`|\n</pre>\n")))
    (test create cell-escape (visibility private)
      (actual (call cell (record Cell
        (field Cell::value (text "<>&\"'`|")) (field Cell::code (bool true)))))
      (expected (text "<td><code>&lt;&gt;&amp;&quot;&#39;`|</code></td>")))
    (test create text-cell (visibility private)
      (actual (call cell (record Cell
        (field Cell::value (text "plain")) (field Cell::code (bool false)))))
      (expected (text "<td>plain</td>")))
    (test create empty-table (visibility private)
      (actual (call table (list Text (text "Name")) (list (list Cell))))
      (expected (text "<table>\n<thead>\n<tr><th>Name</th></tr>\n</thead>\n<tbody>\n</tbody>\n</table>\n"))))
  (module create guides
    (record create Build (visibility public)
      (field create product (type Text))
      (field create version (type Text))
      (field create capabilities (type Text)))
    (record create Operation (visibility public)
      (field create name (type Text))
      (field create request (type Text))
      (field create response (type Text))
      (field create authority (type Text))
      (field create usage (type Text)))
    (record create Template (visibility public)
      (field create name (type Text))
      (field create purpose (type Text))
      (field create runner (type Text))
      (field create deployment (type Bool))
      (field create artifact (type Text)))
    (record create Diagnostic (visibility public)
      (field create code (type Text))
      (field create class (type Text))
      (field create meaning (type Text))
      (field create retry (type Text)))
    (record create Exit (visibility public)
      (field create status (type I64))
      (field create meaning (type Text)))
    (function create header (visibility private)
      (parameter create build (type Build))
      (returns Text) (effect pure)
      (body (call markup::join (list Text
        (text "<!-- Generated by `lkjscript capabilities --generate-docs docs/generated`. Do not edit. ")
        (call std::html-escape-text (field (local build) Build::product)) (text " ")
        (call std::html-escape-text (field (local build) Build::version)) (text " capabilities `")
        (call std::html-escape-text (field (local build) Build::capabilities)) (text "`. -->\n\n")))))
    (function create code (visibility private)
      (parameter create value (type Text))
      (returns markup::Cell) (effect pure)
      (body (record markup::Cell (field markup::Cell::value (local value))
        (field markup::Cell::code (bool true)))))
    (function create prose (visibility private)
      (parameter create value (type Text))
      (returns markup::Cell) (effect pure)
      (body (record markup::Cell (field markup::Cell::value (local value))
        (field markup::Cell::code (bool false)))))
    (function create operation-row (visibility private)
      (parameter create item (type Operation))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell
        (call code (field (local item) Operation::name))
        (call code (field (local item) Operation::request))
        (call code (field (local item) Operation::response))
        (call code (field (local item) Operation::authority))
        (call code (field (local item) Operation::usage)))))
    (function create template-row (visibility private)
      (parameter create item (type Template))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell
        (call code (field (local item) Template::name))
        (call prose (field (local item) Template::purpose))
        (call code (field (local item) Template::runner))
        (call code (if (field (local item) Template::deployment) (text "true") (text "false")))
        (call code (field (local item) Template::artifact)))))
    (function create diagnostic-row (visibility private)
      (parameter create item (type Diagnostic))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell
        (call code (field (local item) Diagnostic::code))
        (call code (field (local item) Diagnostic::class))
        (call prose (field (local item) Diagnostic::meaning))
        (call prose (field (local item) Diagnostic::retry)))))
    (function create exit-row (visibility private)
      (parameter create item (type Exit))
      (returns (list markup::Cell)) (effect pure)
      (body (list markup::Cell
        (call prose (call std::i64-to-text (field (local item) Exit::status)))
        (call prose (field (local item) Exit::meaning)))))
    (function create operations (visibility public)
      (parameter create build (type Build))
      (parameter create operations (type (list Operation)))
      (parameter create templates (type (list Template)))
      (parameter create runners (type Text))
      (returns Text) (effect pure)
      (body (call markup::join (list Text
        (call header (local build)) (text "# Public operations\n\n")
        (call markup::table
          (list Text (text "Operation") (text "Request model") (text "Response model")
            (text "Authority effect") (text "Usage"))
          (call std::list-map (types Operation (list markup::Cell))
            (local operations) (function-value operation-row)))
        (text "\n## Project templates\n\n")
        (call markup::table
          (list Text (text "Template") (text "Purpose") (text "Runner")
            (text "Starter deployment") (text "Recommended artifact output"))
          (call std::list-map (types Template (list markup::Cell))
            (local templates) (function-value template-row)))
        (text "\n## Execution observations\n\n") (call markup::code-block (local runners))))))
    (function create diagnostics (visibility public)
      (parameter create build (type Build))
      (parameter create diagnostics (type (list Diagnostic)))
      (parameter create exits (type (list Exit)))
      (returns Text) (effect pure)
      (body (call markup::join (list Text
        (call header (local build)) (text "# Protocol diagnostics and exit statuses\n\n")
        (call markup::table
          (list Text (text "Code") (text "Class") (text "Stable meaning") (text "Retry guidance"))
          (call std::list-map (types Diagnostic (list markup::Cell))
            (local diagnostics) (function-value diagnostic-row)))
        (text "\n")
        (call markup::table (list Text (text "Exit") (text "Meaning"))
          (call std::list-map (types Exit (list markup::Cell))
            (local exits) (function-value exit-row)))))))
    (component create console (visibility private)
      (port create operations (type (function (Build (list Operation) (list Template) Text) Text))
        (function operations))
      (port create diagnostics (type (function (Build (list Diagnostic) (list Exit)) Text))
        (function diagnostics))))
  (target create operations (component guides::console) (runner command) (port guides::console::operations))
  (target create diagnostics (component guides::console) (runner command) (port guides::console::diagnostics)))
declarations.end

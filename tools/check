#!/usr/bin/env python3
"""Run exact repository gates with bounded output and retained receipts."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import selectors
import shutil
import signal
import subprocess
import sys
import time
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
LOG_ROOT = ROOT / ".artifacts" / "check"
CHECK_CONTRACT_VERSION = 2
DEFAULT_TIMEOUT_SECONDS = 3_600.0
DEFAULT_MAXIMUM_LOG_BYTES = 64 * 1024 * 1024
MAXIMUM_RETAINED_RUNS = 8
MAXIMUM_FAILURE_EXCERPT_BYTES = 2_048


@dataclass(frozen=True)
class Gate:
    name: str
    command: tuple[str, ...]
    timeout_seconds: float = DEFAULT_TIMEOUT_SECONDS
    maximum_log_bytes: int = DEFAULT_MAXIMUM_LOG_BYTES


def cargo_gate(name: str, *arguments: str) -> Gate:
    return Gate(name, ("cargo", *arguments))


def binary() -> str:
    return str(ROOT / "target" / "release" / "lkjscript")



def relative(path: Path) -> str:
    return str(path.relative_to(ROOT))


def terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def excerpt(path: Path) -> str:
    data = path.read_bytes()
    if len(data) <= MAXIMUM_FAILURE_EXCERPT_BYTES:
        selected = data
    else:
        half = MAXIMUM_FAILURE_EXCERPT_BYTES // 2
        selected = data[:half] + b"\n... bounded excerpt ...\n" + data[-half:]
    return selected.decode("utf-8", errors="replace")


def run_gate(gate: Gate, directory: Path) -> dict[str, Any]:
    stdout_path = directory / f"{gate.name}.stdout.log"
    stderr_path = directory / f"{gate.name}.stderr.log"
    started = time.monotonic_ns()
    environment = os.environ.copy()
    environment["CARGO_NET_OFFLINE"] = "true"
    status = "failed"
    exit_code: int | None = None
    reason: str | None = None
    total_bytes = 0
    streams: dict[Any, tuple[Any, Any]] = {}
    try:
        process = subprocess.Popen(
            list(gate.command),
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except FileNotFoundError:
        stdout_path.write_bytes(b"")
        stderr_path.write_bytes(b"")
        return {
            "name": gate.name,
            "status": "unavailable",
            "command": list(gate.command),
            "exit_code": None,
            "elapsed_nanoseconds": time.monotonic_ns() - started,
            "stdout_bytes": 0,
            "stderr_bytes": 0,
            "stdout_log": relative(stdout_path),
            "stderr_log": relative(stderr_path),
            "fingerprint_sha256": hashlib.sha256(b"unavailable").hexdigest(),
            "reason": "command_not_found",
        }

    selector = selectors.DefaultSelector()
    with stdout_path.open("wb") as stdout_file, stderr_path.open("wb") as stderr_file:
        assert process.stdout is not None and process.stderr is not None
        selector.register(process.stdout, selectors.EVENT_READ)
        selector.register(process.stderr, selectors.EVENT_READ)
        streams[process.stdout] = (stdout_file, stdout_path)
        streams[process.stderr] = (stderr_file, stderr_path)
        deadline = time.monotonic() + gate.timeout_seconds
        try:
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0 and process.poll() is None:
                    status = "exhausted"
                    reason = "timeout"
                    terminate(process)
                events = selector.select(max(0.0, min(0.25, remaining)))
                for key, _ in events:
                    chunk = os.read(key.fileobj.fileno(), 65_536)
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    writable = min(len(chunk), max(0, gate.maximum_log_bytes - total_bytes))
                    if writable:
                        streams[key.fileobj][0].write(chunk[:writable])
                        total_bytes += writable
                    if writable != len(chunk) and reason is None:
                        status = "exhausted"
                        reason = "log_limit"
                        terminate(process)
                if process.poll() is not None and not events:
                    for file_object in list(selector.get_map().values()):
                        chunk = os.read(file_object.fileobj.fileno(), 65_536)
                        if chunk:
                            output = streams[file_object.fileobj][0]
                            writable = min(
                                len(chunk), max(0, gate.maximum_log_bytes - total_bytes)
                            )
                            if writable:
                                output.write(chunk[:writable])
                                total_bytes += writable
                            if writable != len(chunk) and reason is None:
                                status = "exhausted"
                                reason = "log_limit"
                        else:
                            selector.unregister(file_object.fileobj)
        except KeyboardInterrupt:
            terminate(process)
            process.wait(timeout=5)
            raise
        finally:
            selector.close()
        exit_code = process.wait(timeout=5)
    if reason is None:
        status = "passed" if exit_code == 0 else "failed"
        reason = None if exit_code == 0 else "nonzero_exit"
    stdout_bytes = stdout_path.stat().st_size
    stderr_bytes = stderr_path.stat().st_size
    fingerprint = hashlib.sha256()
    fingerprint.update(stdout_path.read_bytes())
    fingerprint.update(b"\0")
    fingerprint.update(stderr_path.read_bytes())
    result: dict[str, Any] = {
        "name": gate.name,
        "status": status,
        "command": list(gate.command),
        "exit_code": exit_code,
        "elapsed_nanoseconds": time.monotonic_ns() - started,
        "stdout_bytes": stdout_bytes,
        "stderr_bytes": stderr_bytes,
        "stdout_log": relative(stdout_path),
        "stderr_log": relative(stderr_path),
        "fingerprint_sha256": fingerprint.hexdigest(),
    }
    if reason is not None:
        result["reason"] = reason
    if status != "passed":
        result["stdout_excerpt"] = excerpt(stdout_path)
        result["stderr_excerpt"] = excerpt(stderr_path)
    return result


def checked_output(command: list[str]) -> str:
    result = subprocess.run(
        command,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else "unavailable"


def worktree_identity() -> str:
    digest = hashlib.sha256()
    status = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout
    digest.update(status)
    listing = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout
    for raw_path in sorted(item for item in listing.split(b"\0") if item):
        path = ROOT / os.fsdecode(raw_path)
        digest.update(len(raw_path).to_bytes(8, "big"))
        digest.update(raw_path)
        if path.is_symlink():
            digest.update(b"link\0")
            digest.update(os.fsencode(os.readlink(path)))
        elif path.is_file():
            digest.update(b"file\0")
            with path.open("rb") as source:
                while chunk := source.read(1024 * 1024):
                    digest.update(chunk)
        else:
            digest.update(b"absent\0")
    return digest.hexdigest()


def changed_paths() -> list[str]:
    output = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout
    records = [record for record in output.split(b"\0") if record]
    paths: list[str] = []
    index = 0
    while index < len(records):
        record = records[index]
        if len(record) < 4:
            raise RuntimeError("git emitted malformed porcelain status")
        status = record[:2]
        paths.append(os.fsdecode(record[3:]))
        if b"R" in status or b"C" in status:
            index += 1
            if index >= len(records):
                raise RuntimeError("git omitted the second rename path")
            paths.append(os.fsdecode(records[index]))
        index += 1
    return sorted(set(paths))


def select_changed() -> tuple[tuple[str, ...], dict[str, Any]]:
    paths = changed_paths()
    selected: set[str] = {"diff_check"}
    reasons: list[str] = []
    widen_full = False
    for path in paths:
        if path == "Cargo.toml" or path == "Cargo.lock" or path.startswith(("src/", "tests/")):
            widen_full = True
            reasons.append(f"runtime_or_test:{path}")
        elif path.startswith(("applications/", "packages/")):
            selected.update(PROFILES["product"])
            selected.add("service_acceptance")
            reasons.append(f"maintained_package:{path}")
        elif path == "tools/check":
            selected.add("checker_self_test")
            reasons.append("verification_contract:tools/check")
        elif path == "tools/service-acceptance":
            selected.update(PROFILES["service"])
            reasons.append("service_acceptance:tools/service-acceptance")
        elif path.startswith(("docs/", "prompts/")) or path in {"README.md", "AGENTS.md"}:
            reasons.append(f"documentation:{path}")
        else:
            widen_full = True
            reasons.append(f"uncertain:{path}")
    if widen_full:
        names = PROFILES["full"]
    else:
        ordered = list(PROFILES["full"])
        names = tuple(name for name in ordered if name in selected)
    return names, {"paths": paths, "reasons": reasons, "widened_to_full": widen_full}


def managed_run(path: Path, prefix: str) -> bool:
    name = path.name
    if prefix:
        if not name.startswith(prefix):
            return False
        name = name[len(prefix) :]
    elif name.startswith("self-test-"):
        return False
    stamp, separator, process_id = name.rpartition("-")
    return bool(
        separator
        and process_id.isdigit()
        and len(stamp) == 23
        and stamp[:8].isdigit()
        and stamp[8] == "T"
        and stamp[9:15].isdigit()
        and stamp[15] == "."
        and stamp[16:22].isdigit()
        and stamp[22] == "Z"
    )


def rotate_runs(current: Path, prefix: str) -> None:
    candidates = sorted(
        (
            path
            for path in LOG_ROOT.iterdir()
            if path.is_dir()
            and path.resolve() != current.resolve()
            and managed_run(path, prefix)
        ),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    for path in candidates[MAXIMUM_RETAINED_RUNS - 1 :]:
        if path.parent.resolve() != LOG_ROOT.resolve():
            raise RuntimeError("refusing to remove an unexpected receipt path")
        shutil.rmtree(path)


def new_run_directory(prefix: str = "") -> Path:
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    directory = LOG_ROOT / f"{prefix}{stamp}-{os.getpid()}"
    directory.mkdir(parents=True)
    rotate_runs(directory, prefix)
    return directory


def self_test(machine: bool) -> int:
    directory = new_run_directory("self-test-")
    fixtures = (
        Gate(
            "pass",
            (
                sys.executable,
                "-c",
                "import os; os.write(1,b'out'); os.write(2,b'err')",
            ),
        ),
        Gate("failure", (sys.executable, "-c", "raise SystemExit(7)")),
        Gate("unavailable", ("lkjscript-intentionally-absent-command",)),
        Gate(
            "timeout",
            (sys.executable, "-c", "import time; time.sleep(5)"),
            timeout_seconds=0.05,
        ),
        Gate(
            "overflow",
            (sys.executable, "-c", "import os; os.write(1,b'x'*4096)"),
            maximum_log_bytes=1_024,
        ),
    )
    expected = ("passed", "failed", "unavailable", "exhausted", "exhausted")
    results = [run_gate(gate, directory) for gate in fixtures]
    actual = tuple(result["status"] for result in results)
    retention_actual = (
        managed_run(Path("20260821T000000.000000Z-123"), ""),
        managed_run(Path("20260821T000000.000000Z-123-full"), ""),
        managed_run(Path("NOT-TZ-123"), ""),
        managed_run(Path("self-test-20260821T000000.000000Z-123"), ""),
        managed_run(Path("self-test-20260821T000000.000000Z-123"), "self-test-"),
    )
    retention_expected = (True, False, False, False, True)
    passed = actual == expected and retention_actual == retention_expected
    receipt = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "kind": "checker_self_test",
        "status": "passed" if passed else "failed",
        "expected": expected,
        "actual": actual,
        "retention_expected": retention_expected,
        "retention_actual": retention_actual,
        "gates": results,
    }
    receipt_path = directory / "receipt.json"
    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
    summary = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": receipt["status"],
        "receipt": relative(receipt_path),
    }
    if machine:
        print(json.dumps(summary, separators=(",", ":"), sort_keys=True))
    else:
        print(f"check self-test {receipt['status']}; receipt={relative(receipt_path)}")
    return 0 if passed else 1


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("profile", nargs="?", choices=(*PROFILES.keys(), "changed"))
    parser.add_argument("--machine", action="store_true")
    parser.add_argument("--details", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    arguments = parser.parse_args()
    if arguments.machine and arguments.details:
        parser.error("--machine and --details are incompatible")
    if arguments.self_test and arguments.profile is not None:
        parser.error("--self-test does not accept a profile")
    if not arguments.self_test and arguments.profile is None:
        parser.error("a profile is required")
    return arguments


def main() -> int:
    arguments = parse_arguments()
    if arguments.self_test:
        return self_test(arguments.machine)
    profile = arguments.profile
    assert profile is not None
    run_directory = new_run_directory()
    gates = base_gates(run_directory)
    selection: dict[str, Any] | None = None
    if profile == "changed":
        names, selection = select_changed()
    else:
        names = PROFILES[profile]
    started = time.monotonic_ns()
    results: list[dict[str, Any]] = []
    unrun: list[str] = []
    for position, name in enumerate(names):
        result = run_gate(gates[name], run_directory)
        results.append(result)
        if result["status"] != "passed":
            unrun = list(names[position + 1 :])
            break
    status = "passed" if not unrun and all(item["status"] == "passed" for item in results) else "failed"
    receipt: dict[str, Any] = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": status,
        "profile": profile,
        "selected_gates": list(names),
        "completed_gates": len(results),
        "passed_gates": sum(item["status"] == "passed" for item in results),
        "unrun_gates": unrun,
        "elapsed_nanoseconds": time.monotonic_ns() - started,
        "git_head": checked_output(["git", "rev-parse", "HEAD"]),
        "worktree_input_sha256": worktree_identity(),
        "toolchain": {
            "rustc": checked_output(["rustc", "-Vv"]),
            "cargo": checked_output(["cargo", "-V"]),
            "python": sys.version.splitlines()[0],
        },
        "environment": {
            "os": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "cargo_net_offline": True,
            "rustflags": os.environ.get("RUSTFLAGS", ""),
        },
        "pass_reuse": "none",
        "log_limit_bytes_per_gate": DEFAULT_MAXIMUM_LOG_BYTES,
        "gates": results,
    }
    if selection is not None:
        receipt["selection"] = selection
    receipt_path = run_directory / "receipt.json"
    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
    summary = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": status,
        "profile": profile,
        "passed": receipt["passed_gates"],
        "selected": len(names),
        "elapsed_nanoseconds": receipt["elapsed_nanoseconds"],
        "receipt": relative(receipt_path),
    }
    if status != "passed":
        summary["failure"] = next(
            (item for item in results if item["status"] != "passed"), None
        )
        summary["unrun_gates"] = unrun
    if arguments.machine:
        print(json.dumps(summary, separators=(",", ":"), sort_keys=True))
    else:
        print(
            f"check {status}: profile={profile} passed={receipt['passed_gates']}/{len(names)} "
            f"elapsed={receipt['elapsed_nanoseconds'] / 1_000_000_000:.3f}s; "
            f"receipt={relative(receipt_path)}"
        )
        if status != "passed":
            failure = summary["failure"]
            assert isinstance(failure, dict)
            print(
                f"failure: gate={failure['name']} status={failure['status']} "
                f"reason={failure.get('reason', 'unknown')} fingerprint={failure['fingerprint_sha256']}"
            )
            if failure.get("stdout_excerpt"):
                print("stdout excerpt:\n" + str(failure["stdout_excerpt"]))
            if failure.get("stderr_excerpt"):
                print("stderr excerpt:\n" + str(failure["stderr_excerpt"]))
            if unrun:
                print("unrun: " + ", ".join(unrun))
        elif arguments.details:
            for result in results:
                print(
                    f"gate {result['name']}: {result['status']} "
                    f"elapsed={result['elapsed_nanoseconds'] / 1_000_000_000:.3f}s "
                    f"logs={result['stdout_log']},{result['stderr_log']}"
                )
    return 0 if status == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())

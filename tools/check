@dataclass(frozen=True)
class Gate:
    name: str
    command: tuple[str, ...]
    dependencies: tuple[str, ...] = ()
    timeout_seconds: float = DEFAULT_TIMEOUT_SECONDS
    maximum_log_bytes: int = DEFAULT_MAXIMUM_LOG_BYTES
    cacheable: bool = True
    identity_command: tuple[str, ...] | None = None
    required_outputs: tuple[str, ...] = ()


@dataclass(frozen=True)
class InputSnapshot:
    digest_sha256: str
    git_head: str
    cargo_lock_sha256: str
    file_count: int
    total_bytes: int
    entries: tuple[dict[str, Any], ...]


@dataclass(frozen=True)
class RuntimeIdentity:
    digest_sha256: str
    toolchain: dict[str, str]
    platform: dict[str, str]
    environment_sha256: str
    environment_names: tuple[str, ...]
    executable_identities: dict[str, dict[str, Any]]


@dataclass(frozen=True)
class CacheLookup:
    result: dict[str, Any] | None
    reason: str


def cargo_gate(name: str, *arguments: str, dependencies: tuple[str, ...] = ()) -> Gate:
    return Gate(name, ("cargo", *arguments), dependencies=dependencies)



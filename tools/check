        "parallel_a": "passed",
        "parallel_b": "passed",
        "shared": "passed",
        "child_one": "passed",
        "child_two": "passed",
        "dag_failure": "failed",
        "blocked": "skipped",
    }
    dag_passed = dag_statuses == dag_expected and shared_marker.read_bytes() == b"x"

    cache_root = directory / "cache-fixture"
    cache_gate = Gate(
        "cache_probe",
        (sys.executable, "-c", "import os; os.write(1,b'cache-proof')"),
    )
    runtime_a = synthetic_runtime
    runtime_b = RuntimeIdentity(
        digest_sha256=digest_value(
            {"environment": "changed-environment", "executable": sys.executable}
        ),
        toolchain=runtime_a.toolchain,
        platform=runtime_a.platform,
        environment_sha256="3" * 64,
        environment_names=runtime_a.environment_names,
        executable_identities=runtime_a.executable_identities,
    )
    fingerprint_a = gate_input_fingerprint(cache_gate, synthetic_snapshot, runtime_a, {})
    fingerprint_b = gate_input_fingerprint(cache_gate, synthetic_snapshot, runtime_b, {})
    initial_miss = load_cached_gate(cache_gate, fingerprint_a, directory, cache_root)
    cache_fresh = run_gate(
        cache_gate,
        directory,
        fingerprint_a,
        {"eligible": True, "lookup": "miss", "reason": "self_test"},
    )
    store_cached_gate(cache_gate, cache_fresh, cache_root)
    cache_hit = load_cached_gate(cache_gate, fingerprint_a, directory, cache_root)
    stale_lookup = load_cached_gate(cache_gate, fingerprint_b, directory, cache_root)
    record_path = cache_record_path(cache_root, cache_gate, fingerprint_a)
    atomic_write(record_path, b"{not-json\n")
    corrupt_lookup = load_cached_gate(cache_gate, fingerprint_a, directory, cache_root)
    cache_passed = (
        initial_miss.result is None
        and initial_miss.reason == "not_found"
        and cache_hit.result is not None
        and cache_hit.result["execution"] == "reused"
        and fingerprint_a != fingerprint_b
        and stale_lookup.result is None
        and stale_lookup.reason == "input_changed"
        and corrupt_lookup.result is None
        and corrupt_lookup.reason == "cache_corrupt"
    )

    graph_rejections: dict[str, bool] = {}
    try:
        validate_gate_graph({"cycle": Gate("cycle", ("true",), dependencies=("cycle",))})
        graph_rejections["cycle"] = False
    except RuntimeError:
        graph_rejections["cycle"] = True
    try:
        validate_gate_graph({"unknown": Gate("unknown", ("true",), dependencies=("absent",))})
        graph_rejections["unknown_dependency"] = False
    except RuntimeError:
        graph_rejections["unknown_dependency"] = True
    try:
        validate_gate_graph(
            {
                "duplicate_a": Gate("duplicate_a", ("true",)),
                "duplicate_b": Gate("duplicate_b", ("true",)),
            }
        )
        graph_rejections["duplicate_command"] = False
    except RuntimeError:
        graph_rejections["duplicate_command"] = True
    contract_directory = directory / "base-gate-contract"
    contract_directory.mkdir()
    contract_gates = base_gates(contract_directory)
    executable_race_dependencies = {
        "clippy": contract_gates["clippy"].dependencies,
        "workspace_tests": contract_gates["workspace_tests"].dependencies,
        "public_cli_tests": contract_gates["public_cli_tests"].dependencies,
        "release_build": contract_gates["release_build"].dependencies,
    }
    executable_race_dependencies_expected = {
        "clippy": ("fmt",),
        "workspace_tests": ("clippy", "release_build"),
        "public_cli_tests": ("library_tests", "general_service_tests"),
        "release_build": ("fmt",),
    }
    retention_actual = (
        managed_run(Path("20260821T000000.000000Z-123"), ""),
        managed_run(Path("20260821T000000.000000Z-123-full"), ""),
        managed_run(Path("NOT-TZ-123"), ""),
        managed_run(Path("self-test-20260821T000000.000000Z-123"), ""),
        managed_run(Path("self-test-20260821T000000.000000Z-123"), "self-test-"),
    )
    retention_expected = (True, False, False, False, True)
    passed = (
        actual == expected
        and retention_actual == retention_expected
        and dag_passed
        and cache_passed
        and all(graph_rejections.values())
        and executable_race_dependencies == executable_race_dependencies_expected
    )
    receipt = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "kind": "checker_self_test",
        "status": "passed" if passed else "failed",
        "expected": expected,
        "actual": actual,
        "retention_expected": retention_expected,
        "retention_actual": retention_actual,
        "dag_expected": dag_expected,
        "dag_actual": dag_statuses,
        "dag_shared_prerequisite_executions": len(shared_marker.read_bytes()),
        "cache": {
            "initial_miss": initial_miss.reason,
            "hit": cache_hit.reason,
            "stale_environment": stale_lookup.reason,
            "corrupt_record": corrupt_lookup.reason,
        },
        "graph_rejections": graph_rejections,
        "executable_race_dependencies_expected": executable_race_dependencies_expected,
        "executable_race_dependencies_actual": executable_race_dependencies,
        "gates": results,
        "dag_gates": dag_results,
    }
    receipt_path = directory / "receipt.json"
    atomic_write(
        receipt_path, json.dumps(receipt, indent=2, sort_keys=True).encode("utf-8") + b"\n"
    )
    summary = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": receipt["status"],
        "receipt": relative(receipt_path),
    }
    if machine:
        print(json.dumps(summary, separators=(",", ":"), sort_keys=True))
    else:
        print(f"check self-test {receipt['status']}; receipt={relative(receipt_path)}")
    return 0 if passed else 1


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("profile", nargs="?", choices=(*PROFILES.keys(), "changed"))
    parser.add_argument("--machine", action="store_true")
    parser.add_argument("--details", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--fresh", action="store_true", help="bypass reusable pass evidence")
    parser.add_argument(
        "--jobs",
        type=int,
        default=DEFAULT_MAXIMUM_WORKERS,
        metavar="N",
        help=f"run at most N independent gates concurrently (1-{MAXIMUM_WORKERS})",
    )
    arguments = parser.parse_args()
    if arguments.machine and arguments.details:
        parser.error("--machine and --details are incompatible")
    if arguments.self_test and arguments.profile is not None:
        parser.error("--self-test does not accept a profile")
    if not arguments.self_test and arguments.profile is None:
        parser.error("a profile is required")
    if not 1 <= arguments.jobs <= MAXIMUM_WORKERS:
        parser.error(f"--jobs must be between 1 and {MAXIMUM_WORKERS}")
    return arguments


def main() -> int:
    arguments = parse_arguments()
    if arguments.self_test:
        return self_test(arguments.machine)
    profile = arguments.profile
    assert profile is not None
    run_directory = new_run_directory()
    gates = base_gates(run_directory)
    selection: dict[str, Any] | None = None
    if profile == "changed":
        requested_names, selection = select_changed()
    else:
        requested_names = PROFILES[profile]
    names = dependency_closure(gates, requested_names)
    fresh_required = profile == "full" or arguments.fresh
    fresh_reason = "full_profile_requires_fresh" if profile == "full" else "explicit_fresh"
    started = time.monotonic_ns()
    initial_snapshot = capture_input_snapshot()
    input_manifest_path = run_directory / "inputs.json"
    atomic_write(
        input_manifest_path,
        json.dumps(
            {
                "contract_version": CHECK_CONTRACT_VERSION,
                "worktree_input_sha256": initial_snapshot.digest_sha256,
                "git_head": initial_snapshot.git_head,
                "cargo_lock_sha256": initial_snapshot.cargo_lock_sha256,
                "file_count": initial_snapshot.file_count,
                "total_bytes": initial_snapshot.total_bytes,
                "files": initial_snapshot.entries,
            },
            indent=2,
            sort_keys=True,
        ).encode("utf-8")
        + b"\n",
    )
    runtime = capture_runtime_identity(gates, names)
    dag_path = run_directory / "dag.json"
    atomic_write(
        dag_path,
        json.dumps(
            {
                "contract_version": CHECK_CONTRACT_VERSION,
                "requested": list(requested_names),
                "selected_closure": list(names),
                "maximum_workers": arguments.jobs,
                "nodes": [
                    {
                        "name": name,
                        "dependencies": list(gates[name].dependencies),
                        "command": list(gates[name].identity_command or gates[name].command),
                        "cacheable": gates[name].cacheable,
                    }
                    for name in names
                ],
            },
            indent=2,
            sort_keys=True,
        ).encode("utf-8")
        + b"\n",
    )
    results = execute_dag(
        gates,
        names,
        run_directory,
        initial_snapshot,
        runtime,
        maximum_workers=arguments.jobs,
        allow_reuse=not fresh_required,
        fresh_reason=fresh_reason,
    )
    final_snapshot = capture_input_snapshot()
    input_stable = final_snapshot.digest_sha256 == initial_snapshot.digest_sha256
    if input_stable:
        for result in results:
            gate = gates[result["name"]]
            try:
                cache_record = store_cached_gate(gate, result)
                if cache_record != "not_eligible":
                    result["cache"]["write"] = "stored"
                    result["cache"]["record"] = cache_record
            except (OSError, RuntimeError) as error:
                result["cache"]["write"] = "failed"
                result["cache"]["write_reason"] = type(error).__name__
    else:
        for result in results:
            if result["execution"] == "fresh" and result["status"] == "passed":
                result["cache"]["write"] = "withheld_input_changed"

    unrun = [item["name"] for item in results if item["status"] == "skipped"]
    fresh_count = sum(
        item["status"] == "passed" and item["execution"] == "fresh" for item in results
    )
    reused_count = sum(
        item["status"] == "passed" and item["execution"] == "reused" for item in results
    )
    all_gate_passed = all(item["status"] == "passed" for item in results)
    full_is_fresh = profile != "full" or reused_count == 0
    status = "passed" if all_gate_passed and input_stable and full_is_fresh else "failed"
    receipt: dict[str, Any] = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": status,
        "profile": profile,
        "requested_gates": list(requested_names),
        "selected_gates": list(names),
        "completed_gates": sum(item["status"] != "skipped" for item in results),
        "passed_gates": sum(item["status"] == "passed" for item in results),
        "fresh_passed_gates": fresh_count,
        "reused_passed_gates": reused_count,
        "unrun_gates": unrun,
        "elapsed_nanoseconds": time.monotonic_ns() - started,
        "git_head": initial_snapshot.git_head,
        "worktree_input_sha256": initial_snapshot.digest_sha256,
        "cargo_lock_sha256": initial_snapshot.cargo_lock_sha256,
        "input_manifest": relative(input_manifest_path),
        "input_stability": {
            "status": "stable" if input_stable else "changed_during_run",
            "before_sha256": initial_snapshot.digest_sha256,
            "after_sha256": final_snapshot.digest_sha256,
        },
        "toolchain": runtime.toolchain,
        "environment": {
            **runtime.platform,
            "cargo_net_offline": True,
            "relevant_input_sha256": runtime.environment_sha256,
            "relevant_names": list(runtime.environment_names),
        },
        "runtime_input_sha256": runtime.digest_sha256,
        "command_executables_at_start": runtime.executable_identities,
        "dag": {
            "manifest": relative(dag_path),
            "nodes": len(names),
            "requested_nodes": len(requested_names),
            "deduplicated_prerequisites": len(requested_names) + sum(
                len(gates[name].dependencies) for name in names
            )
            - len(names),
            "maximum_workers": arguments.jobs,
        },
        "pass_reuse": {
            "allowed": not fresh_required,
            "fresh_required": fresh_required,
            "reason": fresh_reason if fresh_required else "exact_input_match",
            "fresh": fresh_count,
            "reused": reused_count,
            "cache_maximum_bytes": MAXIMUM_CACHE_BYTES,
            "cache_maximum_entries_per_gate": MAXIMUM_CACHE_ENTRIES_PER_GATE,
        },
        "log_limit_bytes_per_gate": DEFAULT_MAXIMUM_LOG_BYTES,
        "gates": results,
    }
    if selection is not None:
        receipt["selection"] = selection
    receipt_path = run_directory / "receipt.json"
    atomic_write(
        receipt_path, json.dumps(receipt, indent=2, sort_keys=True).encode("utf-8") + b"\n"
    )
    summary = {
        "contract_version": CHECK_CONTRACT_VERSION,
        "status": status,
        "profile": profile,
        "passed": receipt["passed_gates"],
        "fresh": fresh_count,
        "reused": reused_count,
        "selected": len(names),
        "elapsed_nanoseconds": receipt["elapsed_nanoseconds"],
        "receipt": relative(receipt_path),
    }
    if status != "passed":
        failure = next(
            (item for item in results if item["status"] not in {"passed", "skipped"}), None
        )
        if failure is None and not input_stable:
            failure = {
                "name": "input_stability",
                "status": "failed",
                "reason": "worktree_changed_during_run",
                "fingerprint_sha256": final_snapshot.digest_sha256,
            }
        if failure is None and not full_is_fresh:
            failure = {
                "name": "fresh_policy",
                "status": "failed",
                "reason": "full_profile_reused_evidence",
                "fingerprint_sha256": runtime.digest_sha256,
            }
        summary["failure"] = failure
        summary["unrun_gates"] = unrun
    if arguments.machine:
        print(json.dumps(summary, separators=(",", ":"), sort_keys=True))
    else:
        print(
            f"check {status}: profile={profile} passed={receipt['passed_gates']}/{len(names)} "
            f"fresh={fresh_count} reused={reused_count} "
            f"elapsed={receipt['elapsed_nanoseconds'] / 1_000_000_000:.3f}s; "
            f"receipt={relative(receipt_path)}"
        )
        if status != "passed":
            failure = summary["failure"]
            assert isinstance(failure, dict)
            print(
                f"failure: gate={failure['name']} status={failure['status']} "
                f"reason={failure.get('reason', 'unknown')} "
                f"fingerprint={failure['fingerprint_sha256']}"
            )
            if failure.get("stdout_excerpt"):
                print("stdout excerpt:\n" + str(failure["stdout_excerpt"]))
            if failure.get("stderr_excerpt"):
                print("stderr excerpt:\n" + str(failure["stderr_excerpt"]))
            if unrun:
                print("unrun: " + ", ".join(unrun))
        elif arguments.details:
            for result in results:
                print(
                    f"gate {result['name']}: {result['status']} execution={result['execution']} "
                    f"elapsed={result['elapsed_nanoseconds'] / 1_000_000_000:.3f}s "
                    f"logs={result['stdout_log']},{result['stderr_log']}"
                )
    return 0 if status == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())

def relative(path: Path) -> str:
    return str(path.relative_to(ROOT))


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True).encode(
        "utf-8"
    )


def digest_value(value: Any) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def digest_file(path: Path) -> tuple[str, int]:
    digest = hashlib.sha256()
    size = 0
    with path.open("rb") as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
            size += len(chunk)
    return digest.hexdigest(), size


def path_label(path: Path) -> str:
    try:
        return relative(path)
    except ValueError:
        return str(path)


def output_proof(raw_path: str) -> dict[str, Any]:
    path = Path(raw_path)
    if not path.is_absolute():
        path = ROOT / path
    label = path_label(path)
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return {"path": label, "kind": "missing"}
    mode = stat.S_IMODE(metadata.st_mode)
    if path.is_symlink():
        target = os.fsencode(os.readlink(path))
        return {
            "path": label,
            "kind": "symlink",
            "mode": mode,
            "bytes": len(target),
            "sha256": hashlib.sha256(target).hexdigest(),
        }
    if path.is_file():
        digest, size = digest_file(path)
        return {
            "path": label,
            "kind": "file",
            "mode": mode,
            "bytes": size,
            "sha256": digest,
        }
    return {"path": label, "kind": "unsupported", "mode": mode}


def relevant_untracked_path(raw_path: bytes) -> bool:
    components = raw_path.split(b"/")
    return b"target" not in components and b".artifacts" not in components


def listed_paths(arguments: list[str]) -> list[bytes]:
    result = subprocess.run(
        ["git", "ls-files", *arguments, "-z"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            "git input enumeration failed: "
            + result.stderr.decode("utf-8", errors="replace").strip()
        )
    return [item for item in result.stdout.split(b"\0") if item]


def capture_input_snapshot() -> InputSnapshot:
    tracked = set(listed_paths(["--cached"]))
    untracked = {
        item
        for item in listed_paths(["--others", "--exclude-standard"])
        if relevant_untracked_path(item)
    }
    entries: list[dict[str, Any]] = []
    total_bytes = 0
    for raw_path in sorted(tracked | untracked):
        path = ROOT / os.fsdecode(raw_path)
        label = os.fsdecode(raw_path)
        source = "tracked" if raw_path in tracked else "untracked"
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            entries.append({"path": label, "source": source, "kind": "missing"})
            continue
        mode = stat.S_IMODE(metadata.st_mode)
        if path.is_symlink():
            target = os.fsencode(os.readlink(path))
            total_bytes += len(target)
            entries.append(
                {
                    "path": label,
                    "source": source,
                    "kind": "symlink",
                    "mode": mode,
                    "bytes": len(target),
                    "sha256": hashlib.sha256(target).hexdigest(),
                }
            )
        elif path.is_file():
            digest, size = digest_file(path)
            total_bytes += size
            entries.append(
                {
                    "path": label,
                    "source": source,
                    "kind": "file",
                    "mode": mode,
                    "bytes": size,
                    "sha256": digest,
                }
            )
        elif path.is_dir():
            # A tracked directory is a gitlink/submodule. Its checked-out commit is
            # an operational input even though its contents belong to another tree.
            head = checked_output(["git", "-C", str(path), "rev-parse", "HEAD"])
            entries.append(
                {
                    "path": label,
                    "source": source,
                    "kind": "gitlink",
                    "mode": mode,
                    "head": head,
                }
            )
        else:
            entries.append(
                {"path": label, "source": source, "kind": "unsupported", "mode": mode}
            )
    cargo_lock = next((entry for entry in entries if entry["path"] == "Cargo.lock"), None)
    cargo_lock_digest = (
        str(cargo_lock.get("sha256", "missing")) if cargo_lock is not None else "missing"
    )
    git_head = checked_output(["git", "rev-parse", "HEAD"])
    digest = digest_value({"git_head": git_head, "files": entries})
    return InputSnapshot(
        digest_sha256=digest,
        git_head=git_head,
        cargo_lock_sha256=cargo_lock_digest,
        file_count=len(entries),
        total_bytes=total_bytes,
        entries=tuple(entries),
    )


def environment_identity() -> tuple[str, tuple[str, ...]]:
    effective = os.environ.copy()
    effective["CARGO_NET_OFFLINE"] = "true"
    names = sorted(effective)
    hashed_values = []
    for name in names:
        # The aggregate binds values without retaining them individually. This
        # includes external service configuration and secret-bearing variables;
        # neither values nor per-value digests enter receipts or stdout.
        hashed_values.append(
            {"name": name, "value_sha256": hashlib.sha256(os.fsencode(effective[name])).hexdigest()}
        )
    return digest_value(hashed_values), tuple(names)


def executable_identity(command: str) -> dict[str, Any]:
    candidate: Path | None
    if os.sep in command:
        candidate = Path(command)
        if not candidate.is_absolute():
            candidate = ROOT / candidate
    else:
        resolved = shutil.which(command)
        candidate = Path(resolved) if resolved is not None else None
    if candidate is None:
        return {"command": command, "kind": "unavailable"}
    try:
        resolved_path = candidate.resolve(strict=True)
    except FileNotFoundError:
        return {"command": command, "kind": "unavailable", "path": str(candidate)}
    proof = output_proof(str(resolved_path))
    proof["command"] = command
    proof["resolved_path"] = str(resolved_path)
    return proof


def capture_runtime_identity(gates: dict[str, Gate], names: tuple[str, ...]) -> RuntimeIdentity:
    commands = sorted({gates[name].command[0] for name in names})
    executables = {command: executable_identity(command) for command in commands}
    environment_digest, environment_names = environment_identity()
    toolchain = {
        "rustc": checked_output(["rustc", "-Vv"]),
        "cargo": checked_output(["cargo", "-V"]),
        "python": sys.version.splitlines()[0],
    }
    platform_identity = {
        "os": platform.system(),
        "release": platform.release(),
        "machine": platform.machine(),
    }
    identity = {
        "toolchain": toolchain,
        "platform": platform_identity,
        "environment_sha256": environment_digest,
        "environment_names": list(environment_names),
    }
    return RuntimeIdentity(
        digest_sha256=digest_value(identity),
        toolchain=toolchain,
        platform=platform_identity,
        environment_sha256=environment_digest,
        environment_names=environment_names,
        executable_identities=executables,
    )


def validate_gate_graph(gates: dict[str, Gate]) -> None:
    command_owners: dict[tuple[Any, ...], str] = {}
    for name, gate in gates.items():
        if name != gate.name or GATE_NAME.fullmatch(name) is None:
            raise RuntimeError(f"invalid gate identity: {name!r}")
        for dependency in gate.dependencies:
            if dependency not in gates:
                raise RuntimeError(f"gate {name} has unknown dependency {dependency}")
        command_key = (
            gate.identity_command or gate.command,
            gate.timeout_seconds,
            gate.maximum_log_bytes,
            gate.required_outputs,
        )
        previous = command_owners.get(command_key)
        if previous is not None:
            raise RuntimeError(
                f"equivalent gates {previous} and {name} must be one shared DAG node"
            )
        command_owners[command_key] = name

    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(name: str) -> None:
        if name in visiting:
            raise RuntimeError(f"verification DAG contains a cycle at {name}")
        if name in visited:
            return
        visiting.add(name)
        for dependency in gates[name].dependencies:
            visit(dependency)
        visiting.remove(name)
        visited.add(name)

    for name in gates:
        visit(name)


def dependency_closure(
    gates: dict[str, Gate], requested_names: tuple[str, ...]
) -> tuple[str, ...]:
    validate_gate_graph(gates)
    requested = set(requested_names)
    unknown = requested - gates.keys()
    if unknown:
        raise RuntimeError("unknown selected gates: " + ", ".join(sorted(unknown)))

    selected: set[str] = set()

    def add(name: str) -> None:
        if name in selected:
            return
        for dependency in gates[name].dependencies:
            add(dependency)
        selected.add(name)

    for name in requested_names:
        add(name)
    # Registry order is the stable receipt and presentation order. The scheduler
    # may execute independent nodes in any order without affecting this order.
    return tuple(name for name in gates if name in selected)


def terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def excerpt(path: Path) -> str:
    data = path.read_bytes()
    if len(data) <= MAXIMUM_FAILURE_EXCERPT_BYTES:
        selected = data
    else:
        half = MAXIMUM_FAILURE_EXCERPT_BYTES // 2
        selected = data[:half] + b"\n... bounded excerpt ...\n" + data[-half:]
    return selected.decode("utf-8", errors="replace")


def gate_input_fingerprint(
    gate: Gate,
    snapshot: InputSnapshot,
    runtime: RuntimeIdentity,
    dependency_results: dict[str, dict[str, Any]],
) -> str:
    dependencies = {
        name: {
            "status": dependency_results[name]["status"],
            "input_fingerprint_sha256": dependency_results[name].get(
                "input_fingerprint_sha256", "unavailable"
            ),
            "outputs": dependency_results[name].get("outputs", []),
        }
        for name in gate.dependencies
    }
    identity = {
        "cache_contract_version": CACHE_CONTRACT_VERSION,
        "gate": gate.name,
        "command": list(gate.identity_command or gate.command),
        "cwd": ".",
        "dependencies": dependencies,
        "timeout_nanoseconds": int(gate.timeout_seconds * 1_000_000_000),
        "maximum_log_bytes": gate.maximum_log_bytes,
        "required_outputs": [path_label(Path(item)) for item in gate.required_outputs],
        "worktree_input_sha256": snapshot.digest_sha256,
        "cargo_lock_sha256": snapshot.cargo_lock_sha256,
        "runtime_input_sha256": runtime.digest_sha256,
        # This is resolved when the node becomes ready. In a fresh checkout the
        # release-build prerequisite creates the executable used by descendants.
        "command_executable": executable_identity(gate.command[0]),
    }
    return digest_value(identity)


def finalize_gate_result(
    gate: Gate,
    directory: Path,
    *,
    status: str,
    exit_code: int | None,
    started: int,
    reason: str | None,
    input_fingerprint: str,
    cache: dict[str, Any],
) -> dict[str, Any]:
    stdout_path = directory / f"{gate.name}.stdout.log"
    stderr_path = directory / f"{gate.name}.stderr.log"
    stdout_path.touch(exist_ok=True)
    stderr_path.touch(exist_ok=True)
    stdout_digest, stdout_bytes = digest_file(stdout_path)
    stderr_digest, stderr_bytes = digest_file(stderr_path)
    outputs = [output_proof(item) for item in gate.required_outputs]
    if status == "passed" and any(item["kind"] != "file" for item in outputs):
        status = "failed"
        reason = "missing_declared_output"
    evidence = {
        "gate": gate.name,
        "input_fingerprint_sha256": input_fingerprint,
        "status": status,
        "exit_code": exit_code,
        "stdout_sha256": stdout_digest,
        "stderr_sha256": stderr_digest,
        "outputs": outputs,
    }
    result: dict[str, Any] = {
        "name": gate.name,
        "status": status,
        "execution": "fresh",
        "command": list(gate.command),
        "dependencies": list(gate.dependencies),
        "exit_code": exit_code,
        "elapsed_nanoseconds": time.monotonic_ns() - started,
        "stdout_bytes": stdout_bytes,
        "stderr_bytes": stderr_bytes,
        "stdout_sha256": stdout_digest,
        "stderr_sha256": stderr_digest,
        "stdout_log": relative(stdout_path),
        "stderr_log": relative(stderr_path),
        "outputs": outputs,
        "input_fingerprint_sha256": input_fingerprint,
        "fingerprint_sha256": digest_value(evidence),
        "cache": cache,
    }
    if reason is not None:
        result["reason"] = reason
    if status != "passed":
        result["stdout_excerpt"] = excerpt(stdout_path)
        result["stderr_excerpt"] = excerpt(stderr_path)
    return result


def run_gate(
    gate: Gate,
    directory: Path,
    input_fingerprint: str = "checker-self-test",
    cache: dict[str, Any] | None = None,
) -> dict[str, Any]:
    stdout_path = directory / f"{gate.name}.stdout.log"
    stderr_path = directory / f"{gate.name}.stderr.log"
    started = time.monotonic_ns()
    environment = os.environ.copy()
    environment["CARGO_NET_OFFLINE"] = "true"
    status = "failed"
    exit_code: int | None = None
    reason: str | None = None
    total_bytes = 0
    streams: dict[Any, tuple[Any, Any]] = {}
    try:
        process = subprocess.Popen(
            list(gate.command),
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except FileNotFoundError:
        stdout_path.write_bytes(b"")
        stderr_path.write_bytes(b"")
        return finalize_gate_result(
            gate,
            directory,
            status="unavailable",
            exit_code=None,
            started=started,
            reason="command_not_found",
            input_fingerprint=input_fingerprint,
            cache=cache or {"eligible": False, "lookup": "self_test"},
        )

    selector = selectors.DefaultSelector()
    with stdout_path.open("wb") as stdout_file, stderr_path.open("wb") as stderr_file:
        assert process.stdout is not None and process.stderr is not None
        selector.register(process.stdout, selectors.EVENT_READ)
        selector.register(process.stderr, selectors.EVENT_READ)
        streams[process.stdout] = (stdout_file, stdout_path)
        streams[process.stderr] = (stderr_file, stderr_path)
        deadline = time.monotonic() + gate.timeout_seconds
        try:
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0 and process.poll() is None:
                    status = "exhausted"
                    reason = "timeout"
                    terminate(process)
                events = selector.select(max(0.0, min(0.25, remaining)))
                for key, _ in events:
                    chunk = os.read(key.fileobj.fileno(), 65_536)
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    writable = min(len(chunk), max(0, gate.maximum_log_bytes - total_bytes))
                    if writable:
                        streams[key.fileobj][0].write(chunk[:writable])
                        total_bytes += writable
                    if writable != len(chunk) and reason is None:
                        status = "exhausted"
                        reason = "log_limit"
                        terminate(process)
                if process.poll() is not None and not events:
                    for file_object in list(selector.get_map().values()):
                        chunk = os.read(file_object.fileobj.fileno(), 65_536)
                        if chunk:
                            output = streams[file_object.fileobj][0]
                            writable = min(
                                len(chunk), max(0, gate.maximum_log_bytes - total_bytes)
                            )
                            if writable:
                                output.write(chunk[:writable])
                                total_bytes += writable
                            if writable != len(chunk) and reason is None:
                                status = "exhausted"
                                reason = "log_limit"
                        else:
                            selector.unregister(file_object.fileobj)
        except KeyboardInterrupt:
            terminate(process)
            process.wait(timeout=5)
            raise
        finally:
            selector.close()
        exit_code = process.wait(timeout=5)
    if reason is None:
        status = "passed" if exit_code == 0 else "failed"
        reason = None if exit_code == 0 else "nonzero_exit"
    return finalize_gate_result(
        gate,
        directory,
        status=status,
        exit_code=exit_code,
        started=started,
        reason=reason,
        input_fingerprint=input_fingerprint,
        cache=cache or {"eligible": False, "lookup": "self_test"},
    )


def checked_output(command: list[str]) -> str:
    result = subprocess.run(
        command,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else "unavailable"


def atomic_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_path, path)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def cache_record_path(cache_root: Path, gate: Gate, fingerprint: str) -> Path:
    if GATE_NAME.fullmatch(gate.name) is None or re.fullmatch(r"[0-9a-f]{64}", fingerprint) is None:
        raise RuntimeError("refusing unsafe verification cache identity")
    return cache_root / "evidence" / gate.name / f"{fingerprint}.json"


def cache_log_path(cache_root: Path, digest: str) -> Path:
    if re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        raise RuntimeError("refusing unsafe verification log identity")
    return cache_root / "logs" / f"{digest}.log"


def cache_miss_reason(record_path: Path) -> str:
    parent = record_path.parent
    if not parent.is_dir():
        return "not_found"
    try:
        return "input_changed" if any(parent.glob("*.json")) else "not_found"
    except OSError:
        return "cache_unreadable"


def cached_evidence_digest(record: dict[str, Any]) -> str:
    return digest_value(
        {
            "gate": record["gate"],
            "input_fingerprint_sha256": record["input_fingerprint_sha256"],
            "status": "passed",
            "exit_code": 0,
            "stdout_sha256": record["stdout_sha256"],
            "stderr_sha256": record["stderr_sha256"],
            "outputs": record["outputs"],
        }
    )


def load_cached_gate(
    gate: Gate,
    input_fingerprint: str,
    directory: Path,
    cache_root: Path = CACHE_ROOT,
) -> CacheLookup:
    started = time.monotonic_ns()
    record_path = cache_record_path(cache_root, gate, input_fingerprint)
    if not record_path.exists():
        return CacheLookup(None, cache_miss_reason(record_path))
    if record_path.is_symlink():
        return CacheLookup(None, "unsafe_record_symlink")
    try:
        if record_path.stat().st_size > MAXIMUM_CACHE_RECORD_BYTES:
            return CacheLookup(None, "record_too_large")
        raw_record = record_path.read_bytes()
        record = json.loads(raw_record)
        expected_keys = {
            "cache_contract_version",
            "gate",
            "input_fingerprint_sha256",
            "identity_command",
            "source_elapsed_nanoseconds",
            "stdout_bytes",
            "stderr_bytes",
            "stdout_sha256",
            "stderr_sha256",
            "outputs",
            "fingerprint_sha256",
        }
        if not isinstance(record, dict) or set(record) != expected_keys:
            return CacheLookup(None, "record_shape")
        if (
            record["cache_contract_version"] != CACHE_CONTRACT_VERSION
            or record["gate"] != gate.name
            or record["input_fingerprint_sha256"] != input_fingerprint
            or record["identity_command"] != list(gate.identity_command or gate.command)
        ):
            return CacheLookup(None, "record_binding")
        if not isinstance(record["source_elapsed_nanoseconds"], int) or record[
            "source_elapsed_nanoseconds"
        ] < 0:
            return CacheLookup(None, "record_elapsed")
        for stream in ("stdout", "stderr"):
            byte_count = record[f"{stream}_bytes"]
            digest = record[f"{stream}_sha256"]
            if (
                not isinstance(byte_count, int)
                or byte_count < 0
                or byte_count > gate.maximum_log_bytes
                or not isinstance(digest, str)
            ):
                return CacheLookup(None, f"record_{stream}")
            log_path = cache_log_path(cache_root, digest)
            if (
                log_path.is_symlink()
                or not log_path.is_file()
                or log_path.stat().st_size != byte_count
            ):
                return CacheLookup(None, f"{stream}_log_missing")
            observed_digest, observed_bytes = digest_file(log_path)
            if observed_bytes != byte_count or observed_digest != digest:
                return CacheLookup(None, f"{stream}_log_corrupt")
        if not isinstance(record["outputs"], list):
            return CacheLookup(None, "record_outputs")
        current_outputs = [output_proof(item) for item in gate.required_outputs]
        if record["outputs"] != current_outputs:
            return CacheLookup(None, "declared_output_changed")
        if cached_evidence_digest(record) != record["fingerprint_sha256"]:
            return CacheLookup(None, "evidence_digest")

        stdout_path = directory / f"{gate.name}.stdout.log"
        stderr_path = directory / f"{gate.name}.stderr.log"
        shutil.copyfile(cache_log_path(cache_root, record["stdout_sha256"]), stdout_path)
        shutil.copyfile(cache_log_path(cache_root, record["stderr_sha256"]), stderr_path)
        result: dict[str, Any] = {
            "name": gate.name,
            "status": "passed",
            "execution": "reused",
            "command": list(gate.command),
            "dependencies": list(gate.dependencies),
            "exit_code": 0,
            "elapsed_nanoseconds": time.monotonic_ns() - started,
            "source_elapsed_nanoseconds": record["source_elapsed_nanoseconds"],
            "stdout_bytes": record["stdout_bytes"],
            "stderr_bytes": record["stderr_bytes"],
            "stdout_sha256": record["stdout_sha256"],
            "stderr_sha256": record["stderr_sha256"],
            "stdout_log": relative(stdout_path),
            "stderr_log": relative(stderr_path),
            "outputs": record["outputs"],
            "input_fingerprint_sha256": input_fingerprint,
            "fingerprint_sha256": record["fingerprint_sha256"],
            "cache": {
                "eligible": True,
                "lookup": "hit",
                "record": relative(record_path),
            },
        }
        return CacheLookup(result, "hit")
    except (OSError, RuntimeError, TypeError, ValueError, json.JSONDecodeError):
        return CacheLookup(None, "cache_corrupt")


def rotate_gate_cache(record_path: Path) -> None:
    records = sorted(
        record_path.parent.glob("*.json"), key=lambda path: path.stat().st_mtime_ns, reverse=True
    )
    for obsolete in records[MAXIMUM_CACHE_ENTRIES_PER_GATE:]:
        if obsolete.parent.resolve() != record_path.parent.resolve():
            raise RuntimeError("refusing to remove an unexpected verification cache path")
        obsolete.unlink()


def prune_cache(cache_root: Path) -> None:
    evidence_root = cache_root / "evidence"
    logs_root = cache_root / "logs"
    if not evidence_root.is_dir() or not logs_root.is_dir():
        return
    records: list[dict[str, Any]] = []
    for path in evidence_root.glob("*/*.json"):
        try:
            if path.stat().st_size > MAXIMUM_CACHE_RECORD_BYTES:
                path.unlink()
                continue
            value = json.loads(path.read_bytes())
            digests = (value["stdout_sha256"], value["stderr_sha256"])
            if any(re.fullmatch(r"[0-9a-f]{64}", item) is None for item in digests):
                path.unlink()
                continue
            records.append(
                {
                    "path": path,
                    "mtime": path.stat().st_mtime_ns,
                    "bytes": path.stat().st_size,
                    "digests": digests,
                }
            )
        except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
            try:
                path.unlink()
            except FileNotFoundError:
                pass

    def retained_size() -> int:
        referenced = {digest for record in records for digest in record["digests"]}
        log_bytes = 0
        for digest in referenced:
            try:
                log_bytes += cache_log_path(cache_root, digest).stat().st_size
            except FileNotFoundError:
                pass
        return sum(record["bytes"] for record in records) + log_bytes

    records.sort(key=lambda item: item["mtime"])
    while len(records) > 1 and retained_size() > MAXIMUM_CACHE_BYTES:
        obsolete = records.pop(0)
        try:
            obsolete["path"].unlink()
        except FileNotFoundError:
            pass
    referenced = {digest for record in records for digest in record["digests"]}
    for path in logs_root.glob("*.log"):
        digest = path.stem
        if digest not in referenced:
            try:
                path.unlink()
            except FileNotFoundError:
                pass


def store_cached_gate(
    gate: Gate,
    result: dict[str, Any],
    cache_root: Path = CACHE_ROOT,
) -> str:
    if not gate.cacheable or result["status"] != "passed" or result["execution"] != "fresh":
        return "not_eligible"
    stdout_path = ROOT / result["stdout_log"]
    stderr_path = ROOT / result["stderr_log"]
    for stream, source in (("stdout", stdout_path), ("stderr", stderr_path)):
        digest, size = digest_file(source)
        if digest != result[f"{stream}_sha256"] or size != result[f"{stream}_bytes"]:
            raise RuntimeError(f"{gate.name} {stream} log changed before cache publication")
        atomic_write(cache_log_path(cache_root, digest), source.read_bytes())
    current_outputs = [output_proof(item) for item in gate.required_outputs]
    if current_outputs != result["outputs"]:
        raise RuntimeError(f"{gate.name} output changed before cache publication")
    record = {
        "cache_contract_version": CACHE_CONTRACT_VERSION,
        "gate": gate.name,
        "input_fingerprint_sha256": result["input_fingerprint_sha256"],
        "identity_command": list(gate.identity_command or gate.command),
        "source_elapsed_nanoseconds": result["elapsed_nanoseconds"],
        "stdout_bytes": result["stdout_bytes"],
        "stderr_bytes": result["stderr_bytes"],
        "stdout_sha256": result["stdout_sha256"],
        "stderr_sha256": result["stderr_sha256"],
        "outputs": result["outputs"],
        "fingerprint_sha256": result["fingerprint_sha256"],
    }
    record_path = cache_record_path(cache_root, gate, result["input_fingerprint_sha256"])
    atomic_write(record_path, json.dumps(record, indent=2, sort_keys=True).encode("utf-8") + b"\n")
    rotate_gate_cache(record_path)
    prune_cache(cache_root)
    return relative(record_path) if cache_root == CACHE_ROOT else str(record_path)


def execute_gate(
    gate: Gate,
    directory: Path,
    snapshot: InputSnapshot,
    runtime: RuntimeIdentity,
    dependency_results: dict[str, dict[str, Any]],
    *,
    allow_reuse: bool,
    fresh_reason: str,
    cache_root: Path = CACHE_ROOT,
) -> dict[str, Any]:
    input_fingerprint = gate_input_fingerprint(gate, snapshot, runtime, dependency_results)
    if allow_reuse and gate.cacheable:
        lookup = load_cached_gate(gate, input_fingerprint, directory, cache_root)
        if lookup.result is not None:
            return lookup.result
        cache = {"eligible": True, "lookup": "miss", "reason": lookup.reason}
    elif not gate.cacheable:
        cache = {"eligible": False, "lookup": "bypassed", "reason": "gate_not_cacheable"}
    else:
        cache = {"eligible": True, "lookup": "bypassed", "reason": fresh_reason}
    return run_gate(gate, directory, input_fingerprint, cache)


def skipped_gate_result(
    gate: Gate,
    snapshot: InputSnapshot,
    runtime: RuntimeIdentity,
    dependency_results: dict[str, dict[str, Any]],
) -> dict[str, Any]:
    failed_dependencies = [
        name for name in gate.dependencies if dependency_results[name]["status"] != "passed"
    ]
    input_fingerprint = gate_input_fingerprint(gate, snapshot, runtime, dependency_results)
    evidence = {
        "gate": gate.name,
        "input_fingerprint_sha256": input_fingerprint,
        "status": "skipped",
        "failed_dependencies": failed_dependencies,
    }
    return {
        "name": gate.name,
        "status": "skipped",
        "execution": "skipped",
        "command": list(gate.command),
        "dependencies": list(gate.dependencies),
        "failed_dependencies": failed_dependencies,
        "exit_code": None,
        "elapsed_nanoseconds": 0,
        "stdout_bytes": 0,
        "stderr_bytes": 0,
        "stdout_log": None,
        "stderr_log": None,
        "outputs": [],
        "input_fingerprint_sha256": input_fingerprint,
        "fingerprint_sha256": digest_value(evidence),
        "reason": "failed_prerequisite",
        "cache": {"eligible": False, "lookup": "not_attempted"},
    }


def internal_failure_result(gate: Gate, directory: Path, error: BaseException) -> dict[str, Any]:
    stdout_path = directory / f"{gate.name}.stdout.log"
    stderr_path = directory / f"{gate.name}.stderr.log"
    stdout_path.write_bytes(b"")
    message = f"checker infrastructure failure: {type(error).__name__}\n"
    stderr_path.write_text(message, encoding="utf-8")
    return finalize_gate_result(
        gate,
        directory,
        status="failed",
        exit_code=None,
        started=time.monotonic_ns(),
        reason="checker_infrastructure",
        input_fingerprint="unavailable",
        cache={"eligible": False, "lookup": "error"},
    )


def execute_dag(
    gates: dict[str, Gate],
    names: tuple[str, ...],
    directory: Path,
    snapshot: InputSnapshot,
    runtime: RuntimeIdentity,
    *,
    maximum_workers: int,
    allow_reuse: bool,
    fresh_reason: str,
    cache_root: Path = CACHE_ROOT,
) -> list[dict[str, Any]]:
    if not 1 <= maximum_workers <= MAXIMUM_WORKERS:
        raise RuntimeError(f"worker count must be between 1 and {MAXIMUM_WORKERS}")
    order = {name: position for position, name in enumerate(names)}
    pending = set(names)
    completed: dict[str, dict[str, Any]] = {}
    running: dict[Future[dict[str, Any]], str] = {}

    with ThreadPoolExecutor(max_workers=maximum_workers, thread_name_prefix="check-gate") as pool:
        while pending or running:
            progressed = False
            for name in sorted(pending, key=order.__getitem__):
                gate = gates[name]
                if not all(dependency in completed for dependency in gate.dependencies):
                    continue
                dependencies = {
                    dependency: completed[dependency] for dependency in gate.dependencies
                }
                if any(result["status"] != "passed" for result in dependencies.values()):
                    completed[name] = skipped_gate_result(gate, snapshot, runtime, dependencies)
                    pending.remove(name)
                    progressed = True
                    continue
                if len(running) >= maximum_workers:
                    break
                future = pool.submit(
                    execute_gate,
                    gate,
                    directory,
                    snapshot,
                    runtime,
                    dependencies,
                    allow_reuse=allow_reuse,
                    fresh_reason=fresh_reason,
                    cache_root=cache_root,
                )
                running[future] = name
                pending.remove(name)
                progressed = True

            if running:
                finished, _ = wait(tuple(running), return_when=FIRST_COMPLETED)
                for future in finished:
                    name = running.pop(future)
                    try:
                        completed[name] = future.result()
                    except Exception as error:
                        completed[name] = internal_failure_result(gates[name], directory, error)
                progressed = True
            if not progressed and pending:
                raise RuntimeError("verification DAG scheduler made no progress")
    return [completed[name] for name in names]


def changed_paths() -> list[str]:
    output = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout
    records = [record for record in output.split(b"\0") if record]
    paths: list[str] = []
    index = 0
    while index < len(records):
        record = records[index]
        if len(record) < 4:
            raise RuntimeError("git emitted malformed porcelain status")
        status = record[:2]
        paths.append(os.fsdecode(record[3:]))
        if b"R" in status or b"C" in status:
            index += 1
            if index >= len(records):
                raise RuntimeError("git omitted the second rename path")
            paths.append(os.fsdecode(records[index]))
        index += 1
    return sorted(set(paths))


def select_changed() -> tuple[tuple[str, ...], dict[str, Any]]:
    paths = changed_paths()
    selected: set[str] = {"diff_check"}
    reasons: list[str] = []
    widen_full = False
    for path in paths:
        if path == "Cargo.toml" or path == "Cargo.lock" or path.startswith(("src/", "tests/")):
            widen_full = True
            reasons.append(f"runtime_or_test:{path}")
        elif path.startswith(("applications/", "packages/")):
            selected.update(PROFILES["product"])
            selected.add("service_acceptance")
            reasons.append(f"maintained_package:{path}")
        elif path == "tools/check":
            selected.add("checker_self_test")
            reasons.append("verification_contract:tools/check")
        elif path == "tools/service-acceptance":
            selected.update(PROFILES["service"])
            reasons.append("service_acceptance:tools/service-acceptance")
        elif path.startswith(("docs/", "prompts/")) or path in {"README.md", "AGENTS.md"}:
            reasons.append(f"documentation:{path}")
        else:
            widen_full = True
            reasons.append(f"uncertain:{path}")
    if widen_full:
        names = PROFILES["full"]
    else:
        ordered = list(PROFILES["full"])
        names = tuple(name for name in ordered if name in selected)
    return names, {"paths": paths, "reasons": reasons, "widened_to_full": widen_full}


def managed_run(path: Path, prefix: str) -> bool:
    name = path.name
    if prefix:
        if not name.startswith(prefix):
            return False
        name = name[len(prefix) :]
    elif name.startswith("self-test-"):
        return False
    stamp, separator, process_id = name.rpartition("-")
    return bool(
        separator
        and process_id.isdigit()
        and len(stamp) == 23
        and stamp[:8].isdigit()
        and stamp[8] == "T"
        and stamp[9:15].isdigit()
        and stamp[15] == "."
        and stamp[16:22].isdigit()
        and stamp[22] == "Z"
    )


def rotate_runs(current: Path, prefix: str) -> None:
    candidates = sorted(
        (
            path
            for path in LOG_ROOT.iterdir()
            if path.is_dir()
            and path.resolve() != current.resolve()
            and managed_run(path, prefix)
        ),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    for path in candidates[MAXIMUM_RETAINED_RUNS - 1 :]:
        if path.parent.resolve() != LOG_ROOT.resolve():
            raise RuntimeError("refusing to remove an unexpected receipt path")
        shutil.rmtree(path)


def new_run_directory(prefix: str = "") -> Path:
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    directory = LOG_ROOT / f"{prefix}{stamp}-{os.getpid()}"
    directory.mkdir(parents=True)
    rotate_runs(directory, prefix)
    return directory



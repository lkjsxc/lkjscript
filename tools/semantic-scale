#!/usr/bin/env python3
"""Generate and measure a many-module graph through the public CLI only."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time
from typing import Any


MAXIMUM_BATCH = 10_000
MAXIMUM_BENCHMARK_MODULES = 1_000_000


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create a deterministic many-module topology using public changes."
    )
    parser.add_argument("--modules", type=int, default=10_000)
    parser.add_argument("--batch", type=int, default=10_000)
    parser.add_argument("--binary", default="target/release/lkjscript")
    parser.add_argument(
        "--retain",
        type=Path,
        help="Use and retain this existing empty directory instead of a temporary project.",
    )
    return parser.parse_args()


def invoke(binary: Path, project: Path, *command: str) -> tuple[dict[str, Any], int, int]:
    started = time.perf_counter_ns()
    result = subprocess.run(
        [str(binary), "--project", str(project), *command],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    elapsed = time.perf_counter_ns() - started
    if result.stderr:
        raise RuntimeError(f"command wrote stderr: {result.stderr[:512]!r}")
    try:
        receipt = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"command returned invalid JSON: {error}") from error
    if result.returncode != 0 or not receipt.get("ok"):
        raise RuntimeError(
            f"command failed ({result.returncode}): "
            f"{json.dumps(receipt, sort_keys=True)[:2048]}"
        )
    return receipt, elapsed, len(result.stdout)


def module_name(ordinal: int) -> str:
    return f"scale.module{ordinal:06d}"


def byte_count(root: Path, include_indexes: bool) -> int:
    total = 0
    for path in root.rglob("*"):
        if not path.is_file() or path.name == "LOCK":
            continue
        relative = path.relative_to(root)
        if not include_indexes and relative.parts[0] in {"indexes", "drafts"}:
            continue
        total += path.stat().st_size
    return total


def payload_bytes(path: Path) -> int:
    if path.is_file():
        return path.stat().st_size
    return sum(
        candidate.stat().st_size
        for candidate in path.rglob("*")
        if candidate.is_file()
    )


def store_inventory(root: Path) -> dict[str, dict[str, int]]:
    inventory: dict[str, dict[str, int]] = {}
    for path in root.rglob("*"):
        if not path.is_file() or path.name == "LOCK":
            continue
        relative = path.relative_to(root)
        area = relative.parts[0]
        current = inventory.setdefault(area, {"files": 0, "bytes": 0})
        current["files"] += 1
        current["bytes"] += path.stat().st_size
    return dict(sorted(inventory.items()))


def inventory_delta(
    before: dict[str, dict[str, int]], after: dict[str, dict[str, int]]
) -> dict[str, dict[str, int]]:
    return {
        area: {
            "files": after.get(area, {}).get("files", 0)
            - before.get(area, {}).get("files", 0),
            "bytes": after.get(area, {}).get("bytes", 0)
            - before.get(area, {}).get("bytes", 0),
        }
        for area in sorted(before.keys() | after.keys())
        if before.get(area) != after.get(area)
    }


def run(configuration: argparse.Namespace, project: Path) -> dict[str, Any]:
    binary = Path(configuration.binary).resolve(strict=True)
    if any(project.iterdir()):
        raise RuntimeError(f"retained benchmark directory is not empty: {project}")

    started = time.perf_counter_ns()
    initialized = subprocess.run(
        [str(binary), "new", str(project), "--template", "minimal", "--name", "scale"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    creation_elapsed = time.perf_counter_ns() - started
    creation_output = len(initialized.stdout)
    if initialized.stderr or initialized.returncode != 0:
        raise RuntimeError(
            f"project creation failed ({initialized.returncode}): "
            f"{initialized.stderr[:512]!r} {initialized.stdout[:2048]!r}"
        )
    creation_receipt = json.loads(initialized.stdout)
    revision = creation_receipt["result"]["revision"]
    applied: list[dict[str, Any]] = []
    request_bytes = 0
    final_module_id = ""

    for start in range(0, configuration.modules, configuration.batch):
        end = min(start + configuration.batch, configuration.modules)
        changes = [
            {
                "change": "create_module",
                "as": f"$module-{ordinal}",
                "name": module_name(ordinal),
            }
            for ordinal in range(start, end)
        ]
        request = {
            "contract_version": 3,
            "base_revision": revision,
            "idempotency_key": f"scale-{configuration.modules}-{start}-{end}",
            "preconditions": [],
            "changes": changes,
            "budget": {
                "maximum_operations": len(changes),
                "maximum_work": 10_000_000,
                "maximum_affected_owners": 100_000,
            },
            "intent": "Deterministic public CLI many-module scale fixture",
        }
        request_path = project / f"change-{start:06d}-{end:06d}.json"
        encoded = json.dumps(request, separators=(",", ":"), sort_keys=True).encode()
        request_bytes += len(encoded)
        request_path.write_bytes(encoded)
        receipt, elapsed, output_bytes = invoke(
            binary, project, "change", "--request-file", str(request_path), "--commit"
        )
        request_path.unlink()
        revision = receipt["result"]["published_revision"]
        final_module_id = receipt["result"]["allocated_identities"][
            f"$module-{end - 1}"
        ]["id"]
        applied.append(
            {
                "start": start,
                "end": end,
                "elapsed_nanoseconds": elapsed,
                "response_bytes": output_bytes,
                "revision": revision,
            }
        )

    store = project / ".lkjscript" / "meaning"
    before_local_create = store_inventory(store)
    local_create_request = {
        "contract_version": 3,
        "base_revision": revision,
        "idempotency_key": f"scale-{configuration.modules}-local-create",
        "changes": [
            {
                "change": "create_module",
                "as": "$local-module",
                "name": "scale.localedit",
            }
        ],
        "intent": "Measure one independent module creation after the background topology",
    }
    local_create_path = project / "change-local-create.json"
    local_create_path.write_bytes(
        json.dumps(
            local_create_request, separators=(",", ":"), sort_keys=True
        ).encode()
    )
    local_create, local_create_elapsed, local_create_output = invoke(
        binary,
        project,
        "change",
        "--request-file",
        str(local_create_path),
        "--commit",
    )
    local_create_path.unlink()
    revision = local_create["result"]["published_revision"]
    final_module_id = local_create["result"]["allocated_identities"]["$local-module"][
        "id"
    ]
    after_local_create = store_inventory(store)

    local_rename_request = {
        "contract_version": 3,
        "base_revision": revision,
        "idempotency_key": f"scale-{configuration.modules}-local-rename",
        "changes": [
            {
                "change": "rename_module",
                "module": final_module_id,
                "new_name": "scale.renamedlocaledit",
            }
        ],
        "intent": "Measure one module rename after the background topology",
    }
    local_rename_path = project / "change-local-rename.json"
    local_rename_path.write_bytes(
        json.dumps(
            local_rename_request, separators=(",", ":"), sort_keys=True
        ).encode()
    )
    local_rename, local_rename_elapsed, local_rename_output = invoke(
        binary,
        project,
        "change",
        "--request-file",
        str(local_rename_path),
        "--commit",
    )
    local_rename_path.unlink()
    revision = local_rename["result"]["published_revision"]
    after_local_rename = store_inventory(store)

    orient, orient_elapsed, orient_bytes = invoke(
        binary, project, "inspect", "project", "--limit", "10"
    )
    find_cold, find_cold_elapsed, find_cold_bytes = invoke(
        binary,
        project,
        "query",
        "find",
        "scale.renamedlocaledit",
        "--exact",
        "--limit",
        "10",
    )
    find, find_elapsed, find_bytes = invoke(
        binary,
        project,
        "query",
        "find",
        "scale.renamedlocaledit",
        "--exact",
        "--limit",
        "10",
    )
    show, show_elapsed, show_bytes = invoke(
        binary, project, "inspect", "owner", final_module_id
    )
    doctor, doctor_elapsed, doctor_bytes = invoke(binary, project, "doctor", "--deep")
    artifact_path = project / "scale.lkja"
    build, build_elapsed, build_bytes = invoke(
        binary, project, "build", "--output", str(artifact_path)
    )
    backup_path = project / "scale.lkjb"
    backup, backup_elapsed, backup_bytes = invoke(
        binary, project, "backup", "--output", str(backup_path)
    )
    return {
        "contract_version": 3,
        "topology": "many_tiny_modules",
        "requested_modules": configuration.modules,
        "batch_size": configuration.batch,
        "base_modules": orient["result"]["module_count"] - configuration.modules - 1,
        "measured_local_modules": 1,
        "total_modules": orient["result"]["module_count"],
        "final_revision": revision,
        "creation": {
            "elapsed_nanoseconds": creation_elapsed,
            "response_bytes": creation_output,
        },
        "apply_batches": applied,
        "local_create": {
            "elapsed_nanoseconds": local_create_elapsed,
            "response_bytes": local_create_output,
            "revision": local_create["result"]["published_revision"],
            "validation": local_create["result"]["receipt"]["validation"],
            "store_delta": inventory_delta(before_local_create, after_local_create),
        },
        "local_rename": {
            "elapsed_nanoseconds": local_rename_elapsed,
            "response_bytes": local_rename_output,
            "revision": local_rename["result"]["published_revision"],
            "validation": local_rename["result"]["receipt"]["validation"],
            "store_delta": inventory_delta(after_local_create, after_local_rename),
        },
        "transaction_request_bytes": request_bytes,
        "orient": {
            "elapsed_nanoseconds": orient_elapsed,
            "response_bytes": orient_bytes,
            "returned_items": len(orient["result"]["modules"]),
        },
        "exact_find": {
            "elapsed_nanoseconds": find_elapsed,
            "response_bytes": find_bytes,
            "work": find["result"]["work"],
            "matches": find["result"]["total_items"],
        },
        "exact_find_cold_index": {
            "elapsed_nanoseconds": find_cold_elapsed,
            "response_bytes": find_cold_bytes,
            "work": find_cold["result"]["work"],
            "matches": find_cold["result"]["total_items"],
        },
        "exact_show": {
            "elapsed_nanoseconds": show_elapsed,
            "response_bytes": show_bytes,
            "id": show["result"]["id"],
        },
        "deep_doctor": {
            "elapsed_nanoseconds": doctor_elapsed,
            "response_bytes": doctor_bytes,
            **doctor["result"],
        },
        "build": {
            "elapsed_nanoseconds": build_elapsed,
            "response_bytes": build_bytes,
            "artifact_bytes": artifact_path.stat().st_size,
            "artifact_digest": build["result"]["receipt"]["artifact_digest"],
        },
        "backup": {
            "elapsed_nanoseconds": backup_elapsed,
            "response_bytes": backup_bytes,
            "backup_bytes": payload_bytes(backup_path),
            "backup_digest": backup["result"]["receipt"]["digest"],
        },
        "canonical_store_bytes": byte_count(store, include_indexes=False),
        "store_bytes_with_indexes": byte_count(store, include_indexes=True),
        "platform": os.uname().sysname + " " + os.uname().machine,
        "project_retained": configuration.retain is not None,
    }


def main() -> int:
    configuration = arguments()
    if (
        configuration.modules < 1
        or configuration.modules > MAXIMUM_BENCHMARK_MODULES
        or configuration.batch < 1
        or configuration.batch > MAXIMUM_BATCH
    ):
        raise SystemExit(
            f"--modules must be 1 through {MAXIMUM_BENCHMARK_MODULES}; "
            f"--batch must be 1 through {MAXIMUM_BATCH}"
        )
    if configuration.retain is not None:
        project = configuration.retain.resolve(strict=True)
        receipt = run(configuration, project)
    else:
        with tempfile.TemporaryDirectory(prefix="lkjscript-scale-") as directory:
            receipt = run(configuration, Path(directory))
    print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

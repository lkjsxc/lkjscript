declarations.begin
(units
  (use std builtin)
  (module edit MODULE_OWNER readview-flat
    (function create task-source-length (visibility private) (effect (task))
      (parameter create source (type (owned-sequence I64)) (use borrow)) (returns I64 (value))
      (body (call readview-flat::length (local source))))
    (function create task-span-length (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000031 s)
      (parameter create view (type (read-view-application readview-flat::FlatSpan (types) (read-scope (declaration task-span-length) read_scope_d8300000000000000000000000000031))) (use borrow))
      (scope-source view (read-scope (declaration task-span-length) read_scope_d8300000000000000000000000000031))
      (returns I64 (value))
      (body (call readview-flat::view-length (scopes (read-scope (declaration task-span-length) read_scope_d8300000000000000000000000000031)) (local view))))
    (function create task-span-source-length (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000037 s)
      (parameter create view (type (read-view-application readview-flat::FlatSpan (types) (read-scope (declaration task-span-source-length) read_scope_d8300000000000000000000000000037))) (use borrow))
      (scope-source view (read-scope (declaration task-span-source-length) read_scope_d8300000000000000000000000000037))
      (returns I64 (value))
      (body (borrow-call
        (call readview-flat::source (scopes (read-scope (declaration task-span-source-length) read_scope_d8300000000000000000000000000037)) (local view))
        (binding projected (type (owned-sequence I64)))
        (in (call task-source-length (local projected))))))
    (function create task-span-child (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000032 s)
      (parameter create view (type (read-view-application readview-flat::FlatSpan (types) (read-scope (declaration task-span-child) read_scope_d8300000000000000000000000000032))) (use borrow))
      (scope-source view (read-scope (declaration task-span-child) read_scope_d8300000000000000000000000000032))
      (returns (record (left I64) (right I64)) (value))
      (body (parallel
        (call task-span-length (scopes (read-scope (declaration task-span-child) read_scope_d8300000000000000000000000000032)) (local view))
        (call task-span-source-length (scopes (read-scope (declaration task-span-child) read_scope_d8300000000000000000000000000032)) (local view)))))
    (function create task-span-join (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000033 s)
      (parameter create view (type (read-view-application readview-flat::FlatSpan (types) (read-scope (declaration task-span-join) read_scope_d8300000000000000000000000000033))) (use borrow))
      (scope-source view (read-scope (declaration task-span-join) read_scope_d8300000000000000000000000000033))
      (returns (record (left (record (left I64) (right I64))) (right (record (left I64) (right I64)))) (value))
      (body (parallel
        (call task-span-child (scopes (read-scope (declaration task-span-join) read_scope_d8300000000000000000000000000033)) (local view))
        (call task-span-child (scopes (read-scope (declaration task-span-join) read_scope_d8300000000000000000000000000033)) (local view)))))
    (function create joined-range (visibility public) (effect (task))
      (parameter create input (type (list I64))) (parameter create start (type I64)) (parameter create end (type I64))
      (returns (record (observations (record (left (record (left I64) (right I64))) (right (record (left I64) (right I64))))) (drained (list I64))) (value))
      (body (let
        (binding owner (type (owned-sequence I64)) (call readview-flat::build (local input)))
        (binding view (as $flat-joined-view-scope)
          (type (read-view-application readview-flat::FlatSpan (types) (lexical-read-scope joined-range $flat-joined-view-scope)))
          (borrow-call (call readview-flat::range (scopes (lexical-read-scope joined-range $flat-joined-view-scope)) (local start) (local end) (local owner))
            (binding constructed (type (read-view-application readview-flat::FlatSpan (types) (lexical-read-scope joined-range $flat-joined-view-scope))))
            (in (view-move (local constructed)))))
        (binding observations (type (record (left (record (left I64) (right I64))) (right (record (left I64) (right I64)))))
          (call task-span-join (scopes (lexical-read-scope joined-range $flat-joined-view-scope)) (local view)))
        (binding drained (type (owned-product (field rest (owned-sequence I64)) (field values (list I64))))
          (sequence (view-drop (local view)) (call readview-flat::drain (local owner))))
        (in (unpack-owned (type (owned-product (field rest (owned-sequence I64)) (field values (list I64)))) (local drained)
          (field rest (binding rest (type (owned-sequence I64)))) (field values (binding values (type (list I64))))
          (in (record structural (field observations (local observations)) (field drained (local values)))))))))
    (function create task-trap (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000038 s)
      (parameter create view (type (read-view-application readview-flat::FlatSpan (types) (read-scope (declaration task-trap) read_scope_d8300000000000000000000000000038))) (use borrow))
      (scope-source view (read-scope (declaration task-trap) read_scope_d8300000000000000000000000000038))
      (returns I64 (value))
      (body (sequence (call readview-flat::view-length (scopes (read-scope (declaration task-trap) read_scope_d8300000000000000000000000000038)) (local view))
        (call std::divide (i64 1) (i64 0)))))
    (function create joined-failure (visibility public) (effect (task))
      (parameter create input (type (list I64))) (parameter create start (type I64)) (parameter create end (type I64))
      (returns (record (left (record (left I64) (right I64))) (right I64)) (value))
      (body (let
        (binding owner (type (owned-sequence I64)) (call readview-flat::build (local input)))
        (binding view (as $flat-failing-view-scope)
          (type (read-view-application readview-flat::FlatSpan (types) (lexical-read-scope joined-failure $flat-failing-view-scope)))
          (borrow-call
            (call readview-flat::range (scopes (lexical-read-scope joined-failure $flat-failing-view-scope)) (local start) (local end) (local owner))
            (binding constructed (type (read-view-application readview-flat::FlatSpan (types) (lexical-read-scope joined-failure $flat-failing-view-scope))))
            (in (view-move (local constructed)))))
        (in (parallel
          (call task-span-child (scopes (lexical-read-scope joined-failure $flat-failing-view-scope)) (local view))
          (call task-trap (scopes (lexical-read-scope joined-failure $flat-failing-view-scope)) (local view)))))))
    (function create make-passive (visibility private) (effect pure)
      (type-parameter create W (constraint owned))
      (scope-parameter read_scope_d8300000000000000000000000000034 s)
      (parameter create size (type I64)) (parameter create storage (type W) (use borrow))
      (scope-source storage (read-scope (declaration make-passive) read_scope_d8300000000000000000000000000034))
      (returns (read-view-application readview-flat::Metadata (types) (read-scope (declaration make-passive) read_scope_d8300000000000000000000000000034))
        (view-from storage (read-scope (declaration make-passive) read_scope_d8300000000000000000000000000034)))
      (body (view-create readview-flat::Metadata (types) (scope (read-scope (declaration make-passive) read_scope_d8300000000000000000000000000034)) (source storage)
        (field field_d8300000000000000000000000000005 (local size)))))
    (function create task-metadata-read (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000035 s)
      (parameter create view (type (read-view-application readview-flat::Metadata (types) (read-scope (declaration task-metadata-read) read_scope_d8300000000000000000000000000035))) (use borrow))
      (scope-source view (read-scope (declaration task-metadata-read) read_scope_d8300000000000000000000000000035))
      (returns I64 (value))
      (body (call readview-flat::metadata-length (scopes (read-scope (declaration task-metadata-read) read_scope_d8300000000000000000000000000035)) (local view))))
    (function create task-metadata-child (visibility private) (effect (task))
      (scope-parameter read_scope_d8300000000000000000000000000036 s)
      (parameter create view (type (read-view-application readview-flat::Metadata (types) (read-scope (declaration task-metadata-child) read_scope_d8300000000000000000000000000036))) (use borrow))
      (scope-source view (read-scope (declaration task-metadata-child) read_scope_d8300000000000000000000000000036))
      (returns (record (left I64) (right I64)) (value))
      (body (parallel
        (call task-metadata-read (scopes (read-scope (declaration task-metadata-child) read_scope_d8300000000000000000000000000036)) (local view))
        (call task-metadata-read (scopes (read-scope (declaration task-metadata-child) read_scope_d8300000000000000000000000000036)) (local view)))))
    (function create metadata-custody-join (visibility public) (effect (task))
      (type-parameter create W (constraint owned))
      (parameter create size (type I64)) (parameter create storage (type W) (use borrow))
      (returns (record (left (record (left I64) (right I64))) (right (record (left I64) (right I64)))) (value))
      (body (let
        (binding view (as $metadata-custody-view-scope)
          (type (read-view-application readview-flat::Metadata (types) (lexical-read-scope metadata-custody-join $metadata-custody-view-scope)))
          (borrow-call
            (call make-passive (types W) (scopes (lexical-read-scope metadata-custody-join $metadata-custody-view-scope)) (local size) (local storage))
            (binding constructed (type (read-view-application readview-flat::Metadata (types) (lexical-read-scope metadata-custody-join $metadata-custody-view-scope))))
            (in (view-move (local constructed)))))
        (in (parallel
          (call task-metadata-child (scopes (lexical-read-scope metadata-custody-join $metadata-custody-view-scope)) (local view))
          (call task-metadata-child (scopes (lexical-read-scope metadata-custody-join $metadata-custody-view-scope)) (local view)))))))))
declarations.end

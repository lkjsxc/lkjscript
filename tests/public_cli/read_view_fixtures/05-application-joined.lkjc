declarations.begin
(units
  (module edit MODULE_OWNER readview-app
    (type-alias Input (record (values (list I64)) (chunks (list (list I64)))
      (start I64) (end I64) (sub_start I64) (sub_end I64)))
    (type-alias Joined (record (observations (record (left (record (left I64) (right I64)))
      (right (record (left I64) (right I64))))) (drained (list I64))))
    (function create joined-flat (visibility public) (effect (task))
      (parameter create input (type Input)) (returns Joined (value))
      (body (call readview-flat::joined-range (field (local input) (name values))
        (field (local input) (name start)) (field (local input) (name end)))))
    (function create joined-chunked (visibility public) (effect (task))
      (parameter create input (type Input)) (returns Joined (value))
      (body (call readview-chunked::joined-range (field (local input) (name chunks))
        (field (local input) (name start)) (field (local input) (name end)))))
    (function create joined-metadata (visibility public) (effect (task))
      (parameter create input (type Input)) (returns Joined (value))
      (body (let
        (binding owner (type (owned-sequence I64)) (call readview-flat::build (field (local input) (name values))))
        (binding observations (type (record (left (record (left I64) (right I64))) (right (record (left I64) (right I64)))))
          (call readview-flat::metadata-custody-join (types (owned-sequence I64))
            (call readview-flat::length (local owner)) (local owner)))
        (binding drained (type (owned-product (field rest (owned-sequence I64)) (field values (list I64))))
          (call readview-flat::drain (local owner)))
        (in (unpack-owned (type (owned-product (field rest (owned-sequence I64)) (field values (list I64)))) (local drained)
          (field rest (binding rest (type (owned-sequence I64)))) (field values (binding values (type (list I64))))
          (in (record structural (field observations (local observations)) (field drained (local values)))))))))
    (function create joined-failure (visibility public) (effect (task))
      (parameter create input (type Input))
      (returns (record (left (record (left I64) (right I64))) (right I64)) (value))
      (body (call readview-flat::joined-failure (field (local input) (name values))
        (field (local input) (name start)) (field (local input) (name end)))))
    (component create joined-command (visibility private)
      (port create flat (type (task-function (Input) Joined (row))) (function joined-flat))
      (port create chunked (type (task-function (Input) Joined (row))) (function joined-chunked))
      (port create metadata (type (task-function (Input) Joined (row))) (function joined-metadata))
      (port create failure (type (task-function (Input) (record (left (record (left I64) (right I64))) (right I64)) (row))) (function joined-failure))))
  (target create readview-joined-flat (component readview-app::joined-command) (runner command) (port readview-app::joined-command::flat))
  (target create readview-joined-chunked (component readview-app::joined-command) (runner command) (port readview-app::joined-command::chunked))
  (target create readview-joined-metadata (component readview-app::joined-command) (runner command) (port readview-app::joined-command::metadata))
  (target create readview-joined-failure (component readview-app::joined-command) (runner command) (port readview-app::joined-command::failure)))
declarations.end

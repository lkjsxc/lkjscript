// expect: value 112
fn recur(depth: u64, salt: u64) -> u64 {
    if depth == 0 {
        return salt;
    }
    let first = salt + 2;
    let second = salt + 3;
    let third = salt + 5;
    let nested = recur(depth - 1, salt + 1);
    first + second + third + nested
}
pub fn probe() -> u64 {
    recur(3, 7)
}

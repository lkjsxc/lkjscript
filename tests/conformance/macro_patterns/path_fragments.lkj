// expect: value 42
// witness: {"root":true}
enum Value { Answer, Missing }
const ANSWER: i64 = 42i64;
macro_rules! path { ($value:path) => { $value }; }
fn probe() -> i64 {
    let a = match Value::Answer { path!(Value::Answer) => 2i64, _ => 0i64 };
    let b = match ANSWER { path!(ANSWER) => 40i64, _ => 0i64 };
    let c = match Value::Missing { path!(Value::Missing) => 0i64, _ => 9i64 };
    a + b + c
}

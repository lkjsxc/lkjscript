lkjscript-ir 1
# The caller reuses consumed argument storage for the aggregate result.
type "()" unit
type "bool" bool
type "i32" int 32 signed
type "i64" int 64 signed
type "usize" int 64 unsigned
type "u8" int 8 unsigned
type "f64" f64
type "Pair" struct copy "left" 3 "right" 3
fn "swap" 1 7
local "pair" 7 let
local "left" 3 let
local "right" 3 let
local "result" 7 let
@1 read 1 copy 0 field 0
@2 read 2 copy 0 field 1
@3 drop 0
@4 struct 3 2 1
@5 return 3
endfn
fn "probe" 0 3
local "left" 3 let
local "right" 3 let
local "pair" 7 mut
local "first" 3 let
local "second" 3 let
local "result" 3 let
@1 int 0 20
@2 int 1 22
@3 struct 2 0 1
@4 call 2 0 2
@5 read 3 copy 2 field 0
@6 read 4 copy 2 field 1
@7 drop 2
@8 binary 5 "+" 3 4
@9 return 5
endfn

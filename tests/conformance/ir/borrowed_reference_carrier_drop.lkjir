lkjscript-ir 1
type "()" unit
type "bool" bool
type "i32" int 32 signed
type "i64" int 64 signed
type "usize" int 64 unsigned
type "u8" int 8 unsigned
type "f64" f64
type "&i64" ref shared 3
type "&&i64" ref shared 7
fn "probe" 0 3
local "value" 3 let
local "shared" 7 let
local "carrier" 8 let
local "output" 8 let
local "result" 3 let
@1 int 0 42
@2 borrow 1 shared 0
@3 borrow 2 shared 1
@4 borrow 3 shared 2 deref
@5 drop 2
@6 drop 1
@7 int 4 42
@8 drop 3
@9 drop 0
@10 return 4
endfn

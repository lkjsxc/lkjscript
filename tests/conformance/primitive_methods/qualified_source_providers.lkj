// expect: value 42
// witness: {}
trait CheckedArithmetic {
    fn checked_add(left: i32, right: i32) -> bool;
}
impl CheckedArithmetic for i32 {
    fn checked_add(_left: i32, _right: i32) -> bool {
        false
    }
}
trait ByteAscii {
    fn is_ascii_digit(value: &u8) -> i64;
}
impl ByteAscii for u8 {
    fn is_ascii_digit(_value: &u8) -> i64 {
        1
    }
}
pub fn probe() -> i64 {
    let value = i32::checked_add(40, 2).unwrap();
    assert!(i32::checked_sub(value, 2).unwrap() == 40);
    assert!(i32::checked_mul(21, 2).unwrap() == 42);
    assert!(i32::checked_div(84, 2).unwrap() == 42);
    assert!(i32::checked_rem(42, 2).unwrap() == 0);
    assert!(i32::saturating_add(40, 2) == 42);
    if u8::is_ascii_digit(&b'2') {
        value as i64
    } else {
        1
    }
}

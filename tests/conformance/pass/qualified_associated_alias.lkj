// expect: value 42
// witness: {}
mod declarations {
    pub trait Value { type Item; fn value() -> Self::Item; }
    pub struct Number {}
    impl Value for Number { type Item = i64; fn value() -> i64 { 42 } }
}
use declarations::Value as Selected;
type ResultOf<T: Selected> = Option<<T as Selected>::Item>;
fn create<T: Selected>() -> ResultOf<T> { Some(<T as Selected>::value()) }
pub fn probe() -> i64 {
    match create::<declarations::Number>() { Some(value) => value, None => 0 }
}

// expect: value 42
// witness: {}
use std::collections::{BTreeMap, BTreeSet};
use std::fmt;
fn show_map<K: fmt::Debug, V: fmt::Debug>(value: &BTreeMap<K, V>) -> String { format!("{:?}", value) }
fn show_set<T: fmt::Debug>(value: &BTreeSet<T>) -> String { format!("{:?}", value) }
struct DebugOnly;
impl fmt::Debug for DebugOnly {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.write_str("DebugOnly") }
}
#[derive(Debug)]
struct Nested { map: BTreeMap<i64, Vec<i64>>, set: BTreeSet<String> }
pub fn probe() -> i64 {
    let empty: BTreeMap<DebugOnly, DebugOnly> = BTreeMap::new();
    assert_eq!(show_map(&empty), "{}");
    let mut map = BTreeMap::new();
    map.insert(2i64, vec![3i64, 4i64]);
    map.insert(1i64, vec![2i64]);
    assert_eq!(show_map(&map), "{1: [2], 2: [3, 4]}");
    assert_eq!(format!("{:#?}", map), "{\n    1: [\n        2,\n    ],\n    2: [\n        3,\n        4,\n    ],\n}");
    let mut set = BTreeSet::<String>::new();
    assert_eq!(show_set(&set), "{}");
    set.insert("z".to_string());
    set.insert("a".to_string());
    set.insert("z".to_string());
    assert_eq!(show_set(&set), "{\"a\", \"z\"}");
    assert_eq!(format!("{:#?}", set), "{\n    \"a\",\n    \"z\",\n}");
    let combined = Nested { map, set };
    assert_eq!(format!("{:?}", combined), "Nested { map: {1: [2], 2: [3, 4]}, set: {\"a\", \"z\"} }");
    42
}

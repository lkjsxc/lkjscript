// expect: value 42
// witness: {"root":true}
const EMPTY: usize = std::mem::size_of::<()>();

const fn scalar_widths() -> bool {
    std::mem::size_of::<bool>() == 1 && std::mem::size_of::<u8>() == 1
        && std::mem::size_of::<i8>() == 1
        && std::mem::size_of::<u16>() == 2 && std::mem::size_of::<i16>() == 2
        && std::mem::size_of::<char>() == 4 && std::mem::size_of::<u32>() == 4
        && std::mem::size_of::<i32>() == 4
        && core::mem::size_of::<f64>() == 8 && core::mem::size_of::<u64>() == 8
        && core::mem::size_of::<i64>() == 8 && core::mem::size_of::<usize>() == 8
        && core::mem::size_of::<isize>() == 8
}

mod shadow {
    mod std {
        pub mod mem {
            pub const fn size_of<T>() -> usize { 17 }
        }
    }
    fn std() -> usize { 4 }
    pub const fn shadowed() -> usize {
        std::mem::size_of::<usize>() + ::std::mem::size_of::<usize>()
    }
    pub fn value() -> usize { std() }
}

fn core() -> usize { 3 }
pub fn probe() -> usize {
    if EMPTY == 0 && scalar_widths() && shadow::shadowed() == 25
        && shadow::value() == 4 && core() == 3 && ::core::mem::size_of::<u32>() == 4 {
        42
    } else {
        17
    }
}

// expect: value 42
// witness: {}
trait Source { type Item; fn get(self) -> Self::Item; }
struct Number {}
impl Source for Number {
    type Item = i64;
    fn get(self) -> i64 { 42 }
}
fn chain<S: Source<Item = T::Item, Item = i64>, T: Source<Item = i64>>(
    source: S, _other: T,
) -> i64 { source.get() }
pub fn probe() -> i64 { chain(Number {}, Number {}) }

// expect: value 42
// witness: {}
trait Source<I> { type Output; fn produce(self, input: I) -> Self::Output; }
struct Number;
impl Source<u8> for Number { type Output = i64; fn produce(self, input: u8) -> i64 { input as i64 } }
impl Source<bool> for Number { type Output = i32; fn produce(self, input: bool) -> i32 { if input { 21 } else { 0 } } }
trait Adapter<I> { type Output; fn adapt(self, input: I) -> Self::Output; }
impl<I, O, P: Source<I, Output = O>> Adapter<I> for (P,) {
    type Output = O;
    fn adapt(self, input: I) -> O { self.0.produce(input) }
}
fn bytes<P: Adapter<u8, Output = i64>>(parser: P) -> i64 { parser.adapt(21u8) }
fn flags<P: Adapter<bool, Output = i32>>(parser: P) -> i32 { parser.adapt(true) }
pub fn probe() -> i64 { bytes((Number,)) + flags((Number,)) as i64 }

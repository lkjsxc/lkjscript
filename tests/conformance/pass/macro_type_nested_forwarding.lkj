// expect: value 42
// witness: {}
macro_rules! inner { (Vec<$x:ty>) => { 4i64 }; ($x:ty) => { 0i64 }; }
macro_rules! outer { ($t:ty) => { inner!($t) }; }
macro_rules! wrap { ($t:ty) => {{ let value: Vec<$t> = Vec::new(); value.len() }}; }
pub fn probe() -> i64 { assert_eq!(outer!(Vec<u32>), 0); assert_eq!(inner!(Vec<u32>), 4); assert_eq!(wrap!(i64), 0usize); 42 }

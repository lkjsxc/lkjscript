// expect: value 42
// witness: {}
trait Seed { fn seed() -> Self; }
impl Seed for i64 { fn seed() -> Self { 42i64 } }
trait Construct { fn make<T: Seed>(&self) -> T; }
struct Factory;
impl Construct for Factory { fn make<T: Seed>(&self) -> T { T::seed() } }
fn make<R: Seed>(factory: &Factory) -> R { factory.make() }
pub fn probe() -> i64 { make::<i64>(&Factory) }

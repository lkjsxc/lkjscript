// expect: value 42
// witness: {}
// entry: conformance_probe
trait QueryRoot { fn query_bound_root(&self) -> Option<String>; }
struct Available {}
impl QueryRoot for Available { fn query_bound_root(&self) -> Option<String> { Some("root".to_string()) } }
fn differs<Q: QueryRoot>(reader: &mut Q, expected: &String) -> bool {
    reader.query_bound_root().as_ref().is_some_and(|root| root != expected)
}
pub fn probe() -> bool {
    let mut reader = Available {};
    differs(&mut reader, &"root".to_string())
}

// Regression observations; the original diagnostic function bodies above stay unchanged.
pub fn conformance_probe() -> i64 {
    assert!(!probe());
    let mut reader = Available {};
    assert!(differs(&mut reader, &"different".to_string()));
    42
}

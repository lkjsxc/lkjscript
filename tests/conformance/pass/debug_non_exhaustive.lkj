// expect: value 42
// witness: {}
use std::fmt;
struct Partial(u8);
impl fmt::Debug for Partial {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self.0 {
            0u8 => f.debug_struct("S").finish_non_exhaustive(),
            1u8 => f.debug_struct("S").field("f", &1i64).finish_non_exhaustive(),
            2u8 => f.debug_tuple("T").finish_non_exhaustive(),
            3u8 => f.debug_tuple("T").field(&1i64).finish_non_exhaustive(),
            4u8 => f.debug_tuple("").finish_non_exhaustive(),
            5u8 => f.debug_tuple("").field(&1i64).finish_non_exhaustive(),
            6u8 => f.debug_list().finish_non_exhaustive(),
            7u8 => f.debug_list().entry(&1i64).finish_non_exhaustive(),
            _ => unreachable!(),
        }
    }
}
pub fn probe() -> i64 {
    assert_eq!(format!("{:?} {:#?}", Partial(0u8), Partial(0u8)), "S { .. } S { .. }");
    assert_eq!(format!("{:?}", Partial(1u8)), "S { f: 1, .. }");
    assert_eq!(format!("{:#?}", Partial(1u8)), "S {\n    f: 1,\n    ..\n}");
    assert_eq!(format!("{:?} {:#?}", Partial(2u8), Partial(2u8)), "T(..) T(..)");
    assert_eq!(format!("{:?}", Partial(3u8)), "T(1, ..)");
    assert_eq!(format!("{:#?}", Partial(3u8)), "T(\n    1,\n    ..\n)");
    assert_eq!(format!("{:?} {:#?}", Partial(4u8), Partial(4u8)), "(..) (..)");
    assert_eq!(format!("{:?}", Partial(5u8)), "(1, ..)");
    assert_eq!(format!("{:#?}", Partial(5u8)), "(\n    1,\n    ..\n)");
    assert_eq!(format!("{:?} {:#?}", Partial(6u8), Partial(6u8)), "[..] [..]");
    assert_eq!(format!("{:?}", Partial(7u8)), "[1, ..]");
    assert_eq!(format!("{:#?}", Partial(7u8)), "[\n    1,\n    ..\n]");
    42
}

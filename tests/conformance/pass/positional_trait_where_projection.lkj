// expect: value 42
// witness: {}
trait Read<I> { type Output; fn read(self, input: I) -> Self::Output; }
trait Source { type Item; }
struct Marker {}
impl Source for Marker { type Item = i64; }
struct Identity {}
impl<I> Read<I> for Identity { type Output = I; fn read(self, input: I) -> I { input } }
fn read<P: Read<A::Item, Output = A::Item>, A>(parser: P, input: A::Item) -> i64 where A: Source<Item = i64> { parser.read(input) }
pub fn probe() -> i64 { read::<Identity, Marker>(Identity {}, 42) }

// expect: value 42
// witness: {}
trait Marker {}
impl<'a, T: ?Sized, const N: usize> Marker for ([u8; N], &'a T) {}
fn require<U: Marker>(_value: &U) -> i64 { 42i64 }
fn call<T: ?Sized, const N: usize>(value: &T, bytes: [u8; N]) -> i64 {
    require(&(bytes, value))
}
pub fn probe() -> i64 { call::<str, 3>("borrowed", [0u8; 3]) }

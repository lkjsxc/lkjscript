// expect: value 42
// witness: {}
pub fn probe() -> i64 {
    let length_a = 3usize;
    let open: Vec<usize> = (1..).take(length_a).collect();
    assert_eq!(open, vec![1usize, 2usize, 3usize]);
    let finite: Vec<usize> = (1..4).collect();
    assert_eq!(finite, open);
    let inclusive: Vec<usize> = (1..=3).collect();
    assert_eq!(inclusive, open);
    let signed_open: Vec<i16> = (-2..).take(3usize).collect();
    assert_eq!(signed_open, vec![-2i16, -1i16, 0i16]);
    let signed_finite: Vec<i16> = (-2..1).collect();
    assert_eq!(signed_finite, signed_open);
    let signed_inclusive: Vec<i16> = (-2..=0).collect();
    assert_eq!(signed_inclusive, signed_open);
    let suffixed: Vec<usize> = (1usize..).take(length_a).collect();
    assert_eq!(suffixed, open);
    let mut direct = 1..;
    let first: usize = direct.next().unwrap();
    assert_eq!(first, 1usize);
    {
        let maximum = u8::MAX;
        let minimum = u8::MIN;
        let mut closed = (maximum - 1u8)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1u8));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1u8)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1u8));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1u8)..;
        assert_eq!(open.next(), Some(maximum - 1u8));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1u8);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1u8));
        assert_eq!(low.next(), None);
        let mut empty = 1u8..0u8;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = u16::MAX;
        let minimum = u16::MIN;
        let mut closed = (maximum - 1u16)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1u16));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1u16)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1u16));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1u16)..;
        assert_eq!(open.next(), Some(maximum - 1u16));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1u16);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1u16));
        assert_eq!(low.next(), None);
        let mut empty = 1u16..0u16;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = u32::MAX;
        let minimum = u32::MIN;
        let mut closed = (maximum - 1u32)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1u32));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1u32)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1u32));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1u32)..;
        assert_eq!(open.next(), Some(maximum - 1u32));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1u32);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1u32));
        assert_eq!(low.next(), None);
        let mut empty = 1u32..0u32;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = u64::MAX;
        let minimum = u64::MIN;
        let mut closed = (maximum - 1u64)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1u64));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1u64)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1u64));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1u64)..;
        assert_eq!(open.next(), Some(maximum - 1u64));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1u64);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1u64));
        assert_eq!(low.next(), None);
        let mut empty = 1u64..0u64;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = usize::MAX;
        let minimum = usize::MIN;
        let mut closed = (maximum - 1usize)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1usize));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1usize)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1usize));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1usize)..;
        assert_eq!(open.next(), Some(maximum - 1usize));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1usize);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1usize));
        assert_eq!(low.next(), None);
        let mut empty = 1usize..0usize;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = i8::MAX;
        let minimum = i8::MIN;
        let mut closed = (maximum - 1i8)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1i8));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1i8)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1i8));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1i8)..;
        assert_eq!(open.next(), Some(maximum - 1i8));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1i8);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1i8));
        assert_eq!(low.next(), None);
        let mut empty = 1i8..0i8;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = i16::MAX;
        let minimum = i16::MIN;
        let mut closed = (maximum - 1i16)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1i16));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1i16)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1i16));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1i16)..;
        assert_eq!(open.next(), Some(maximum - 1i16));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1i16);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1i16));
        assert_eq!(low.next(), None);
        let mut empty = 1i16..0i16;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = i32::MAX;
        let minimum = i32::MIN;
        let mut closed = (maximum - 1i32)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1i32));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1i32)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1i32));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1i32)..;
        assert_eq!(open.next(), Some(maximum - 1i32));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1i32);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1i32));
        assert_eq!(low.next(), None);
        let mut empty = 1i32..0i32;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = i64::MAX;
        let minimum = i64::MIN;
        let mut closed = (maximum - 1i64)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1i64));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1i64)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1i64));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1i64)..;
        assert_eq!(open.next(), Some(maximum - 1i64));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1i64);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1i64));
        assert_eq!(low.next(), None);
        let mut empty = 1i64..0i64;
        assert_eq!(empty.next(), None);
    }
    {
        let maximum = isize::MAX;
        let minimum = isize::MIN;
        let mut closed = (maximum - 1isize)..=maximum;
        assert_eq!(closed.next(), Some(maximum - 1isize));
        assert_eq!(closed.next(), Some(maximum));
        assert_eq!(closed.next(), None);
        assert_eq!(closed.next(), None);
        let mut finite = (maximum - 1isize)..maximum;
        assert_eq!(finite.next(), Some(maximum - 1isize));
        assert_eq!(finite.next(), None);
        let mut open = (maximum - 1isize)..;
        assert_eq!(open.next(), Some(maximum - 1isize));
        drop(open);
        assert_eq!((maximum..).take(0usize).count(), 0usize);
        let mut low = minimum..=(minimum + 1isize);
        assert_eq!(low.next(), Some(minimum));
        assert_eq!(low.next(), Some(minimum + 1isize));
        assert_eq!(low.next(), None);
        let mut empty = 1isize..0isize;
        assert_eq!(empty.next(), None);
    }
    42i64

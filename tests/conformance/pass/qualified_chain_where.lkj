// expect: value 42
// witness: {}
trait Source { type Item; }
trait Value { fn make() -> i64; }
struct Number {}
struct Root {}
impl Source for Root { type Item = Number; }
impl Value for Number { fn make() -> i64 { 42 } }
impl Number { fn make() -> i64 { 99 } }
fn answer<T: Source>() -> i64 where <T as Source>::Item: Value {
    <T as Source>::Item::make()
}
pub fn probe() -> i64 { answer::<Root>() }

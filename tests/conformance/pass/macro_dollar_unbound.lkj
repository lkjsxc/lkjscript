macro_rules! receive { ($d:tt $name:ident) => { 42i64 }; }
macro_rules! forward { () => { receive!($unbound) }; }
macro_rules! names { ($($value:ident $d:tt $name:ident;)*) => { 42i64 }; }
macro_rules! repeat {
    ($($value:ident),+) => { names!($($value $unbound;)*) };
}
fn probe() -> i64 {

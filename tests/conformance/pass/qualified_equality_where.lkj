trait Source { type Item; }
trait Container { type Element; fn make() -> Self::Element; }
struct Number {}
struct Root {}
impl Source for Root { type Item = Number; }
impl Container for Number { type Element = i64; fn make() -> i64 { 42 } }
fn answer<T: Source>() -> i64
where <T as Source>::Item: Container<Element = i64> {
    <T as Source>::Item::make()
}
pub fn probe() -> i64 { answer::<Root>() }

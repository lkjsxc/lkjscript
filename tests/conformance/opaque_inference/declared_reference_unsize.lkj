// expect: value 42
// witness: {}
trait Parser<I> { type Output; fn parse(&mut self, input: I) -> (I, Self::Output); }
struct Counter { amount: i64 }
impl Parser<i64> for Counter {
    type Output = i64;
    fn parse(&mut self, input: i64) -> (i64, i64) { (input + self.amount, input) }
}
fn fill<'a, I: Clone, F>(mut parser: F, output: &'a mut [<F as Parser<I>>::Output])
    -> impl FnMut(I) -> I + 'a
where F: Parser<I> + 'a {
    move |mut input: I| {
        let mut index = 0usize;
        while index < output.len() {
            let (remaining, value) = parser.parse(input);
            input = remaining;
            output[index] = value;
            index += 1usize;
        }
        input
    }
}
pub fn probe() -> i64 {
    let mut output = [0i64, 0i64, 0i64];
    let reference: &mut [i64; 3] = &mut output;
    let mut parse = fill(Counter { amount: 7i64 }, reference);
    let remaining = parse(0i64);
    drop(parse);
    remaining + reference[0usize] + reference[1usize] + reference[2usize]
}

// Minimal error/streaming carriers isolate the unchanged producers; the whole nom source is a separate acceptance target.
trait ParseError<I> {}
impl ParseError<usize> for u8 {}
#[derive(Debug, PartialEq)]
enum Needed { Unknown }
#[derive(Debug, PartialEq)]
enum Err<Failure, Error> { Incomplete(Needed), Error(Error), Failure(Failure) }
// nom-source: modes begin
pub trait Mode {
  /// The output type that may be generated
  type Output<T>;

  /// Produces a value
  fn bind<T, F: FnOnce() -> T>(f: F) -> Self::Output<T>;

  /// Applies a function over the produced value
  fn map<T, U, F: FnOnce(T) -> U>(x: Self::Output<T>, f: F) -> Self::Output<U>;

  /// Combines two values generated by previous parsers
  fn combine<T, U, V, F: FnOnce(T, U) -> V>(
    x: Self::Output<T>,
    y: Self::Output<U>,
    f: F,
  ) -> Self::Output<V>;
}

/// Produces a value. This is the default behaviour for parsers
pub struct Emit;
impl Mode for Emit {
  type Output<T> = T;

  #[inline(always)]
  fn bind<T, F: FnOnce() -> T>(f: F) -> Self::Output<T> {
    f()
  }

  #[inline(always)]
  fn map<T, U, F: FnOnce(T) -> U>(x: Self::Output<T>, f: F) -> Self::Output<U> {
    f(x)
  }

  #[inline(always)]
  fn combine<T, U, V, F: FnOnce(T, U) -> V>(
    x: Self::Output<T>,
    y: Self::Output<U>,
    f: F,
  ) -> Self::Output<V> {
    f(x, y)
  }
}

/// Applies the parser, but do not a produce a value
///
/// This has the effect of greatly reducing the amount of code generated and the
/// parser memory usage. Some combinators check for an error in a child parser but
/// discard the error, and for those, using [Check] makes sure the error is not
/// even generated, only the fact that an error happened remains
pub struct Check;
impl Mode for Check {
  type Output<T> = ();

  #[inline(always)]
  fn bind<T, F: FnOnce() -> T>(_: F) -> Self::Output<T> {}

  #[inline(always)]
  fn map<T, U, F: FnOnce(T) -> U>(_: Self::Output<T>, _: F) -> Self::Output<U> {}

  #[inline(always)]
  fn combine<T, U, V, F: FnOnce(T, U) -> V>(
    _: Self::Output<T>,
    _: Self::Output<U>,
    _: F,
  ) -> Self::Output<V> {
  }
}
// nom-source: modes end
pub type PResult<OM, I, O, E> = Result<
    (I, <<OM as OutputMode>::Output as Mode>::Output<O>),
    Err<E, <<OM as OutputMode>::Error as Mode>::Output<E>>,
>;
trait IsStreaming {}
struct Complete;
impl IsStreaming for Complete {}
trait OutputMode { type Output: Mode; type Error: Mode; type Incomplete: IsStreaming; }
struct OutputM<M: Mode, EM: Mode, S: IsStreaming> { output: M, error: EM, incomplete: S }
impl<M: Mode, EM: Mode, S: IsStreaming> OutputMode for OutputM<M, EM, S> {
    type Output = M;
    type Error = EM;
    type Incomplete = S;
}
trait Parser<Input> {
    type Output;
    type Error: ParseError<Input>;
    fn process<OM: OutputMode>(&mut self, input: Input) -> PResult<OM, Input, Self::Output, Self::Error>;
}
struct Add { amount: usize, calls: usize }
impl Parser<usize> for Add {
    type Output = usize;
    type Error = u8;
    fn process<OM: OutputMode>(&mut self, input: usize) -> PResult<OM, usize, usize, u8> {
        self.calls += 1usize;
        if self.amount == 0usize { return Err(Err::Error(OM::Error::bind(|| 7u8))); }
        Ok((input + self.amount, OM::Output::bind(|| input)))
    }
}
// nom-source: parser-chain begin
macro_rules! impl_parser_for_tuple {
  ($($parser:ident $output:ident),+) => (
    #[allow(non_snake_case)]
    impl<I, $($output),+, E: ParseError<I>, $($parser),+> Parser<I> for ($($parser),+,)
    where
      $($parser: Parser<I, Output = $output, Error = E>),+
    {
      type Output = ($($output),+,);
      type Error = E;

      #[inline(always)]
      fn process<OM: OutputMode>(&mut self, i: I) -> PResult<OM, I, Self::Output, Self::Error> {
        let ($(ref mut $parser),+,) = *self;

        // FIXME: is there a way to avoid producing the output values?
        $(let(i, $output) = $parser.process::<OutputM<Emit, OM::Error, OM::Incomplete>>(i)?;)+

        // ???
        Ok((i, OM::Output::bind(|| ($($output),+,))))
      }
    }
  )
}

macro_rules! impl_parser_for_tuples {
    ($parser1:ident $output1:ident, $($parser:ident $output:ident),+) => {
        impl_parser_for_tuples!(__impl $parser1 $output1; $($parser $output),+);
    };
    (__impl $($parser:ident $output:ident),+; $parser1:ident $output1:ident $(,$parser2:ident $output2:ident)*) => {
        impl_parser_for_tuple!($($parser $output),+);
        impl_parser_for_tuples!(__impl $($parser $output),+, $parser1 $output1; $($parser2 $output2),*);
    };
    (__impl $($parser:ident $output:ident),+;) => {
        impl_parser_for_tuple!($($parser $output),+);
    }
}

impl_parser_for_tuples!(P1 O1, P2 O2, P3 O3, P4 O4, P5 O5, P6 O6, P7 O7, P8 O8, P9 O9, P10 O10, P11 O11, P12 O12, P13 O13, P14 O14, P15 O15, P16 O16, P17 O17, P18 O18, P19 O19, P20 O20, P21 O21);
// nom-source: parser-chain end
pub fn main(mut world: World) {
    let mut parser = (Add { amount: 2usize, calls: 0usize }, Add { amount: 3usize, calls: 0usize }, Add { amount: 5usize, calls: 0usize });
    assert_eq!(parser.process::<OutputM<Emit, Emit, Complete>>(10usize), Ok((20usize, (10usize, 12usize, 15usize))));
    assert_eq!(parser.process::<OutputM<Check, Emit, Complete>>(10usize), Ok((20usize, ())));
    assert_eq!((parser.0.calls, parser.1.calls, parser.2.calls), (2usize, 2usize, 2usize));
    let mut failing = (Add { amount: 2usize, calls: 0usize }, Add { amount: 0usize, calls: 0usize }, Add { amount: 5usize, calls: 0usize });
    assert_eq!(failing.process::<OutputM<Emit, Check, Complete>>(10usize), Err(Err::Error(())));
    assert_eq!((failing.0.calls, failing.1.calls, failing.2.calls), (1usize, 1usize, 0usize));
    world.stdout().write(b"nom parser macros ok\n");
}

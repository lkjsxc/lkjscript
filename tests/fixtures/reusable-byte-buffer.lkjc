request base=BASE
declarations.begin
(units
  (use std builtin)
  (module create buffers
    (function create transfer (visibility private)
      (type-parameter create T)
      (parameter create value (type T))
      (returns T) (effect pure) (body (local value)))
    (function create repeat (visibility private)
      (parameter create count (type I64))
      (parameter create segment (type Bytes))
      (parameter create output (type Bytes))
      (returns Bytes) (effect pure)
      (body (if (call std::less (local count) (i64 1)) (local output)
        (call repeat (call std::subtract (local count) (i64 1)) (local segment)
          (call transfer (types Bytes)
            (call std::bytes-concat (local output) (local segment)))))))
    (function create grow (visibility public)
      (parameter create count (type I64))
      (parameter create segment (type Bytes))
      (returns Bytes) (effect pure)
      (body (call repeat (local count) (local segment)
        (call std::bytes-from-list (list I64)))))
    (function create captured (visibility private)
      (parameter create prefix (type Bytes))
      (parameter create ignored (type I64))
      (returns Bytes) (effect pure) (body (local prefix)))
    (function create retain (visibility public)
      (parameter create segment (type Bytes))
      (returns (record (prefix Bytes) (next Bytes) (captured Bytes)
        (old I64) (enlarged I64) (roundtrip Bytes))) (effect pure)
      (body (let
        (binding prefix (call grow (i64 3) (local segment)))
        (binding saved (call std::map-insert (types Bytes I64)
          (map Bytes I64) (local prefix) (i64 17)))
        (binding reader (bind (function-value captured) (local prefix)))
        (binding next (call std::bytes-concat (local prefix) (local segment)))
        (in (record structural
          (field prefix (local prefix))
          (field next (local next))
          (field captured (invoke (local reader) (i64 0)))
          (field old (call std::map-get-or (types Bytes I64) (local saved) (local prefix) (i64 -1)))
          (field enlarged (call std::map-get-or (types Bytes I64) (local saved) (local next) (i64 -1)))
          (field roundtrip (call std::data-decode-or (types Bytes)
            (call std::data-encode (types Bytes) (local next))
            (call std::bytes-from-list (list I64)))))))))
    (component create console (visibility private)
      (port create grow (type (function (I64 Bytes) Bytes)) (function grow))
      (port create retain (type (function (Bytes)
        (record (prefix Bytes) (next Bytes) (captured Bytes)
          (old I64) (enlarged I64) (roundtrip Bytes)))) (function retain))))
  (target create grow (component buffers::console) (runner command) (port buffers::console::grow))
  (target create retain (component buffers::console) (runner command) (port buffers::console::retain)))
declarations.end

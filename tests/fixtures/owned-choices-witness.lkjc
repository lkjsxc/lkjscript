declarations.begin
(units (module create witness
  (owned-contract create Finish (visibility public)
    (self Self) (type-parameter create Self (constraint owned))
    (method method_42000000000000000000000000000001 finish (parameters (Self consume)) (returns I64)))
  (function create finish (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (implementation-parameter implparam_42000000000000000000000000000001 ops Finish T)
    (parameter create value (type T) (use consume)) (returns I64)
    (body (method-call parameter@finish@implparam_42000000000000000000000000000001 Finish method_42000000000000000000000000000001 (local value))))
  (function create relay (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create again (type Bool))
    (parameter create value (type T) (use consume)) (returns T)
    (body (if (local again) (call relay (types T) (bool false) (local value)) (local value))))
  (function create observe (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create value (type T) (use borrow)) (returns Unit) (body (unit)))
  (function create reborrow (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create value (type T) (use borrow)) (returns Unit)
    (body (call observe (types T) (local value))))
  (external create new (visibility private) (implementation core.cell.create)
    (parameter create n (type I64)) (returns OwnedI64Cell))
  (external create extract (visibility private) (implementation core.cell.extract)
    (parameter create c (type OwnedI64Cell) (use consume)) (returns I64))
  (function create select (visibility public) (effect pure)
    (type-alias Outcome (owned-choice (case accepted I64) (case rejected OwnedI64Cell) (case skipped Unit)))
    (parameter create p (type Outcome) (use consume)) (returns I64)
    (body (match-owned (type Outcome) (local p)
      (case skipped (binding value (type Unit)) (in (i64 7)))
      (case rejected (binding value (type OwnedI64Cell)) (in (call extract (local value))))
      (case accepted (binding value (type I64)) (in (local value))))))
  (function create alternate (visibility public) (effect pure)
    (parameter create p (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell) (case skipped Unit))) (use consume))
    (returns I64) (body (i64 99)))
  (owned-implementation create Scalar (visibility public) (contract Finish)
    (self (owned-choice (case accepted I64) (case rejected OwnedI64Cell) (case skipped Unit)))
    (method method_42000000000000000000000000000001 select))
  (owned-implementation create Alternate (visibility public) (contract Finish)
    (self (owned-choice (case accepted I64) (case rejected OwnedI64Cell) (case skipped Unit)))
    (method method_42000000000000000000000000000001 alternate))
  (function create selected (visibility public) (effect pure)
    (type-alias Outcome (owned-choice (case accepted I64) (case rejected OwnedI64Cell) (case skipped Unit)))
    (parameter create n (type I64)) (parameter create accepted (type Bool))
    (returns (record (scalar I64) (alternate I64) (skipped I64)))
    (body (let
      (binding a (type OwnedI64Cell) (call new (local n)))
      (binding b (type OwnedI64Cell) (call new (local n)))
      (binding p (type Outcome)
        (if (local accepted) (choose-owned (type Outcome) (case accepted) (local n))
          (choose-owned (type Outcome) (case rejected) (local a))))
      (binding p (type Outcome) (call relay (types Outcome) (bool true) (local p)))
      (binding checked (type Unit) (call reborrow (types Outcome) (local p)))
      (binding q (type Outcome) (choose-owned (type Outcome) (case rejected) (local b)))
      (binding s (type Outcome) (choose-owned (type Outcome) (case skipped) (unit)))
      (in (record structural
        (field scalar (implementation-call finish (types Outcome) (implementations concrete@Scalar) (local p)))
        (field alternate (implementation-call finish (types Outcome) (implementations concrete@Alternate) (local q)))
        (field skipped (implementation-call finish (types Outcome) (implementations concrete@Scalar) (local s))))))))))
declarations.end

declarations.begin
(units
  (module create memory
    (external create empty (visibility public) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility public) (implementation core.buffer.push)
      (parameter create octet (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create get (visibility public) (implementation core.buffer.get)
      (parameter create index (type I64))
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create length (visibility public) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create freeze (visibility public) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
    (external create discard (visibility public) (implementation core.buffer.discard)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Unit))
    (function create identity (visibility public) (parameter create n (type I64))
      (returns I64) (effect pure) (body (local n)))
    (function create producer (visibility public)
      (type-parameter create T)
      (parameter create seed (type T)) (parameter create encode (type (function (T) I64)))
      (returns ByteBuffer) (effect pure)
      (body (let (binding b (type ByteBuffer) (call empty))
        (in (call push (invoke (local encode) (local seed)) (local b))))))
    (function create transformer (visibility public)
      (type-parameter create T)
      (parameter create seed (type T)) (parameter create encode (type (function (T) I64)))
      (parameter create b (type ByteBuffer) (use consume))
      (returns ByteBuffer) (effect pure)
      (body (call push (invoke (local encode) (local seed)) (local b))))
    (function create consumer (visibility public)
      (type-parameter create R)
      (parameter create decode (type (function (I64) R)))
      (parameter create b (type ByteBuffer) (use borrow))
      (returns R) (effect pure)
      (body (sequence (call length (local b))
        (invoke (local decode) (call get (i64 0) (local b))))))
    (function create forward (visibility public)
      (type-parameter create R)
      (parameter create decode (type (function (I64) R)))
      (parameter create b (type ByteBuffer) (use borrow))
      (returns R) (effect pure)
      (body (call consumer (types R) (local decode) (local b))))
    (function create main (visibility public) (returns Bytes) (effect pure)
      (body (let
        (binding b0 (type ByteBuffer) (call producer (types I64) (i64 0) (function-value identity)))
        (binding b1 (type ByteBuffer) (call transformer (types I64) (i64 255) (function-value identity) (local b0)))
        (binding b2 (type ByteBuffer) (call transformer (types I64) (i64 128) (function-value identity) (local b1)))
        (binding read (call forward (types I64) (function-value identity) (local b2)))
        (in (call freeze (local b2))))))
    (function create abandoned (visibility public) (returns Unit) (effect pure)
      (body (let (binding b (type ByteBuffer) (call empty)) (in (unit)))))
    (function create discarded (visibility public) (returns Unit) (effect pure)
      (body (let (binding b (type ByteBuffer) (call empty)) (in (call discard (local b))))))
    (function create invalid-push (visibility public)
      (parameter create n (type I64)) (returns Bytes) (effect pure)
      (body (let (binding b (type ByteBuffer) (call empty))
        (binding next (type ByteBuffer) (call push (local n) (local b)))
        (in (call freeze (local next))))))))
declarations.end



declarations.begin
(units
  (module create flows
    (external create add (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create subtract (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (function create builder (visibility private)
      (parameter create n (type I64))
      (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer) (effect pure)
      (body (if (call less (local n) (i64 1)) (local b)
        (let (binding next (type ByteBuffer) (call memory::push (i64 12) (local b)))
          (in (call builder (call subtract (local n) (i64 1)) (local next)))))))
    (function create reader (visibility private)
      (parameter create index (type I64)) (parameter create sum (type I64))
      (parameter create b (type ByteBuffer) (use borrow)) (returns I64) (effect pure)
      (body (if (call less (local index) (call memory::length (local b)))
        (call reader (call add (local index) (i64 1))
          (call add (local sum) (call memory::get (local index) (local b))) (local b))
        (local sum))))
    (function create long-bytes (visibility public) (returns Bytes) (effect pure)
      (body (let (binding empty (type ByteBuffer) (call memory::empty))
        (binding built (type ByteBuffer) (call builder (i64 16384) (local empty)))
        (in (call memory::freeze (local built))))))
    (function create long-read (visibility public) (returns I64) (effect pure)
      (body (let (binding empty (type ByteBuffer) (call memory::empty))
        (binding built (type ByteBuffer) (call builder (i64 16384) (local empty)))
        (in (call reader (i64 0) (i64 0) (local built))))))
    (function create choose (visibility private)
      (parameter create first (type Bool))
      (parameter create a (type ByteBuffer) (use consume))
      (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer) (effect pure)
      (body (if (local first) (local a) (local b))))
    (function create choice (visibility public)
      (parameter create first (type Bool)) (returns Bytes) (effect pure)
      (body (let
        (binding e0 (type ByteBuffer) (call memory::empty))
        (binding a (type ByteBuffer) (call memory::push (i64 0) (local e0)))
        (binding e1 (type ByteBuffer) (call memory::empty))
        (binding b (type ByteBuffer) (call memory::push (i64 255) (local e1)))
        (binding selected (type ByteBuffer) (call choose (local first) (local a) (local b)))
        (in (call memory::freeze (local selected))))))
    (function create task-local (visibility public) (returns Bytes) (effect (task))
      (body (let (binding b (type ByteBuffer) (call memory::empty))
        (in (call memory::freeze (local b))))))
    (constant create frozen (visibility private) (type Bytes)
      (value (let (binding b (type ByteBuffer) (call memory::empty))
        (in (call memory::freeze (local b))))))
    (test create transient-test (visibility private)
      (actual (let (binding b (type ByteBuffer) (call memory::empty))
        (in (call memory::freeze (local b)))))
      (expected (constant frozen)))
    (component create transient-port (visibility private)
      (port create read (type (function (I64) I64))
        (value (let (binding b (type ByteBuffer) (call memory::empty))
          (in (sequence (call memory::discard (local b)) (function-value memory::identity)))))))))
declarations.end


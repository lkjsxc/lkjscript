declarations.begin
(units (module create cancellation
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (function create loan-callback (visibility private)
    (parameter create b (type ByteBuffer) (use borrow)) (returns I64) (effect pure)
    (body (call add (call memory::length (local b)) (i64 0))))
  (function create cancel-loan (visibility public) (returns I64) (effect pure)
    (body (let (binding b (type ByteBuffer) (call memory::empty))
      (in (call loan-callback (local b))))))
  (function create scope-cleanup (visibility public) (returns I64) (effect pure)
    (body (sequence
      (let (binding b (type ByteBuffer) (call memory::empty)) (in (unit)))
      (call add (i64 0) (i64 0)))))))
declarations.end

declarations.begin
(units (module create bounds
  (function create invalid-index (visibility public)
    (parameter create index (type I64)) (returns I64) (effect pure)
    (body (let (binding empty (type ByteBuffer) (call memory::empty))
      (binding b (type ByteBuffer) (call memory::push (i64 128) (local empty)))
      (in (call memory::get (local index) (local b))))))))

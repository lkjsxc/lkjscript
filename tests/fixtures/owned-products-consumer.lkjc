declarations.begin
(units
  (module create consume
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create n (type I64)) (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create b (type ByteBuffer) (use consume)) (returns Bytes))
    (external create cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create extract (visibility private) (implementation core.cell.extract)
      (parameter create c (type OwnedI64Cell) (use consume)) (returns I64))
    (function create factory (visibility public) (effect pure)
      (parameter create n (type I64))
      (returns (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)))
      (body (let
        (binding a (type ByteBuffer) (call empty))
        (binding b (type ByteBuffer) (call push (i64 0) (local a)))
        (binding c (type ByteBuffer) (call push (i64 255) (local b)))
        (binding d (type ByteBuffer) (call push (i64 128) (local c)))
        (binding scalar (type OwnedI64Cell) (call cell (local n)))
        (in (call product-independent::pair (types ByteBuffer OwnedI64Cell) (i64 7) (local d) (local scalar))))))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64))
      (returns (record (bytes Bytes) (scalar I64) (tag I64) (opaque I64)))
      (body (let
        (binding p (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (call factory (local n)))
        (binding tagged (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)))
          (call transform::retag (types ByteBuffer OwnedI64Cell) (i64 128) (local p)))
        (binding forwarded (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)))
          (call transform::forward (types (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (i64 8192) (local tagged)))
        (binding opaque (type I64) (call transform::reborrow (types (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (local forwarded)))
        (in (unpack-owned (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)))
          (local forwarded)
          (field left (binding bytes (type ByteBuffer))) (field right (binding scalar (type OwnedI64Cell)))
          (field tag (binding tag (type I64)))
          (in (record structural (field bytes (call freeze (local bytes))) (field scalar (call extract (local scalar)))
            (field tag (local tag)) (field opaque (local opaque)))))))))
    (function create nested (visibility public) (effect pure) (parameter create n (type I64)) (returns Bytes)
      (body (let
        (binding inner (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (call factory (local n)))
        (binding spare (type OwnedI64Cell) (call cell (i64 -257)))
        (binding outer (type (owned-product (field left (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (field right OwnedI64Cell) (field tag I64)))
          (call product-independent::pair (types (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)) OwnedI64Cell) (i64 9) (local inner) (local spare)))
        (binding retained (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)))
          (call product-independent::take-left (types (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64)) OwnedI64Cell) (local outer)))
        (binding bytes (type ByteBuffer) (call product-independent::take-left (types ByteBuffer OwnedI64Cell) (local retained)))
        (in (call freeze (local bytes))))))
    (function create abandoned (visibility public) (effect (task)) (returns Unit)
      (body (let
        (binding p (type (owned-product (field left ByteBuffer) (field right OwnedI64Cell) (field tag I64))) (call factory (i64 0)))
        (in (unit)))))
    (component create command (visibility private)
      (port create main (type (function (I64) (record (bytes Bytes) (scalar I64) (tag I64) (opaque I64)))) (function main)))
    (component create nested-command (visibility private)
      (port create nested (type (function (I64) Bytes)) (function nested))))
  (target create products (component consume::command) (runner command) (port consume::command::main))
  (target create products-nested (component consume::nested-command) (runner command) (port consume::nested-command::nested)))
declarations.end

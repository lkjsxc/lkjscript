declarations.begin
(units (module create native-bytes
  (external create from-list (visibility private) (implementation core.bytes.from-list)
    (parameter create values (type (list I64))) (returns Bytes))
  (external create from-text (visibility private) (implementation core.bytes.from-text)
    (parameter create text (type Text)) (returns Bytes))
  (external create integer-text (visibility private) (implementation core.i64.to-text)
    (parameter create value (type I64)) (returns Text))
  (external create length (visibility private) (implementation core.bytes.length)
    (parameter create data (type Bytes)) (returns I64))
  (external create get (visibility private) (implementation core.bytes.get)
    (parameter create data (type Bytes)) (parameter create index (type I64)) (returns I64))
  (external create equal (visibility private) (implementation core.bytes.equal)
    (parameter create left (type Bytes)) (parameter create right (type Bytes)) (returns Bool))
  (external create concat (visibility private) (implementation core.bytes.concat)
    (parameter create left (type Bytes)) (parameter create right (type Bytes)) (returns Bytes))
  (external create slice (visibility private) (implementation core.bytes.slice)
    (parameter create data (type Bytes)) (parameter create start (type I64))
    (parameter create end (type I64)) (returns Bytes))
  (external create copy (visibility private) (implementation core.bytes.copy)
    (parameter create data (type Bytes)) (returns Bytes))
  (external create empty-buffer (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
  (external create push-buffer (visibility private) (implementation core.buffer.push)
    (parameter create byte (type I64)) (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create get-buffer (visibility private) (implementation core.buffer.get)
    (parameter create index (type I64)) (parameter create b (type ByteBuffer) (use borrow)) (returns I64))
  (external create size-buffer (visibility private) (implementation core.buffer.length)
    (parameter create b (type ByteBuffer) (use borrow)) (returns I64))
  (external create freeze-buffer (visibility private) (implementation core.buffer.freeze)
    (parameter create b (type ByteBuffer) (use consume)) (returns Bytes))
  (external create discard-buffer (visibility private) (implementation core.buffer.discard)
    (parameter create b (type ByteBuffer) (use consume)) (returns Unit))
  (external create sub (visibility private) (implementation core.i64.subtract)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create less (visibility private) (implementation core.i64.less)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (function create build-buffer (visibility private) (effect pure)
    (parameter create n (type I64)) (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer)
    (body (if (call less (local n) (i64 1)) (local b)
      (let (binding next (type ByteBuffer) (call push-buffer (i64 255) (local b)))
        (in (call build-buffer (call sub (local n) (i64 1)) (local next)))))))
  (function create read-buffer (visibility private) (effect pure)
    (parameter create index (type I64)) (parameter create b (type ByteBuffer) (use borrow)) (returns I64)
    (body (sequence (call size-buffer (local b)) (call get-buffer (local index) (local b)))))
  (function create buffer-roundtrip (visibility public) (effect pure)
    (parameter create octet (type I64)) (returns I64)
    (body (let (binding b (type ByteBuffer) (call empty-buffer))
      (binding next (type ByteBuffer) (call push-buffer (local octet) (local b)))
      (in (call get (call freeze-buffer (local next)) (i64 0))))))
  (function create buffer-growth (visibility public) (effect pure)
    (parameter create n (type I64)) (parameter create index (type I64)) (returns I64)
    (body (let (binding b (type ByteBuffer) (call empty-buffer))
      (binding built (type ByteBuffer) (call build-buffer (local n) (local b)))
      (in (call read-buffer (local index) (local built))))))
  (function create buffer-size (visibility public) (effect pure)
    (parameter create n (type I64)) (returns I64)
    (body (let (binding b (type ByteBuffer) (call empty-buffer))
      (binding built (type ByteBuffer) (call build-buffer (local n) (local b)))
      (in (call length (call freeze-buffer (local built)))))))
  (function create buffer-discard (visibility public) (effect pure) (returns Unit)
    (body (let (binding b (type ByteBuffer) (call empty-buffer)) (in (call discard-buffer (local b))))))
  (function create octet (visibility public) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body (call get (call from-list (list I64 (local value))) (i64 0))))
  (function create index (visibility public) (effect pure)
    (parameter create index (type I64)) (returns I64)
    (body (call get (call from-list (list I64 (i64 0) (i64 128) (i64 255))) (local index))))
  (function create empty-length (visibility public) (effect pure) (returns I64)
    (body (call length (call from-list (list I64)))))
  (function create empty-index (visibility public) (effect pure) (returns I64)
    (body (call get (call from-list (list I64)) (i64 0))))
  (function create same-octets (visibility public) (effect pure) (returns Bool)
    (body (call equal (call from-list (list I64 (i64 0) (i64 128) (i64 255)))
      (call from-list (list I64 (i64 0) (i64 128) (i64 255))))))
  (function create different-octets (visibility public) (effect pure) (returns Bool)
    (body (call equal (call from-list (list I64 (i64 0) (i64 128) (i64 255)))
      (call from-list (list I64 (i64 0) (i64 129) (i64 255))))))
  (function create different-length (visibility public) (effect pure) (returns Bool)
    (body (call equal (call from-list (list I64 (i64 0))) (call from-list (list I64)))))
  (function create empty-equal (visibility public) (effect pure) (returns Bool)
    (body (call equal (call from-list (list I64)) (call from-list (list I64)))))
  (function create text-octets (visibility public) (effect pure)
    (parameter create index (type I64)) (returns I64)
    (body (call get (call from-text (text "\u{0}\n\"\\猫")) (local index))))
  (function create decimal-octets (visibility public) (effect pure)
    (parameter create value (type I64)) (parameter create index (type I64)) (returns I64)
    (body (call get (call from-text (call integer-text (local value))) (local index))))
  (function create decimal-length (visibility public) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body (call length (call from-text (call integer-text (local value))))))
  (function create range-length (visibility public) (effect pure)
    (parameter create start (type I64)) (parameter create end (type I64)) (returns I64)
    (body (call length (call slice (call from-list (list I64 (i64 0) (i64 128) (i64 255)))
      (local start) (local end)))))
  (function create copied-range (visibility public) (effect pure) (returns Bool)
    (body (call equal
      (call copy (call slice (call from-list (list I64 (i64 0) (i64 128) (i64 255))) (i64 1) (i64 3)))
      (call from-list (list I64 (i64 128) (i64 255))))))
  (function create concatenated (visibility public) (effect pure) (returns Bool)
    (body (let (binding prefix (call from-list (list I64 (i64 0) (i64 128))))
      (binding suffix (call from-list (list I64 (i64 255))))
      (in (call equal (call concat (local prefix) (local suffix))
        (call from-list (list I64 (i64 0) (i64 128) (i64 255))))))))
  (function create empty-concat (visibility public) (effect pure) (returns Bool)
    (body (let (binding empty (call from-list (list I64)))
      (binding value (call from-list (list I64 (i64 255))))
      (in (call equal (call concat (call concat (local empty) (local value)) (local empty)) (local value))))))
  (function create copied-empty (visibility public) (effect pure) (returns I64)
    (body (call length (call copy (call slice (call from-list (list I64 (i64 1))) (i64 1) (i64 1))))))
  (function create hash-length (visibility public) (effect pure) (returns I64)
    (body (call length (call digest (call from-list (list I64))))))
  (external create digest (visibility private) (implementation core.bytes.blake3)
    (parameter create data (type Bytes)) (returns Bytes))))
declarations.end

declarations.begin
(units
  (module create generic-parallel
    (external create create-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create extract-cell (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create transfer (visibility public) (effect (task))
      (type-parameter create T (constraint owned))
      (parameter create value (type T) (use consume)) (returns T)
      (body (local value)))
    (function create keep-list (visibility public) (effect (task))
      (type-parameter create Item)
      (parameter create values (type (list Item))) (returns (list Item))
      (body (local values)))
    (function create joined (visibility public) (effect (task))
      (parameter create n (type I64))
      (parameter create values (type (list I64)))
      (returns (record (scalar I64) (values (list I64))))
      (body (let
        (binding value (type OwnedI64Cell) (call create-cell (local n)))
        (binding pair
          (type (owned-product (field left OwnedI64Cell) (field right (list I64))))
          (parallel
            (call transfer (types OwnedI64Cell) (local value))
            (call keep-list (types I64) (local values))))
        (in (unpack-owned
          (type (owned-product (field left OwnedI64Cell) (field right (list I64))))
          (local pair)
          (field left (binding scalar (type OwnedI64Cell)))
          (field right (binding kept (type (list I64))))
          (in (record structural
            (field scalar (call extract-cell (local scalar)))
            (field values (local kept)))))))))))
declarations.end

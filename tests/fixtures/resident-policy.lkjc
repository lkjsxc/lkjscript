request base=BASE
declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (module create work
    (function create count (visibility private)
      (parameter create left (type I64)) (parameter create total (type I64))
      (returns I64) (effect pure)
      (body (if (call std::less (local left) (i64 1)) (local total)
        (call count (call std::subtract (local left) (i64 1))
          (call std::add (local total) (i64 1))))))
    (function create size (visibility private)
      (parameter create n (type I64)) (returns I64) (effect pure)
      (body (call count (local n) (i64 0))))
    (function create fill (visibility private)
      (parameter create left (type I64)) (parameter create items (type (list I64)))
      (returns (list I64)) (effect pure)
      (body (if (call std::less (local left) (i64 1)) (local items)
        (call fill (call std::subtract (local left) (i64 1))
          (call std::list-append (types I64) (local items) (local left))))))
    (function create reply (visibility private)
      (parameter create n (type I64)) (returns Response) (effect pure)
      (body (record structural
        (field status (i64 200))
        (field headers (list Header (record structural (field name (text "content-type"))
          (field value (call std::bytes-from-text (text "text/plain"))))))
        (field body (call std::json-encode (types I64) (local n))))))
    (function create health (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (i64 7))))
    (function create large (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (call size (i64 1000000)))))
    (function create collections (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (call std::list-length (types I64) (call fill (i64 100) (list I64))))))
    (function create deadline (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (call size (i64 1000000000000)))))
    (function create clock (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::clock)))
      (body (let
        (binding first (capability-call server::clock std::WallClock::utc-milliseconds))
        (binding second (capability-call server::clock std::WallClock::utc-milliseconds))
        (in (call reply (if (call std::i64-equal (local first) (local second)) (i64 1) (i64 2)))))))
    (component create server (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (requirement create clock (interface std::WallClock)
        (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 2 calls)))
      (port create health (type (task-function (Request) Response (row))) (function health))
      (port create large (type (task-function (Request) Response (row))) (function large))
      (port create collections (type (task-function (Request) Response (row))) (function collections))
      (port create deadline (type (task-function (Request) Response (row))) (function deadline))
      (port create clock (type (task-function (Request) Response (row (requirement clock)))) (function clock)))
    (component create console (visibility private)
      (port create count (type (function (I64) I64)) (function size)))
    (test create zero (visibility private) (actual (call size (i64 0))) (expected (i64 0)))
    (test create count-small (visibility private) (actual (call size (i64 32))) (expected (i64 32)))
    (test create collection-small (visibility private)
      (actual (call std::list-length (types I64) (call fill (i64 3) (list I64)))) (expected (i64 3))))
  (target create count (component work::console) (runner command) (port work::console::count))
  (target create web (component work::server) (runner http)
    (route create health (method GET) (path "/health") (port work::server::health))
    (route create large (method GET) (path "/large") (port work::server::large))
    (route create collections (method GET) (path "/collections") (port work::server::collections))
    (route create deadline (method GET) (path "/deadline") (port work::server::deadline))
    (route create clock (method GET) (path "/clock") (port work::server::clock))))
declarations.end

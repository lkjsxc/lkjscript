(function create step-with-policy (visibility private)
  (type-parameter create T (constraint capture-safe))
  (parameter create projection (type (function (T) (Marked I64))))
  (parameter create include_excluded (type Bool))
  (parameter create state (type Summary))
  (parameter create item (type T))
  (returns Summary) (effect pure)
  (body
    (match (invoke (local projection) (local item))
      (arm Marked::included (payload amount I64)
        (call add-included (local state) (local amount)))
      (arm Marked::excluded (payload amount I64)
        (if (local include_excluded)
          (call add-included (local state) (local amount))
          (local state))))))
(test create include-excluded (visibility private)
  (actual
    (call summarize (types (Marked I64))
      (record Batch (types (Marked I64))
        (field Batch::items
          (list (Marked I64)
            (variant Marked::included (types I64) (i64 3))
            (variant Marked::excluded (types I64) (i64 100))
            (variant Marked::included (types I64) (i64 -1)))))
      (function-value keep-marked) (bool true)))
  (expected (record Summary (field Summary::count (i64 3)) (field Summary::sum (i64 102)))))

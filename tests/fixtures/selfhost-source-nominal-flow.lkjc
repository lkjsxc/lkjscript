declarations.begin
(units (module create nominal-flow
  (variant create Tree (visibility public)
    (type-parameter create T)
    (case create stop)
    (case create leaf (payload T))
    (case create branch (payload (list (Tree T)))))
  (record create Swap (visibility public)
    (type-parameter create A) (type-parameter create B)
    (field create next (type (Swap B A))))
  (record create Dup (visibility public)
    (type-parameter create A)
    (field create next (type (Select A A))))
  (record create Select (visibility public)
    (type-parameter create A) (type-parameter create B)
    (field create next (type (Dup B))))
  (record create Reset (visibility public)
    (type-parameter create A)
    (field create next (type (Drop (list A) I64))))
  (record create Drop (visibility public)
    (type-parameter create A) (type-parameter create B)
    (field create next (type (Reset B))))
  (record create Closed (visibility public)
    (type-parameter create A)
    (field create next (type (Closed I64))))
  (record create Signature (visibility public)
    (type-parameter create A)
    (field create callback (type (function (I64) (Signature A)))))
  (record create Phantom (visibility public)
    (type-parameter create A)
    (field create marker (type I64)))
  (function create leaf (visibility public) (effect pure) (returns (Tree I64))
    (body (variant Tree::leaf (types I64) (i64 42))))))
declarations.end

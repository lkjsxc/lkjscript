          (types I64) (effects (row)) (requirements caller::cells)
          (static-text "preflight") (i64 100) (function-value trap)
          (list std::DataKeyPart (variant std::DataKeyPart::Text (text "credit"))))))
    (component create caller (visibility private)
      (requirement create cells (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::require-transaction)
        (limits (maximum_calls 20 calls)))
      (port create guard
        (type (task-function () I64 (row (requirement cells))))
        (function call-participant))))
  (target create guard (component guard::caller) (port guard::caller::guard) (runner command)))

declarations.begin
(units
  (use std pkg_10000000000000000000000000000001 package_revision_3b195535785762a7dcdec5df40080cd51e1abbb592bd2edfd2c26a05bcdd0a92)
  (module create guard
    (function create trap (visibility private)
      (parameter create value (type I64))
      (returns I64) (effect (task))
      (body (call std::divide (i64 1) (i64 0))))
    (function create call-participant (visibility private)
      (returns I64) (effect (task (requirement caller::cells)))
      (body

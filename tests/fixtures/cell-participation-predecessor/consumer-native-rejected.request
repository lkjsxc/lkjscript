reference.owner as=$try-update package=$library class=declaration name=try-update
declarations.begin
(units
  (use std builtin)
  (module create baseline (as $baseline)
    (function create subtract-thirty (visibility private)
      (parameter create value (type I64))
      (returns I64) (effect (task))
      (body (call std::add (local value) (i64 -30))))
    (function create raw-adjust (as $raw-adjust) (visibility private)
      (requirement-parameter create R (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put))
      (parameter create delta (type I64))
      (returns I64) (effect (task (requirement R)))
      (body
        (let
          (binding key (type (list std::DataKeyPart))
            (list std::DataKeyPart (variant std::DataKeyPart::Text (text "credit"))))
          (binding entries (type (list std::DataEntry))
            (capability-call R std::DataStore::get (static-text "baseline") (local key)))
          (binding absent (type Bool)
            (call std::i64-equal
              (call std::list-length (types std::DataEntry) (local entries)) (i64 0)))
          (binding previous (type I64)
            (if (local absent) (i64 100)
              (call std::data-decode-or (types I64)
                (field
                  (call std::list-get (types std::DataEntry) (local entries) (i64 0))
                  std::DataEntry::value)
                (i64 100))))
          (binding candidate (type I64) (call std::add (local previous) (local delta)))
          (binding matched (type Bool)
            (capability-call R std::DataStore::put (static-text "baseline") (local key)
              (call std::data-encode (types I64) (local candidate))
              (if (local absent)
                (variant std::DataExpectation::Missing)
                (variant std::DataExpectation::Exact
                  (field
                    (call std::list-get (types std::DataEntry) (local entries) (i64 0))
                    std::DataEntry::revision)))))
          (in (local candidate)))))
    (function create nested-owner (as $nested-owner) (visibility private)
      (returns (std::TransactionOutcome I64))
      (effect (task (requirement stores::data)))
      (body
        (transaction-outcome stores::data (types I64)
          (outcome std::TransactionOutcome std::TransactionAbortReason
            std::TransactionOutcome::Committed std::TransactionOutcome::Aborted
            std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
          (binding parent)
          (sequence
            (call $try-update (types I64) (effects (row)) (requirements stores::data)
              (static-text "baseline") (i64 100) (function-value subtract-thirty)
              (list std::DataKeyPart (variant std::DataKeyPart::Text (text "credit"))))
            (i64 0)))))
    (function create raw-owner (as $raw-owner) (visibility private)
      (returns (std::TransactionOutcome I64))
      (effect (task (requirement stores::data)))
      (body
        (transaction-outcome stores::data (types I64)
          (outcome std::TransactionOutcome std::TransactionAbortReason
            std::TransactionOutcome::Committed std::TransactionOutcome::Aborted
            std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
          (binding parent)
          (sequence
            (call raw-adjust (requirements stores::data) (i64 -30))
            (call raw-adjust (requirements stores::data) (i64 -10))))))
    (function create read-credit (as $read-credit) (visibility private)
      (returns (list I64)) (effect (task (requirement stores::data)))
      (body
        (let
          (binding entries (type (list std::DataEntry))
            (capability-call stores::data std::DataStore::get
              (static-text "baseline")
              (list std::DataKeyPart (variant std::DataKeyPart::Text (text "credit")))))
          (in
            (if
              (call std::i64-equal
                (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
              (list I64)
              (list I64
                (call std::data-decode-or (types I64)
                  (field
                    (call std::list-get (types std::DataEntry) (local entries) (i64 0))
                    std::DataEntry::value)
                  (i64 -999))))))))
    (component create stores (visibility private)
      (requirement create data (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::transaction)
        (limits (maximum_calls 100 calls)))
      (port create nested-owner
        (type (task-function () (std::TransactionOutcome I64) (row (requirement data))))
        (function nested-owner))
      (port create raw-owner
        (type (task-function () (std::TransactionOutcome I64) (row (requirement data))))
        (function raw-owner))
      (port create read-credit
        (type (task-function () (list I64) (row (requirement data))))
        (function read-credit))))
  (target create nested-owner (component baseline::stores)
    (port baseline::stores::nested-owner) (runner command))
  (target create raw-owner (component baseline::stores)
    (port baseline::stores::raw-owner) (runner command))
  (target create read-credit (component baseline::stores)
    (port baseline::stores::read-credit) (runner command)))
declarations.end

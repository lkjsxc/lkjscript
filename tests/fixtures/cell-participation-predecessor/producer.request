add.parameter as=$factory-space function=$factory name=space type=static-text
add.parameter as=$factory-default function=$factory name=default type=@FactoryT
add.parameter as=$factory-transform function=$factory name=transform type=@FactoryTransform
expression.block as=$factory-body
  (bind
    (function-value $update
      (types @FactoryT)
      (effects @FactoryE)
      (requirements parameter:$factory-R))
    (local $factory-space)
    (local $factory-default)
    (local $factory-transform))
expression.end

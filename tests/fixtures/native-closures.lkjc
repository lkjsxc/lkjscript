declarations.begin
(units (module create native-closures
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
  (external create sub (visibility private) (implementation core.i64.subtract)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
  (external create less (visibility private) (implementation core.i64.less)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns Bool))
  (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
  (external create size (visibility private) (implementation core.buffer.length)
    (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
  (function create borrowed-loop (visibility private) (effect pure)
    (parameter create remaining (type I64))
    (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64)
    (body (if (call less (local remaining) (i64 1)) (call size (local buffer))
      (call borrowed-loop (call sub (local remaining) (i64 1)) (local buffer)))))
  (function create borrowed (visibility public) (effect pure)
    (parameter create count (type I64)) (returns I64)
    (body (let (binding scratch (type ByteBuffer) (call empty))
      (in (call add (call borrowed-loop (local count) (local scratch))
        (call size (local scratch)))))))
  (function create indirect-even (visibility private) (effect pure)
    (parameter create remaining (type I64)) (parameter create total (type I64)) (returns I64)
    (body (if (call less (local remaining) (i64 1)) (local total)
      (invoke (bind (function-value indirect-odd) (call sub (local remaining) (i64 1)))
        (call add (local total) (i64 1)) (i64 7) (i64 9)))))
  (function create indirect-odd (visibility private) (effect pure)
    (parameter create remaining (type I64)) (parameter create total (type I64))
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64)
    (body (let (binding sum (call add (local left) (local right)))
      (in (if (call less (local remaining) (i64 1))
        (call add (local total) (call sub (local sum) (i64 16)))
        (invoke (bind (function-value indirect-even) (call sub (local remaining) (i64 1)))
          (call add (local total) (i64 1))))))))
  (function create direct-even (visibility private) (effect pure)
    (parameter create remaining (type I64)) (parameter create total (type I64)) (returns I64)
    (body (if (call less (local remaining) (i64 1)) (local total)
      (call direct-odd (call sub (local remaining) (i64 1))
        (call add (local total) (i64 1)) (i64 7) (i64 9)))))
  (function create direct-odd (visibility private) (effect pure)
    (parameter create remaining (type I64)) (parameter create total (type I64))
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64)
    (body (let (binding sum (call add (local left) (local right)))
      (in (if (call less (local remaining) (i64 1))
        (call add (local total) (call sub (local sum) (i64 16)))
        (call direct-even (call sub (local remaining) (i64 1))
          (call add (local total) (i64 1))))))))
  (function create indirect (visibility public) (effect pure)
    (parameter create count (type I64)) (returns I64)
    (body (call add (invoke (function-value indirect-even) (local count) (i64 0)) (i64 100))))
  (function create direct (visibility public) (effect pure)
    (parameter create count (type I64)) (returns I64)
    (body (call add (call direct-even (local count) (i64 0)) (i64 100))))
  (function create plus (visibility private) (effect pure)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64)
    (body (call add (local left) (local right))))
  (function create factory (visibility private) (effect pure) (returns (function (I64) I64))
    (body (bind (function-value plus) (i64 20))))
  (function create empty-unbound (visibility public) (effect pure) (returns I64)
    (body (invoke (bind (function-value plus)) (i64 20) (i64 22))))
  (function create empty-bound (visibility public) (effect pure) (returns I64)
    (body (invoke (bind (bind (function-value plus) (i64 20))) (i64 22))))
  (function create empty-factory (visibility public) (effect pure) (returns I64)
    (body (invoke (bind (call factory)) (i64 22))))
  (function create full (visibility public) (effect pure) (returns I64)
    (body (invoke (bind (function-value plus) (i64 20) (i64 22)))))
  (function create terminal-external (visibility public) (effect pure) (returns I64)
    (body (invoke (bind (function-value add) (i64 20)) (i64 22))))
  (function create held-invoke (visibility public) (effect pure) (returns I64)
    (body (let (binding scratch (type ByteBuffer) (call empty))
      (in (invoke (function-value plus) (i64 20) (i64 22))))))
  (function create held-call (visibility public) (effect pure) (returns I64)
    (body (let (binding scratch (type ByteBuffer) (call empty))
      (in (call plus (i64 20) (i64 22))))))))
declarations.end

declarations.begin
(units
  (module create source-interface-probe
    (function create failure (visibility private) (effect pure)
      (parameter create code (type I64))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (record structural (field diagnostic (local code))
        (field image (call ci::text-bytes (text ""))))))
    (function create encode (visibility private) (effect pure)
      (parameter create projected
        (type (record (code I64) (root Bytes) (digest Bytes) (owners Bytes) (types Bytes) (objects Bytes))))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (let
        (binding owners (field (local projected) (name owners)))
        (binding types (field (local projected) (name types)))
        (binding objects (field (local projected) (name objects)))
        (binding extent (call source-unit-tables::add (i64 136)
          (call source-unit-tables::add (call ci::length (local owners))
            (call source-unit-tables::add (call ci::length (local types)) (call ci::length (local objects))))))
        (in (if (call ci::lt (local extent) (i64 0))
          (call failure (i64 3))
          (let
            (binding a (type ByteBuffer) (call ci::empty))
            (binding b (type ByteBuffer)
              (call wire::range (call ci::text-bytes (text "LKJSIF01")) (i64 0) (i64 8) (local a)))
            (binding c (type ByteBuffer)
              (call wire::range (field (local projected) (name root)) (i64 0) (i64 72) (local b)))
            (binding d (type ByteBuffer)
              (call wire::range (field (local projected) (name digest)) (i64 0) (i64 32) (local c)))
            (binding e (type ByteBuffer) (call ci::le (call ci::length (local owners)) (i64 8) (local d)))
            (binding f (type ByteBuffer) (call ci::le (call ci::length (local types)) (i64 8) (local e)))
            (binding g (type ByteBuffer) (call ci::le (call ci::length (local objects)) (i64 8) (local f)))
            (binding h (type ByteBuffer)
              (call wire::range (local owners) (i64 0) (call ci::length (local owners)) (local g)))
            (binding i (type ByteBuffer)
              (call wire::range (local types) (i64 0) (call ci::length (local types)) (local h)))
            (binding j (type ByteBuffer)
              (call wire::range (local objects) (i64 0) (call ci::length (local objects)) (local i)))
            (in (record structural (field diagnostic (i64 0)) (field image (call ci::freeze (local j)))))))))))
    (function create admitted (visibility private) (effect pure)
      (parameter create graph (type Bytes)) (parameter create selector (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (let
        (binding prepared (call source-scalar::prepare (local graph)))
        (in (if (call ci::eq (field (local prepared) (name code)) (i64 0))
          (let (binding target (call source-table::owner (local graph) (local selector) (i64 0) (i64 12)))
            (in (if (call ci::lt (local target) (i64 0))
              (call failure (i64 19))
              (if (call ci::eq (call source-table::kind (local graph) (local target)) (i64 20))
                (let (binding projected (call source-interface::project (local graph)))
                  (in (if (call ci::eq (field (local projected) (name code)) (i64 0))
                    (call encode (local projected))
                    (call failure (field (local projected) (name code))))))
                (call failure (i64 19))))))
          (call failure (field (local prepared) (name code))))))))
    (function create inspect-interface (visibility public) (effect pure)
      (parameter create request (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (let (binding parsed (call source-request::read (local request)))
        (in (if (call ci::eq (field (local parsed) (name code)) (i64 0))
          (if (call ci::eq (field (local parsed) (name mode)) (i64 1))
            (call admitted (field (local parsed) (name graph)) (field (local parsed) (name target)))
            (call failure (i64 12)))
          (call failure (field (local parsed) (name code))))))))))
declarations.end

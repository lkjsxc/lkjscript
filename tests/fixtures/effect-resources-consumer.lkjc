declarations.begin
(units
  (use std builtin)
  (module create resource-consumer (as $consumer)
    (function create relay (visibility public)
      (type-parameter create U) (effect-parameter create E)
      (parameter create decode (type (task-function (Bytes) U (row (parameter E)))))
      (parameter create lease (type (resource std::DurableQueue))
        (use borrow) (requirement lib::queue::jobs))
      (returns U) (effect (task (requirement lib::queue::jobs) (parameter E)))
      (body (call lib::read-lease (types U) (effects (row (parameter E)))
        (local decode) (local lease))))
    (function create finish-here (visibility public)
      (type-parameter create V) (effect-parameter create E)
      (parameter create decode (type (task-function (Bytes) V (row (parameter E)))))
      (parameter create result (type Bytes))
      (parameter create lease (type (resource std::DurableQueue))
        (use consume) (requirement lib::queue::jobs))
      (returns V) (effect (task (requirement lib::queue::jobs) (parameter E)))
      (body (call lib::finish (types V) (effects (row (parameter E)))
        (local decode) (local result) (local lease))))
    (function create process (visibility private)
      (type-parameter create T)
      (parameter create job (type Text))
      (parameter create payload (type Bytes))
      (parameter create decode (type (task-function (Bytes) T (row (requirement app::audit)))))
      (parameter create absent (type T))
      (returns T) (effect (task (requirement lib::queue::jobs) (requirement app::audit)))
      (body (sequence
        (capability-call lib::queue::jobs std::DurableQueue::initialize)
        (capability-call lib::queue::jobs std::DurableQueue::enqueue
          (local job) (local job) (local payload) (i64 0) (i64 0))
        (match (capability-call lib::queue::jobs std::DurableQueue::claim
          (text "effect-worker") (i64 0) (i64 1000))
          (arm std::QueueLeaseState::live (payload lease (resource std::DurableQueue))
            (let
              (binding first (call relay (types T) (effects (row (requirement app::audit)))
                (local decode) (local lease)))
              (binding second (call lib::read-lease (types T) (effects (row (requirement app::audit)))
                (local decode) (local lease)))
              (in (call finish-here (types T) (effects (row (requirement app::audit)))
                (local decode) (local payload) (local lease)))))
          (arm std::QueueLeaseState::absent (local absent))))))
    (function create decode-numbers (visibility private)
      (parameter create payload (type Bytes)) (returns (list I64))
      (effect (task (requirement app::audit)))
      (body (sequence
        (capability-call app::audit std::DurableQueue::initialize)
        (capability-call app::audit std::DurableQueue::enqueue
          (text "numbers") (text "numbers") (local payload) (i64 0) (i64 0))
        (call std::data-decode-or (types (list I64)) (local payload) (list I64)))))
    (function create decode-text (visibility private)
      (parameter create payload (type Bytes)) (returns Text)
      (effect (task (requirement app::audit)))
      (body (sequence
        (capability-call app::audit std::DurableQueue::initialize)
        (capability-call app::audit std::DurableQueue::enqueue
          (text "text") (text "text") (local payload) (i64 0) (i64 0))
        (call std::data-decode-or (types Text) (local payload) (text "invalid")))))
    (function create numbers (visibility private)
      (returns (list I64)) (effect (task (requirement lib::queue::jobs) (requirement app::audit)))
      (body (call process (types (list I64)) (text "numbers")
        (call std::data-encode (types (list I64)) (list I64 (i64 7) (i64 42) (i64 -3)))
        (function-value decode-numbers) (list I64))))
    (function create text (visibility private)
      (returns Text) (effect (task (requirement lib::queue::jobs) (requirement app::audit)))
      (body (call process (types Text) (text "text")
        (call std::data-encode (types Text) (text "日本語 + generic"))
        (function-value decode-text) (text "absent"))))
    (component create app (visibility private)
      (requirement create audit (interface std::DurableQueue)
        (operations std::DurableQueue::initialize std::DurableQueue::enqueue)
        (limits (maximum_calls 64 calls)))
      (port create numbers
        (type (task-function () (list I64) (row (requirement lib::queue::jobs) (requirement audit))))
        (function numbers))
      (port create text
        (type (task-function () Text (row (requirement lib::queue::jobs) (requirement audit))))
        (function text))))
  (target create numbers (component resource-consumer::app) (runner command) (port resource-consumer::app::numbers))
  (target create text (component resource-consumer::app) (runner command) (port resource-consumer::app::text)))
declarations.end

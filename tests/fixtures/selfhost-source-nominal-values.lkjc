declarations.begin
(units
  (module create nominal-controls
    (external create add (visibility private) (implementation core.i64.add)
      (parameter create a (type I64))
      (parameter create b (type I64))
      (returns I64))
    (external create sub (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64))
      (parameter create b (type I64))
      (returns I64))
    (external create eq (visibility private) (implementation core.i64.equal)
      (parameter create a (type I64))
      (parameter create b (type I64))
      (returns Bool))
    (external create divide (visibility private) (implementation core.i64.divide)
      (parameter create a (type I64))
      (parameter create b (type I64))
      (returns I64))
    (external create empty (visibility private) (implementation core.buffer.empty)
      (returns ByteBuffer))
    (external create word (visibility private) (implementation core.buffer.append-i64-le)
      (parameter create value (type I64))
      (parameter create buffer (type ByteBuffer) (use consume))
      (returns ByteBuffer))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume))
      (returns Bytes))
    (external create size (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create discard (visibility private) (implementation core.buffer.discard)
      (parameter create buffer (type ByteBuffer) (use consume))
      (returns Unit))
    (external create read (visibility private) (implementation core.bytes.read-i64-le)
      (parameter create data (type Bytes))
      (parameter create index (type I64))
      (returns I64))
    (record create Point (visibility private)
      (field create left (type I64)) (field create right (type I64)))
    (record create OtherPoint (visibility private)
      (field create left (type I64)) (field create right (type I64)))
    (variant create Choice (visibility private)
      (case create none) (case create marker (payload Unit))
      (case create number (payload I64)) (case create point (payload Point))
      (case create thunk (payload (function () I64))))
    (variant create Outer (visibility private)
      (case create empty) (case create wrapped (payload Choice)))
    (record create Wrapper (visibility private)
      (field create value (type Outer)) (field create extra (type I64)))
    (function create word-buffer (visibility private) (effect pure)
      (parameter create value (type I64)) (returns ByteBuffer)
      (body
        (let
          (binding seed-buffer (type ByteBuffer) (call empty))
          (in (call word (local value) (local seed-buffer))))))
    (function create seed (visibility private) (effect pure)
      (returns I64)
      (body (i64 42)))
    (function create result (visibility private) (effect pure)
      (parameter create value (type I64))
      (returns I64)
      (body (local value)))
    (function create make-point-value (visibility private) (effect pure)
      (returns Point)
      (body (record Point (field Point::left (i64 7)) (field Point::right (i64 50)))))
    (function create point-score (visibility private) (effect pure)
      (parameter create point (type Point))
      (returns I64)
      (body (call sub (field (local point) Point::right) (field (local point) Point::left))))
    (function create point-plus (visibility private) (effect pure)
      (parameter create point (type Point))
      (parameter create bump (type I64))
      (returns I64)
      (body (call add (call point-score (local point)) (local bump))))
    (function create make-point (visibility private) (effect pure)
      (returns Choice)
      (body (variant Choice::point (call make-point-value))))
    (function create make-number (visibility private) (effect pure)
      (returns Choice)
      (body (variant Choice::number (call seed))))
    (function create choose (visibility private) (effect pure)
      (parameter create selector (type I64))
      (returns Choice)
      (body (if (call eq (local selector) (i64 0)) (variant Choice::none) (if (call eq (local selector) (i64 1)) (variant Choice::marker (unit)) (if (call eq (local selector) (i64 2)) (call make-number) (if (call eq (local selector) (i64 3)) (call make-point) (variant Choice::thunk (bind (function-value point-plus) (call make-point-value) (i64 4)))))))))
    (function create inspect (visibility private) (effect pure)
      (parameter create choice (type Choice))
      (returns I64)
      (body (match (local choice) (arm Choice::none (i64 7)) (arm Choice::marker (payload u Unit) (sequence (local u) (i64 11))) (arm Choice::number (payload n I64) (local n)) (arm Choice::point (payload p Point) (call point-score (local p))) (arm Choice::thunk (payload f (function () I64)) (invoke (local f))))))
    (function create nested (visibility private) (effect pure)
      (returns I64)
      (body (let (binding box (type Wrapper) (record Wrapper (field Wrapper::value (variant Outer::wrapped (call make-point))) (field Wrapper::extra (i64 3)))) (in (call add (match (field (local box) Wrapper::value) (arm Outer::empty (i64 -100)) (arm Outer::wrapped (payload choice Choice) (call inspect (local choice)))) (field (local box) Wrapper::extra))))))
    (function create closure-payload (visibility private) (effect pure)
      (returns I64)
      (body (let (binding p (type Point) (call make-point-value)) (binding f (type (function () I64)) (bind (function-value point-score) (local p))) (binding value (type Choice) (variant Choice::thunk (local f))) (in (call add (call inspect (local value)) (invoke (local f)))))))
    (function create closure-captures-variant (visibility private) (effect pure)
      (returns I64)
      (body (let (binding value (type Choice) (variant Choice::none)) (binding f (type (function () I64)) (bind (function-value inspect) (local value))) (in (call add (invoke (local f)) (invoke (local f)))))))
    (function create extract-closure (visibility private) (effect pure)
      (parameter create choice (type Choice))
      (returns (function () I64))
      (body (match (local choice) (arm Choice::none (function-value seed)) (arm Choice::marker (payload u Unit) (function-value seed)) (arm Choice::number (payload n I64) (bind (function-value result) (local n))) (arm Choice::point (payload p Point) (bind (function-value point-score) (local p))) (arm Choice::thunk (payload f (function () I64)) (local f)))))
    (function create returned-closure (visibility private) (effect pure)
      (returns I64)
      (body (invoke (call extract-closure (call make-point)))))
    (function create selected-only (visibility private) (effect pure)
      (returns I64)
      (body (match (variant Choice::none) (arm Choice::none (i64 7)) (arm Choice::marker (payload u Unit) (call divide (i64 1) (i64 0))) (arm Choice::number (payload n I64) (call divide (i64 1) (i64 0))) (arm Choice::point (payload p Point) (call divide (i64 1) (i64 0))) (arm Choice::thunk (payload f (function () I64)) (call divide (i64 1) (i64 0))))))
    (function create branch-repair (visibility private) (effect pure)
      (parameter create selector (type I64))
      (returns I64)
      (body (let (binding first (type ByteBuffer) (call word-buffer (i64 101))) (in (let (binding second (type ByteBuffer) (call word-buffer (i64 202))) (in (match (call choose (local selector)) (arm Choice::none (sequence (call discard (local first)) (i64 7))) (arm Choice::marker (payload u Unit) (sequence (call discard (local second)) (local u) (i64 11))) (arm Choice::number (payload n I64) (sequence (call discard (local second)) (call discard (local first)) (local n))) (arm Choice::point (payload p Point) (call point-score (local p))) (arm Choice::thunk (payload f (function () I64)) (sequence (call discard (local first)) (invoke (local f)))))))))))
    (function create live-buffer-match (visibility private) (effect pure)
      (parameter create selector (type I64))
      (returns I64)
      (body (let (binding first (type ByteBuffer) (call word-buffer (i64 303))) (in (let (binding second (type ByteBuffer) (call word-buffer (i64 404))) (in (match (call choose (local selector)) (arm Choice::none (call result (i64 7))) (arm Choice::marker (payload u Unit) (call result (sequence (local u) (i64 11)))) (arm Choice::number (payload n I64) (call result (local n))) (arm Choice::point (payload p Point) (call result (call point-score (local p)))) (arm Choice::thunk (payload f (function () I64)) (call result (invoke (local f)))))))))))
    (function create tail-clean (visibility private) (effect pure)
      (parameter create selector (type I64))
      (returns I64)
      (body (let (binding first (type ByteBuffer) (call empty)) (in (sequence (call discard (local first)) (match (call choose (local selector)) (arm Choice::none (call result (i64 7))) (arm Choice::marker (payload u Unit) (call result (sequence (local u) (i64 11)))) (arm Choice::number (payload n I64) (call result (local n))) (arm Choice::point (payload p Point) (call result (call point-score (local p)))) (arm Choice::thunk (payload f (function () I64)) (call result (invoke (local f))))))))))
    (function create select-buffer (visibility private) (effect pure)
      (parameter create selector (type I64))
      (parameter create left (type ByteBuffer) (use consume))
      (parameter create right (type ByteBuffer) (use consume))
      (returns ByteBuffer)
      (body
        (match (call choose (local selector))
          (arm Choice::none (local left))
          (arm Choice::marker (payload u Unit) (sequence (local u) (local right)))
          (arm Choice::number (payload n I64) (call word (local n) (local left)))
          (arm Choice::point (payload p Point) (call word (call point-score (local p)) (local right)))
          (arm Choice::thunk (payload f (function () I64)) (call word-buffer (invoke (local f)))))))
    (function create affine-match-output (visibility private) (effect pure)
      (parameter create selector (type I64)) (returns I64)
      (body
        (let
          (binding left (type ByteBuffer) (call word-buffer (i64 111)))
          (binding right (type ByteBuffer) (call word-buffer (i64 222)))
          (binding selected (type ByteBuffer) (call select-buffer (local selector) (local left) (local right)))
          (binding count (call size (local selected)))
          (binding frozen (call freeze (local selected)))
          (in
            (call add (local count)
              (call add (call read (local frozen) (i64 0))
                (call read (local frozen) (call sub (local count) (i64 8)))))))))
    (function create nested-match-output (visibility private) (effect pure)
      (parameter create selector (type I64)) (returns I64)
      (body
        (let
          (binding nested-first (type ByteBuffer) (call word-buffer (i64 303)))
          (binding nested-second (type ByteBuffer) (call word-buffer (i64 404)))
          (binding nested-survivor (type ByteBuffer) (call word-buffer (i64 505)))
          (binding answer
            (match
              (if (call eq (local selector) (i64 5))
                (variant Outer::empty)
                (variant Outer::wrapped (call choose (local selector))))
              (arm Outer::empty (sequence (call discard (local nested-first)) (i64 -100)))
              (arm Outer::wrapped (payload inner Choice)
                (match (local inner)
                  (arm Choice::none (sequence (call discard (local nested-first)) (i64 17)))
                  (arm Choice::marker (payload u Unit)
                    (sequence (call discard (local nested-second)) (local u) (i64 21)))
                  (arm Choice::number (payload n I64)
                    (sequence (call discard (local nested-second)) (call discard (local nested-first)) (local n)))
                  (arm Choice::point (payload p Point) (call point-score (local p)))
                  (arm Choice::thunk (payload f (function () I64))
                    (sequence (call discard (local nested-first)) (invoke (local f))))))))
          (in (call add (local answer) (call size (local nested-survivor)))))))
    (function create consume-size (visibility private) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns I64)
      (body (call size (local buffer))))
    (function create borrowed-match-output (visibility private) (effect pure)
      (parameter create selector (type I64)) (returns I64)
      (body
        (let
          (binding held (type ByteBuffer) (call word-buffer (i64 909)))
          (binding answer
            (call add (call size (local held))
              (match (call choose (local selector))
                (arm Choice::none (call add (call size (local held)) (i64 7)))
                (arm Choice::marker (payload u Unit)
                  (sequence (local u) (call add (call size (local held)) (i64 11))))
                (arm Choice::number (payload n I64) (call add (call size (local held)) (local n)))
                (arm Choice::point (payload p Point)
                  (call add (call size (local held)) (call point-score (local p))))
                (arm Choice::thunk (payload f (function () I64))
                  (call add (call size (local held)) (invoke (local f)))))))
          (binding after (call size (local held)))
          (in (call add (local answer) (local after))))))
    (function create other-entry (visibility public) (effect pure)
      (returns I64)
      (body (call sub (field (record OtherPoint (field OtherPoint::left (i64 9)) (field OtherPoint::right (i64 53))) OtherPoint::right) (i64 9))))
    (function create unused-point (visibility private) (effect pure)
      (returns Point)
      (body (record Point (field Point::left (i64 1)) (field Point::right (i64 2)))))
    (function create unused-number (visibility private) (effect pure)
      (returns Choice)
      (body (variant Choice::number (i64 3))))
    (function create unused-field (visibility private) (effect pure)
      (parameter create p (type Point))
      (returns I64)
      (body (field (local p) Point::left)))
    (function create unused-match (visibility private) (effect pure)
      (returns I64)
      (body (match (variant Choice::none) (arm Choice::none (i64 31)) (arm Choice::marker (payload u Unit) (i64 32)) (arm Choice::number (payload n I64) (i64 33)) (arm Choice::point (payload p Point) (i64 34)) (arm Choice::thunk (payload f (function () I64)) (i64 35)))))
    (function create entry (visibility private) (effect pure)
      (parameter create selector (type I64))
      (parameter create choice (type I64))
      (returns I64)
      (body (if (call eq (local selector) (i64 0)) (call inspect (call choose (i64 0))) (if (call eq (local selector) (i64 1)) (call inspect (call choose (i64 1))) (if (call eq (local selector) (i64 2)) (call inspect (call choose (i64 2))) (if (call eq (local selector) (i64 3)) (call inspect (call choose (i64 3))) (if (call eq (local selector) (i64 4)) (call inspect (call choose (i64 4))) (if (call eq (local selector) (i64 5)) (call nested) (if (call eq (local selector) (i64 6)) (call closure-payload) (if (call eq (local selector) (i64 7)) (call closure-captures-variant) (if (call eq (local selector) (i64 8)) (call returned-closure) (if (call eq (local selector) (i64 9)) (call selected-only) (if (call eq (local selector) (i64 10)) (call branch-repair (local choice)) (if (call eq (local selector) (i64 11)) (call live-buffer-match (local choice)) (if (call eq (local selector) (i64 12)) (call tail-clean (local choice)) (if (call eq (local selector) (i64 14)) (call affine-match-output (local choice)) (if (call eq (local selector) (i64 15)) (call nested-match-output (local choice)) (if (call eq (local selector) (i64 16)) (call borrowed-match-output (local choice)) (call other-entry)))))))))))))))))))
    (function create binary (visibility public) (effect pure)
      (parameter create data (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (record structural (field diagnostic (i64 0)) (field image (let (binding binary-output (type ByteBuffer) (call word-buffer (call entry (call read (local data) (i64 0)) (call read (local data) (i64 8))))) (in (call freeze (local binary-output))))))))
    (component create binary-app (visibility private)
      (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes)))) (function binary)))
    (component create other-app (visibility private)
      (port create run (type (function () I64)) (function other-entry))))
  (target create nominal-binary (component nominal-controls::binary-app)
    (runner command) (port nominal-controls::binary-app::run))
  (target create nominal-other (component nominal-controls::other-app)
    (runner command) (port nominal-controls::other-app::run)))
declarations.end

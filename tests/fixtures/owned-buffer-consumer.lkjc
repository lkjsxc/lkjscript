declarations.begin
(units
  (use std builtin)
  (use producer PRODUCER_PACKAGE PRODUCER_PACKAGE_REVISION)
  (use transformer TRANSFORMER_PACKAGE TRANSFORMER_PACKAGE_REVISION)
  (module create destination
    (function create identity (visibility private) (parameter create n (type I64))
      (returns I64) (effect pure) (body (local n)))
    (function create encode-flag (visibility private) (parameter create flag (type Bool))
      (returns I64) (effect pure) (body (if (local flag) (i64 128) (i64 255))))
    (function create decode-flag (visibility private) (parameter create n (type I64))
      (returns Bool) (effect pure) (body (call std::i64-equal (local n) (i64 128))))
    (function create consume-data (visibility public)
      (type-parameter create R)
      (parameter create decode (type (function (I64) R)))
      (parameter create b (type ByteBuffer) (use borrow)) (returns R) (effect pure)
      (body (invoke (local decode) (call std::buffer-get (i64 2) (local b)))))
    (function create main (visibility private) (returns Bytes) (effect pure)
      (body (let
        (binding first (type ByteBuffer) (call producer::produce (types I64) (i64 0) (function-value identity)))
        (binding second (type ByteBuffer) (call transformer::append (types I64) (i64 255) (function-value identity) (local first)))
        (binding third (type ByteBuffer) (call transformer::append (types I64) (i64 128) (function-value identity) (local second)))
        (binding observed (call consume-data (types I64) (function-value identity) (local third)))
        (in (call std::buffer-freeze (local third))))))
    (test create borrowed-callback (visibility private)
      (actual (let
        (binding first (type ByteBuffer) (call transformer::relay (types I64) (i64 0) (function-value identity)))
        (binding second (type ByteBuffer) (call transformer::append (types I64) (i64 255) (function-value identity) (local first)))
        (binding third (type ByteBuffer) (call transformer::append (types I64) (i64 128) (function-value identity) (local second)))
        (in (call consume-data (types I64) (function-value identity) (local third)))))
      (expected (i64 128)))
    (test create exact-binary (visibility private)
      (actual (call main))
      (expected (call std::bytes-from-list (list I64 (i64 0) (i64 255) (i64 128)))))
    (test create generic-boolean-roundtrip (visibility private)
      (actual (let
        (binding first (type ByteBuffer) (call producer::produce (types Bool) (bool false) (function-value encode-flag)))
        (binding second (type ByteBuffer) (call transformer::append (types Bool) (bool false) (function-value encode-flag) (local first)))
        (binding third (type ByteBuffer) (call transformer::append (types Bool) (bool true) (function-value encode-flag) (local second)))
        (in (call consume-data (types Bool) (function-value decode-flag) (local third)))))
      (expected (bool true)))
    (component create console (visibility private)
      (port create main (type (function () Bytes)) (function main))))
  (target create memory (component destination::console) (runner command) (port destination::console::main)))
declarations.end

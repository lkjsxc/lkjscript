declarations.begin
(units
  (module create choices
    (external create cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create extract (visibility private) (implementation core.cell.extract)
      (parameter create c (type OwnedI64Cell) (use consume)) (returns I64))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create octet (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
    (external create length (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (function create route (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create left (type Bool))
      (parameter create payload (type T) (use consume))
      (returns (owned-choice (case left T) (case right T)))
      (body (if (local left)
        (choose-owned (type (owned-choice (case left T) (case right T))) (case left) (local payload))
        (choose-owned (type (owned-choice (case left T) (case right T))) (case right) (local payload)))))
    (function create restore (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create choice (type (owned-choice (case left T) (case right T))) (use consume))
      (returns T)
      (body (match-owned (type (owned-choice (case left T) (case right T))) (local choice)
        (case left (binding value (type T)) (in (local value)))
        (case right (binding value (type T)) (in (local value))))))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create inner (type Bool)) (parameter create outer (type Bool))
      (returns I64)
      (body (let
        (binding c (type OwnedI64Cell) (call cell (local n)))
        (binding routed (type (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell)))
          (call route (types OwnedI64Cell) (local inner) (local c)))
        (binding packet (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64)))
          (pack-owned (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (field tag (i64 7)) (field outcome (local routed))))
        (binding envelope (type (owned-choice (case left (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (case right (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64)))))
          (call route (types (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (local outer) (local packet)))
        (binding restored (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64)))
          (call restore (types (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (local envelope)))
        (in (unpack-owned (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (local restored)
          (field outcome (binding result (type (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell)))))
          (field tag (binding tag (type I64)))
          (in (let
            (binding data (type OwnedI64Cell) (call restore (types OwnedI64Cell) (local result)))
            (in (call extract (local data))))))))))
    (function create bytes (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create left (type Bool)) (returns Bytes)
      (body (let
        (binding e (type ByteBuffer) (call empty))
        (binding b (type ByteBuffer) (call push (local n) (local e)))
        (binding routed (type (owned-choice (case left ByteBuffer) (case right ByteBuffer)))
          (call route (types ByteBuffer) (local left) (local b)))
        (binding restored (type ByteBuffer) (call restore (types ByteBuffer) (local routed)))
        (in (call freeze (local restored))))))
    (function create abandoned (visibility public) (effect pure) (returns Unit)
      (body (let
        (binding c (type OwnedI64Cell) (call cell (i64 42)))
        (binding routed (type (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell)))
          (call route (types OwnedI64Cell) (bool false) (local c)))
        (binding packet (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64)))
          (pack-owned (type (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (field tag (i64 7)) (field outcome (local routed))))
        (binding envelope (type (owned-choice (case left (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (case right (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64)))))
          (call route (types (owned-product (field outcome (owned-choice (case left OwnedI64Cell) (case right OwnedI64Cell))) (field tag I64))) (bool true) (local packet)))
        (in (unit)))))
    (function create accepted (visibility public) (effect pure) (returns I64)
      (body (let
        (binding result (type (owned-choice (case accepted Unit) (case rejected ByteBuffer)))
          (choose-owned (type (owned-choice (case accepted Unit) (case rejected ByteBuffer)))
            (case accepted) (unit)))
        (in (match-owned (type (owned-choice (case accepted Unit) (case rejected ByteBuffer))) (local result)
          (case accepted (binding value (type Unit)) (in (i64 42)))
          (case rejected (binding buffer (type ByteBuffer)) (in (call length (local buffer)))))))))
    (test create route-left (visibility private)
      (actual (call main (i64 42) (bool true) (bool false))) (expected (i64 42)))
    (test create route-right (visibility private)
      (actual (call main (i64 -128) (bool false) (bool true))) (expected (i64 -128)))
    (test create success-without-owned-payload (visibility private)
      (actual (call accepted)) (expected (i64 42)))))
declarations.end

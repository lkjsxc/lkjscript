request base=BASE
declarations.begin
(units
  (use std builtin)
  (module create terminal-values
    (variant create Envelope (visibility public)
      (case create leaf (payload Text))
      (case create wrap (payload Envelope)))
    (record create Pair (visibility public)
      (type-parameter create T)
      (field create first (type T))
      (field create second (type T)))
    (function create keep (visibility private)
      (type-parameter create T)
      (parameter create value (type T))
      (returns T) (effect pure) (body (local value)))
    (function create step (visibility private)
      (parameter create marker (type Text))
      (parameter create state (type Envelope))
      (parameter create ignored (type I64))
      (returns Envelope) (effect pure)
      (body (call keep (types Envelope) (local state))))
    (function create duplicate (visibility public)
      (parameter create direct (type Bool))
      (parameter create value (type Envelope))
      (returns (Pair Envelope)) (effect pure)
      (body
        (record Pair (types Envelope)
          (field Pair::first (call keep (types Envelope) (local value)))
          (field Pair::second
            (if (local direct)
              (call keep (types Envelope) (local value))
              (call std::list-fold-left (types I64 Envelope)
                (list I64 (i64 0) (i64 1) (i64 2) (i64 3))
                (local value)
                (bind (function-value step) (text "retained capture"))))))))
    (test create direct (visibility private)
      (actual (call duplicate (bool true)
        (variant Envelope::wrap (variant Envelope::leaf (text "猫")))))
      (expected (record Pair (types Envelope)
        (field Pair::first (variant Envelope::wrap (variant Envelope::leaf (text "猫"))))
        (field Pair::second (variant Envelope::wrap (variant Envelope::leaf (text "猫")))))))
    (test create iterated (visibility private)
      (actual (call duplicate (bool false)
        (variant Envelope::wrap (variant Envelope::leaf (text "猫")))))
      (expected (record Pair (types Envelope)
        (field Pair::first (variant Envelope::wrap (variant Envelope::leaf (text "猫"))))
        (field Pair::second (variant Envelope::wrap (variant Envelope::leaf (text "猫")))))))
    (component create command (visibility private)
      (port create main (type (function (Bool Envelope) (Pair Envelope))) (function duplicate))))
  (target create duplicate (component terminal-values::command) (runner command)
    (port terminal-values::command::main)))
declarations.end

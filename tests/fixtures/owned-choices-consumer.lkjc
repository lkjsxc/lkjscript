declarations.begin
(units
  (module create choice-consumer
    (function create marker (visibility public) (effect pure) (returns I64)
      (body (let
        (binding result (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (choose-owned (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
            (case accepted) (i64 41)))
        (in (match-owned (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell))) (local result)
          (case accepted (binding value (type I64)) (in (local value)))
          (case rejected (binding value (type OwnedI64Cell)) (in (call cell::read (local value)))))))))
    (function create main (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create accepted (type Bool))
      (returns (record (value I64) (alternate I64) (bytes I64) (nested I64) (marker I64) (witness (record (scalar I64) (alternate I64) (skipped I64)))))
      (body (let
        (binding c (type OwnedI64Cell) (call cell::create (local n)))
        (binding result (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (implementation-call outcomes::attempt (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local accepted) (local c)))
        (binding value (type I64)
          (implementation-call outcomes::recover (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local result)))
        (binding c (type OwnedI64Cell) (call cell::create (local n)))
        (binding alternate (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (implementation-call outcomes::attempt (types OwnedI64Cell)
            (implementations concrete@cell::Alternate) (local accepted) (local c)))
        (binding alternate (type I64)
          (implementation-call outcomes::recover (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local alternate)))
        (binding b (type ByteBuffer) (call buffer::create (i64 128)))
        (binding octets (type (owned-choice (case accepted I64) (case rejected ByteBuffer)))
          (implementation-call outcomes::attempt (types ByteBuffer)
            (implementations concrete@buffer::Octets) (local accepted) (local b)))
        (binding bytes (type I64)
          (implementation-call outcomes::recover (types ByteBuffer)
            (implementations concrete@buffer::Octets) (local octets)))
        (in (record structural
          (field value (local value)) (field alternate (local alternate))
          (field bytes (local bytes))
          (field nested (call choices::main (local n) (local accepted) (local accepted)))
          (field witness (call witness::selected (local n) (local accepted)))
          (field marker (call marker)))))))
    (test create rejected (visibility private)
      (actual (call main (i64 -257) (bool false)))
      (expected (record structural
        (field value (i64 -257)) (field alternate (i64 -257)) (field bytes (i64 1))
        (field witness (record structural (field scalar (i64 -257)) (field alternate (i64 99)) (field skipped (i64 7))))
        (field nested (i64 -257)) (field marker (i64 41)))))
    (test create accepted (visibility private)
      (actual (call main (i64 257) (bool true)))
      (expected (record structural
        (field value (i64 257)) (field alternate (i64 99)) (field bytes (i64 1))
        (field witness (record structural (field scalar (i64 257)) (field alternate (i64 99)) (field skipped (i64 7))))
        (field nested (i64 257)) (field marker (i64 41)))))
    (component create command (visibility private)
      (port create main
        (type (function (I64 Bool) (record (value I64) (alternate I64) (bytes I64) (nested I64) (marker I64) (witness (record (scalar I64) (alternate I64) (skipped I64))))))
        (function main))))
  (target create owned-outcomes (component choice-consumer::command) (runner command) (port choice-consumer::command::main)))
declarations.end

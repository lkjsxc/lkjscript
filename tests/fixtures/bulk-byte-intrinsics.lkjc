declarations.begin
(units (module create bulk-bytes
  (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
  (external create push (visibility private) (implementation core.buffer.push)
    (parameter create byte (type I64)) (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create append (visibility private) (implementation core.buffer.append-slice)
    (parameter create input (type Bytes)) (parameter create start (type I64)) (parameter create end (type I64))
    (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create word (visibility private) (implementation core.buffer.append-i64-le)
    (parameter create value (type I64)) (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create read (visibility private) (implementation core.bytes.read-i64-le)
    (parameter create input (type Bytes)) (parameter create start (type I64)) (returns I64))
  (external create freeze (visibility private) (implementation core.buffer.freeze)
    (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
  (external create length (visibility private) (implementation core.bytes.length)
    (parameter create input (type Bytes)) (returns I64))
  (external create octets (visibility private) (implementation core.bytes.from-list)
    (parameter create input (type (list I64))) (returns Bytes))
  (function create range (visibility public) (effect pure)
    (parameter create input (type Bytes)) (parameter create start (type I64)) (parameter create end (type I64))
    (returns Bytes)
    (body (let (binding a (type ByteBuffer) (call empty))
      (binding b (type ByteBuffer) (call push (i64 173) (local a)))
      (binding c (type ByteBuffer) (call append (local input) (local start) (local end) (local b)))
      (in (call freeze (local c))))))
  (function create unaligned (visibility public) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body (let (binding a (type ByteBuffer) (call empty))
      (binding b (type ByteBuffer) (call push (i64 173) (local a)))
      (binding c (type ByteBuffer) (call word (local value) (local b)))
      (binding bytes (call freeze (local c))) (in (call read (local bytes) (i64 1))))))
  (function create binary (visibility public) (effect pure)
    (parameter create input (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (let (binding a (type ByteBuffer) (call empty))
      (binding b (type ByteBuffer) (call word (i64 -9223372036854775808) (local a)))
      (binding c (type ByteBuffer) (call append (local input) (i64 0) (call length (local input)) (local b)))
      (binding d (type ByteBuffer) (call append (local input) (call length (local input)) (call length (local input)) (local c)))
      (binding e (type ByteBuffer) (call word (i64 9223372036854775807) (local d)))
      (in (record structural (field diagnostic (i64 0)) (field image (call freeze (local e))))))))
  (function create minimum (visibility public) (effect pure) (returns I64) (body (call unaligned (i64 -9223372036854775808))))
  (function create negative (visibility public) (effect pure) (returns I64) (body (call unaligned (i64 -1))))
  (function create zero (visibility public) (effect pure) (returns I64) (body (call unaligned (i64 0))))
  (function create positive (visibility public) (effect pure) (returns I64) (body (call unaligned (i64 72623859790382856))))
  (function create maximum (visibility public) (effect pure) (returns I64) (body (call unaligned (i64 9223372036854775807))))
  (function create negative-start (visibility public) (effect pure) (returns I64) (body (call length (call range (call octets (list I64 (i64 0) (i64 255))) (i64 -1) (i64 1)))))
  (function create reversed (visibility public) (effect pure) (returns I64) (body (call length (call range (call octets (list I64 (i64 0) (i64 255))) (i64 2) (i64 1)))))
  (function create beyond-end (visibility public) (effect pure) (returns I64) (body (call length (call range (call octets (list I64 (i64 0) (i64 255))) (i64 0) (i64 3)))))
  (function create maximum-start (visibility public) (effect pure) (returns I64) (body (call length (call range (call octets (list I64 (i64 0) (i64 255))) (i64 9223372036854775807) (i64 9223372036854775807)))))
  (function create word-negative (visibility public) (effect pure) (returns I64) (body (call read (call octets (list I64 (i64 0) (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7))) (i64 -1))))
  (function create word-truncated (visibility public) (effect pure) (returns I64) (body (call read (call octets (list I64 (i64 0) (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7))) (i64 1))))
  (function create word-overflow (visibility public) (effect pure) (returns I64) (body (call read (call octets (list I64 (i64 0) (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7))) (i64 9223372036854775807))))
  (component create app-minimum (visibility public) (port create run (type (function () I64)) (function minimum)))
  (component create app-negative (visibility public) (port create run (type (function () I64)) (function negative)))
  (component create app-zero (visibility public) (port create run (type (function () I64)) (function zero)))

  (component create app-word-truncated (visibility public) (port create run (type (function () I64)) (function word-truncated)))
  (component create app-word-overflow (visibility public) (port create run (type (function () I64)) (function word-overflow)))
  (component create app-binary (visibility public) (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes)))) (function binary))))

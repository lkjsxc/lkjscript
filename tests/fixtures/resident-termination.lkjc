request base=BASE
declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (type-alias Decision (record (closing (option std::SessionClose))
    (kind std::SessionDecisionKind) (messages (list std::SessionOutbound))
    (rejection (option std::SessionReject)) (state (option Unit))))
  (type-alias Open (record (headers (list Header)) (path Text) (query Text)))
  (type-alias Message (record (body (stream Bytes)) (kind std::SessionMessageKind)))
  (type-alias PeerClose (record (code (option I64)) (reason Text)))
  (module create termination
    (function create spin (visibility private) (returns I64) (effect pure)
      (body (call spin)))
    (function create reply (visibility private)
      (parameter create value (type I64)) (returns Response) (effect pure)
      (body (record structural (field status (i64 200)) (field headers (list Header))
        (field body (call std::json-encode (types I64) (local value))))))
    (function create health (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (i64 7))))
    (function create busy (visibility private)
      (parameter create request (type Request)) (returns Response) (effect (task))
      (body (call reply (call spin))))
    (function create idle (visibility private) (returns Bool) (effect (task))
      (body (bool false)))
    (function create decision (visibility private)
      (parameter create kind (type std::SessionDecisionKind))
      (parameter create state (type (option Unit))) (returns Decision) (effect pure)
      (body (record structural
        (field closing (call std::option-none (types std::SessionClose)))
        (field kind (local kind)) (field messages (list std::SessionOutbound))
        (field rejection (call std::option-none (types std::SessionReject)))
        (field state (local state)))))
    (function create transition (visibility private)
      (parameter create state (type (option Unit)))
      (parameter create event (type std::SessionEvent))
      (returns Decision) (effect (task (requirement service::streams)))
      (body (match (local event)
        (arm std::SessionEvent::open (payload open Open)
          (call decision (variant std::SessionDecisionKind::accept)
            (call std::option-some (types Unit) (unit))))
        (arm std::SessionEvent::message (payload message Message)
          (call decision (variant std::SessionDecisionKind::continue) (local state)))
        (arm std::SessionEvent::tick
          (call decision (variant std::SessionDecisionKind::continue) (local state)))
        (arm std::SessionEvent::peer-close (payload peer PeerClose)
          (call decision (variant std::SessionDecisionKind::finish)
            (call std::option-none (types Unit))))
        (arm std::SessionEvent::shutdown
          (call decision (variant std::SessionDecisionKind::finish)
            (call std::option-none (types Unit)))))))
    (component create service (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 4 calls)))
      (port create health (type (task-function (Request) Response (row))) (function health))
      (port create busy (type (task-function (Request) Response (row))) (function busy))
      (port create idle (type (task-function () Bool (row))) (function idle))
      (port create live
        (type (task-function ((option Unit) std::SessionEvent) Decision
          (row (requirement streams)))) (function transition))))
  (target create termination-http (component termination::service) (runner http)
    (route create health (method GET) (path "/health") (port termination::service::health))
    (route create busy (method GET) (path "/busy") (port termination::service::busy)))
  (target create termination-worker (component termination::service)
    (runner worker) (port termination::service::idle))
  (target create termination-live (component termination::service)
    (runner interactive) (port termination::service::live)))
declarations.end

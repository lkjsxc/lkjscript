pub fn probe() -> i64 { 37i64 }
pub fn child(mut root: ReadDirectory, mut output: Stdout, mut environment: Environment,
    mut endpoint: Connector, mut arguments: Arguments, mut clock: Clock, mut entropy: Entropy,
    mut status: ExitStatus) -> i64 {
    let mut file = root.open("inside.txt").unwrap();
    assert_eq!(file.read_to_end().unwrap().as_slice(), b"inside\n");
    assert!(root.open("../outside.txt").is_err());
    assert_eq!(environment.get().unwrap().as_slice(), b"packet-value");
    let values = arguments.args();
    assert_eq!(values.len(), 1usize);
    assert_eq!(values[0].as_slice(), b"explicit");
    assert!(clock.nanoseconds().is_ok());
    let mut random = [0u8; 8]; entropy.fill(&mut random).unwrap();
    status.set_status(0u8);
    output.write(b"ok transferred child\n");
    37i64
}

pub fn descriptors(mut root: Directory, mut read: ReadFile, mut file: File,
    mut incoming: Listener, mut ready: Readiness, sink: NullDevice,
    mut input: Stdin, mut errors: Stderr, mut clock: Clock) -> i64 {
    assert_eq!(read.read_to_end().unwrap().as_slice(), b"inside\n");
    assert_eq!(file.read_to_end().unwrap().as_slice(), b"inside\n");
    let mut created = root.create("created.txt").unwrap(); created.write_all(b"created").unwrap();
    incoming.set_nonblocking(true).unwrap();
    ready.watch_listener(&mut incoming, 0usize).unwrap();
    let _events = ready.wait(&mut clock, 0usize);
    ready.unwatch_listener(&mut incoming).unwrap();
    let mut bytes = [0u8; 1]; assert_eq!(input.read(&mut bytes).unwrap(), 0usize);
    errors.write(b"ok transferred descriptors\n"); drop(sink);
    37i64
}
pub fn proc_probe(mut root: ReadDirectory) -> i64 {
    let names = root.list().unwrap();
    for name in &names {
        assert!(name.as_slice() == b"3" || name.as_slice() == b"4" || name.as_slice() == b"8");
    }
    // list() owns one fresh directory descriptor, promoted to fd4.
    assert_eq!(names.len(), 3usize);
    37i64
}

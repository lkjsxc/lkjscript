lkjscript-ir 1
# expect: check
# authority-reject: E_ENTRY; duplicate grant parameter name output
type "()" unit
type "bool" bool
type "i32" int 32 signed
type "i64" int 64 signed
type "usize" int 64 unsigned
type "u8" int 8 unsigned
type "f64" f64
type "Stdout" stdout
fn "main" 2 0
local "output" 7 let
local "output" 7 let
local "done" 0 let
@1 drop 0
@2 drop 1
@3 unit 2
@4 return 2
endfn

lkjscript-ir 1
# expect: check
# Entry APIs validate the whole grant list before any acquisition.
type "()" unit
type "bool" bool
type "i32" int 32 signed
type "i64" int 64 signed
type "usize" int 64 unsigned
type "u8" int 8 unsigned
type "f64" f64
type "Directory" directory
type "Listener" listener
fn "main" 2 0
local "root" 7 let
local "incoming" 8 let
local "done" 0 let
@1 drop 0
@2 drop 1
@3 unit 2
@4 return 2
endfn
fn "listener" 1 0
local "incoming" 8 let
local "done" 0 let
@10 drop 0
@11 unit 1
@12 return 1
endfn
fn "capability_result" 1 7
local "root" 7 let
@20 return 0
endfn

declarations.begin
(units (module create sequence-tail
  (type-alias Cells (owned-sequence OwnedI64Cell))
  (type-alias CellItem (owned-product (field rest Cells) (field value OwnedI64Cell)))
  (type-alias CellPop (owned-choice (case empty Cells) (case item CellItem)))
  (type-alias Nested (owned-sequence Cells))
  (type-alias NestedItem (owned-product (field rest Nested) (field value Cells)))
  (type-alias NestedPop (owned-choice (case empty Nested) (case item NestedItem)))
  (external create cell (visibility private) (implementation core.cell.create)
    (parameter create n (type I64)) (returns OwnedI64Cell))
  (external create read (visibility private) (implementation core.cell.read)
    (parameter create c (type OwnedI64Cell) (use borrow)) (returns I64))
  (external create finish (visibility private) (implementation core.cell.extract)
    (parameter create c (type OwnedI64Cell) (use consume)) (returns I64))
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create less (visibility private) (implementation core.i64.less)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (external create append (visibility private) (implementation core.list.append)
    (parameter create values (type (list I64))) (parameter create value (type I64))
    (returns (list I64)))
  (function create build-loop (visibility private) (effect pure)
    (parameter create index (type I64)) (parameter create count (type I64))
    (parameter create values (type Cells) (use consume)) (returns Cells)
    (body (if (call less (local index) (local count))
      (let
        (binding value (type OwnedI64Cell) (call cell (local index)))
        (binding next (type Cells) (sequence-push (type Cells) (local value) (local values)))
        (in (call build-loop (call add (local index) (i64 1)) (local count) (local next))))
      (local values))))
  (function create summarize-loop (visibility private) (effect pure)
    (parameter create index (type I64)) (parameter create total (type I64))
    (parameter create values (type Cells) (use borrow)) (returns I64)
    (body (if (call less (local index) (sequence-length (type Cells) (local values)))
      (let
        (binding observed (type I64)
          (borrow-owned-item (type Cells) (local values)
            (index (local index)) (binding view (type OwnedI64Cell))
            (in (call read (local view)))))
        (in (call summarize-loop (call add (local index) (i64 1))
          (call add (local total) (local observed)) (local values))))
      (local total))))
  (function create drain-loop (visibility private) (effect pure)
    (parameter create finished (type (list I64)))
    (parameter create values (type Cells) (use consume)) (returns (list I64))
    (body (let
      (binding outcome (type CellPop) (sequence-pop (type Cells) (local values)))
      (in (match-owned (type CellPop) (local outcome)
        (case empty (binding rest (type Cells)) (in (local finished)))
        (case item (binding item (type CellItem))
          (in (unpack-owned (type CellItem) (local item)
            (field rest (binding rest (type Cells)))
            (field value (binding value (type OwnedI64Cell)))
            (in (let (binding n (type I64) (call finish (local value)))
              (in (call drain-loop (call append (local finished) (local n)) (local rest)))))))))))))
  (function create main (visibility public) (effect pure)
    (parameter create requested (type I64))
    (returns (record (count I64) (sum I64) (values (list I64))))
    (body (let
      (binding empty (type Cells) (sequence-empty (type Cells)))
      (binding values (type Cells) (call build-loop (i64 0) (local requested) (local empty)))
      (binding count (type I64) (sequence-length (type Cells) (local values)))
      (binding outer-empty (type Nested) (sequence-empty (type Nested)))
      (binding outer (type Nested) (sequence-push (type Nested) (local values) (local outer-empty)))
      (binding sum (type I64)
        (borrow-owned-item (type Nested) (local outer)
          (index (i64 0)) (binding inner (type Cells))
          (in (call summarize-loop (i64 0) (i64 0) (local inner)))))
      (binding outcome (type NestedPop) (sequence-pop (type Nested) (local outer)))
      (binding values (type Cells)
        (match-owned (type NestedPop) (local outcome)
          (case empty (binding rest (type Nested)) (in (sequence-empty (type Cells))))
          (case item (binding item (type NestedItem))
            (in (unpack-owned (type NestedItem) (local item)
              (field rest (binding rest (type Nested))) (field value (binding inner (type Cells)))
              (in (local inner)))))))
      (binding drained (type (list I64)) (call drain-loop (list I64) (local values)))
      (in (record structural (field count (local count)) (field sum (local sum))
        (field values (local drained)))))))))
declarations.end

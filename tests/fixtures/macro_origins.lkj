// Exact macro origins are replayed from source, never authorized by receipts.
mod ast; mod diagnostic; mod names; mod syntax; mod resolve; mod source; mod origins;
mod diagnostics {
    #[derive(Clone)]
    pub struct BlockedRegion { pub path: String, pub span: crate::ast::Span, pub kind: String, pub reason: String }
}
fn inputs() -> Vec<(String, Vec<u8>)> {
    let text = r#"
#[macro_export(local_inner_macros)]
macro_rules! exported { () => { 9i64 }; }
macro_rules! emit { ($name:ident, $value:expr) => { fn $name() -> i64 { $value } }; }
macro_rules! twice { ($value:expr) => { ($value, $value) }; }
macro_rules! nested { ($value:expr) => { twice!($value) }; }
macro_rules! text { () => { include_str!("payload.txt") }; }
macro_rules! discard { ($value:expr) => { 0i64 }; }
macro_rules! defaults { ($name:ident) => { struct $name<T = i64, U = T> { first: T, second: U } }; }
fn helper(value: i64) -> i64 { value + 1i64 }
emit!(generated, helper(5i64));
defaults!(GeneratedDefaults);
fn type_anchor(_value: bool) {}
fn source() -> i64 {
    let pair = nested!(helper(7i64));
    let label = text!();
    let ignored = discard!(missing!());
    pair.0 + pair.1 + generated()
}
"#;
    vec![("main.lkj".to_string(), text.as_bytes().to_vec()),
        ("payload.txt".to_string(), b"retained input"[..].to_vec()),
        ("$std/lib.lkj".to_string(), b"pub mod marker { pub struct Value; }"[..].to_vec())]
}
fn parsed(inputs: &[(String, Vec<u8>)]) -> ast::Program {
    let program = source::load("main.lkj", Some("$std/lib.lkj"), &mut |path: &str| {
        Ok(inputs.iter().find(|(name, _)| name == path).map(|(_, bytes)| bytes.clone()))
    }).unwrap();
    resolve::resolve(&program).unwrap()
}
fn refused(program: &ast::Program) -> usize {
    let resolver = resolve::Resolver::new(program).unwrap();
    match origins::collect(program, &resolver) {
        Err(message) => assert!(message.contains("E_IDENTITY_ORIGIN")),
        Ok(_) => panic!("unexplained macro origin accepted"),
    }
    1usize
}
fn unauthenticated(program: &ast::Program, inputs: &[(String, Vec<u8>)]) -> usize {
    match syntax::macros::provenance::validate_inputs(program, inputs) {
        Err(problem) => assert!(problem.code == "E_IDENTITY_ORIGIN"),
        Ok(()) => panic!("macro snapshot was not bound to its actual input bytes"),
    }
    1usize
}
fn normalized(path: &str) -> String {
    if path.starts_with("$std/") { format!("/mounted/library/{}", &path[5usize..]) }
    else { format!("/project/{path}") }
}
// Replay path identities as normalized by the driver.
fn mounted_replay(program: &ast::Program, inputs: &[(String, Vec<u8>)]) {
    let mut mounted = program.clone();
    for index in 0usize..mounted.files.len() { mounted.files[index].path = normalized(&mounted.files[index].path); }
    for index in 0usize..mounted.loaded_modules.len() {
        if !mounted.loaded_modules[index].alternate.is_empty() {
            mounted.loaded_modules[index].alternate = normalized(&mounted.loaded_modules[index].alternate);
        }
    }
    for index in 0usize..mounted.macro_inputs.len() { mounted.macro_inputs[index].0 = normalized(&mounted.macro_inputs[index].0); }
    let files = mounted.files.clone();
    let modules = mounted.loaded_modules.clone();
    {
        let original = mounted.macro_input.as_mut().unwrap();
        original.files = files;
        original.loaded_modules = modules;
    }
    let mut mounted_inputs = Vec::new();
    for (path, bytes) in inputs { mounted_inputs.push((normalized(path), bytes.clone())); }
    syntax::macros::provenance::validate_inputs(&mounted, &mounted_inputs).unwrap();
    let resolver = resolve::Resolver::new(&mounted).unwrap();
    origins::collect(&mounted, &resolver).unwrap();
}

fn expression_origins() -> i64 {
    let inputs = inputs();
    let program = parsed(&inputs);
    syntax::macros::provenance::validate_inputs(&program, &inputs).unwrap();
    let resolver = resolve::Resolver::new(&program).unwrap();
    let relation = origins::collect(&program, &resolver).unwrap();
    let generated = program.functions.iter().position(|function| function.name == "generated").unwrap();
    assert!(relation.functions[generated].is_some());
    assert!(relation.functions[generated].unwrap().expansion.name() == "macro-rules");
    assert!(!relation.macros.expressions.is_empty());
    let mut unreachable_copy = false;
    for alias in &program.macro_aliases {
        if !relation.macros.live_expressions.contains(&alias.expanded) {
            assert!(relation.macros.expressions.contains_key(&alias.expanded));
            unreachable_copy = true;
        }
    }
    assert!(unreachable_copy);
    assert!(program.macro_inputs.len() == 1usize);
    assert!(program.macro_invocations.iter().all(|invocation| invocation.name != "missing"));
    let repeated = program.macro_captures.iter().position(|capture| capture.materializations.len() > 1usize).unwrap();
    assert!(program.macro_captures[repeated].materializations[0usize]
        != program.macro_captures[repeated].materializations[1usize]);
    let integer = relation.macros.expressions.keys().find(|index|
        matches!(program.exprs[**index].kind, ast::Expr::Int(_))).copied().unwrap();
    let included = relation.macros.expressions.keys().find(|index|
        matches!(&program.exprs[**index].kind, ast::Expr::String(value) if value == "retained input")).copied().unwrap();

    mounted_replay(&program, &inputs);

    let mut count = 0usize;
    let mut literal = program.clone();
    literal.exprs[integer].kind = ast::Expr::Int("99i64".to_string());
    count += refused(&literal);
    let mut capture = program.clone();
    capture.macro_captures[repeated].tokens[0usize].text = "invented".to_string();
    count += refused(&capture);
    let mut materializations = program.clone();
    let first = materializations.macro_captures[repeated].materializations[0usize];
    materializations.macro_captures[repeated].materializations.push(first);
    count += refused(&materializations);
    let mut spelling = program.clone();
    spelling.macro_definitions[0usize].body[0usize].origin.start += 1usize;
    count += refused(&spelling);
    let mut alias = program.clone();
    alias.macro_aliases[0usize].expanded = integer;
    count += refused(&alias);
    let mut original = program.clone();
    original.macro_aliases[0usize].original.kind = ast::Expr::Bool(true);
    count += refused(&original);
    let mut owner = program.clone();
    let body = owner.functions[generated].body.unwrap();
    owner.blocks[body].tail = None;
    count += refused(&owner);
    let mut snapshot = program.clone();
    snapshot.macro_input = None;
    count += refused(&snapshot);
    let mut expanded_input = program.clone();
    expanded_input.macro_input.as_mut().unwrap().macros_expanded = true;
    count += refused(&expanded_input);
    let mut absent_include = program.clone();
    absent_include.macro_inputs.clear();
    count += refused(&absent_include);
    let mut duplicate_include = program.clone();
    let receipt = duplicate_include.macro_inputs[0usize].clone();
    duplicate_include.macro_inputs.push(receipt);
    count += refused(&duplicate_include);
    let mut unused_include = program.clone();
    unused_include.macro_inputs.push(("unused.txt".to_string(), b"unused"[..].to_vec()));
    count += refused(&unused_include);
    let mut token_context = program.clone();
    token_context.macro_definitions[0usize].body[0usize].context = 1usize;
    count += refused(&token_context);

    // Coordinated receipt/output changes still cannot change authenticated bytes.
    let mut include_forgery = program.clone();
    include_forgery.macro_inputs[0usize].1 = b"forged"[..].to_vec();
    for index in 0usize..include_forgery.exprs.len() {
        if matches!(&include_forgery.exprs[index].kind, ast::Expr::String(value) if value == "retained input") {
            include_forgery.exprs[index].kind = ast::Expr::String("forged".to_string());
        }
    }
    count += unauthenticated(&include_forgery, &inputs);
    let mut flags = program.clone();
    flags.macro_input.as_mut().unwrap().macro_definitions[0usize].exported = false;
    count += unauthenticated(&flags, &inputs);
    let mut inner = program.clone();
    inner.macro_input.as_mut().unwrap().macro_definitions[0usize].local_inner = false;
    count += unauthenticated(&inner, &inputs);
    let mut empty = program.clone();
    empty.macro_input.as_mut().unwrap().macro_definitions[0usize].body.clear();
    count += unauthenticated(&empty, &inputs);
    let mut scope = program.clone();
    scope.macro_input.as_mut().unwrap().scopes[0usize].path = "forged".to_string();
    count += unauthenticated(&scope, &inputs);
    let mut wrong_span = program.clone();
    wrong_span.exprs[included].span.start += 1usize;
    count += refused(&wrong_span);
    // A different existing TypeId is still an unauthenticated default recipe.
    let generated_type = program.structs.iter().position(|definition| definition.name == "GeneratedDefaults").unwrap();
    let anchor = program.functions.iter().position(|function| function.name == "type_anchor").unwrap();
    let mut changed_default = program.clone();
    changed_default.structs[generated_type].generics[0usize].default = Some(program.functions[anchor].params[0usize].ty);
    count += refused(&changed_default);
    count += module_path_origins();
    count += format_args_origins();
    assert!(count == 35usize);
    count as i64
}

// Keep each replay input scoped to the feature its cases exercise. Growing one
// specimen should not make every unrelated refusal replay its extra syntax.
fn parsed_fixture(text: &str) -> (ast::Program, Vec<(String, Vec<u8>)>) {
    let inputs = vec![("main.lkj".to_string(), text.as_bytes().to_vec()),
        ("$std/lib.lkj".to_string(), b"pub mod marker { pub struct Value; }"[..].to_vec())];
    let program = parsed(&inputs);
    syntax::macros::provenance::validate_inputs(&program, &inputs).unwrap();
    (program, inputs)
}
fn macro_path_refused(program: &ast::Program) -> usize {
    match syntax::macros::provenance::validate(program) {
        Err(problem) => assert!(problem.code == "E_IDENTITY_ORIGIN"),
        Ok(()) => panic!("forged module-path origin accepted"),
    }
    1usize
}
fn format_args_origins() -> usize {
    let text = r#"
macro_rules! deferred { ($value:expr) => { format_args!("value={}", $value) }; }
macro_rules! capture { () => {{ let captured = 9i64; format_args!("{captured}") }}; }
macro_rules! composed { () => { format_args!(concat!("joined", '=', "{}"), 7i64) }; }
fn value() { let item = 7i64; let first = deferred!(item); let second = capture!(); let third = composed!(); }
"#;
    let (program, inputs) = parsed_fixture(text);
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let macro_id = program.exprs.iter().position(|node|
        matches!(&node.kind, ast::Expr::Macro { name, args, .. } if name == "format_args" && args.len() == 2usize)).unwrap();
    let ast::Expr::Macro { args, .. } = program.exprs[macro_id].kind.clone() else { unreachable!() };
    let capture = program.exprs.iter().position(|node|
        matches!(&node.kind, ast::Expr::Path(path) if ast::macros::source_name(&path.name) == "captured" && path.name != "captured")).unwrap();
    let mut count = 0usize;
    let mut literal = program.clone();
    literal.exprs[args[0usize]].kind = ast::Expr::String("forged={0:?}".to_string());
    count += macro_path_refused(&literal);
    let mut invocation = program.clone();
    if let ast::Expr::Macro { name, .. } = &mut invocation.exprs[macro_id].kind { *name = "format".to_string(); }
    count += macro_path_refused(&invocation);
    let mut arguments = program.clone();
    if let ast::Expr::Macro { args, .. } = &mut arguments.exprs[macro_id].kind { let first = args[0usize]; args[0usize] = args[1usize]; args[1usize] = first; }
    count += macro_path_refused(&arguments);
    let mut separator = program.clone();
    if let ast::Expr::Macro { separator, .. } = &mut separator.exprs[macro_id].kind { *separator = ";".to_string(); }
    count += macro_path_refused(&separator);
    let mut hygiene = program.clone();
    if let ast::Expr::Path(path) = &mut hygiene.exprs[capture].kind { path.name = "captured".to_string(); }
    count += macro_path_refused(&hygiene);
    let mut changed_inputs = inputs.clone();
    changed_inputs[0usize].1 = text.replace("9i64", "8i64").as_bytes().to_vec();
    count += unauthenticated(&program, &changed_inputs);
    let joined = program.exprs.iter().position(|node| matches!(&node.kind, ast::Expr::String(text) if text == "joined={}")).unwrap();
    let normalized = program.exprs.iter().position(|node| matches!(&node.kind, ast::Expr::String(text) if text == "joined={0}")).unwrap();
    let mut forged_join = program.clone();
    forged_join.exprs[joined].kind = ast::Expr::String("other={}".to_string());
    count += macro_path_refused(&forged_join);
    let mut forged_normalization = program.clone();
    forged_normalization.exprs[normalized].kind = ast::Expr::String("other={0}".to_string());
    count += macro_path_refused(&forged_normalization);
    assert!(count == 8usize);
    count
}
fn module_path_origins() -> usize {
    let text = r#"
macro_rules! path { () => { module_path!() }; }
macro_rules! relay { () => { path!() }; }
mod left { pub fn value() -> &'static str { relay!() } }
mod right { pub fn value() -> &'static str { relay!() } }
"#;
    let (program, inputs) = parsed_fixture(text);
    syntax::macros::provenance::validate_inputs(&program, &inputs).unwrap();
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let value = program.exprs.iter().position(|node|
        matches!(&node.kind, ast::Expr::String(value) if value == "main::left")).unwrap();
    let alternate = program.scopes.iter().position(|scope| scope.path == "right").unwrap();
    let invocation = program.macro_invocations.iter().position(|call| call.name == "path").unwrap();
    let mut count = 0usize;
    let mut literal = program.clone();
    literal.exprs[value].kind = ast::Expr::String("main::right".to_string());
    count += macro_path_refused(&literal);
    let mut scope = program.clone();
    scope.exprs[value].scope = alternate;
    count += macro_path_refused(&scope);
    let mut destination = program.clone();
    destination.macro_invocations[invocation].destination = alternate;
    count += macro_path_refused(&destination);
    let mut parent = program.clone();
    parent.macro_invocations[invocation].parent = None;
    count += macro_path_refused(&parent);
    let mut snapshot = program.clone();
    let original_scope = snapshot.macro_input.as_ref().unwrap().scopes.iter()
        .position(|scope: &ast::ModuleScope| scope.path == "left").unwrap();
    snapshot.macro_input.as_mut().unwrap().scopes[original_scope].path = "right".to_string();
    snapshot.exprs[value].kind = ast::Expr::String("main::right".to_string());
    count += unauthenticated(&snapshot, &inputs);
    let mut absent_file = program.clone();
    absent_file.macro_input.as_mut().unwrap().loaded_modules[0usize].file = program.files.len();
    count += macro_path_refused(&absent_file);

    let provider_inputs = vec![("main.lkj".to_string(),
        b"#[macro_use] extern crate provider_name as alias; fn value() -> &'static str { label!() }"[..].to_vec()),
        ("provider.lkj".to_string(), b"#[macro_export] macro_rules! label { () => { module_path!() }; }"[..].to_vec())];
    let providers = vec![ast::macros::MacroProviderInput { name: "provider_name".to_string(),
        alias: "alias".to_string(), path: "provider.lkj".to_string() }];
    let provider = source::load_report_with_providers("main.lkj", None, &providers, &mut |path: &str| {
        Ok(provider_inputs.iter().find(|(name, _)| name == path).map(|(_, bytes)| bytes.clone()))
    }).into_result().unwrap();
    let mut provider = resolve::resolve(&provider).unwrap();
    syntax::macros::provenance::validate_inputs(&provider, &provider_inputs).unwrap();
    provider.macro_providers[0usize].input.name = "invented".to_string();
    provider.macro_input.as_mut().unwrap().macro_providers[0usize].input.name = "invented".to_string();
    count += unauthenticated(&provider, &provider_inputs);
    assert!(count == 7usize);
    count
}

fn type_origins() -> i64 {
    let (program, inputs) = parsed_fixture(r#"
#[macro_export(local_inner_macros)]
macro_rules! exported { () => { 9i64 }; }
macro_rules! emit { ($name:ident, $value:expr) => { fn $name() -> i64 { $value } }; }
macro_rules! twice { ($value:expr) => { ($value, $value) }; }
macro_rules! typed { ($t:ty) => { fn typed(value: $t) -> ($t, $t) { (value, value) } }; }
macro_rules! typed_relay { ($t:ty) => { typed!($t); }; }
typed_relay!(i64);
emit!(generated, 5i64);
fn type_anchor(_value: bool) {}
fn source() -> (i64, i64) { twice!(7i64) }
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    let relation = origins::collect(&program, &resolver).unwrap();
    let repeated = program.macro_captures.iter().position(|capture| capture.materializations.len() > 1usize).unwrap();
    let typed = program.macro_captures.iter().position(|capture| capture.type_materializations.len() > 1usize).unwrap();
    let first_type = program.macro_captures[typed].type_materializations[0usize];
    assert!(Some(first_type) == program.macro_captures[typed].ty);
    assert!(first_type != program.macro_captures[typed].type_materializations[1usize]);
    for ty in &program.macro_captures[typed].type_materializations {
        assert!(relation.macros.types.contains_key(ty));
    }
    let type_call = program.macro_invocations.iter().position(|call|
        call.tokens.iter().any(|token| token.kind == 9u8)).unwrap();
    let opaque_token = program.macro_invocations[type_call].tokens.iter().position(|token| token.kind == 9u8).unwrap();
    let wrong_scope = program.scopes.iter().position(|scope| scope.path == "$std").unwrap();
    let anchor = program.functions.iter().find(|function| function.name == "type_anchor").unwrap();
    let generated = program.functions.iter().find(|function| function.name == "generated").unwrap();
    let relay = program.macro_invocations.iter().position(|call| call.name == "typed_relay").unwrap();
    let relay_expansion = program.macro_expansions.iter().position(|expansion| expansion.invocation == relay).unwrap();
    let exported = program.macro_definitions.iter().position(|definition| definition.name == "exported").unwrap();
    let source_relay = program.macro_input.as_ref().unwrap().macro_invocations.iter()
        .position(|call| call.name == "typed_relay").unwrap();
    mounted_replay(&program, &inputs);

    let mut count = 0usize;
    let mut type_first = program.clone();
    type_first.macro_captures[typed].ty = Some(anchor.params[0usize].ty);
    count += refused(&type_first);
    let mut type_list = program.clone();
    type_list.macro_captures[typed].type_materializations.push(first_type);
    count += refused(&type_list);
    let mut opaque_kind = program.clone();
    opaque_kind.macro_invocations[type_call].tokens[opaque_token].kind = 8u8;
    count += refused(&opaque_kind);
    let mut opaque_index = program.clone();
    opaque_index.macro_invocations[type_call].tokens[opaque_token].capture = Some(repeated);
    count += refused(&opaque_index);
    let mut destination = program.clone();
    destination.macro_invocations[type_call].destination = wrong_scope;
    count += refused(&destination);
    let mut textual_scope = program.clone();
    textual_scope.macro_invocations[type_call].scope = wrong_scope;
    count += refused(&textual_scope);
    let mut type_block = program.clone();
    type_block.types[first_type].block = generated.body;
    count += refused(&type_block);
    let mut context = program.clone();
    context.macro_expansions[relay_expansion].context += 1usize;
    count += refused(&context);
    let mut parent = program.clone();
    parent.macro_expansions[relay_expansion].parent = Some(relay_expansion);
    count += refused(&parent);
    let mut definition = program.clone();
    definition.macro_expansions[relay_expansion].definition = exported;
    count += refused(&definition);
    let mut invocation = program.clone();
    invocation.macro_invocations[relay].name = "invented".to_string();
    count += refused(&invocation);
    let mut extent = program.clone();
    extent.macro_expansions[relay_expansion].end.exprs += 1usize;
    count += refused(&extent);
    let mut source_token = program.clone();
    source_token.macro_input.as_mut().unwrap().macro_invocations[source_relay].tokens[0usize].text = "invented".to_string();
    count += unauthenticated(&source_token, &inputs);
    assert!(count == 13usize);
    count as i64
}
fn fragment_token_origins() -> i64 {
    let (program, inputs) = parsed_fixture(r#"
macro_rules! split_type { (<$t:ty>) => { type Split = $t; }; }
macro_rules! discard_type { ($t:ty) => { 0i64 }; }
split_type!(<Vec<i64>>);
fn source() -> i64 { discard_type!(UnresolvedUnused) }
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let split = program.macro_captures.iter().position(|capture|
        capture.tokens.last().is_some_and(|token| token.text == ">")).unwrap();
    let prefix = program.macro_captures[split].tokens.last().unwrap();
    assert!(prefix.span.end - prefix.span.start == 1usize);
    assert!(prefix.origin.end - prefix.origin.start == 1usize);
    let unused = program.macro_captures.iter().find(|capture|
        capture.tokens.first().is_some_and(|token| token.text == "UnresolvedUnused")).unwrap();
    assert!(unused.ty.is_none() && unused.type_materializations.is_empty());
    assert!(!program.types.iter().any(|node|
        matches!(&node.kind, ast::Type::Path(path) if path.name == "UnresolvedUnused")));

    let mut split_origin = program.clone();
    let last = split_origin.macro_captures[split].tokens.len() - 1usize;
    split_origin.macro_captures[split].tokens[last].origin.end += 1usize;
    let count = refused(&split_origin) + lifetime_token_origins() + block_and_tree_origins();
    assert!(count == 8usize);
    count as i64
}
fn lifetime_token_origins() -> usize {
    let (program, inputs) = parsed_fixture(r#"
macro_rules! borrowed {
    ($lt:lifetime) => { fn selected<$lt>(value: &$lt i64) -> &$lt i64 { value } };
}
borrowed!('capture);
fn source() -> i64 { let value = 42i64; *selected(&value) }
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let invocation = program.macro_invocations.iter().position(|candidate|
        candidate.name == "borrowed").unwrap();
    let token = program.macro_invocations[invocation].tokens.iter().position(|token|
        token.kind == 5u8).unwrap();

    let mut kind = program.clone();
    kind.macro_invocations[invocation].tokens[token].kind = 0u8;
    let mut count = refused(&kind);
    let mut context = program.clone();
    context.macro_invocations[invocation].tokens[token].context += 1usize;
    count += refused(&context);
    let mut origin = program.clone();
    origin.macro_invocations[invocation].tokens[token].origin.start += 1usize;
    count += refused(&origin);
    let source_invocation = program.macro_input.as_ref().unwrap().macro_invocations.iter()
        .position(|candidate: &ast::MacroInvocation| candidate.name == "borrowed").unwrap();
    let mut source_token = program.clone();
    source_token.macro_input.as_mut().unwrap().macro_invocations[source_invocation].tokens[token].text =
        "'changed".to_string();
    count += unauthenticated(&source_token, &inputs);
    assert!(count == 4usize);
    count
}
fn block_and_tree_origins() -> usize {
    let (program, _) = parsed_fixture(r#"
macro_rules! leaf { (@tag $body:block) => { $body + $body }; }
macro_rules! relay { ([$($head:tt)+] $body:block) => { leaf!($($head)+ $body) }; }
fn source() -> i64 { let value = 21i64; relay!([@tag] {value}) }
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    let relay = program.macro_invocations.iter().find(|call| call.name == "relay").unwrap();
    let leaf = program.macro_invocations.iter().position(|call| call.name == "leaf").unwrap();
    let source_at = relay.tokens.iter().find(|token| token.text == "@").unwrap();
    assert!(*source_at == program.macro_invocations[leaf].tokens[0usize]);
    let capture = program.macro_captures.iter().position(|capture|
        capture.tokens.first().is_some_and(|token| token.text == "{")).unwrap();
    assert!(program.macro_captures[capture].materializations.len() == 2usize);
    let first = program.macro_captures[capture].materializations[0usize];
    let second = program.macro_captures[capture].materializations[1usize];
    assert!(first != second);
    let mut punctuation = program.clone();
    punctuation.macro_invocations[leaf].tokens[0usize].origin.start += 1usize;
    let mut block = program.clone();
    block.macro_captures[capture].tokens[0usize].context += 1usize;
    let mut reused = program.clone();
    reused.macro_captures[capture].materializations[1usize] = first;
    refused(&punctuation) + refused(&block) + refused(&reused)
}
fn lexical_origins() -> i64 {
    let (program, inputs) = parsed_fixture(r#"
macro_rules! block_import { ($e:expr) => {{ { use std::marker::Value; } $e }}; }
macro_rules! emit { ($name:ident) => { fn $name() -> bool { true } }; }
emit!(unrelated);
fn source() -> i64 { block_import!(0i64) }
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let import = program.uses.iter().position(|item| item.block.is_some()).unwrap();
    let import_block = program.uses[import].block.unwrap();
    let unrelated = program.functions.iter().find(|function| function.name == "unrelated").unwrap();

    let mut count = 0usize;
    let mut import_owner = program.clone();
    import_owner.uses[import].block = unrelated.body;
    count += refused(&import_owner);
    let mut block_parent = program.clone();
    block_parent.blocks[import_block].parent = None;
    count += refused(&block_parent);
    let mut absent_block = program.clone();
    absent_block.macro_input.as_mut().unwrap().types[0usize].block = Some(18446744073709551615usize);
    count += refused(&absent_block);
    assert!(count == 3usize);
    count as i64
}
fn statement_origins() -> i64 {
    let (program, inputs) = parsed_fixture(r#"
macro_rules! emit { ($name:ident, $value:expr) => { fn $name() -> i64 { $value } }; }
macro_rules! statements { ($name:ident, $value:expr) => { let $name = $value; }; }
macro_rules! block_import { ($e:expr) => {{ { use std::marker::Value; } $e }}; }
emit!(generated, 5i64);
fn source() -> i64 {
    statements!(captured, 3i64);
    let scoped = block_import!(0i64);
    scoped + generated()
}
"#);
    let resolver = resolve::Resolver::new(&program).unwrap();
    let relation = origins::collect(&program, &resolver).unwrap();
    mounted_replay(&program, &inputs);
    let generated = program.functions.iter().position(|function| function.name == "generated").unwrap();
    let statement = program.macro_invocations.iter().position(|call| call.name == "statements").unwrap();
    let invocation = &program.macro_invocations[statement];
    let expected_position = ast::MacroPosition::Statement { semicolon: true, braces: false };
    assert!(invocation.position == expected_position);
    let splice = program.macro_expansions.iter().position(|item| item.invocation == statement).unwrap();
    let placement = program.macro_expansions[splice].splice.as_ref().unwrap();
    assert!(placement.tail.is_none() && placement.count > 0usize);
    assert!(placement.first + placement.count < program.blocks[placement.block].statements.len());
    let binder = &invocation.tokens[0usize];
    assert!(binder.text == "captured" && program.macro_identifier_uses.contains(&binder.origin));
    let foreign_block = program.functions[generated].body.unwrap();
    assert!(foreign_block != placement.block);
    let integer = program.blocks[foreign_block].tail.unwrap();
    assert!(matches!(program.exprs[integer].kind, ast::Expr::Int(_)));
    assert!(relation.macros.expressions.contains_key(&integer));
    let source_calls = &program.macro_input.as_ref().unwrap().macro_invocations;
    let source_statement = source_calls.iter().position(|call| call.name == "statements").unwrap();
    assert!(source_calls[source_statement].position == expected_position && source_calls[source_statement].block.is_some());
    let mut count = 0usize;
    let mut position = program.clone();
    position.macro_invocations[statement].position = ast::MacroPosition::Expression;
    count += refused(&position);
    let mut semicolon = program.clone();
    semicolon.macro_invocations[statement].position = ast::MacroPosition::Statement { semicolon: false, braces: false };
    count += refused(&semicolon);
    let mut absent_statement_block = program.clone();
    absent_statement_block.macro_invocations[statement].block = None;
    count += refused(&absent_statement_block);
    let mut splice_block = program.clone();
    splice_block.macro_expansions[splice].splice.as_mut().unwrap().block = foreign_block;
    count += refused(&splice_block);
    let mut splice_first = program.clone();
    splice_first.macro_expansions[splice].splice.as_mut().unwrap().first += 1usize;
    count += refused(&splice_first);
    let mut splice_count = program.clone();
    splice_count.macro_expansions[splice].splice.as_mut().unwrap().count += 1usize;
    count += refused(&splice_count);
    let mut splice_tail = program.clone();
    splice_tail.macro_expansions[splice].splice.as_mut().unwrap().tail = Some(integer);
    count += refused(&splice_tail);
    let mut chosen_rule = program.clone();
    chosen_rule.macro_expansions[splice].rule += 1usize;
    count += refused(&chosen_rule);
    let mut identifier_role = program.clone();
    identifier_role.macro_identifier_uses.clear();
    count += refused(&identifier_role);
    let mut leftover = program.clone();
    let block = program.macro_invocations[statement].block.unwrap();
    leftover.blocks[block].statements.push(ast::Stmt::MacroInvocation(statement));
    count += refused(&leftover);
    let mut original_position = program.clone();
    original_position.macro_input.as_mut().unwrap().macro_invocations[source_statement].position = ast::MacroPosition::Expression;
    count += unauthenticated(&original_position, &inputs);
    let mut original_block = program.clone();
    original_block.macro_input.as_mut().unwrap().macro_invocations[source_statement].block = None;
    count += unauthenticated(&original_block, &inputs);
    assert!(count == 12usize);
    count as i64
}
fn main() {
    let count = expression_origins() + type_origins() + fragment_token_origins()
        + lexical_origins() + statement_origins();
    assert!(count == 71i64);
}

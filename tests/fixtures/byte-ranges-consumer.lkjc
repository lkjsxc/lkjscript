declarations.begin
(units
  (use std builtin)
  (use ranges LIBRARY_PACKAGE LIBRARY_PACKAGE_REVISION)
  (type-alias Projection (record (captured Bytes) (copied Bytes) (hex Text)
    (joined Bytes) (lookup I64) (nested Bytes) (original Bytes) (roundtrip Bytes) (selected Bytes)))
  (module create windows
    (function create identity (visibility private)
      (parameter create bytes (type Bytes)) (returns Bytes) (effect pure)
      (body (local bytes)))
    (function create project (visibility private)
      (parameter create bytes (type Bytes))
      (parameter create start (type I64)) (parameter create end (type I64))
      (returns Projection) (effect pure)
      (body (let
        (binding selected (call ranges::map-range (types Bytes) (local bytes)
          (local start) (local end) (function-value identity)))
        (binding retained (call ranges::remember (local selected)))
        (binding keys (call std::map-insert (types Bytes I64)
          (map Bytes I64) (local selected) (i64 7)))
        (in (record structural
          (field captured (invoke (local retained) (unit)))
          (field copied (call ranges::map-range (types Bytes) (local bytes)
            (local start) (local end) (function-value std::bytes-copy)))
          (field hex (call ranges::map-range (types Text) (local bytes)
            (local start) (local end) (function-value std::bytes-to-hex)))
          (field joined (call std::bytes-concat (local selected)
            (call std::bytes-from-list (list I64 (i64 0) (i64 255)))))
          (field lookup (call std::map-get-or (types Bytes I64) (local keys)
            (call std::bytes-copy (local selected)) (i64 -1)))
          (field nested (call std::bytes-slice (local selected) (i64 0)
            (call std::bytes-length (local selected))))
          (field original (local bytes))
          (field roundtrip (call std::data-decode-or (types Bytes)
            (call std::data-encode (types Bytes) (local selected))
            (call std::bytes-from-list (list I64))))
          (field selected (local selected)))))))
    (function create packet (visibility private)
      (parameter create frame (type Bytes)) (returns Bytes) (effect pure)
      (body (call ranges::payload (local frame))))
    (test create retained-binary (visibility private)
      (actual (field (call project (call std::bytes-from-list
        (list I64 (i64 0) (i64 255) (i64 128) (i64 13))) (i64 1) (i64 3)) (name captured)))
      (expected (call std::bytes-from-list (list I64 (i64 255) (i64 128)))))
    (test create map-copy-key (visibility private)
      (actual (field (call project (call std::bytes-from-text (text "ABCDE"))
        (i64 1) (i64 4)) (name lookup))) (expected (i64 7)))
    (component create console (visibility private)
      (port create range (type (function (Bytes I64 I64) Projection)) (function project))
      (port create packet (type (function (Bytes) Bytes)) (function packet))))
  (target create range (component windows::console) (runner command) (port windows::console::range))
  (target create packet (component windows::console) (runner command) (port windows::console::packet)))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create batches (as $batches)
    (record create Batch (as $Batch) (visibility public)
      (type-parameter create T)
      (field create items (type (list T))))
    (variant create Marked (as $Marked) (visibility public)
      (type-parameter create T)
      (case create included (payload T))
      (case create excluded (payload T)))
    (record create Summary (as $Summary) (visibility public)
      (field create count (type I64))
      (field create sum (type I64)))
    (function create add-included (visibility private)
      (parameter create state (type Summary))
      (parameter create amount (type I64))
      (returns Summary) (effect pure)
      (body
        (record Summary
          (field Summary::count (call std::add (field (local state) Summary::count) (i64 1)))
          (field Summary::sum (call std::add (field (local state) Summary::sum) (local amount))))))
    (function create step (visibility private)
      (type-parameter create T (constraint capture-safe))
      (parameter create projection (type (function (T) (Marked I64))))
      (parameter create state (type Summary))
      (parameter create item (type T))
      (returns Summary) (effect pure)
      (body
        (match (invoke (local projection) (local item))
          (arm Marked::included (payload amount I64)
            (call add-included (local state) (local amount)))
          (arm Marked::excluded (payload amount I64) (local state)))))
    (function create summarize (as $summarize) (visibility public)
      (type-parameter create T (constraint capture-safe))
      (parameter create batch (as $batch) (type (Batch T)))
      (parameter create projection (as $projection) (type (function (T) (Marked I64))))
      (returns Summary) (effect pure)
      (body
        (call std::list-fold-left (types T Summary)
          (field (local batch) Batch::items)
          (record Summary (field Summary::count (i64 0)) (field Summary::sum (i64 0)))
          (bind (function-value step (types T)) (local projection)))))
    (function create keep-marked (visibility private)
      (parameter create value (type (Marked I64)))
      (returns (Marked I64)) (effect pure) (body (local value)))
    (test create empty (visibility private)
      (actual
        (call summarize (types (Marked I64))
          (record Batch (types (Marked I64))
            (field Batch::items (list (Marked I64))))
          (function-value keep-marked)))
      (expected (record Summary (field Summary::count (i64 0)) (field Summary::sum (i64 0)))))
    (test create mixed (visibility private)
      (actual
        (call summarize (types (Marked I64))
          (record Batch (types (Marked I64))
            (field Batch::items
              (list (Marked I64)
                (variant Marked::included (types I64) (i64 3))
                (variant Marked::excluded (types I64) (i64 100))
                (variant Marked::included (types I64) (i64 -1)))))
          (function-value keep-marked)))
      (expected (record Summary (field Summary::count (i64 2)) (field Summary::sum (i64 2)))))
    (test create excluded (visibility private)
      (actual
        (call summarize (types (Marked I64))
          (record Batch (types (Marked I64))
            (field Batch::items
              (list (Marked I64)
                (variant Marked::excluded (types I64) (i64 100)))))
          (function-value keep-marked)))
      (expected (record Summary (field Summary::count (i64 0)) (field Summary::sum (i64 0)))))))
declarations.end

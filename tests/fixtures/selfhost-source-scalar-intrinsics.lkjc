declarations.begin
(units
  (module create scalar-intrinsics
    (external create sum (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create difference (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create product (visibility private) (implementation core.i64.multiply)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create quotient (visibility private) (implementation core.i64.divide)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create same-number (visibility private) (implementation core.i64.equal)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create smaller (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create both-values (visibility private) (implementation core.bool.and)
      (parameter create a (type Bool)) (parameter create b (type Bool)) (returns Bool))
    (external create either-value (visibility private) (implementation core.bool.or)
      (parameter create a (type Bool)) (parameter create b (type Bool)) (returns Bool))
    (external create unused-sum (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))

    (function create arithmetic (visibility public) (effect pure) (returns I64)
      (body
        (if
          (call both-values
            (call same-number (call product (i64 6) (i64 4)) (i64 24))
            (call either-value (call smaller (i64 -1) (i64 0)) (bool false)))
          (call sum (call quotient (i64 -91) (i64 7)) (call difference (i64 60) (i64 5)))
          (i64 -1))))
    (function create truncation (visibility public) (effect pure) (returns I64)
      (body (call quotient (i64 -92) (i64 7))))
    (function create false-relations (visibility public) (effect pure) (returns I64)
      (body
        (call sum
          (if (call both-values (bool true) (bool false)) (i64 1) (i64 0))
          (call sum
            (if (call either-value (bool false) (bool false)) (i64 2) (i64 0))
            (call sum
              (if (call smaller (i64 9) (i64 9)) (i64 4) (i64 0))
              (if (call smaller (i64 0) (i64 -1)) (i64 8) (i64 0)))))))
    (function create minimum-division (visibility public) (effect pure) (returns I64)
      (body (call quotient (i64 -9223372036854775808) (i64 1))))
    (function create maximum-addition (visibility public) (effect pure) (returns I64)
      (body (call sum (i64 9223372036854775807) (i64 0))))
    (function create count-down (visibility public) (effect pure)
      (parameter create remaining (type I64)) (returns I64)
      (body
        (if (call same-number (local remaining) (i64 0))
          (i64 0)
          (call sum (i64 1) (call count-down (call difference (local remaining) (i64 1)))))))
    (function create recursive-entry (visibility public) (effect pure) (returns I64)
      (body (call count-down (i64 42))))
    (function create add-trap (visibility public) (effect pure) (returns I64)
      (body (call sum (i64 9223372036854775807) (i64 1))))
    (function create subtract-trap (visibility public) (effect pure) (returns I64)
      (body (call difference (i64 -9223372036854775808) (i64 1))))
    (function create multiply-trap (visibility public) (effect pure) (returns I64)
      (body (call product (i64 9223372036854775807) (i64 2))))
    (function create divide-zero (visibility public) (effect pure) (returns I64)
      (body (call quotient (i64 1) (i64 0))))
    (function create divide-overflow (visibility public) (effect pure) (returns I64)
      (body (call quotient (i64 -9223372036854775808) (i64 -1))))
    (function create trapping-bool (visibility public) (effect pure) (returns Bool)
      (body (call same-number (call sum (i64 9223372036854775807) (i64 1)) (i64 0))))
    (function create strict-and (visibility public) (effect pure) (returns I64)
      (body (if (call both-values (bool false) (call trapping-bool)) (i64 1) (i64 0))))
    (function create strict-or (visibility public) (effect pure) (returns I64)
      (body (if (call either-value (bool true) (call trapping-bool)) (i64 1) (i64 0))))
    (function create left-before-right (visibility public) (effect pure) (returns I64)
      (body (call sum (call quotient (i64 1) (i64 0)) (call sum (i64 9223372036854775807) (i64 1)))))
    (function create operand-before-intrinsic (visibility public) (effect pure) (returns I64)
      (body (call quotient (call sum (i64 9223372036854775807) (i64 1)) (i64 0))))
    (function create unused-call (visibility public) (effect pure) (returns I64)
      (body (call sum (i64 2) (i64 3))))
    (function create zero-arity (visibility public) (effect pure) (returns I64)
      (body (i64 0)))
    (function create unused-zero-call (visibility public) (effect pure) (returns I64)
      (body (call zero-arity)))

    (component create main (visibility public)
      (port create run (type (function () I64)) (function arithmetic))))
  (target create scalar-main (component scalar-intrinsics::main)
    (runner command) (port scalar-intrinsics::main::run)))
declarations.end

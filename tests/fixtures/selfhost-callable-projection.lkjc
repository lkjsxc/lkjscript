declarations.begin
(units (module create callable-projection
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create left (type I64)) (parameter create right (type I64))
    (returns I64))
  (external create empty (visibility private) (implementation core.buffer.empty)
    (returns ByteBuffer))
  (external create get (visibility private) (implementation core.list.get)
    (type-parameter create T)
    (parameter create values (type (list T))) (parameter create index (type I64))
    (returns T))
  (function create plus (visibility private) (effect pure)
    (parameter create left (type I64)) (parameter create right (type I64))
    (returns I64) (body (call add (local left) (local right))))
  (function create apply-one (visibility private) (effect pure)
(parameter create callable (type (function (I64) I64)))
    (parameter create value (type I64)) (returns I64)
(body (invoke (local callable) (local value))))
  (function create factory (visibility private) (effect pure)
    (returns (function (I64) I64))
    (body (bind (function-value plus) (i64 20))))
  (function create holder (visibility private) (effect pure)
    (returns (record (chosen (function (I64) I64))))
    (body (record structural (field chosen (call factory)))))
  (function create entry (visibility public) (effect pure) (returns I64)
    (body (let
      (binding unchanged (bind (function-value plus)))
      (binding partial (bind (local unchanged) (i64 20)))
      (in (if (bool true)
        (invoke (local partial) (i64 22))
        (invoke (function-value plus) (i64 21) (i64 21)))))))
  (function create higher (visibility public) (effect pure) (returns I64)
    (body (call apply-one (call factory) (i64 22))))
  (function create recorded (visibility public) (effect pure) (returns I64)
    (body (invoke (field (call holder) (name chosen)) (i64 22))))
  (function create generic (visibility public) (effect pure) (returns I64)
    (body (invoke (function-value get (types I64))
      (list I64 (i64 17) (i64 42)) (i64 1))))
  (function create held (visibility public) (effect pure) (returns I64)
    (body (let (binding scratch (type ByteBuffer) (call empty))
      (in (invoke (function-value plus) (i64 20) (i64 22))))))))
declarations.end

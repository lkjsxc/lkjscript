declarations.begin
(units
  (module create transform
    (external create subtract (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (function create forward (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create n (type I64)) (parameter create packet (type T) (use consume))
      (returns T)
      (body (if (call less (local n) (i64 1)) (local packet)
        (call forward (types T) (call subtract (local n) (i64 1)) (local packet)))))
    (function create inspect (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type T) (use borrow)) (returns I64) (body (i64 99)))
    (function create reborrow (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type T) (use borrow)) (returns I64)
      (body (call inspect (types T) (local packet))))
    (function create retag (visibility public) (effect pure)
      (type-parameter create T (constraint owned)) (type-parameter create U (constraint owned))
      (parameter create tag (type I64))
      (parameter create packet (type (owned-product (field left T) (field right U) (field tag I64))) (use consume))
      (returns (owned-product (field left T) (field right U) (field tag I64)))
      (body (unpack-owned (type (owned-product (field left T) (field right U) (field tag I64)))
        (local packet)
        (field left (binding left (type T))) (field right (binding right (type U)))
        (field tag (binding old (type I64)))
        (in (call product-independent::pair (types T U) (local tag) (local left) (local right))))))))
declarations.end

declarations.begin
(units
  (module create native-elf-tests
    (record create Box (visibility public) (type-parameter create T)
      (field create active (type Bool)) (field create empty (type Unit))
      (field create value (type T)))
    (function create nominal (visibility public) (effect pure) (returns (Box I64))
      (body (record Box (types I64) (field Box::value (i64 42))
        (field Box::active (bool true)) (field Box::empty (unit)))))
    (external create add (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create subtract (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create multiply (visibility private) (implementation core.i64.multiply)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create divide (visibility private) (implementation core.i64.divide)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create append (visibility private) (implementation core.list.append)
      (type-parameter create T)
      (parameter create items (type (list T))) (parameter create value (type T)) (returns (list T)))
    (external create get (visibility private) (implementation core.list.get)
      (type-parameter create T)
      (parameter create items (type (list T))) (parameter create index (type I64)) (returns T))
    (function create arithmetic (visibility public) (effect pure)
      (parameter create x (type I64)) (parameter create y (type I64)) (returns I64)
      (body (call multiply (call add (local x) (i64 0)) (call subtract (local y) (i64 1)))))
    (function create constant (visibility public) (effect pure) (returns I64)
      (body (call add (call multiply (i64 6) (i64 7)) (i64 0))))
    (function create branch (visibility public) (effect pure)
      (parameter create x (type I64)) (returns I64)
      (body (if (call less (local x) (i64 0))
        (call subtract (i64 0) (local x)) (call add (local x) (i64 3)))))
    (function create sum (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create acc (type I64)) (returns I64)
      (body (if (call less (local n) (i64 1)) (local acc)
        (call sum (call subtract (local n) (i64 1)) (call add (local acc) (local n))))))
    (function create captured (visibility public) (effect pure) (returns I64)
      (body (invoke (bind (function-value add) (i64 20)) (i64 22))))
    (function create collection (visibility public) (effect pure) (returns I64)
      (body (call get (types I64)
        (call append (types I64) (list I64 (i64 11) (i64 29)) (i64 42)) (i64 2))))
    (function create aggregate (visibility public) (effect pure)
      (returns (record (answer I64) (text Text) (values (list I64))))
      (body (record structural
        (field values (list I64 (i64 -9223372036854775808) (i64 0) (i64 9223372036854775807)))
        (field text (text "a\n\"b"))
        (field answer (i64 42)))))
    (function create overflow (visibility public) (effect pure) (returns I64)
      (body (call add (call add (i64 9223372036854775807) (i64 1)) (i64 0))))
    (function create annihilator (visibility public) (effect pure) (returns I64)
      (body (call multiply (call add (i64 9223372036854775807) (i64 1)) (i64 0))))
    (function create division (visibility public) (effect pure)
      (parameter create divisor (type I64)) (returns I64)
      (body (call divide (i64 -9223372036854775808) (local divisor))))
    (function create untaken (visibility public) (effect pure) (returns I64)
      (body (if (bool false) (call overflow) (i64 3))))
    (function create unsupported (visibility public) (effect pure) (returns F64) (body (f64 1.25)))
    (component create command (visibility private)
      (port create unsupported (type (function () F64)) (function unsupported))
      (port create main (type (function (I64 I64) I64)) (function arithmetic))))
  (target create unsupported (component native-elf-tests::command) (runner command)
    (port native-elf-tests::command::unsupported))
  (target create arithmetic (component native-elf-tests::command) (runner command)
    (port native-elf-tests::command::main)))
declarations.end

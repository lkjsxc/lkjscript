declarations.begin
(units
  (module create artifact-controls
    (external create sum (visibility private) (implementation core.i64.add)
      (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
    (external create list-get (visibility public) (implementation core.list.get)
      (type-parameter create T)
      (parameter create values (type (list T))) (parameter create index (type I64)) (returns T))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create value (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create size (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
    (function create owned-count (visibility private) (effect pure) (returns I64)
      (body (let
        (binding a (type ByteBuffer) (call empty))
        (binding b (type ByteBuffer) (call push (i64 65) (local a)))
        (binding count (call size (local b)))
        (binding frozen (call freeze (local b)))
        (in (local count)))))
    (function create untaken (visibility private) (effect pure) (returns I64)
      (body (if (bool true) (i64 7) (i64 13))))
    (function create text-id (visibility public) (effect pure)
      (parameter create value (type Text)) (returns Text) (body (local value)))
    (function create static-id (visibility public) (effect pure)
      (parameter create value (type StaticText)) (returns StaticText) (body (local value)))
    (function create entry (visibility public) (effect pure) (returns I64)
      (body (call sum
        (call list-get (types I64) (list I64 (i64 40) (i64 41)) (i64 1))
        (call owned-count))))
    (function create other-entry (visibility public) (effect pure) (returns I64) (body (i64 11)))
    (function create binary-entry (visibility public) (effect pure)
      (parameter create input (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (record structural (field diagnostic (i64 0)) (field image (local input)))))
    (component create main (visibility public)
      (port create run (type (function () I64)) (function entry)))
    (component create other (visibility public)
      (port create run (type (function () I64)) (function other-entry)))
    (component create binary (visibility public)
      (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function binary-entry))))
  (target create scalar-main (component artifact-controls::main) (runner command)
    (port artifact-controls::main::run))
  (target create other-main (component artifact-controls::other) (runner command)
    (port artifact-controls::other::run))
  (target create binary-main (component artifact-controls::binary) (runner command)
    (port artifact-controls::binary::run)))
declarations.end

declarations.begin
(units (module create source-index-probe
  (function create word (visibility private) (effect pure)
    (parameter create data (type Bytes)) (parameter create at (type I64)) (returns I64)
    (body (let (binding value (call ci::u32 (local data) (local at)))
      (in (if (call ci::eq (local value) (i64 4294967295)) (i64 -1)
        (if (call ci::eq (local value) (i64 4294967294)) (i64 9223372036854775807)
          (if (call ci::eq (local value) (i64 4294967293)) (i64 -9223372036854775808)
            (local value))))))))
  (function create read-index (visibility public) (effect pure)
    (parameter create data (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (if (call ci::lt (call ci::length (local data)) (i64 24))
      (record structural (field diagnostic (i64 12)) (field image (call ci::text-bytes (text ""))))
      (let
        (binding mode (call ci::u32 (local data) (i64 0)))
        (binding at (call word (local data) (i64 4)))
        (binding count (call word (local data) (i64 8)))
        (binding key-at (call word (local data) (i64 12)))
        (binding extra (call word (local data) (i64 20)))
        (binding found (if (call ci::eq (local mode) (i64 1))
          (call source-index::lookup-owner (local data) (local at) (local count)
            (local data) (local key-at) (local extra))
          (if (call ci::eq (local mode) (i64 2))
            (call source-index::lookup-type (local data) (local at) (local count) (local data) (local key-at))
            (call source-index::lookup (local data) (local at) (local count)
              (call word (local data) (i64 16)) (local extra)
              (call ci::slice (local data) (local key-at) (call ci::length (local data)))))))
        (binding out (type ByteBuffer) (call ci::empty))
        (binding encoded (type ByteBuffer) (call wire::signed (local found) (local out)))
        (in (record structural (field diagnostic (i64 0))
          (field image (call ci::freeze (local encoded)))))))))
  (function create read-namespace-parents (visibility public) (effect pure)
    (parameter create graph (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (let
      (binding prepared (call source-members::prepare (local graph)))
      (binding code (field (local prepared) (name code)))
      (in (if (call ci::eq (local code) (i64 0))
        (let
          (binding out (type ByteBuffer) (call ci::empty))
          (binding keys (call source-namespace-key::collect (local graph) (i64 0)
            (i64 2147483647) (field (local prepared) (name rows)) (local out)))
          (in (record structural
            (field diagnostic (if (call ci::lt (field (local keys) (name work)) (i64 0))
              (call ci::sub (i64 0) (field (local keys) (name work))) (i64 0)))
            (field image (field (local keys) (name rows))))))
        (record structural (field diagnostic (local code)) (field image (call ci::text-bytes (text "")))))))))))
declarations.end

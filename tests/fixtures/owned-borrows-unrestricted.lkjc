declarations.begin
(units
  (module create unrestricted-owned-view
    (function create ordinary (visibility private) (effect pure)
      (type-parameter create U)
      (parameter create value (type U)) (returns U) (body (local value)))
    (function create escape (visibility public) (effect pure)
      (type-parameter create T (constraint owned))
      (parameter create packet (type (owned-product (field payload T))) (use consume))
      (returns T)
      (body (borrow-owned-field (type (owned-product (field payload T))) (local packet)
        (field payload (binding view (type T)))
        (in (call ordinary (types T) (local view))))))))
declarations.end

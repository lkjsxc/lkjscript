declarations.begin
(units
  (module create custody-controls
    (external create sum (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create difference (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create equal (visibility private) (implementation core.i64.equal)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create bytes-length (visibility private) (implementation core.bytes.length)
      (parameter create data (type Bytes)) (returns I64))
    (external create bytes-get (visibility private) (implementation core.bytes.get)
      (parameter create data (type Bytes)) (parameter create index (type I64)) (returns I64))
    (external create bytes-concat (visibility private) (implementation core.bytes.concat)
      (parameter create left (type Bytes)) (parameter create right (type Bytes)) (returns Bytes))
    (external create empty (visibility private) (implementation core.buffer.empty)
      (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create byte (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create size (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
    (external create discard (visibility private) (implementation core.buffer.discard)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Unit))
    (external create unused-size (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))

    (function create constant (visibility private) (effect pure) (returns I64)
      (body (i64 42)))
    (function create owned-identity (visibility private) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (local buffer)))
    (function create forward (visibility private) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (call owned-identity (local buffer))))
    (function create return-cleanup (visibility private) (effect pure)
      (parameter create keep (type ByteBuffer) (use consume))
      (parameter create spare (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (local keep)))
    (function create pick (visibility private) (effect pure)
      (parameter create flag (type Bool))
      (parameter create left (type ByteBuffer) (use consume))
      (parameter create right (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (if (local flag) (local left) (local right))))
    (function create pair-bytes (visibility private) (effect pure) (returns ByteBuffer)
      (body (let
        (binding start (type ByteBuffer) (call empty))
        (binding zero (type ByteBuffer) (call push (i64 0) (local start)))
        (binding full (type ByteBuffer) (call push (i64 255) (local zero)))
        (in (local full)))))
    (function create choice-bytes (visibility private) (effect pure)
      (parameter create flag (type Bool)) (returns Bytes)
      (body (let
        (binding left-empty (type ByteBuffer) (call empty))
        (binding left (type ByteBuffer) (call push (i64 0) (local left-empty)))
        (binding right-empty (type ByteBuffer) (call empty))
        (binding right (type ByteBuffer) (call push (i64 255) (local right-empty)))
        (binding selected (type ByteBuffer) (call pick (local flag) (local left) (local right)))
        (in (call freeze (local selected))))))
    (function create scope-cleanup (visibility public) (effect pure) (returns I64)
      (body (let
        (binding outer-first (type ByteBuffer) (call empty))
        (binding outer-second (type ByteBuffer) (call empty))
        (in (let
          (binding inner-first (type ByteBuffer) (call empty))
          (binding inner-second (type ByteBuffer) (call empty))
          (in (call constant)))))))
    (function create fallback-size (visibility public) (effect pure) (returns I64)
      (body (let
        (binding initial (type ByteBuffer) (call empty))
        (binding borrowed-live (type ByteBuffer) (call push (i64 42) (local initial)))
        (in (call size (local borrowed-live))))))
    (function create sequence-cleanup (visibility public) (effect pure) (returns I64)
      (body (sequence (call empty) (call constant))))
    (function create owned-loop (visibility private) (effect pure)
      (parameter create remaining (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (if (call equal (local remaining) (i64 0))
        (local buffer)
        (let
          (binding next (type ByteBuffer) (call push (i64 42) (local buffer)))
          (in (call owned-loop (call difference (local remaining) (i64 1)) (local next)))))))
    (function create tail-entry (visibility public) (effect pure) (returns I64)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding filled (type ByteBuffer) (call owned-loop (i64 16384) (local first)))
        (binding count (call size (local filled)))
        (binding frozen (call freeze (local filled)))
        (in (if (call equal (local count) (i64 16384))
          (if (call equal (call bytes-length (local frozen)) (i64 16384))
            (call bytes-get (local frozen) (i64 16383)) (i64 -2)) (i64 -1))))))

    (function create unused-double-consume (visibility private) (effect pure) (returns Unit)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (in (sequence (call discard (local first)) (call discard (local second)))))))
    (function create unused-after-freeze (visibility private) (effect pure) (returns I64)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (binding frozen (call freeze (local first)))
        (in (call size (local second))))))
    (function create unused-maybe-moved (visibility private) (effect pure)
      (parameter create flag (type Bool)) (returns I64)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (binding chosen (if (local flag)
          (sequence (call discard (local first)) (i64 11)) (i64 22)))
        (in (call size (local second))))))
    (function create unused-nonlocal-consume (visibility private) (effect pure) (returns Bytes)
      (body (let
        (binding buffer (type ByteBuffer) (call empty))
        (in (call freeze (local buffer))))))
    (function create unused-nonlocal-borrow (visibility private) (effect pure) (returns I64)
      (body (let
        (binding buffer (type ByteBuffer) (call empty))
        (in (call size (local buffer))))))
    (function create unused-annotation (visibility private) (effect pure) (returns Unit)
      (body (let
        (binding buffer (type ByteBuffer) (call empty))
        (in (call discard (local buffer))))))
    (function create unused-return-transfer (visibility private) (effect pure) (returns I64)
      (body (let
        (binding original (type ByteBuffer) (call empty))
        (binding returned (type ByteBuffer) (call owned-identity (local original)))
        (in (call size (local returned))))))
    (function create consume-pair (visibility private) (effect pure)
      (parameter create first (type ByteBuffer) (use consume))
      (parameter create second (type ByteBuffer) (use consume)) (returns Unit)
      (body (sequence (call discard (local first)) (call discard (local second)))))
    (function create unused-alias (visibility private) (effect pure) (returns Unit)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (in (call consume-pair (local first) (local second))))))
    (function create unused-untaken (visibility private) (effect pure) (returns Unit)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (in (if (bool true)
          (sequence (call discard (local first)) (call discard (local second)))
          (sequence (call discard (local first)) (call discard (local second))))))))
    (function create unused-owner-result (visibility private) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (local buffer)))

    (function create entry (visibility public) (effect pure) (returns I64)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding one (type ByteBuffer) (call push (i64 40) (local first)))
        (binding before (call size (local one)))
        (binding two (type ByteBuffer) (call push (i64 2) (local one)))
        (binding frozen (call freeze (local two)))
        (binding discarded (type ByteBuffer) (call empty))
        (in (sequence
          (call discard (local discarded))
          (if (call equal (local before) (i64 1))
            (call sum (call bytes-get (local frozen) (i64 0))
              (call bytes-get (local frozen) (i64 1))) (i64 -1)))))))
    (function create binary-entry (visibility public) (effect pure)
      (parameter create input (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (let
        (binding original (type ByteBuffer) (call pair-bytes))
        (binding count (call size (local original)))
        (binding forwarded (type ByteBuffer) (call forward (local original)))
        (binding spare (type ByteBuffer) (call empty))
        (binding returned (type ByteBuffer) (call return-cleanup (local forwarded) (local spare)))
        (binding frozen (call freeze (local returned)))
        (in (record structural
          (field diagnostic (if (call equal (local count) (i64 2)) (i64 0) (i64 99)))
          (field image (call bytes-concat
            (call bytes-concat (call choice-bytes (bool true)) (call choice-bytes (bool false)))
            (call bytes-concat (local frozen) (local input)))))))))

    (component create main (visibility public)
      (port create run (type (function () I64)) (function entry)))
    (component create scopes (visibility public)
      (port create run (type (function () I64)) (function scope-cleanup)))
    (component create borrowed (visibility public)
      (port create run (type (function () I64)) (function fallback-size)))
    (component create sequence (visibility public)
      (port create run (type (function () I64)) (function sequence-cleanup)))
    (component create tail (visibility public)
      (port create run (type (function () I64)) (function tail-entry)))
    (component create binary (visibility public)
      (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function binary-entry))))
  (target create scalar-main (component custody-controls::main)
    (runner command) (port custody-controls::main::run))
  (target create custody-scopes (component custody-controls::scopes)
    (runner command) (port custody-controls::scopes::run))
  (target create custody-borrowed (component custody-controls::borrowed)
    (runner command) (port custody-controls::borrowed::run))
  (target create custody-sequence (component custody-controls::sequence)
    (runner command) (port custody-controls::sequence::run))
  (target create custody-tail (component custody-controls::tail)
    (runner command) (port custody-controls::tail::run))
  (target create custody-binary (component custody-controls::binary)
    (runner command) (port custody-controls::binary::run)))
declarations.end

declarations.begin
(units
  (module create transfer-consumer
    (type-alias AllPair (owned-product (field left ByteBuffer) (field right OwnedI64Cell)))
    (type-alias LeftPair (owned-product (field left ByteBuffer) (field right I64)))
    (type-alias RightPair (owned-product (field left I64) (field right OwnedI64Cell)))
    (type-alias Outcome (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
    (type-alias NestedPair (owned-product (field left AllPair) (field right Outcome)))
    (type-alias WitnessPair (owned-product (field left OwnedI64Cell) (field right OwnedI64Cell)))
    (type-alias Result (record
      (ordinary (record (left (list I64)) (right (list I64))))
      (all (record (bytes Bytes) (length I64) (before I64) (after I64)))
      (mixed-left (record (bytes Bytes) (scalar I64)))
      (mixed-right (record (ordinary I64) (scalar I64)))
      (nested (record (bytes Bytes) (scalar I64) (outcome (record (accepted Bool) (value I64)))))
      (intermediate Bytes) (witnesses (record (left I64) (right I64)))))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create value (type ByteBuffer) (use consume)) (returns Bytes))
    (external create extract (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create initial-buffer (visibility private) (effect pure) (returns ByteBuffer)
      (body (let
        (binding value (type ByteBuffer) (call buffer::buffer-create (i64 0)))
        (binding value (type ByteBuffer) (call buffer::buffer-update (i64 255) (local value)))
        (in (call buffer::buffer-update (i64 128) (local value))))))
    (function create all-owned (visibility private) (effect (task))
      (parameter create n (type I64))
      (returns (record (bytes Bytes) (length I64) (before I64) (after I64)))
      (body (let
        (binding value (type ByteBuffer) (call initial-buffer))
        (binding scalar (type OwnedI64Cell) (call cell::cell-create (i64 0)))
        (binding pair (type AllPair)
          (implementation-call transfer-combinator::witness-pair (types ByteBuffer OwnedI64Cell)
            (implementations concrete@buffer::Octets concrete@cell::Scalar)
            (local n) (local value) (local scalar)))
        (in (unpack-owned (type AllPair) (local pair)
          (field left (binding data (type ByteBuffer)))
          (field right (binding scalar (type OwnedI64Cell)))
          (in (let
            (binding length (type I64)
              (implementation-call abstraction::read-helper (types ByteBuffer)
                (implementations concrete@buffer::Octets) (local data)))
            (binding before (type I64)
              (implementation-call abstraction::read-helper (types OwnedI64Cell)
                (implementations concrete@cell::Scalar) (local scalar)))
            (binding data (type ByteBuffer) (call buffer::buffer-update (i64 9) (local data)))
            (binding scalar (type OwnedI64Cell) (call cell::cell-update (i64 -81) (local scalar)))
            (in (record structural
              (field bytes (call freeze (local data))) (field length (local length))
              (field before (local before)) (field after (call extract (local scalar))))))))))))
    (function create mixed-left (visibility private) (effect (task))
      (parameter create n (type I64)) (returns (record (bytes Bytes) (scalar I64)))
      (body (let
        (binding data (type ByteBuffer) (call initial-buffer))
        (binding data (type ByteBuffer) (call buffer::buffer-update (i64 11) (local data)))
        (binding pair (type LeftPair)
          (call transfer-combinator::mixed-left (types ByteBuffer I64) (local n) (local data)))
        (in (unpack-owned (type LeftPair) (local pair)
          (field left (binding data (type ByteBuffer))) (field right (binding scalar (type I64)))
          (in (record structural
            (field bytes (call freeze (local data))) (field scalar (local scalar)))))))))
    (function create mixed-right (visibility private) (effect (task))
      (parameter create n (type I64)) (returns (record (ordinary I64) (scalar I64)))
      (body (let
        (binding scalar (type OwnedI64Cell) (call cell::cell-create (local n)))
        (binding pair (type RightPair)
          (call transfer-combinator::mixed-right (types I64 OwnedI64Cell) (local n) (local scalar)))
        (in (unpack-owned (type RightPair) (local pair)
          (field left (binding ordinary (type I64)))
          (field right (binding scalar (type OwnedI64Cell)))
          (in (record structural
            (field ordinary (local ordinary)) (field scalar (call extract (local scalar))))))))))
    (function create nested (visibility private) (effect (task))
      (parameter create n (type I64)) (parameter create accepted (type Bool))
      (returns (record (bytes Bytes) (scalar I64) (outcome (record (accepted Bool) (value I64)))))
      (body (let
        (binding data (type ByteBuffer) (call initial-buffer))
        (binding data (type ByteBuffer) (call buffer::buffer-update (i64 64) (local data)))
        (binding scalar (type OwnedI64Cell) (call cell::cell-create (local n)))
        (binding alternate (type OwnedI64Cell) (call cell::cell-create (local n)))
        (binding outcome (type Outcome)
          (call result-workers::choice-job (local accepted) (local alternate)))
        (binding pair (type NestedPair)
          (call transfer-combinator::nested (types ByteBuffer OwnedI64Cell I64)
            (local data) (local scalar) (local outcome)))
        (in (unpack-owned (type NestedPair) (local pair)
          (field left (binding inner (type AllPair)))
          (field right (binding outcome (type Outcome)))
          (in (unpack-owned (type AllPair) (local inner)
            (field left (binding data (type ByteBuffer)))
            (field right (binding scalar (type OwnedI64Cell)))
            (in (record structural
              (field bytes (call freeze (local data)))
              (field scalar (call extract (local scalar)))
              (field outcome
                (match-owned (type Outcome) (local outcome)
                  (case accepted (binding value (type I64))
                    (in (record structural (field accepted (bool true)) (field value (local value)))))
                  (case rejected (binding value (type OwnedI64Cell))
                    (in (record structural
                      (field accepted (bool false)) (field value (call extract (local value)))))))))))))))))
    (function create intermediate (visibility private) (effect (task))
      (returns Bytes)
      (body (let
        (binding data (type ByteBuffer) (call initial-buffer))
        (binding discarded (type ByteBuffer) (call initial-buffer))
        (binding result (type ByteBuffer)
          (call transfer-combinator::first (types ByteBuffer ByteBuffer) (local data) (local discarded)))
        (in (call freeze (local result))))))
    (function create witnesses (visibility private) (effect (task))
      (parameter create n (type I64)) (returns (record (left I64) (right I64)))
      (body (let
        (binding left (type OwnedI64Cell) (call cell::cell-create (i64 0)))
        (binding right (type OwnedI64Cell) (call cell::cell-create (i64 0)))
        (binding pair (type WitnessPair)
          (implementation-call transfer-combinator::witnesses (types OwnedI64Cell)
            (implementations concrete@cell::Scalar concrete@transfer-workers::Fixed)
            (local n) (local left) (local right)))
        (in (unpack-owned (type WitnessPair) (local pair)
          (field left (binding left (type OwnedI64Cell)))
          (field right (binding right (type OwnedI64Cell)))
          (in (record structural
            (field left (call extract (local left))) (field right (call extract (local right))))))))))
    (function create main (visibility public) (effect (task))
      (parameter create n (type I64)) (parameter create accepted (type Bool)) (returns Result)
      (body (record structural
        (field ordinary (call transfer-combinator::ordinary (types (list I64) (list I64))
          (list I64 (local n) (i64 42) (i64 -3)) (list I64 (i64 0) (i64 255) (i64 128))))
        (field all (call all-owned (local n)))
        (field mixed-left (call mixed-left (local n)))
        (field mixed-right (call mixed-right (local n)))
        (field nested (call nested (local n) (local accepted)))
        (field intermediate (call intermediate))
        (field witnesses (call witnesses (local n))))))
    (component create command (visibility private)
      (port create main (type (task-function (I64 Bool) Result (row))) (function main))))
  (target create transferable-parallel (component transfer-consumer::command)
    (runner command) (port transfer-consumer::command::main)))
declarations.end

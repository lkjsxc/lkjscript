declarations.begin
(units (module create native-scalar-probe
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create eq (visibility private) (implementation core.i64.equal)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (external create read (visibility private) (implementation core.bytes.read-i64-le)
    (parameter create input (type Bytes)) (parameter create start (type I64)) (returns I64))
  (external create slice (visibility private) (implementation core.bytes.slice)
    (parameter create input (type Bytes)) (parameter create start (type I64))
    (parameter create end (type I64)) (returns Bytes))
  (external create empty (visibility private) (implementation core.buffer.empty)
    (returns ByteBuffer))
  (external create word (visibility private) (implementation core.buffer.append-i64-le)
    (parameter create value (type I64))
    (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create freeze (visibility private) (implementation core.buffer.freeze)
    (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
  (function create identity (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body (local value)))
  (function create loop (visibility private) (effect pure)
    (parameter create input (type Bytes)) (parameter create cursor (type I64))
    (parameter create end (type I64)) (parameter create value (type I64))
    (parameter create mode (type I64)) (returns I64)
    (body
      (if (call eq (local cursor) (local end))
        (local value)
        (let
          (binding step
            (if (call eq (local mode) (i64 1))
              (call read (call slice (local input) (i64 16) (i64 33)) (i64 0))
              (call read (local input) (i64 16))))
          (binding operand
            (if (call eq (local mode) (i64 2))
              (call identity (local step))
              (local step)))
          (binding next (call add (local value) (local operand)))
          (in (call loop (local input) (call add (local cursor) (i64 1))
            (local end) (local next) (local mode)))))))
  (function create entry (visibility public) (effect pure)
    (parameter create input (type Bytes))
    (returns (record (diagnostic I64) (image Bytes)))
    (body
      (let
        (binding count (call read (local input) (i64 0)))
        (binding seed (call read (local input) (i64 8)))
        (binding mode (call read (local input) (i64 24)))
        (binding end (call add (local seed) (local count)))
        (binding value (call loop (local input) (local seed) (local end) (local seed) (local mode)))
        (binding a (type ByteBuffer) (call empty))
        (binding b (type ByteBuffer) (call word (local value) (local a)))
        (in (record structural (field diagnostic (i64 0)) (field image (call freeze (local b))))))))
))
declarations.end

declarations.begin
(units (module create source-type-fixture
  (record create Left (visibility public)
    (type-parameter create T)
    (field create item (type T))
    (field create nested (type (list T)))
    (field create callback (type (function (T) (list T))))
    (field create related (type (Right T))))
  (record create Right (visibility public)
    (type-parameter create U)
    (field create item (type U))
    (field create nested (type (list U)))
    (field create callback (type (function (U) (list U))))
    (field create related (type (Choice U))))
  (variant create Choice (visibility public)
    (type-parameter create V)
    (case create yes (payload V))
    (case create no))
  (record create Cell (visibility public)
    (type-parameter create W)
    (field create value (type W)))
  (function create first (visibility public) (effect pure)
    (type-parameter create A)
    (parameter create input (type A)) (returns A)
    (body (let (binding kept (type A) (local input)) (in (local kept)))))
  (function create second (visibility public) (effect pure)
    (type-parameter create B)
    (parameter create other (type B)) (returns B) (body (local other)))
  (function create calls (visibility public) (effect pure)
    (type-parameter create C)
    (parameter create argument (type C)) (returns C)
    (body (call first (types C) (local argument))))
  (function create functions (visibility public) (effect pure)
    (type-parameter create D)
    (returns (function (D) D)) (body (function-value first (types D))))
  (function create lists (visibility public) (effect pure)
    (type-parameter create E)
    (parameter create element (type E)) (returns (list E)) (body (list E (local element))))
  (function create choices (visibility public) (effect pure)
    (type-parameter create F)
    (parameter create payload (type F)) (returns (Choice F))
    (body (variant Choice::yes (types F) (local payload))))
  (function create records (visibility public) (effect pure)
    (type-parameter create G)
    (parameter create value (type G)) (returns (Cell G))
    (body (record Cell (types G) (field Cell::value (local value)))))))
declarations.end

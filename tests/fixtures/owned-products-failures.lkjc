declarations.begin
(units (module create failures
  (external create divide (visibility private) (implementation core.i64.divide)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create get (visibility private) (implementation core.buffer.get)
    (parameter create index (type I64)) (parameter create b (type ByteBuffer) (use borrow)) (returns I64))
  (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
  (external create probe (visibility private) (implementation core.i64.add)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (function create divide-first (visibility public) (effect pure) (returns Unit)
    (body (let
      (binding b (type ByteBuffer) (call empty))
      (binding p (type (owned-product (field a I64) (field b ByteBuffer) (field z I64)))
        (pack-owned (type (owned-product (field a I64) (field b ByteBuffer) (field z I64)))
          (field z (call divide (i64 1) (i64 0))) (field a (call get (i64 99) (local b))) (field b (local b))))
      (in (unit)))))
  (function create index-first (visibility public) (effect pure) (returns Unit)
    (body (let
      (binding b (type ByteBuffer) (call empty))
      (binding p (type (owned-product (field a I64) (field b ByteBuffer) (field z I64)))
        (pack-owned (type (owned-product (field a I64) (field b ByteBuffer) (field z I64)))
          (field a (call get (i64 99) (local b))) (field z (call divide (i64 1) (i64 0))) (field b (local b))))
      (in (unit)))))
  (function create observe (visibility private) (effect pure)
    (type-parameter create T (constraint owned)) (parameter create p (type T) (use borrow))
    (returns I64) (body (call probe (i64 0) (i64 0))))
  (function create cancellation (visibility public) (effect pure) (returns I64)
    (body (let
      (binding b (type ByteBuffer) (call empty))
      (binding inner (type (owned-product (field data ByteBuffer)))
        (pack-owned (type (owned-product (field data ByteBuffer))) (field data (local b))))
      (binding c (type ByteBuffer) (call empty))
      (binding outer (type (owned-product (field inner (owned-product (field data ByteBuffer))) (field spare ByteBuffer)))
        (pack-owned (type (owned-product (field inner (owned-product (field data ByteBuffer))) (field spare ByteBuffer)))
          (field inner (local inner)) (field spare (local c))))
      (in (call observe (types (owned-product (field inner (owned-product (field data ByteBuffer))) (field spare ByteBuffer))) (local outer))))))
  (function create field-trap (visibility public) (effect pure) (returns Unit)
    (body (let
      (binding b (type ByteBuffer) (call empty))
      (binding inner (type (owned-product (field data ByteBuffer)))
        (pack-owned (type (owned-product (field data ByteBuffer))) (field data (local b))))
      (binding outer (type (owned-product (field inner (owned-product (field data ByteBuffer))) (field z I64)))
        (pack-owned (type (owned-product (field inner (owned-product (field data ByteBuffer))) (field z I64)))
          (field inner (local inner)) (field z (call divide (i64 1) (i64 0)))))
      (in (unit)))))
  (function create unpack-trap (visibility public) (effect pure) (returns I64)
    (body (let
      (binding b (type ByteBuffer) (call empty))
      (binding inner (type (owned-product (field data ByteBuffer)))
        (pack-owned (type (owned-product (field data ByteBuffer))) (field data (local b))))
      (in (unpack-owned (type (owned-product (field data ByteBuffer))) (local inner)
        (field data (binding data (type ByteBuffer)))
        (in (call get (i64 99) (local data))))))))))
declarations.end

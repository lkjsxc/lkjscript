declarations.begin
(units
  (use std builtin)
  (use producer PRODUCER_PACKAGE PRODUCER_PACKAGE_REVISION)
  (module create transform
    (function create append (visibility public)
      (type-parameter create T)
      (parameter create seed (type T)) (parameter create encode (type (function (T) I64)))
      (parameter create b (type ByteBuffer) (use consume)) (returns ByteBuffer) (effect pure)
      (body (call std::buffer-push (invoke (local encode) (local seed)) (local b))))
    (function create relay (visibility public)
      (type-parameter create T)
      (parameter create seed (type T)) (parameter create encode (type (function (T) I64)))
      (returns ByteBuffer) (effect pure)
      (body (call producer::produce (types T) (local seed) (local encode))))))
declarations.end

declarations.begin
(units
  (use std builtin)
  (module create parallel-workers
    (external create add (visibility private) (implementation core.i64.add)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create subtract (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create octet (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create get (visibility private) (implementation core.buffer.get)
      (parameter create index (type I64))
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create length (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create new-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create read-cell (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create replace-cell (visibility private) (implementation core.cell.replace)
      (parameter create n (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell))
    (external create extract-cell (visibility private) (implementation core.cell.extract)
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64))
    (function create buffer (visibility public)
      (parameter create seed (type I64)) (returns ByteBuffer) (effect pure)
      (body (let (binding empty (type ByteBuffer) (call empty))
        (in (call push (local seed) (local empty))))))
    (function create cell (visibility public)
      (parameter create seed (type I64)) (returns OwnedI64Cell) (effect pure)
      (body (call new-cell (local seed))))
    (function create grow (visibility private)
      (parameter create n (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer) (effect pure)
      (body (if (call less (local n) (i64 1)) (local buffer)
        (let (binding next (type ByteBuffer) (call push (local n) (local buffer)))
          (in (call grow (call subtract (local n) (i64 1)) (local next)))))))
    (function create sum (visibility private)
      (parameter create index (type I64)) (parameter create total (type I64))
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64) (effect pure)
      (body (if (call less (local index) (call length (local buffer)))
        (call sum (call add (local index) (i64 1))
          (call add (local total) (call get (local index) (local buffer))) (local buffer))
        (local total))))
    (function create accumulate (visibility private)
      (parameter create n (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns I64) (effect pure)
      (body (if (call less (local n) (i64 1)) (call extract-cell (local value))
        (let (binding next (type OwnedI64Cell)
          (call replace-cell (call add (local n) (call read-cell (local value))) (local value)))
          (in (call accumulate (call subtract (local n) (i64 1)) (local next)))))))
    (owned-contract create Reduce (visibility public)
      (self Self) (type-parameter create Self (constraint owned))
      (method method_91000000000000000000000000000001 reduce
        (parameters (I64 unrestricted) (Self consume)) (returns I64) (effect (task))))
    (function create generic-reduce (visibility public)
      (type-parameter create T (constraint owned))
      (implementation-parameter implparam_91000000000000000000000000000001 ops Reduce T)
      (parameter create n (type I64)) (parameter create value (type T) (use consume))
      (returns I64) (effect (task))
      (body (method-call parameter@generic-reduce@implparam_91000000000000000000000000000001
        Reduce method_91000000000000000000000000000001 (local n) (local value))))
    (function create reduce-buffer (visibility public)
      (parameter create n (type I64)) (parameter create value (type ByteBuffer) (use consume))
      (returns I64) (effect (task))
      (body (let (binding grown (type ByteBuffer) (call grow (local n) (local value)))
        (in (call sum (i64 0) (i64 0) (local grown))))))
    (function create reduce-cell (visibility public)
      (parameter create n (type I64)) (parameter create value (type OwnedI64Cell) (use consume))
      (returns I64) (effect (task)) (body (call accumulate (local n) (local value))))
    (owned-implementation create Octets (visibility public) (contract Reduce) (self ByteBuffer)
      (method method_91000000000000000000000000000001 reduce-buffer))
    (owned-implementation create Scalar (visibility public) (contract Reduce) (self OwnedI64Cell)
      (method method_91000000000000000000000000000001 reduce-cell))
    (function create buffer-job (visibility public)
      (parameter create n (type I64)) (parameter create value (type ByteBuffer) (use consume))
      (returns I64) (effect (task))
      (body (implementation-call generic-reduce (types ByteBuffer)
        (implementations concrete@Octets) (local n) (local value))))
    (function create cell-job (visibility public)
      (parameter create n (type I64)) (parameter create value (type OwnedI64Cell) (use consume))
      (returns I64) (effect (task))
      (body (implementation-call generic-reduce (types OwnedI64Cell)
        (implementations concrete@Scalar) (local n) (local value))))
    (function create product-job (visibility public)
      (parameter create n (type I64))
      (parameter create packet
        (type (owned-product (field octets ByteBuffer) (field scalar OwnedI64Cell) (field tag I64)))
        (use consume))
      (returns I64) (effect (task))
      (body (unpack-owned
        (type (owned-product (field octets ByteBuffer) (field scalar OwnedI64Cell) (field tag I64)))
        (local packet)
        (field octets (binding octets (type ByteBuffer)))
        (field scalar (binding scalar (type OwnedI64Cell))) (field tag (binding tag (type I64)))
        (in (call add (call add (call buffer-job (local n) (local octets))
          (call cell-job (local n) (local scalar))) (local tag))))))
    (function create choice-job (visibility public)
      (parameter create n (type I64))
      (parameter create choice (type (owned-choice (case scalar OwnedI64Cell) (case octets ByteBuffer)))
        (use consume))
      (returns I64) (effect (task))
      (body (match-owned (type (owned-choice (case scalar OwnedI64Cell) (case octets ByteBuffer)))
        (local choice)
        (case scalar (binding scalar (type OwnedI64Cell)) (in (call cell-job (local n) (local scalar))))
        (case octets (binding octets (type ByteBuffer)) (in (call buffer-job (local n) (local octets)))))))
    (function create pure-buffer (visibility public)
      (parameter create n (type I64)) (parameter create value (type ByteBuffer) (use consume))
      (returns I64) (effect pure) (body (call sum (i64 0) (local n) (local value))))
    (function create borrowed-buffer (visibility public)
      (parameter create n (type I64)) (parameter create value (type ByteBuffer) (use borrow))
      (returns I64) (effect pure) (body (call sum (i64 0) (local n) (local value))))
    (function create ordinary-job (visibility public)
      (parameter create n (type I64)) (returns I64) (effect (task)) (body (local n)))
    (function create available (visibility private) (returns I64) (effect pure) (body (i64 0)))
    (component create authority (visibility public)
      (requirement create clock (interface std::WallClock)
        (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 1 calls)))
      (port create ready (type (function () I64)) (function available)))
    (function create effectful-buffer (visibility public)
      (parameter create n (type I64)) (parameter create value (type ByteBuffer) (use consume))
      (returns I64) (effect (task (requirement authority::clock)))
      (body (sequence (capability-call authority::clock std::WallClock::utc-milliseconds)
        (call buffer-job (local n) (local value)))))))
declarations.end

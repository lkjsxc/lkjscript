declarations.begin
(units
  (use std builtin)
  (module create generic-queue (as $module)
    (function create read-lease (as $reader) (visibility private)
      (type-parameter create T)
      (parameter create decode (type (function (Bytes) T)))
      (parameter create lease (type (resource std::DurableQueue))
        (use borrow) (requirement queue::jobs))
      (returns T) (effect (task (requirement queue::jobs)))
      (body (invoke (local decode)
        (field (capability-call queue::jobs std::DurableQueue::lease-info (local lease))
          std::QueueLeaseInfo::payload))))
    (function create relay (as $relay) (visibility private)
      (type-parameter create U)
      (parameter create decode (type (function (Bytes) U)))
      (parameter create lease (type (resource std::DurableQueue))
        (use borrow) (requirement queue::jobs))
      (returns U) (effect (task (requirement queue::jobs)))
      (body (call read-lease (types U) (local decode) (local lease))))
    (function create finish (as $finisher) (visibility private)
      (type-parameter create V)
      (parameter create value (type V))
      (parameter create result (type Bytes))
      (parameter create lease (type (resource std::DurableQueue))
        (use consume) (requirement queue::jobs))
      (returns V) (effect (task (requirement queue::jobs)))
      (body (sequence
        (capability-call queue::jobs std::DurableQueue::complete
          (local lease) (i64 0) (local result))
        (local value))))
    (function create process (visibility private)
      (type-parameter create T)
      (parameter create job (type Text))
      (parameter create payload (type Bytes))
      (parameter create decode (type (function (Bytes) T)))
      (parameter create absent (type T))
      (returns T) (effect (task (requirement queue::jobs)))
      (body (sequence
        (capability-call queue::jobs std::DurableQueue::initialize)
        (capability-call queue::jobs std::DurableQueue::enqueue
          (local job) (local job) (local payload) (i64 0) (i64 0))
        (match (capability-call queue::jobs std::DurableQueue::claim
          (text "generic-worker") (i64 0) (i64 1000))
          (arm std::QueueLeaseState::live (payload lease (resource std::DurableQueue))
            (let
              (binding first (call relay (types T) (local decode) (local lease)))
              (binding second (call read-lease (types T) (local decode) (local lease)))
              (in (call finish (types T) (local second) (local payload) (local lease)))))
          (arm std::QueueLeaseState::absent (local absent))))))
    (function create decode-numbers (visibility private)
      (parameter create payload (type Bytes)) (returns (list I64)) (effect pure)
      (body (call std::data-decode-or (types (list I64)) (local payload) (list I64))))
    (function create decode-text (visibility private)
      (parameter create payload (type Bytes)) (returns Text) (effect pure)
      (body (call std::data-decode-or (types Text) (local payload) (text "invalid"))))
    (function create numbers (visibility private)
      (returns (list I64)) (effect (task (requirement queue::jobs)))
      (body (call process (types (list I64)) (text "numbers")
        (call std::data-encode (types (list I64)) (list I64 (i64 7) (i64 42) (i64 -3)))
        (function-value decode-numbers) (list I64))))
    (function create text (visibility private)
      (returns Text) (effect (task (requirement queue::jobs)))
      (body (call process (types Text) (text "text")
        (call std::data-encode (types Text) (text "日本語 + generic"))
        (function-value decode-text) (text "absent"))))
    (component create queue (visibility private)
      (requirement create jobs (interface std::DurableQueue)
        (operations std::DurableQueue::initialize std::DurableQueue::enqueue
          std::DurableQueue::claim std::DurableQueue::lease-info std::DurableQueue::complete)
        (limits (maximum_calls 64 calls)))
      (port create numbers (type (task-function () (list I64) (row (requirement jobs)))) (function numbers))
      (port create text (type (task-function () Text (row (requirement jobs)))) (function text))))
  (target create numbers (component generic-queue::queue) (runner command) (port generic-queue::queue::numbers))
  (target create text (component generic-queue::queue) (runner command) (port generic-queue::queue::text)))
declarations.end

// The production parser is copied unchanged; its child tests can inspect private cursors.
mod ast; mod diagnostic; mod names; mod syntax; mod resolve; mod source;
mod diagnostics {
    #[derive(Clone)]
    pub struct BlockedRegion { pub path: String, pub span: crate::ast::Span, pub kind: String, pub reason: String }
    #[derive(Clone)]
    pub struct Recovery {
        pub span: crate::ast::Span, pub scope: usize, pub block: Option<usize>,
        pub kind: String, pub names: Vec<String>, pub namespace: bool, pub coherence: bool,
        pub diagnostic: crate::ast::Diagnostic,
    }
}
pub fn probe_success() -> usize { syntax::attribute_parser_tests::probe_success() }
pub fn probe_failure() -> usize { syntax::attribute_parser_tests::probe_failure() }
pub fn attribute_failure() -> usize { syntax::attribute_parser_tests::attribute_failure() }
pub fn disabled_items() -> usize { syntax::attribute_parser_tests::disabled_items() }
pub fn cfg_depth() -> usize { syntax::attribute_parser_tests::cfg_depth() }
pub fn cfg_attributes() -> usize { syntax::attribute_parser_tests::cfg_attributes() }
pub fn main() -> usize {
    probe_success() + probe_failure() + attribute_failure() + disabled_items() + cfg_attributes()
}

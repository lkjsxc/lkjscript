declarations.begin
(units (module create binary
  (external create digest (visibility private) (implementation core.bytes.blake3)
    (parameter create data (type Bytes)) (returns Bytes))
  (external create length (visibility private) (implementation core.bytes.length)
    (parameter create data (type Bytes)) (returns I64))
  (external create divide (visibility private) (implementation core.i64.divide)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (function create echo (visibility public) (effect pure)
    (parameter create data (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (record structural (field diagnostic (i64 0)) (field image (local data)))))
  (function create reject (visibility public) (effect pure)
    (parameter create data (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (record structural (field diagnostic (i64 -123)) (field image (local data)))))
  (function create hash (visibility public) (effect pure)
    (parameter create data (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (record structural (field diagnostic (i64 0)) (field image (call digest (local data))))))
  (function create trap (visibility public) (effect pure)
    (parameter create data (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
    (body (record structural
      (field diagnostic (call divide (i64 1) (call length (local data))))
      (field image (local data)))))))
declarations.end

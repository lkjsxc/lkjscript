declarations.begin
(units
  (module create task-consumer
    (function create task-main (visibility public) (effect (task))
      (parameter create n (type I64)) (parameter create accepted (type Bool))
      (returns (record (value I64) (alternate I64) (bytes I64) (product I64)))
      (body (let
        (binding c (type OwnedI64Cell)
          (implementation-call task-transfer::task-produce (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local n)))
        (binding c (type OwnedI64Cell) (call task-transfer::task-relay (types OwnedI64Cell) (local c)))
        (binding outcome (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (implementation-call task-transfer::task-attempt (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local accepted) (local c)))
        (binding forwarded (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (call task-transfer::task-relay (types (owned-choice (case accepted I64) (case rejected OwnedI64Cell))) (local outcome)))
        (binding value (type I64)
          (implementation-call task-transfer::task-recover (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local forwarded)))
        (binding c (type OwnedI64Cell) (call cell::create (local n)))
        (binding outcome (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (implementation-call task-transfer::task-attempt (types OwnedI64Cell)
            (implementations concrete@cell::Alternate) (local accepted) (local c)))
        (binding alternate (type I64)
          (implementation-call task-transfer::task-recover (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local outcome)))
        (binding b (type ByteBuffer)
          (implementation-call task-transfer::task-produce (types ByteBuffer)
            (implementations concrete@buffer::Octets) (i64 128)))
        (binding octets (type (owned-choice (case accepted I64) (case rejected ByteBuffer)))
          (implementation-call task-transfer::task-attempt (types ByteBuffer)
            (implementations concrete@buffer::Octets) (local accepted) (local b)))
        (binding bytes (type I64)
          (implementation-call task-transfer::task-recover (types ByteBuffer)
            (implementations concrete@buffer::Octets) (local octets)))
        (binding c (type OwnedI64Cell) (call cell::create (local n)))
        (binding product (type (owned-product (field tag I64) (field payload OwnedI64Cell)))
          (pack-owned (type (owned-product (field tag I64) (field payload OwnedI64Cell)))
            (field tag (i64 7)) (field payload (local c))))
        (binding product (type (owned-product (field tag I64) (field payload OwnedI64Cell)))
          (call task-transfer::task-relay (types (owned-product (field tag I64) (field payload OwnedI64Cell))) (local product)))
        (binding product-value (type I64)
          (unpack-owned (type (owned-product (field tag I64) (field payload OwnedI64Cell))) (local product)
            (field tag (binding tag (type I64)))
            (field payload (binding payload (type OwnedI64Cell)))
            (in (call cell::read (local payload)))))
        (in (record structural
          (field value (local value)) (field alternate (local alternate))
          (field bytes (local bytes)) (field product (local product-value)))))))
    (component create command (visibility private)
      (port create main
        (type (task-function (I64 Bool) (record (value I64) (alternate I64) (bytes I64) (product I64)) (row)))
        (function task-main))))
  (target create owned-tasks (component task-consumer::command) (runner command) (port task-consumer::command::main)))
declarations.end

declarations.begin
(units (module create closure
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create sub (visibility private) (implementation core.i64.subtract)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create mul (visibility private) (implementation core.i64.multiply)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
  (external create eq (visibility private) (implementation core.i64.equal)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (external create less (visibility private) (implementation core.i64.less)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (external create le (visibility private) (implementation core.i64.less-equal)
    (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
  (external create not (visibility private) (implementation core.bool.not)
    (parameter create a (type Bool)) (returns Bool))
  (external create and (visibility private) (implementation core.bool.and)
    (parameter create a (type Bool)) (parameter create b (type Bool)) (returns Bool))
  (external create or (visibility private) (implementation core.bool.or)
    (parameter create a (type Bool)) (parameter create b (type Bool)) (returns Bool))
  (function create same (visibility private) (effect pure)
    (parameter create a (type Bool)) (parameter create b (type Bool)) (returns Bool)
    (body (if (local a) (local b) (call not (local b)))))
  (function create choose (visibility private) (effect pure)
    (parameter create yes (type Bool)) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
    (body (if (local yes) (local a) (local b))))
  (function create loop (visibility private) (effect pure)
    (parameter create n (type I64)) (parameter create total (type I64)) (returns I64)
    (body (if (call eq (local n) (i64 0)) (local total)
      (call loop (call sub (local n) (i64 1)) (call add (local n) (local total))))))
  (function create factorial (visibility private) (effect pure)
    (parameter create n (type I64)) (returns I64)
    (body (if (call eq (local n) (i64 0)) (i64 1)
      (call mul (local n) (call factorial (call sub (local n) (i64 1)))))))
  (function create even (visibility private) (effect pure)
    (parameter create n (type I64)) (returns Bool)
    (body (if (call eq (local n) (i64 0)) (bool true) (call odd (call sub (local n) (i64 1))))))
  (function create odd (visibility private) (effect pure)
    (parameter create n (type I64)) (returns Bool)
    (body (if (call eq (local n) (i64 0)) (bool false) (call even (call sub (local n) (i64 1))))))
  (function create branch-true (visibility public) (effect pure) (returns I64)
    (body (call choose (bool true) (i64 42) (i64 17))))
  (function create branch-false (visibility public) (effect pure) (returns I64)
    (body (call choose (bool false) (i64 42) (i64 17))))
  (function create tail-loop (visibility public) (effect pure) (returns I64)
    (body (call loop (i64 100000) (i64 0))))
  (function create recursive (visibility public) (effect pure) (returns I64)
    (body (call factorial (i64 10))))
  (function create mutually-recursive (visibility public) (effect pure) (returns I64)
    (body (call choose (call even (i64 24)) (i64 42) (i64 -1))))
  (function create locals (visibility public) (effect pure) (returns I64)
    (body (let (binding x (i64 6)) (binding y (i64 7))
      (binding yes (call less (local x) (local y)))
      (binding result (if (local yes) (call mul (local x) (local y)) (i64 -1)))
      (in (local result)))))
  (function create bools (visibility public) (effect pure) (returns I64)
    (body (call choose (call and (call not (bool false))
      (call or (call same (bool true) (bool false)) (call le (i64 -1) (i64 0)))) (i64 42) (i64 -1))))
  (function create unit-local (visibility public) (effect pure) (returns I64)
    (body (let (binding x (unit)) (binding y (local x)) (in (i64 42)))))
  (function create untaken-trap (visibility public) (effect pure) (returns I64)
    (body (if (bool true) (i64 42) (call add (i64 9223372036854775807) (i64 1)))))
  (function create called-overflow (visibility public) (effect pure) (returns I64)
    (body (call factorial (i64 21))))
))
declarations.end

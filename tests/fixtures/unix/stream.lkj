//! Raw Wayland wire bytes and affine descriptors; no privileged browser helper.
fn word(bytes: &mut Vec<u8>, value: u32) {
    bytes.push(value as u8);
    bytes.push((value >> 8u32) as u8);
    bytes.push((value >> 16u32) as u8);
    bytes.push((value >> 24u32) as u8);
}
fn packet(sender: u32, opcode: u32, fields: &[u32]) -> Vec<u8> {
    let mut bytes: Vec<u8> = Vec::new();
    word(&mut bytes, sender);
    word(&mut bytes, (((fields.len() * 4usize + 8usize) as u32) << 16u32) | opcode);
    for field in fields { word(&mut bytes, *field); }
    bytes
}
fn until(clock: &mut Clock) -> usize { clock.nanoseconds().unwrap() + 5_000_000_000usize }
fn send(socket: &mut File, bytes: &[u8], files: Vec<File>, clock: &mut Clock) {
    let mut sent = socket.send_message(bytes, files, until(clock)).unwrap();
    assert!(sent > 0usize);
    while sent < bytes.len() {
        let empty: Vec<File> = Vec::new();
        let count = socket.send_message(&bytes[sent..], empty, until(clock)).unwrap();
        assert!(count > 0usize);
        sent += count;
    }
}
fn send_bytes(socket: &mut File, bytes: &[u8], clock: &mut Clock) {
    let empty: Vec<File> = Vec::new();
    send(socket, bytes, empty, clock);
}
fn receive(socket: &mut File, length: usize, clock: &mut Clock) -> (Vec<u8>, Vec<File>) {
    let mut bytes = vec![0u8; length];
    let mut files: Vec<File> = Vec::new();
    let mut offset = 0usize;
    while offset < length {
        let (count, owned) = socket.receive_message(&mut bytes[offset..], 4usize, until(clock)).unwrap();
        assert!(count > 0usize);
        for file in owned { files.push(file); }
        offset += count;
    }
    (bytes, files)
}
fn expect(socket: &mut File, expected: &[u8], clock: &mut Clock) {
    let (bytes, files) = receive(socket, expected.len(), clock);
    assert_eq!(bytes.as_slice(), expected);
    assert_eq!(files.len(), 0usize);
}
fn exercise(mut socket: File, mut root: Directory, mut clock: Clock, mut ready: Readiness) -> usize {
    let request = packet(1u32, 1u32, &[2u32]); // wl_display.get_registry(new registry=2).
    send_bytes(&mut socket, &request, &mut clock);
    ready.watch_file(&mut socket, 91usize, 1u8).unwrap();
    let deadline = until(&mut clock);
    let events = ready.wait(&mut clock, deadline).unwrap();
    assert!(!events.is_empty());
    assert_eq!(events[0usize].0, 91usize);
    ready.unwatch_file(&mut socket).unwrap();
    let shm = packet(2u32, 0u32, &[7u32, 7u32, 0x735f6c77u32, 0x00006d68u32, 1u32]);
    expect(&mut socket, &shm, &mut clock);
    let bind = packet(2u32, 0u32, &[7u32, 7u32, 0x735f6c77u32, 0x00006d68u32, 1u32, 3u32]);
    send_bytes(&mut socket, &bind, &mut clock); // registry.bind(wl_shm).
    let seat = packet(2u32, 0u32, &[8u32, 8u32, 0x735f6c77u32, 0x00746165u32, 1u32]);
    expect(&mut socket, &seat, &mut clock);
    let bind = packet(2u32, 0u32, &[8u32, 8u32, 0x735f6c77u32, 0x00746165u32, 1u32, 4u32]);
    send_bytes(&mut socket, &bind, &mut clock);
    let keyboard = packet(4u32, 1u32, &[5u32]);
    send_bytes(&mut socket, &keyboard, &mut clock);
    let keymap = packet(5u32, 0u32, &[1u32, 4u32]);
    let (bytes, mut files) = receive(&mut socket, keymap.len(), &mut clock);
    assert_eq!(bytes.as_slice(), keymap.as_slice());
    assert_eq!(files.len(), 1usize);
    let mut keymap = files.pop().unwrap();
    let mut keybytes = [0u8; 4];
    assert_eq!(keymap.read(&mut keybytes).unwrap(), 4usize);
    assert_eq!(&keybytes[..], b"key\0");
    send_bytes(&mut socket, b"K", &mut clock); // Let the witness inspect CLOEXEC while held.
    expect(&mut socket, b"C", &mut clock);
    drop(keymap);
    let mut frame = root.create_new("frame").unwrap();
    frame.write_all(&[0x11u8, 0x22u8, 0x33u8, 0xffu8]).unwrap();
    let pool = packet(3u32, 0u32, &[6u32, 4u32]);
    send(&mut socket, &pool, vec![frame], &mut clock); // wl_shm.create_pool consumes its File.
    expect(&mut socket, b"R", &mut clock);

    // An owned File may be another socket kind; message methods must refuse it.
    send_bytes(&mut socket, b"u", &mut clock);
    let (kind_marker, mut wrong_files) = receive(&mut socket, 1usize, &mut clock);
    assert_eq!(kind_marker.as_slice(), b"U");
    assert_eq!(wrong_files.len(), 1usize);
    let mut datagram = wrong_files.pop().unwrap();
    let rejected = root.open("frame").unwrap();
    assert_eq!(datagram.send_message(b"x", vec![rejected], 0usize).err().unwrap(), 91i64);
    let mut kind_bytes = [99u8; 1];
    assert_eq!(datagram.receive_message(&mut kind_bytes, 1usize, 0usize).err().unwrap(), 91i64);
    assert_eq!(kind_bytes[0usize], 99u8);
    drop(datagram);
    send_bytes(&mut socket, b"D", &mut clock);
    // Give the witness one explicit duplicate solely to set a bounded send buffer.
    // The original owner remains live, and the duplicate is consumed normally.
    let tune = socket.duplicate().unwrap();
    send(&mut socket, b"n", vec![tune], &mut clock);
    expect(&mut socket, b"N", &mut clock);
    // One positive partial send transfers its owned rights exactly once.
    {
        let payload = vec![0x5au8; 65_536usize];
        let frame = root.open("frame").unwrap();
        send_bytes(&mut socket, b"p", &mut clock);
        expect(&mut socket, b"go", &mut clock);
        let sent = socket.send_message(&payload, vec![frame], until(&mut clock)).unwrap();
        assert!(sent > 0usize && sent < payload.len());
        send_bytes(&mut socket, &payload[sent..], &mut clock);
        expect(&mut socket, b"Q", &mut clock);
    }
    // Backpressure may consume an owned File without transferring any rights.
    send_bytes(&mut socket, b"b", &mut clock);
    {
        let payload = vec![0x7fu8; 4_096usize];
        let mut full = false;
        while !full {
            let empty: Vec<File> = Vec::new();
            match socket.send_message(&payload, empty, 0usize) {
                Ok(count) => assert!(count > 0usize),
                Err(errno) => { assert_eq!(errno, 110i64); full = true; }
            }
        }
    }
    let failed = root.open("frame").unwrap();
    assert_eq!(socket.send_message(b"x", vec![failed], 0usize).err().unwrap(), 110i64);
    let mut marker = root.create("backpressure-ready").unwrap();
    marker.write_all(b"ready").unwrap();
    drop(marker);
    send_bytes(&mut socket, b"\x01", &mut clock);
    expect(&mut socket, b"B", &mut clock);
    root.remove("backpressure-ready").unwrap();

    // File never assumes a descriptor's kernel kind.
    let mut regular = root.open("frame").unwrap();
    let another = root.open("frame").unwrap();
    assert_eq!(regular.send_message(b"x", vec![another], until(&mut clock)).err().unwrap(), 88i64);
    let mut untouched = [99u8; 1];
    assert_eq!(regular.receive_message(&mut untouched, 1usize, until(&mut clock)).err().unwrap(), 88i64);
    assert_eq!(untouched[0usize], 99u8);
    drop(regular);
    let rejected = root.open("frame").unwrap();
    assert_eq!(socket.send_message(b"", vec![rejected], until(&mut clock)).err().unwrap(), 22i64);
    let mut empty_bytes = [0u8; 0];
    assert_eq!(socket.receive_message(&mut empty_bytes, 1usize, 0usize).err().unwrap(), 22i64);
    assert_eq!(socket.receive_message(&mut untouched, 1usize, 0usize).err().unwrap(), 110i64);
    assert_eq!(untouched[0usize], 99u8);
    assert_eq!(socket.receive_message(&mut untouched, 18_446_744_073_709_551_615usize, 0usize).err().unwrap(), 75i64);
    send_bytes(&mut socket, b"t", &mut clock);
    // CMSG padding can fit two rights when the public limit is one. Exercise
    // both that case and MSG_CTRUNC, plus a zero-rights receive, without leaks.
    for round in 0usize..144usize {
        let limit = if round % 3usize == 2usize { 0usize } else { 1usize };
        assert_eq!(socket.receive_message(&mut untouched, limit, until(&mut clock)).err().unwrap(), 90i64);
        assert_eq!(untouched[0usize], 99u8);
        send_bytes(&mut socket, b"a", &mut clock);
    }
    expect(&mut socket, b"done", &mut clock);
    let (count, files) = socket.receive_message(&mut untouched, 1usize, until(&mut clock)).unwrap();
    assert_eq!(count, 0usize);
    assert_eq!(files.len(), 0usize);
    let broken = root.open("frame").unwrap();
    assert_eq!(socket.send_message(b"x", vec![broken], until(&mut clock)).err().unwrap(), 32i64);
    root.remove("frame").unwrap();
    42usize
}
pub fn main(socket: File, root: Directory, clock: Clock, ready: Readiness) -> usize {
    exercise(socket, root, clock, ready)
}
pub fn directory(mut root: Directory, clock: Clock, ready: Readiness) -> usize {
    let socket = match root.unix_connect("socket") { Ok(socket) => socket, Err(errno) => return errno as usize };
    exercise(socket, root, clock, ready)
}
pub fn world(mut world: World) -> usize {
    let args = world.args();
    assert_eq!(args.len(), 1usize);
    let path = String::from_utf8(args[0usize].clone()).unwrap();
    let socket = world.unix_connect(format!("{}/socket", path).as_str()).unwrap();
    let root = world.directory(path.as_str()).unwrap();
    let clock = world.clock();
    let ready = world.readiness().unwrap();
    exercise(socket, root, clock, ready)
}
pub fn confined(mut root: Directory) -> usize {
    assert!(root.unix_connect("../socket").is_err());
    assert!(root.unix_connect("/socket").is_err());
    assert!(root.unix_connect("escape/socket").is_err());
    assert!(root.unix_connect("socket-link").is_err());
    assert_eq!(root.unix_connect("regular").err().unwrap(), 88i64);
    42usize
}

pub fn pinned(mut root: Directory) -> usize {
    let mut socket = root.unix_connect("socket").unwrap();
    let files: Vec<File> = Vec::new();
    assert_eq!(socket.send_message(b"pinned", files, 18_446_744_073_709_551_615usize).unwrap(), 6usize);
    42usize
}
pub fn wrong_socket(mut target: Connector, mut root: Directory) -> usize {
    let mut socket = target.connect().unwrap();
    let file = root.open("regular").unwrap();
    assert_eq!(socket.send_message(b"x", vec![file], 0usize).err().unwrap(), 97i64);
    let mut bytes = [99u8; 1];
    assert_eq!(socket.receive_message(&mut bytes, 1usize, 0usize).err().unwrap(), 97i64);
    assert_eq!(bytes[0usize], 99u8);
    let marker = root.create("tcp-ready").unwrap();
    drop(marker);
    assert_eq!(socket.read(&mut bytes).unwrap(), 1usize);
    assert_eq!(bytes[0usize], b'd');
    root.remove("tcp-ready").unwrap();
    42usize
}

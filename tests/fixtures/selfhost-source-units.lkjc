declarations.begin
(units
  (module create unit-controls
    (external create sum (visibility private) (implementation core.i64.add)
      (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
    (external create difference (visibility private) (implementation core.i64.subtract)
      (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
    (external create equal (visibility private) (implementation core.i64.equal)
      (parameter create left (type I64)) (parameter create right (type I64)) (returns Bool))
    (external create list-get (visibility private) (implementation core.list.get)
      (type-parameter create T)
      (parameter create values (type (list T))) (parameter create index (type I64)) (returns T))
    (external create list-size (visibility private) (implementation core.list.length)
      (type-parameter create T) (parameter create values (type (list T))) (returns I64))
    (external create empty (visibility private) (implementation core.buffer.empty) (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create byte (type I64))
      (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create size (visibility private) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (external create freeze (visibility private) (implementation core.buffer.freeze)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
    (external create discard (visibility private) (implementation core.buffer.discard)
      (parameter create buffer (type ByteBuffer) (use consume)) (returns Unit))

    (function create literals (visibility private) (effect pure) (returns I64)
      (body (sequence (text "same") (static-text "same") (i64 7))))
    (function create identity (visibility public) (effect pure)
      (parameter create value (type I64)) (returns I64) (body (local value)))
    (function create text-identity (visibility private) (effect pure)
      (parameter create value (type Text)) (returns Text) (body (local value)))
    (function create static-identity (visibility private) (effect pure)
      (parameter create value (type StaticText)) (returns StaticText) (body (local value)))
    (function create annotated (visibility private) (effect pure) (returns I64)
      (body (let (binding number (type I64) (i64 17)) (in (local number)))))
    (function create generic (visibility private) (effect pure) (returns I64)
      (body (call list-get (types I64) (list I64 (i64 11) (i64 22)) (i64 1))))
    (function create generic-size (visibility private) (effect pure) (returns I64)
      (body (call list-size (types I64) (list I64 (i64 11) (i64 22)))))
    (function create fields (visibility private) (effect pure) (returns I64)
      (body (let
        (binding pair (record structural (field zed (i64 10)) (field alpha (i64 20))))
        (in (field (local pair) (name alpha))))))
    (function create unused-branch (visibility private) (effect pure) (returns I64)
      (body (if (bool true) (i64 17) (i64 34))))
    (function create even (visibility private) (effect pure)
      (parameter create remaining (type I64)) (returns Bool)
      (body (if (call equal (local remaining) (i64 0)) (bool true)
        (call odd (call difference (local remaining) (i64 1))))))
    (function create odd (visibility private) (effect pure)
      (parameter create remaining (type I64)) (returns Bool)
      (body (if (call equal (local remaining) (i64 0)) (bool false)
        (call even (call difference (local remaining) (i64 1))))))
    (function create owned-return (visibility private) (effect pure) (returns ByteBuffer)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call push (i64 7) (local first)))
        (binding spare (type ByteBuffer) (call empty))
        (in (local second)))))
    (function create buffer-count (visibility private) (effect pure) (returns I64)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call push (i64 7) (local first)))
        (binding count (call size (local second)))
        (binding frozen (call freeze (local second)))
        (in (local count)))))
    (function create unused-dispose (visibility private) (effect pure) (returns Unit)
      (body (let
        (binding first (type ByteBuffer) (call empty))
        (binding second (type ByteBuffer) (call empty))
        (in (sequence (call discard (local first)) (call discard (local second)))))))
    (function create entry (visibility public) (effect pure) (returns I64)
      (body (call sum (call generic) (call fields))))
    (function create binary-entry (visibility public) (effect pure)
      (parameter create input (type Bytes)) (returns (record (diagnostic I64) (image Bytes)))
      (body (record structural (field image (local input)) (field diagnostic (i64 0)))))
    (component create main (visibility public)
      (port create run (type (function () I64)) (function entry)))
    (component create binary (visibility public)
      (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function binary-entry))))
  (target create scalar-main (component unit-controls::main) (runner command) (port unit-controls::main::run))
  (target create unit-binary (component unit-controls::binary) (runner command) (port unit-controls::binary::run)))
declarations.end

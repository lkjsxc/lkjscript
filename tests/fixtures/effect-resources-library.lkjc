declarations.begin
(units
  (use std builtin)
  (module create resource-library (as $library)
    (function create read-lease (visibility public)
      (type-parameter create T) (effect-parameter create E)
      (parameter create decode (type (task-function (Bytes) T (row (parameter E)))))
      (parameter create lease (type (resource std::DurableQueue))
        (use borrow) (requirement queue::jobs))
      (returns T) (effect (task (requirement queue::jobs) (parameter E)))
      (body (call repeat-read (types T) (effects (row (parameter E)))
        (i64 2) (local decode) (local lease))))
    (function create repeat-read (visibility private)
      (type-parameter create T) (effect-parameter create E)
      (parameter create turns (type I64))
      (parameter create decode (type (task-function (Bytes) T (row (parameter E)))))
      (parameter create lease (type (resource std::DurableQueue))
        (use borrow) (requirement queue::jobs))
      (returns T) (effect (task (requirement queue::jobs) (parameter E)))
      (body (if (call std::i64-equal (local turns) (i64 0))
        (invoke (local decode)
          (field (capability-call queue::jobs std::DurableQueue::lease-info (local lease))
            std::QueueLeaseInfo::payload))
        (call repeat-read (types T) (effects (row (parameter E)))
          (call std::subtract (local turns) (i64 1)) (local decode) (local lease)))))
    (function create finish (visibility public)
      (type-parameter create V) (effect-parameter create E)
      (parameter create decode (type (task-function (Bytes) V (row (parameter E)))))
      (parameter create result (type Bytes))
      (parameter create lease (type (resource std::DurableQueue))
        (use consume) (requirement queue::jobs))
      (returns V) (effect (task (requirement queue::jobs) (parameter E)))
      (body (sequence
        (capability-call queue::jobs std::DurableQueue::complete
          (local lease) (i64 0) (local result))
        (invoke (local decode) (local result)))))
    (function create ready (visibility private)
      (returns Unit) (effect (task (requirement queue::jobs)))
      (body (unit)))
    (component create queue (visibility public)
      (requirement create jobs (interface std::DurableQueue)
        (operations std::DurableQueue::initialize std::DurableQueue::enqueue
          std::DurableQueue::claim std::DurableQueue::lease-info std::DurableQueue::complete)
        (limits (maximum_calls 64 calls)))
      (port create ready (type (task-function () Unit (row (requirement jobs))))
        (function ready)))))
declarations.end

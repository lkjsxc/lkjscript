declarations.begin
(units
  (module create result-workers
    (function create buffer-job (visibility public) (effect (task))
      (parameter create octet (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer)
      (body (implementation-call abstraction::transform (types ByteBuffer)
        (implementations concrete@buffer::Octets) (local octet) (local value))))
    (function create cell-job (visibility public) (effect (task))
      (parameter create n (type I64))
      (parameter create value (type OwnedI64Cell) (use consume)) (returns OwnedI64Cell)
      (body (implementation-call abstraction::transform (types OwnedI64Cell)
        (implementations concrete@cell::Scalar) (local n) (local value))))
    (function create ordinary-job (visibility public) (effect (task))
      (parameter create n (type I64)) (returns I64) (body (local n)))
    (function create nested-job (visibility public) (effect (task))
      (parameter create n (type I64))
      (parameter create value (type ByteBuffer) (use consume))
      (returns (owned-product (field left ByteBuffer) (field right OwnedI64Cell)))
      (body (let (binding scalar (type OwnedI64Cell) (call cell::cell-create (i64 0)))
        (in (parallel
          (call buffer-job (i64 64) (local value))
          (call cell-job (local n) (local scalar)))))))
    (function create choice-job (visibility public) (effect (task))
      (parameter create accepted (type Bool))
      (parameter create value (type OwnedI64Cell) (use consume))
      (returns (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
      (body (if (local accepted)
        (choose-owned (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (case accepted)
          (implementation-call abstraction::consume (types OwnedI64Cell)
            (implementations concrete@cell::Scalar) (local value)))
        (choose-owned (type (owned-choice (case accepted I64) (case rejected OwnedI64Cell)))
          (case rejected) (local value)))))))
declarations.end

declarations.begin
(units
  (module create interface-controls
    (external create list-get (visibility public) (implementation core.list.get)
      (type-parameter create T)
      (parameter create items (type (list T)))
      (parameter create index (type I64)) (returns T))
    (external create list-size (visibility public) (implementation core.list.length)
      (type-parameter create T)
      (parameter create items (type (list T))) (returns I64))
    (external create buffer-size (visibility public) (implementation core.buffer.length)
      (parameter create buffer (type ByteBuffer) (use borrow)) (returns I64))
    (function create text-id (visibility public) (effect pure)
      (parameter create value (type Text)) (returns Text) (body (local value)))
    (function create static-id (visibility public) (effect pure)
      (parameter create value (type StaticText)) (returns StaticText) (body (local value)))
    (function create record-id (visibility public) (effect pure)
      (parameter create value (type (record (numbers (list I64)) (label StaticText))))
      (returns (record (numbers (list I64)) (label StaticText))) (body (local value)))
    (function create transfer (visibility public) (effect pure)
      (parameter create buffer (type ByteBuffer) (use consume))
      (returns ByteBuffer) (body (local buffer)))
    (function create hidden (visibility private) (effect pure) (returns I64) (body (i64 7)))
    (function create entry (visibility public) (effect pure) (returns I64)
      (body (call list-get (types I64) (list I64 (i64 17) (i64 29)) (i64 1))))
    (function create binary-entry (visibility public) (effect pure)
      (parameter create input (type Bytes))
      (returns (record (diagnostic I64) (image Bytes)))
      (body (record structural (field diagnostic (i64 0)) (field image (local input)))))
    (component create main (visibility public)
      (port create run (type (function () I64)) (function entry)))
    (component create binary (visibility public)
      (port create run (type (function (Bytes) (record (diagnostic I64) (image Bytes))))
        (function binary-entry)))
    (component create hidden-component (visibility private)
      (port create run (type (function () I64)) (function hidden))))
  (target create scalar-main (component interface-controls::main) (runner command)
    (port interface-controls::main::run))
  (target create interface-binary (component interface-controls::binary) (runner command)
    (port interface-controls::binary::run))
  (target create unselected (component interface-controls::hidden-component) (runner command)
    (port interface-controls::hidden-component::run)))
declarations.end

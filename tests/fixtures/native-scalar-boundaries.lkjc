declarations.begin
(units (module create native-scalar-boundaries
  (external create add (visibility private) (implementation core.i64.add)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns I64))
  (external create eq (visibility private) (implementation core.i64.equal)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns Bool))
  (external create less (visibility private) (implementation core.i64.less)
    (parameter create left (type I64)) (parameter create right (type I64)) (returns Bool))
  (external create read (visibility private) (implementation core.bytes.read-i64-le)
    (parameter create input (type Bytes)) (parameter create start (type I64)) (returns I64))
  (external create empty (visibility private) (implementation core.buffer.empty)
    (returns ByteBuffer))
  (external create word (visibility private) (implementation core.buffer.append-i64-le)
    (parameter create value (type I64))
    (parameter create buffer (type ByteBuffer) (use consume)) (returns ByteBuffer))
  (external create freeze (visibility private) (implementation core.buffer.freeze)
    (parameter create buffer (type ByteBuffer) (use consume)) (returns Bytes))
  (external create discard (visibility private) (implementation core.buffer.discard)
    (parameter create buffer (type ByteBuffer) (use consume)) (returns Unit))
  (variant create Choice (visibility private)
    (case create none) (case create marker (payload Unit)) (case create number (payload I64)))
  (function create identity (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body (local value)))
  (function create direct (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body
      (let
        (binding forwarded (call identity (local value)))
        (in (if (call less (local value) (i64 0))
          (local forwarded)
          (call identity (local forwarded)))))))
  (function create factory (visibility private) (effect pure)
    (parameter create value (type I64)) (returns (function () I64))
    (body (bind (function-value identity) (local value))))
  (function create captured (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body
      (let
        (binding original (call factory (local value)))
        (binding box (record structural (field run (bind (local original)))))
        (in (invoke (field (local box) (name run)))))))
  (function create nominal (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create kind (type I64)) (returns I64)
    (body
      (let
        (binding choice
          (if (call eq (local kind) (i64 2))
            (variant Choice::none)
            (if (call eq (local kind) (i64 1))
              (variant Choice::marker (unit))
              (variant Choice::number (local value)))))
        (in (match (local choice)
          (arm Choice::none (i64 -1))
          (arm Choice::marker (payload marker Unit) (sequence (local marker) (i64 0)))
          (arm Choice::number (payload number I64) (call identity (local number))))))))
  (function create held (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body
      (let
        (binding scalar (call identity (local value)))
        (binding scratch (type ByteBuffer) (call empty))
        (binding filled (type ByteBuffer) (call word (i64 17) (local scratch)))
        (in (call identity (local scalar))))))
  (function create consumed (visibility private) (effect pure)
    (parameter create value (type I64)) (returns I64)
    (body
      (let
        (binding scalar (call identity (local value)))
        (binding scratch (type ByteBuffer) (call empty))
        (binding filled (type ByteBuffer) (call word (i64 17) (local scratch)))
        (in (sequence
          (call discard (local filled))
          (invoke (bind (function-value identity) (local scalar))))))))
  (function create fallback (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create flag (type Bool)) (returns I64)
    (body
      (if (local flag)
        (local value)
        (field (record structural (field value (local value))) (name value)))))
  (function create fallback-call (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create flag (type Bool)) (returns I64)
    (body
      (let
        (binding answer (call fallback (local value) (local flag)))
        (in (call identity (local answer))))))
  (function create fallback-tail (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create flag (type Bool)) (returns I64)
    (body (call fallback (local value) (local flag))))
  (function create fallback-invoke (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create flag (type Bool)) (returns I64)
    (body
      (let
        (binding bound (bind (function-value fallback) (local value)))
        (binding answer (invoke (local bound) (local flag)))
        (in (call identity (local answer))))))
  (function create fallback-tail-invoke (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create flag (type Bool)) (returns I64)
    (body (invoke (bind (function-value fallback) (local value)) (local flag))))
  (function create checked (visibility private) (effect pure)
    (parameter create value (type I64)) (parameter create delta (type I64)) (returns I64)
    (body
      (let
        (binding scratch (type ByteBuffer) (call empty))
        (binding filled (type ByteBuffer) (call word (local value) (local scratch)))
        (in (call add (local value) (local delta))))))
  (function create entry (visibility public) (effect pure)
    (parameter create input (type Bytes))
    (returns (record (diagnostic I64) (image Bytes)))
    (body
      (let
        (binding selector (call read (local input) (i64 0)))
        (binding value (call read (local input) (i64 8)))
        (binding delta (call read (local input) (i64 16)))
        (binding answer
          (if (call eq (local selector) (i64 0))
            (call direct (local value))
            (if (call eq (local selector) (i64 1))
              (call captured (local value))
              (if (call eq (local selector) (i64 2))
                (call nominal (local value) (local delta))
                (if (call eq (local selector) (i64 3))
                  (call held (local value))
                  (if (call eq (local selector) (i64 4))
                    (call consumed (local value))
                    (if (call eq (local selector) (i64 6))
                      (call fallback-call (local value) (call eq (local delta) (i64 1)))
                      (if (call eq (local selector) (i64 7))
                        (call fallback-tail (local value) (call eq (local delta) (i64 1)))
                        (if (call eq (local selector) (i64 8))
                          (call fallback-invoke (local value) (call eq (local delta) (i64 1)))
                          (if (call eq (local selector) (i64 9))
                            (call fallback-tail-invoke (local value) (call eq (local delta) (i64 1)))
                            (call checked (local value) (local delta))))))))))))
        (binding output (type ByteBuffer) (call empty))
        (binding written (type ByteBuffer) (call word (local answer) (local output)))
        (in (record structural
          (field diagnostic (i64 0))
          (field image (call freeze (local written))))))))
))
declarations.end

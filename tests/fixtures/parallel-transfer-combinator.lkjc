declarations.begin
(units
  (module create transfer-combinator
    (function create ordinary (visibility public) (effect (task))
      (type-parameter create Left (constraint capture-safe transferable))
      (type-parameter create Right (constraint transferable))
      (parameter create left (type Left)) (parameter create right (type Right))
      (returns (record (left Left) (right Right)))
      (body (parallel
        (call transfer-workers::keep (types Left) (local left))
        (call transfer-workers::keep (types Right) (local right)))))
    (function create owned (visibility public) (effect (task))
      (type-parameter create Left (constraint owned transferable))
      (type-parameter create Right (constraint owned transferable))
      (parameter create left (type Left) (use consume))
      (parameter create right (type Right) (use consume))
      (returns (owned-product (field left Left) (field right Right)))
      (body (parallel
        (call transfer-workers::move (types Left) (local left))
        (call transfer-workers::move (types Right) (local right)))))
    (function create witness-pair (visibility public) (effect (task))
      (type-parameter create Left (constraint owned transferable))
      (type-parameter create Right (constraint owned transferable))
      (implementation-parameter implparam_94000000000000000000000000000001 left-ops abstraction::Storage Left)
      (implementation-parameter implparam_94000000000000000000000000000002 right-ops abstraction::Storage Right)
      (parameter create n (type I64))
      (parameter create left (type Left) (use consume))
      (parameter create right (type Right) (use consume))
      (returns (owned-product (field left Left) (field right Right)))
      (body (parallel
        (implementation-call transfer-workers::forward-twice (types Left)
          (implementations parameter@witness-pair@implparam_94000000000000000000000000000001)
          (i64 7) (local left))
        (implementation-call transfer-workers::forward-twice (types Right)
          (implementations parameter@witness-pair@implparam_94000000000000000000000000000002)
          (local n) (local right)))))
    (function create mixed-left (visibility public) (effect (task))
      (type-parameter create Left (constraint owned transferable))
      (type-parameter create Right (constraint transferable))
      (parameter create right (type Right)) (parameter create left (type Left) (use consume))
      (returns (owned-product (field left Left) (field right Right)))
      (body (parallel
        (call transfer-workers::move (types Left) (local left))
        (call transfer-workers::keep (types Right) (local right)))))
    (function create mixed-right (visibility public) (effect (task))
      (type-parameter create Left (constraint transferable))
      (type-parameter create Right (constraint owned transferable))
      (parameter create left (type Left)) (parameter create right (type Right) (use consume))
      (returns (owned-product (field left Left) (field right Right)))
      (body (parallel
        (call transfer-workers::keep (types Left) (local left))
        (call transfer-workers::move (types Right) (local right)))))
    (function create nested (visibility public) (effect (task))
      (type-parameter create Left (constraint owned transferable))
      (type-parameter create Right (constraint owned transferable))
      (type-parameter create Metadata (constraint transferable))
      (parameter create left (type Left) (use consume))
      (parameter create right (type Right) (use consume))
      (parameter create outcome (type (owned-choice (case accepted Metadata) (case rejected Right))) (use consume))
      (returns (owned-product
        (field left (owned-product (field left Left) (field right Right)))
        (field right (owned-choice (case accepted Metadata) (case rejected Right)))))
      (body (parallel
        (call owned (types Left Right) (local left) (local right))
        (call transfer-workers::move (types (owned-choice (case accepted Metadata) (case rejected Right)))
          (local outcome)))))
    (function create first (visibility public) (effect (task))
      (type-parameter create Left (constraint owned transferable))
      (type-parameter create Right (constraint owned transferable))
      (parameter create left (type Left) (use consume))
      (parameter create right (type Right) (use consume)) (returns Left)
      (body (let
        (binding pair (type (owned-product (field left Left) (field right Right)))
          (parallel
            (call transfer-workers::move (types Left) (local left))
            (call transfer-workers::move (types Right) (local right))))
        (in (unpack-owned (type (owned-product (field left Left) (field right Right))) (local pair)
          (field left (binding result (type Left)))
          (field right (binding discarded (type Right)))
          (in (local result)))))))
    (function create witnesses (visibility public) (effect (task))
      (type-parameter create T (constraint owned transferable))
      (implementation-parameter implparam_94000000000000000000000000000003 left-ops abstraction::Storage T)
      (implementation-parameter implparam_94000000000000000000000000000004 right-ops abstraction::Storage T)
      (parameter create n (type I64))
      (parameter create left (type T) (use consume))
      (parameter create right (type T) (use consume))
      (returns (owned-product (field left T) (field right T)))
      (body (parallel
        (implementation-call transfer-workers::forward-twice (types T)
          (implementations parameter@witnesses@implparam_94000000000000000000000000000003)
          (local n) (local left))
        (implementation-call transfer-workers::forward-twice (types T)
          (implementations parameter@witnesses@implparam_94000000000000000000000000000004)
          (local n) (local right)))))))
declarations.end

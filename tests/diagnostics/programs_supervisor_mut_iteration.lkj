use std::workers::Supervisor;
pub fn probe(image:&mut Image,deadline:usize) {
    let mut workers=Vec::new();workers.push(Supervisor::new(image,2usize,deadline).unwrap());
    for worker in &mut workers {worker.shutdown(deadline).unwrap();}
}

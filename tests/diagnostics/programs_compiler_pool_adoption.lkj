use std::process_model::Event;
pub fn probe(image: &mut Image, jobs: &[u64], deadline: usize) -> Result<Vec<u64>, i64> {
    let mut trace: Vec<Event> = Vec::new();
    std::workers::ordered_map(image,4usize,jobs,deadline,&mut trace)
}

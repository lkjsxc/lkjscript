{
  "schema": "lkjscript.capsule",
  "version": 1,
  "id": "semantic-protocol",
  "root": "crates/lkjscript-compiler/src/semantic",
  "kind": "source",
  "purpose": "Own strict bounded Semantic Source queries, diagnostics, and atomic revisioned transactions.",
  "layer": "agent protocol",
  "concepts": [
    "closed Semantic Source schema",
    "semantic query",
    "atomic transaction",
    "bounded local session",
    "typed holes and legal actions",
    "Edition 2 identity projection"
  ],
  "facade": ["crates/lkjscript-compiler/src/semantic/mod.rs"],
  "allowed_dependencies": ["core", "semantic-source"],
  "forbidden_dependencies": ["app", "jit", "vm"],
  "tests": [
    "crates/lkjscript-compiler/src/semantic/tests/mod.rs",
    "crates/lkjscript-compiler/src/semantic/tests/corpus.rs",
    "crates/lkjscript-compiler/src/semantic/tests/edition.rs",
    "crates/lkjscript-compiler/src/semantic/tests/holes/mod.rs",
    "crates/lkjscript-compiler/src/semantic/session/tests/mod.rs",
    "crates/lkjscript-app/tests/semantic_cli.rs"
  ],
  "decisions": [
    "docs/decisions/platform/semantic-source-and-agent-protocol.md",
    "docs/decisions/platform/semantic-source-and-agent-protocol/complete-schema-v1.md",
    "docs/decisions/platform/semantic-source-and-agent-protocol/typed-holes-and-legal-actions.md",
    "docs/decisions/platform/semantic-source-and-agent-protocol/local-session.md",
    "docs/decisions/semantics/edition-2/identity-and-migration.md"
  ],
  "unsafe_boundary": { "status": "forbidden", "boundaries": [] },
  "capability": { "status": "none", "names": [] },
  "provenance": { "class": "authored", "source": "Complete Semantic Source Schema V2 and typed-hole implementation" },
  "verification": [
    "cargo test --locked -p lkjscript-compiler semantic",
    "cargo test --locked -p lkjscript-app --test semantic_cli"
  ],
  "context_card": {
    "goal": "Return deterministic semantic facts and publish only fully validated revisions.",
    "interfaces": [
      "lkjscript_compiler::semantic::execute",
      "lkjscript_compiler::semantic::session::serve",
      "lkjscript semantic"
    ],
    "invariants": [
      "closed JSON schemas",
      "checker-derived hole facts",
      "stale identity rejection",
      "no partial publish"
    ]
  }
}

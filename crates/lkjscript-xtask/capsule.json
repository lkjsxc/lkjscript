{
  "schema": "lkjscript.capsule",
  "version": 1,
  "id": "xtask",
  "root": "crates/lkjscript-xtask",
  "kind": "crate",
  "purpose": "Run verification, bounded structure intelligence, and externalized autonomous work-state commands.",
  "layer": "repository tooling",
  "concepts": [
    "verification",
    "structure audit",
    "repository graph",
    "agent work state",
    "capability status graph"
  ],
  "facade": [
    "crates/lkjscript-xtask/src/main.rs"
  ],
  "allowed_dependencies": [
    "compiler",
    "compiler.source",
    "core"
  ],
  "forbidden_dependencies": [
    "app",
    "jit",
    "vm"
  ],
  "tests": [
    "crates/lkjscript-xtask/src/structure/graph_tests/mod.rs",
    "crates/lkjscript-xtask/src/structure/repository_tests.rs",
    "crates/lkjscript-xtask/src/agent/tests/mod.rs",
    "crates/lkjscript-xtask/src/documentation_status/tests.rs"
  ],
  "decisions": [
    "docs/decisions/platform/bounded-repository-topology.md",
    "docs/decisions/platform/repository-intelligence-graph.md",
    "docs/decisions/platform/agent-work-state.md",
    "docs/operations/status-authority.md"
  ],
  "unsafe_boundary": {
    "status": "forbidden",
    "boundaries": []
  },
  "capability": {
    "status": "uses",
    "names": [
      "repository policy"
    ]
  },
  "provenance": {
    "class": "authored",
    "source": "Rust crate source"
  },
  "verification": [
    "cargo test --locked -p lkjscript-xtask",
    "cargo clippy --locked -p lkjscript-xtask --all-targets -- -D warnings",
    "cargo run --locked -p lkjscript-xtask -- structure check"
  ],
  "context_card": {
    "goal": "Make repository verification, context, and autonomous handoff state deterministic and bounded.",
    "interfaces": [
      "lkjscript-xtask structure",
      "lkjscript-xtask agent",
      "lkjscript-xtask quiet verify"
    ],
    "invariants": [
      "Git-tracked authority",
      "atomic generated state",
      "explicit staleness and truncation",
      "registered cross-authority capability status"
    ]
  }
}

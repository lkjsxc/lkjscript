  "verification": ["cargo test --locked -p lkjscript-xtask", "cargo clippy --locked -p lkjscript-xtask --all-targets -- -D warnings"],
  "context_card": {
    "goal": "Make repository verification and graph answers deterministic, bounded, and evidenced.",

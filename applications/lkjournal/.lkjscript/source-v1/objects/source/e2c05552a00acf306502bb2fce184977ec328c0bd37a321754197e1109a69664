  (fn object-name-valid ((name Text)) Bool
    (call core.bool-and
      (call core.bool-not (call core.text-empty name))
      (call core.bool-and
        (call core.less-equal (call core.text-length name) 512)
        (call core.bool-and
          (call core.bool-not (call core.text-contains name "/"))
          (call core.bool-not (call core.text-contains name "\\"))))))

  (task read-body-text ((body (Stream Bytes))) Text
    (requires (streams streams.ByteStream))
    (call core.bytes-to-text (perform streams read-all body 1048576)))

  (task authenticated-actor
    ((headers (List (Record (name Text) (value Bytes)))) (now I64))
    Text
    (requires (db db.Database))
    (let ((token (call http.bearer-token headers)))
      (if (call core.text-empty token)
        ""
        (let ((rows
          (perform db query
            (static-text "SELECT actor_id FROM lkjournal_sessions WHERE token = $1 AND expires_at_ms > $2 LIMIT 1")
            (list db.SqlValue
              (variant db.SqlValue Text token)
              (variant db.SqlValue I64 now))
            (list db.SqlType (variant db.SqlType Text))
            1)))
          (if (call core.i64-equal (call db.sql-rows-length rows) 1)
              (call sql-text (call db.sql-row-get (call db.sql-rows-get rows 0) 0))
              "")))))

  (task initialize
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (config config.Configuration)
      (bootstrap secrets.SecretVerifier)
      (db db.Database)
      (jobs jobs.DurableQueue)
      (passwords passwords.PasswordHash)
      (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (bootstrap-allowed
            (perform bootstrap matches
              (call core.bytes-from-text (call http.bearer-token (field request headers)))))
          (expected-actor (perform config text (static-text "initial-actor"))))
      (if (call core.bool-or
            (call core.bool-not bootstrap-allowed)
            (call core.bool-or
            (call core.text-empty actor)
            (call core.bool-not (call core.text-equal actor expected-actor))))
          (call json-response 403 "{\"error\":\"initial_actor_denied\"}")
          (let ((password (call core.bytes-from-text (call read-body-text (field request body))))
                (migration
              (perform db migration
                1
                (static-text "a5f8b9481ceed789e245a4d0d94de03ca48d6befb3380cafd03a5894e50000b1")
                (static-text "CREATE TABLE lkjournal_actors (actor_id TEXT PRIMARY KEY, password_hash TEXT NOT NULL, created_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_sessions (token TEXT PRIMARY KEY, actor_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), expires_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_resources (resource_id TEXT PRIMARY KEY, owner_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), title TEXT NOT NULL, body TEXT NOT NULL, revision BIGINT NOT NULL CHECK (revision >= 0), updated_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_snapshots (resource_id TEXT NOT NULL REFERENCES lkjournal_resources(resource_id), revision BIGINT NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, created_at_ms BIGINT NOT NULL, PRIMARY KEY(resource_id, revision)); CREATE TABLE lkjournal_objects (object_key TEXT PRIMARY KEY, owner_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), size_bytes BIGINT NOT NULL, digest TEXT NOT NULL, state TEXT NOT NULL, created_at_ms BIGINT NOT NULL);")))
                (queue (perform jobs initialize))
                (encoded (perform passwords hash password))
                (inserted
                  (perform db execute
                    (static-text "INSERT INTO lkjournal_actors (actor_id, password_hash, created_at_ms) VALUES ($1, $2, 0) ON CONFLICT (actor_id) DO NOTHING")
                    (list db.SqlValue
                      (variant db.SqlValue Text actor)
                      (variant db.SqlValue Text encoded)))))
            (call json-response 200
              (call core.text-concat
                "{\"initialized\":"
                (call core.text-concat
                  (if migration "true" "false")
                  (call core.text-concat
                    ",\"actor_inserted\":"
                    (call core.text-concat
                      (if (call core.i64-equal inserted 1) "true" "false")
                      "}")))))))))

  (task login
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (clock clock.WallClock)
      (db db.Database)
      (passwords passwords.PasswordHash)
      (random random.SecureRandom)
      (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (password (call core.bytes-from-text (call read-body-text (field request body))))
          (rows
            (perform db query
              (static-text "SELECT password_hash FROM lkjournal_actors WHERE actor_id = $1")
              (list db.SqlValue (variant db.SqlValue Text actor))
              (list db.SqlType (variant db.SqlType Text))
              1)))
      (if (call core.i64-equal (call db.sql-rows-length rows) 0)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((encoded (call sql-text (call db.sql-row-get (call db.sql-rows-get rows 0) 0)))
                (verified (perform passwords verify password encoded)))
            (if (call core.bool-not verified)
                (call json-response 401 "{\"error\":\"authentication_failed\"}")
                (let ((now (perform clock utc-milliseconds))
                      (token-bytes (perform random bytes 32))
                      (token (call core.bytes-to-hex token-bytes))
                      (expires (call core.add now 86400000))
                      (published
                        (perform db execute
                          (static-text "INSERT INTO lkjournal_sessions (token, actor_id, expires_at_ms) VALUES ($1, $2, $3)")
                          (list db.SqlValue
                            (variant db.SqlValue Text token)
                            (variant db.SqlValue Text actor)
                            (variant db.SqlValue I64 expires)))))
                  (call json-response 200
                    (call core.text-concat
                      "{\"actor\":"
                      (call core.text-concat
                        (call core.json-string actor)
                        (call core.text-concat
                          ",\"token\":"
                          (call core.text-concat
                            (call core.json-string token)
                            (call core.text-concat
                              ",\"expires_at_ms\":"
                              (call core.text-concat
                                (call core.i64-to-text expires)
                                "}")))))))))))))

  (task create-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (clock clock.WallClock)
      (db db.Database)
      (identifiers identifiers.Identifier)
      (jobs jobs.DurableQueue)
      (streams streams.ByteStream))
    (let ((now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((encoded (perform streams read-all (field request body) 1048576))
                (decoded
                  (call decode-create-input encoded
                    (record domain.CreateInput (title "") (body "")))))
            (if (call core.bool-not (field decoded valid))
                (call json-response 400 "{\"error\":\"json_invalid\"}")
                (let ((input (field decoded value)))
                  (if (call core.bool-or
                        (call core.text-empty (field input title))
                        (call core.bool-not
                          (call core.less-equal (call core.text-length (field input title)) 512)))
                      (call json-response 400 "{\"error\":\"title_invalid\"}")
                      (let ((id (perform identifiers uuid-v4))
                            (published
                              (transaction db transaction-scope
                                (do
                                  (perform transaction-scope execute
                                    (static-text "INSERT INTO lkjournal_resources (resource_id, owner_id, title, body, revision, updated_at_ms) VALUES ($1, $2, $3, $4, 0, $5)")
                                    (list db.SqlValue
                                      (variant db.SqlValue Text id)
                                      (variant db.SqlValue Text actor)
                                      (variant db.SqlValue Text (field input title))
                                      (variant db.SqlValue Text (field input body))
                                      (variant db.SqlValue I64 now)))
                                  (perform transaction-scope execute
                                    (static-text "INSERT INTO lkjournal_snapshots (resource_id, revision, title, body, created_at_ms) VALUES ($1, 0, $2, $3, $4)")
                                    (list db.SqlValue
                                      (variant db.SqlValue Text id)
                                      (variant db.SqlValue Text (field input title))
                                      (variant db.SqlValue Text (field input body))
                                      (variant db.SqlValue I64 now))))))
                            (enqueued
                              (perform jobs enqueue
                                id
                                (call core.text-concat "index:" id)
                                (call core.bytes-from-text id)
                                now
                                now)))
                        (call json-bytes-response 201
                          (call encode-created-response
                            (record domain.CreatedResponse
                              (id id) (revision 0) (job_enqueued true))))))))))))

  (task read-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database))
    (let ((id (call query-one (field request query_parameters) "id"))
          (now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((rows
              (perform db query
                (static-text "SELECT owner_id, title, body, revision FROM lkjournal_resources WHERE resource_id = $1")
                (list db.SqlValue (variant db.SqlValue Text id))
                (list db.SqlType
                  (variant db.SqlType Text)
                  (variant db.SqlType Text)
                  (variant db.SqlType Text)
                  (variant db.SqlType I64))
                1)))
            (if (call core.i64-equal (call db.sql-rows-length rows) 0)
                (call json-response 404 "{\"error\":\"resource_missing\"}")
                (let ((row (call db.sql-rows-get rows 0))
                      (resource
                        (record domain.Resource
                          (id id)
                          (owner (call sql-text (call db.sql-row-get row 0)))
                          (title (call sql-text (call db.sql-row-get row 1)))
                          (body (call sql-text (call db.sql-row-get row 2)))
                          (revision (call sql-i64 (call db.sql-row-get row 3))))))
                  (if (call core.bool-not (call domain.owns actor resource))
                      (call json-response 403 "{\"error\":\"resource_owner_denied\"}")
                      (call json-bytes-response 200
                        (call encode-resource-view
                          (record domain.ResourceView
                            (id (field resource id))
                            (title (field resource title))
                            (body (field resource body))
                            (revision (field resource revision))))))))))))

  (task list-resources
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database))
    (let ((now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((rows
              (perform db query
                (static-text "SELECT resource_id, title, revision FROM lkjournal_resources WHERE owner_id = $1 ORDER BY updated_at_ms DESC, resource_id ASC LIMIT 1000")
                (list db.SqlValue (variant db.SqlValue Text actor))
                (list db.SqlType
                  (variant db.SqlType Text)
                  (variant db.SqlType Text)
                  (variant db.SqlType I64))

  (fn json-bytes-response
    ((status I64) (body Bytes))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (record _
      (status status)
      (headers
        (list (Record (name Text) (value Bytes))
          (record _
            (name "content-type")
            (value (call core.bytes-from-text "application/json; charset=utf-8")))))
      (body body)))

  (extern decode-create-input
    ((input Bytes) (fallback domain.CreateInput))
    (Record (valid Bool) (value domain.CreateInput) (error Text))
    core.json.decode-or)

  (extern decode-update-input
    ((input Bytes) (fallback domain.UpdateInput))
    (Record (valid Bool) (value domain.UpdateInput) (error Text))
    core.json.decode-or)

  (extern encode-resource-view ((value domain.ResourceView)) Bytes core.json.encode)
  (extern encode-create-input ((value domain.CreateInput)) Bytes core.json.encode)
  (extern encode-created-response ((value domain.CreatedResponse)) Bytes core.json.encode)
  (extern encode-updated-response ((value domain.UpdatedResponse)) Bytes core.json.encode)
  (extern encode-resource-summaries
    ((values (List domain.ResourceSummary))) Bytes core.json.encode)
  (extern encode-snapshot-views
    ((values (List domain.SnapshotView))) Bytes core.json.encode)

  (extern append-resource-summary
    ((values (List domain.ResourceSummary)) (value domain.ResourceSummary))
    (List domain.ResourceSummary)
    core.list.append)

  (extern resource-summary-length
    ((values (List domain.ResourceSummary))) I64 core.list.length)

  (extern append-snapshot-view
    ((values (List domain.SnapshotView)) (value domain.SnapshotView))
    (List domain.SnapshotView)
    core.list.append)

  (fn query-one
    ((parameters (Map Text (List Text))) (name Text))
    Text
    (call core.text-list-get
      (call core.query-get-or parameters name (list Text ""))
      0))

  (fn route
    ((request (Record
      (method Text)
      (path Text)
      (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes))))
     (method Text) (path Text))
    Bool
    (call core.bool-and
      (call core.text-equal (field request method) method)
      (call core.text-equal (field request path) path)))

  (fn sql-text ((value db.SqlValue)) Text
    (match value
      (case Text text text)
      (case Bool value "")
      (case I64 value "")
      (case Bytes value "")
      (case NullBool "")
      (case NullI64 "")
      (case NullText "")
      (case NullBytes "")))

  (fn sql-i64 ((value db.SqlValue)) I64
    (match value
      (case I64 number number)
      (case Bool value -1)
      (case Text value -1)
      (case Bytes value -1)
      (case NullBool -1)
      (case NullI64 -1)
      (case NullText -1)
      (case NullBytes -1)))

  (fn sql-bool ((value db.SqlValue)) Bool
    (match value
      (case Bool boolean boolean)
      (case I64 value false)
      (case Text value false)
      (case Bytes value false)
      (case NullBool false)
      (case NullI64 false)
      (case NullText false)
      (case NullBytes false)))

  (fn resource-summaries
    ((rows (List (List db.SqlValue)))
     (index I64)
     (output (List domain.ResourceSummary)))
    (List domain.ResourceSummary)
    (if (call core.i64-equal index (call db.sql-rows-length rows))
        output
        (let ((row (call db.sql-rows-get rows index)))
          (call resource-summaries
            rows
            (call core.add index 1)
            (call append-resource-summary output
              (record domain.ResourceSummary
                (id (call sql-text (call db.sql-row-get row 0)))
                (title (call sql-text (call db.sql-row-get row 1)))
                (revision (call sql-i64 (call db.sql-row-get row 2)))))))))

  (fn snapshot-views
    ((rows (List (List db.SqlValue)))
     (index I64)
     (output (List domain.SnapshotView)))
    (List domain.SnapshotView)
    (if (call core.i64-equal index (call db.sql-rows-length rows))

          (call snapshot-views
            rows
            (call core.add index 1)
            (call append-snapshot-view output
              (record domain.SnapshotView
                (revision (call sql-i64 (call db.sql-row-get row 0)))
                (title (call sql-text (call db.sql-row-get row 1)))
                (body (call sql-text (call db.sql-row-get row 2)))))))))

  (extern object-receipts-length
    ((receipts (List (Record
      (key Text) (size I64) (blake3 Text) (version Text) (cleanup_pending Bool)))))
    I64
    core.list.length)

  (extern object-receipts-get
    ((receipts (List (Record
      (key Text) (size I64) (blake3 Text) (version Text) (cleanup_pending Bool))))

    (requires (clock clock.WallClock) (db db.Database))
    (let ((now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((id (call query-one (field request query_parameters) "id"))
                (rows
                  (perform db query
                    (static-text "SELECT snapshots.revision, snapshots.title, snapshots.body FROM lkjournal_snapshots AS snapshots INNER JOIN lkjournal_resources AS resources ON resources.resource_id = snapshots.resource_id WHERE snapshots.resource_id = $1 AND resources.owner_id = $2 ORDER BY snapshots.revision ASC LIMIT 1000")
                    (list db.SqlValue
                      (variant db.SqlValue Text id)
                      (variant db.SqlValue Text actor))
                    (list db.SqlType
                      (variant db.SqlType I64)
                      (variant db.SqlType Text)
                      (variant db.SqlType Text))
                    1000)))
            (call json-bytes-response 200
              (call encode-snapshot-views
                (call snapshot-views rows 0 (list domain.SnapshotView))))))))

  (task update-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database) (streams streams.ByteStream))
    (let ((now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((id (call query-one (field request query_parameters) "id"))
                (encoded (perform streams read-all (field request body) 1048576))
                (decoded
                  (call decode-update-input encoded
                    (record domain.UpdateInput (title "") (body "") (base 0)))))
            (if (call core.bool-not (field decoded valid))
                (call json-response 400 "{\"error\":\"json_invalid\"}")
                (let ((input (field decoded value))
                      (base (field (field decoded value) base))
                      (next (call core.add base 1))
                      (changed
                        (transaction db transaction-scope
                          (let ((count
                              (perform transaction-scope execute
                                (static-text "UPDATE lkjournal_resources SET title = $1, body = $2, revision = revision + 1, updated_at_ms = $3 WHERE resource_id = $4 AND owner_id = $5 AND revision = $6")
                                (list db.SqlValue
                                  (variant db.SqlValue Text (field input title))
                                  (variant db.SqlValue Text (field input body))
                                  (variant db.SqlValue I64 now)
                                  (variant db.SqlValue Text id)
                                  (variant db.SqlValue Text actor)
                                  (variant db.SqlValue I64 base)))))
                            (if (call core.i64-equal count 1)
                                (do
                                  (perform transaction-scope execute
                                    (static-text "INSERT INTO lkjournal_snapshots (resource_id, revision, title, body, created_at_ms) VALUES ($1, $2, $3, $4, $5)")
                                    (list db.SqlValue
                                      (variant db.SqlValue Text id)
                                      (variant db.SqlValue I64 next)
                                      (variant db.SqlValue Text (field input title))
                                      (variant db.SqlValue Text (field input body))
                                      (variant db.SqlValue I64 now)))
                                  true)
                                false)))))
                  (if changed
                      (call json-bytes-response 200
                        (call encode-updated-response
                          (record domain.UpdatedResponse (id id) (revision next))))
                      (call json-response 409 "{\"error\":\"stale_or_denied\"}"))))))))

  (task publish-object
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database) (objects objects.ObjectStorage))
    (let ((name (call query-one (field request query_parameters) "name"))
          (now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (if (call core.bool-not (call object-name-valid name))
              (call json-response 400 "{\"error\":\"object_name_invalid\"}")
              (let ((key (call core.text-concat actor (call core.text-concat "/" name)))
                    (pending
                      (perform db execute
                        (static-text "INSERT INTO lkjournal_objects (object_key, owner_id, size_bytes, digest, state, created_at_ms) VALUES ($1, $2, 0, '', 'pending', $3)")
                        (list db.SqlValue
                          (variant db.SqlValue Text key)
                          (variant db.SqlValue Text actor)
                          (variant db.SqlValue I64 now))))
                    (receipt (perform objects put-new key (field request body) (static-text "application/octet-stream")))
                    (published
                      (perform db execute
                        (static-text "UPDATE lkjournal_objects SET size_bytes = $1, digest = $2, state = 'ready' WHERE object_key = $3 AND owner_id = $4 AND state = 'pending'")
                        (list db.SqlValue
                          (variant db.SqlValue I64 (field receipt size))
                          (variant db.SqlValue Text (field receipt blake3))
                          (variant db.SqlValue Text key)
                          (variant db.SqlValue Text actor)))))
                (call json-response 201
                  (call core.text-concat
                    "{\"key\":"
                    (call core.text-concat
                      (call core.json-string key)
                      (call core.text-concat
                        ",\"bytes\":"
                        (call core.text-concat
                          (call core.i64-to-text (field receipt size))
                          "}"))))))))))

  (task reconcile-object
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database) (objects objects.ObjectStorage))
    (let ((name (call query-one (field request query_parameters) "name"))
          (now (perform clock utc-milliseconds))
          (actor (call authenticated-actor (field request headers) now)))
      (if (call core.text-empty actor)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (if (call core.bool-not (call object-name-valid name))
              (call json-response 400 "{\"error\":\"object_name_invalid\"}")
              (let ((key (call core.text-concat actor (call core.text-concat "/" name)))
                    (pending-rows
                      (perform db query
                        (static-text "SELECT EXISTS (SELECT 1 FROM lkjournal_objects WHERE object_key = $1 AND owner_id = $2 AND state = 'pending')")
                        (list db.SqlValue
                          (variant db.SqlValue Text key)
                          (variant db.SqlValue Text actor))
                        (list db.SqlType (variant db.SqlType Bool))
                        1))
                    (pending
                      (if (call core.i64-equal (call db.sql-rows-length pending-rows) 1)
                          (call sql-bool (call db.sql-row-get (call db.sql-rows-get pending-rows 0) 0))
                          false)))
                (if (call core.bool-not pending)
                    (call json-response 404 "{\"error\":\"pending_object_missing\"}")
                    (let ((receipts (perform objects reconcile-put key)))
                      (if (call core.i64-equal (call object-receipts-length receipts) 0)
                          (let ((removed
                              (perform db execute
                                (static-text "DELETE FROM lkjournal_objects WHERE object_key = $1 AND owner_id = $2 AND state = 'pending'")
                                (list db.SqlValue
                                  (variant db.SqlValue Text key)
                                  (variant db.SqlValue Text actor)))))
                            (call json-response 409 "{\"error\":\"object_absent_pending_removed\"}"))
                          (let ((receipt (call object-receipts-get receipts 0))
                                (published
                                  (perform db execute
                                    (static-text "UPDATE lkjournal_objects SET size_bytes = $1, digest = $2, state = 'ready' WHERE object_key = $3 AND owner_id = $4 AND state = 'pending'")
                                    (list db.SqlValue
                                      (variant db.SqlValue I64 (field receipt size))
                                      (variant db.SqlValue Text (field receipt blake3))
                                      (variant db.SqlValue Text key)
                                      (variant db.SqlValue Text actor)))))
                            (call json-response 200
                              (call core.text-concat
                                "{\"reconciled\":true,\"bytes\":"
                                (call core.text-concat
                                  (call core.i64-to-text (field receipt size))
                                  "}"))))))))))))


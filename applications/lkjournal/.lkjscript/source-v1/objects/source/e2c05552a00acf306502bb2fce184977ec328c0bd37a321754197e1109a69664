  (fn text-response
    ((status I64) (content-type Text) (body Text))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (record _
      (status status)
      (headers
        (list (Record (name Text) (value Bytes))
          (record _ (name "content-type") (value (call core.bytes-from-text content-type)))))
      (body (call core.bytes-from-text body))))

  (fn json-response
    ((status I64) (body Text))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (call text-response status "application/json; charset=utf-8" body))

  (fn html-response
    ((status I64) (body Text))

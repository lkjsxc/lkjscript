(module service
  (import domain domain)
  (import clock std.clock)
  (import config std.configuration)
  (import core std.core)
  (import db std.database)
  (import identifiers std.identifier)
  (import objects std.object)
  (import passwords std.password)
  (import jobs std.queue)
  (import random std.random)
  (import streams std.stream)
  (export Web handle)

  (fn text-response
    ((status I64) (content-type Text) (body Text))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (record _
      (status status)
      (headers
        (list (Record (name Text) (value Bytes))
          (record _ (name "content-type") (value (call core.bytes-from-text content-type)))))
      (body (call core.bytes-from-text body))))

  (fn json-response
    ((status I64) (body Text))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (call text-response status "application/json; charset=utf-8" body))

  (fn html-response
    ((status I64) (body Text))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (call text-response status "text/html; charset=utf-8" body))

  (fn query-one
    ((parameters (Map Text (List Text))) (name Text))
    Text
    (call core.text-list-get
      (call core.query-get-or parameters name (list Text ""))
      0))

  (fn route
    ((request (Record
      (method Text)
      (path Text)
      (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes))))
     (method Text) (path Text))
    Bool
    (call core.bool-and
      (call core.text-equal (field request method) method)
      (call core.text-equal (field request path) path)))

  (fn sql-text ((value db.SqlValue)) Text
    (match value
      (case Text text text)
      (case Bool value "")
      (case I64 value "")
      (case Bytes value "")
      (case NullBool "")
      (case NullI64 "")
      (case NullText "")
      (case NullBytes "")))

  (fn sql-i64 ((value db.SqlValue)) I64
    (match value
      (case I64 number number)
      (case Bool value -1)
      (case Text value -1)
      (case Bytes value -1)
      (case NullBool -1)
      (case NullI64 -1)
      (case NullText -1)
      (case NullBytes -1)))

  (fn sql-bool ((value db.SqlValue)) Bool
    (match value
      (case Bool boolean boolean)
      (case I64 value false)
      (case Text value false)
      (case Bytes value false)
      (case NullBool false)
      (case NullI64 false)
      (case NullText false)
      (case NullBytes false)))

  (task read-body-text ((body (Stream Bytes))) Text
    (requires (streams streams.ByteStream))
    (let ((part (perform streams read body)))
      (do
        (perform streams close body)
        (if (field part done)
            ""
            (call core.bytes-to-text (field part chunk))))))

  (task authenticated ((actor Text) (token Text) (now I64)) Bool
    (requires (db db.Database))
    (if (call core.bool-or (call core.text-empty actor) (call core.text-empty token))
        false
        (let ((rows
          (perform db query
            (static-text "SELECT EXISTS (SELECT 1 FROM lkjournal_sessions WHERE token = $1 AND actor_id = $2 AND expires_at_ms > $3)")
            (list db.SqlValue
              (variant db.SqlValue Text token)
              (variant db.SqlValue Text actor)
              (variant db.SqlValue I64 now))
            (list db.SqlType (variant db.SqlType Bool))
            1)))
          (if (call core.i64-equal (call db.sql-rows-length rows) 1)
              (call sql-bool (call db.sql-row-get (call db.sql-rows-get rows 0) 0))
              false))))

  (task initialize
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (config config.Configuration)
      (db db.Database)
      (jobs jobs.DurableQueue)
      (passwords passwords.PasswordHash)
      (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (password (call core.bytes-from-text (call read-body-text (field request body))))
          (expected-actor (perform config text (static-text "initial-actor"))))
      (if (call core.bool-or
            (call core.text-empty actor)
            (call core.bool-not (call core.text-equal actor expected-actor)))
          (call json-response 403 "{\"error\":\"initial_actor_denied\"}")
          (let ((migration
              (perform db migration
                1
                (static-text "a5f8b9481ceed789e245a4d0d94de03ca48d6befb3380cafd03a5894e50000b1")
                (static-text "CREATE TABLE lkjournal_actors (actor_id TEXT PRIMARY KEY, password_hash TEXT NOT NULL, created_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_sessions (token TEXT PRIMARY KEY, actor_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), expires_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_resources (resource_id TEXT PRIMARY KEY, owner_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), title TEXT NOT NULL, body TEXT NOT NULL, revision BIGINT NOT NULL CHECK (revision >= 0), updated_at_ms BIGINT NOT NULL); CREATE TABLE lkjournal_snapshots (resource_id TEXT NOT NULL REFERENCES lkjournal_resources(resource_id), revision BIGINT NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, created_at_ms BIGINT NOT NULL, PRIMARY KEY(resource_id, revision)); CREATE TABLE lkjournal_objects (object_key TEXT PRIMARY KEY, owner_id TEXT NOT NULL REFERENCES lkjournal_actors(actor_id), size_bytes BIGINT NOT NULL, digest TEXT NOT NULL, state TEXT NOT NULL, created_at_ms BIGINT NOT NULL);")))
                (queue (perform jobs initialize))
                (encoded (perform passwords hash password))
                (inserted
                  (perform db execute
                    (static-text "INSERT INTO lkjournal_actors (actor_id, password_hash, created_at_ms) VALUES ($1, $2, 0) ON CONFLICT (actor_id) DO NOTHING")
                    (list db.SqlValue
                      (variant db.SqlValue Text actor)
                      (variant db.SqlValue Text encoded)))))
            (call json-response 200
              (call core.text-concat
                "{\"initialized\":"
                (call core.text-concat
                  (if migration "true" "false")
                  (call core.text-concat
                    ",\"actor_inserted\":"
                    (call core.text-concat
                      (if (call core.i64-equal inserted 1) "true" "false")
                      "}")))))))))

  (task login
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (clock clock.WallClock)
      (db db.Database)
      (passwords passwords.PasswordHash)
      (random random.SecureRandom)
      (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (password (call core.bytes-from-text (call read-body-text (field request body))))
          (rows
            (perform db query
              (static-text "SELECT password_hash FROM lkjournal_actors WHERE actor_id = $1")
              (list db.SqlValue (variant db.SqlValue Text actor))
              (list db.SqlType (variant db.SqlType Text))
              1)))
      (if (call core.i64-equal (call db.sql-rows-length rows) 0)
          (call json-response 401 "{\"error\":\"authentication_failed\"}")
          (let ((encoded (call sql-text (call db.sql-row-get (call db.sql-rows-get rows 0) 0)))
                (verified (perform passwords verify password encoded)))
            (if (call core.bool-not verified)
                (call json-response 401 "{\"error\":\"authentication_failed\"}")
                (let ((now (perform clock utc-milliseconds))
                      (token-bytes (perform random bytes 32))
                      (token (call core.bytes-to-hex token-bytes))
                      (expires (call core.add now 86400000))
                      (published
                        (perform db execute
                          (static-text "INSERT INTO lkjournal_sessions (token, actor_id, expires_at_ms) VALUES ($1, $2, $3)")
                          (list db.SqlValue
                            (variant db.SqlValue Text token)
                            (variant db.SqlValue Text actor)
                            (variant db.SqlValue I64 expires)))))
                  (call json-response 200
                    (call core.text-concat
                      "{\"actor\":"
                      (call core.text-concat
                        (call core.json-string actor)
                        (call core.text-concat
                          ",\"token\":"
                          (call core.text-concat
                            (call core.json-string token)
                            (call core.text-concat
                              ",\"expires_at_ms\":"
                              (call core.text-concat
                                (call core.i64-to-text expires)
                                "}")))))))))))))

  (task create-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (clock clock.WallClock)
      (db db.Database)
      (identifiers identifiers.Identifier)
      (jobs jobs.DurableQueue)
      (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (token (call query-one (field request query_parameters) "token"))
          (title (call query-one (field request query_parameters) "title"))
          (now (perform clock utc-milliseconds))
          (allowed (call authenticated actor token now)))
      (if (call core.bool-not allowed)
          (call json-response 403 "{\"error\":\"authorization_denied\"}")
          (let ((body (call read-body-text (field request body)))
                (id (perform identifiers uuid-v4))
                (published
                  (transaction db transaction-scope
                    (do
                      (perform transaction-scope execute
                        (static-text "INSERT INTO lkjournal_resources (resource_id, owner_id, title, body, revision, updated_at_ms) VALUES ($1, $2, $3, $4, 0, $5)")
                        (list db.SqlValue
                          (variant db.SqlValue Text id)
                          (variant db.SqlValue Text actor)
                          (variant db.SqlValue Text title)
                          (variant db.SqlValue Text body)
                          (variant db.SqlValue I64 now)))
                      (perform transaction-scope execute
                        (static-text "INSERT INTO lkjournal_snapshots (resource_id, revision, title, body, created_at_ms) VALUES ($1, 0, $2, $3, $4)")
                        (list db.SqlValue
                          (variant db.SqlValue Text id)
                          (variant db.SqlValue Text title)
                          (variant db.SqlValue Text body)
                          (variant db.SqlValue I64 now))))))
                (enqueued
                  (perform jobs enqueue
                    id
                    (call core.text-concat "index:" id)
                    (call core.bytes-from-text id)
                    now
                    now)))
            (call json-response 201
              (call core.text-concat
                "{\"id\":"
                (call core.text-concat
                  (call core.json-string id)
                  ",\"revision\":0,\"job_enqueued\":true}")))))))

  (task read-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (token (call query-one (field request query_parameters) "token"))
          (id (call query-one (field request query_parameters) "id"))
          (now (perform clock utc-milliseconds))
          (allowed (call authenticated actor token now)))
      (if (call core.bool-not allowed)
          (call json-response 403 "{\"error\":\"authorization_denied\"}")
          (let ((rows
              (perform db query
                (static-text "SELECT owner_id, title, body, revision FROM lkjournal_resources WHERE resource_id = $1")
                (list db.SqlValue (variant db.SqlValue Text id))
                (list db.SqlType
                  (variant db.SqlType Text)
                  (variant db.SqlType Text)
                  (variant db.SqlType Text)
                  (variant db.SqlType I64))
                1)))
            (if (call core.i64-equal (call db.sql-rows-length rows) 0)
                (call json-response 404 "{\"error\":\"resource_missing\"}")
                (let ((row (call db.sql-rows-get rows 0))
                      (resource
                        (record domain.Resource
                          (id id)
                          (owner (call sql-text (call db.sql-row-get row 0)))
                          (title (call sql-text (call db.sql-row-get row 1)))
                          (body (call sql-text (call db.sql-row-get row 2)))
                          (revision (call sql-i64 (call db.sql-row-get row 3))))))
                  (if (call core.bool-not (call domain.owns actor resource))
                      (call json-response 403 "{\"error\":\"resource_owner_denied\"}")
                      (call json-response 200
                        (call core.text-concat
                          "{\"id\":"
                          (call core.text-concat
                            (call core.json-string (field resource id))
                            (call core.text-concat
                              ",\"title\":"
                              (call core.text-concat
                                (call core.json-string (field resource title))
                                (call core.text-concat
                                  ",\"body\":"
                                  (call core.text-concat
                                    (call core.json-string (field resource body))
                                    (call core.text-concat
                                      ",\"revision\":"
                                      (call core.text-concat
                                        (call core.i64-to-text (field resource revision))
                                        "}"))))))))))))))))

  (task update-resource
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database) (streams streams.ByteStream))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (token (call query-one (field request query_parameters) "token"))
          (id (call query-one (field request query_parameters) "id"))
          (title (call query-one (field request query_parameters) "title"))
          (base (call core.i64-parse (call query-one (field request query_parameters) "base")))
          (now (perform clock utc-milliseconds))
          (allowed (call authenticated actor token now)))
      (if (call core.bool-not allowed)
          (call json-response 403 "{\"error\":\"authorization_denied\"}")
          (let ((body (call read-body-text (field request body)))
                (next (call core.add base 1))
                (changed
                  (transaction db transaction-scope
                    (let ((count
                        (perform transaction-scope execute
                          (static-text "UPDATE lkjournal_resources SET title = $1, body = $2, revision = revision + 1, updated_at_ms = $3 WHERE resource_id = $4 AND owner_id = $5 AND revision = $6")
                          (list db.SqlValue
                            (variant db.SqlValue Text title)
                            (variant db.SqlValue Text body)
                            (variant db.SqlValue I64 now)
                            (variant db.SqlValue Text id)
                            (variant db.SqlValue Text actor)
                            (variant db.SqlValue I64 base)))))
                      (if (call core.i64-equal count 1)
                          (do
                            (perform transaction-scope execute
                              (static-text "INSERT INTO lkjournal_snapshots (resource_id, revision, title, body, created_at_ms) VALUES ($1, $2, $3, $4, $5)")
                              (list db.SqlValue
                                (variant db.SqlValue Text id)
                                (variant db.SqlValue I64 next)
                                (variant db.SqlValue Text title)
                                (variant db.SqlValue Text body)
                                (variant db.SqlValue I64 now)))
                            true)
                          false)))))
            (if changed
                (call json-response 200
                  (call core.text-concat
                    "{\"id\":"
                    (call core.text-concat
                      (call core.json-string id)
                      (call core.text-concat
                        ",\"revision\":"
                        (call core.text-concat (call core.i64-to-text next) "}")))))
                (call json-response 409 "{\"error\":\"stale_or_denied\"}"))))))

  (task publish-object
    ((request (Record
      (method Text) (path Text) (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (clock clock.WallClock) (db db.Database) (objects objects.ObjectStorage))
    (let ((actor (call query-one (field request query_parameters) "actor"))
          (token (call query-one (field request query_parameters) "token"))
          (name (call query-one (field request query_parameters) "name"))
          (now (perform clock utc-milliseconds))
          (allowed (call authenticated actor token now)))
      (if (call core.bool-not allowed)
          (call json-response 403 "{\"error\":\"authorization_denied\"}")
          (let ((key (call core.text-concat actor (call core.text-concat "/" name)))
                (receipt (perform objects put-new key (field request body) (static-text "application/octet-stream")))
                (published
                  (perform db execute
                    (static-text "INSERT INTO lkjournal_objects (object_key, owner_id, size_bytes, digest, state, created_at_ms) VALUES ($1, $2, $3, $4, 'ready', $5)")
                    (list db.SqlValue
                      (variant db.SqlValue Text key)
                      (variant db.SqlValue Text actor)
                      (variant db.SqlValue I64 (field receipt size))
                      (variant db.SqlValue Text (field receipt blake3))
                      (variant db.SqlValue I64 now)))))
            (call json-response 201
              (call core.text-concat
                "{\"key\":"
                (call core.text-concat
                  (call core.json-string key)
                  (call core.text-concat
                    ",\"bytes\":"
                    (call core.text-concat
                      (call core.i64-to-text (field receipt size))
                      "}")))))))))

  (task home
    ()
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires (config config.Configuration))
    (let ((title (perform config text (static-text "service-title"))))
      (call html-response 200
        (call core.text-concat
          "<!doctype html><html><head><meta charset=\"utf-8\"><title>"
          (call core.text-concat
            (call core.html-escape-text title)
            "</title></head><body><h1>lkjournal</h1><p>Actor-aware immutable resource journal.</p></body></html>")))))

  (task handle
    ((request (Record
      (method Text)
      (path Text)
      (query Text)
      (query_parameters (Map Text (List Text)))
      (headers (List (Record (name Text) (value Bytes))))
      (body (Stream Bytes)))))
    (Record
      (status I64)
      (headers (List (Record (name Text) (value Bytes))))
      (body Bytes))
    (requires
      (clock clock.WallClock)
      (config config.Configuration)
      (db db.Database)
      (identifiers identifiers.Identifier)
      (jobs jobs.DurableQueue)
      (objects objects.ObjectStorage)
      (passwords passwords.PasswordHash)
      (random random.SecureRandom)
      (streams streams.ByteStream))
    (if (call route request "GET" "/health")
        (call text-response 200 "text/plain; charset=utf-8" "ready")
        (if (call route request "GET" "/")
            (call home)
            (if (call route request "POST" "/initialize")
                (call initialize request)
                (if (call route request "POST" "/login")
                    (call login request)
                    (if (call route request "POST" "/resources")
                        (call create-resource request)
                        (if (call route request "GET" "/resource")
                            (call read-resource request)
                            (if (call route request "POST" "/resource/update")
                                (call update-resource request)
                                (if (call route request "POST" "/objects")
                                    (call publish-object request)
                                    (call json-response 404 "{\"error\":\"route_missing\"}"))))))))))

  (component Web
    (require clock clock.WallClock (operations utc-milliseconds)
      (limit maximum_calls 16) (limit maximum_output_bytes 256))
    (require config config.Configuration (operations text)
      (limit maximum_calls 8) (limit maximum_output_bytes 4096))
    (require db db.Database (operations execute query migration transaction)
      (limit maximum_calls 32) (limit maximum_input_bytes 1048576)
      (limit maximum_output_bytes 4194304) (limit maximum_rows 1000))
    (require identifiers identifiers.Identifier (operations uuid-v4)
      (limit maximum_calls 8) (limit maximum_output_bytes 512))
    (require jobs jobs.DurableQueue (operations initialize enqueue)
      (limit maximum_calls 8) (limit maximum_input_bytes 1048576)
      (limit maximum_output_bytes 1048576))
    (require objects objects.ObjectStorage (operations put-new)
      (limit maximum_calls 4) (limit maximum_input_bytes 4096)
      (limit maximum_output_bytes 4096) (limit maximum_read_bytes 4194304))
    (require passwords passwords.PasswordHash (operations hash verify)
      (limit maximum_calls 4) (limit maximum_input_bytes 4096)
      (limit maximum_output_bytes 4096))
    (require random random.SecureRandom (operations bytes)
      (limit maximum_calls 4) (limit maximum_random_bytes 64)
      (limit maximum_output_bytes 128))
    (require streams streams.ByteStream (operations read close)
      (limit maximum_calls 8) (limit maximum_output_bytes 1048576))
    (port request
      (Function
        ((Record
          (method Text)
          (path Text)
          (query Text)
          (query_parameters (Map Text (List Text)))
          (headers (List (Record (name Text) (value Bytes))))
          (body (Stream Bytes))))
        (Record
          (status I64)
          (headers (List (Record (name Text) (value Bytes))))
          (body Bytes)))
      (function handle))))

; lkjournal product meaning. These names never enter generic adapters.
(module domain
  (import core std.core)
  (export
    Resource CreateInput UpdateInput ResourceView CreatedResponse UpdatedResponse
    owns exact-base)

  (record Resource
    (id Text)
    (owner Text)
    (title Text)
    (body Text)
    (revision I64))

  (record CreateInput
    (title Text)
    (body Text))

  (record UpdateInput
    (title Text)
    (body Text)
    (base I64))

  (record ResourceView
    (id Text)
    (title Text)
    (body Text)
    (revision I64))

  (record CreatedResponse
    (id Text)
    (revision I64)
    (job_enqueued Bool))

  (record UpdatedResponse
    (id Text)
    (revision I64))

  (fn owns ((actor Text) (resource Resource)) Bool
    (call core.text-equal actor (field resource owner)))

  (fn exact-base ((expected I64) (resource Resource)) Bool
    (call core.i64-equal expected (field resource revision)))

  (test owner-allowed
    (call owns "alice"
      (record Resource
        (id "resource-1") (owner "alice") (title "Title") (body "Body") (revision 0)))
    true)
  (test foreign-owner-denied
    (call owns "bob"
      (record Resource
        (id "resource-1") (owner "alice") (title "Title") (body "Body") (revision 0)))
    false))

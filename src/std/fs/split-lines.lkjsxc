<def>
  <name>split-lines</name>
  <fn>
    <params><s/><i/><start/><acc/></params>
    <if>
      <gte><i/><str-len><s/></str-len></gte>
      <cons>
        <str-slice><s/><start/><i/></str-slice>
        <acc/>
      </cons>
      <if>
        <eq><str-ref><s/><i/></str-ref><10/></eq>
        <split-lines>
          <s/><+><i/><1/></+><+><i/><1/></+>
          <cons>
            <str-slice><s/><start/><i/></str-slice>
            <acc/>
          </cons>
        </split-lines>
        <split-lines><s/><+><i/><1/></+><start/><acc/></split-lines>
      </if>
    </if>
  </fn>
</def>

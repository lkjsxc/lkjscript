<import>std/list/nth.lkjscript</import>
<import>std/list/len.lkjscript</import>
<def>
  <name>join-lines</name>
  <fn>
    <params><xs/><i/><n/><acc/></params>
    <if>
      <gte><i/><n/></gte>
      <acc/>
      <join-lines>
        <xs/><+><i/><1/></+><n/>
        <str-append>
          <str-append><acc/><nth><xs/><i/></nth></str-append>
          <if>
            <lt><i/><-><n/><1/></-></lt>
            <str-from-byte><10/></str-from-byte>
            <empty-str></empty-str>
          </if>
        </str-append>
      </join-lines>
    </if>
  </fn>
</def>

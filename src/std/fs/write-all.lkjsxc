<def>
  <name>write-all</name>
  <fn>
    <params><fd/><s/><i/></params>
    <if>
      <gte><i/><str-len><s/></str-len></gte>
      <nil/>
      <do>
        <write-byte-fd><fd/><str-ref><s/><i/></str-ref></write-byte-fd>
        <write-all><fd/><s/><+><i/><1/></+></write-all>
      </do>
    </if>
  </fn>
</def>

import/ "std/fs/write-all.lkjscript" /import
import/ "std/fs/open-write.lkjscript" /import
def/
  name/ "write-file" /name
  fn/
    sig/ Str Str -> Nil /sig
    params/ path Str s Str /params
    let/
      bind/ fd open-write/ path /open-write /bind
      do/
        write-all/ fd s 0 /write-all
        close/ fd /close
      /do
    /let
  /fn
/def

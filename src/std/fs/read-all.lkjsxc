<def>
  <name>read-all</name>
  <fn>
    <params><fd/><acc/></params>
    <let>
      <bind><b/><read-byte-fd><fd/></read-byte-fd></bind>
      <if>
        <lt><b/><0/></lt>
        <acc/>
        <read-all>
          <fd/>
          <str-append><acc/><str-from-byte><b/></str-from-byte></str-append>
        </read-all>
      </if>
    </let>
  </fn>
</def>

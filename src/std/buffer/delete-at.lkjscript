def/
  name/ "delete-at" /name
  fn/
    sig/ Str I64 -> Str /sig
    params/ s Str i I64 /params
    if/
      gte/ i str-len/ s /str-len /gte
      s
      str-append/
        str-slice/ s 0 i /str-slice
        str-slice/ s +/ i 1 /+ str-len/ s /str-len /str-slice
      /str-append
    /if
  /fn
/def

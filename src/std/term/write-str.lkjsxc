<import>std/io/put-byte.lkjsxc</import>
<def>
  <name>write-str</name>
  <fn>
    <params><s/><i/></params>
    <if>
      <gte><i/><str-len><s/></str-len></gte>
      <nil/>
      <do>
        <put-byte><str-ref><s/><i/></str-ref></put-byte>
        <write-str><s/><+><i/><1/></+></write-str>
      </do>
    </if>
  </fn>
</def>

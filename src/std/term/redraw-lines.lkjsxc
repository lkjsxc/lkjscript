<import>std/ansi/clear.lkjsxc</import>
<import>std/ansi/home.lkjsxc</import>
<import>std/term/puts.lkjsxc</import>
<import>std/list/nth.lkjsxc</import>
<import>std/list/len.lkjsxc</import>
<import>std/io/crlf.lkjsxc</import>
<def>
  <name>draw-line</name>
  <fn>
    <params><lines/><i/><n/></params>
    <if>
      <gte><i/><n/></gte>
      <nil/>
      <do>
        <puts><nth><lines/><i/></nth></puts>
        <crlf></crlf>
        <draw-line><lines/><+><i/><1/></+><n/></draw-line>
      </do>
    </if>
  </fn>
</def>

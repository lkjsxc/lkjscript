<import>std/ansi/esc.lkjsxc</import>
<import>std/io/put-byte.lkjsxc</import>
<def>
  <name>cup</name>
  <fn>
    <params><r/><c/></params>
    <do>
      <esc></esc>
      <put-byte><91/></put-byte>
      <print><r/></print>
      <put-byte><59/></put-byte>
      <print><c/></print>
      <put-byte><72/></put-byte>
    </do>
  </fn>
</def>

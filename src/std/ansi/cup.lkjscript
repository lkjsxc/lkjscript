import/ "std/ansi/esc.lkjscript" /import
import/ "std/io/put-byte.lkjscript" /import
def/
  name/ "cup" /name
  fn/
    sig/ I64 I64 -> Nil /sig
    params/ r I64 c I64 /params
    do/
      esc/ /esc
      put-byte/ 91 /put-byte
      print/ str-from-i64/ r /str-from-i64 /print
      put-byte/ 59 /put-byte
      print/ str-from-i64/ c /str-from-i64 /print
      put-byte/ 72 /put-byte
    /do
  /fn
/def

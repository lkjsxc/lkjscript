<import>lib/edit/view/redraw.lkjscript</import>
<import>lib/edit/handle.lkjscript</import>
<def>
  <name>edit-loop</name>
  <fn>
    <params></params>
    <do>
      <term-raw></term-raw>
      <redraw-ed></redraw-ed>
      <while>
        <eq><ed-quit/><0/></eq>
        <edit-step></edit-step>
      </while>
      <term-cooked></term-cooked>
    </do>
  </fn>
</def>
<def>
  <name>edit-step</name>
  <fn>
    <params></params>
    <let>
      <bind><k/><poll-byte></poll-byte></bind>
      <edit-on-key><k/></edit-on-key>
    </let>
  </fn>
</def>
<def>
  <name>edit-on-key</name>
  <fn>
    <params><k/></params>
    <if>
      <eq><k/><-2/></eq>
      <set><ed-quit/><1/></set>
      <if>
        <eq><k/><-1/></eq>
        <wait-ms><16/></wait-ms>
        <do>
          <set><ed-msg/><empty-str></empty-str></set>
          <handle-key><k/></handle-key>
          <redraw-ed></redraw-ed>
        </do>
      </if>
    </if>
  </fn>
</def>

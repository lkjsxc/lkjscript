<import>std/list/nth.lkjsxc</import>
<import>std/list/len.lkjsxc</import>
<import>std/term/puts.lkjsxc</import>
<import>std/io/put-byte.lkjsxc</import>
<def>
  <name>clamp-view</name>
  <fn>
    <params></params>
    <if>
      <lt><ed-row/><ed-top/></lt>
      <set><ed-top/><ed-row/></set>
      <if>
        <gte>
          <ed-row/>
          <+><ed-top/><ed-rows/></+>
        </gte>
        <set>
          <ed-top/>
          <-><+><ed-row/><1/></+><ed-rows/></->
        </set>
        <nil/>
      </if>
    </if>
  </fn>
</def>

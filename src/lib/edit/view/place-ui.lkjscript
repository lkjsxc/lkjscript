<import>std/ansi/cup.lkjscript</import>
<import>lib/edit/ui/status.lkjscript</import>
<import>lib/edit/view/view-draw.lkjscript</import>
<def>
  <name>place-ui</name>
  <fn>
    <params></params>
    <do>
      <cup><+><ed-rows/><1/></+><1/></cup>
      <show-status></show-status>
      <cup>
        <-><+><ed-row/><1/></+><ed-top/></->
        <+><ed-col/><+><gutter-w></gutter-w><1/></+></+>
      </cup>
    </do>
  </fn>
</def>

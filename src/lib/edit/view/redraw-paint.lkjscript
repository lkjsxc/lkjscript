<import>lib/edit/view/view.lkjscript</import>
<import>lib/edit/view/draw-rows.lkjscript</import>
<import>lib/edit/buf/clamp-col.lkjscript</import>
<import>std/ansi/clear.lkjscript</import>
<import>std/ansi/home.lkjscript</import>
<import>std/ansi/cursor.lkjscript</import>
<def>
  <name>redraw-paint</name>
  <fn>
    <params></params>
    <do>
      <clamp-col></clamp-col>
      <clamp-view></clamp-view>
      <hide-cursor></hide-cursor>
      <clear-screen></clear-screen>
      <home></home>
      <draw-rows><ed-top/><0/></draw-rows>
    </do>
  </fn>
</def>

<import>std/fs/read-file.lkjscript</import>
<import>std/fs/file-to-buf.lkjscript</import>
<import>lib/edit/buf/load-new.lkjscript</import>
<def>
  <name>ed-load</name>
  <fn>
    <params><path/></params>
    <if>
      <eq><path-exists><path/></path-exists><1/></eq>
      <ed-load-existing><path/></ed-load-existing>
      <ed-load-new><path/></ed-load-new>
    </if>
  </fn>
</def>
<def>
  <name>ed-load-existing</name>
  <fn>
    <params><path/></params>
    <do>
      <set><ed-path/><path/></set>
      <set>
        <ed-buf/>
        <file-to-buf><read-file><path/></read-file></file-to-buf>
      </set>
      <set><ed-row/><0/></set>
      <set><ed-col/><0/></set>
      <set><ed-dirty/><0/></set>
      <set><ed-msg/><empty-str></empty-str></set>
    </do>
  </fn>
</def>

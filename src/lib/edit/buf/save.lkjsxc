<import>std/fs/write-file.lkjsxc</import>
<import>std/fs/join-lines.lkjsxc</import>
<import>std/list/len.lkjsxc</import>
<def>
  <name>ed-save</name>
  <fn>
    <params></params>
    <do>
      <write-file>
        <ed-path/>
        <join-lines>
          <ed-buf/><0/><list-len><ed-buf/></list-len>
          <empty-str></empty-str>
        </join-lines>
      </write-file>
      <set><ed-dirty/><0/></set>
      <set><ed-msg/>wrote</set>
    </do>
  </fn>
</def>

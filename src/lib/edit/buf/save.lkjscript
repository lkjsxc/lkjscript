import/ "std/fs/write-file.lkjscript" /import
import/ "std/fs/text/join-lines.lkjscript" /import
import/ "std/list/len.lkjscript" /import
def/
  name/ "ed-save" /name
  fn/
    sig/ -> Nil /sig
    params/  /params
    do/
      write-file/
        ed-path
        join-lines/
          ed-buf 0 list-len/ ed-buf /list-len
          empty-str/ /empty-str
        /join-lines
      /write-file
      set/ ed-dirty 0 /set
      set/ ed-msg "wrote" /set
    /do
  /fn
/def

import/ "lib/edit/buf/cur-line.lkjscript" /import
 import/ "std/list/insert.lkjscript" /import
 def/
 name/ "yank-line" /name
 fn/
 sig/ -> Any /sig
 params/  /params
 set/ ed-yank cur-line/ /cur-line /set
 /fn
 /def
 def/
 name/ "paste-line" /name
 fn/
 sig/ -> Any /sig
 params/  /params
 do/
 set/
 ed-buf
 list-insert/
 ed-buf
 +/ ed-row 1 /+
 ed-yank
 /list-insert
 /set
 set/ ed-row +/ ed-row 1 /+ /set
 set/ ed-col 0 /set
 set/ ed-dirty 1 /set
 /do
 /fn
 /def

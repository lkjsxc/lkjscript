<import>lib/edit/buf/save.lkjsxc</import>
<def>
  <name>try-quit</name>
  <fn>
    <params></params>
    <if>
      <eq><ed-dirty/><0/></eq>
      <set><ed-quit/><1/></set>
      <nil/>
    </if>
  </fn>
</def>
<def>
  <name>run-cmd2</name>
  <fn>
    <params></params>
    <if>
      <eq><ed-cmd/>q!</eq>
      <set><ed-quit/><1/></set>
      <if>
        <eq><ed-cmd/>wq</eq>
        <do>
          <ed-save></ed-save>
          <set><ed-quit/><1/></set>
        </do>
        <nil/>
      </if>
    </if>
  </fn>
</def>

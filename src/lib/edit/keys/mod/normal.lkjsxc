<import>lib/edit/keys/nav/left.lkjsxc</import>
<import>lib/edit/keys/nav/right.lkjsxc</import>
<import>lib/edit/keys/nav/up.lkjsxc</import>
<import>lib/edit/keys/nav/down.lkjsxc</import>
<import>lib/edit/keys/mod/ins.lkjsxc</import>
<import>lib/edit/keys/mod/del.lkjsxc</import>
<import>lib/edit/keys/mod/normal2.lkjsxc</import>
<def>
  <name>handle-normal</name>
  <fn>
    <params><k/></params>
    <if>
      <eq><k/><104/></eq>
      <move-left></move-left>
      <if>
        <eq><k/><108/></eq>
        <move-right></move-right>
        <if>
          <eq><k/><107/></eq>
          <move-up></move-up>
          <if>
            <eq><k/><106/></eq>
            <move-down></move-down>
            <handle-normal2><k/></handle-normal2>
          </if>
        </if>
      </if>
    </if>
  </fn>
</def>

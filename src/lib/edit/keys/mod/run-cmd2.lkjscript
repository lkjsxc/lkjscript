import/ "lib/edit/buf/save.lkjscript" /import
 def/
 name/ "try-quit" /name
 fn/
 sig/ -> Any /sig
 params/  /params
 if/
 eq/ ed-dirty 0 /eq
 set/ ed-quit 1 /set
 set/ ed-msg "no write" /set
 /if
 /fn
 /def
 def/
 name/ "run-cmd2" /name
 fn/
 sig/ -> Any /sig
 params/  /params
 if/
 eq/ ed-cmd "q!" /eq
 set/ ed-quit 1 /set
 if/
 eq/ ed-cmd "wq" /eq
 do/
 ed-save/ /ed-save
 set/ ed-quit 1 /set
 /do
 set/ ed-msg "unknown" /set
 /if
 /if
 /fn
 /def

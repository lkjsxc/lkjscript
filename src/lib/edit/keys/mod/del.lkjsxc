<import>lib/edit/buf/cur-line.lkjsxc</import>
<import>lib/edit/buf/set-cur-line.lkjsxc</import>
<import>std/buffer/delete-at.lkjsxc</import>
<def>
  <name>del-char</name>
  <fn>
    <params></params>
    <do>
      <set-cur-line>
        <delete-at><cur-line></cur-line><ed-col/></delete-at>
      </set-cur-line>
      <set><ed-dirty/><1/></set>
    </do>
  </fn>
</def>

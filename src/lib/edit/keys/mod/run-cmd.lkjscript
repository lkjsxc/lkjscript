<import>lib/edit/keys/mod/run-cmd2.lkjscript</import>
<import>lib/edit/buf/save.lkjscript</import>
<def>
  <name>run-cmd</name>
  <fn>
    <params></params>
    <do>
      <set><ed-mode/><0/></set>
      <if>
        <eq><ed-cmd/>w</eq>
        <ed-save></ed-save>
        <if>
          <eq><ed-cmd/>q</eq>
          <try-quit></try-quit>
          <run-cmd2></run-cmd2>
        </if>
      </if>
    </do>
  </fn>
</def>

import/ "std/term/puts.lkjscript" /import
 import/ "std/io/put-byte.lkjscript" /import
 import/ "std/ansi/clear-eol.lkjscript" /import
 import/ "lib/edit/ui/status-msg.lkjscript" /import
 import/ "lib/edit/ui/status-bits.lkjscript" /import
 def/
 name/ "show-cmdline" /name
 fn/
 sig/ -> Nil /sig
 params/  /params
 do/
 puts/ ":" /puts
 puts/ ed-cmd /puts
 clear-eol/ /clear-eol
 /do
 /fn
 /def
 def/
 name/ "show-status" /name
 fn/
 sig/ -> Nil /sig
 params/  /params
 if/
 eq/ ed-mode 2 /eq
 show-cmdline/ /show-cmdline
 do/
 show-mode/ /show-mode
 put-byte/ 32 /put-byte
 puts/ ed-path /puts
 show-dirty/ /show-dirty
 show-msg/ /show-msg
 show-pos/ /show-pos
 clear-eol/ /clear-eol
 /do
 /if
 /fn
 /def

//! Checked structural transactions plan exact byte patches against one source snapshot.
//! Planning is pure. The driver checks the complete candidate before publication.
use crate::{ir, semantic, semantic_facts, sha256, syntax};
use std::collections::{BTreeMap, BTreeSet};
use std::json::{self, Value};

#[derive(Clone)]
pub struct Operation {
    pub data: String,
    pub kind: String,
    pub identity: String,
    pub source: String,
    pub name: String,
    pub parent: String,
    pub expected: String,
}
pub struct Request {
    pub snapshot: String,
    pub operations: Vec<Operation>,
    pub require: Vec<Requirement>,
}
/// A checked-contract predicate over every checked instance of one source item.
#[derive(Clone)]
pub struct Requirement {
    pub identity: String,
    pub predicate: String,
}
#[derive(Clone)]
pub struct Patch {
    pub identity: String,
    pub file: String,
    pub start: usize,
    pub end: usize,
    pub replacement: String,
}

#[derive(Clone)]
pub enum PreviousText {
    Absent,
    Present(Vec<u8>),
}
#[derive(Clone)]
pub struct Change {
    pub file: String,
    pub before: PreviousText,
    pub after: Vec<u8>,
}

/// A proposed external-module projection. Only the driver may bind its path
/// to an absent source change after pinning loader and directory evidence.
#[derive(Clone)]
pub struct Projection {
    pub identity: String,
    pub parent: String,
    pub path: String,
    pub source: Vec<u8>,
}
pub struct Draft {
    pub changes: Vec<Change>,
    pub projections: Vec<Projection>,
    pub identities: Vec<String>,
    pub patches: Vec<Patch>,
}
pub(crate) fn error(identity: &str, rule: &str, detail: &str) -> String {
    let mut message = format!("{} E_EDIT_{} {}", semantic::quote(identity), rule, detail);
    if rule == "REQUEST" || rule == "VERSION" || rule == "OPERATION" {
        message.push_str("\nSee lkjscript edit --help for the JSON request schema and examples.");
    }
    message
}
fn string(value: &Value, key: &str, required: bool) -> Result<String, String> {
    match value.get(key) {
        Some(value) => match value.as_str() {
            Some(text) => Ok(text.to_string()),
            None => Err(error("transaction", "REQUEST", &format!("{key} must be a string"))),
        },
        None if !required => Ok(String::new()),
        None => Err(error("transaction", "REQUEST", &format!("missing {key}"))),
    }
}
pub fn parse(bytes: &[u8]) -> Result<Request, String> {
    let value = json::parse(bytes).map_err(|problem| error("transaction", "REQUEST", &problem.message))?;
    let fields = value.as_object().ok_or_else(|| error("transaction", "REQUEST", "expected an object"))?;
    for (key, _) in fields {
        if key != "version" && key != "snapshot" && key != "operations" && key != "require" {
            return Err(error("transaction", "REQUEST", &format!("unknown field {key}")));
        }
    }
    if value.get("version").and_then(|value| value.as_usize()) != Some(1usize) {
        return Err(error("transaction", "VERSION", "expected version 1"));
    }
    let snapshot = string(&value, "snapshot", false)?;
    let operations = value.get("operations").and_then(|value| value.as_array())
        .ok_or_else(|| error("transaction", "REQUEST", "operations must be an array"))?;
    if operations.is_empty() { return Err(error("transaction", "REQUEST", "no operations")); }
    let mut parsed = Vec::new();
    for operation in operations {
        let fields = operation.as_object().ok_or_else(|| error("transaction", "REQUEST", "operation must be an object"))?;
        let kind = string(operation, "op", true)?;
        for (key, _) in fields {
            if key == "projection" && kind != "add-item" {
                return Err(error("transaction", "REQUEST", "projection is valid only on add-item"));
            }
            if key != "op" && key != "id" && key != "source" && key != "name"
                && key != "parent" && key != "expect"
                && !((key == "before" || key == "projection") && kind == "add-item")
                && matches!(kind.as_str(), "replace-body" | "replace-item" | "replace-call" | "add-item" | "remove-item" | "rename" | "move") {
                return Err(error("transaction", "REQUEST", &format!("unknown operation field {key}")));
            }
        }
        if kind == "replace-call" {
            for (key, _) in fields {
                if key != "op" && key != "id" && key != "source" && key != "expect" {
                    return Err(error("transaction", "REQUEST", &format!("unknown operation field {key}")));
                }
            }
            string(operation, "source", true)?;
        }
        let identity = string(operation, "id", true)?;
        let source = string(operation, "source", false)?;
        let name = string(operation, "name", false)?;
        let parent = string(operation, "parent", false)?;
        let expected = string(operation, "expect", false)?;
        let data = json::stringify(operation).map_err(|problem| error(&identity, "REQUEST", &problem.message))?;
        parsed.push(Operation { data, kind, identity, source, name, parent, expected });
    }
    let mut require: Vec<Requirement> = Vec::new();
    if let Some(field) = value.get("require") {
        let entries = field.as_array().ok_or_else(|| error("transaction", "REQUEST", "require must be an array"))?;
        if entries.is_empty() { return Err(error("transaction", "REQUEST", "require names no predicate")); }
        for entry in entries {
            let fields = entry.as_object().ok_or_else(|| error("transaction", "REQUEST", "require entry must be an object"))?;
            for (key, _) in fields {
                if key != "predicate" && key != "id" {
                    return Err(error("transaction", "REQUEST", &format!("unknown require field {key}")));
                }
            }
            let identity = string(entry, "id", true)?;
            let predicate = string(entry, "predicate", true)?;
            if !semantic_facts::predicate(&predicate) {
                return Err(error(&identity, "REQUEST", &format!("unknown require predicate {predicate}")));
            }
            require.push(Requirement { identity, predicate });
        }
    }
    Ok(Request { snapshot, operations: parsed, require })
}
/// Resolve requirement selectors against the original snapshot before checking.
pub fn select_requirements(catalog: &semantic::Catalog, require: &[Requirement]) -> Result<Vec<Requirement>, String> {
    let mut selected: Vec<Requirement> = Vec::new();
    for entry in require {
        let identity = catalog.select(&entry.identity, "EDIT")?;
        for previous in &selected {
            if previous.identity == identity && previous.predicate == entry.predicate {
                return Err(error(&identity, "REQUEST", &format!("duplicate require predicate {}", entry.predicate)));
            }
        }
        selected.push(Requirement { identity, predicate: entry.predicate.clone() });
    }
    Ok(selected)
}
/// Evaluate selected requirements over both independently checked programs.
/// Every verdict is reported; anything other than PROVEN refuses publication.
pub fn require(selected: &[Requirement], before: &semantic::Catalog, old: &ir::CheckedProgram,
    after: &semantic::Catalog, new: &ir::CheckedProgram) -> Result<String, String> {
    if selected.is_empty() { return Ok(String::new()); }
    let old_contracts = semantic_facts::contracts(before, old)?;
    let new_contracts = semantic_facts::contracts(after, new)?;
    let mut report = String::new();
    let mut proven = true;
    for entry in selected {
        let (verdict, detail) = semantic_facts::require(&entry.predicate, &entry.identity, &old_contracts, &new_contracts);
        if verdict != "PROVEN" { proven = false; }
        report.push_str(&format!("require {} predicate={} verdict={} level=checked-ir {}\n",
            semantic::quote(&entry.identity), entry.predicate, verdict, detail));
    }
    if proven { Ok(report) }
    else { Err(format!("transaction E_EDIT_REQUIRE a required checked contract is not PROVEN; no source was published\n{}", &report[..report.len() - 1usize])) }
}
fn select_value(catalog: &semantic::Catalog, value: &mut Value, optional: bool) -> Result<(), String> {
    if let Value::String(selector) = value {
        if optional && selector.is_empty() { return Ok(()); }
        *selector = catalog.select(selector, "EDIT")?;
    }
    Ok(())
}
/// Resolve every supplied identity before comparing owners or planning writes.
/// Source fragments and ordinary names are never interpreted as selectors.
pub(crate) fn selected_operation(catalog: &semantic::Catalog, operation: &Operation) -> Result<Operation, String> {
    let mut value = json::parse(operation.data.as_bytes()).map_err(|problem| error(&operation.identity, "REQUEST", &problem.message))?;
    if let Value::Object(fields) = &mut value {
        for index in 0usize..fields.len() {
            let key = fields[index].0.clone();
            let value = &mut fields[index].1;
            if key == "id" || key == "parent" || key == "before" {
                select_value(catalog, value, key != "id")?;
            } else if key == "sites" || key == "parameters" {
                if let Value::Array(values) = value {
                    for index in 0usize..values.len() {
                        let value = &mut values[index];
                        if key == "sites" || operation.kind == "change-signature" {
                            select_value(catalog, value, false)?;
                        } else if operation.kind == "extract-function" {
                            if let Value::Object(fields) = value {
                                for index in 0usize..fields.len() {
                                    let key = fields[index].0.clone();
                                    let value = &mut fields[index].1;
                                    if key == "id" { select_value(catalog, value, false)?; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut selected = operation.clone();
    selected.identity = string(&value, "id", true)?;
    selected.parent = string(&value, "parent", false)?;
    selected.data = json::stringify(&value).map_err(|problem| error(&operation.identity, "REQUEST", &problem.message))?;
    Ok(selected)
}
/// Resolve authored capture targets within the source-catalog trust boundary.
/// The driver does not inspect private expansion evidence across crate layers.
pub fn capture_rename_target(catalog: &semantic::Catalog, operation: &Operation) -> Result<Option<String>, String> {
    let selected = selected_operation(catalog, operation)?;
    if catalog.macro_replay.captures.contains_key(&selected.identity) {
        Ok(Some(selected.identity))
    } else { Ok(None) }
}

/// Report replay failure without exposing private expansion identities or proofs.
pub fn capture_rename_refusal(before: &semantic::Catalog, after: &semantic::Catalog,
    identities: &[String]) -> Option<String> {
    let refusal = semantic::macro_renames::verify(before, after, identities)?;
    Some(crate::structure_refactor::at_site(&refusal.identity, "REFERENCES", &refusal.site, &refusal.reason))
}
pub(crate) fn input<'a>(inputs: &'a [(String, Vec<u8>)], path: &str) -> Result<&'a [u8], String> {
    for (name, bytes) in inputs {
        if name == path { return Ok(bytes.as_slice()); }
    }
    Err(error(path, "SOURCE", "source bytes are absent from the compilation snapshot"))
}
pub(crate) fn item<'a>(catalog: &'a semantic::Catalog, identity: &str) -> Result<&'a semantic::Item, String> {
    let selected = catalog.select(identity, "EDIT")?;
    let index = catalog.by_identity.get(&selected)
        .ok_or_else(|| error(identity, "IDENTITY", "selected module root has no authored declaration"))?;
    Ok(&catalog.items[*index])
}
pub(crate) fn patch(patches: &mut Vec<Patch>, identity: &str, file: &str, start: usize, end: usize, replacement: &str) {
    patches.push(Patch { identity: identity.to_string(), file: file.to_string(), start, end,
        replacement: replacement.to_string() });
}
pub(crate) fn identifier(name: &str) -> bool {
    if name.is_empty() { return false; }
    for (index, byte) in name.bytes().enumerate() {
        if !(byte == b'_' || byte.is_ascii_alphabetic() || (index != 0usize && byte.is_ascii_digit())) {
            return false;
        }
    }
    true
}
pub(crate) fn validate_item(target: &semantic::Item, inputs: &[(String, Vec<u8>)], expected: &str) -> Result<(), String> {
    if !target.generated_from.is_empty() {
        return Err(error(&target.identity, "GENERATED_SOURCE",
            &format!("{} projection has no editable source; edit defining item {}", target.generated_expansion, semantic::quote(&target.generated_from))));
    }
    let bytes = input(inputs, &target.file)?;
    if target.start > target.end || target.end > bytes.len() {
        return Err(error(&target.identity, "SPAN", "catalog span is outside its input"));
    }
    if sha256::hex_digest(bytes) != target.file_digest
        || bytes[target.start..target.end] != *target.text.as_bytes() {
        return Err(error(&target.identity, "STALE", "catalog and source snapshot disagree"));
    }
    if !expected.is_empty() && expected != target.text_digest {
        return Err(error(&target.identity, "STALE", "expected item digest differs"));
    }
    Ok(())
}
pub(crate) fn insertion(catalog: &semantic::Catalog,
    inputs: &[(String, Vec<u8>)], identity: &str) -> Result<(String, usize), String> {
    let selected = catalog.select(identity, "EDIT")?;
    let identity = selected.as_str();
    if identity == "crate" {
        let bytes = input(inputs, &catalog.root)?;
        return Ok((catalog.root.clone(), bytes.len()));
    }
    // Crate roots and external modules have actual selected-file provenance,
    // including empty modules. A positive include read never enters this list.
    for mounted in &catalog.module_sources {
        if mounted.identity.as_str() == identity {
            if !mounted.parent.is_empty() {
                let target = item(catalog, identity)?;
                if target.kind != "module" {
                    return Err(error(identity, "PARENT", "items can be inserted only in a module"));
                }
            }
            let bytes = input(inputs, &mounted.file)?;
            return Ok((mounted.file.clone(), bytes.len()));
        }
    }
    let target = item(catalog, identity)?;
    if target.kind != "module" {
        return Err(error(identity, "PARENT", "items can be inserted only in a module"));
    }
    let bytes = input(inputs, &target.file)?;
    let text = String::from_utf8(bytes.to_vec()).map_err(|_| error(identity, "SOURCE", "source is not UTF-8"))?;
    let tokens = syntax::semantic_tokens(&text).map_err(|problem| error(identity, "SYNTAX", &problem.message))?;
    let mut last = None;
    for token in &tokens {
        if target.start <= token.span.start && token.span.end <= target.end
            && token.kind == 6u8 && token.text == "}" {
            last = Some(token.span.start);
        }
    }
    match last {
        Some(at) => Ok((target.file.clone(), at)),
        None => Err(error(identity, "PARENT", "external module has no actual loader-selected source")),
    }
}
fn finish(inputs: &[(String, Vec<u8>)], patches: Vec<Patch>) -> Result<Draft, String> {
    let mut ordered: BTreeMap<(String, usize, usize), Patch> = BTreeMap::new();
    for value in patches {
        let key = (value.file.clone(), value.start, value.end);
        if let Some(prior) = ordered.get_mut(&key) {
            if value.start == value.end {
                prior.replacement.push_str(&value.replacement);
                continue;
            }
            if prior.replacement == value.replacement { continue; }
            return Err(error(&value.identity, "OVERLAP", "operations write different values at one site"));
        }
        ordered.insert(key, value);
    }
    let mut changes: Vec<Change> = Vec::new();
    let mut all: Vec<Patch> = Vec::new();
    let mut identities: BTreeSet<String> = BTreeSet::new();
    let mut current = String::new();
    let mut cursor = 0usize;
    let mut output: Vec<u8> = Vec::new();
    for (_, value) in ordered {
        if value.file != current {
            if !current.is_empty() {
                let original = input(inputs, &current)?;
                output.extend_from_slice(&original[cursor..]);
                changes.push(Change { file: current.clone(), before: PreviousText::Present(original.to_vec()), after: output });
                output = Vec::new();
            }
            current = value.file.clone();
            cursor = 0usize;
        }
        let original = input(inputs, &current)?;
        if value.start < cursor || value.start > value.end || value.end > original.len() {
            return Err(error(&value.identity, "OVERLAP", "operations overlap or escape the source snapshot"));
        }
        output.extend_from_slice(&original[cursor..value.start]);
        output.extend_from_slice(value.replacement.as_bytes());
        cursor = value.end;
        identities.insert(value.identity.clone());
        all.push(value);
    }
    if !current.is_empty() {
        let original = input(inputs, &current)?;
        output.extend_from_slice(&original[cursor..]);
        changes.push(Change { file: current, before: PreviousText::Present(original.to_vec()), after: output });
    }
    let mut names = Vec::new();
    for identity in identities { names.push(identity); }
    Ok(Draft { changes, projections: Vec::new(), identities: names, patches: all })
}
pub(crate) fn one_item(identity: &str, source: &str, body: bool) -> Result<(), String> {
    let wrapped = if body { format!("fn __lkjscript_transaction_body() {source}") }
        else { format!("mod __lkjscript_transaction_scope {{ {source} }}") };
    // Shape validation retains invocations; the complete candidate expands them
    // in their real source scope and must pass the ordinary semantic checks.
    let parsed = syntax::parse_unexpanded(&wrapped).map_err(|problem| error(identity, "SYNTAX", &problem.message))?;
    let count = if body { parsed.items.len() } else if parsed.items.len() == 1usize {
        match parsed.items[0usize] {
            crate::ast::Item::Module(index) => parsed.modules[index].items.len(),
            _ => 0usize,
        }
    } else { 0usize };
    if count != 1usize {
        return Err(error(identity, "ITEM", "replacement must contain exactly one item or one body"));
    }
    Ok(())
}

pub(crate) fn external_module_name(identity: &str, source: &str) -> Result<String, String> {
    let prefix = "mod __lkjscript_transaction_scope { ";
    let parsed = syntax::parse(&format!("{prefix}{source} }}"))
        .map_err(|problem| error(identity, "SYNTAX", &problem.message))?;
    if parsed.items.len() != 1usize {
        return Err(error(identity, "PROJECTION", "projection needs exactly one external module declaration"));
    }
    let crate::ast::Item::Module(wrapper) = parsed.items[0usize] else {
        return Err(error(identity, "PROJECTION", "projection needs an external module"));
    };
    let children = &parsed.modules[wrapper].items;
    if children.len() != 1usize {
        return Err(error(identity, "PROJECTION", "projection needs exactly one enabled external module"));
    }
    let crate::ast::Item::Module(index) = children[0usize] else {
        return Err(error(identity, "PROJECTION", "projection source is not a module declaration"));
    };
    let module = &parsed.modules[index];
    if !module.external || module.span.start < prefix.len() {
        return Err(error(identity, "PROJECTION", "projection needs an external mod declaration, not an inline body"));
    }
    let tokens = syntax::semantic_tokens(source).map_err(|problem| error(identity, "SYNTAX", &problem.message))?;
    let mut at = 0usize;
    while at < tokens.len() && tokens[at].kind == 6u8 && tokens[at].text == "#" {
        at += 1usize;
        if at >= tokens.len() || tokens[at].kind != 6u8 || tokens[at].text != "[" {
            return Err(error(identity, "PROJECTION", "only outer declaration attributes may precede the module"));
        }
        at += 1usize;
        let mut depth = 1usize;
        while at < tokens.len() && depth != 0usize {
            if tokens[at].kind == 6u8 {
                if tokens[at].text == "[" { depth += 1usize; }
                else if tokens[at].text == "]" { depth -= 1usize; }
            }
            at += 1usize;
        }
        if depth != 0usize { return Err(error(identity, "PROJECTION", "unclosed declaration attribute")); }
    }
    if at < tokens.len() && tokens[at].kind == 0u8 && tokens[at].text == "pub" {
        at += 1usize;
        if at < tokens.len() && tokens[at].kind == 6u8 && tokens[at].text == "(" {
            at += 1usize;
            while at < tokens.len() && !(tokens[at].kind == 6u8 && tokens[at].text == ")") { at += 1usize; }
            if at == tokens.len() { return Err(error(identity, "PROJECTION", "unclosed module visibility")); }
            at += 1usize;
        }
    }
    if tokens.len() != at + 3usize || tokens[at].kind != 0u8 || tokens[at].text != "mod"
        || tokens[at + 1usize].kind != 0u8 || tokens[at + 1usize].text != module.name
        || tokens[at + 2usize].kind != 6u8 || tokens[at + 2usize].text != ";"
        || tokens[at].span.start + prefix.len() != module.span.start
        || tokens[at + 2usize].span.end + prefix.len() != module.span.end {
        return Err(error(identity, "PROJECTION", "projection source must contain only its module declaration"));
    }
    Ok(module.name.clone())
}

fn projection(catalog: &semantic::Catalog, operation: &Operation) -> Result<Option<Projection>, String> {
    let value = json::parse(operation.data.as_bytes()).map_err(|problem| error(&operation.identity, "REQUEST", &problem.message))?;
    let Some(projected) = value.get("projection") else { return Ok(None); };
    let fields = projected.as_object().ok_or_else(|| error(&operation.identity, "PROJECTION", "projection must be an object"))?;
    for (key, _) in fields {
        if key != "path" && key != "source" {
            return Err(error(&operation.identity, "PROJECTION", &format!("unknown projection field {key}")));
        }
    }
    let path = string(projected, "path", true)?;
    if path.is_empty() || !path.ends_with(".lkj") || path.as_bytes().contains(&0u8) {
        return Err(error(&operation.identity, "PROJECTION", "projection needs a relative .lkj source path"));
    }
    for part in path.as_str().split('/') {
        if part.is_empty() || part == "." || part == ".." {
            return Err(error(&operation.identity, "PROJECTION", "projection path must be relative and normalized"));
        }
    }
    let name = external_module_name(&operation.identity, &operation.source)?;
    let qualified = if operation.identity == "crate" { semantic::declaration_path(&name) }
        else { format!("{}::{name}", semantic::source_path(&operation.identity)) };
    let identity = semantic::source_identity(crate::resolve::Namespace::Type, &qualified);
    if catalog.by_identity.contains_key(&identity) {
        return Err(error(&identity, "NAME", "projected module identity already exists"));
    }
    for module in &catalog.module_sources {
        if module.identity == identity {
            return Err(error(&identity, "NAME", "projected module identity already exists"));
        }
    }
    Ok(Some(Projection { identity, parent: operation.identity.clone(), path,
        source: string(projected, "source", true)?.as_bytes().to_vec() }))
}
fn one_expression(identity: &str, source: &str, call: bool) -> Result<String, String> {
    let rule = if call { "CALL_SITE" } else { "EXPRESSION" };
    let tokens = syntax::semantic_tokens(source)
        .map_err(|problem| error(identity, rule, &problem.message))?;
    if tokens.is_empty() { return Err(error(identity, rule, "source is empty; expected one expression")); }
    // Delimiters must close inside the supplied fragment, independently of the
    // wrapper. Otherwise "1) + 2 + (3" could escape the replacement's grouping.
    let mut delimiters: Vec<u8> = Vec::new();
    for token in &tokens {
        if token.kind != 6u8 { continue; }
        let opening = match token.text.as_str() {
            "(" => b')', "[" => b']', "{" => b'}',
            ")" | "]" | "}" => {
                if delimiters.pop() != Some(token.text.as_bytes()[0usize]) {
                    return Err(error(identity, rule, "source closes a bracket it did not open; expected one self-contained expression"));
                }
                0u8
            }
            _ => 0u8,
        };
        if opening != 0u8 { delimiters.push(opening); }
    }
    if !delimiters.is_empty() {
        return Err(error(identity, rule, "source does not stay inside its wrapper (unbalanced bracket or unclosed comment); expected one self-contained expression"));
    }
    // Parentheses retain this expression's precedence; newlines keep trailing
    // line comments from swallowing the closing delimiter or surrounding code.
    let expression = format!("(\n{source}\n)");
    // Validate the raw value expression to EOF before adding projection grouping.
    // Macro invocations are shape-checked here and expanded only in real scope.
    let (parsed, tail) = syntax::parse_expression_unexpanded(source)
        .map_err(|problem| error(identity, rule, &problem.message))?;
    if call && !matches!(parsed.exprs[tail].kind, crate::ast::Expr::Call { .. } | crate::ast::Expr::Method { .. }) {
        return Err(error(identity, rule, "call-site text is not one complete call expression; replace its owning body"));
    }
    Ok(expression)
}

fn call_replacement(catalog: &semantic::Catalog, inputs: &[(String, Vec<u8>)],
    target: &semantic::Item, source: &str) -> Result<String, String> {
    if target.kind != "call-site" {
        return Err(error(&target.identity, "CALL_SITE", "id is not an authored call site; find call-site IDs with query --kind outline"));
    }
    let owner = item(catalog, &target.parent)?;
    validate_item(owner, inputs, "")?;
    let (start, end) = owner.body.ok_or_else(|| error(&target.identity, "CALL_SITE", "the function containing this call site has no authored body"))?;
    if owner.kind != "function" || owner.file != target.file
        || target.start < start || target.start >= target.end || target.end > end {
        return Err(error(&target.identity, "CALL_SITE", "internal: call site lies outside its function's body"));
    }
    // Grouped callees/receivers can have spans missing an opening parenthesis.
    // Refuse such incomplete projections instead of guessing surrounding bytes.
    if one_expression(&target.identity, &target.text, true).is_err() {
        return Err(error(&target.identity, "CALL_SITE", "the text at this call site is not one complete call expression; use replace-body on its function instead"));
    }
    one_expression(&target.identity, source, false)
}

pub fn plan(catalog: &semantic::Catalog,
    inputs: &[(String, Vec<u8>)], request: &Request) -> Result<Draft, String> {
    if !request.snapshot.is_empty() && request.snapshot != catalog.input_digest {
        return Err(error("transaction", "STALE", "expected source snapshot differs"));
    }
    let mut patches = Vec::new();
    let mut projections = Vec::new();
    let mut projected_identities: BTreeSet<String> = BTreeSet::new();
    let mut projected_paths: BTreeSet<String> = BTreeSet::new();
    for operation in &request.operations {
        let selected = selected_operation(catalog, operation)?;
        let operation = &selected;
        if operation.kind == "rename" {
            if let Some(refusal) = semantic::macro_renames::refusal(catalog, &operation.identity) {
                return Err(crate::structure_refactor::at_site(&refusal.identity, "REFERENCES", &refusal.site, &refusal.reason));
            }
        }
        if let Some(index) = catalog.by_identity.get(&operation.identity) {
            let selected = &catalog.items[*index];
            if !selected.generated_from.is_empty() { validate_item(selected, inputs, &operation.expected)?; }
            if matches!(operation.kind.as_str(),
                "rename" | "move" | "change-signature" | "inline-function" | "remove-item") {
                for site in &catalog.generated_references {
                    if site.target == selected.identity {
                        let owner = item(catalog, &site.owner)?;
                        let macro_definition = catalog.by_identity.get(&owner.generated_from)
                            .is_some_and(|definition| !catalog.items[*definition].generated_from.is_empty());
                        let macro_reference = owner.generated_expansion == "macro-rules" || macro_definition;
                        // Authored Default/Debug declarations reconstruct their
                        // nominal, field and bound references after a source edit.
                        // Their helper calls retain the established refusal.
                        // A derive emitted by a macro still has no editable
                        // defining declaration and receives the macro refusal.
                        if !macro_reference && !(selected.kind == "function" && site.kind == "call") { continue; }
                        return Err(error(&selected.identity, "GENERATED_REFERENCE",
                            &format!("{} from {} has no editable source; edit defining item {}",
                                site.kind, semantic::quote(&site.owner), semantic::quote(&owner.generated_from))));
                    }
                }
            }
        }
        if operation.kind == "add-item" {
            if let Some(projected) = projection(catalog, operation)? {
                if !projected_identities.insert(projected.identity.clone())
                    || !projected_paths.insert(projected.path.clone()) {
                    return Err(error(&projected.identity, "PROJECTION", "duplicate projected identity or path"));
                }
                projections.push(projected);
            } else { one_item(&operation.identity, &operation.source, false)?; }
            let (file, at) = add_location(catalog, inputs, operation)?;
            patch(&mut patches, &operation.identity, &file, at, at, &format!("\n{}\n", operation.source));
            continue;
        }
        let target = item(catalog, &operation.identity)?;
        validate_item(target, inputs, &operation.expected)?;
        if crate::structure_refactor::plan(catalog, inputs, operation, &mut patches)? { continue; }
        match operation.kind.as_str() {
            "replace-call" => {
                let replacement = call_replacement(catalog, inputs, target, &operation.source)?;
                patch(&mut patches, &operation.identity, &target.file, target.start, target.end, &replacement);
            }
            "replace-body" => {
                let (start, end) = target.body.ok_or_else(|| error(&operation.identity, "BODY", "identity has no source body"))?;
                if operation.source.is_empty() { return Err(error(&operation.identity, "BODY", "replacement body is empty")); }
                one_item(&operation.identity, &operation.source, true)?;
                patch(&mut patches, &operation.identity, &target.file, start, end, &operation.source);
            }
            "replace-item" => {
                if operation.source.is_empty() { return Err(error(&operation.identity, "ITEM", "replacement item is empty")); }
                one_item(&operation.identity, &operation.source, false)?;
                patch(&mut patches, &operation.identity, &target.file, target.start, target.end, &operation.source);
            }
            "remove-item" => {
                let (start, end) = remove_span(target, inputs)?;
                patch(&mut patches, &operation.identity, &target.file, start, end, "");
            },
            "rename" => return Err(error(&operation.identity, "REFERENCES",
                "this identity has no complete source-scope rename proof")),
            "move" => {
                // Relocation within one semantic module preserves the source
                // identity. Cross-module relocation also needs resolved path edits.
                if operation.parent != target.parent {
                    return Err(error(&operation.identity, "REFERENCES", "cross-module move requires complete resolved path rewrites"));
                }
                let (file, at) = insertion(catalog, inputs, &operation.parent)?;
                if file == target.file && target.start <= at && at < target.end {
                    return Err(error(&operation.identity, "OVERLAP", "cannot move an item into itself"));
                }
                let (start, end) = remove_span(target, inputs)?;
                patch(&mut patches, &operation.identity, &target.file, start, end, "");
                patch(&mut patches, &operation.identity, &file, at, at, &format!("\n{}\n", target.text));
            }
            _ => return Err(error(&operation.identity, "OPERATION", &format!("unsupported structural operation {}", operation.kind))),
        }
    }
    let mut draft = finish(inputs, patches)?;
    for projected in &projections { draft.identities.push(projected.identity.clone()); }
    draft.projections = projections;
    Ok(draft)
}
pub fn report(draft: &Draft) -> String {
    let mut out = String::new();
    for identity in &draft.identities {
        out.push_str(&format!("{} level=source-claim operation-target selected={}\n", semantic::quote(identity), semantic::quote(identity)));
    }
    for projected in &draft.projections {
        out.push_str(&format!("{} level=source-claim projection parent={} path={} bytes={} source={}\n",
            semantic::quote(&projected.identity), semantic::quote(&projected.parent),
            semantic::quote(&projected.path), projected.source.len(), sha256::hex_digest(&projected.source)));
    }
    for change in &draft.changes {
        let before = match &change.before {
            PreviousText::Absent => "absent".to_string(),
            PreviousText::Present(bytes) => sha256::hex_digest(bytes),
        };
        out.push_str(&format!("{} level=source-claim file before={} after={}\n", semantic::quote(&change.file),
            before, sha256::hex_digest(&change.after)));
    }
    out.push_str(&format!("transaction sites={} files={} identities={}\n", draft.patches.len(), draft.changes.len(), draft.identities.len()));
    out
}

pub(crate) fn remove_span(target: &semantic::Item, inputs: &[(String, Vec<u8>)]) -> Result<(usize, usize), String> {
    let bytes = input(inputs, &target.file)?;
    let mut start = target.start;
    while start > 0usize && bytes[start - 1usize] != b'\n' {
        let byte = bytes[start - 1usize];
        if byte != b' ' && byte != b'\t' && byte != b'\r' { start = target.start; break; }
        start -= 1usize;
    }
    let mut end = target.end;
    while end < bytes.len() && (bytes[end] == b' ' || bytes[end] == b'\t' || bytes[end] == b'\r') { end += 1usize; }
    if end < bytes.len() && bytes[end] == b'\n' { end += 1usize; }
    else if end != bytes.len() { end = target.end; }
    Ok((start, end))
}

fn add_location(catalog: &semantic::Catalog, inputs: &[(String, Vec<u8>)], operation: &Operation) -> Result<(String, usize), String> {
    let value = json::parse(operation.data.as_bytes()).map_err(|problem| error(&operation.identity, "REQUEST", &problem.message))?;
    let before = string(&value, "before", false)?;
    if before.is_empty() { return insertion(catalog, inputs, &operation.identity); }
    let anchor = item(catalog, &before)?;
    if anchor.parent != operation.identity {
        return Err(error(&operation.identity, "PARENT", "before anchor belongs to another module"));
    }
    validate_item(anchor, inputs, "")?;
    Ok((anchor.file.clone(), remove_span(anchor, inputs)?.0))
}

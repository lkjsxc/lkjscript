// Native case discovery, worker processes and expectation checks.
// Case expectations live beside their source; worker output is kept private.
use std::collections::BTreeMap;

pub struct Capture {
    pub status: i64,
    pub stdout: Vec<u8>,
    pub stderr: Vec<u8>,
    pub result: Vec<u8>,
    pub timed_out: bool,
}

pub struct Running {
    child: Child,
    output: File,
    errors: File,
    result: File,
}

fn io(operation: &str, errno: i64) -> String {
    format!("E_TEST {operation} failed (errno {errno})")
}

pub fn start(
    world: &mut World,
    executable: &File,
    arguments: &[Vec<u8>],
) -> Result<Running, String> {
    let input = world.temporary_file().map_err(|e: i64| io("input", e))?;
    let output = world.temporary_file().map_err(|e: i64| io("output", e))?;
    let errors = world.temporary_file().map_err(|e: i64| io("errors", e))?;
    let result = world.temporary_file().map_err(|e: i64| io("result", e))?;
    let child = world
        .process()
        .spawn_file(executable, arguments, &input, &output, &errors, &result)
        .map_err(|e: i64| io("spawn", e))?;
    Ok(Running { child, output, errors, result })
}

fn captured(file: &mut File) -> Result<Vec<u8>, String> {
    file.rewind().map_err(|e: i64| io("rewind", e))?;
    file.read_to_end().map_err(|e: i64| io("read capture", e))
}

pub fn finish(
    world: &mut World,
    mut running: Running,
    timeout_ns: usize,
) -> Result<Capture, String> {
    let mut timed_out = false;
    let status = if timeout_ns == 0 {
        running.child.wait().map_err(|e: i64| io("wait", e))?
    } else {
        let mut clock = world.clock();
        let started = clock.nanoseconds().map_err(|e: i64| io("clock", e))?;
        loop {
            if let Some(status) = running.child.try_wait().map_err(|e: i64| io("poll", e))? {
                break status;
            }
            let now = clock.nanoseconds().map_err(|e: i64| io("clock", e))?;
            if now - started >= timeout_ns {
                running.child.terminate().map_err(|e: i64| io("terminate", e))?;
                timed_out = true;
                break running.child.wait().map_err(|e: i64| io("reap", e))?;
            }
        }
    };
    Ok(Capture {
        status,
        stdout: captured(&mut running.output)?,
        stderr: captured(&mut running.errors)?,
        result: captured(&mut running.result)?,
        timed_out,
    })
}

pub fn invoke(
    world: &mut World,
    executable: &File,
    arguments: &[Vec<u8>],
    timeout_ns: usize,
) -> Result<Capture, String> {
    let running = start(world, executable, arguments)?;
    finish(world, running, timeout_ns)
}

fn pieces(text: &str, separator: u8) -> Vec<String> {
    let mut result = Vec::new();
    let mut begin = 0usize;
    for (at, byte) in text.as_bytes().iter().enumerate() {
        if *byte == separator {
            result.push(text[begin..at].to_string());
            begin = at + 1;
        }
    }
    result.push(text[begin..].to_string());
    result
}

fn number(text: &str) -> Result<usize, String> {
    if text.is_empty() {
        return Err("E_TEST expected a decimal integer".to_string());
    }
    let mut value = 0usize;
    for byte in text.as_bytes() {
        if *byte < b'0' || *byte > b'9' {
            return Err(format!("E_TEST invalid integer {text}"));
        }
        value = match value.checked_mul(10) {
            Some(n) => match n.checked_add((*byte - b'0') as usize) {
                Some(next) => next,
                None => return Err("E_TEST integer overflow".to_string()),
            },
            None => return Err("E_TEST integer overflow".to_string()),
        };
    }
    Ok(value)
}

fn digit(byte: u8) -> Result<u8, String> {
    match byte {
        b'0'..=b'9' => Ok(byte - b'0'),
        b'a'..=b'f' => Ok(byte - b'a' + 10),
        b'A'..=b'F' => Ok(byte - b'A' + 10),
        _ => Err("E_TEST invalid hexadecimal bytes".to_string()),
    }
}

fn unhex(text: &str) -> Result<Vec<u8>, String> {
    if text.len() % 2 != 0 {
        return Err("E_TEST hexadecimal bytes need pairs".to_string());
    }
    let mut bytes = Vec::new();
    let mut at = 0usize;
    while at < text.len() {
        bytes.push(digit(text.as_bytes()[at])? * 16 + digit(text.as_bytes()[at + 1])?);
        at += 2;
    }
    Ok(bytes)
}

pub fn hex(bytes: &[u8]) -> String {
    let digits = b"0123456789abcdef";
    let mut out = String::new();
    for byte in bytes {
        out.push(digits[(*byte >> 4) as usize] as char);
        out.push(digits[(*byte & 15) as usize] as char);
    }
    out
}

fn utf8(bytes: Vec<u8>, message: &str) -> Result<String, String> {
    match String::from_utf8(bytes) {
        Ok(text) => Ok(text),
        Err(_) => Err(message.to_string()),
    }
}

fn open_file(world: &mut World, path: &str) -> Result<File, String> {
    let mut split = None;
    for (index, byte) in path.as_bytes().iter().enumerate() {
        if *byte == b'/' { split = Some(index); }
    }
    let parent = match split { Some(0) => "/", Some(index) => &path[..index], None => "." };
    let name = match split { Some(index) => &path[index + 1..], None => path };
    let mut directory = world.directory(parent).map_err(|e: i64| io("source directory", e))?;
    directory.open(name).map_err(|e: i64| io(path, e))
}

fn read(world: &mut World, path: &str) -> Result<String, String> {
    let mut file = open_file(world, path)?;
    let bytes = file.read_to_end().map_err(|e: i64| io("source read", e))?;
    utf8(bytes, &format!("E_TEST {path} is not UTF-8"))
}

struct Case {
    path: String,
    kind: String,
    value: String,
    stdout: Vec<u8>,
    stderr: Vec<u8>,
    status: usize,
    line: usize,
    entry: String,
    pending: String,
    reference: String,
    witness: String,
}

fn header(line: &str) -> Option<&str> {
    if line.starts_with("// ") {
        Some(&line[3..])
    } else if line.starts_with("# ") {
        Some(&line[2..])
    } else {
        None
    }
}

fn case(path: &str, source: &str) -> Result<Option<Case>, String> {
    let mut out = Case {
        path: path.to_string(), kind: String::new(), value: String::new(),
        stdout: Vec::new(), stderr: Vec::new(), status: 0, line: 0,
        entry: String::new(), pending: String::new(), reference: String::new(), witness: String::new(),
    };
    for line in pieces(source, b'\n') {
        let text = match header(&line) {
            Some(text) => text,
            None => continue,
        };
        if text.starts_with("expect: ") {
            if !out.kind.is_empty() {
                return Err(format!("E_TEST duplicate expectation in {path}"));
            }
            let expectation = &text[8..];
            let space = expectation.find(' ').unwrap_or(expectation.len());
            out.kind = expectation[..space].to_string();
            let rest = if space == expectation.len() { "" } else { &expectation[space + 1..] };
            if out.kind == "value" || out.kind == "reject" {
                out.value = rest.to_string();
            } else if out.kind == "output" {
                out.stdout = unhex(rest)?;
            } else if out.kind == "trap" {
                let fields = pieces(rest, b' ');
                if fields.is_empty() || fields.len() > 2 {
                    return Err(format!("E_TEST invalid trap expectation in {path}"));
                }
                out.value = fields[0].clone();
                if fields.len() == 2 {
                    out.line = number(&fields[1])?;
                }
                out.status = 1;
            } else if out.kind != "check" && out.kind != "compare" {
                return Err(format!("E_TEST unknown expectation {} in {path}", out.kind));
            }
        } else if text.starts_with("stdout:") {
            out.stdout = unhex(trim(&text[7..]))?;
        } else if text.starts_with("stderr:") {
            out.stderr = unhex(trim(&text[7..]))?;
        } else if text.starts_with("status: ") {
            out.status = number(&text[8..])?;
        } else if text.starts_with("entry: ") {
            out.entry = text[7..].to_string();
        } else if text.starts_with("witness: ") {
            out.witness = text[9..].to_string();
        } else if text.starts_with("reference: ") {
            out.reference = text[11..].to_string();
        } else if text.starts_with("pending: ") {
            out.pending = text[9..].to_string();
        }
    }
    if !out.reference.is_empty() && out.kind != "compare" {
        return Err(format!("E_TEST reference requires compare expectation in {path}"));
    }
    if out.kind.is_empty() { Ok(None) } else { Ok(Some(out)) }
}

fn discover(world: &mut World, path: &str, cases: &mut Vec<Case>) -> Result<(), String> {
    match world.directory(path) {
        Ok(mut directory) => {
            let mut names: Vec<String> = Vec::new();
            for name in directory.list().map_err(|e: i64| io("list cases", e))? {
                let name = utf8(name, "E_TEST non-UTF-8 case name")?;
                if !name.starts_with('.') {
                    names.push(name);
                }
            }
            names.sort();
            for name in names {
                discover(world, &format!("{path}/{name}"), cases)?;
            }
        }
        Err(errno) => {
            if errno != 20 && errno != 2 {
                return Err(io(path, errno));
            }
            if path.ends_with(".lkj") || path.ends_with(".lkjir") {
                let source = read(world, path)?;
                if let Some(found) = case(path, &source)? {
                    cases.push(found);
                }
            }
        }
    }
    Ok(())
}

pub fn has_cases(world: &mut World, path: &str) -> Result<bool, String> {
    if world.directory(path).is_ok() {
        return Ok(true);
    }
    Ok(case(path, &read(world, path)?)?.is_some())
}

#[derive(Clone)]
struct Record {
    index: usize,
    engine: String,
    checked: bool,
    status: usize,
    stdout: Vec<u8>,
    stderr: Vec<u8>,
    diagnostic: String,
}

fn json_string(bytes: &[u8], at: &mut usize) -> Result<String, String> {
    if *at >= bytes.len() || bytes[*at] != b'"' {
        return Err("E_TEST worker JSON expected string".to_string());
    }
    *at += 1;
    let mut out = Vec::new();
    while *at < bytes.len() {
        let byte = bytes[*at];
        *at += 1;
        if byte == b'"' {
            return utf8(out, "E_TEST worker JSON UTF-8");
        }
        if byte != b'\\' {
            out.push(byte);
            continue;
        }
        if *at == bytes.len() {
            break;
        }
        let escape = bytes[*at];
        *at += 1;
        match escape {
            b'"' | b'\\' | b'/' => out.push(escape),
            b'n' => out.push(b'\n'),
            b'r' => out.push(b'\r'),
            b't' => out.push(b'\t'),
            b'b' => out.push(8),
            b'f' => out.push(12),
            b'u' => {
                if bytes.len() - *at < 4 || bytes[*at] != b'0' || bytes[*at + 1] != b'0' {
                    return Err("E_TEST unexpected worker JSON escape".to_string());
                }
                out.push(digit(bytes[*at + 2])? * 16 + digit(bytes[*at + 3])?);
                *at += 4;
            }
            _ => return Err("E_TEST invalid worker JSON escape".to_string()),
        }
    }
    Err("E_TEST unterminated worker JSON string".to_string())
}

fn record(text: &str) -> Result<Record, String> {
    let bytes = text.as_bytes();
    if bytes.is_empty() || bytes[0] != b'{' {
        return Err("E_TEST malformed worker record".to_string());
    }
    let mut fields: BTreeMap<String, String> = BTreeMap::new();
    let mut at = 1usize;
    while at < bytes.len() && bytes[at] != b'}' {
        if bytes[at] == b' ' || bytes[at] == b',' {
            at += 1;
            continue;
        }
        let key = json_string(bytes, &mut at)?;
        if at == bytes.len() || bytes[at] != b':' {
            return Err("E_TEST malformed worker key".to_string());
        }
        at += 1;
        let value = if at < bytes.len() && bytes[at] == b'"' {
            json_string(bytes, &mut at)?
        } else {
            let begin = at;
            while at < bytes.len() && bytes[at] != b',' && bytes[at] != b'}' {
                at += 1;
            }
            text[begin..at].to_string()
        };
        fields.insert(key, value);
    }
    if at == bytes.len() || bytes[at] != b'}' || at + 1 != bytes.len() {
        return Err("E_TEST incomplete worker JSON object".to_string());
    }
    let required = vec!["index".to_string(), "engine".to_string(), "checkStatus".to_string(), "status".to_string(), "stdoutHex".to_string(), "stderrHex".to_string(), "stderr".to_string()];
    for key in &required {
        if !fields.contains_key(&key.to_string()) {
            return Err(format!("E_TEST worker record missing {key}"));
        }
    }
    Ok(Record {
        index: number(fields.get(&"index".to_string()).unwrap())?,
        engine: fields.get(&"engine".to_string()).unwrap().clone(),
        checked: fields.get(&"checkStatus".to_string()).unwrap() == "0",
        status: number(fields.get(&"status".to_string()).unwrap())?,
        stdout: unhex(fields.get(&"stdoutHex".to_string()).unwrap())?,
        stderr: unhex(fields.get(&"stderrHex".to_string()).unwrap())?,
        diagnostic: fields.get(&"stderr".to_string()).unwrap().clone(),
    })
}

/// Decode the machine-only observation used by raw-IR differential execution.
/// The record retains complete static diagnostic identity before user bounding.
pub fn observed_capture(mut capture: Capture) -> Result<Capture, String> {
    if capture.timed_out || !capture.stderr.is_empty() { return Ok(capture); }
    let text = String::from_utf8(capture.stdout.clone()).map_err(|_| -> String { "E_TEST observation is not UTF-8".to_string() })?;
    let actual = record(trim(&text))?;
    if actual.index != 0 || actual.engine != "interpreter" || !actual.checked
        || actual.status as i64 != capture.status || !capture.result.is_empty() {
        return Err("E_TEST incomplete observation status or descriptor".to_string());
    }
    capture.stdout = actual.stdout;
    capture.stderr = actual.stderr;
    if !actual.diagnostic.is_empty() {
        capture.stderr.extend_from_slice(actual.diagnostic.as_bytes()); capture.stderr.push(b'\n');
    }
    Ok(capture)
}

fn diagnostic_code(text: &str) -> String {
    let bytes = text.as_bytes();
    let mut at = 0usize;
    while at + 2 < bytes.len() {
        if bytes[at] == b'E' && bytes[at + 1] == b'_' {
            let begin = at;
            at += 2;
            while at < bytes.len() && ((bytes[at] >= b'A' && bytes[at] <= b'Z') || bytes[at] == b'_' || (bytes[at] >= b'0' && bytes[at] <= b'9')) {
                at += 1;
            }
            return text[begin..at].to_string();
        }
        at += 1;
    }
    String::new()
}

fn raw_trap_code(text: &str) -> String {
    let bytes = text.as_bytes();
    let mut at = 0usize;
    while at + 4 < bytes.len() {
        if bytes[at] == b'R' && ((at == 0 && !text.contains(": R")) || (at >= 2 && bytes[at - 2] == b':' && bytes[at - 1] == b' ')) {
            let mut valid = true;
            for offset in 1..5 {
                if bytes[at + offset] < b'0' || bytes[at + offset] > b'9' {
                    valid = false;
                }
            }
            if valid && (at + 5 == bytes.len() || bytes[at + 5] == b' ') {
                let value = &text[at..at + 5];
                return value.to_string();
            }
        }
        at += 1;
    }
    String::new()
}

pub fn custom_trap(text: &str) -> bool {
    let code = raw_trap_code(text);
    !code.is_empty() && number(&code[1..]).unwrap_or(0) >= 16
}
pub fn trap_code(text: &str) -> String {
    let code = raw_trap_code(text);
    if !code.is_empty() && number(&code[1..]).unwrap_or(0) >= 16 { "R0004".to_string() } else { code }
}

fn trim(text: &str) -> &str {
    let bytes = text.as_bytes();
    let mut first = 0usize;
    let mut last = bytes.len();
    while first < last && bytes[first] <= 32 { first += 1; }
    while last > first && bytes[last - 1] <= 32 { last -= 1; }
    &text[first..last]
}

fn verify(case: &Case, actual: &Record) -> Result<bool, String> {
    let code = diagnostic_code(&actual.diagnostic);
    if !actual.checked {
        if !case.pending.is_empty() && (code == "E_PARSE" || code == "E_UNSUPPORTED") {
            return Ok(true);
        }
        if case.kind == "reject" && code == case.value {
            return Ok(false);
        }
        return Err(format!("expected {}, got {}", case.kind, actual.diagnostic));
    }
    if case.kind == "reject" {
        return Err(format!("expected {}, checker accepted", case.value));
    }
    if case.kind == "compare" {
        if !actual.diagnostic.is_empty() && trap_code(&actual.diagnostic).is_empty() {
            return Err(format!("unexpected host failure {}", actual.diagnostic));
        }
        return Ok(false);
    }
    if case.kind == "trap" {
        let found = trap_code(&actual.diagnostic);
        if actual.status == 0 || found != case.value {
            return Err(format!("expected {}, got {}", case.value, actual.diagnostic));
        }
        if case.line != 0 {
            let needle = format!(":{}: ", case.line);
            if !actual.diagnostic.contains(&needle) {
                return Err(format!("expected trap line {}, got {}", case.line, actual.diagnostic));
            }
        }
    } else if actual.status != case.status || !actual.diagnostic.is_empty() {
        return Err(format!("expected status {}, got {} {}", case.status, actual.status, actual.diagnostic));
    }
    if case.kind == "value" {
        let text = utf8(actual.stdout.clone(), "scalar is not UTF-8")?;
        if trim(&text) != case.value {
            return Err(format!("expected value {}, got {}", case.value, trim(&text)));
        }
    } else if actual.stdout != case.stdout {
        return Err(format!("stdout expected {}, got {}", hex(&case.stdout), hex(&actual.stdout)));
    }
    if actual.stderr != case.stderr {
        return Err(format!("stderr expected {}, got {}", hex(&case.stderr), hex(&actual.stderr)));
    }
    Ok(false)
}

fn same(left: &Record, right: &Record) -> bool {
    left.checked == right.checked && left.status == right.status && left.stdout == right.stdout
        && left.stderr == right.stderr
        && diagnostic_code(&left.diagnostic) == diagnostic_code(&right.diagnostic)
        && trap_code(&left.diagnostic) == trap_code(&right.diagnostic)
}

fn trap_line(text: &str) -> Option<usize> {
    let bytes = text.as_bytes();
    let mut at = 0usize;
    while at + 6 < bytes.len() {
        if bytes[at] == b':' && bytes[at + 1] == b' ' && bytes[at + 2] == b'R' {
            let mut first = at;
            while first > 0 && bytes[first - 1] >= b'0' && bytes[first - 1] <= b'9' {
                first -= 1;
            }
            if first > 0 && first < at && bytes[first - 1] == b':' {
                return number(&text[first..at]).ok();
            }
        }
        at += 1;
    }
    None
}

fn same_source(left: &Record, right: &Record) -> bool {
    if !same(left, right) { return false; }
    if custom_trap(&left.diagnostic) || custom_trap(&right.diagnostic) {
        return left.diagnostic == right.diagnostic;
    }
    if trap_code(&left.diagnostic).is_empty() { return true; }
    if trap_line(&left.diagnostic).is_none() || trap_line(&right.diagnostic).is_none() { return false; }
    match (left.diagnostic.find(": R"), right.diagnostic.find(": R")) {
        (Some(first), Some(second)) => left.diagnostic[..first] == right.diagnostic[..second],
        _ => false,
    }
}

struct Worker {
    process: Running,
    indices: Vec<usize>,
}

fn workers(
    world: &mut World,
    directory: &mut Directory,
    temporary: &str,
    cases: &[Case],
    jobs: usize,
    engines: &[String],
    library_directory: &Option<String>,
    store_directory: &Option<String>,
    store_key: &Option<String>,
    stats: bool,
    inline_limit: Option<usize>,
    store_capacity: usize,
) -> Result<Vec<Worker>, String> {
    let executable = world.executable().map_err(|e: i64| io("compiler executable", e))?;
    let mut result = Vec::new();
    let mut routes = String::new();
    for engine in engines {
        if !routes.is_empty() { routes.push(','); }
        routes.push_str(engine);
    }
    for worker in 0..jobs {
        let mut indices = Vec::new();
        let mut requests = String::new();
        let mut index = worker;
        while index < cases.len() {
            let case = &cases[index];
            let mode = if case.kind == "reject" || case.kind == "check" { "check" } else { "run" };
            requests.push_str(&format!("{mode}\t{}\t{}\n", case.entry, case.path));
            indices.push(index);
            if !case.reference.is_empty() {
                requests.push_str(&format!("run\t{}\t{}\n", case.entry, case.reference));
                indices.push(index);
            }
            index += jobs;
        }
        if indices.is_empty() { continue; }
        let name = format!("worker-{worker}");
        let mut file = directory.create(&name).map_err(|e: i64| io("requests", e))?;
        file.write_all(requests.as_bytes()).map_err(|e: i64| io("write requests", e))?;
        let mut args = vec![
            "batch".as_bytes().to_vec(), format!("{temporary}/{name}").into_bytes(),
            "--engines".as_bytes().to_vec(), routes.as_bytes().to_vec(),
            "--roundtrip".as_bytes().to_vec(),
        ];
        if let Some(path) = library_directory {
            args.push("--library-dir".as_bytes().to_vec()); args.push(path.as_bytes().to_vec());
        }
        if let Some(path) = store_directory {
            // Stable worker partitions let every batch publish without contending
            // on a different worker's lifetime policy lock.
            if let Ok(mut parent) = world.directory(path) { let _ = parent.create_directory(&name); }
            args.push("--store".as_bytes().to_vec()); args.push(format!("{path}/{name}").into_bytes());
            args.push("--store-bytes".as_bytes().to_vec()); args.push(format!("{}", store_capacity / 4usize).into_bytes());
        }
        if let Some(path) = store_key {
            args.push("--store-key".as_bytes().to_vec()); args.push(path.as_bytes().to_vec());
        }
        if stats { args.push("--stats".as_bytes().to_vec()); }
        if let Some(limit) = inline_limit {
            args.push("--inline-limit".as_bytes().to_vec()); args.push(format!("{limit}").into_bytes());
        }
        result.push(Worker { process: start(world, &executable, &args)?, indices });
    }
    Ok(result)
}

fn run_inner(
    world: &mut World,
    directory: &mut Directory,
    temporary: &str,
    cases: &[Case],
    jobs: usize,
    engines: &[String],
    library_directory: &Option<String>,
    store_directory: &Option<String>,
    store_key: &Option<String>,
    stats: bool,
    inline_limit: Option<usize>,
    store_capacity: usize,
) -> Result<(usize, usize, usize), String> {
    let active = workers(world, directory, temporary, cases, jobs, engines, library_directory, store_directory, store_key, stats, inline_limit, store_capacity)?;
    let mut passed = 0usize;
    let mut pending = 0usize;
    let mut failed = 0usize;
    for worker in active {
        let capture = finish(world, worker.process, 0)?;
        if capture.status != 0 {
            world.stderr().write(&capture.stderr);
            return Err(format!("E_TEST worker exited {}", capture.status));
        }
        if stats { world.stderr().write(&capture.stderr); }
        let text = utf8(capture.stdout, "E_TEST worker output UTF-8")?;
        let mut observed: BTreeMap<usize, Record> = BTreeMap::new();
        let mut references: BTreeMap<usize, Record> = BTreeMap::new();
        let mut count = 0usize;
        for line in pieces(&text, b'\n') {
            if line.is_empty() { continue; }
            let actual = record(&line)?;
            if actual.index >= worker.indices.len() || !engines.contains(&actual.engine) {
                return Err("E_TEST worker returned unexpected case or engine".to_string());
            }
            let case = &cases[worker.indices[actual.index]];
            match verify(case, &actual) {
                Ok(true) => pending += 1,
                Ok(false) => passed += 1,
                Err(problem) => {
                    failed += 1;
                    world.stderr().write(format!("FAIL {} {}: {problem}\n", case.path, actual.engine).as_bytes());
                }
            }
            if let Some(previous) = observed.get(&actual.index) {
                if previous.engine == actual.engine {
                    return Err("E_TEST duplicate worker observation".to_string());
                }
                if !same_source(previous, &actual) {
                    failed += 1;
                    world.stderr().write(format!("FAIL {}: native/interpreter outcomes differ\n", case.path).as_bytes());
                }
            }
            if !case.reference.is_empty() {
                let identity = worker.indices[actual.index];
                let found = {
                    if let Some(previous) = references.get(&identity) {
                        if !same(previous, &actual) {
                            failed += 1;
                            world.stderr().write(format!("FAIL {}: independent reference {} differs\n", case.path, case.reference).as_bytes());
                        }
                        true
                    } else { false }
                };
                if !found { references.insert(identity, actual.clone()); }
            }
            observed.insert(actual.index, actual);
            count += 1;
        }
        if count != worker.indices.len() * engines.len() {
            return Err(format!("E_TEST worker returned {count} observations for {} cases", worker.indices.len()));
        }
    }
    Ok((passed, pending, failed))
}

pub fn run_stored(
    world: &mut World,
    path: &str,
    jobs: usize,
    engines: &[String],
    library_directory: &Option<String>,
    store_directory: &Option<String>,
    store_key: &Option<String>,
    stats: bool,
    inline_limit: Option<usize>,
    store_capacity: usize,
) -> Result<u8, String> {
    if jobs == 0 || jobs > 8 {
        return Err("E_USAGE --jobs must be between one and eight".to_string());
    }
    let mut cases = Vec::new();
    discover(world, path, &mut cases)?;
    if cases.is_empty() {
        return Err(format!("E_TEST no expectation cases in {path}"));
    }
    let mut clock = world.clock();
    let started = clock.nanoseconds().map_err(|e: i64| io("clock", e))?;
    let temporary = format!(".lkjscript-test-{started}");
    let mut parent = world.directory(".").map_err(|e: i64| io("current directory", e))?;
    parent.create_directory(&temporary).map_err(|e: i64| io("worker directory", e))?;
    let result = match parent.open_directory(&temporary) {
        Err(errno) => Err(io("worker directory", errno)),
        Ok(mut directory) => {
            let result = run_inner(world, &mut directory, &temporary, &cases, jobs, engines, library_directory, store_directory, store_key, stats, inline_limit, store_capacity);
            for worker in 0..jobs {
                let _ = directory.remove(&format!("worker-{worker}"));
            }
            result
        }
    };
    let _ = parent.remove_directory(&temporary);
    let (passed, pending, failed) = result?;
    let elapsed = clock.nanoseconds().map_err(|e: i64| io("clock", e))? - started;
    if failed != 0 {
        return Err(format!("E_TEST {path}: {failed} failures, {passed} passed, {pending} pending"));
    }
    world.stdout().write(format!(
        "ok {path}: {} cases, {passed} route checks, {pending} pending ({}.{:03} s)\n",
        cases.len(), elapsed / 1_000_000_000, elapsed / 1_000_000 % 1000,
    ).as_bytes());
    Ok(0)
}


fn worker_records_preserve_bytes_and_require_completion() {
    let text = "{\"index\":0,\"engine\":\"native\",\"checkStatus\":0,\"status\":7,\"stdoutHex\":\"00ff80\",\"stderrHex\":\"fe00\",\"stderr\":\"line\\u000anext\"}";
    let actual = record(text).unwrap();
    assert_eq!(actual.stdout, vec![0u8, 255u8, 128u8]);
    assert_eq!(actual.stderr, vec![254u8, 0u8]);
    assert_eq!(actual.diagnostic, "line\nnext");
    assert!(record(&text[..text.len() - 1]).is_err());
    assert!(record("{\"index\":0}").is_err());
    assert!(unhex("0").is_err());
    assert!(unhex("gg").is_err());
    let empty = case("empty.lkj", "// expect: output\n// stdout:\n// stderr:\n").unwrap().unwrap();
    assert!(empty.kind == "output" && empty.stdout.is_empty() && empty.stderr.is_empty());
}

fn expectations_detect_outputs_rejections_and_trap_locations() {
    let mut actual = record("{\"index\":0,\"engine\":\"native\",\"checkStatus\":0,\"status\":0,\"stdoutHex\":\"34320a\",\"stderrHex\":\"\",\"stderr\":\"\"}").unwrap();
    let scalar = case("case.lkj", "// expect: value 42\n").unwrap().unwrap();
    assert_eq!(verify(&scalar, &actual).unwrap(), false);
    actual.stdout = "41\n".as_bytes().to_vec();
    assert!(verify(&scalar, &actual).is_err());
    let rejection = case("case.lkj", "// expect: reject E_BORROW\n").unwrap().unwrap();
    assert!(verify(&rejection, &actual).is_err());
    actual.checked = false;
    actual.diagnostic = "case.lkj:3:1: E_BORROW cannot move".to_string();
    assert_eq!(verify(&rejection, &actual).unwrap(), false);
    let trap = case("case.lkj", "// expect: trap R0003 12\n").unwrap().unwrap();
    actual.checked = true;
    actual.status = 1;
    actual.stdout = Vec::new();
    actual.diagnostic = "case.lkj:12: R0003 bounds".to_string();
    assert_eq!(verify(&trap, &actual).unwrap(), false);
    actual.diagnostic = "case.lkj:11: R0003 bounds".to_string();
    assert!(verify(&trap, &actual).is_err());
    assert!(case("case.lkj", "// expect: check\n// expect: value 42\n").is_err());
}

fn pending_specs_do_not_hide_unexpected_failures() {
    let expectation = case("case.lkj", "// expect: value 42\n// pending: missing scoped tasks\n").unwrap().unwrap();
    let mut actual = record("{\"index\":0,\"engine\":\"native\",\"checkStatus\":1,\"status\":1,\"stdoutHex\":\"\",\"stderrHex\":\"\",\"stderr\":\"case.lkj:1:1: E_UNSUPPORTED task\"}").unwrap();
    assert_eq!(verify(&expectation, &actual).unwrap(), true);
    actual.diagnostic = "case.lkj:1:1: E_BORROW unexpected".to_string();
    assert!(verify(&expectation, &actual).is_err());
}

fn comparisons_preserve_same_source_locations_and_reference_bytes() {
    let actual = record("{\"index\":0,\"engine\":\"native\",\"checkStatus\":0,\"status\":1,\"stdoutHex\":\"00\",\"stderrHex\":\"ff\",\"stderr\":\"a.lkj:12: R0003 bounds\"}").unwrap();
    let mut reference = actual.clone();
    reference.engine = "interpreter".to_string();
    reference.diagnostic = "b.lkj:27: R0003 bounds".to_string();
    assert!(same(&actual, &reference));
    assert!(!same_source(&actual, &reference));
    reference.diagnostic = "b.lkj:12: R0003 bounds".to_string();
    assert!(!same_source(&actual, &reference));
    assert_eq!(trap_code("R0006-in-path.lkj:12: R0003 bounds"), "R0003");
    reference.diagnostic = "a.lkj:12: R0003 different explanation".to_string();
    assert!(same_source(&actual, &reference));
    reference.diagnostic = "R0003 missing location".to_string();
    assert!(!same_source(&actual, &reference));
    reference.diagnostic = "b.lkj:27: R0003 bounds".to_string();
    reference.status = 0;
    assert!(!same(&actual, &reference));
    reference.status = 1;
    reference.stderr.push(0u8);
    assert!(!same(&actual, &reference));
    reference.diagnostic = String::new();
    reference.status = 101;
    let comparison = case("normal.lkj", "// expect: compare\n").unwrap().unwrap();
    assert_eq!(verify(&comparison, &reference).unwrap(), false);
}



fn same_source_custom_traps_preserve_message_code_and_file() {
    let actual = record("{\"index\":0,\"engine\":\"native\",\"checkStatus\":0,\"status\":1,\"stdoutHex\":\"\",\"stderrHex\":\"\",\"stderr\":\"file 1:12: R0016 alpha\\nR0006 is text\"}").unwrap();
    let mut reference = actual.clone();
    reference.engine = "interpreter".to_string();
    assert!(same_source(&actual, &reference));
    let mut prefix = String::new(); for _ in 0..1200 { prefix.push('x'); }
    let mut long_first = actual.clone(); let mut long_second = actual.clone();
    long_first.diagnostic = format!("child.lkj:12: R0016 {prefix}A");
    long_second.diagnostic = format!("child.lkj:12: R0016 {prefix}B");
    assert!(!same_source(&long_first, &long_second));
    for diagnostic in vec![
        "file 1:12: R0017 alpha\nR0006 is text".to_string(),
        "file 1:12: R0016 beta\nR0006 is text".to_string(),
        "file 2:12: R0016 alpha\nR0006 is text".to_string(),
        "file 1:13: R0016 alpha\nR0006 is text".to_string(),
        "file 1:12: R0016 alpha".to_string(),
    ] {
        reference.diagnostic = diagnostic;
        assert!(same(&actual, &reference));
        assert!(!same_source(&actual, &reference));
    }
}

fn write(directory: &mut Directory, name: &str, text: &str) -> Result<(), String> {
    let mut file = directory.create(name).map_err(|e: i64| io(name, e))?;
    file.write_all(text.as_bytes()).map_err(|e: i64| io("write witness source", e))
}

fn word(bytes: &[u8], offset: usize) -> u64 {
    let mut value = 0u64;
    for index in 0..8 {
        value |= (bytes[offset + index] as u64) << ((index * 8) as u64);
    }
    value
}

fn witness_record(actual: Capture) -> Result<Record, String> {
    if actual.result.len() != 24 {
        return Err(format!("E_TEST Rust witness exited {} without a complete result", actual.status));
    }
    let code = word(&actual.result, 0);
    let status = word(&actual.result, 16) as usize;
    if (code == 0 && status != actual.status as usize) || (code != 0 && actual.status != 101) {
        return Err("E_TEST Rust witness status/control mismatch".to_string());
    }
    Ok(Record {
        index: 0, engine: "rustc".to_string(), checked: true,
        status: if code == 0 { status } else { 1 },
        stdout: actual.stdout, stderr: actual.stderr,
        diagnostic: if code == 0 { String::new() } else { format!("R{code:04} witness trap") },
    })
}

fn witness_error_matches(metadata: &str, diagnostic: &str) -> bool {
    let bytes = metadata.as_bytes();
    let mut at = 0usize;
    let mut found = false;
    let mut matches = false;
    while at + 4 < bytes.len() {
        if bytes[at] == b'E' && bytes[at + 1] >= b'0' && bytes[at + 1] <= b'9' {
            found = true;
            if diagnostic.contains(&format!("[{}]", &metadata[at..at + 5])) { matches = true; }
        }
        at += 1;
    }
    !found || matches
}

// The optional host witness executes env by its ordinary path. Some Linux
// distributions use a multicall env whose identity check rejects execveat(fd).
fn witness_invoke(
    world: &mut World,
    shell: &File,
    arguments: &[Vec<u8>],
) -> Result<Capture, String> {
    let mut command = vec![
        "-c".as_bytes().to_vec(),
        "exec \"$@\"".as_bytes().to_vec(),
        "lkjscript-witness".as_bytes().to_vec(),
        "/usr/bin/env".as_bytes().to_vec(),
    ];
    for argument in arguments { command.push(argument.clone()); }
    invoke(world, shell, &command, 0)
}

fn witness_inner(
    world: &mut World,
    path: &str,
    rustc: &str,
    temporary: &str,
    directory: &mut Directory,
) -> Result<(usize, usize), String> {
    let mut discovered = Vec::new();
    discover(world, path, &mut discovered)?;
    let mut cases = Vec::new();
    for case in discovered {
        if !case.witness.is_empty() && case.path.ends_with(".lkj") { cases.push(case); }
    }
    if cases.is_empty() { return Err(format!("E_TEST no marked Rust cases in {path}")); }
    let rustc_path = rustc.to_string();
    let shell = open_file(world, "/bin/sh")?;
    let host = read(world, "witness/bridge/output.rs")?;
    let mut harness = "#![allow(dead_code,unused_imports,unused_variables)]\nmod host {\n".to_string();
    harness.push_str(&host);
    harness.push_str("\n}\n");
    for (index, case) in cases.iter().enumerate() {
        if case.kind == "reject" { continue; }
        harness.push_str(&format!("mod case_{index} {{\n"));
        if case.kind != "value" {
            harness.push_str("use crate::host::{World,Arguments,Environment,ExitStatus,Stdout,Stdin,Stderr,Directory,ReadDirectory,ReadFile,ForeignCommand,ForeignSession,NullDevice,File,Process,Clock,Child,Listener,Connector,Readiness,Entropy,Stop};\n");
        }
        harness.push_str(&read(world, &case.path)?);
        harness.push_str("\n}\n");
    }
    harness.push_str("fn main(){let name=std::env::var(\"LKJSCRIPT_ORACLE_CASE\").unwrap();match name.as_str(){\n");
    for (index, case) in cases.iter().enumerate() {
        if case.kind == "reject" { continue; }
        if case.kind == "value" {
            let entry = if case.entry.is_empty() { "probe" } else { case.entry.as_str() };
            harness.push_str(&format!("\"{index}\"=>host::observe(||{{println!(\"{{}}\",case_{index}::{entry}());0}}),\n"));
        } else {
            harness.push_str(&format!("\"{index}\"=>host::enter(case_{index}::main),\n"));
        }
    }
    harness.push_str("_=>std::process::exit(2)}}\n");
    write(directory, "positive.rs", &harness)?;
    let arguments = vec![
        "PATH=/usr/local/bin:/usr/bin:/bin".as_bytes().to_vec(), rustc_path.as_bytes().to_vec(),
        "--edition=2024".as_bytes().to_vec(), "--cfg".as_bytes().to_vec(),
        "lkjscript_control".as_bytes().to_vec(), "-C".as_bytes().to_vec(),
        "overflow-checks=yes".as_bytes().to_vec(), "-C".as_bytes().to_vec(),
        "opt-level=1".as_bytes().to_vec(), "-A".as_bytes().to_vec(), "warnings".as_bytes().to_vec(),
        format!("{temporary}/positive.rs").into_bytes(), "-o".as_bytes().to_vec(),
        format!("{temporary}/positive").into_bytes(),
    ];
    let built = witness_invoke(world, &shell, &arguments)?;
    if built.status != 0 {
        world.stderr().write(&built.stderr);
        return Err("E_TEST Rust witness harness did not compile".to_string());
    }
    let mut positive = 0usize;
    let mut negative = 0usize;
    let mut failures = 0usize;
    for (index, case) in cases.iter().enumerate() {
        if case.kind != "reject" {
            let arguments = vec![format!("LKJSCRIPT_ORACLE_CASE={index}").into_bytes(),
                format!("{temporary}/positive").into_bytes()];
            let actual = witness_record(witness_invoke(world, &shell, &arguments)?)?;
            let mut expectation = Case {
                path: case.path.clone(), kind: case.kind.clone(), value: case.value.clone(),
                stdout: case.stdout.clone(), stderr: case.stderr.clone(), status: case.status, line: 0,
                entry: case.entry.clone(), pending: String::new(), reference: String::new(), witness: String::new(),
            };
            // The Rust comparison checks the declared termination kind; source locations
            // belong to each language's own diagnostics.
            expectation.line = 0;
            if let Err(problem) = verify(&expectation, &actual) {
                failures += 1;
                world.stderr().write(format!("FAIL witness {}: {problem}\n", case.path).as_bytes());
            }
            positive += 1;
        } else {
            let source = read(world, &case.path)?;
            let source = if case.witness.contains("\"world\":true") {
                format!("mod host {{\n{host}\n}}\nmod case {{\nuse crate::host::{{World,Arguments,Environment,ExitStatus,Stdout,Stdin,Stderr,Directory,ReadDirectory,ReadFile,File,Process,Clock,Child,Listener,Connector,Readiness,Entropy,Stop}};\n{source}\n}}\n")
            } else { source };
            write(directory, "rejection.rs", &source)?;
            let arguments = vec!["PATH=/usr/local/bin:/usr/bin:/bin".as_bytes().to_vec(), rustc_path.as_bytes().to_vec(),
                "--edition=2024".as_bytes().to_vec(),
                "--crate-type=lib".as_bytes().to_vec(), "--emit=metadata".as_bytes().to_vec(),
                "-A".as_bytes().to_vec(), "warnings".as_bytes().to_vec(),
                format!("{temporary}/rejection.rs").into_bytes(), "-o".as_bytes().to_vec(),
                format!("{temporary}/rejection.rmeta").into_bytes()];
            let actual = witness_invoke(world, &shell, &arguments)?;
            let accepted = case.witness.contains("\"rustAccept\":true");
            let diagnostic = utf8(actual.stderr, "E_TEST Rust diagnostics UTF-8")?;
            if (actual.status == 0) != accepted || !witness_error_matches(&case.witness, &diagnostic) {
                failures += 1;
                world.stderr().write(format!("FAIL witness {}: unexpected Rust verdict {diagnostic}\n", case.path).as_bytes());
            }
            negative += 1;
        }
    }
    if failures != 0 { return Err(format!("E_TEST Rust witness: {failures} failures")); }
    Ok((positive, negative))
}

pub fn witness(world: &mut World, path: &str, rustc: &str) -> Result<u8, String> {
    let stamp = world.clock().nanoseconds().map_err(|e: i64| io("clock", e))?;
    let temporary = format!(".lkjscript-witness-{stamp}");
    let mut parent = world.directory(".").map_err(|e: i64| io("current directory", e))?;
    parent.create_directory(&temporary).map_err(|e: i64| io("witness directory", e))?;
    let outcome = {
        let mut directory = parent.open_directory(&temporary).map_err(|e: i64| io("witness directory", e))?;
        let outcome = witness_inner(world, path, rustc, &temporary, &mut directory);
        for bytes in directory.list().map_err(|e: i64| io("witness cleanup", e))? {
            let name = utf8(bytes, "E_TEST witness name UTF-8")?;
            directory.remove(&name).map_err(|e: i64| io("witness cleanup", e))?;
        }
        outcome
    };
    parent.remove_directory(&temporary).map_err(|e: i64| io("witness cleanup", e))?;
    let (positive, negative) = outcome?;
    world.stdout().write(format!("ok Rust witness: {positive} values/output cases, {negative} verdicts\n").as_bytes());
    Ok(0)
}


pub struct Observation {
    pub checked: bool,
    pub status: usize,
    pub stdout: Vec<u8>,
    pub stderr: Vec<u8>,
    pub diagnostic: String,
    pub timed_out: bool,
}

/// Evaluate one candidate with the same separated streams and termination
/// evidence as the suite runner. A timeout is an observation, never a finding.
pub fn evaluate(
    world: &mut World,
    executable: &File,
    path: &str,
    entry: &str,
    engine: &str,
    timeout_ns: usize,
    inline_limit: Option<usize>,
) -> Result<Observation, String> {
    if path.contains('\n') || path.contains('\t') || entry.contains('\n') || entry.contains('\t') {
        return Err("E_TEST batch paths and entries cannot contain tab or newline".to_string());
    }
    let stamp = world.clock().nanoseconds().map_err(|e: i64| io("clock", e))?;
    let name = format!(".lkjscript-observe-{stamp}");
    let mut directory = world.directory(".").map_err(|e: i64| io("current directory", e))?;
    write(&mut directory, &name, &format!("run\t{entry}\t{path}\n"))?;
    let mut arguments = vec![
        "batch".as_bytes().to_vec(), name.as_bytes().to_vec(),
        "--engine".as_bytes().to_vec(), engine.as_bytes().to_vec(),
    ];
    if let Some(limit) = inline_limit {
        arguments.push("--inline-limit".as_bytes().to_vec()); arguments.push(format!("{limit}").into_bytes());
    }
    let outcome = invoke(world, executable, &arguments, timeout_ns);
    directory.remove(&name).map_err(|e: i64| io("observation cleanup", e))?;
    let capture = outcome?;
    if capture.timed_out {
        return Ok(Observation {
            checked: false, status: 124, stdout: capture.stdout, stderr: capture.stderr,
            diagnostic: "did not terminate within the test allowance".to_string(),
            timed_out: true,
        });
    }
    if capture.status != 0 {
        return Err(format!("E_TEST worker exited {}: {}", capture.status, utf8(capture.stderr, "E_TEST diagnostic UTF-8")?));
    }
    let text = utf8(capture.stdout, "E_TEST worker output UTF-8")?;
    let mut records = Vec::new();
    for line in pieces(&text, b'\n') {
        if !line.is_empty() { records.push(record(&line)?); }
    }
    if records.len() != 1 {
        return Err(format!("E_TEST expected one observation, got {}", records.len()));
    }
    let actual = records.pop().unwrap();
    if actual.index != 0 || actual.engine != engine {
        return Err("E_TEST worker observation identity mismatch".to_string());
    }
    Ok(Observation {
        checked: actual.checked, status: actual.status, stdout: actual.stdout,
        stderr: actual.stderr, diagnostic: actual.diagnostic, timed_out: false,
    })
}

/// Pure observation-decoder contracts, executed by the closed gate root.
pub fn closed_contracts() -> usize {
    worker_records_preserve_bytes_and_require_completion();
    expectations_detect_outputs_rejections_and_trap_locations();
    pending_specs_do_not_hide_unexpected_failures();
    comparisons_preserve_same_source_locations_and_reference_bytes();
    same_source_custom_traps_preserve_message_code_and_file();
    5usize
}

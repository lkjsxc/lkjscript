//! Derive a reviewable transaction between two already checked source catalogs.
//! The driver must still check the candidate and compare its checked meaning
//! with the desired program. Text gaps and unsupported relocations fail closed.
use crate::{semantic, structure_edit};
use std::collections::BTreeMap;

struct Items {
    by_file: BTreeMap<String, Vec<usize>>,
    by_identity: BTreeMap<String, usize>,
}
fn failure(identity: &str, rule: &str, detail: &str) -> String {
    format!("{} E_REPLAY_{} {}", semantic::quote(identity), rule, detail)
}
fn selectable(kind: &str) -> bool {
    matches!(kind, "function" | "struct" | "enum" | "trait" | "implementation" | "alias" | "constant" | "module")
}
fn items(catalog: &semantic::Catalog) -> Result<Items, String> {
    let mut ordered: BTreeMap<(String, usize, usize, String), usize> = BTreeMap::new();
    for (index, item) in catalog.items.iter().enumerate() {
        if selectable(&item.kind) {
            ordered.insert((item.file.clone(), item.start, !item.end, item.identity.clone()), index);
        }
    }
    let mut result = Items { by_file: BTreeMap::new(), by_identity: BTreeMap::new() };
    let mut file = String::new(); let mut end = 0usize;
    for (_, index) in ordered {
        let item = &catalog.items[index];
        if item.file == file && item.start < end {
            if item.end <= end { continue; }
            return Err(failure(&item.identity, "OVERLAP", "declaration spans overlap without containment"));
        }
        file = item.file.clone(); end = item.end;
        result.by_identity.insert(item.identity.clone(), index);
        if !result.by_file.contains_key(&file) { result.by_file.insert(file.clone(), Vec::new()); }
        result.by_file.get_mut(&file).unwrap().push(index);
    }
    Ok(result)
}
fn input_index(inputs: &[(String, Vec<u8>)]) -> Result<BTreeMap<String, usize>, String> {
    let mut result: BTreeMap<String, usize> = BTreeMap::new();
    for (index, (path, bytes)) in inputs.iter().enumerate() {
        let previous = result.get(path).map(|index| *index);
        if let Some(previous) = previous {
            if inputs[previous].1 != *bytes {
                return Err(failure(path, "SOURCE", "conflicting source bytes for one path"));
            }
            continue;
        }
        result.insert(path.clone(), index);
    }
    Ok(result)
}

pub fn same_text(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)]) -> bool {
    let Ok(pairs) = file_pairs(before, before_inputs, after, after_inputs) else { return false; };
    let Ok(left) = input_index(before_inputs) else { return false; };
    let Ok(right) = input_index(after_inputs) else { return false; };
    for (before_file, after_file) in pairs {
        let (Ok(old), Ok(new)) = (input(before_inputs, &left, &before_file), input(after_inputs, &right, &after_file))
            else { return false; };
        if old != new { return false; }
    }
    true
}
fn input<'a>(inputs: &'a [(String, Vec<u8>)], index: &BTreeMap<String, usize>, path: &str) -> Result<&'a [u8], String> {
    let at = index.get(&path.to_string()).ok_or_else(|| failure(path, "SOURCE", "catalog file is absent from snapshot"))?;
    Ok(inputs[*at].1.as_slice())
}
fn pair(files: &mut BTreeMap<String, String>, reverse: &mut BTreeMap<String, String>,
    before: &str, after: &str) -> Result<(), String> {
    if let Some(previous) = files.get(&before.to_string()) {
        if *previous != after {
            return Err(failure(before, "FILE_SPLIT", "stable identities moved from one file into several files"));
        }
        return Ok(());
    }
    if reverse.contains_key(&after.to_string()) {
        return Err(failure(after, "FILE_JOIN", "stable identities moved from several files into one file"));
    }
    files.insert(before.to_string(), after.to_string());
    reverse.insert(after.to_string(), before.to_string());
    Ok(())
}
fn directory(path: &str) -> String {
    match path.rfind('/') { Some(at) => path[..at + 1usize].to_string(), None => String::new() }
}
fn file_pairs(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)]) -> Result<BTreeMap<String, String>, String> {
    let allowed: BTreeMap<String, bool> = BTreeMap::new();
    file_pairs_allowed(before, before_inputs, after, after_inputs, &allowed)
}
fn frame(catalog: &semantic::Catalog, selected: &Items, inputs: &[(String, Vec<u8>)],
    index: &BTreeMap<String, usize>, file: &str) -> Result<String, String> {
    let source = input(inputs, index, file)?;
    let mut gaps = Vec::new(); let mut at = 0usize;
    if let Some(items) = selected.by_file.get(&file.to_string()) {
        for index in items {
            let item = &catalog.items[*index];
            if item.start < at || item.end < item.start || item.end > source.len()
                || source[item.start..item.end] != *item.text.as_bytes() {
                return Err(failure(&item.identity, "SPAN", "catalog item does not match source bytes"));
            }
            gaps.extend_from_slice(&source[at..item.start]); gaps.push(b'\n');
            at = item.end;
        }
    }
    gaps.extend_from_slice(&source[at..]);
    let text = String::from_utf8(gaps).map_err(|_| -> String { failure(file, "SOURCE", "source is not UTF-8") })?;
    semantic::normalized_digest(&text)
}
fn common_order(catalog: &semantic::Catalog, selected: &Items, other: &Items, file: &str) -> Vec<String> {
    let mut result = Vec::new();
    if let Some(items) = selected.by_file.get(&file.to_string()) {
        for index in items {
            let identity = &catalog.items[*index].identity;
            if other.by_identity.contains_key(identity) { result.push(identity.clone()); }
        }
    }
    result
}
fn same_order(left: &[String], right: &[String]) -> bool {
    if left.len() != right.len() { return false; }
    for index in 0usize..left.len() { if left[index] != right[index] { return false; } }
    true
}
fn body(item: &semantic::Item) -> Result<String, String> {
    let (start, end) = item.body.ok_or_else(|| failure(&item.identity, "BODY", "item has no body"))?;
    if start < item.start || end < start || end > item.end {
        return Err(failure(&item.identity, "SPAN", "body is outside its item"));
    }
    String::from_utf8(item.text.as_bytes()[start - item.start..end - item.start].to_vec())
        .map_err(|_| -> String { failure(&item.identity, "SOURCE", "body splits UTF-8") })
}
fn same_frame(before: &semantic::Item, after: &semantic::Item) -> bool {
    let (Some((_, before_end)), Some((_, after_end))) = (before.body, after.body) else { return false; };
    if before.signature != after.signature || before_end < before.start || before_end > before.end
        || after_end < after.start || after_end > after.end { return false; }
    before.text.as_bytes()[before_end - before.start..] == after.text.as_bytes()[after_end - after.start..]
}
fn operation(out: &mut String, count: &mut usize, kind: &str, identity: &str,
    source: &str, expected: &str, anchor: &str) {
    if *count != 0usize { out.push(','); }
    out.push_str(&format!("{{\"op\":{},\"id\":{}", semantic::quote(kind), semantic::quote(identity)));
    if !source.is_empty() { out.push_str(&format!(",\"source\":{}", semantic::quote(source))); }
    if !expected.is_empty() { out.push_str(&format!(",\"expect\":{}", semantic::quote(expected))); }
    if !anchor.is_empty() { out.push_str(&format!(",\"before\":{}", semantic::quote(anchor))); }
    out.push('}'); *count += 1usize;
}
pub fn request(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)]) -> Result<structure_edit::Request, String> {
    request_with_scope(before, before_inputs, after, after_inputs, "")
}

struct Projections {
    by_identity: BTreeMap<String, structure_edit::Projection>,
    files: BTreeMap<String, bool>,
}

fn mounted<'a>(catalog: &'a semantic::Catalog, identity: &str) -> Option<&'a semantic::ModuleSource> {
    for source in &catalog.module_sources { if source.identity == identity { return Some(source); } }
    None
}

fn module_base(source: &semantic::ModuleSource) -> Result<String, String> {
    if source.parent.is_empty() || source.file.ends_with("/mod.lkj") || source.file == "mod.lkj" {
        return Ok(directory(&source.file));
    }
    if !source.file.ends_with(".lkj") {
        return Err(failure(&source.identity, "MODULE_PATH", "loaded module file has no .lkj suffix"));
    }
    Ok(format!("{}/", &source.file[..source.file.len() - 4usize]))
}

fn relative_projection(path: &str, scope: &str) -> Result<String, String> {
    let mut end = scope.len();
    while end > 1usize && scope.as_bytes()[end - 1usize] == b'/' { end -= 1usize; }
    let scope = &scope[..end];
    let relative = if scope == "." {
        if path.starts_with('/') { return Err(failure(path, "MODULE_SCOPE", "absolute projection cannot use a relative transaction scope")); }
        path.to_string()
    } else {
        let prefix = if scope == "/" { "/".to_string() } else { format!("{scope}/") };
        if !path.starts_with(&prefix) { return Err(failure(path, "MODULE_SCOPE", "new module is outside the transaction scope")); }
        path[prefix.len()..].to_string()
    };
    if relative.is_empty() || !relative.ends_with(".lkj") || relative.as_bytes().contains(&0u8) {
        return Err(failure(path, "MODULE_PATH", "projection needs a normalized relative .lkj path"));
    }
    for component in relative.as_str().split('/') {
        if component.is_empty() || component == "." || component == ".." {
            return Err(failure(path, "MODULE_PATH", "projection path contains an empty, current or parent component"));
        }
    }
    Ok(relative)
}

fn projections(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)], selected: &Items,
    scope: &str) -> Result<Projections, String> {
    let mut result = Projections { by_identity: BTreeMap::new(), files: BTreeMap::new() };
    if scope.is_empty() { return Ok(result); }
    let before_index = input_index(before_inputs)?; let after_index = input_index(after_inputs)?;
    let mut destinations: BTreeMap<String, bool> = BTreeMap::new();
    for source in &after.module_sources {
        if mounted(before, &source.identity).is_some() { continue; }
        if source.parent.is_empty() || before.by_identity.contains_key(&source.identity) {
            return Err(failure(&source.identity, "MODULE_PROJECTION", "new roots or inline-to-external changes need an explicit source decision"));
        }
        let index = selected.by_identity.get(&source.identity)
            .ok_or_else(|| failure(&source.identity, "MODULE_PROJECTION", "new module declaration is not a separate selected item"))?;
        let item = &after.items[*index];
        if item.kind != "module" || item.parent != source.parent {
            return Err(failure(&source.identity, "MODULE_PROJECTION", "loaded module does not match its selected declaration"));
        }
        let old_parent = mounted(before, &source.parent)
            .ok_or_else(|| failure(&source.identity, "MODULE_PARENT", "projection replay requires an existing loaded module parent"))?;
        let new_parent = mounted(after, &source.parent)
            .ok_or_else(|| failure(&source.identity, "MODULE_PARENT", "desired parent has no actual loaded module source"))?;
        if item.file != new_parent.file {
            return Err(failure(&source.identity, "MODULE_PARENT", "declaration does not belong to its loaded parent file"));
        }
        let name = structure_edit::external_module_name(&item.identity, &item.text)?;
        let identity = if item.parent == "crate" { name.clone() } else { format!("{}::{name}", item.parent) };
        if identity != source.identity {
            return Err(failure(&source.identity, "MODULE_PROJECTION", "external declaration identity does not match loader provenance"));
        }
        let old_base = module_base(old_parent)?; let new_base = module_base(new_parent)?;
        let direct = format!("{new_base}{name}.lkj"); let nested = format!("{new_base}{name}/mod.lkj");
        let destination = if source.file == direct && source.alternate == nested {
            format!("{old_base}{name}.lkj")
        } else if source.file == nested && source.alternate == direct {
            format!("{old_base}{name}/mod.lkj")
        } else {
            return Err(failure(&source.identity, "MODULE_PATH", "loaded file and alternate are not this parent's exact module candidates"));
        };
        if before_index.contains_key(&destination) {
            return Err(failure(&source.identity, "MODULE_EXISTING", "new projection destination is already a loaded source or data input"));
        }
        let path = relative_projection(&destination, scope)?;
        let body = input(after_inputs, &after_index, &source.file)?;
        String::from_utf8(body.to_vec()).map_err(|_| -> String {
            failure(&source.identity, "MODULE_SOURCE", "new module source is not UTF-8")
        })?;
        if result.files.contains_key(&source.file) || destinations.contains_key(&path) {
            return Err(failure(&source.identity, "MODULE_DUPLICATE", "projections repeat a source file or destination"));
        }
        result.files.insert(source.file.clone(), true); destinations.insert(path.clone(), true);
        result.by_identity.insert(source.identity.clone(), structure_edit::Projection {
            identity: source.identity.clone(), parent: source.parent.clone(), path, source: body.to_vec(),
        });
    }
    Ok(result)
}

fn file_pairs_allowed(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)],
    new_files: &BTreeMap<String, bool>) -> Result<BTreeMap<String, String>, String> {
    let mut files = BTreeMap::new(); let mut reverse = BTreeMap::new();
    pair(&mut files, &mut reverse, &before.root, &after.root)?;
    for item in &before.items {
        if !selectable(&item.kind) { continue; }
        if let Some(index) = after.by_identity.get(&item.identity) {
            pair(&mut files, &mut reverse, &item.file, &after.items[*index].file)?;
        }
    }
    for old_source in &before.module_sources {
        if let Some(new_source) = mounted(after, &old_source.identity) {
            pair(&mut files, &mut reverse, &old_source.file, &new_source.file)?;
        }
    }
    // Infer directory correspondence only from the root and stable source
    // identities. Include-only inputs have no item identity of their own.
    let mut directories: BTreeMap<String, Vec<String>> = BTreeMap::new();
    for (old_file, new_file) in &files {
        let old_directory = directory(old_file);
        let new_directory = directory(new_file);
        if !directories.contains_key(&old_directory) {
            directories.insert(old_directory.clone(), Vec::new());
        }
        let targets = directories.get_mut(&old_directory).unwrap();
        if !targets.contains(&new_directory) { targets.push(new_directory); }
    }
    let after_index = input_index(after_inputs)?;
    for (path, _) in before_inputs {
        if files.contains_key(path) { continue; }
        if after_index.contains_key(path) {
            pair(&mut files, &mut reverse, path, path)?;
            continue;
        }
        let mut selected = false;
        let mut prefix_length = 0usize;
        let mut target_directory = String::new();
        let mut ambiguous = false;
        for (old_directory, targets) in &directories {
            if path.starts_with(old_directory) && (!selected || old_directory.len() > prefix_length) {
                selected = true;
                prefix_length = old_directory.len();
                ambiguous = targets.len() != 1usize;
                target_directory = if ambiguous { String::new() } else { targets[0].clone() };
            }
        }
        if selected {
            if ambiguous {
                return Err(failure(path, "FILE_AMBIGUOUS", "stable identities imply several counterpart directories for this include-only input"));
            }
            let candidate = format!("{}{}", target_directory, &path[prefix_length..]);
            if after_index.contains_key(&candidate) {
                pair(&mut files, &mut reverse, path, &candidate)?;
                continue;
            }
        }
        return Err(failure(path, "FILES", "source file has no stable identity or unambiguous relative-path counterpart"));
    }
    for (path, _) in after_inputs {
        if !reverse.contains_key(path) && !new_files.contains_key(path) {
            return Err(failure(path, "FILES", "a newly loaded file needs an explicit file-creation operation"));
        }
    }
    for (path, _) in new_files {
        if reverse.contains_key(path) {
            return Err(failure(path, "MODULE_EXISTING", "a projected module body already has an existing input counterpart"));
        }
    }
    Ok(files)
}

fn projected_operation(out: &mut String, count: &mut usize, item: &semantic::Item,
    projection: &structure_edit::Projection, anchor: &str) -> Result<(), String> {
    let source = String::from_utf8(projection.source.clone())
        .map_err(|_| -> String { failure(&item.identity, "MODULE_SOURCE", "projection is not UTF-8") })?;
    if *count != 0usize { out.push(','); }
    out.push_str(&format!("{{\"op\":\"add-item\",\"id\":{},\"source\":{},\"projection\":{{\"path\":{},\"source\":{}}}",
        semantic::quote(&item.parent), semantic::quote(&item.text), semantic::quote(&projection.path), semantic::quote(&source)));
    if !anchor.is_empty() { out.push_str(&format!(",\"before\":{}", semantic::quote(anchor))); }
    out.push('}'); *count += 1usize; Ok(())
}

pub fn request_with_scope(before: &semantic::Catalog, before_inputs: &[(String, Vec<u8>)],
    after: &semantic::Catalog, after_inputs: &[(String, Vec<u8>)], scope: &str) -> Result<structure_edit::Request, String> {
    let old = items(before)?; let new = items(after)?;
    let before_index = input_index(before_inputs)?; let after_index = input_index(after_inputs)?;
    let projected = projections(before, before_inputs, after, after_inputs, &new, scope)?;
    let pairs = file_pairs_allowed(before, before_inputs, after, after_inputs, &projected.files)?;
    for (before_file, after_file) in &pairs {
        let old_bytes = input(before_inputs, &before_index, before_file)?;
        let new_bytes = input(after_inputs, &after_index, after_file)?;
        if old_bytes == new_bytes { continue; }
        if !old.by_file.contains_key(before_file) && !new.by_file.contains_key(after_file) {
            return Err(failure(before_file, "DATA", "changed include-only data needs an explicit data-file operation"));
        }
        if frame(before, &old, before_inputs, &before_index, before_file)?
            != frame(after, &new, after_inputs, &after_index, after_file)? {
            return Err(failure(before_file, "FRAME", "tokens outside selected declarations changed; imports/module framing need an explicit operation"));
        }
        let left = common_order(before, &old, &new, before_file);
        let right = common_order(after, &new, &old, after_file);
        if !same_order(&left, &right) {
            return Err(failure(before_file, "ORDER", "existing declarations were reordered; replay needs an ordered move operation"));
        }
    }
    let mut encoded = format!("{{\"version\":1,\"snapshot\":{},\"operations\":[", semantic::quote(&before.input_digest));
    let mut count = 0usize;
    for (identity, index) in &old.by_identity {
        let item = &before.items[*index];
        if let Some(next) = new.by_identity.get(identity) {
            let desired = &after.items[*next];
            if item.text == desired.text { continue; }
            if same_frame(item, desired) {
                operation(&mut encoded, &mut count, "replace-body", identity, &body(desired)?, &item.text_digest, "");
            } else {
                operation(&mut encoded, &mut count, "replace-item", identity, &desired.text, &item.text_digest, "");
            }
        } else {
            operation(&mut encoded, &mut count, "remove-item", identity, "", &item.text_digest, "");
        }
    }
    for (file, indices) in &new.by_file {
        if projected.files.contains_key(file) { continue; }
        for (position, index) in indices.iter().enumerate() {
            let item = &after.items[*index];
            if old.by_identity.contains_key(&item.identity) { continue; }
            if item.parent != "crate" && !before.by_identity.contains_key(&item.parent)
                && mounted(before, &item.parent).is_none() {
                return Err(failure(&item.identity, "PARENT", "added item has no existing source module parent"));
            }
            let mut anchor = String::new();
            for next in position + 1usize..indices.len() {
                let following = &after.items[indices[next]];
                if following.parent == item.parent && old.by_identity.contains_key(&following.identity) {
                    anchor = following.identity.clone(); break;
                }
            }
            if let Some(projection) = projected.by_identity.get(&item.identity) {
                projected_operation(&mut encoded, &mut count, item, projection, &anchor)?;
            } else {
                operation(&mut encoded, &mut count, "add-item", &item.parent, &item.text, "", &anchor);
            }
        }
    }
    if count == 0usize {
        return Err(failure("program", "NO_OPERATIONS", "no selected item changes; text-only gaps are compared separately"));
    }
    encoded.push_str("]}");
    structure_edit::parse(encoded.as_bytes())
}

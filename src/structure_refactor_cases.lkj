//! Focused refactoring contract cases over the production planner and checker.
mod ast; mod check; mod diagnostic; mod diagnostics; mod elaborate; mod facts;
mod frontend; mod generics; mod interpreter; mod ir; mod ir_binary; mod ir_text;
mod json; mod names; mod optimizer; mod resolve; mod reuse; mod runtime_memory;
mod native; mod x86; mod child_image; mod entry_grants; mod runtime; mod runtime_diagnostics; mod semantic; mod source; mod syntax;
mod structure_edit; mod structure_refactor;
pub use std::sha256;
pub fn main(mut world: World) { cases::run(&mut world); }

mod cases {
    use super::*;
    use std::collections::BTreeMap;

    struct Snapshot { catalog: semantic::Catalog, inputs: Vec<(String, Vec<u8>)>, checked: ir::CheckedProgram }
    fn snapshot(text: &str) -> Result<Snapshot, String> {
        let mut parsed = syntax::parse(text).map_err(|problem| problem.message)?;
        parsed.files[0usize].path = "fixture.lkj".to_string();
        let resolved = resolve::resolve(&parsed).map_err(|problem| problem.message)?;
        let definitions = elaborate::infer_resolved_all(&resolved).map_err(|problems| -> String { problems[0usize].message.clone() })?;
        let mut evidence = Some(elaborate::semantic::Evidence::default());
        let raw = elaborate::lower_definitions_recorded_semantic(definitions, &mut None, &mut evidence)
            .map_err(|problems| -> String { problems[0usize].message.clone() })?;
        let checked = check::check(raw).map_err(|problem| problem.message)?;
        let inputs = vec![("fixture.lkj".to_string(), text.as_bytes().to_vec())];
        let catalog = semantic::catalog_typed(&resolved, &inputs, &checked, &evidence)?;
        Ok(Snapshot { catalog, inputs, checked })
    }
    fn value(snapshot: &Snapshot) -> i64 {
        let program = snapshot.checked.program(); let mut entry: Option<usize> = None;
        for (index, function) in program.functions.iter().enumerate() { if function.name == "main" { entry = Some(index); } }
        let args: Vec<u64> = Vec::new(); let mut host: Vec<u8> = Vec::new();
        let result = interpreter::run(program, entry.unwrap(), &args, &mut host).unwrap();
        assert!(host.is_empty());
        match result.value { interpreter::Scalar::Int { value, .. } => value as i64, _ => panic!("fixture main must return an integer") }
    }
    fn plan(snapshot: &Snapshot, operation: &str) -> Result<Vec<structure_edit::Patch>, String> {
        let request = structure_edit::parse(format!("{{\"version\":1,\"operations\":[{operation}]}}").as_bytes())?;
        let mut patches = Vec::new();
        for operation in &request.operations {
            if !structure_refactor::plan(&snapshot.catalog, &snapshot.inputs, operation, &mut patches)? {
                return Err("unhandled operation".to_string());
            }
        }
        Ok(patches)
    }
    fn apply(snapshot: &Snapshot, operation: &str) -> Result<String, String> {
        let patches = plan(snapshot, operation)?; let original = &snapshot.inputs[0usize].1;
        let mut ordered: BTreeMap<(usize, usize), String> = BTreeMap::new();
        for patch in patches {
            assert_eq!(patch.file, "fixture.lkj");
            let key = (patch.start, patch.end);
            if let Some(old) = ordered.get(&key) { if *old != patch.replacement { return Err("different patches overlap".to_string()); } }
            ordered.insert(key, patch.replacement);
        }
        let mut cursor = 0usize; let mut bytes = Vec::new();
        for ((start, end), replacement) in ordered {
            if start < cursor || start > end || end > original.len() { return Err("patch ranges overlap".to_string()); }
            bytes.extend_from_slice(&original[cursor..start]); bytes.extend_from_slice(replacement.as_bytes()); cursor = end;
        }
        bytes.extend_from_slice(&original[cursor..]); Ok(String::from_utf8(bytes).unwrap())
    }
    fn accepts(source: &str, operation: &str, expected: i64) -> Result<(), String> {
        let before = snapshot(source).map_err(|error| -> String { format!("fixture {operation}: {error}\n{source}") })?; let original = before.inputs[0usize].1.clone();
        let after = apply(&before, operation)?; let checked = snapshot(&after).map_err(|error| -> String { format!("candidate {operation}: {error}\n{after}") })?;
        assert_eq!(value(&checked), expected); assert_eq!(before.inputs[0usize].1, original);
        if source.contains("// untouched:  spacing stays") { assert!(after.contains("// untouched:  spacing stays")); }
        Ok(())
    }
    fn same(source: &str, operation: &str) -> Result<(), String> {
        let before = snapshot(source).map_err(|error| -> String { format!("fixture {operation}: {error}\n{source}") })?; let expected = value(&before);
        accepts(source, operation, expected)
    }
    fn refuses(source: &str, operation: &str, rule: &str) -> Result<(), String> {
        let before = snapshot(source)?; let original = before.inputs[0usize].1.clone();
        if rule == "CHECK" {
            match apply(&before, operation) { Ok(after) => if snapshot(&after).is_ok() { return Err(format!("expected checker refusal: {operation}\n{after}")); }, Err(error) => return Err(format!("expected candidate checker refusal, got {error}")) }
        } else {
            match plan(&before, operation) { Err(error) => if !error.contains(rule) { return Err(format!("expected {rule}: {error}")); }, Ok(_) => return Err(format!("expected planner refusal {rule}: {operation}")) }
        }
        assert_eq!(before.inputs[0usize].1, original);
        let request = structure_edit::parse(format!("{{\"version\":1,\"operations\":[{operation}]}}").as_bytes()).unwrap();
        let mut patches = Vec::new();
        if structure_refactor::plan(&before.catalog, &before.inputs, &request.operations[0usize], &mut patches).is_err() { assert!(patches.is_empty()); }
        Ok(())
    }
    fn identity(snapshot: &Snapshot, kind: &str, parent: &str, name: &str) -> String {
        for item in &snapshot.catalog.items {
            if item.kind == kind && item.parent == parent && item.name == name { return item.identity.clone(); }
        }
        panic!("missing test identity {kind} {parent} {name}")
    }
    fn extract(source: &str, owner: &str, expression: &str, parameters: &str, result: &str) -> String {
        let parsed = snapshot(source).unwrap(); let item = &parsed.catalog.items[*parsed.catalog.by_identity.get(&owner.to_string()).unwrap()];
        let start = item.text.find(expression).unwrap(); let end = start + expression.len();
        format!("{{\"op\":\"extract-function\",\"id\":{},\"expect\":{},\"name\":\"extracted\",\"start\":{start},\"end\":{end},\"parameters\":{parameters},\"result\":{}}}",
            semantic::quote(owner), semantic::quote(&item.text_digest), semantic::quote(result))
    }
    fn tick() -> String { "fn tick(n: &mut i64) -> i64 { *n += 1i64; *n }\n".to_string() }
    fn signatures() -> Result<usize, String> {
        let source = format!("{}fn pair(a: i64, b: i64) -> i64 {{ a * 10i64 + b }}\n// untouched:  spacing stays\nfn main() -> i64 {{ let mut n = 0i64; let p = pair(tick(&mut n), tick(&mut n)); p * 10i64 + n }}", tick());
        same(&source, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:b","pair::param:a"]}"#)?;
        accepts(&source, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:a","pair::param:b",{"name":"added","type":"i64","argument":"tick(&mut n)"}]}"#, 123i64)?;
        refuses(&source, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:a","pair::param:b",{"name":"added","type":"i64","argument":"true"}]}"#, "CHECK")?;
        refuses(&source, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:b"]}"#, "CHECK")?;
        refuses(&source, r#"{"op":"change-signature","id":"pair","parameters":[{"name":"added","type":"i64","argument":"1i64","op":"ignored"}]}"#, "E_EDIT_REQUEST")?;
        let unused = format!("{}fn choose(a: i64, b: i64) -> i64 {{ a }} fn main() -> i64 {{ let mut n = 0i64; let p = choose(tick(&mut n), tick(&mut n)); p * 10i64 + n }}", tick());
        same(&unused, r#"{"op":"change-signature","id":"choose","parameters":["choose::param:a"]}"#)?;
        let nested = "fn pair(a: i64, b: i64) -> i64 { a * 10i64 + b } fn main() -> i64 { pair(pair(1i64, 2i64), 3i64) }";
        same(nested, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:b","pair::param:a"]}"#)?;
        let operand = "fn pair(a: i64, b: i64) -> i64 { a * 10i64 + b } fn main() -> i64 { pair(1i64, 2i64) + pair(3i64, 4i64) }";
        same(operand, r#"{"op":"change-signature","id":"pair","parameters":["pair::param:b","pair::param:a"]}"#)?;
        let capture = "const offset: i64 = 3i64; fn helper() -> i64 { offset } fn main() -> i64 { helper() }";
        refuses(capture, r#"{"op":"change-signature","id":"helper","parameters":[{"name":"offset","type":"i64","argument":"9i64"}]}"#, "E_EDIT_PARAMETER_CAPTURE")?;
        let width = "fn helper(value: u8) -> i64 { 0i64 } fn main() -> i64 { helper(255 + 1) }";
        let before = snapshot(width)?; let expected = outcome(&before); assert!(expected.is_err());
        let after = apply(&before, r#"{"op":"change-signature","id":"helper","parameters":[]}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        let borrowed = "struct Data { n: i64 } fn combine(value: &Data, add: i64) -> i64 { value.n + add } fn main() -> i64 { let data = Data { n: 3i64 }; combine(&data, 4i64) }";
        same(borrowed, r#"{"op":"change-signature","id":"combine","parameters":["combine::param:add","combine::param:value"]}"#)?;
        let anonymous = format!("{}fn twin(_: i64, named: i64, _: bool) -> i64 {{ named }} fn main() -> i64 {{ let mut n = 0i64; let value = twin(tick(&mut n), tick(&mut n), true); value * 10i64 + n }}", tick());
        let before = snapshot(&anonymous)?;
        assert!(before.catalog.by_identity.contains_key(&"twin::param:0".to_string()));
        assert!(before.catalog.by_identity.contains_key(&"twin::param:named".to_string()));
        assert!(before.catalog.by_identity.contains_key(&"twin::param:2".to_string()));
        assert!(!before.catalog.by_identity.contains_key(&"twin::param:_".to_string()));
        same(&anonymous, r#"{"op":"change-signature","id":"twin","parameters":["twin::param:2","twin::param:named","twin::param:0"]}"#)?;
        refuses(&anonymous, r#"{"op":"change-signature","id":"twin","parameters":["twin::param:_"]}"#, "E_EDIT_IDENTITY")?;
        refuses(&anonymous, r#"{"op":"change-signature","id":"twin","parameters":["twin::param:1"]}"#, "E_EDIT_IDENTITY")?;
        refuses(&anonymous, r#"{"op":"change-signature","id":"twin","parameters":["twin::param:0","twin::param:0"]}"#, "E_EDIT_PARAMETER")?;
        let anonymous_reference = "fn wildcard(_: i64, _: i64) -> i64 { _ } fn main() -> i64 { wildcard(1i64, 2i64) }";
        let before = snapshot(anonymous_reference)?;
        assert!(before.catalog.references.iter().any(|site| site.owner == "wildcard" && site.target == "wildcard::param:1"));
        refuses(anonymous_reference, r#"{"op":"change-signature","id":"wildcard","parameters":["wildcard::param:1","wildcard::param:0"]}"#, "E_EDIT_WILDCARD_PARAMETER")?;
        Ok(16usize)
    }
    fn fields() -> Result<usize, String> {
        let added = format!("{}struct Point {{ x: i64 }} fn main() -> i64 {{ let mut n = 0i64; let p = Point {{ x: tick(&mut n) }}; let Point {{ x }} = p; x * 10i64 + n }}", tick());
        accepts(&added, r#"{"op":"add-field","id":"Point","source":"y: i64","value":"tick(&mut n)"}"#, 12i64)?;
        refuses(&added, r#"{"op":"add-field","id":"Point","source":"y: i64","value":"true"}"#, "CHECK")?;
        let removed = format!("{}struct Point {{ x: i64, y: i64 }} fn main() -> i64 {{ let mut n = 0i64; let p = Point {{ x: tick(&mut n), y: tick(&mut n) }}; let Point {{ x, .. }} = p; x * 10i64 + n }}", tick());
        same(&removed, r#"{"op":"remove-field","id":"Point::field:y"}"#)?;
        let used = "struct Point { x: i64, y: i64 } fn main() -> i64 { let p = Point { x: 1i64, y: 2i64 }; let Point { x, y } = p; x + y }";
        refuses(used, r#"{"op":"remove-field","id":"Point::field:y"}"#, "E_EDIT_REMOVED_BINDING")?;
        let access = "struct Point { x: i64, y: i64 } fn main() -> i64 { let p = Point { x: 1i64, y: 2i64 }; p.y }";
        accepts(access, r#"{"op":"remove-field","id":"Point::field:y","replacement":"7i64"}"#, 7i64)?;
        refuses(access, r#"{"op":"remove-field","id":"Point::field:y"}"#, "E_EDIT_FIELD_VALUE")?;
        let nested = "struct Inner { value: i64, kept: i64 } struct Outer { value: i64 } fn main() -> i64 { let inner = Inner { value: 2i64, kept: 3i64 }; let outer = Outer { value: inner.value }; outer.value }";
        accepts(nested, r#"{"op":"remove-field","id":"Inner::field:value","replacement":"7i64"}"#, 7i64)?;
        let write = "struct Point { x: i64, y: i64 } fn main() -> i64 { let mut p = Point { x: 1i64, y: 2i64 }; p.y = 3i64; p.x }";
        refuses(write, r#"{"op":"remove-field","id":"Point::field:y","replacement":"7i64"}"#, "E_EDIT_FIELD_WRITE")?;
        let width = "struct Point { x: i64, y: u8 } fn main() -> i64 { Point { x: 0i64, y: 255 + 1 }.x }";
        let before = snapshot(width)?; let expected = outcome(&before); assert!(expected.is_err());
        let after = apply(&before, r#"{"op":"remove-field","id":"Point::field:y"}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        let joined = "enum Choice { A { x: i64 }, B { x: i64 } } fn main() -> i64 { match (Choice::A { x: 1i64 }) { Choice::A { x: value } | Choice::B { x: value } => value } }";
        refuses(joined, r#"{"op":"remove-field","id":"Choice::variant:A::field:x"}"#, "E_EDIT_REMOVED_BINDING")?;
        let generic = "struct Value<T> { old: T } fn main() -> u64 { Value { old: 2147483647 + 1 }.old as u64 }";
        refuses(generic, r#"{"op":"add-field","id":"Value","source":"new: T","value":"0u64"}"#, "CHECK")?;
        let associated = "mod types { pub struct Item { pub value: i64 } impl Item { pub fn new() -> Self { Self { value: 21i64 } } } } use types::Item as Alias; fn main() -> i64 { types::Item::new().value + Alias::new().value }";
        accepts(associated, r#"{"op":"add-field","id":"types::Item","source":"tag: i64","value":"0i64"}"#, 42i64)?;
        refuses(associated, r#"{"op":"add-field","id":"types::Item","source":"tag: i64","value":"true"}"#, "CHECK")?;
        Ok(13usize)
    }
    fn variants() -> Result<usize, String> {
        let added = "enum Choice { A } fn main() -> i64 { match Choice::A { Choice::A => 1i64 } }";
        same(added, r#"{"op":"add-variant","id":"Choice","source":"B","arm":"Choice::B => 2i64"}"#)?;
        refuses(added, r#"{"op":"add-variant","id":"Choice","source":"B","arm":"Choice::B => true"}"#, "CHECK")?;
        let removed = "enum Choice { A, B } fn main() -> i64 { match Choice::B { Choice::A => 1i64, Choice::B => 2i64 } }";
        accepts(removed, r#"{"op":"remove-variant","id":"Choice::variant:B","replacement":"Choice::A"}"#, 1i64)?;
        refuses(removed, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#, "E_EDIT_VARIANT_VALUE")?;
        let alternatives = "enum Choice { A, B, C } fn main() -> i64 { match Choice::A { Choice::A | Choice::B => 1i64, Choice::C => 2i64 } }";
        same(alternatives, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#)?;
        let nested = "enum Choice { A, B, C } enum Wrap { Some(Choice), None } fn main() -> i64 { match Wrap::Some(Choice::A) { Wrap::Some(Choice::A | Choice::B) => 1i64, Wrap::Some(Choice::C) => 2i64, Wrap::None => 0i64 } }";
        same(nested, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#)?;
        let width = "enum Choice { A, B(u8) } fn main() -> i64 { match Choice::B(255 + 1) { Choice::A => 0i64, Choice::B(_) => 1i64 } }";
        let before = snapshot(width)?; let expected = outcome(&before); assert!(expected.is_err());
        let after = apply(&before, r#"{"op":"remove-variant","id":"Choice::variant:B","replacement":"Choice::A"}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        let add_context = "enum Choice { A } fn main() -> u64 { (match Choice::A { Choice::A => 2147483647 + 1 }) as u64 }";
        refuses(add_context, r#"{"op":"add-variant","id":"Choice","source":"B","arm":"Choice::B => 0u64"}"#, "CHECK")?;
        let remove_context = "enum Choice { A, B } fn main() -> u64 { (match Choice::A { Choice::A => 255 + 1, Choice::B => 0u8 }) as u64 }";
        let before = snapshot(remove_context)?; let expected = outcome(&before); assert!(expected.is_err());
        let after = apply(&before, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        let generated = "enum Choice { A, B } fn make(n: &mut i64) -> Choice { *n += 1i64; Choice::A } fn main() -> i64 { let mut n = 0i64; let _ = matches!(make(&mut n), Choice::B); n }";
        refuses(generated, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#, "E_EDIT_MATCH_SOURCE")?;
        let wildcard = "enum Choice { A } type Identity<T> = T; type Alias = Identity<Choice>; fn make() -> Alias { Choice::A } fn main() -> i64 { match make() { _ => 1i64 } }";
        let operation = r#"{"op":"add-variant","id":"Choice","source":"B","arm":"Choice::B => 2i64"}"#;
        let before = snapshot(wildcard)?; let after = apply(&before, operation)?;
        assert!(after.contains("Choice::B => 2i64")); assert_eq!(value(&snapshot(&after)?), 1i64);
        let new_value = after.replace("fn make() -> Alias { Choice::A }", "fn make() -> Alias { Choice::B }");
        assert_eq!(value(&snapshot(&new_value)?), 2i64);
        let mut absent = snapshot(added)?; absent.catalog.references_recorded = false;
        match plan(&absent, operation) {
            Err(error) => assert!(error.contains("E_EDIT_REFERENCES")),
            Ok(_) => return Err("items-only catalog admitted a refactor".to_string()),
        }
        let add_scrutinee = "enum Choice<T> { A(T) } fn main() -> u64 { match Choice::A(2147483647 + 1) { Choice::A(_) => 0u64 } }";
        refuses(add_scrutinee, r#"{"op":"add-variant","id":"Choice","source":"B(T)","arm":"Choice::B(value) => value"}"#, "CHECK")?;
        let remove_scrutinee = "enum Choice<T> { A(T), B(T) } fn main() -> u64 { match Choice::A(255 + 1) { Choice::A(value) => value as u64, Choice::B(value) => { let _: u8 = value; 0u64 } } }";
        let before = snapshot(remove_scrutinee)?; let expected = outcome(&before); assert!(expected.is_err());
        let after = apply(&before, r#"{"op":"remove-variant","id":"Choice::variant:B"}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        Ok(14usize)
    }
    fn extractions() -> Result<usize, String> {
        let source = "fn compute(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { compute(5i64) }";
        let operation = extract(source, "compute", "x + 1i64", r#"[{"id":"compute::param:x","name":"value","type":"i64","argument":"x"}]"#, "i64");
        same(source, &operation)?;
        let missing = extract(source, "compute", "x + 1i64", "[]", "i64");
        refuses(source, &missing, "E_EDIT_CAPTURE")?;
        refuses(source, r#"{"op":"extract-function","id":"compute","expect":"wrong","name":"extracted","start":0,"end":1,"parameters":[],"result":"i64"}"#, "E_EDIT_STALE")?;
        let invalid = extract(source, "compute", "x + 1i64", r#"[{"id":"compute::param:x","name":"value","type":"i64","argument":"x"}]"#, "bool");
        refuses(source, &invalid, "E_EDIT_RESULT_TYPE")?;
        let mutable = "fn main() -> i64 { let mut x = 1i64; let answer = { x += 2i64; x }; answer + x }";
        let parsed = snapshot(mutable).unwrap(); let binding = identity(&parsed, "binding", "main", "x");
        let params = format!("[{{\"id\":{},\"name\":\"value\",\"type\":\"&mut i64\",\"argument\":\"&mut x\"}}]", semantic::quote(&binding));
        same(mutable, &extract(mutable, "main", "{ x += 2i64; x }", &params, "i64"))?;
        let params = format!("[{{\"id\":{},\"name\":\"value\",\"type\":\"i64\",\"argument\":\"x\"}}]", semantic::quote(&binding));
        refuses(mutable, &extract(mutable, "main", "{ x += 2i64; x }", &params, "i64"), "E_EDIT_CAPTURE_WRITE")?;
        let generic = "fn compute<T>(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { compute::<bool>(5i64) }";
        same(generic, &extract(generic, "compute", "x + 1i64", r#"[{"id":"compute::param:x","name":"value","type":"i64","argument":"x"}]"#, "i64"))?;
        let shorthand = "struct Point { x: i64 } fn make(x: i64) -> Point { Point { x } } fn main() -> i64 { make(4i64).x }";
        same(shorthand, &extract(shorthand, "make", "Point { x }", r#"[{"id":"make::param:x","name":"value","type":"i64","argument":"x"}]"#, "Point"))?;
        let call = "fn add(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { add(3i64) }";
        let parsed = snapshot(call).unwrap(); let id = identity(&parsed, "call-site", "main", "");
        let op = format!("{{\"op\":\"extract-function\",\"id\":{},\"name\":\"extracted\",\"parameters\":[],\"result\":\"i64\"}}", semantic::quote(&id));
        same(call, &op)?;
        let returns = "fn compute(x: i64) -> i64 { if x > 0i64 { return x; } 0i64 } fn main() -> i64 { compute(1i64) }";
        refuses(returns, &extract(returns, "compute", "return x", r#"[{"id":"compute::param:x","name":"value","type":"i64","argument":"x"}]"#, "i64"), "E_EDIT_CONTROL")?;
        let context = "fn main() -> u64 { (2147483647 + 1) as u64 }";
        refuses(context, &extract(context, "main", "2147483647 + 1", "[]", "u64"), "E_EDIT_RESULT_TYPE")?;
        let wrong_capture = extract(source, "compute", "x + 1i64", r#"[{"id":"compute::param:x","name":"value","type":"u64","argument":"x"}]"#, "i64");
        refuses(source, &wrong_capture, "E_EDIT_CAPTURE_TYPE")?;
        Ok(12usize)
    }
    fn inlines() -> Result<usize, String> {
        let source = format!("{}fn pair(a: i64, b: i64) -> i64 {{ a * 10i64 + b }} fn main() -> i64 {{ let mut n = 0i64; let p = pair(tick(&mut n), tick(&mut n)); p * 10i64 + n }}", tick());
        same(&source, r#"{"op":"inline-function","id":"pair","remove":true}"#)?;
        let scope = "fn offset() -> i64 { 7i64 } fn helper(x: i64) -> i64 { x + offset() } fn main() -> i64 { let offset = 100i64; helper(3i64) }";
        same(scope, r#"{"op":"inline-function","id":"helper","remove":true}"#)?;
        let terminal = "fn helper(x: i64) -> i64 { let value = x + 2i64; return value; } fn main() -> i64 { helper(3i64) }";
        same(terminal, r#"{"op":"inline-function","id":"helper","remove":true}"#)?;
        let early = "fn helper(x: i64) -> i64 { if x > 0i64 { return x; } 0i64 } fn main() -> i64 { helper(3i64) }";
        refuses(early, r#"{"op":"inline-function","id":"helper"}"#, "E_EDIT_CONTROL")?;
        let generic = "fn helper<T>(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { helper::<bool>(3i64) }";
        refuses(generic, r#"{"op":"inline-function","id":"helper"}"#, "E_EDIT_GENERIC_INLINE")?;
        let nested = "fn helper(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { helper(helper(3i64)) }";
        same(nested, r#"{"op":"inline-function","id":"helper","remove":true}"#)?;
        let selective = "fn helper(x: i64) -> i64 { x + 1i64 } fn main() -> i64 { helper(1i64) + helper(3i64) }";
        let parsed = snapshot(selective).unwrap(); let mut id = String::new();
        for item in &parsed.catalog.items { if item.kind == "call-site" && item.parent == "main" && item.text == "helper(1i64)" { id = item.identity.clone(); } }
        assert!(!id.is_empty());
        let operation = format!("{{\"op\":\"inline-function\",\"id\":\"helper\",\"sites\":[{}]}}", semantic::quote(&id));
        same(selective, &operation)?;
        let removal = format!("{{\"op\":\"inline-function\",\"id\":\"helper\",\"sites\":[{}],\"remove\":true}}", semantic::quote(&id));
        refuses(selective, &removal, "E_EDIT_CALL_SITE")?;
        let private = "mod inner { const OFFSET: i64 = 7i64; pub fn helper(x: i64) -> i64 { x + OFFSET } } fn main() -> i64 { inner::helper(3i64) }";
        refuses(private, r#"{"op":"inline-function","id":"inner::helper"}"#, "CHECK")?;
        let narrow = "fn narrow() -> u8 { 255 + 1 } fn main() -> u64 { narrow() as u64 }";
        let before = snapshot(narrow)?; let expected = outcome(&before); assert!(expected.is_err());
        let widened = snapshot("fn main() -> u64 { ({ { 255 + 1 } }) as u64 }")?;
        assert!(outcome(&widened) != expected);
        let after = apply(&before, r#"{"op":"inline-function","id":"narrow","remove":true}"#)?;
        assert!(outcome(&snapshot(&after)?) == expected);
        let result_alias = "mod inner { pub type Byte = u8; pub fn small() -> Byte { 3 + 4 } } fn main() -> u64 { inner::small() as u64 }";
        same(result_alias, r#"{"op":"inline-function","id":"inner::small","remove":true}"#)?;
        let dispatch = "mod types { pub struct Value {} pub trait A { fn read(&self) -> i64; } pub trait B { fn read(&self) -> i64; } impl A for Value { fn read(&self) -> i64 { 1i64 } } impl B for Value { fn read(&self) -> i64 { 2i64 } } } mod left { use crate::types::{Value, A}; pub fn helper(value: &Value) -> i64 { value.read() } } mod right { use crate::types::{Value, B}; pub fn run() -> i64 { let value = Value {}; crate::left::helper(&value) } } fn main() -> i64 { right::run() }";
        refuses(dispatch, r#"{"op":"inline-function","id":"left::helper"}"#, "E_EDIT_METHOD_SCOPE")?;
        let operation = r#"{"op":"inline-function","id":"helper","remove":true}"#;
        let template = "fn helper(__lkjscript_edit_0000000000000000_0_1: i64, second: i64) -> i64 { second } fn main() -> i64 { helper(1i64, 2i64) }";
        let parsed = snapshot(template)?; let mut position = 0usize;
        for item in &parsed.catalog.items { if item.kind == "call-site" && item.parent == "main" { position = item.start; } }
        let request = structure_edit::parse(format!("{{\"version\":1,\"operations\":[{operation}]}}").as_bytes())?;
        let digest = sha256::hex_digest(format!("{}:{position}", request.operations[0usize].data).as_bytes());
        let collision = format!("fn helper(__lkjscript_edit_{}_0_1: i64, second: i64) -> i64 {{ second }} fn main() -> i64 {{ helper(1i64, 2i64) }}", &digest[..16usize]);
        assert_eq!(template.len(), collision.len()); same(&collision, operation)?;
        let parent_visibility = "mod inner { pub(super) fn helper(x: i64) -> i64 { x + 1i64 } } fn main() -> i64 { inner::helper(3i64) }";
        same(parent_visibility, r#"{"op":"inline-function","id":"inner::helper","remove":true}"#)?;
        let restricted = "mod outer { mod inner { pub(in crate::outer) fn helper(x: i64) -> i64 { x + 1i64 } } pub fn run() -> i64 { inner::helper(3i64) } } fn main() -> i64 { outer::run() }";
        same(restricted, r#"{"op":"inline-function","id":"outer::inner::helper","remove":true}"#)?;
        let borrowed = "mod inner { pub struct Data { pub n: i64 } pub fn helper(value: &Data) -> i64 { value.n } } fn main() -> i64 { let value = inner::Data { n: 9i64 }; inner::helper(&value) }";
        same(borrowed, r#"{"op":"inline-function","id":"inner::helper","remove":true}"#)?;
        let wildcard = "struct Mark { out: Stdout } impl Drop for Mark { fn drop(&mut self) { self.out.write(b\"a\"); } } fn say(mut out: Stdout) { out.write(b\"b\"); } fn helper(_: Mark, out: Stdout) { say(out); } fn main(mut world: World) { helper(Mark { out: world.stdout() }, world.stdout()); }";
        let before = snapshot(wildcard)?; assert_eq!(output(&before)?, b"ba".as_slice().to_vec());
        let after = apply(&before, r#"{"op":"inline-function","id":"helper","remove":true}"#)?;
        assert_eq!(output(&snapshot(&after)?)?, b"ba".as_slice().to_vec());
        let anonymous = "struct First { out: Stdout } struct Last { out: Stdout } impl Drop for First { fn drop(&mut self) { self.out.write(b\"a\"); } } impl Drop for Last { fn drop(&mut self) { self.out.write(b\"c\"); } } fn say(mut out: Stdout) { out.write(b\"b\"); } fn helper(_: First, _: Last, out: Stdout) { say(out); } fn main(mut world: World) { helper(First { out: world.stdout() }, Last { out: world.stdout() }, world.stdout()); }";
        let before = snapshot(anonymous)?; let expected = output(&before)?;
        assert_eq!(expected.len(), 3usize); assert_eq!(expected[0usize], b'b');
        assert!(expected[1usize] != expected[2usize]);
        let after = apply(&before, r#"{"op":"inline-function","id":"helper","remove":true}"#)?;
        assert_eq!(output(&snapshot(&after)?)?, expected);
        let anonymous_reference = "fn wildcard(_: i64, _: i64) -> i64 { _ } fn main() -> i64 { wildcard(1i64, 2i64) }";
        refuses(anonymous_reference, r#"{"op":"inline-function","id":"wildcard","remove":true}"#, "E_EDIT_WILDCARD_PARAMETER")?;
        Ok(19usize)
    }
    fn report(world: &mut World, result: Result<usize, String>) -> usize {
        match result {
            Ok(count) => count,
            Err(error) => { world.stdout().write(format!("{error}\n").as_bytes()); panic!("structural refactor case failed"); }
        }
    }
            pub fn run(world: &mut World) {
        let mut count = 0usize;
        world.stdout().write(b"refactor signature cases\n"); count += report(world, signatures());
        world.stdout().write(b"refactor field cases\n"); count += report(world, fields());
        world.stdout().write(b"refactor variant cases\n"); count += report(world, variants());
        world.stdout().write(b"refactor extraction cases\n"); count += report(world, extractions());
        world.stdout().write(b"refactor inline cases\n"); count += report(world, inlines());
        world.stdout().write(b"refactor rename cases\n"); count += report(world, renames());
        world.stdout().write(b"refactor general rename cases\n"); count += report(world, general_renames());
        world.stdout().write(b"refactor rename scope cases\n"); count += report(world, rename_scope());
        world.stdout().write(b"refactor move cases\n"); count += report(world, moves());
        world.stdout().write(format!("ok structural refactor {count} cases\n").as_bytes());
    }

fn outcome(snapshot: &Snapshot) -> Result<interpreter::Scalar, String> {
    let program = snapshot.checked.program(); let mut entry: Option<usize> = None;
    for (index, function) in program.functions.iter().enumerate() { if function.name == "main" { entry = Some(index); } }
    let args: Vec<u64> = Vec::new(); let mut host: Vec<u8> = Vec::new();
    interpreter::run(program, entry.unwrap(), &args, &mut host).map(|result| result.value).map_err(|error| error.code())
}

fn output(snapshot: &Snapshot) -> Result<Vec<u8>, String> {
        let program = snapshot.checked.program(); let mut entry: Option<usize> = None;
        for (index, function) in program.functions.iter().enumerate() { if function.name == "main" { entry = Some(index); } }
        let args: Vec<u64> = Vec::new(); let mut host: Vec<u8> = Vec::new();
        interpreter::run(program, entry.unwrap(), &args, &mut host).map_err(|error| error.code())?;
        Ok(host)
    }

fn same_meaning(source: &str, operation: &str) -> Result<(), String> {
        let before = snapshot(source).map_err(|error| -> String { format!("fixture {operation}: {error}\n{source}") })?; let after = apply(&before, operation)?;
        let candidate = snapshot(&after).map_err(|error| -> String { format!("candidate {operation}: {error}\n{after}") })?;
        if meaning::identity(&before.checked) != meaning::identity(&candidate.checked) {
            return Err(format!("checked meaning differs after {operation}\n{after}"));
        }
        assert_eq!(value(&before), value(&candidate)); Ok(())
    }

fn renames() -> Result<usize, String> {
        let field = "struct Point { x: i64 } fn main() -> i64 { let x = 3i64; let point = Point { x }; let Point { x } = point; x }";
        same_meaning(field, r#"{"op":"rename","id":"Point::field:x","name":"value"}"#)?;
        let borrowed = "struct Point { x: i64 } fn main() -> i64 { let mut point = Point { x: 3i64 }; let Point { ref mut x } = point; *x += 2i64; *x }";
        same_meaning(borrowed, r#"{"op":"rename","id":"Point::field:x","name":"value"}"#)?;
        let collision = "struct Point { x: i64, y: i64 } fn main() -> i64 { Point { x: 1i64, y: 2i64 }.x }";
        refuses(collision, r#"{"op":"rename","id":"Point::field:x","name":"y"}"#, "E_EDIT_NAME")?;
        let variant = "enum Choice { Some { value: i64 }, None } use crate::Choice::Some as Some; fn main() -> i64 { match (Some { value: 4i64 }) { Choice::Some { value } => value, Choice::None => 0i64 } }";
        same_meaning(variant, r#"{"op":"rename","id":"Choice::variant:Some","name":"Ready"}"#)?;
        refuses(variant, r#"{"op":"rename","id":"Choice::variant:Some","name":"None"}"#, "E_EDIT_NAME")?;
        let inherent = "struct Value {} impl Value { fn read(&self) -> i64 { 7i64 } } fn main() -> i64 { let value = Value {}; value.read() }";
        same_meaning(inherent, r#"{"op":"rename","id":"Value::read","name":"read_value"}"#)?;
        let traits = "trait Read { fn read(&self) -> i64; } struct First {} struct Second {} impl Read for First { fn read(&self) -> i64 { 2i64 } } impl Read for Second { fn read(&self) -> i64 { 3i64 } } fn main() -> i64 { let first = First {}; let second = Second {}; first.read() + second.read() }";
        same_meaning(traits, r#"{"op":"rename","id":"Read::read","name":"read_value"}"#)?;
        let default = "trait Read { fn read(&self) -> i64 { 9i64 } } struct Value {} impl Read for Value {} fn main() -> i64 { 9i64 }";
        same_meaning(default, r#"{"op":"rename","id":"Read::read","name":"read_value"}"#)?;
        let mut missing = snapshot(inherent)?;
        let site = missing.catalog.references.iter().find(|site: &&semantic::Reference| site.target == "Value::read").unwrap().clone();
        missing.catalog.unresolved.push(site);
        match plan(&missing, r#"{"op":"rename","id":"Value::read","name":"read_value"}"#) {
            Err(error) => if !error.contains("E_EDIT_REFERENCES") { return Err(error); },
            Ok(_) => return Err("missing method evidence admitted rename".to_string()),
        }
        let module = "pub mod old { pub fn value() -> i64 { 5i64 } pub mod inner { pub fn run() -> i64 { super::value() } } } fn main() -> i64 { old::inner::run() }";
        same_meaning(module, r#"{"op":"rename","id":"old","name":"new"}"#)?;
        let module_alias = "mod container { pub mod old { pub fn value() -> i64 { 6i64 } } } use crate::container::old as old; fn main() -> i64 { old::value() }";
        same_meaning(module_alias, r#"{"op":"rename","id":"container::old","name":"new"}"#)?;
        let modules = "mod old {} mod new {} fn main() -> i64 { 0i64 }";
        refuses(modules, r#"{"op":"rename","id":"old","name":"new"}"#, "E_EDIT_NAME")?;
        Ok(12usize)
    }

fn moves() -> Result<usize, String> {
        let function = "fn offset() -> i64 { 7i64 } mod old { pub fn helper(n: i64) -> i64 { if n == 0i64 { crate::offset() } else { helper(n - 1i64) } } } mod fresh {} fn main() -> i64 { old::helper(2i64) }";
        same_meaning(function, r#"{"op":"move","id":"old::helper","parent":"fresh"}"#)?;
        let module = "fn offset() -> i64 { 4i64 } pub mod old { pub fn value() -> i64 { super::offset() } } mod fresh {} fn main() -> i64 { old::value() }";
        same_meaning(module, r#"{"op":"move","id":"old","parent":"fresh"}"#)?;
        let collision = "mod old { pub fn helper() -> i64 { 1i64 } } mod fresh { pub fn helper() -> i64 { 2i64 } } fn main() -> i64 { old::helper() + fresh::helper() }";
        refuses(collision, r#"{"op":"move","id":"old::helper","parent":"fresh"}"#, "E_EDIT_NAME")?;
        let imported = "mod old { pub fn helper() -> i64 { 1i64 } } mod fresh {} use crate::old::helper; fn main() -> i64 { helper() }";
        refuses(imported, r#"{"op":"move","id":"old::helper","parent":"fresh"}"#, "E_EDIT_MOVE_IMPORT")?;
        let method = "struct Value {} impl Value { fn read(&self) -> i64 { 1i64 } } mod old { pub fn helper(value: &crate::Value) -> i64 { value.read() } } mod fresh {} fn main() -> i64 { let value = Value {}; old::helper(&value) }";
        refuses(method, r#"{"op":"move","id":"old::helper","parent":"fresh"}"#, "E_EDIT_METHOD_SCOPE")?;
        let private = "mod old { const VALUE: i64 = 8i64; pub fn helper() -> i64 { VALUE } } mod fresh {} fn main() -> i64 { old::helper() }";
        refuses(private, r#"{"op":"move","id":"old::helper","parent":"fresh"}"#, "CHECK")?;
        let cycle = "mod old { pub mod inner {} } fn main() -> i64 { 0i64 }";
        refuses(cycle, r#"{"op":"move","id":"old","parent":"old::inner"}"#, "E_EDIT_MOVE_CYCLE")?;
        let imports = "fn offset() -> i64 { 3i64 } mod old { use crate::offset; pub fn helper() -> i64 { offset() } } mod fresh {} fn main() -> i64 { old::helper() }";
        refuses(imports, r#"{"op":"move","id":"old","parent":"fresh"}"#, "E_EDIT_MOVE_IMPORT")?;
        let standard = "mod host { pub mod std { pub fn value() -> i64 { 1i64 } } } mod fresh {} fn main() -> i64 { host::std::value() }";
        refuses(standard, r#"{"op":"move","id":"host::std","parent":"fresh"}"#, "E_EDIT_INTRINSIC_CAPTURE")?;
        let outgoing = "fn other() -> i64 { 1i64 } mod old { pub fn helper() -> i64 { crate::other() } } mod fresh {} fn main() -> i64 { old::helper() }";
        for category in 0usize..4usize {
        let mut missing = snapshot(outgoing)?;
        let item = &missing.catalog.items[*missing.catalog.by_identity.get(&"old::helper".to_string()).unwrap()];
        missing.catalog.unresolved.push(semantic::Reference { owner: item.identity.clone(), target: "other".to_string(),
            file: item.file.clone(), kind: match category {
                0usize => "implicit-source".to_string(),
                1usize => "unresolved-namespace-qualification".to_string(),
                2usize => "typed-method".to_string(),
                _ => "typed-field".to_string(),
            }, start: item.start, end: item.start });
        let request = structure_edit::parse(r#"{"version":1,"operations":[{"op":"move","id":"old::helper","parent":"fresh"}]}"#.as_bytes())?;
        let mut patches = Vec::new();
        match structure_refactor::plan(&missing.catalog, &missing.inputs, &request.operations[0usize], &mut patches) {
            Err(error) => if !error.contains("E_EDIT_SCOPE") { return Err(error); },
            Ok(_) => return Err("outgoing unresolved source admitted relocation".to_string()),
        }
        assert!(patches.is_empty());
        }
        Ok(13usize)
    }

fn general_renames() -> Result<usize, String> {
        let nominal = "struct Point { x: i64 } fn value(point: &Point) -> i64 { point.x } fn main() -> i64 { value(&Point { x: 3i64 }) }";
        same_meaning(nominal, r#"{"op":"rename","id":"Point","name":"Position"}"#)?;
        let variants = "enum Choice { A(i64), B } fn main() -> i64 { match Choice::A(4i64) { Choice::A(value) => value, Choice::B => 0i64 } }";
        same_meaning(variants, r#"{"op":"rename","id":"Choice","name":"Selection"}"#)?;
        let traits = "trait Read { fn read(&self) -> i64; } struct Value {} impl Read for Value { fn read(&self) -> i64 { 6i64 } } fn main() -> i64 { Value {}.read() }";
        same_meaning(traits, r#"{"op":"rename","id":"Read","name":"Readable"}"#)?;
        let aliases = "mod types { pub type Number = i64; } use crate::types::Number as Number; fn main() -> Number { 8i64 }";
        same_meaning(aliases, r#"{"op":"rename","id":"types::Number","name":"Count"}"#)?;
        let constants = "const offset: i64 = 5i64; struct Point { offset: i64 } fn main() -> i64 { Point { offset }.offset }";
        same_meaning(constants, r#"{"op":"rename","id":"offset","name":"bias"}"#)?;
        let parameters = "struct Point { x: i64 } fn value(x: i64) -> i64 { Point { x }.x } fn main() -> i64 { value(7i64) }";
        same_meaning(parameters, r#"{"op":"rename","id":"value::param:x","name":"input"}"#)?;
        let ordinary = "fn main() -> i64 { let mut value = 3i64; value += 2i64; value }";
        let parsed = snapshot(ordinary)?; let binding = identity(&parsed, "binding", "main", "value");
        same_meaning(ordinary, &format!("{{\"op\":\"rename\",\"id\":{},\"name\":\"total\"}}", semantic::quote(&binding)))?;
        let shorthand = "struct Point { x: i64 } fn main() -> i64 { let point = Point { x: 4i64 }; let Point { x } = point; Point { x }.x }";
        let parsed = snapshot(shorthand)?; let binding = identity(&parsed, "binding", "main", "x");
        same_meaning(shorthand, &format!("{{\"op\":\"rename\",\"id\":{},\"name\":\"value\"}}", semantic::quote(&binding)))?;
        let borrowed = "struct Point { x: i64 } fn main() -> i64 { let mut point = Point { x: 3i64 }; let Point { ref mut x } = point; *x += 2i64; *x }";
        let parsed = snapshot(borrowed)?; let binding = identity(&parsed, "binding", "main", "x");
        same_meaning(borrowed, &format!("{{\"op\":\"rename\",\"id\":{},\"name\":\"value\"}}", semantic::quote(&binding)))?;
        let generic = "struct Value<T> { value: T } fn main() -> i64 { Value { value: 7i64 }.value }";
        refuses(generic, r#"{"op":"rename","id":"Value::generic:T","name":"Element"}"#, "E_EDIT_GENERIC_REFERENCES")?;
        let collision = "fn value(x: i64, y: i64) -> i64 { x + y } fn main() -> i64 { value(2i64, 3i64) }";
        refuses(collision, r#"{"op":"rename","id":"value::param:x","name":"y"}"#, "E_EDIT_CAPTURE")?;
        let capture = "const total: i64 = 4i64; fn main() -> i64 { let value = 3i64; value + total }";
        let parsed = snapshot(capture)?; let binding = identity(&parsed, "binding", "main", "value");
        refuses(capture, &format!("{{\"op\":\"rename\",\"id\":{},\"name\":\"total\"}}", semantic::quote(&binding)), "E_EDIT_CAPTURE")?;
        let named = "struct Point {} struct Position {} fn main() -> i64 { 0i64 }";
        refuses(named, r#"{"op":"rename","id":"Point","name":"Position"}"#, "E_EDIT_NAME")?;
        let receiver = "struct Value {} impl Value { fn read(&self) -> i64 { 1i64 } } fn main() -> i64 { Value {}.read() }";
        refuses(receiver, r#"{"op":"rename","id":"Value::read::param:self","name":"value"}"#, "E_EDIT_LOCAL_NAME")?;
        Ok(14usize)
    }

fn rename_scope() -> Result<usize, String> {
        let generic = "struct Old { value: u8 } fn idle<New: Copy>(x: Old) -> u8 { 42u8 } fn main() -> i64 { 42i64 }";
        let operation = r#"{"op":"rename","id":"Old","name":"New"}"#;
        same_meaning(generic, operation)?;
        let before = snapshot(generic)?; let after = apply(&before, operation)?;
        assert!(after.contains("x: crate::New"));
        let hidden = "fn old() -> i64 { 1i64 } fn idle<T>() -> i64 { let renamed = || -> i64 { 2i64 }; old() } fn main() -> i64 { 42i64 }";
        let operation = r#"{"op":"rename","id":"old","name":"renamed"}"#;
        same_meaning(hidden, operation)?;
        let before = snapshot(hidden)?; let after = apply(&before, operation)?;
        assert!(after.contains("crate::renamed()"));
        let collision = "struct Value {} trait First { fn old(&self) -> i64; } trait Second { fn renamed(&self) -> i64; } impl First for Value { fn old(&self) -> i64 { 1i64 } } impl Second for Value { fn renamed(&self) -> i64 { 2i64 } } fn main() -> i64 { 42i64 }";
        refuses(collision, r#"{"op":"rename","id":"First::old","name":"renamed"}"#, "E_EDIT_METHOD_CAPTURE")?;
        let source = "fn chosen() -> i64 { 3i64 } fn other() -> i64 { 4i64 } fn main() -> i64 { chosen() }";
        let operation = r#"{"op":"rename","id":"chosen","name":"selected"}"#;
        for category in 0usize..2usize {
            let kind = if category == 0usize { "implicit-source" } else { "alias-origin" };
            let mut unrelated = snapshot(source)?;
            unrelated.catalog.unresolved.push(semantic::Reference { owner: "main".to_string(), target: "other".to_string(),
                file: "fixture.lkj".to_string(), kind: kind.to_string(), start: 0usize, end: 0usize });
            let after = apply(&unrelated, operation)?;
            assert_eq!(meaning::identity(&unrelated.checked), meaning::identity(&snapshot(&after)?.checked));
            for relevance in 0usize..2usize {
                let target = if relevance == 0usize { "chosen" } else { "" };
                let mut relevant = snapshot(source)?;
                relevant.catalog.unresolved.push(semantic::Reference { owner: "main".to_string(), target: target.to_string(),
                    file: "fixture.lkj".to_string(), kind: kind.to_string(), start: 0usize, end: 0usize });
                let request = structure_edit::parse(format!("{{\"version\":1,\"operations\":[{operation}]}}").as_bytes())?;
                let mut patches = Vec::new();
                match structure_refactor::plan(&relevant.catalog, &relevant.inputs, &request.operations[0usize], &mut patches) {
                    Err(error) => if !error.contains("E_EDIT_REFERENCES") { return Err(error); },
                    Ok(_) => return Err("relevant unresolved source admitted free-function rename".to_string()),
                }
                assert!(patches.is_empty());
            }
        }
        let intrinsic = "struct Old { value: u8 } fn main() -> i64 { 42i64 }";
        refuses(intrinsic, r#"{"op":"rename","id":"Old","name":"Vec"}"#, "E_EDIT_INTRINSIC_CAPTURE")?;
        let method = "trait Read { fn old(&self) -> usize; } impl Read for Vec<i64> { fn old(&self) -> usize { 7usize } } fn idle<T>(value: &Vec<i64>) -> usize { value.old() } fn main() -> i64 { 42i64 }";
        let misleading = method.replace("old", "len");
        assert_eq!(meaning::identity(&snapshot(method)?.checked), meaning::identity(&snapshot(&misleading)?.checked));
        let live = method.replace("fn main() -> i64 { 42i64 }", "fn main() -> usize { idle::<bool>(&Vec::new()) }");
        assert_eq!(value(&snapshot(&live)?), 7i64); assert_eq!(value(&snapshot(&live.replace("old", "len"))?), 0i64);
        refuses(method, r#"{"op":"rename","id":"Read::old","name":"len"}"#, "E_EDIT_METHOD_INTRINSIC")?;
        let protocol = "trait Old {} fn idle<T: Copy>(value: T) -> T { value } fn main() -> i64 { 42i64 }";
        refuses(protocol, r#"{"op":"rename","id":"Old","name":"Copy"}"#, "E_EDIT_INTRINSIC_CAPTURE")?;
        for category in 0usize..3usize {
            let kind = match category {
                0usize => "unresolved-namespace-qualification".to_string(),
                1usize => "typed-method".to_string(),
                _ => "typed-field".to_string(),
            };
            let mut namespace = snapshot(source)?;
            namespace.catalog.unresolved.push(semantic::Reference { owner: "main".to_string(), target: String::new(),
                file: "fixture.lkj".to_string(), kind: kind.to_string(), start: 0usize, end: 0usize });
            let after = apply(&namespace, operation)?;
            assert_eq!(meaning::identity(&namespace.checked), meaning::identity(&snapshot(&after)?.checked));
        }
        let imported_alias = "mod exports { pub fn source() -> i64 { 2i64 } pub use crate::exports::source as renamed; } mod inner { use crate::exports::*; pub fn old() -> i64 { 1i64 } pub fn idle<T>() -> i64 { renamed() } } fn main() -> i64 { 42i64 }";
        let captured_alias = imported_alias.replace("pub fn old()", "pub fn renamed()");
        assert_eq!(meaning::identity(&snapshot(imported_alias)?.checked), meaning::identity(&snapshot(&captured_alias)?.checked));
        let live_alias = imported_alias.replace("fn main() -> i64 { 42i64 }", "fn main() -> i64 { inner::idle::<bool>() }");
        assert_eq!(value(&snapshot(&live_alias)?), 2i64);
        assert_eq!(value(&snapshot(&live_alias.replace("pub fn old()", "pub fn renamed()"))?), 1i64);
        refuses(imported_alias, r#"{"op":"rename","id":"inner::old","name":"renamed"}"#, "E_EDIT_CAPTURE")?;
        let qualified_alias = "mod exports { pub fn source() -> i64 { 2i64 } pub use crate::exports::source as renamed; } mod inner { pub use crate::exports::*; pub fn old() -> i64 { 1i64 } } fn idle<T>() -> i64 { inner::renamed() } fn main() -> i64 { 42i64 }";
        refuses(qualified_alias, r#"{"op":"rename","id":"inner::old","name":"renamed"}"#, "E_EDIT_CAPTURE")?;
        let qualified_glob = "mod exports { pub fn renamed() -> i64 { 2i64 } } mod inner { pub use crate::exports::*; pub fn old() -> i64 { 1i64 } } fn idle<T>() -> i64 { inner::renamed() } fn main() -> i64 { 42i64 }";
        refuses(qualified_glob, r#"{"op":"rename","id":"inner::old","name":"renamed"}"#, "E_EDIT_CAPTURE")?;
        let direct = "mod other { pub fn renamed() -> i64 { 2i64 } } mod inner { pub fn old() -> i64 { 1i64 } } fn main() -> i64 { crate::other::renamed() + inner::old() }";
        same_meaning(direct, r#"{"op":"rename","id":"inner::old","name":"renamed"}"#)?;
        let grouped_function = "mod helpers { pub fn square(value: i64) -> i64 { value * value } } mod calls { use crate::helpers::square::{self}; pub fn run() -> i64 { square(3i64) } } fn main() -> i64 { calls::run() }";
        same_meaning(grouped_function, r#"{"op":"rename","id":"helpers::square","name":"squared"}"#)?;
        let grouped_module = "mod helpers { pub fn value() -> i64 { 3i64 } } use helpers::{self as visible, value}; fn main() -> i64 { visible::value() + value() }";
        same_meaning(grouped_module, r#"{"op":"rename","id":"helpers","name":"fresh"}"#)?;
        Ok(21usize)
    }
}

mod authority;

mod meaning;

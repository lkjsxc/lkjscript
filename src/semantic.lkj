//! Source identities are producer claims. Only checked IR supplies verified facts.
//! Text remains the repository projection; this catalog never authorizes code.
use crate::{ast as a, ir, json, names, resolve, sha256, syntax};
use std::collections::{BTreeMap, BTreeSet};
mod references;
pub(crate) mod macro_renames;
use references::*;

#[derive(Clone)]
pub struct Item {
    pub identity: String,
    pub parent: String,
    pub kind: String,
    pub name: String,
    pub file: String,
    pub start: usize,
    pub end: usize,
    pub name_start: usize,
    pub name_end: usize,
    pub body: Option<(usize, usize)>,
    /// Defining declaration for a validated generated projection; no authored bytes.
    pub generated_from: String,
    pub generated_expansion: String,
    pub signature: String,
    pub text: String,
    /// Source display only; type-sensitive operations use canonical_type.
    pub type_name: String,
    pub canonical_type: String,
    pub type_resolved: bool,
    pub file_digest: String,
    pub text_digest: String,
    pub signature_digest: String,
    pub body_digest: String,
    pub references_complete: bool,
}
#[derive(Clone)]
pub struct Reference {
    pub owner: String,
    pub target: String,
    pub file: String,
    pub kind: String,
    pub start: usize,
    pub end: usize,
}

/// Source-loader provenance, never inferred from arbitrary positive file reads.
#[derive(Clone)]
pub struct ModuleSource {
    pub identity: String,
    pub parent: String,
    pub file: String,
    pub alternate: String,
}
/// Display type spellings and resolved query keys are kept distinct.
pub struct Implementation {
    pub identity: String,
    pub target: String,
    pub trait_name: String,
    pub target_key: String,
    pub trait_key: String,
}

pub struct Catalog {
    pub configuration: a::BuildConfiguration,
    pub root: String,
    pub module_sources: Vec<ModuleSource>,
    /// Whether reference discovery was requested; false is declarations-only.
    pub references_recorded: bool,
    pub(crate) macro_replay: macro_renames::Proof,
    pub items: Vec<Item>,
    pub by_identity: BTreeMap<String, usize>,
    /// Resolver namespace slots, including a constructor's reserved value slot.
    pub namespace_slots: BTreeMap<String, String>,
    /// The complete metadata candidate universe, including noneditable type and IR identities.
    pub selector_kinds: BTreeMap<String, String>,
    pub references: Vec<Reference>,
    /// Semantic edges from validated expansions, never editable spelling sites.
    pub generated_references: Vec<Reference>,
    pub unresolved: Vec<Reference>,
    /// Resolved frontend expression types; None is unavailable or ambiguous.
    pub expression_types: BTreeMap<(String, usize, usize), Option<String>>,
    pub function_ids: Vec<String>,
    pub instance_ids: Vec<String>,
    pub instance_sources: Vec<String>,
    pub instance_arguments: Vec<String>,
    pub input_digest: String,
    pub implementations: Vec<Implementation>,
}
struct SourceText {
    path: String,
    text: String,
    digest: String,
    tokens: Vec<syntax::SemanticToken>,
}
fn word(out: &mut Vec<u8>, value: usize) {
    for shift in 0usize..8usize { out.push((value >> (shift * 8usize)) as u8); }
}
fn bytes(out: &mut Vec<u8>, value: &[u8]) {
    word(out, value.len()); out.extend_from_slice(value);
}
pub fn quote(value: &str) -> String {
    let mut out = Vec::new(); json::write_string(&mut out, value);
    String::from_utf8(out).unwrap()
}
pub fn module_name(value: &str) -> String {
    if value == "$std" { "std".to_string() }
    else if value.starts_with("$std::") { format!("std::{}", &value[6usize..]) }
    else { value.to_string() }
}
/// Accepts only resolver declaration or module scope paths.
pub fn declaration_path(value: &str) -> String {
    crate::elaborate::semantic::declaration_path(value)
}
/// The path is already canonical; namespace tagging never rewrites it.
pub fn source_identity(namespace: resolve::Namespace, path: &str) -> String {
    let prefix = match namespace { resolve::Namespace::Type => "type", resolve::Namespace::Value => "value" };
    format!("{prefix}@{path}")
}
/// Strip only the namespace marker; the remaining source path is not a selector.
pub fn source_path(identity: &str) -> &str {
    if identity.starts_with("type@") { &identity[5usize..] }
    else if identity.starts_with("value@") { &identity[6usize..] }
    else { identity }
}
/// Normalize source spelling while preserving the application's escaped std root.
pub fn canonical_source_path(path: &str) -> &str {
    if path.starts_with("crate::") {
        let unrooted = &path[7usize..];
        if unrooted != "std" && !unrooted.starts_with("std::") { return unrooted; }
    }
    path
}
/// Recover resolver scope names from canonical paths, never from source text.
pub fn resolver_module_path(path: &str) -> String {
    if path == "std" { "$std".to_string() }
    else if path.starts_with("std::") { format!("$std::{}", &path[5usize..]) }
    else if path == "crate::std" || path.starts_with("crate::std::") { path[7usize..].to_string() }
    else { path.to_string() }
}
pub fn selector_candidates(selector: &str, domain: &str) -> Result<Vec<String>, String> {
    if selector.contains('@') {
        let path = if selector.starts_with("builtin@") { &selector[8usize..] } else { source_path(selector) };
        if path == selector || path.is_empty() || path.contains('@') {
            return Err(format!("{} E_{}_SELECTOR expected one type@PATH, value@PATH or builtin@NAME marker", quote(selector), domain));
        }
        return Ok(vec![selector.to_string()]);
    }
    Ok(vec![selector.to_string(), format!("type@{selector}"),
        format!("value@{selector}"), format!("builtin@{selector}")])
}

impl Catalog {
    pub fn select(&self, selector: &str, domain: &str) -> Result<String, String> {
        let mut found: Vec<String> = Vec::new();
        let mut detail = String::new();
        let mut source = false;
        for candidate in selector_candidates(selector, domain)? {
            let Some(kind) = self.selector_kinds.get(&candidate) else { continue; };
            let mut root = candidate == "crate";
            for module in &self.module_sources { if module.identity == candidate { root = true; } }
            if self.by_identity.contains_key(&candidate) || root { source = true; }
            if !detail.is_empty() { detail.push_str(", "); }
            detail.push_str(&format!("{} ({kind})", quote(&candidate)));
            found.push(candidate);
        }
        if found.len() > 1usize {
            return Err(format!("{} E_{}_AMBIGUOUS select one canonical identity: {}", quote(selector), domain, detail));
        }
        if let Some(identity) = found.pop() {
            if source { return Ok(identity); }
            return Err(format!("{} E_{}_IDENTITY recorded identity has no editable source item", quote(&identity), domain));
        }
        if let Some(owner) = self.namespace_slots.get(&selector.to_string()) {
            return Err(format!("{} E_{}_IDENTITY constructor slot belongs to {}", quote(selector), domain, quote(owner)));
        }
        Err(format!("{} E_{}_IDENTITY identity is absent from this source snapshot", quote(selector), domain))
    }
    pub fn names_conflict(&self, left: &Item, right: &Item) -> bool {
        if self.namespace_slots.get(&left.identity) != Some(&left.identity)
            || self.namespace_slots.get(&right.identity) != Some(&right.identity) { return true; }
        for namespace in vec![resolve::Namespace::Type, resolve::Namespace::Value] {
            let left_slot = source_identity(namespace, source_path(&left.identity));
            let right_slot = source_identity(namespace, source_path(&right.identity));
            if self.namespace_slots.get(&left_slot) == Some(&left.identity)
                && self.namespace_slots.get(&right_slot) == Some(&right.identity) { return true; }
        }
        false
    }
}
fn root_parent(value: &str) -> String {
    if value.is_empty() { "crate".to_string() } else { source_identity(resolve::Namespace::Type, &declaration_path(value)) }
}
fn type_identity(module: &str, name: &str) -> String {
    source_identity(resolve::Namespace::Type, &qualified(module, name))
}
fn qualified(module: &str, name: &str) -> String {
    declaration_path(&names::qualified(module, name))
}
pub fn type_name(program: &a::Program, ty: usize) -> String {
    crate::elaborate::semantic::source_type_name(program, ty)
}
pub fn identity_type_name(program: &a::Program, ty: usize) -> String {
    crate::elaborate::semantic::identity_type_name(program, ty)
}
fn token_at(tokens: &[syntax::SemanticToken], position: usize) -> usize {
    let mut low = 0usize; let mut high = tokens.len();
    while low < high {
        let mid = low + (high - low) / 2usize;
        if tokens[mid].span.start < position { low = mid + 1usize; } else { high = mid; }
    }
    low
}
fn token_digest(tokens: &[syntax::SemanticToken], start: usize, end: usize) -> String {
    let mut out = b"lkjscript-semantic-tokens-1"[..].to_vec();
    let mut at = token_at(tokens, start);
    while at < tokens.len() && tokens[at].span.start < end {
        let token = &tokens[at];
        if token.span.end <= end {
            out.push(token.kind); bytes(&mut out, token.text.as_bytes());
        }
        at += 1usize;
    }
    sha256::hex_digest(&out)
}
pub fn normalized_digest(text: &str) -> Result<String, String> {
    let tokens = syntax::semantic_tokens(text).map_err(|problem| problem.message)?;
    Ok(token_digest(&tokens, 0usize, text.len()))
}
fn preceding(tokens: &[syntax::SemanticToken], start: usize) -> usize {
    let mut at = token_at(tokens, start);
    let original = at;
    if at > 0usize && tokens[at - 1usize].text == "pub" { at -= 1usize; }
    else if at > 0usize && tokens[at - 1usize].text == ")" {
        let mut scan = at - 1usize; let mut depth = 1usize;
        while scan > 0usize && depth != 0usize {
            scan -= 1usize;
            if tokens[scan].text == ")" { depth += 1usize; }
            else if tokens[scan].text == "(" { depth -= 1usize; }
        }
        if depth == 0usize && scan > 0usize && tokens[scan - 1usize].text == "pub" {
            at = scan - 1usize;
        }
    }
    loop {
        if at == 0usize || tokens[at - 1usize].text != "]" { break; }
        let mut scan = at - 1usize; let mut depth = 1usize;
        while scan > 0usize && depth != 0usize {
            scan -= 1usize;
            if tokens[scan].text == "]" { depth += 1usize; }
            else if tokens[scan].text == "[" { depth -= 1usize; }
        }
        if depth != 0usize || scan == 0usize || tokens[scan - 1usize].text != "#" { break; }
        at = scan - 1usize;
    }
    if at < original { tokens[at].span.start } else { start }
}
fn name_span(file: &SourceText, start: usize, end: usize, name: &str) -> (usize, usize) {
    let mut at = token_at(&file.tokens, start);
    while at < file.tokens.len() && file.tokens[at].span.end <= end {
        if (file.tokens[at].kind == 0u8 && syntax::identifier_matches(&file.tokens[at].text, name))
            || (file.tokens[at].kind == 5u8 && file.tokens[at].text == name) {
            return (file.tokens[at].span.start, file.tokens[at].span.end);
        }
        at += 1usize;
    }
    (start, start)
}
/// Render canonical evidence for display without changing its retained identity.
fn display_type_evidence(value: &str) -> Result<String, String> {
    if !value.contains("crate::std") { return Ok(value.to_string()); }
    let tokens = syntax::semantic_tokens(value)
        .map_err(|problem| -> String { format!("E_IDENTITY invalid type display evidence: {}", problem.message) })?;
    let mut out = String::new(); let mut at = 0usize;
    for index in 0usize..tokens.len() {
        if tokens[index].text != "crate" || index + 2usize >= tokens.len()
            || tokens[index + 1usize].text != "::" || tokens[index + 2usize].text != "std"
            || (index > 0usize && tokens[index - 1usize].text == "::") { continue; }
        out.push_str(&value[at..tokens[index].span.start]);
        at = tokens[index + 2usize].span.start;
    }
    out.push_str(&value[at..]); Ok(out)
}
fn append(
    result: &mut Catalog, files: &[SourceText], identity: String, parent: String,
    kind: &str, name: &str, span: a::Span, body: Option<(usize, usize)>,
    ty: String, attributes: bool,
) -> Result<(), String> {
    let display = display_type_evidence(&ty)?;
    append_evidence(result, files, identity, parent, kind, name, span, body, display, ty, attributes)
}
fn append_evidence(
    result: &mut Catalog, files: &[SourceText], identity: String, parent: String,
    kind: &str, name: &str, span: a::Span, body: Option<(usize, usize)>,
    ty: String, canonical_type: String, attributes: bool,
) -> Result<(), String> {
    if result.by_identity.contains_key(&identity) {
        return Err(format!("E_IDENTITY duplicate source identity {}", quote(&identity)));
    }
    let file = &files[span.file];
    if span.start > span.end || span.end > file.text.len() {
        return Err(format!("E_IDENTITY invalid source span for {}", quote(&identity)));
    }
    let start = if attributes { preceding(&file.tokens, span.start) } else { span.start };
    let mut signature_end = match body { Some((begin, _)) => begin, None => span.end };
    if matches!(kind, "module" | "trait" | "implementation") {
        let mut at = token_at(&file.tokens, span.start);
        while at < file.tokens.len() && file.tokens[at].span.start < span.end {
            if file.tokens[at].text == "{" { signature_end = file.tokens[at].span.start; break; }
            at += 1usize;
        }
    }
    let (name_start, name_end) = name_span(file, span.start, signature_end, name);
    // String slicing validates its entire backing file through as_str().
    // Validate only the selected ranges; source/token spans remain checked.
    let text = String::from_utf8(file.text.as_bytes()[start..span.end].to_vec())
        .map_err(|_| -> String { "E_IDENTITY item span splits UTF-8".to_string() })?;
    let signature = String::from_utf8(file.text.as_bytes()[start..signature_end].to_vec())
        .map_err(|_| -> String { "E_IDENTITY signature span splits UTF-8".to_string() })?;
    let body_digest = match body {
        Some((begin, end)) => token_digest(&file.tokens, begin, end),
        None => String::new(),
    };
    let generated_from = match result.by_identity.get(&parent) {
        Some(index) => result.items[*index].generated_from.clone(), None => String::new(),
    };
    let generated_expansion = match result.by_identity.get(&parent) {
        Some(index) => result.items[*index].generated_expansion.clone(), None => String::new(),
    };
    let generated = !generated_from.is_empty();
    let signature = if generated { ty.clone() } else { signature };
    let text = if generated { String::new() } else { text };
    let signature_digest = if generated { normalized_digest(&signature)? }
        else { token_digest(&file.tokens, start, signature_end) };
    let item = Item {
        identity: identity.clone(), parent, kind: kind.to_string(), name: name.to_string(),
        file: file.path.clone(), start, end: span.end,
        name_start: if generated { start } else { name_start },
        name_end: if generated { start } else { name_end },
        body: if generated { None } else { body }, generated_from, generated_expansion, signature_digest,
        text_digest: sha256::hex_digest(text.as_bytes()), body_digest,
        signature, text, type_name: ty, canonical_type,
        type_resolved: !matches!(kind, "binding" | "call-site"), file_digest: file.digest.clone(),
        references_complete: !generated,
    };
    result.by_identity.insert(identity, result.items.len());
    result.items.push(item);
    Ok(())
}
fn append_typed(
    result: &mut Catalog, files: &[SourceText], program: &a::Program,
    identity: String, parent: String, kind: &str, name: &str, span: a::Span,
    ty: Option<usize>, attributes: bool,
) -> Result<(), String> {
    let display = ty.map_or("_".to_string(), |ty| type_name(program, ty));
    let canonical = ty.map_or("_".to_string(), |ty| identity_type_name(program, ty));
    append_evidence(result, files, identity, parent, kind, name, span, None, display, canonical, attributes)
}
fn append_generics(result: &mut Catalog, files: &[SourceText], owner: &str, values: &[a::GenericParam]) -> Result<(), String> {
    for parameter in values {
        if parameter.implicit { continue; }
        append(result, files, format!("{}::generic:{}", owner, parameter.name), owner.to_string(),
            "generic-parameter", &parameter.name, parameter.span, None,
                if parameter.constant { "usize".to_string() } else { parameter.name.clone() }, false)?;
    }
    Ok(())
}
fn receiver_identity_type_name(program: &a::Program, ty: usize) -> String {
    let name = identity_type_name(program, ty);
    if let a::Type::Path(path) = &program.types[ty].kind {
        if path.declaration.is_some_and(|declaration| matches!(program.declarations[declaration].item,
            a::Item::Struct(_) | a::Item::Enum(_))) {
            return resolve::nominal_receiver_name(&name);
        }
    }
    name
}
fn function_identity(program: &a::Program, index: usize) -> String {
    let function = &program.functions[index];
    match program.function_owner(a::FunctionId { index }) {
        a::FunctionOwner::Free => source_identity(resolve::Namespace::Value, &qualified(&function.module, &function.name)),
        a::FunctionOwner::Trait(owner) => {
            let owner = &program.traits[owner.index];
            format!("{}::{}", qualified(&owner.module, &owner.name), function.name)
        }
        a::FunctionOwner::Implementation(owner) => {
            let owner = &program.impls[owner.index];
            let target = receiver_identity_type_name(program, owner.target);
            match owner.trait_ty {
                Some(trait_ty) => format!("<{} as {}>::{}", target, identity_type_name(program, trait_ty), function.name),
                None => format!("{}::{}", target, function.name),
            }
        }
    }
}
fn implementation_identity(program: &a::Program, index: usize) -> String {
    let value = &program.impls[index];
    let target = receiver_identity_type_name(program, value.target);
    let mut members: Vec<String> = Vec::new();
    for index in &value.methods { members.push(program.functions[*index].name.clone()); }
    for associated in &value.associated { members.push(format!("type:{}", associated.name)); }
    for constant in &value.constants { members.push(format!("const:{}", program.constants[*constant].name)); }
    members.sort();
    let mut identity = Vec::new();
    for member in members { bytes(&mut identity, member.as_bytes()); }
    let digest = sha256::hex_digest(&identity);
    match value.trait_ty {
        Some(trait_ty) => format!("impl:<{} as {}>#{}", target, identity_type_name(program, trait_ty), &digest[..16usize]),
        None => format!("impl:{}#{}", target, &digest[..16usize]),
    }
}
fn constant_owner(program: &a::Program, value: &a::Constant) -> Option<String> {
    let a::Type::Path(path) = &program.types[value.owner?].kind else { return None; };
    Some(program.declarations[path.declaration?].name.clone())
}
fn constant_identity(program: &a::Program, index: usize) -> String {
    let value = &program.constants[index];
    if let Some(owner) = program.constant_implementation(index) {
        let implementation = &program.impls[owner];
        if let Some(trait_ty) = implementation.trait_ty {
            return format!("<{} as {}>::{}", receiver_identity_type_name(program, implementation.target),
                identity_type_name(program, trait_ty), value.name);
        }
    }
    let owner = constant_owner(program, value).unwrap_or_else(|| value.module.clone());
    source_identity(resolve::Namespace::Value, &qualified(&owner, &value.name))
}
fn item_identity(program: &a::Program, item: a::Item, function_ids: &[String]) -> String {
    match item {
        a::Item::MacroInvocation(id) => format!("macro-invocation:{id}"),
        a::Item::Function(index) => function_ids[index].clone(),
        a::Item::Struct(index) => type_identity(&program.structs[index].module, &program.structs[index].name),
        a::Item::Enum(index) => type_identity(&program.enums[index].module, &program.enums[index].name),
        a::Item::Trait(index) => type_identity(&program.traits[index].module, &program.traits[index].name),
        a::Item::Impl(index) => implementation_identity(program, index),
        a::Item::Use(index) => format!("{}::use:{}", source_path(&root_parent(&program.uses[index].module)), program.uses[index].alias),
        a::Item::Module(index) => type_identity(&program.modules[index].parent, &program.modules[index].name),
        a::Item::Alias(index) => type_identity(&program.aliases[index].module, &program.aliases[index].name),
        a::Item::Constant(index) => constant_identity(program, index),
    }
}
fn declaration_identity(program: &a::Program, index: usize, function_ids: &[String]) -> Option<String> {
    let declaration = program.declarations.get(index)?;
    Some(item_identity(program, declaration.item, function_ids))
}
fn function_signature(program: &a::Program, function: &a::Function) -> String {
    let mut out = if function.const_qualified { "const fn".to_string() } else { "fn".to_string() };
    if function.generics.iter().any(|parameter| parameter.constant) {
        out.push('<');
        for (index, parameter) in function.generics.iter().enumerate() {
            if index != 0usize { out.push_str(", "); }
            if parameter.constant { out.push_str("const "); }
            out.push_str(&parameter.name);
            if parameter.constant { out.push_str(": usize"); }
        }
        out.push('>');
    }
    out.push('(');
    for (index, parameter) in function.params.iter().enumerate() {
        if index != 0usize { out.push_str(", "); }
        out.push_str(&type_name(program, parameter.ty));
    }
    out.push_str(") -> "); out.push_str(&type_name(program, function.result));
    for (index, predicate) in function.outlives.iter().enumerate() {
        out.push_str(if index == 0usize { " where " } else { ", " });
        out.push_str(&predicate.target.name); out.push_str(": ");
        for (index, bound) in predicate.bounds.iter().enumerate() {
            if index != 0usize { out.push_str(" + "); }
            out.push_str(&bound.name);
        }
    }
    let mut predicates = !function.outlives.is_empty();
    for parameter in &function.generics {
        if parameter.lifetime { continue; }
        let mut bounds = Vec::new();
        for bound in &parameter.bounds {
            if let Some(name) = crate::generics::type_outlives::lifetime(program, *bound) { bounds.push(name); }
        }
        if bounds.is_empty() { continue; }
        out.push_str(if predicates { ", " } else { " where " }); predicates = true;
        out.push_str(&parameter.name); out.push_str(": ");
        for (index, bound) in bounds.iter().enumerate() {
            if index != 0usize { out.push_str(" + "); }
            out.push_str(bound);
        }
    }
    out
}
fn source_type_key(program: &a::Program, ty: usize) -> String {
    let name = identity_type_name(program, ty);
    if let a::Type::Path(path) = &program.types[ty].kind {
        if let Some(declaration) = path.declaration {
            if matches!(program.declarations[declaration].item,
                a::Item::Struct(_) | a::Item::Enum(_) | a::Item::Trait(_) | a::Item::Alias(_)) {
                return source_identity(resolve::Namespace::Type, &name);
            }
        }
    }
    format!("builtin@{name}")
}

fn leaf_name(path: &str) -> &str {
    match path.rfind("::") { Some(at) => &path[at + 2usize..], None => path }
}
struct Owner {
    start: usize,
    end: usize,
    identity: String,
    parent: Option<usize>,
}
struct Owners { files: BTreeMap<String, Vec<Owner>> }
impl Owners {
    fn new(catalog: &Catalog) -> Self {
        let mut order: BTreeMap<String, Vec<(usize, usize, String)>> = BTreeMap::new();
        for item in &catalog.items {
            if matches!(item.kind.as_str(), "parameter" | "field" | "variant" | "generic-parameter" | "associated-type")
                || item.start == item.end || !item.generated_from.is_empty() { continue; }
            if !order.contains_key(&item.file) { order.insert(item.file.clone(), Vec::new()); }
            order.get_mut(&item.file).unwrap().push((item.start, (!0usize) - item.end, item.identity.clone()));
        }
        let mut files = BTreeMap::new();
        for (file, mut intervals) in order {
            intervals.sort();
            let mut nodes: Vec<Owner> = Vec::new();
            let mut stack: Vec<usize> = Vec::new();
            for (start, inverse_end, identity) in intervals {
                let end = (!0usize) - inverse_end;
                loop {
                    let Some(last) = ({ stack.last().copied() }) else { break; };
                    if nodes[last].start <= start && end <= nodes[last].end { break; }
                    stack.pop();
                }
                let parent = stack.last().copied();
                stack.push(nodes.len());
                nodes.push(Owner { start, end, identity, parent });
            }
            files.insert(file, nodes);
        }
        Self { files }
    }
    fn get(&self, file: &str, start: usize, end: usize) -> Option<String> {
        let nodes = self.files.get(&file.to_string())?;
        let mut low = 0usize; let mut high = nodes.len();
        while low < high {
            let mid = low + (high - low) / 2usize;
            if nodes[mid].start <= start { low = mid + 1usize; } else { high = mid; }
        }
        if low == 0usize { return None; }
        let mut at = low - 1usize;
        loop {
            if nodes[at].start <= start && end <= nodes[at].end { return Some(nodes[at].identity.clone()); }
            at = nodes[at].parent?;
        }
    }
}
fn add_reference(result: &mut Catalog, files: &[SourceText], owner: String, target: String,
    span: a::Span, name: &str, kind: &str, proven: bool) {
    let file = &files[span.file];
    let (start, end) = name_span(file, span.start, span.end, name);
    let reference = Reference { owner: owner.clone(), target, file: file.path.clone(), kind: kind.to_string(), start, end };
    if proven && start < end { result.references.push(reference); }
    else {
        if let Some(index) = result.by_identity.get(&owner) { result.items[*index].references_complete = false; }
        result.unresolved.push(reference);
    }
}
fn numeric(text: &str) -> Option<usize> {
    if text.is_empty() { return None; }
    let mut result = 0usize;
    for byte in text.bytes() {
        if !byte.is_ascii_digit() { return None; }
        result = result.checked_mul(10usize)?.checked_add((byte - b'0') as usize)?;
    }
    Some(result)
}
fn ir_source(program: &a::Program, catalog: &Catalog, free: &BTreeMap<String, String>, name: &str) -> Option<(String, String)> {
    let end = name.find('<').unwrap_or(name.len());
    let base = &name[..end];
    let source = match base.rfind("$f") {
        Some(at) => {
            let index = numeric(&base[at + 2usize..])?;
            let function = program.functions.get(index)?;
            if names::qualified(&function.module, &function.name).as_str() != &base[..at] { return None; }
            catalog.function_ids[index].clone()
        }
        None => free.get(&base.to_string())?.clone(),
    };
    Some((source, name[end..].to_string()))
}
fn nominal_ir_head(name: &str, canonical: bool) -> String {
    if canonical { declaration_path(name) } else { module_name(name) }
}
fn nominal_ir_name(program: &ir::Program, name: &str, canonical: bool) -> String {
    let Some(start) = name.find('<') else { return nominal_ir_head(name, canonical); };
    if !name.ends_with('>') { return nominal_ir_head(name, canonical); }
    let mut out = nominal_ir_head(&name[..start], canonical); out.push('<');
    let mut first = true;
    for argument in name[start + 1usize..name.len() - 1usize].split(',') {
        if !argument.starts_with('t') { return nominal_ir_head(name, canonical); }
        let Some(ty) = numeric(&argument[1usize..]) else { return nominal_ir_head(name, canonical); };
        if ty >= program.types.len() { return nominal_ir_head(name, canonical); }
        if !first { out.push(','); } first = false;
        out.push_str(&ir_type_name_form(program, ty, canonical));
    }
    out.push('>'); out
}
fn ir_type_name_form(program: &ir::Program, ty: usize, canonical: bool) -> String {
    let value = &program.types[ty];
    match &value.kind {
        ir::TypeKind::Ref { inner, mutable } => format!("&{}{}", if *mutable { "mut " } else { "" }, ir_type_name_form(program, *inner, canonical)),
        ir::TypeKind::Slice { inner, mutable } => format!("[{}{}]", if *mutable { "mut " } else { "" }, ir_type_name_form(program, *inner, canonical)),
        ir::TypeKind::Vec { inner } => format!("Vec<{}>", ir_type_name_form(program, *inner, canonical)),
        ir::TypeKind::Box { inner } => format!("Box<{}>", ir_type_name_form(program, *inner, canonical)),
        // Named source values can use existing array storage without acquiring
        // a structural array identity. Keep that declared name in query keys;
        // the checked type facts still expose the exact representation ID.
        ir::TypeKind::Array { .. } if !value.name.starts_with('[') =>
            nominal_ir_name(program, &value.name, canonical),
        ir::TypeKind::Array { inner, len } => format!("[{};{}]", ir_type_name_form(program, *inner, canonical), len),
        ir::TypeKind::Struct { fields, .. } if value.name.starts_with('(') => {
            let mut out = "(".to_string();
            for (index, field) in fields.iter().enumerate() {
                if index != 0usize { out.push(','); }
                out.push_str(&ir_type_name_form(program, field.ty, canonical));
            }
            if fields.len() == 1usize { out.push(','); }
            out.push(')'); out
        }
        ir::TypeKind::Struct { .. } | ir::TypeKind::Enum { .. } => nominal_ir_name(program, &value.name, canonical),
        _ => if canonical { value.name.clone() } else { module_name(&value.name) },
    }
}
pub fn ir_type_name(program: &ir::Program, ty: usize) -> String {
    ir_type_name_form(program, ty, false)
}
/// Raw lowered IR retains resolver paths in nominal names; normalized unit names are already canonical.
pub fn ir_identity_type_name(program: &ir::Program, ty: usize) -> String {
    ir_type_name_form(program, ty, true)
}
/// Nominal source types use declaration identities; structural names use builtin keys.
pub fn type_key(catalog: &Catalog, name: &str) -> String {
    let base = name.find('<').map_or(name, |at| &name[..at]);
    let identity = source_identity(resolve::Namespace::Type, base);
    if catalog.by_identity.get(&identity).is_some_and(|index|
        matches!(catalog.items[*index].kind.as_str(), "struct" | "enum" | "trait" | "alias")) {
        source_identity(resolve::Namespace::Type, name)
    } else { format!("builtin@{name}") }
}
pub fn ir_type_is_nominal(value: &ir::Type) -> bool {
    match &value.kind {
        ir::TypeKind::Struct { .. } => !value.name.starts_with('('),
        ir::TypeKind::Enum { .. } => true,
        ir::TypeKind::Array { .. } => !value.name.starts_with('['),
        _ => false,
    }
}
pub fn ir_type_key(catalog: &Catalog, value: &ir::Type, name: &str) -> String {
    if ir_type_is_nominal(value) { type_key(catalog, name) } else { format!("builtin@{name}") }
}
/// Collect exactly the metadata identities published by semantic_facts, without building facts.
fn collect_selector_metadata(catalog: &Catalog, program: &ir::Program) -> BTreeMap<String, String> {
    let mut result: BTreeMap<String, String> = BTreeMap::new();
    result.insert("crate".to_string(), "module".to_string());
    for source in &catalog.module_sources { result.insert(source.identity.clone(), "module".to_string()); }
    for item in &catalog.items { result.insert(item.identity.clone(), item.kind.clone()); }
    for implementation in &catalog.implementations {
        for which in 0usize..2usize {
            let selected = if which == 0usize { &implementation.target_key } else { &implementation.trait_key };
            if selected.is_empty() { continue; }
            if !result.contains_key(selected) {
                let kind = if selected.starts_with("builtin@") { "builtin" } else { "type-name" };
                result.insert(selected.clone(), kind.to_string());
            }
            if let Some(at) = selected.find('<') {
                let base = selected[..at].to_string();
                if !result.contains_key(&base) {
                    let kind = if base.starts_with("builtin@") { "builtin" } else { "type-family" };
                    result.insert(base, kind.to_string());
                }
            }
        }
    }
    for identity in &catalog.instance_ids { result.insert(identity.clone(), "recorded identity".to_string()); }
    for (index, value) in program.types.iter().enumerate() {
        let name = ir_identity_type_name(program, index);
        let selected = ir_type_key(catalog, value, &name);
        if !result.contains_key(&selected) {
            let kind = if selected.starts_with("builtin@") { "builtin" } else { "type-name" };
            result.insert(selected, kind.to_string());
        }
        result.insert(format!("ir:type:{name}"), "recorded identity".to_string());
    }
    result
}
fn instance_arguments(program: &ir::Program, raw: &str) -> String {
    if raw.is_empty() { return String::new(); }
    if !raw.starts_with('<') || !raw.ends_with('>') { return raw.to_string(); }
    let mut result = "<".to_string();
    let mut first = true;
    for pair in raw[1usize..raw.len() - 1usize].split(';') {
        if pair.is_empty() { continue; }
        let Some(at) = pair.find("=t") else { return raw.to_string(); };
        let Some(ty) = numeric(&pair[at + 2usize..]) else { return raw.to_string(); };
        if ty >= program.types.len() { return raw.to_string(); }
        if !first { result.push_str(","); } first = false;
        result.push_str(&pair[..at]); result.push('=');
        result.push_str(&ir_identity_type_name(program, ty));
    }
    result.push('>'); result
}

/// The caller provides the resolved source and the checked product of that exact
/// elaboration. Source-only answers remain explicitly frontend claims.
pub fn catalog(program: &a::Program, inputs: &[(String, Vec<u8>)], checked: &ir::CheckedProgram) -> Result<Catalog, String> {
    catalog_typed(program, inputs, checked, &None)
}
pub fn catalog_typed(program: &a::Program, inputs: &[(String, Vec<u8>)], checked: &ir::CheckedProgram,
    evidence: &Option<crate::elaborate::semantic::Evidence>) -> Result<Catalog, String> {
    catalog_mode(program, inputs, checked, evidence, true)
}


/// Named parameters retain their spelling identity. An anonymous parameter
/// uses its zero-based signature position, stable until those positions change.
pub(crate) fn parameter_identity(owner: &str, name: &str, position: usize) -> String {
    if name == "_" { format!("{owner}::param:{position}") }
    else { format!("{owner}::param:{name}") }
}
fn catalog_mode(program: &a::Program, inputs: &[(String, Vec<u8>)], checked: &ir::CheckedProgram,
    evidence: &Option<crate::elaborate::semantic::Evidence>, include_references: bool) -> Result<Catalog, String> {
    if !program.resolved { return Err("E_IDENTITY source is not resolved".to_string()); }
    crate::syntax::macros::provenance::validate_inputs(program, inputs)
        .map_err(|problem| -> String { format!("E_IDENTITY_ORIGIN {}", problem.message) })?;
    let resolver = resolve::Resolver::new(program).map_err(|problem| problem.message)?;
    let origins = origins::collect(program, &resolver)?;
    let mut by_path: BTreeMap<String, usize> = BTreeMap::new();
    let mut input_identity = b"lkjscript-source-snapshot-2"[..].to_vec();
    word(&mut input_identity, program.configuration.debug_assertions as usize);
    for (index, (path, raw)) in inputs.iter().enumerate() { by_path.insert(path.clone(), index); }
    for (path, index) in &by_path {
        bytes(&mut input_identity, path.as_bytes());
        bytes(&mut input_identity, sha256::hex_digest(&inputs[*index].1).as_bytes());
    }
    let mut files = Vec::new();
    for file in &program.files {
        let index = by_path.get(&file.path).ok_or_else(|| -> String { format!("E_IDENTITY missing source {}", quote(&file.path)) })?;
        let raw = &inputs[*index].1;
        let text = String::from_utf8(raw.clone()).map_err(|_| -> String { "E_IDENTITY source is not UTF-8".to_string() })?;
        let tokens = syntax::semantic_tokens(&text).map_err(|problem| problem.message)?;
        files.push(SourceText { path: file.path.clone(), digest: sha256::hex_digest(raw), text, tokens });
    }
    let mut result = Catalog {
        configuration: program.configuration,
        root: program.files[0usize].path.clone(), module_sources: Vec::new(), references_recorded: include_references,
        items: Vec::new(), by_identity: BTreeMap::new(), namespace_slots: BTreeMap::new(), selector_kinds: BTreeMap::new(), references: Vec::new(), generated_references: Vec::new(), unresolved: Vec::new(),
        expression_types: BTreeMap::new(), macro_replay: macro_renames::Proof::default(),
        function_ids: Vec::new(), instance_ids: Vec::new(), instance_sources: Vec::new(),
        implementations: Vec::new(), instance_arguments: Vec::new(), input_digest: sha256::hex_digest(&input_identity),
    };
    for module in &program.modules {
        if module.name == "crate" {
            return Err(format!("{} E_IDENTITY module name crate is reserved; file={} start={} end={}",
                quote(&names::qualified(&module.parent, &module.name)), quote(&program.files[module.span.file].path),
                module.span.start, module.span.end));
        }
    }
    let mut mounted: BTreeSet<String> = BTreeSet::new();
    for loaded in &program.loaded_modules {
        if loaded.scope >= program.scopes.len() || loaded.file >= program.files.len() {
            return Err("E_IDENTITY invalid loaded module source".to_string());
        }
        let scope = &program.scopes[loaded.scope];
        let identity = root_parent(&scope.path);
        if !mounted.insert(identity.clone()) {
            return Err(format!("E_IDENTITY duplicate loaded module {}", quote(&identity)));
        }
        let parent = match scope.parent {
            Some(parent) => root_parent(&program.scopes[parent].path),
            None => String::new(),
        };
        result.module_sources.push(ModuleSource { identity, parent,
            file: program.files[loaded.file].path.clone(), alternate: loaded.alternate.clone() });
    }
    for index in 0usize..program.functions.len() { result.function_ids.push(function_identity(program, index)); }
    for declaration in &program.declarations {
        let owner = item_identity(program, declaration.item, &result.function_ids);
        let (types, values) = resolve::declaration_namespaces(program, declaration.item);
        for namespace in vec![resolve::Namespace::Type, resolve::Namespace::Value] {
            if !(match namespace { resolve::Namespace::Type => types, resolve::Namespace::Value => values }) { continue; }
            let slot = source_identity(namespace, &declaration_path(&declaration.name));
            if result.namespace_slots.insert(slot.clone(), owner.clone()).is_some() {
                return Err(format!("E_IDENTITY duplicate source namespace slot {}", quote(&slot)));
            }
        }
    }
    macro_sources::append_entries(&mut result, &files, program)?;
    for (index, value) in program.functions.iter().enumerate() {
        let identity = result.function_ids[index].clone();
        let parent = match program.function_owner(a::FunctionId { index }) {
            a::FunctionOwner::Free => root_parent(&value.module),
            a::FunctionOwner::Implementation(owner) => implementation_identity(program, owner.index),
            a::FunctionOwner::Trait(owner) => type_identity(&program.traits[owner.index].module, &program.traits[owner.index].name),
        };
        let body = value.body.map(|body| (program.blocks[body].span.start, program.blocks[body].span.end));
        append(&mut result, &files, identity.clone(), parent, "function", &value.name,
            value.span, body, function_signature(program, value), true)?;
        if let Some(structure) = origins.functions[index] {
            generated_projection(&mut result, &files, program, &identity, structure, function_signature(program, value), true)?;
        }
        for (position, parameter) in value.params.iter().enumerate() {
            append_typed(&mut result, &files, program, parameter_identity(&identity, &parameter.name, position), identity.clone(),
                "parameter", &parameter.name, parameter.span, Some(parameter.ty), false)?;
        }
        for parameter in &value.generics {
            if parameter.implicit { continue; }
            append(&mut result, &files, format!("{}::generic:{}", identity, parameter.name), identity.clone(),
                "generic-parameter", &parameter.name, parameter.span, None,
                if parameter.constant { "usize".to_string() } else { parameter.name.clone() }, false)?;
        }
    }
    for value in &program.structs {
        let identity = type_identity(&value.module, &value.name);
        append(&mut result, &files, identity.clone(), root_parent(&value.module), "struct",
            &value.name, value.span, None, source_path(&identity).to_string(), true)?;
        append_generics(&mut result, &files, &identity, &value.generics)?;
        for field in &value.fields {
            append_typed(&mut result, &files, program, format!("{}::field:{}", identity, field.name), identity.clone(), "field",
                &field.name, field.span, Some(field.ty), false)?;
        }
    }
    for value in &program.enums {
        let identity = type_identity(&value.module, &value.name);
        append(&mut result, &files, identity.clone(), root_parent(&value.module), "enum",
            &value.name, value.span, None, source_path(&identity).to_string(), true)?;
        append_generics(&mut result, &files, &identity, &value.generics)?;
        for variant in &value.variants {
            let variant_identity = format!("{}::variant:{}", identity, variant.name);
            append(&mut result, &files, variant_identity.clone(), identity.clone(), "variant",
                &variant.name, variant.span, None, source_path(&identity).to_string(), false)?;
            for field in &variant.fields {
                append_typed(&mut result, &files, program, format!("{}::field:{}", variant_identity, field.name), variant_identity.clone(),
                    "field", &field.name, field.span, Some(field.ty), false)?;
            }
        }
    }
    for value in &program.traits {
        let identity = type_identity(&value.module, &value.name);
        append(&mut result, &files, identity.clone(), root_parent(&value.module), "trait", &value.name,
            value.span, None, source_path(&identity).to_string(), true)?;
        append_generics(&mut result, &files, &identity, &value.generics)?;
        for constant in &value.constants {
            append_typed(&mut result, &files, program, format!("{}::{}", qualified(&value.module, &value.name), constant.name),
                identity.clone(), "associated-constant", &constant.name, constant.span, Some(constant.ty), false)?;
        }
        for associated in &value.associated {
            append_typed(&mut result, &files, program, format!("{}::type:{}", identity, associated.name), identity.clone(),
                "associated-type", &associated.name, associated.span, associated.value, false)?;
            append_generics(&mut result, &files, &format!("{}::type:{}", identity, associated.name), &associated.generics)?;
        }
    }
    for (index, value) in program.impls.iter().enumerate() {
        let identity = implementation_identity(program, index);
        append_typed(&mut result, &files, program, identity.clone(), root_parent(&value.module), "implementation", "impl",
            value.span, Some(value.target), true)?;
        if let Some(structure) = origins.implementations[index] {
            let signature = match value.trait_ty {
                Some(trait_ty) => format!("impl {} for {}", type_name(program, trait_ty), type_name(program, value.target)),
                None => format!("impl {}", type_name(program, value.target)),
            };
            generated_projection(&mut result, &files, program, &identity, structure, signature, false)?;
        }
        append_generics(&mut result, &files, &identity, &value.generics)?;
        result.implementations.push(Implementation { identity: identity.clone(),
            target: type_name(program, value.target), trait_name: value.trait_ty.map_or(String::new(), |ty| type_name(program, ty)),
            target_key: source_type_key(program, value.target), trait_key: value.trait_ty.map_or(String::new(), |ty| source_type_key(program, ty)) });
        for associated in &value.associated {
            append_typed(&mut result, &files, program, format!("{}::type:{}", identity, associated.name), identity.clone(),
                "associated-type", &associated.name, associated.span, associated.value, false)?;
            append_generics(&mut result, &files, &format!("{}::type:{}", identity, associated.name), &associated.generics)?;
        }
    }
    for value in &program.modules {
        let identity = type_identity(&value.parent, &value.name);
        append(&mut result, &files, identity.clone(), root_parent(&value.parent), "module", &value.name,
            value.span, None, source_path(&identity).to_string(), true)?;
    }
    for value in &program.aliases {
        append_typed(&mut result, &files, program, type_identity(&value.module, &value.name), root_parent(&value.module), "alias",
            &value.name, value.span, Some(value.ty), true)?;
        append_generics(&mut result, &files, &type_identity(&value.module, &value.name), &value.generics)?;
    }
    for (index, value) in program.constants.iter().enumerate() {
        let implementation = program.constant_implementation(index)
            .filter(|owner| program.impls[*owner].trait_ty.is_some());
        let owner = implementation.map_or_else(|| constant_owner(program, value).map_or_else(|| root_parent(&value.module),
            |owner: String| source_identity(resolve::Namespace::Type, &owner)), |owner| implementation_identity(program, owner));
        let kind = if implementation.is_some() { "associated-constant" } else { "constant" };
        append_typed(&mut result, &files, program, constant_identity(program, index), owner, kind,
            &value.name, value.span, Some(value.ty), true)?;
    }
    macro_sources::project_items(&mut result, &files, program, &origins)?;
    // Validated generated calls have identities even in declaration-only catalogs.
    // Their edges never require editable source spelling or body inference.
    let mut generated_calls: BTreeMap<String, usize> = BTreeMap::new();
    for (expression, function) in &origins.expressions {
        generated_expression(&mut result, &files, program, &resolver, *expression, *function, &mut generated_calls, evidence)?;
    }
    macro_sources::generated_nodes(&mut result, &files, program, &resolver, &origins, &mut generated_calls, evidence)?;
    macro_sources::generated_imports(&mut result, &files, program, &resolver, &origins);
    for (pattern, function) in &origins.patterns {
        let node = &program.patterns[*pattern];
        if let a::Pattern::Path(path) | a::Pattern::Variant { path, .. } | a::Pattern::Struct { path, .. } = &node.kind {
            let owner = result.function_ids[*function].clone();
            let target = value_identity(program, path, &result.function_ids);
            generated_reference(&mut result, &files, &owner, target, node.span, "pattern");
        }
    }
    if include_references {
        let has_constant_parameters = crate::generics::const_arguments::has_parameters(program);
        let owners = Owners::new(&result);
        let self_traits = self_trait_owners(program);
        lifetime_predicate_references(&mut result, &files, program);
        import_qualifications(&mut result, &files, program, &resolver, &origins);
        visibility_qualifications(&mut result, &files, &owners);
        // Every declaration-backed type path is a resolved reference, including aliases.
        for (type_index, node) in program.types.iter().enumerate() {
            if program.impl_traits.contains_key(&type_index) || program.constant_arguments.contains_key(&type_index) { continue; }
            if let Some((declaration, _)) = program.array_length_constants.get(&type_index) {
                if let Some(target) = declaration_identity(program, *declaration, &result.function_ids) {
                    let span = *program.array_length_spans.get(&type_index).unwrap();
                    if let Some(function) = origins.types.get(&type_index) {
                        let owner = result.function_ids[*function].clone();
                        generated_reference(&mut result, &files, &owner, Some(target), span, "array-length");
                    } else if let Some(expansion) = origins.macros.types.get(&type_index) {
                        let owner = origins::macros::expansion_identity(*expansion);
                        generated_reference(&mut result, &files, &owner, Some(target), span, "array-length");
                    } else if let Some(owner) = owners.get(&files[span.file].path, span.start, span.end) {
                        path_qualifications(&mut result, &files, program, &resolver, &owner, node.scope, span);
                        path_reference(&mut result, &files, owner, target, span, "array-length", &resolver, node.scope, false);
                    }
                }
            }
            if !origins.types.contains_key(&type_index) {
                if let Some(expansion) = origins.macros.types.get(&type_index) {
                    let owner = origins::macros::expansion_identity(*expansion);
                    let target = match &node.kind {
                        a::Type::Path(path) => path.declaration.and_then(|declaration|
                            declaration_identity(program, declaration, &result.function_ids)),
                        _ => None,
                    };
                    generated_reference(&mut result, &files, &owner, target, node.span, "type");
                    continue;
                }
            }
            if let a::Type::Array { len, .. } = &node.kind {
                if has_constant_parameters && crate::generics::const_arguments::literal(len).is_none()
                    && crate::generics::const_arguments::declared(program, node.span, len) {
                    if let Some(span) = program.array_length_spans.get(&type_index) {
                        if let Some(owner) = owners.get(&files[span.file].path, span.start, span.end) {
                            constant_reference(&mut result, &files, &owner, len, *span);
                        }
                    }
                }
            }
            if let Some(function) = origins.types.get(&type_index) {
                let owner = result.function_ids[*function].clone();
                let target = match &node.kind {
                    a::Type::Path(path) => {
                        path.declaration.and_then(|declaration| declaration_identity(program, declaration, &result.function_ids))
                            .or_else(|| {
                                let origin = origins.functions[*function]?;
                                let candidate = format!("{}::generic:{}", origin_identity(program, origin), path.name);
                                if result.by_identity.contains_key(&candidate) { Some(candidate) } else { None }
                            })
                    }
                    _ => None,
                };
                generated_reference(&mut result, &files, &owner, target, node.span, "type");
                continue;
            }
            if let a::Type::Path(path) = &node.kind {
                let file = &files[node.span.file];
                let Some(owner) = owners.get(&file.path, node.span.start, node.span.end) else { continue; };
                if has_constant_parameters && crate::generics::const_arguments::declared(program, node.span, &path.name) {
                    constant_reference(&mut result, &files, &owner, &path.name, node.span);
                    continue;
                }
                if let Some(qualification) = &path.qualification {
                    let Some(trait_ty) = qualification.trait_ty else { continue; };
                    if let a::Type::Path(bound) = &program.types[trait_ty].kind {
                        if let Some(declaration) = bound.declaration {
                            if let Some(identity) = declaration_identity(program, declaration, &result.function_ids) {
                                let target = format!("{}::type:{}", identity, path.name);
                                let known = result.by_identity.contains_key(&target);
                                record_site(&mut result, &files, owner, target, qualification.member_span, "associated-type", known);
                            }
                        }
                    }
                    continue;
                }
                if path.declaration.is_none() {
                    if family_parameter_reference(&mut result, &files, path, node.span) { continue; }
                    if let Some(target) = self_associated_identity(program, &result, &self_traits, &owner, &path.name) {
                        add_reference(&mut result, &files, owner, target, node.span,
                            leaf_name(&path.name), "associated-type", true);
                        continue;
                    }
                    if family_member_reference(&mut result, &files, program, evidence, type_index, path, node.span, &owner) { continue; }
                    if !path.args.is_empty() && path.name.contains("::") {
                        add_reference(&mut result, &files, owner.clone(), path.name.clone(), node.span,
                            leaf_name(&path.name), "associated-type", false);
                    }
                }
                path_qualifications(&mut result, &files, program, &resolver, &owner, node.scope, node.span);
                for binding in &path.bindings {
                    match crate::generics::associated_binding_owner(program, path, binding) {
                        Ok(index) => {
                            let declaration = &program.traits[index];
                            let target = format!("{}::type:{}", type_identity(&declaration.module, &declaration.name), binding.name);
                            add_reference(&mut result, &files, owner.clone(), target, binding.span,
                                &binding.name, "associated-type-binding", true);
                        }
                        Err(_) => add_reference(&mut result, &files, owner.clone(), binding.name.clone(),
                            binding.span, &binding.name, "associated-type-binding", false),
                    }
                }
                if let Some(declaration) = path.declaration {
                    if let Some(target) = declaration_identity(program, declaration, &result.function_ids) {
                        if declaration_path(&path.name) == source_path(&target) {
                            path_reference(&mut result, &files, owner, target, node.span, "type", &resolver, node.scope, true);
                        } else {
                            add_reference(&mut result, &files, owner, path.name.clone(), node.span,
                                leaf_name(&path.name), "associated-type", false);
                        }
                    }
                }
            }
        }
        for (index, imported) in program.uses.iter().enumerate() {
            if origins.macros.items.contains_key(&(5usize, index)) || imported.glob { continue; }
            let scope = resolve::module(program, &imported.module);
            let path = a::Path { qualification: None, bindings: Vec::new(), declaration: None, name: imported.path.clone(), args: Vec::new() };
            let mut targets: BTreeMap<String, bool> = BTreeMap::new();
            if let Ok(resolved) = resolver.value_path(scope, &path, imported.span) {
                if let Some(target) = value_identity(program, &resolved, &result.function_ids) {
                    let alias = resolve::semantic_path_alias(&resolver, scope, &imported.path, true, imported.span).map_err(|problem| problem.message)?;
                    targets.insert(target, alias);
                }
            }
            if let Ok(path) = resolve::semantic_type_path(&resolver, scope, &imported.path, imported.span) {
                if let Some(target) = value_identity(program, &path, &result.function_ids) {
                    let alias = resolve::semantic_path_alias(&resolver, scope, &imported.path, false, imported.span).map_err(|problem| problem.message)?;
                    targets.insert(target, alias);
                }
            }
            for (target, alias) in targets {
                import_reference(&mut result, &files, root_parent(&imported.module), target, imported, alias);
            }
        }
        let mut generated_patterns = origins.patterns.clone();
        for pattern in origins.macros.patterns.keys() { generated_patterns.insert(*pattern, 0usize); }
        pattern_references(&mut result, &files, program, &owners, &resolver, &generated_patterns);
        let mut local_names: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
        let mut source_functions: BTreeMap<String, usize> = BTreeMap::new();
        for (index, function) in program.functions.iter().enumerate() {
            let mut locals = BTreeSet::new();
            for parameter in &function.params { locals.insert(parameter.name.clone()); }
            local_names.insert(result.function_ids[index].clone(), locals);
            source_functions.insert(result.function_ids[index].clone(), index);
        }
        let mut binding_counts: BTreeMap<(String, String), usize> = BTreeMap::new();
        let mut binding_ids: BTreeMap<usize, String> = BTreeMap::new();
        for (pattern, node) in program.patterns.iter().enumerate() {
            if generated_patterns.contains_key(&pattern) { continue; }
            if let a::Pattern::Bind { name, .. } = &node.kind {
                let file = &files[node.span.file];
                if let Some(owner) = owners.get(&file.path, node.span.start, node.span.end) {
                    if let Some(locals) = local_names.get_mut(&owner) { locals.insert(name.clone()); }
                    let key = (owner.clone(), name.clone());
                    let ordinal = binding_counts.get(&key).copied().unwrap_or(0usize);
                    binding_counts.insert(key, ordinal + 1usize);
                    let digest = match result.by_identity.get(&owner) { Some(index) => result.items[*index].body_digest.clone(), None => String::new() };
                    let identity = format!("{}::body:{}::binding:{}:{}", owner, digest, name, ordinal);
                    if !result.by_identity.contains_key(&identity) {
                        binding_ids.insert(pattern, identity.clone());
                        append(&mut result, &files, identity.clone(), owner, "binding", name, node.span, None,
                            "inferred type is unavailable".to_string(), false)?;
                        if let Some(ty) = evidence.as_ref().and_then(|evidence| evidence.bindings.get(&pattern)) {
                            let index = *result.by_identity.get(&identity).unwrap();
                            result.items[index].type_name = display_type_evidence(ty.as_str())?;
                            result.items[index].canonical_type = ty.clone(); result.items[index].type_resolved = true;
                        }
                    }
                }
            }
        }
        macro_sources::generated_bindings(&mut result, &files, program, &origins, &mut binding_ids, evidence)?;
        macro_sources::generated_locals(&mut result, &files, program, &origins, &binding_ids, evidence);
        macro_renames::append(&mut result, &files, program, &resolver, &origins, &binding_ids, evidence);
        let mut calls: BTreeMap<String, usize> = BTreeMap::new();
        for (expression, node) in program.exprs.iter().enumerate() {
            if origins.expressions.contains_key(&expression) || origins.macros.expressions.contains_key(&expression) { continue; }
            let file = &files[node.span.file];
            let Some(owner) = owners.get(&file.path, node.span.start, node.span.end) else { continue; };
            let key = (file.path.clone(), node.span.start, node.span.end);
            let self_record = matches!(&node.kind, a::Expr::Struct { path, .. } if path.name == "Self");
            let self_claim = if self_record {
                source_functions.get(&owner).and_then(|function| self_constructor(
                    &mut result, &files, program, *function, &owner, node))
            } else { None };
            let ty = evidence.as_ref().and_then(|evidence| evidence.expressions.get(&expression)).cloned()
                .or_else(|| self_claim.as_ref().map(|claim| claim.1.clone()));
            if result.expression_types.contains_key(&key) {
                let previous = result.expression_types.get_mut(&key).unwrap();
                let agrees = match (&*previous, &ty) {
                    (Some(left), Some(right)) => left == right,
                    _ => false,
                };
                if !agrees { *previous = None; }
            } else { result.expression_types.insert(key, ty); }
            match &node.kind {
                a::Expr::Path(path) | a::Expr::Struct { path, .. } => {
                    if has_constant_parameters && matches!(node.kind, a::Expr::Path(_)) && crate::generics::const_arguments::declared(program, node.span, &path.name) {
                        constant_reference(&mut result, &files, &owner, &path.name, node.span);
                        continue;
                    }
                    if let Some(qualification) = &path.qualification {
                        let resolved = resolver.value_path(node.scope, path, node.span).ok();
                        if let Some(declaration) = resolved.and_then(|resolved| resolved.declaration) {
                            if let a::Item::Constant(index) = program.declarations[declaration].item {
                                let target = constant_identity(program, index);
                                record_site(&mut result, &files, owner.clone(), target, qualification.member_span, "associated-constant", true);
                                path_qualifications(&mut result, &files, program, &resolver, &owner, node.scope, node.span);
                                continue;
                            }
                        }
                        let Some(trait_ty) = qualification.trait_ty else {
                            let closed = source_functions.get(&owner).is_some_and(|function|
                                crate::elaborate::semantic::closed_source_owner(program, *function));
                            if evidence.as_ref().is_some_and(|evidence|
                                typed_associated(&mut result, &files, program, evidence, expression, &owner, closed)) {
                                continue;
                            }
                            record_site(&mut result, &files, owner.clone(), path.name.clone(),
                                qualification.member_span, "associated-function", false);
                            continue;
                        };
                        if let a::Type::Path(bound) = &program.types[trait_ty].kind {
                            if let Some(declaration) = bound.declaration {
                                if let a::Item::Trait(index) = program.declarations[declaration].item {
                                    if let Some(method) = program.traits[index].methods.iter()
                                        .find(|method| program.functions[**method].name == path.name) {
                                        let target = result.function_ids[*method].clone();
                                        record_site(&mut result, &files, owner.clone(), target, qualification.member_span, "associated-call", true);
                                    }
                                }
                            }
                        }
                        continue;
                    }
                    path_qualifications(&mut result, &files, program, &resolver, &owner, node.scope, node.span);
                    let typed_owner = evidence.as_ref().is_some_and(|evidence| source_functions.get(&owner).is_some_and(|function| evidence.definitions.contains(function)));
                    let mut local_target = evidence.as_ref().and_then(|evidence| evidence.locals.get(&expression)).copied();
                    if local_target.is_none() && !typed_owner && matches!(node.kind, a::Expr::Path(_)) {
                        if let Some(function) = source_functions.get(&owner) {
                            local_target = untyped_local(program, &binding_counts, *function, &owner, &path.name, node.span);
                        }
                    }
                    if let Some(target) = local_target {
                        local_reference(&mut result, &files, program, &binding_ids, &source_functions, &owner, node, &path.name, target);
                        continue;
                    }
                    let local = !typed_owner && local_names.get(&owner).is_some_and(|locals| locals.contains(&path.name));
                    if local {
                        add_reference(&mut result, &files, owner, path.name.clone(), node.span, leaf_name(&path.name), "lexical-name", false);
                        continue;
                    }
                    let closed = source_functions.get(&owner).is_some_and(|function|
                        crate::elaborate::semantic::closed_source_owner(program, *function));
                    if matches!(node.kind, a::Expr::Path(_))
                        && evidence.as_ref().is_some_and(|evidence|
                            typed_associated(&mut result, &files, program, evidence, expression, &owner, closed)) {
                        continue;
                    }
                    let resolved = resolver.value_path(node.scope, path, node.span).ok();
                    let target = if self_record { self_claim.as_ref().map(|claim| claim.0.clone()) }
                        else { resolved.as_ref().and_then(|path| value_identity(program, path, &result.function_ids)) };
                    if self_record {
                        if target.is_none() {
                            record_site(&mut result, &files, owner.clone(), "Self".to_string(),
                                a::Span { end: node.span.start, ..node.span }, "constructor", false);
                        }
                    } else if let Some(target) = &target {
                        path_reference(&mut result, &files, owner.clone(), target.clone(), node.span,
                            if matches!(node.kind, a::Expr::Struct { .. }) { "constructor" } else { "value" },
                            &resolver, node.scope, matches!(node.kind, a::Expr::Struct { .. }));
                    } else if resolved.as_ref().is_some_and(|path| path.declaration.is_some())
                        || (matches!(node.kind, a::Expr::Path(_)) && path.name.contains("::")
                            && resolver.generic_path(path, node.span)) {
                        add_reference(&mut result, &files, owner.clone(), path.name.clone(), node.span, leaf_name(&path.name), "associated-function", false);
                    }
                    constructor_fields(&mut result, &files, program, &owner, node, &target);
                }
                a::Expr::Method { receiver, name, .. } => {
                    let resolved = evidence.as_ref().is_some_and(|evidence| typed_member(&mut result, &files, program, evidence, expression, &owner));
                    if !resolved {
                        let span = a::Span { start: program.exprs[*receiver].span.end, ..node.span };
                        add_reference(&mut result, &files, owner.clone(), name.clone(), span, name, "typed-method", false);
                    }
                }
                a::Expr::Field { value, name } => {
                    let resolved = evidence.as_ref().is_some_and(|evidence| typed_member(&mut result, &files, program, evidence, expression, &owner));
                    if !resolved {
                        let span = a::Span { start: program.exprs[*value].span.end, ..node.span };
                        add_reference(&mut result, &files, owner.clone(), name.clone(), span, name, "typed-field", false);
                    }
                }
                a::Expr::Binary { .. } | a::Expr::Assign { .. } => {
                    if let Some(evidence) = &evidence {
                        operator_member(&mut result, &files, program, evidence, expression, &owner);
                    }
                }
                _ => {}
            }
            if matches!(node.kind, a::Expr::Call { .. } | a::Expr::Method { .. }) {
                let ordinal = calls.get(&owner).copied().unwrap_or(0usize);
                calls.insert(owner.clone(), ordinal + 1usize);
                let digest = match result.by_identity.get(&owner) { Some(index) => result.items[*index].body_digest.clone(), None => String::new() };
                let identity = format!("{}::body:{}::call:{}", owner, digest, ordinal);
                append(&mut result, &files, identity.clone(), owner, "call-site", "", node.span, None,
                    "inferred result type is unavailable".to_string(), false)?;
                if let Some(ty) = evidence.as_ref().and_then(|evidence| evidence.expressions.get(&expression)) {
                    let index = *result.by_identity.get(&identity).unwrap();
                    result.items[index].type_name = display_type_evidence(ty.as_str())?;
                    result.items[index].canonical_type = ty.clone(); result.items[index].type_resolved = true;
                }
            }
        }
    } else {
        // Absence of rows in this mode is never evidence of absence of uses.
        for index in 0usize..result.items.len() { result.items[index].references_complete = false; }
    }
    let mut ir_sources: BTreeMap<String, String> = BTreeMap::new();
    for (index, function) in program.functions.iter().enumerate() {
        if program.function_owner(a::FunctionId { index }) == a::FunctionOwner::Free {
            ir_sources.insert(names::qualified(&function.module, &function.name), result.function_ids[index].clone());
        }
    }
    let mut instance_keys: BTreeSet<String> = BTreeSet::new();
    for function in &checked.program().functions {
        let (source, raw) = match ir_source(program, &result, &ir_sources, &function.name) {
            Some(value) => value,
            None => (String::new(), String::new()),
        };
        let arguments = instance_arguments(checked.program(), &raw);
        let identity = if source.is_empty() { format!("ir:{}", function.name) }
            else { format!("ir:{}{}", source_path(&source), arguments) };
        if !instance_keys.insert(identity.clone()) {
            return Err(format!("{} E_IDENTITY duplicate checked instance identity", quote(&identity)));
        }
        result.instance_ids.push(identity);
        result.instance_sources.push(source);
        result.instance_arguments.push(arguments);
    }
    let mut ordered: BTreeMap<(String, String, usize, usize, String), Reference> = BTreeMap::new();
    let references = std::mem::replace(&mut result.references, Vec::new());
    for reference in references {
        ordered.insert((reference.owner.clone(), reference.file.clone(), reference.start, reference.end, reference.target.clone()), reference);
    }
    for (_, reference) in ordered { result.references.push(reference); }
    result.selector_kinds = collect_selector_metadata(&result, checked.program());
    Ok(result)
}

/// Capture declarations and byte identities without body reference/type discovery.
/// This view cannot authorize rename/refactoring or any claim of absent uses.
pub fn catalog_items(program: &a::Program, inputs: &[(String, Vec<u8>)], checked: &ir::CheckedProgram) -> Result<Catalog, String> {
    catalog_mode(program, inputs, checked, &None, false)
}

mod origins;
mod macro_sources;

pub fn generated_epoch_domain(expansion: &str) -> String {
    if expansion == "derive-default" { "lkjscript-derived-default-body-1".to_string() }
    else { format!("lkjscript-{expansion}-body-1") }
}

fn origin_identity(program: &a::Program, origin: origins::Origin) -> String {
    let path = declaration_path(&origin.identity(program));
    if matches!(origin.expansion, origins::Expansion::Macro(_)) { path }
    else { source_identity(resolve::Namespace::Type, &path) }
}
fn generated_projection(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    identity: &str, origin: origins::Origin, signature: String, body: bool) -> Result<(), String> {
    let span = origin.span(program);
    let defining = origin_identity(program, origin);
    let file = &files[span.file];
    let start = preceding(&file.tokens, span.start);
    let declaration = token_digest(&file.tokens, start, span.end);
    let domain = generated_epoch_domain(origin.expansion.name());
    let mut epoch = domain.as_bytes().to_vec();
    bytes(&mut epoch, defining.as_bytes()); bytes(&mut epoch, declaration.as_bytes());
    if let origins::Expansion::Macro(index) = origin.expansion {
        macro_sources::epoch(&mut epoch, files, program, index);
    } else {
        macro_sources::derived_epoch(&mut epoch, files, program, origin);
    }
    let index = *catalog.by_identity.get(&identity.to_string())
        .ok_or_else(|| -> String { format!("{} E_IDENTITY_ORIGIN generated item is absent", quote(identity)) })?;
    let item = &mut catalog.items[index];
    item.generated_from = defining;
    item.generated_expansion = origin.expansion.name().to_string();
    item.signature_digest = normalized_digest(&signature)?;
    item.signature = signature;
    item.text.clear(); item.text_digest = sha256::hex_digest(b"");
    item.name_start = item.start; item.name_end = item.start;
    item.body = None;
    item.body_digest = if body { sha256::hex_digest(&epoch) } else { String::new() };
    item.references_complete = false;
    Ok(())
}

fn generated_reference(catalog: &mut Catalog, files: &[SourceText], owner: &str,
    target: Option<String>, span: a::Span, kind: &str) {
    catalog.generated_references.push(Reference { owner: owner.to_string(),
        target: target.unwrap_or_else(|| -> String { String::new() }), file: files[span.file].path.clone(),
        kind: kind.to_string(), start: span.start, end: span.end });
}

fn generated_expression(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, expression: usize, function: usize, calls: &mut BTreeMap<String, usize>,
    evidence: &Option<crate::elaborate::semantic::Evidence>) -> Result<(), String> {
    let owner = catalog.function_ids[function].clone();
    generated_expression_owned(catalog, files, program, resolver, expression, &owner, Some(function), false, calls, evidence)
}

fn generated_expression_owned(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, expression: usize, selected_owner: &str, function: Option<usize>,
    macro_expansion: bool, calls: &mut BTreeMap<String, usize>,
    evidence: &Option<crate::elaborate::semantic::Evidence>) -> Result<(), String> {
    let node = &program.exprs[expression];
    let owner = selected_owner.to_string();
    match &node.kind {
        a::Expr::Path(path) => {
            if path.declaration.is_none() && (path.name == "self" || path.name.starts_with("$debug_")) { return Ok(()); }
            if macro_expansion && evidence.as_ref().is_some_and(|value| value.locals.contains_key(&expression)) {
                // Local targets are projected after both authored and generated bindings exist.
                return Ok(());
            }
            let target = resolver.value_path(node.scope, path, node.span).ok()
                .and_then(|path| value_identity(program, &path, &catalog.function_ids));
            generated_reference(catalog, files, &owner, target, node.span, "value");
        }
        a::Expr::Struct { path, fields, .. } => {
            let target = value_identity(program, path, &catalog.function_ids);
            generated_reference(catalog, files, &owner, target.clone(), node.span, "constructor");
            for (name, _) in fields {
                let field = target.as_ref().map(|target: &String| -> String { format!("{target}::field:{name}") });
                generated_reference(catalog, files, &owner, field, node.span, "constructor-field");
            }
        }
        a::Expr::Call { callee, .. } => {
            let target = match &program.exprs[*callee].kind {
                a::Expr::Path(path) if !evidence.as_ref().is_some_and(|value| value.locals.contains_key(callee)) =>
                    resolver.value_path(program.exprs[*callee].scope, path, program.exprs[*callee].span).ok()
                        .and_then(|path| value_identity(program, &path, &catalog.function_ids)),
                _ => None,
            };
            generated_reference(catalog, files, &owner, target, node.span, "call");
            let ordinal = calls.get(&owner).copied().unwrap_or(0usize);
            calls.insert(owner.clone(), ordinal + 1usize);
            let index = *catalog.by_identity.get(&owner).unwrap();
            let epoch = catalog.items[index].body_digest.clone();
            let identity = format!("{owner}::derived:{epoch}::call:{ordinal}");
            let ty = evidence.as_ref().and_then(|value| value.expressions.get(&expression)).cloned();
            append(catalog, files, identity.clone(), owner, "call-site", "", node.span, None,
                ty.clone().unwrap_or_else(|| -> String { "inferred result type is unavailable".to_string() }), false)?;
            let index = *catalog.by_identity.get(&identity).unwrap();
            catalog.items[index].type_resolved = ty.is_some();
            catalog.items[index].body_digest = epoch;
        }
        a::Expr::Method { name, .. } => {
            let target = evidence.as_ref().and_then(|value| value.methods.get(&expression)).and_then(|method| {
                match method {
                    crate::elaborate::semantic::MethodTarget::Source(index) => Some(catalog.function_ids[*index].clone()),
                    crate::elaborate::semantic::MethodTarget::Trait(index) => {
                        let value = &program.traits[*index];
                        Some(format!("{}::{}", qualified(&value.module, &value.name), name))
                    }
                    _ => None,
                }
            });
            generated_reference(catalog, files, &owner, target, node.span, "method");
            let ordinal = calls.get(&owner).copied().unwrap_or(0usize);
            calls.insert(owner.clone(), ordinal + 1usize);
            let index = *catalog.by_identity.get(&owner).unwrap();
            let epoch = catalog.items[index].body_digest.clone();
            let identity = format!("{owner}::derived:{epoch}::call:{ordinal}");
            let ty = evidence.as_ref().and_then(|value| value.expressions.get(&expression)).cloned();
            append(catalog, files, identity.clone(), owner, "call-site", "", node.span, None,
                ty.clone().unwrap_or_else(|| -> String { "inferred result type is unavailable".to_string() }), false)?;
            let index = *catalog.by_identity.get(&identity).unwrap();
            catalog.items[index].type_resolved = ty.is_some();
            catalog.items[index].body_digest = epoch;
        }
        a::Expr::Binary { .. } | a::Expr::Assign { .. } => {
            if let Some(evidence) = evidence {
                if let Some(target) = operator_target(program, evidence, expression) {
                    generated_reference(catalog, files, &owner, Some(target), node.span, "operator-contract");
                }
            }
        }
        a::Expr::Field { name, .. } => {
            if evidence.as_ref().is_some_and(|value| value.builtin_fields.contains(&expression)) { return Ok(()); }
            let inferred = evidence.as_ref().and_then(|value| value.fields.get(&expression))
                .and_then(|declaration| declaration_identity(program, *declaration, &catalog.function_ids))
                .map(|parent| format!("{parent}::field:{name}"));
            let source = function.map(|function| program.function_owner(a::FunctionId { index: function }));
            let target = inferred.or_else(|| match source {
                Some(a::FunctionOwner::Implementation(index)) => {
                    let target = source_type_key(program, program.impls[index.index].target);
                    let base = target.find('<').map_or(target.as_str(), |at| &target[..at]);
                    Some(format!("{base}::field:{name}"))
                }
                _ => None,
            });
            generated_reference(catalog, files, &owner, target, node.span, "field");
        }
        a::Expr::String(_) | a::Expr::Borrow { .. } | a::Expr::Block(_) | a::Expr::Match { .. } => {}
        _ if macro_expansion => {}
        _ => return Err(format!("{} E_IDENTITY_ORIGIN generated expression has no validated form", quote(&owner))),
    }
    Ok(())
}

//! Authenticated bounded radix pages. Queries name immutable build snapshots.
//! A stored pointer is a selection hint, never a proof that files stayed unchanged.
use crate::{ir, ir_binary, semantic, semantic_facts, sha256, store};
use std::collections::BTreeMap;

pub struct Snapshot {
    pub identity: String,
    pub producer: String,
    pub source: String,
    pub checked_ir: String,
    pub root: String,
    pub selector: String,
    pub facts: usize,
    pub root_offset: usize,
    pub root_length: usize,
    pub total_bytes: usize,
}
struct Entry {
    name: String,
    hash: String,
    record: usize,
    start: usize,
    end: usize,
    next: Option<usize>,
    value_bytes: usize,
}
#[derive(Clone)]
pub struct Page { pub lines: Vec<String>, pub next: Option<usize> }

pub fn selector(path: &str, source: &Option<String>, library: &Option<String>, no_library: bool) -> String {
    let mut bytes = b"lkjscript-semantic-selector-1"[..].to_vec();
    store::push_bytes(&mut bytes, path.as_bytes());
    for index in 0usize..2usize {
        let option = if index == 0usize { source } else { library };
        match option {
            Some(value) => { store::push_word(&mut bytes, 1usize); store::push_bytes(&mut bytes, value.as_bytes()); }
            None => store::push_word(&mut bytes, 0usize),
        }
    }
    store::push_word(&mut bytes, no_library as usize);
    sha256::hex_digest(&bytes)
}
fn hexadecimal(value: &str) -> bool {
    if value.len() != 64usize { return false; }
    for byte in value.bytes() {
        if !byte.is_ascii_digit() && !(b'a' <= byte && byte <= b'f') { return false; }
    }
    true
}
fn leaf_key(kind: &str, identity: &str, page: usize) -> String {
    format!("{}\t{page}", semantic_facts::key(kind, identity))
}
fn page(lines: &[String], next: Option<usize>) -> Vec<u8> {
    let mut bytes = Vec::new();
    store::push_word(&mut bytes, 1usize);
    store::push_word(&mut bytes, next.unwrap_or(!0usize));
    store::push_word(&mut bytes, lines.len());
    for line in lines { store::push_bytes(&mut bytes, line.as_bytes()); }
    bytes
}
fn node(writer: &mut store::QueryContainerWriter<'_>, entries: Vec<Entry>, records: &[Vec<String>], depth: usize) -> Result<store::QueryExtent, String> {
    let mut size = 32usize;
    for entry in &entries { size += entry.name.len() + entry.value_bytes + 88usize; }
    let mut bytes = Vec::new();
    store::push_word(&mut bytes, 3usize);
    if entries.len() <= 64usize && size <= 32768usize {
        store::push_word(&mut bytes, 0usize);
        store::push_word(&mut bytes, depth);
        store::push_word(&mut bytes, entries.len());
        let mut ordered: BTreeMap<String, Entry> = BTreeMap::new();
        for entry in entries { ordered.insert(entry.hash.clone(), entry); }
        for (_, entry) in ordered {
            store::push_bytes(&mut bytes, entry.name.as_bytes());
            store::push_bytes(&mut bytes, entry.hash.as_bytes());
            let value = page(&records[entry.record][entry.start..entry.end], entry.next);
            store::push_bytes(&mut bytes, &value);
        }
    } else {
        if depth >= 64usize { return Err("E_QUERY_INDEX a fact exceeds its page representation".to_string()); }
        store::push_word(&mut bytes, 1usize);
        store::push_word(&mut bytes, depth);
        let mut groups: BTreeMap<u8, Vec<Entry>> = BTreeMap::new();
        for entry in entries {
            let digit = entry.hash.as_bytes()[depth];
            if !groups.contains_key(&digit) { groups.insert(digit, Vec::new()); }
            groups.get_mut(&digit).unwrap().push(entry);
        }
        store::push_word(&mut bytes, groups.len());
        for (digit, group) in groups {
            store::push_word(&mut bytes, digit as usize);
            let child = node(writer, group, records, depth + 1usize)?;
            store::push_bytes(&mut bytes, child.digest.as_bytes());
            store::push_word(&mut bytes, child.offset);
            store::push_word(&mut bytes, child.length);
        }
    }
    writer.append_node(&bytes)
}
fn decode_snapshot(bytes: &[u8]) -> Option<Snapshot> {
    let manifest = store::QueryManifest::decode(bytes)?;
    Some(Snapshot { identity: manifest.identity, producer: manifest.producer, source: manifest.source,
        checked_ir: manifest.checked_ir, root: manifest.root, selector: manifest.selector,
        facts: manifest.facts, root_offset: manifest.root_offset, root_length: manifest.root_length,
        total_bytes: manifest.total_bytes })
}
pub fn publish(store: &mut store::Store, selector: &str, catalog: &semantic::Catalog, checked: &ir::CheckedProgram) -> Result<Snapshot, String> {
    publish_emitted(store, selector, catalog, checked, &BTreeMap::new())
}
pub fn publish_emitted(store: &mut store::Store, selector: &str, catalog: &semantic::Catalog, checked: &ir::CheckedProgram, native_sizes: &BTreeMap<String, usize>) -> Result<Snapshot, String> {
    let facts = semantic_facts::build_emitted(catalog, checked, native_sizes)?;
    let mut records: Vec<Vec<String>> = Vec::new();
    let mut entries = Vec::new();
    let mut count = 0usize;
    for (name, lines) in facts.records {
        let record = records.len();
        count += lines.len();
        let mut at = 0usize; let mut number = 0usize;
        loop {
            let mut end = at; let mut size = 24usize;
            while end < lines.len() && end - at < 16usize {
                let addition = lines[end].len().checked_add(8usize).ok_or("E_QUERY_INDEX fact length overflow")?;
                if end != at && size + addition > 16384usize { break; }
                if addition > 16000usize { return Err("E_QUERY_INDEX one fact is too large; source text uses chunks".to_string()); }
                size += addition; end += 1usize;
            }
            let next = if end < lines.len() { Some(number + 1usize) } else { None };
            let key = format!("{name}\t{number}");
            entries.push(Entry { hash: sha256::hex_digest(key.as_bytes()), name: key, record, start: at, end, next, value_bytes: size });
            at = end; number += 1usize;
            if next.is_none() { break; }
        }
        records.push(lines);
    }
    let mut writer = store.begin_query_container()?;
    let root = node(&mut writer, entries, &records, 0usize)?;
    drop(records);
    let checked_ir = sha256::hex_digest(&ir_binary::write(checked.program()));
    let manifest = writer.finish(&catalog.input_digest, &checked_ir, selector, count, &root)?;
    let bytes = manifest.encode();
    let snapshot = decode_snapshot(&bytes).ok_or("E_QUERY_INDEX could not form snapshot")?;
    if !store.publish_query_locator(&snapshot.identity, selector, &snapshot.root) {
        store.invalidate_query_snapshot(&snapshot.identity, selector);
        return Err("E_QUERY_INDEX store refused authenticated snapshot locator publication".to_string());
    }
    store.put("semantic-latest-v3", selector, &bytes);
    // Publishing can be refused by the disposable store's budget or lock. Never
    // print an identity until its complete container and locator were retained.
    if !store.query_container_retained(&snapshot.identity, snapshot.total_bytes)
        || !store.query_locator_retained(&snapshot.identity, selector, &snapshot.root) {
        store.invalidate_query_snapshot(&snapshot.identity, selector);
        return Err("E_QUERY_INDEX store refused complete snapshot publication; increase --store-bytes or retry".to_string());
    }
    Ok(snapshot)
}
pub fn open<Q: store::QueryAccess>(store: &mut Q, selector: &str, requested: &Option<String>) -> Result<Snapshot, String> {
    let bytes = match requested {
        Some(identity) => {
            if !hexadecimal(identity) { return Err("E_QUERY_SNAPSHOT expected a 64-digit snapshot identity".to_string()); }
            store.query_root(identity)
        }
        None => store.query_latest(selector),
    }.ok_or("E_QUERY_SNAPSHOT no authenticated snapshot; build with --index and this store first")?;
    let snapshot = decode_snapshot(&bytes).ok_or("E_QUERY_SNAPSHOT invalid authenticated snapshot record")?;
    if requested.is_none() {
        let actual = store.query_root(&snapshot.identity)
            .ok_or("E_QUERY_SNAPSHOT latest has no complete authenticated container")?;
        if actual != bytes { return Err("E_QUERY_SNAPSHOT latest disagrees with its container".to_string()); }
    }
    if snapshot.producer != store.query_producer() {
        return Err("E_QUERY_SNAPSHOT snapshot producer does not match authenticated provenance".to_string());
    }
    if let Some(root) = store.query_bound_root() {
        if root != snapshot.root {
            return Err("E_QUERY_SNAPSHOT snapshot root does not match authenticated locator".to_string());
        }
    }
    if snapshot.selector != selector { return Err("E_QUERY_SNAPSHOT snapshot belongs to another source selection".to_string()); }
    if requested.as_ref().is_some_and(|identity| identity != &snapshot.identity) {
        return Err("E_QUERY_SNAPSHOT requested snapshot identity does not match".to_string());
    }
    Ok(snapshot)
}

pub struct Reader {
    snapshot: Snapshot,
    pages: BTreeMap<String, Vec<u8>>,
    fact_pages: BTreeMap<String, Option<Page>>,
    pub reads: usize,
}
impl Reader {
    pub fn new(snapshot: Snapshot) -> Self { Self { snapshot, pages: BTreeMap::new(), fact_pages: BTreeMap::new(), reads: 0usize } }
    fn node<Q: store::QueryAccess>(&mut self, store: &mut Q, extent: &store::QueryExtent) -> Result<Vec<u8>, String> {
        if !extent.valid(self.snapshot.total_bytes, self.snapshot.total_bytes) {
            return Err("E_QUERY_INDEX node extent is outside its authenticated container".to_string());
        }
        let key = extent.cache_key();
        if let Some(bytes) = self.pages.get(&key) { return Ok(bytes.clone()); }
        let bytes = match store.query_node(&self.snapshot.identity, extent) {
            Some(bytes) => bytes,
            None => {
                store.invalidate_query_snapshot(&self.snapshot.identity, &self.snapshot.selector);
                return Err("E_QUERY_INDEX node is missing or unauthenticated; rebuild the index".to_string());
            }
        };
        if bytes.len() < 32usize || bytes.len() > 32768usize
            || bytes.len().checked_add(90usize) != Some(extent.length)
            || sha256::hex_digest(&bytes) != extent.digest {
            store.invalidate_query_snapshot(&self.snapshot.identity, &self.snapshot.selector);
            return Err("E_QUERY_INDEX node does not match its rooted content identity".to_string());
        }
        self.reads += 1usize;
        self.pages.insert(key, bytes.clone());
        Ok(bytes)
    }
    fn value<Q: store::QueryAccess>(&mut self, store: &mut Q, key: &str) -> Result<Option<Vec<u8>>, String> {
        let hash = sha256::hex_digest(key.as_bytes());
        let mut extent = self.snapshot.root_extent(); let mut depth = 0usize;
        loop {
            let bytes = self.node(&mut *store, &extent)?;
            let mut input = store::Reader::new(&bytes);
            let version = input.word().ok_or("E_QUERY_INDEX malformed page")?;
            let kind = input.word().ok_or("E_QUERY_INDEX malformed page")?;
            let level = input.word().ok_or("E_QUERY_INDEX malformed page")?;
            let count = input.word().ok_or("E_QUERY_INDEX malformed page")?;
            if version != 3usize || level != depth || depth > 64usize || count > 64usize {
                return Err("E_QUERY_INDEX invalid page shape".to_string());
            }
            if kind == 0usize {
                let mut found = None;
                let mut previous = String::new();
                for _ in 0usize..count {
                    let name = input.text().ok_or("E_QUERY_INDEX malformed leaf")?;
                    let claimed = input.text().ok_or("E_QUERY_INDEX malformed leaf")?;
                    let value = input.bytes().ok_or("E_QUERY_INDEX malformed leaf")?;
                    if !hexadecimal(&claimed) || sha256::hex_digest(name.as_bytes()) != claimed
                        || (!previous.is_empty() && claimed <= previous)
                        || claimed[..depth] != hash[..depth] {
                        return Err("E_QUERY_INDEX leaf is outside its rooted range".to_string());
                    }
                    previous = claimed;
                    if name == key { found = Some(value); }
                }
                if !input.done() { return Err("E_QUERY_INDEX trailing leaf bytes".to_string()); }
                return Ok(found);
            }
            if kind != 1usize || depth >= 64usize || count == 0usize || count > 16usize { return Err("E_QUERY_INDEX invalid branch".to_string()); }
            let mut selected = None; let mut previous = 0usize;
            for index in 0usize..count {
                let digit = input.word().ok_or("E_QUERY_INDEX malformed branch")?;
                let digest = input.text().ok_or("E_QUERY_INDEX malformed branch")?;
                let offset = input.word().ok_or("E_QUERY_INDEX malformed branch extent")?;
                let length = input.word().ok_or("E_QUERY_INDEX malformed branch extent")?;
                let child = store::QueryExtent { digest, offset, length };
                let byte = digit as u8;
                if digit > 255usize || !(byte.is_ascii_digit() || (b'a' <= byte && byte <= b'f'))
                    || (index != 0usize && digit <= previous)
                    || !child.valid(self.snapshot.total_bytes, extent.offset) {
                    return Err("E_QUERY_INDEX invalid ordered branch extent".to_string());
                }
                previous = digit;
                if byte == hash.as_bytes()[depth] { selected = Some(child); }
            }
            if !input.done() { return Err("E_QUERY_INDEX trailing branch bytes".to_string()); }
            let Some(child) = selected else { return Ok(None); };
            extent = child; depth += 1usize;
        }
    }
    pub fn page<Q: store::QueryAccess>(&mut self, store: &mut Q, kind: &str, identity: &str, number: usize) -> Result<Option<Page>, String> {
        let key = leaf_key(kind, identity, number);
        if let Some(page) = self.fact_pages.get(&key) { return Ok(page.clone()); }
        let result = self.page_checked(&mut *store, kind, identity, number);
        match &result {
            Ok(page) => { self.fact_pages.insert(key, page.clone()); }
            Err(_) => { store.invalidate_query_snapshot(&self.snapshot.identity, &self.snapshot.selector); }
        }
        result
    }
    fn page_checked<Q: store::QueryAccess>(&mut self, store: &mut Q, kind: &str, identity: &str, number: usize) -> Result<Option<Page>, String> {
        let Some(bytes) = self.value(&mut *store, &leaf_key(kind, identity, number))? else { return Ok(None); };
        let mut reader = store::Reader::new(&bytes);
        if reader.word() != Some(1usize) { return Err("E_QUERY_INDEX invalid fact page".to_string()); }
        let next = reader.word().ok_or("E_QUERY_INDEX malformed fact page")?;
        let count = reader.word().ok_or("E_QUERY_INDEX malformed fact page")?;
        if count > 16usize || (next != !0usize && next != number + 1usize) {
            return Err("E_QUERY_INDEX invalid fact continuation".to_string());
        }
        let mut lines = Vec::new();
        for _ in 0usize..count { lines.push(reader.text().ok_or("E_QUERY_INDEX malformed fact line")?); }
        if !reader.done() { return Err("E_QUERY_INDEX trailing fact bytes".to_string()); }
        Ok(Some(Page { lines, next: if next == !0usize { None } else { Some(next) } }))
    }
}

impl Snapshot {
    fn root_extent(&self) -> store::QueryExtent {
        store::QueryExtent { digest: self.root.clone(), offset: self.root_offset, length: self.root_length }
    }
}

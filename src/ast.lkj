//! Flat syntax trees. Edges are arena indices, so dropping a deeply nested source is iterative.

pub mod macros;
pub(crate) mod walk;
pub use macros::{MacroToken, MacroDefinition, MacroInvocation, MacroExpansion, MacroCapture, MacroAlias, MacroInventory, MacroPosition, MacroSplice};

pub type FileId = usize;
pub type ModuleId = usize;
pub type DeclarationId = usize;
pub type TypeId = usize;
pub type ExprId = usize;
pub type BlockId = usize;
pub type PatternId = usize;

/// Source function identities are distinct from implementation and trait owners.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub struct FunctionId {
    pub index: usize,
}
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub struct ImplId {
    pub index: usize,
}
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub struct TraitId {
    pub index: usize,
}
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum FunctionOwner {
    Free,
    Implementation(ImplId),
    Trait(TraitId),
}

pub use crate::diagnostic::{Diagnostic, Span};

#[derive(Clone, PartialEq, Eq)]
pub struct AssociatedBinding {
    pub name: String,
    pub value: TypeId,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct QualifiedPath {
    pub receiver: TypeId,
    // A missing trait selects a value member on the explicit receiver type.
    // Associated type projections always retain their declared trait.
    pub trait_ty: Option<TypeId>,
    pub member_span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Path {
    pub qualification: Option<QualifiedPath>,
    pub declaration: Option<DeclarationId>,
    pub name: String,
    pub args: Vec<TypeId>,
    pub bindings: Vec<AssociatedBinding>,
}

#[derive(Clone, PartialEq, Eq)]
pub enum Type {
    Infer,
    Path(Path),
    Ref {
        mutable: bool,
        lifetime: String,
        inner: TypeId,
    },
    Slice(TypeId),
    Array {
        inner: TypeId,
        len: String,
    },
    Tuple(Vec<TypeId>),
    Function {
        params: Vec<TypeId>,
        result: TypeId,
    },
    Never,
}

#[derive(Clone, PartialEq, Eq)]
pub struct TypeNode {
    pub scope: ModuleId,
    pub block: Option<BlockId>,
    pub kind: Type,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct WherePredicate {
    pub target: TypeId,
    pub bounds: Vec<TypeId>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct NamedLifetime {
    pub name: String,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct LifetimePredicate {
    pub target: NamedLifetime,
    pub bounds: Vec<NamedLifetime>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct GenericParam {
    pub name: String,
    pub bounds: Vec<TypeId>,
    pub default: Option<TypeId>,
    pub lifetime: bool,
    /// Const usize parameters inhabit the value namespace, not the type namespace.
    pub constant: bool,
    /// An argument-position impl Trait parameter cannot be named by a turbofish.
    pub implicit: bool,
    pub span: Span,
}

/// The written projection of an anonymous parameter survives ordinary generic lowering.
#[derive(Clone, PartialEq, Eq)]
pub struct ImplTrait {
    pub bounds: Vec<TypeId>,
    pub argument: bool,
    pub result: Option<usize>,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Attribute {
    pub name: String,
    pub args: Vec<String>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Param {
    pub name: String,
    pub ty: TypeId,
    pub mutable: bool,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Function {
    pub const_qualified: bool,
    pub name: String,
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub outlives: Vec<LifetimePredicate>,
    pub params: Vec<Param>,
    pub result: TypeId,
    pub body: Option<BlockId>,
    pub attrs: Vec<Attribute>,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Field {
    pub name: String,
    pub ty: TypeId,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Struct {
    pub name: String,
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub fields: Vec<Field>,
    pub tuple: bool,
    pub unit: bool,
    pub attrs: Vec<Attribute>,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, Copy, PartialEq, Eq)]
pub enum VariantStyle {
    Unit,
    Tuple,
    Named,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Variant {
    pub name: String,
    pub fields: Vec<Field>,
    pub style: VariantStyle,
    pub discriminant: Option<ExprId>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Enum {
    pub name: String,
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub variants: Vec<Variant>,
    pub attrs: Vec<Attribute>,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct AssociatedType {
    pub name: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub bounds: Vec<TypeId>,
    pub value: Option<TypeId>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct AssociatedConstant {
    pub name: String,
    pub ty: TypeId,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Trait {
    pub name: String,
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub bounds: Vec<TypeId>,
    pub methods: Vec<usize>,
    pub associated: Vec<AssociatedType>,
    pub constants: Vec<AssociatedConstant>,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Impl {
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub target: TypeId,
    pub trait_ty: Option<TypeId>,
    pub methods: Vec<usize>,
    pub associated: Vec<AssociatedType>,
    pub constants: Vec<usize>,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Use {
    pub module: String,
    pub block: Option<BlockId>,
    pub path: String,
    pub alias: String,
    /// True even when `as` repeats the original spelling.
    pub explicit_alias: bool,
    pub glob: bool,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Module {
    pub scope: ModuleId,
    pub name: String,
    pub parent: String,
    pub items: Vec<Item>,
    pub external: bool,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Alias {
    pub name: String,
    pub module: String,
    pub generics: Vec<GenericParam>,
    pub predicates: Vec<WherePredicate>,
    pub ty: TypeId,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Constant {
    pub name: String,
    pub module: String,
    pub owner: Option<TypeId>,
    pub ty: TypeId,
    pub value: ExprId,
    pub public: Visibility,
    pub span: Span,
}

#[derive(Clone, Copy, PartialEq, Eq)]
pub enum Item {
    Function(usize),
    Struct(usize),
    Enum(usize),
    Trait(usize),
    Impl(usize),
    Use(usize),
    Module(usize),
    Alias(usize),
    Constant(usize),
    MacroInvocation(usize),
}

#[derive(Clone, PartialEq, Eq)]
pub enum Expr {
    Int(String),
    Float(String),
    Bool(bool),
    String(String),
    /// Invocation source path, materialized after loader diagnostic identities are selected.
    FilePath,
    Char(char),
    Bytes(Vec<u8>),
    Path(Path),
    Tuple(Vec<ExprId>),
    Array(Vec<ExprId>),
    Repeat {
        value: ExprId,
        count: ExprId,
    },
    Unary {
        op: String,
        value: ExprId,
    },
    Binary {
        op: String,
        left: ExprId,
        right: ExprId,
    },
    Assign {
        op: String,
        place: ExprId,
        value: ExprId,
    },
    Borrow {
        mutable: bool,
        value: ExprId,
    },
    Cast {
        value: ExprId,
        ty: TypeId,
    },
    Call {
        callee: ExprId,
        args: Vec<ExprId>,
    },
    Method {
        receiver: ExprId,
        name: String,
        types: Vec<TypeId>,
        args: Vec<ExprId>,
    },
    Field {
        value: ExprId,
        name: String,
    },
    Index {
        value: ExprId,
        index: ExprId,
    },
    Struct {
        path: Path,
        fields: Vec<(String, ExprId)>,
        base: Option<ExprId>,
    },
    Block(BlockId),
    If {
        condition: ExprId,
        then_block: BlockId,
        otherwise: Option<ExprId>,
    },
    IfLet {
        pattern: PatternId,
        value: ExprId,
        then_block: BlockId,
        otherwise: Option<ExprId>,
    },
    While {
        condition: ExprId,
        body: BlockId,
    },
    WhileLet {
        pattern: PatternId,
        value: ExprId,
        body: BlockId,
    },
    Loop {
        body: BlockId,
    },
    For {
        pattern: PatternId,
        iterator: ExprId,
        body: BlockId,
    },
    Match {
        value: ExprId,
        arms: Vec<Arm>,
    },
    Closure {
        moved: bool,
        params: Vec<Param>,
        patterns: Vec<PatternId>,
        result: Option<TypeId>,
        body: ExprId,
    },
    Return(Option<ExprId>),
    Break(Option<ExprId>),
    Continue,
    MacroInvocation(usize),
    Macro {
        name: String,
        args: Vec<ExprId>,
        separator: String,
    },
    Try(ExprId),
    /// A source obligation introduced by let-else expansion.
    Diverge(ExprId),
    Range {
        start: Option<ExprId>,
        end: Option<ExprId>,
        inclusive: bool,
    },
}

#[derive(Clone, PartialEq, Eq)]
pub struct ExprNode {
    pub scope: ModuleId,
    pub block: Option<BlockId>,
    pub kind: Expr,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub struct Arm {
    pub pattern: PatternId,
    pub guard: Option<ExprId>,
    pub value: ExprId,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub enum Pattern {
    Wild,
    /// An omitted tuple/tuple-variant field span, expanded after arity is known.
    Rest,
    Bind {
        name: String,
        mutable: bool,
        by_ref: bool,
        ref_mut: bool,
    },
    Path(Path),
    Literal(ExprId),
    Range {
        start: Option<ExprId>,
        end: Option<ExprId>,
        inclusive: bool,
    },
    Tuple(Vec<PatternId>),
    Variant {
        path: Path,
        fields: Vec<PatternId>,
    },
    Struct {
        path: Path,
        fields: Vec<(String, PatternId)>,
        rest: bool,
    },
    Ref {
        mutable: bool,
        inner: PatternId,
    },
    Or(Vec<PatternId>),
}

#[derive(Clone, PartialEq, Eq)]
pub struct PatternNode {
    pub scope: ModuleId,
    pub block: Option<BlockId>,
    pub kind: Pattern,
    pub span: Span,
}

#[derive(Clone, PartialEq, Eq)]
pub enum Stmt {
    Let {
        pattern: PatternId,
        ty: Option<TypeId>,
        value: Option<ExprId>,
        span: Span,
    },
    Expr {
        value: ExprId,
        semicolon: bool,
    },
    Item(Item),
    MacroInvocation(usize),
}

#[derive(Clone, PartialEq, Eq)]
pub struct Block {
    pub scope: ModuleId,
    pub parent: Option<BlockId>,
    pub statements: Vec<Stmt>,
    pub tail: Option<ExprId>,
    pub span: Span,
}

#[derive(Clone, Copy, PartialEq, Eq)]
pub enum Visibility {
    Private,
    Parent,
    Crate,
    /// An explicit restriction to an ancestor module in this program.
    Restricted(ModuleId),
    Public,
}


/// Actual loader-selected source for a module or crate root; includes are not modules.
#[derive(Clone, PartialEq, Eq)]
pub struct LoadedModule {
    pub scope: ModuleId,
    pub file: FileId,
    pub alternate: String,
}
#[derive(Clone, PartialEq, Eq)]
pub struct SourceFile {
    pub path: String,
    pub crate_root: ModuleId,
}
#[derive(Clone, PartialEq, Eq)]
pub struct ModuleScope {
    pub path: String,
    pub parent: Option<ModuleId>,
    pub crate_root: ModuleId,
}
#[derive(Clone, PartialEq, Eq)]
pub struct Declaration {
    pub name: String,
    pub scope: ModuleId,
    pub item: Item,
    pub public: Visibility,
    pub span: Span,
}

/// Explicit source compilation facts; never inferred from host flags or environment.
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct BuildConfiguration {
    pub debug_assertions: bool,
}
impl Default for BuildConfiguration {
    fn default() -> Self { Self { debug_assertions: true } }
}

#[derive(Clone, Default, PartialEq, Eq)]
pub struct Program {
    pub configuration: BuildConfiguration,
    pub macro_input: Option<Box<Program>>,
    pub macro_aliases: Vec<MacroAlias>,
    pub macro_inputs: Vec<(String, Vec<u8>)>,
    pub macro_captures: Vec<MacroCapture>,
    pub macro_identifier_uses: Vec<Span>,
    pub macro_definitions: Vec<MacroDefinition>,
    pub macro_invocations: Vec<MacroInvocation>,
    pub macro_expansions: Vec<MacroExpansion>,
    pub(crate) macro_parse_writes: Vec<macros::MacroParseWrite>,
    pub macro_providers: Vec<macros::MacroProvider>,
    pub macro_use_modules: std::collections::BTreeSet<ModuleId>,
    pub macros_expanded: bool,
    pub macro_pattern_bindings: std::collections::BTreeMap<PatternId, (usize, bool, bool)>,
    pub files: Vec<SourceFile>,
    pub loaded_modules: Vec<LoadedModule>,
    pub scopes: Vec<ModuleScope>,
    pub declarations: Vec<Declaration>,
    pub resolved: bool,
    /// Populated once by resolution; later phases read this relation directly.
    pub function_owners: Vec<FunctionOwner>,
    pub types: Vec<TypeNode>,
    pub impl_traits: std::collections::BTreeMap<TypeId, ImplTrait>,
    pub constant_arguments: std::collections::BTreeMap<TypeId, String>,
    /// First argument maps to its written owner and whether that segment ends the path.
    /// Owner::<T>::make and Owner::make::<T> retain distinct source meaning.
    pub value_argument_lists: std::collections::BTreeMap<TypeId, (String, bool)>,
    pub array_length_spans: std::collections::BTreeMap<TypeId, Span>,
    /// The declaration and written name of a length resolved to a concrete count.
    pub array_length_constants: std::collections::BTreeMap<TypeId, (DeclarationId, String)>,
    /// Written relaxed Sized bounds are source contracts, never IR type facts.
    pub relaxed_bounds: std::collections::BTreeSet<TypeId>,
    pub exprs: Vec<ExprNode>,
    pub patterns: Vec<PatternNode>,
    pub blocks: Vec<Block>,
    pub functions: Vec<Function>,
    pub structs: Vec<Struct>,
    pub enums: Vec<Enum>,
    pub traits: Vec<Trait>,
    pub impls: Vec<Impl>,
    pub uses: Vec<Use>,
    pub modules: Vec<Module>,
    pub aliases: Vec<Alias>,
    pub constants: Vec<Constant>,
    pub items: Vec<Item>,
    pub attrs: Vec<Attribute>,
}

impl Program {
    /// The caller supplies a resolved program, whose owner table covers every function.
    pub fn function_owner(&self, function: FunctionId) -> FunctionOwner {
        self.function_owners[function.index]
    }
}

impl Program {
    pub fn constant_implementation(&self, constant: usize) -> Option<usize> {
        self.impls.iter().position(|implementation| implementation.constants.contains(&constant))
    }
}

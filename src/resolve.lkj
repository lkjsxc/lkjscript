//! Module and declaration identity. Later phases consume resolved paths, never bare-name guesses.
mod associated_constants;
mod higher_ranked;
mod trait_constants;
mod import_scopes;
mod iteration;
mod primitive_limits;
use crate::ast::*;
use crate::names::qualified;
use import_scopes::ImportScopes;
use std::collections::{BTreeMap, BTreeSet};

type Result<T> = std::result::Result<T, Diagnostic>;
// A root nominal can share a primitive spelling; associated owner identities
// retain its stable declaration qualification rather than a parse-order ID.
pub(crate) fn nominal_receiver_name(name: &str) -> String {
    if matches!(name, "u8" | "u16" | "u32" | "u64" | "usize"
        | "i8" | "i16" | "i32" | "i64" | "isize" | "bool" | "char" | "f64") {
        format!("crate::{name}")
    } else { name.to_string() }
}
#[derive(Clone)]
struct Binding {
    declaration: DeclarationId,
    target: String,
    scope: ModuleId,
    public: Visibility,
    glob: bool,
    ambiguous: bool,
    // Whether this final spelling is fixed by an explicit import alias.
    semantic_alias: bool,
}
struct Resolved {
    name: String,
    binding: Option<Binding>,
}
impl Resolved {
    fn intrinsic(name: String) -> Self {
        Self {
            name,
            binding: None,
        }
    }
    fn item(binding: Binding) -> Self {
        Self {
            name: binding.target.clone(),
            binding: Some(binding),
        }
    }
}
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub(crate) enum Namespace {
    Type,
    Value,
}
/// The declaration slots used by both resolution and semantic source identity.
pub(crate) fn declaration_namespaces(program: &Program, item: Item) -> (bool, bool) {
    match item {
        Item::Function(_) | Item::Constant(_) => (false, true),
        Item::Struct(index) => (true, program.structs[index].tuple || program.structs[index].fields.is_empty()),
        Item::Module(_) | Item::Enum(_) | Item::Trait(_) | Item::Alias(_) => (true, false),
        _ => (false, false),
    }
}
pub struct Resolver<'a> {
    program: &'a Program,
    declarations: Vec<Declaration>,
    names: BTreeMap<(ModuleId, String, Namespace), Binding>,
    modules: BTreeMap<String, ModuleId>,
    alternatives: BTreeMap<(ModuleId, String, Namespace), Vec<Binding>>,
    generic_ranges: BTreeMap<(FileId, String), Vec<Span>>,
    generic_value_ranges: BTreeMap<(FileId, String), Vec<Span>>,
    import_scopes: ImportScopes,
    trait_names: BTreeMap<(usize, DeclarationId), BTreeSet<String>>,
    anonymous_traits: BTreeSet<(usize, DeclarationId)>,
    // Only an unresolved input needs a newly built relation. Resolved inputs
    // retain the program's authoritative table without constructing another.
    function_owners: Option<Vec<FunctionOwner>>,
    associated_constants: associated_constants::Constants,
}

fn first_name(path: &str) -> &str {
    match path.find("::") {
        Some(at) => &path[..at],
        None => path,
    }
}
fn last_name(path: &str) -> &str {
    match path.rfind("::") {
        Some(at) => &path[at + 2..],
        None => path,
    }
}
fn path_parts(path: &str) -> Vec<String> {
    let mut parts: Vec<String> = Vec::new();
    for part in path.split("::") {
        parts.push(part.to_string());
    }
    parts
}
fn join_parts(parts: &[String]) -> String {
    let mut result = String::new();
    for i in 0..parts.len() {
        if i > 0 {
            result.push_str("::");
        }
        result.push_str(&parts[i]);
    }
    result
}
pub(crate) fn module_scope(program: &Program, scope: ModuleId) -> ModuleId {
    if scope < program.scopes.len() { scope }
    else { program.blocks[scope - program.scopes.len()].scope }
}
fn within(program: &Program, mut scope: ModuleId, ancestor: ModuleId) -> bool {
    scope = module_scope(program, scope);
    let ancestor = module_scope(program, ancestor);
    loop {
        if scope == ancestor {
            return true;
        }
        if let Some(parent) = program.scopes[scope].parent {
            scope = parent;
        } else {
            return false;
        }
    }
}
fn region(program: &Program, scope: ModuleId, visibility: Visibility) -> Option<ModuleId> {
    let scope = module_scope(program, scope);
    match visibility {
        Visibility::Public => None,
        Visibility::Crate => Some(program.scopes[scope].crate_root),
        Visibility::Parent => program.scopes[scope].parent,
        Visibility::Private => Some(scope),
        Visibility::Restricted(ancestor) => Some(ancestor),
    }
}
pub fn visible(program: &Program, owner: ModuleId, visibility: Visibility, from: ModuleId) -> bool {
    region(program, owner, visibility).is_none_or(|root| within(program, from, root))
}
pub fn module(program: &Program, name: &str) -> ModuleId {
    program
        .scopes
        .iter()
        .position(|s| s.path == name)
        .unwrap_or(0)
}

/// Intrinsic value types, separate from the resolver's builtin predicates.
pub(crate) fn intrinsic_type_name(name: &str) -> bool {
    matches!(name, "bool" | "u8" | "u16" | "u32"
            | "u64" | "usize" | "i8" | "i16"
            | "i32" | "i64" | "isize" | "f64"
            | "str" | "char" | "Vec" | "Box"
            | "World" | "Arguments" | "Environment" | "ExitStatus"
            | "Stdout" | "Stdin" | "Stderr" | "Directory"
            | "ReadDirectory" | "ReadFile" | "Image" | "Channel"
            | "Worker" | "ReadRegion" | "ForeignCommand" | "ForeignSession"
            | "NullDevice" | "File" | "Process" | "Clock"
            | "Child" | "Listener" | "Connector" | "TcpPort" | "TemporaryFiles" | "Readiness"
            | "Entropy" | "Stop")
}
fn builtin(name: &str) -> bool {
    intrinsic_type_name(name) || matches!(name, "Copy" | "Clone" | "Ord" | "Eq"
            | "PartialEq" | "PartialOrd" | "Send" | "Sync"
            | "Data" | "Drop" | "Sized" | "Fn" | "FnMut"
            | "FnOnce")
}
fn insert_function_owner(
    owners: &mut [FunctionOwner],
    function: FunctionId,
    owner: FunctionOwner,
    span: Span,
) -> Result<()> {
    let slot = owners.get_mut(function.index).ok_or_else(|| {
        Diagnostic::new(span, "E_NAME", "method owner refers to an unknown function")
    })?;
    if *slot != FunctionOwner::Free {
        return Err(Diagnostic::new(
            span,
            "E_NAME",
            "a function cannot have more than one method owner",
        ));
    }
    *slot = owner;
    Ok(())
}

fn index_function_owners(program: &Program) -> Result<Vec<FunctionOwner>> {
    let mut owners = vec![FunctionOwner::Free; program.functions.len()];
    for (index, implementation) in program.impls.iter().enumerate() {
        for function in &implementation.methods {
            insert_function_owner(
                &mut owners,
                FunctionId { index: *function },
                FunctionOwner::Implementation(ImplId { index }),
                implementation.span,
            )?;
        }
    }
    for (index, declaration) in program.traits.iter().enumerate() {
        for function in &declaration.methods {
            insert_function_owner(
                &mut owners,
                FunctionId { index: *function },
                FunctionOwner::Trait(TraitId { index }),
                declaration.span,
            )?;
        }
    }
    Ok(owners)
}

impl<'a> Resolver<'a> {
    pub fn new(program: &'a Program) -> Result<Self> {
        let (resolver, problems) = Self::new_report(program)?;
        if let Some(failure) = problems.into_iter().next() {
            Err(failure)
        } else {
            Ok(resolver)
        }
    }
    fn new_report(program: &'a Program) -> Result<(Self, Vec<Diagnostic>)> {
        if program.resolved && program.function_owners.len() != program.functions.len() {
            return Err(Diagnostic::new(
                Span::default(),
                "E_NAME",
                "resolved source is missing its function ownership relation",
            ));
        }
        let function_owners = if program.resolved {
            None
        } else {
            Some(index_function_owners(program)?)
        };
        let mut result = Resolver {
            program,
            declarations: Vec::new(),
            names: BTreeMap::new(),
            modules: BTreeMap::new(),
            alternatives: BTreeMap::new(),
            generic_ranges: BTreeMap::new(),
            generic_value_ranges: BTreeMap::new(),
            import_scopes: ImportScopes::default(),
            trait_names: BTreeMap::new(),
            anonymous_traits: BTreeSet::new(),
            function_owners,
            associated_constants: associated_constants::Constants::default(),
        };
        for (id, scope) in program.scopes.iter().enumerate() {
            result.modules.insert(scope.path.clone(), id);
        }
        result.import_scopes = ImportScopes::new(program, &result.modules)?;
        for item in &program.impls {
            result.generics(item.span, &item.generics);
            for member in &item.associated { result.generics(member.span, &member.generics); }
        }
        for (id, item) in program.functions.iter().enumerate() {
            result.generics(item.span, &item.generics);
            if result.function_owner(FunctionId { index: id }) == FunctionOwner::Free {
                result.declare(
                    &item.name,
                    &item.module,
                    Item::Function(id),
                    item.public,
                    item.span,
                    declaration_namespaces(program, Item::Function(id)),
                )?;
            }
        }
        for (id, item) in program.structs.iter().enumerate() {
            result.generics(item.span, &item.generics);
            result.declare(
                &item.name,
                &item.module,
                Item::Struct(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Struct(id)),
            )?;
        }
        for (id, item) in program.enums.iter().enumerate() {
            result.generics(item.span, &item.generics);
            result.declare(
                &item.name,
                &item.module,
                Item::Enum(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Enum(id)),
            )?;
        }
        for (id, item) in program.traits.iter().enumerate() {
            result.generics(item.span, &item.generics);
            for member in &item.associated { result.generics(member.span, &member.generics); }
            result.declare(
                &item.name,
                &item.module,
                Item::Trait(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Trait(id)),
            )?;
        }
        for (id, item) in program.aliases.iter().enumerate() {
            result.generics(item.span, &item.generics);
            result.declare(
                &item.name,
                &item.module,
                Item::Alias(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Alias(id)),
            )?;
        }
        for (id, item) in program.constants.iter().enumerate() {
            if item.owner.is_some() { continue; }
            result.declare(
                &item.name,
                &item.module,
                Item::Constant(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Constant(id)),
            )?;
        }
        for (id, item) in program.modules.iter().enumerate() {
            if item.external {
                return Err(Diagnostic::new(
                    item.span,
                    "E_UNSUPPORTED",
                    "external modules require a source bundle or the normal CLI",
                ));
            }
            result.declare(
                &item.name,
                &item.parent,
                Item::Module(id),
                item.public,
                item.span,
                declaration_namespaces(program, Item::Module(id)),
            )?;
        }
        let problems = result.imports();
        if problems.is_empty() { result.index_associated_constants()?; }
        Ok((result, problems))
    }
    fn function_owner(&self, function: FunctionId) -> FunctionOwner {
        match &self.function_owners {
            Some(owners) => owners[function.index],
            None => self.program.function_owner(function),
        }
    }
    fn generics(&mut self, span: Span, params: &[GenericParam]) {
        for param in params {
            let key = (span.file, param.name.clone());
            if !self.generic_ranges.contains_key(&key) {
                self.generic_ranges.insert(key.clone(), Vec::new());
            }
            self.generic_ranges.get_mut(&key).unwrap().push(span);
            if param.constant {
                if !self.generic_value_ranges.contains_key(&key) { self.generic_value_ranges.insert(key.clone(), Vec::new()); }
                self.generic_value_ranges.get_mut(&key).unwrap().push(span);
            }
        }
    }
    pub(crate) fn generic(&self, span: Span, name: &str) -> bool {
        if name == "Self" || name.starts_with('\'') {
            return true;
        }
        match self.generic_ranges.get(&(span.file, name.to_string())) {
            Some(ranges) => ranges
                .iter()
                .any(|range| range.start <= span.start && span.end <= range.end),
            None => false,
        }
    }
    fn generic_value(&self, span: Span, name: &str) -> bool {
        match self.generic_value_ranges.get(&(span.file, name.to_string())) {
            Some(ranges) => ranges.iter().any(|range| range.start <= span.start && span.end <= range.end),
            None => false,
        }
    }
    fn value_pattern(&self, scope: ModuleId, name: &str, span: Span) -> Result<Option<Path>> {
        let Some(resolved) = self.path(scope, name, Namespace::Value, span, true)? else { return Ok(None); };
        let constructor = match &resolved.binding {
            Some(binding) => matches!(self.declarations[binding.declaration].item,
                Item::Struct(_) | Item::Enum(_) | Item::Constant(_)),
            None => self.generic_value(span, name) || matches!(name, "Some" | "None" | "Ok" | "Err"),
        };
        if !constructor { return Ok(None); }
        Ok(Some(Path { name: resolved.name, declaration: resolved.binding.map(|binding| binding.declaration),
            qualification: None, bindings: Vec::new(), args: Vec::new() }))
    }
    fn declare(
        &mut self,
        name: &str,
        path: &str,
        item: Item,
        public: Visibility,
        span: Span,
        namespaces: (bool, bool),
    ) -> Result<()> {
        let (ty, value) = namespaces;
        let scope = *self.modules.get(&path.to_string()).unwrap();
        let declaration = self.declarations.len();
        self.declarations.push(Declaration {
            name: qualified(path, name),
            scope,
            item,
            public,
            span,
        });
        if ty && matches!(item, Item::Trait(_)) {
            let key = (scope, declaration);
            if !self.trait_names.contains_key(&key) {
                self.trait_names.insert(key, BTreeSet::new());
            }
            self.trait_names
                .get_mut(&key)
                .unwrap()
                .insert(name.to_string());
        }
        for index in 0..2 {
            let enabled = if index == 0 { ty } else { value };
            let namespace = if index == 0 {
                Namespace::Type
            } else {
                Namespace::Value
            };
            if enabled {
                let key = (scope, name.to_string(), namespace);
                if self
                    .names
                    .insert(
                        key,
                        Binding {
                            declaration,
                            target: qualified(path, name),
                            scope,
                            public,
                            glob: false,
                            ambiguous: false,
                            semantic_alias: false,
                        },
                    )
                    .is_some()
                {
                    return Err(Diagnostic::new(
                        span,
                        "E_NAME",
                        &format!("duplicate declaration: {}", qualified(path, name)),
                    ));
                }
            }
        }
        Ok(())
    }
    fn access(&self, binding: &Binding, from: ModuleId, span: Span) -> Result<()> {
        if binding.ambiguous {
            return Err(Diagnostic::new(
                span,
                "E_NAME",
                &format!("ambiguous glob import {}", last_name(&binding.target)),
            ));
        }
        if !visible(self.program, binding.scope, binding.public, from) {
            return Err(Diagnostic::new(
                span,
                "E_PRIVACY",
                &format!("{} is private", self.declarations[binding.declaration].name),
            ));
        }
        Ok(())
    }
    fn lookup(&self, scope: ModuleId, name: &str, namespace: Namespace) -> Option<Binding> {
        self.names
            .get(&(scope, name.to_string(), namespace))
            .cloned()
    }
    fn lookup_owner(
        &self,
        scope: ModuleId,
        name: &str,
        namespace: Namespace,
        span: Span,
    ) -> Option<usize> {
        let mut owner = scope;
        loop {
            if self
                .names
                .contains_key(&(owner, name.to_string(), namespace))
            {
                return Some(owner);
            }
            owner = self.import_scopes.parent(owner)?;
        }
    }
    fn lookup_lexical(
        &self,
        scope: ModuleId,
        name: &str,
        namespace: Namespace,
        span: Span,
    ) -> Option<Binding> {
        self.lookup_owner(scope, name, namespace, span)
            .and_then(|owner| {
                self.names
                    .get(&(owner, name.to_string(), namespace))
                    .cloned()
            })
    }
    fn lookup_prelude(&self, name: &str, namespace: Namespace) -> Option<Binding> {
        let scope = self.modules.get(&"$std::prelude".to_string())?;
        self.lookup(*scope, name, namespace)
    }
    fn path(
        &self,
        scope: ModuleId,
        path: &str,
        namespace: Namespace,
        span: Span,
        prelude: bool,
    ) -> Result<Option<Resolved>> {
        let parts = path_parts(path);
        if parts.is_empty() {
            return Ok(None);
        }
        if parts[0].as_str() == "Self" {
            if let Some(resolved) = self.constant_self(scope, &parts, namespace, span)? {
                return Ok(Some(resolved));
            }
        }
        let local_type = self
            .lookup_owner(scope, parts[0].as_str(), Namespace::Type, span)
            .is_some_and(|owner| owner >= self.program.scopes.len());
        if !local_type && self.generic(span, parts[0].as_str())
            && (namespace == Namespace::Type || parts[0] == "Self" || parts.len() > 1usize || self.generic_value(span, parts[0].as_str())) {
            return Ok(Some(Resolved::intrinsic(path.to_string())));
        }
        if let Some(limit) = self.primitive_limit(scope, path, &parts, namespace, span)? {
            return Ok(Some(limit));
        }
        if matches!(
            path,
            "std::mem::replace"
                | "std::mem::drop"
                | "mem::replace"
                | "std::thread::scope"
                | "std::str::from_utf8"
                | "std::char::from_u32"
        ) && self
            .lookup_lexical(scope, parts[0].as_str(), Namespace::Type, span)
            .is_none()
        {
            return Ok(Some(Resolved::intrinsic(path.to_string())));
        }
        let mut at = 0;
        let mut current = module_scope(self.program, scope);
        let mut rooted = false;
        if parts[0].as_str() == "crate" {
            current = self.program.scopes[current].crate_root;
            at = 1;
            rooted = true;
        } else if parts[0].as_str() == "self" {
            at = 1;
            rooted = true;
        } else if parts[0].as_str() == "super" {
            while at < parts.len() && parts[at].as_str() == "super" {
                current = self.program.scopes[current]
                    .parent
                    .ok_or_else(|| Diagnostic::new(span, "E_NAME", "super has no parent module"))?;
                at += 1;
            }
            rooted = true;
        }
        if at == parts.len() {
            return Ok(None);
        }
        let first_namespace = if parts.len() - at > 1 {
            Namespace::Type
        } else {
            namespace
        };
        let mut binding = if rooted {
            self.lookup(current, parts[at].as_str(), first_namespace)
        } else {
            self.lookup_lexical(scope, parts[at].as_str(), first_namespace, span)
        };
        let standard_root = if parts[at].as_str() == "core" { "$std::core" } else { "$std" };
        if binding.is_none()
            && !rooted
            && matches!(parts[at].as_str(), "std" | "core")
            && self.modules.contains_key(&standard_root.to_string())
        {
            let core = parts[at].as_str() == "core";
            current = *self.modules.get(&standard_root.to_string()).unwrap();
            at += 1;
            rooted = true;
            if at == parts.len() {
                return Ok(None);
            }
            let remaining = join_parts(&parts[at..]);
            let intrinsic = match remaining.as_str() {
                "vec::Vec" if !core => Some("Vec"),
                "boxed::Box" if !core => Some("Box"),
                "mem::replace" if !core => Some("std::mem::replace"),
                "mem::drop" if !core => Some("std::mem::drop"),
                "str::from_utf8" if !core => Some("std::str::from_utf8"),
                "marker::Sized" => Some("Sized"),
                "marker::Copy" => Some("Copy"),
                "marker::Clone" => Some("Clone"),
                "marker::Send" => Some("Send"),
                "marker::Sync" => Some("Sync"),
                "cmp::PartialEq" => Some("PartialEq"),
                "cmp::Eq" => Some("Eq"),
                "cmp::PartialOrd" => Some("PartialOrd"),
                "cmp::Ord" => Some("Ord"),
                _ => None,
            };
            if let Some(name) = intrinsic {
                return Ok(Some(Resolved::intrinsic(name.to_string())));
            }
            if !core && remaining.starts_with("vec::Vec::") {
                return Ok(Some(Resolved::intrinsic(remaining[5..].to_string())));
            }
            if !core && remaining.starts_with("boxed::Box::") {
                return Ok(Some(Resolved::intrinsic(remaining[7..].to_string())));
            }
            binding = self.lookup(
                current,
                parts[at].as_str(),
                if parts.len() - at > 1 {
                    Namespace::Type
                } else {
                    namespace
                },
            );
        }
        if binding.is_none() && !rooted && prelude {
            if parts.len() == 1
                && namespace == Namespace::Value
                && matches!(parts[0].as_str(), "None" | "Some" | "Ok" | "Err")
            {
                let owner = if matches!(parts[0].as_str(), "None" | "Some") {
                    "Option"
                } else {
                    "Result"
                };
                if let Some(mut owner) = self.path(scope, owner, Namespace::Type, span, true)? {
                    owner.name = format!("{}::{}", owner.name, parts[0].as_str());
                    if let Some(binding) = &mut owner.binding {
                        binding.target = owner.name.clone();
                    }
                    return Ok(Some(owner));
                }
            }
            binding = self.lookup_prelude(parts[at].as_str(), first_namespace);
            if binding.is_none() && parts[0].as_str() == "String" {
                if let Some(std_scope) = self.modules.get(&"$std::string".to_string()) {
                    binding = self.lookup(*std_scope, "String", Namespace::Type);
                }
            }
            if binding.is_none()
                && (builtin(parts[0].as_str())
                    || matches!(
                        path,
                        "drop"
                            | "std::mem::replace"
                            | "mem::replace"
                            | "std::mem::drop"
                            | "scope"
                            | "std::thread::scope"
                            | "std::str::from_utf8"
                            | "std::char::from_u32"
                    ))
            {
                return Ok(Some(Resolved::intrinsic(path.to_string())));
            }
        }
        let mut binding = match binding {
            Some(b) => b,
            None => return Ok(None),
        };
        self.access(&binding, scope, span)?;
        at += 1;
        while at < parts.len() {
            let declaration = &self.declarations[binding.declaration];
            match declaration.item {
                Item::Module(index) => {
                    current = self.program.modules[index].scope;
                    let ns = if parts.len() - at > 1 {
                        Namespace::Type
                    } else {
                        namespace
                    };
                    binding = match self.lookup(current, parts[at].as_str(), ns) {
                        Some(b) => b,
                        None => return Ok(None),
                    };
                    self.access(&binding, scope, span)?;
                    at += 1;
                }
                Item::Struct(_) | Item::Enum(_) | Item::Alias(_) | Item::Trait(_) => {
                    if namespace == Namespace::Value && parts.len() - at == 1usize {
                        if let Some(member) = self.associated_constant(binding.declaration, &parts[at], scope, span)? {
                            return Ok(Some(member));
                        }
                    }
                    binding.target = format!("{}::{}", binding.target, join_parts(&parts[at..]));
                    // The suffix has its own spelling; an alias of its owner
                    // does not make a variant or associated member an alias.
                    binding.semantic_alias = false;
                    return Ok(Some(Resolved::item(binding)));
                }
                _ => return Ok(None),
            }
        }
        Ok(Some(Resolved::item(binding)))
    }
    fn exact_trait(&self, declaration: DeclarationId, target: &str, span: Span) -> Result<Option<usize>> {
        let entry = &self.declarations[declaration];
        let Item::Trait(index) = entry.item else { return Ok(None); };
        // A member path carries its owner ID, but only an exact path (including
        // an import alias) has the canonical name of the trait itself.
        if target != entry.name {
            return Err(Diagnostic::new(span, "E_TRAIT", "trait path has an unexpected member suffix"));
        }
        Ok(Some(index))
    }
    fn resolve_path(
        &self,
        scope: ModuleId,
        path: &mut Path,
        namespace: Namespace,
        span: Span,
    ) -> Result<()> {
        // Receiver and trait have their own arena nodes and lexical scopes.
        // The member is selected only after the receiver's trait proof exists.
        if path.qualification.is_some() {
            if namespace == Namespace::Value { self.resolve_trait_constant(path, span)?; }
            return Ok(());
        }
        if let Some(resolved) = self.path(scope, &path.name, namespace, span, true)? {
            if namespace == Namespace::Type {
                if let Some(binding) = &resolved.binding {
                    self.exact_trait(binding.declaration, &resolved.name, span)?;
                }
            }
            path.name = resolved.name;
            path.declaration = resolved.binding.map(|binding| binding.declaration);
            Ok(())
        } else {
            Err(Diagnostic::new(
                span,
                "E_NAME",
                &format!("unresolved name {}", path.name),
            ))
        }
    }
    fn wider_binding(&self, incoming: &Binding, previous: &Binding) -> bool {
        match (
            region(self.program, incoming.scope, incoming.public),
            region(self.program, previous.scope, previous.public),
        ) {
            (None, Some(_)) => true,
            (Some(next), Some(old)) => next != old && within(self.program, old, next),
            _ => false,
        }
    }
    fn import_binding(
        &mut self,
        use_item: &Use,
        scope: ModuleId,
        name: &str,
        ns: Namespace,
        source: &Binding,
    ) -> Result<bool> {
        let owner = self.import_scopes.import_owner(use_item, scope);
        let key = (owner, name.to_string(), ns);
        if use_item.glob && self.names.get(&key).is_some_and(|binding| !binding.glob) {
            return Ok(false);
        }
        let target_region = region(self.program, source.scope, source.public);
        let use_region = region(self.program, scope, use_item.public);
        let export_allowed = match (target_region, use_region) {
            (None, _) => true,
            (Some(_), None) => false,
            (Some(target), Some(user)) => within(self.program, user, target),
        };
        if !export_allowed && !use_item.glob {
            return Err(Diagnostic::new(
                use_item.span,
                "E_PRIVACY",
                "re-export is wider than the imported binding's visibility",
            ));
        }
        let declaration = source.declaration;
        let target = &self.declarations[declaration];
        if name == "_" {
            return Ok(ns == Namespace::Type
                && matches!(target.item, Item::Trait(_))
                && self.anonymous_traits.insert((owner, declaration)));
        }
        if ns == Namespace::Type && matches!(target.item, Item::Trait(_)) {
            let key = (owner, declaration);
            if !self.trait_names.contains_key(&key) {
                self.trait_names.insert(key, BTreeSet::new());
            }
            self.trait_names
                .get_mut(&key)
                .unwrap()
                .insert(name.to_string());
        }
        let mut incoming = Binding {
            declaration,
            target: source.target.clone(),
            scope: if export_allowed { scope } else { source.scope },
            public: if export_allowed {
                use_item.public
            } else {
                source.public
            },
            glob: use_item.glob,
            ambiguous: false,
            semantic_alias: source.semantic_alias || use_item.explicit_alias,
        };
        let previous: Option<Binding> = match self.names.get(&key) {
            Some(binding) => Some((*binding).clone()),
            None => None,
        };
        if let Some(previous) = previous {
            let same = previous.declaration == declaration && previous.target == source.target;
            if same { incoming.semantic_alias |= previous.semantic_alias; }
            if !previous.glob {
                if same {
                    if incoming.semantic_alias != previous.semantic_alias {
                        self.names.get_mut(&key).unwrap().semantic_alias = incoming.semantic_alias;
                        return Ok(true);
                    }
                    return Ok(false);
                }
                return Err(Diagnostic::new(
                    use_item.span,
                    "E_NAME",
                    &format!("ambiguous import {name}"),
                ));
            }
            if !use_item.glob {
                self.names.insert(key.clone(), incoming);
                self.alternatives.remove(&key);
                return Ok(true);
            }
            if same {
                if self.wider_binding(&incoming, &previous) || incoming.semantic_alias != previous.semantic_alias {
                    self.names.insert(
                        key,
                        Binding {
                            ambiguous: previous.ambiguous,
                            ..incoming
                        },
                    );
                    return Ok(true);
                }
                return Ok(false);
            }
            let position: Option<usize> = self.alternatives.get(&key).and_then(|bindings| {
                bindings.iter().position(|binding| {
                    binding.declaration == declaration && binding.target == source.target
                })
            });
            if let Some(position) = position {
                let wider = {
                    let previous = &self.alternatives.get(&key).unwrap()[position];
                    let changed = incoming.semantic_alias && !previous.semantic_alias;
                    incoming.semantic_alias |= previous.semantic_alias;
                    self.wider_binding(&incoming, previous) || changed
                };
                if wider {
                    self.alternatives.get_mut(&key).unwrap()[position] = incoming;
                    return Ok(true);
                }
                return Ok(false);
            }
            if !self.alternatives.contains_key(&key) {
                self.alternatives.insert(key.clone(), Vec::new());
            }
            self.alternatives.get_mut(&key).unwrap().push(incoming);
            self.names.get_mut(&key).unwrap().ambiguous = true;
            return Ok(true);
        }
        self.names.insert(key, incoming);
        Ok(true)
    }
    fn module_members(
        &self,
        target: ModuleId,
        scope: ModuleId,
    ) -> Vec<(String, Namespace, Binding)> {
        let mut entries = Vec::new();
        for (key, binding) in &self.names {
            if key.0 < target {
                continue;
            }
            if key.0 > target {
                break;
            }
            if visible(self.program, binding.scope, binding.public, scope) {
                entries.push((key.1.clone(), key.2, binding.clone()));
            }
            if let Some(alternatives) = self.alternatives.get(key) {
                for binding in alternatives {
                    if visible(self.program, binding.scope, binding.public, scope) {
                        entries.push((key.1.clone(), key.2, binding.clone()));
                    }
                }
            }
        }
        entries
    }
    fn module_anchor(&self, scope: ModuleId, path: &str, span: Span) -> Result<Option<ModuleId>> {
        let module = module_scope(self.program, scope);
        if path == "crate" {
            return Ok(Some(self.program.scopes[module].crate_root));
        }
        if path == "self" {
            return Ok(Some(module));
        }
        if matches!(path, "std" | "core")
            && self.lookup_lexical(scope, path, Namespace::Type, span).is_none()
        {
            let root = if path == "core" { "$std::core" } else { "$std" };
            return Ok(self.modules.get(&root.to_string()).copied());
        }
        if !path.is_empty() && path.split("::").all(|part| part == "super") {
            let mut current = module;
            for _ in path.split("::") {
                current = self.program.scopes[current]
                    .parent
                    .ok_or_else(|| Diagnostic::new(span, "E_NAME", "super has no parent module"))?;
            }
            return Ok(Some(current));
        }
        Ok(None)
    }
    fn import_one(&mut self, index: usize) -> Result<(bool, bool)> {
        let import = self.program.uses[index].clone();
        let module = *self.modules.get(&import.module).unwrap();
        let scope = self.import_scopes.import_owner(&import, module);
        let mut changed = false;
        if import.glob {
            let mut target = self.module_anchor(scope, &import.path, import.span)?;
            let mut enum_target: Option<(usize, Binding)> = None;
            if target.is_none() {
                let resolved =
                    self.path(scope, &import.path, Namespace::Type, import.span, false)?;
                let binding = match resolved.and_then(|resolved| resolved.binding) {
                    Some(binding) => binding,
                    None => return Ok((false, false)),
                };
                let declaration = &self.declarations[binding.declaration];
                match declaration.item {
                    Item::Module(index) => target = Some(self.program.modules[index].scope),
                    Item::Enum(index) if binding.target == declaration.name => {
                        enum_target = Some((index, binding));
                    }
                    _ => {
                        return Err(Diagnostic::new(
                            import.span,
                            "E_IMPORT",
                            "glob import requires a module or enum",
                        ));
                    }
                }
            }
            if target == Some(self.import_scopes.import_owner(&import, scope)) {
                return Err(Diagnostic::new(
                    import.span,
                    "E_IMPORT",
                    "a module cannot glob-import itself",
                ));
            }
            let entries: Vec<(String, Namespace, Binding)> = if let Some(target) = target {
                self.module_members(target, scope)
            } else if let Some((index, binding)) = enum_target {
                let mut entries = Vec::new();
                for variant in &self.program.enums[index].variants {
                    let mut binding = binding.clone();
                    binding.target = qualified(&binding.target, &variant.name);
                    for index in 0..2 {
                        let namespace = if index == 0 {
                            Namespace::Type
                        } else {
                            Namespace::Value
                        };
                        entries.push((variant.name.clone(), namespace, binding.clone()));
                    }
                }
                entries
            } else {
                return Ok((false, false));
            };
            for (name, namespace, binding) in entries {
                changed |= self.import_binding(&import, module, &name, namespace, &binding)?;
            }
            Ok((changed, true))
        } else {
            let mut found = false;
            for index in 0..2 {
                let ns = if index == 0 {
                    Namespace::Type
                } else {
                    Namespace::Value
                };
                if let Some(binding) = self
                    .path(scope, &import.path, ns, import.span, false)?
                    .and_then(|resolved| resolved.binding)
                {
                    found = true;
                    changed |= self.import_binding(&import, module, &import.alias, ns, &binding)?;
                }
            }
            if !found
                && self
                    .path(scope, &import.path, Namespace::Type, import.span, true)?
                    .is_some_and(|resolved| resolved.binding.is_none())
            {
                return Err(Diagnostic::new(
                    import.span,
                    "E_UNSUPPORTED",
                    "import aliases for intrinsic types or functions are not implemented",
                ));
            }
            Ok((changed, found))
        }
    }
    fn imports(&mut self) -> Vec<Diagnostic> {
        loop {
            let mut problems = BTreeMap::new();
            let mut unresolved = Vec::new();
            let mut changed = false;
            for index in 0..self.program.uses.len() {
                match self.import_one(index) {
                    Ok((updated, found)) => {
                        changed |= updated;
                        if !found {
                            unresolved.push(index);
                        }
                    }
                    Err(problem) => {
                        problems.insert(index, problem);
                    }
                }
            }
            if !changed {
                for index in unresolved {
                    let import = &self.program.uses[index];
                    problems.insert(
                        index,
                        Diagnostic::new(
                            import.span,
                            "E_IMPORT",
                            &format!("unresolved or cyclic import {}", import.path),
                        ),
                    );
                }
                let mut failures = Vec::new();
                for (_, problem) in problems {
                    failures.push(problem);
                }
                return failures;
            }
        }
    }
}

/// Give unresolved diagnostic projections the same explicit lexical owners as
/// resolution. The source report itself remains in its parsed coordinate space.
pub(crate) fn bind_lexical_scopes(result: &mut Program) {
    let modules = result.scopes.len();
    for id in 0usize..result.types.len() {
        if let Some(block) = result.types[id].block { result.types[id].scope = modules + block; }
    }
    for id in 0usize..result.exprs.len() {
        if let Some(block) = result.exprs[id].block { result.exprs[id].scope = modules + block; }
    }
    for id in 0usize..result.patterns.len() {
        if let Some(block) = result.patterns[id].block { result.patterns[id].scope = modules + block; }
    }
}

pub fn resolve(source: &Program) -> Result<Program> {
    if source.resolved {
        return Ok(source.clone());
    }
    let resolver = Resolver::new(source)?;
    let mut result = source.clone();
    bind_lexical_scopes(&mut result);
    resolve_nodes(&mut result, &resolver)?;
    result.declarations = resolver.declarations;
    result.function_owners = resolver
        .function_owners
        .expect("unresolved source has indexed owners");
    result.resolved = true;
    Ok(result)
}

fn resolve_nodes(result: &mut Program, resolver: &Resolver<'_>) -> Result<()> {
    // Validate the written owner before paths are flattened or any constructor
    // bypasses ordinary call selection. Modules never own generic arguments.
    for (argument, (owner, terminal)) in &result.value_argument_lists {
        let node = &result.types[*argument];
        let namespace = if *terminal { Namespace::Value } else { Namespace::Type };
        let mut resolved = resolver.path(node.scope, owner, namespace, node.span, true)?;
        if resolved.is_none() && *terminal {
            resolved = resolver.path(node.scope, owner, Namespace::Type, node.span, true)?;
        }
        let Some(resolved) = resolved else {
            return Err(Diagnostic::new(node.span, "E_NAME",
                &format!("unresolved generic argument owner {owner}")));
        };
        if let Some(binding) = resolved.binding {
            if matches!(resolver.declarations[binding.declaration].item, Item::Module(_)) {
                return Err(Diagnostic::new(node.span, "E_TYPE",
                    "generic arguments cannot be applied to a module"));
            }
        }
    }
    for (ty, form) in &result.impl_traits {
        if !form.argument && form.result.is_none() {
            return Err(Diagnostic::new(result.types[*ty].span, "E_UNSUPPORTED",
                "impl Trait requires a function parameter or a direct function result; nested bounds and nested results are not implemented yet"));
        }
        if let Some(index) = form.result {
            if matches!(resolver.function_owner(FunctionId { index }), FunctionOwner::Trait(_)) {
                return Err(Diagnostic::new(result.types[*ty].span, "E_UNSUPPORTED",
                    "impl Trait in trait method results requires an associated opaque contract and is not implemented yet"));
            }
            let mut lifetimes = std::collections::BTreeSet::<String>::new();
            for bound in &form.bounds {
                if let Type::Path(path) = &result.types[*bound].kind {
                    if path.name.starts_with('\'') { lifetimes.insert(path.name.clone()); }
                }
            }
            if lifetimes.len() > 1usize && !lifetimes.contains(&"'static".to_string()) {
                return Err(Diagnostic::new(result.types[*ty].span, "E_UNSUPPORTED",
                    "impl Trait results with multiple independent lifetime bounds are not implemented yet"));
            }
        }
        if form.bounds.iter().all(|bound|
            matches!(&result.types[*bound].kind, Type::Path(path) if path.name.starts_with('\'')))
        {
            return Err(Diagnostic::new(result.types[*ty].span, "E_TRAIT",
                "impl Trait requires at least one trait bound"));
        }
    }
    for id in 0..result.types.len() {
        if result.constant_arguments.contains_key(&id) { continue; }
        if result.impl_traits.get(&id).is_some_and(|form| form.result.is_some()) {
            continue;
        }
        if resolver.lower_higher_ranked_callable(result, id)? { continue; }
        let node = &mut result.types[id];
        let scope = node.scope;
        let span = node.span;
        if let Type::Path(path) = &mut node.kind {
            resolver.resolve_path(scope, path, Namespace::Type, span)?;
        }
    }
    for (id, span) in &result.array_length_spans {
        let (scope, written) = {
            let node = &result.types[*id];
            let Type::Array { len, .. } = &node.kind else { continue; };
            let name = crate::ast::macros::source_name(len);
            if name.as_bytes().first().is_some_and(|byte| byte.is_ascii_digit())
                || resolver.generic_value(node.span, name) { continue; }
            (node.scope, len.clone())
        };
        let name = crate::ast::macros::source_name(&written);
        let Some((declaration, count)) = resolver.module_array_length(result, scope, name, *span)? else { continue; };
        let Type::Array { len, .. } = &mut result.types[*id].kind else { unreachable!() };
        *len = format!("{count}");
        result.array_length_constants.insert(*id, (declaration, written));
    }
    for id in 0..result.patterns.len() {
        if let Some((context, mutable, by_ref)) = result.macro_pattern_bindings.get(&id).copied() {
            let name: Option<String> = match &result.patterns[id].kind {
                Pattern::Path(path) if path.qualification.is_none() && path.args.is_empty() && !path.name.contains("::") => Some(path.name.clone()),
                Pattern::Bind { name, .. } => Some(crate::ast::macros::source_name(name).to_string()),
                _ => None,
            };
            if let Some(name) = name {
                let scope = result.patterns[id].scope;
                let span = result.patterns[id].span;
                if let Some(path) = resolver.value_pattern(scope, &name, span)? {
                    if mutable || by_ref { return Err(Diagnostic::new(span, "E_TYPE", "binding mode cannot shadow a value constructor or constant")); }
                    result.patterns[id].kind = Pattern::Path(path);
                    // value_pattern already resolved the constructor at its destination.
                    // Internal library paths are canonical results, not new source spellings.
                    continue;
                } else {
                    result.patterns[id].kind = Pattern::Bind { name: crate::ast::macros::local_name(&name, context),
                        mutable: mutable && !by_ref, by_ref, ref_mut: mutable && by_ref };
                }
            }
        }
        let node = &mut result.patterns[id];
        let scope = node.scope;
        let span = node.span;
        let operand = match &mut node.kind {
            Pattern::Path(path) | Pattern::Variant { path, .. } => Some((path, Namespace::Value)),
            Pattern::Struct { path, .. } => Some((path, Namespace::Type)),
            _ => None,
        };
        if let Some((path, namespace)) = operand {
            resolver.resolve_path(scope, path, namespace, span)?;
        }
    }
    // Locals still resolve before declaration-valued expression paths.
    for id in 0..result.exprs.len() {
        let node = &mut result.exprs[id];
        let scope = node.scope;
        let span = node.span;
        if let Expr::Struct { path, .. } = &mut node.kind {
            resolver.resolve_path(scope, path, Namespace::Type, span)?;
        }
    }
    if result.resolved {
        return Ok(());
    }
    iteration::expand(result, resolver)
}

impl Resolver<'_> {
    fn module_array_length(&self, resolved: &Program, scope: ModuleId, name: &str, span: Span)
        -> Result<Option<(DeclarationId, usize)>> {
        if let Some(separator) = name.rfind("::") {
            let owner = &name[..separator];
            if self.module_anchor(scope, owner, span)?.is_none() {
                let module = self.path(scope, owner, Namespace::Type, span, false)?
                    .and_then(|path| path.binding)
                    .is_some_and(|binding| matches!(self.declarations[binding.declaration].item, Item::Module(_)));
                if !module { return Ok(None); }
            }
        }
        let Some(path) = self.path(scope, name, Namespace::Value, span, false)? else { return Ok(None); };
        let Some(binding) = path.binding else { return Ok(None); };
        let Item::Constant(index) = self.declarations[binding.declaration].item else { return Ok(None); };
        let constant = &resolved.constants[index];
        if constant.owner.is_some() { return Ok(None); }
        if !matches!(&resolved.types[constant.ty].kind, Type::Path(ty)
            if ty.name == "usize" && ty.declaration.is_none() && ty.qualification.is_none()
                && ty.args.is_empty() && ty.bindings.is_empty()) {
            return Err(Diagnostic::new(span, "E_TYPE", "array length constant requires the builtin usize type"));
        }
        let Expr::Int(text) = &resolved.exprs[constant.value].kind else {
            return Err(Diagnostic::new(span, "E_UNSUPPORTED", "array length constant requires a usize literal initializer"));
        };
        let digits = text.replace('_', "");
        let digits = if digits.ends_with("usize") { &digits[..digits.len() - 5usize] } else { digits.as_str() };
        let count = crate::syntax::integer_literals::magnitude(digits).ok_or_else(||
            Diagnostic::new(span, "E_TYPE", "array length constant initializer is not a representable usize literal"))?;
        Ok(Some((binding.declaration, count as usize)))
    }

    /// A parameter path keeps its lexical binding even when another module has
    /// a declaration with the same spelling. Resolved items are never parameters.
    pub(crate) fn generic_path(&self, path: &Path, span: Span) -> bool {
        let root = first_name(&path.name);
        path.qualification.is_none() && path.declaration.is_none() && !root.starts_with('\'') && self.generic(span, root)
    }

    pub(crate) fn is_type_parameter(&self, path: &Path, span: Span) -> bool {
        !path.name.contains("::") && self.generic_path(path, span)
    }

    pub fn value_path(&self, scope: ModuleId, path: &Path, span: Span) -> Result<Path> {
        // Resolved expression paths include compiler-generated source sugar.
        // Their declaration identity must not be looked up again by spelling.
        if let Some(declaration) = path.declaration {
            if self.declarations.get(declaration).is_none() {
                return Err(Diagnostic::new(
                    span,
                    "E_NAME",
                    "resolved value declaration is missing",
                ));
            }
            return Ok(path.clone());
        }
        let mut path = path.clone();
        if path.name.starts_with("__macro$") { let marked = path.name.clone(); path.name = crate::ast::macros::source_name(&marked).to_string(); }
        self.resolve_path(scope, &mut path, Namespace::Value, span)?;
        if !path.args.is_empty() && path.declaration.is_some_and(|declaration|
            matches!(self.declarations[declaration].item, Item::Constant(index)
                if self.program.constants[index].owner.is_some())) {
            return Err(Diagnostic::new(span, "E_TYPE", "associated constants take no generic arguments"));
        }
        Ok(path)
    }
    pub fn scope(&self, path: &str) -> ModuleId {
        *self.modules.get(&path.to_string()).unwrap()
    }
    pub fn type_name(&self, scope: ModuleId, name: &str, span: Span) -> Result<String> {
        self.path(scope, name, Namespace::Type, span, true)?
            .map(|resolved| resolved.name)
            .ok_or_else(|| Diagnostic::new(span, "E_NAME", &format!("unresolved type {name}")))
    }
    pub fn prelude_type(&self, name: &str, span: Span) -> Result<String> {
        let scope = self
            .modules
            .get(&"$std::prelude".to_string())
            .copied()
            .unwrap_or(0);
        self.type_name(scope, name, span)
    }
    pub fn library_type(&self, module: &str, name: &str, span: Span) -> Result<Path> {
        let module = qualified("$std", module);
        let scope = match self.modules.get(&module) {
            Some(scope) => *scope,
            None => {
                return Err(Diagnostic::new(
                    span,
                    "E_NAME",
                    &format!("source library module {module} is missing"),
                ));
            }
        };
        let mut path = Path {
            qualification: None, bindings: Vec::new(),
            declaration: None,
            name: name.to_string(),
            args: Vec::new(),
        };
        self.resolve_path(scope, &mut path, Namespace::Type, span)?;
        Ok(path)
    }
    pub fn library_function(&self, module: &str, name: &str, span: Span) -> Result<usize> {
        let module = format!("$std::{module}");
        let scope = match self.modules.get(&module) {
            Some(scope) => *scope,
            None => {
                return Err(Diagnostic::new(
                    span,
                    "E_UNSUPPORTED",
                    &format!("source library module {module} is not loaded"),
                ));
            }
        };
        let path = self.value_path(
            scope,
            &Path {
                qualification: None, bindings: Vec::new(),
                declaration: None,
                name: name.to_string(),
                args: Vec::new(),
            },
            span,
        )?;
        let declaration = path.declaration.ok_or_else(|| {
            Diagnostic::new(span, "E_NAME", "source library helper is not a declaration")
        })?;
        match self.declarations[declaration].item {
            Item::Function(index) => Ok(index),
            _ => Err(Diagnostic::new(
                span,
                "E_TYPE",
                "source library helper is not a function",
            )),
        }
    }
    pub fn sequence_function(&self, name: &str, span: Span) -> Result<usize> {
        self.library_function("sequence", name, span)
    }
    pub fn trait_in_scope(&self, scope: ModuleId, declaration: DeclarationId, span: Span) -> bool {
        let mut owner = scope;
        loop {
            if self.anonymous_traits.contains(&(owner, declaration)) {
                return true;
            }
            if let Some(names) = self.trait_names.get(&(owner, declaration)) {
                for name in names {
                    if self.lookup_owner(scope, name, Namespace::Type, span) != Some(owner) {
                        continue;
                    }
                    let key = (owner, name.clone(), Namespace::Type);
                    if self.names.get(&key).is_some_and(|binding| {
                        binding.declaration == declaration
                            && visible(self.program, binding.scope, binding.public, scope)
                    }) || self.alternatives.get(&key).is_some_and(|bindings| {
                        bindings.iter().any(|binding| {
                            binding.declaration == declaration
                                && visible(self.program, binding.scope, binding.public, scope)
                        })
                    }) {
                        return true;
                    }
                }
            }
            let Some(parent) = self.import_scopes.parent(owner) else {
                break;
            };
            owner = parent;
        }
        let Some(prelude) = self.modules.get(&"$std::prelude".to_string()) else {
            return false;
        };
        if let Some(names) = self.trait_names.get(&(*prelude, declaration)) {
            for name in names {
                if let Ok(Some(resolved)) = self.path(scope, name, Namespace::Type, span, true) {
                    if let Some(binding) = resolved.binding {
                        if binding.declaration == declaration {
                            return true;
                        }
                    }
                }
            }
        }
        false
    }
    pub fn declaration_visible(&self, scope: ModuleId, declaration: DeclarationId) -> bool {
        let item = &self.declarations[declaration];
        visible(self.program, item.scope, item.public, scope)
    }
}

/// Resolve one written type/module prefix with its declaration identity.
pub fn semantic_type_path(resolver: &Resolver<'_>, scope: ModuleId, name: &str, span: Span) -> Result<Path> {
    let mut path = Path { qualification: None, bindings: Vec::new(), declaration: None, name: name.to_string(), args: Vec::new() };
    resolver.resolve_path(scope, &mut path, Namespace::Type, span)?;
    Ok(path)
}

/// Alias provenance of the final written path component, after lexical resolution.
pub fn semantic_path_alias(resolver: &Resolver<'_>, scope: ModuleId, name: &str, value_namespace: bool,
    span: Span) -> Result<bool> {
    let namespace = if value_namespace { Namespace::Value } else { Namespace::Type };
    let resolved = resolver.path(scope, name, namespace, span, true)?
        .ok_or_else(|| Diagnostic::new(span, "E_NAME", &format!("unresolved semantic path {name}")))?;
    Ok(resolved.binding.is_some_and(|binding| binding.semantic_alias))
}

pub(crate) fn intrinsic_name(name: &str) -> bool { builtin(name) }

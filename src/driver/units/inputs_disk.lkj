//! Required source claims live in a command-local authenticated disk map.
//! Only the previous/current unit's observation and selected-claim caches stay
//! in RAM. Cached observations never supply a fresh admission's source identity.
use crate::native::records as disk_records;
use super::inputs::Expectation;
use std::collections::BTreeMap;

type Key = (String, String);
const DIRECTORY_ORDINAL_WIDTH: usize = 20usize;
fn retained_key(directories: &[String], directory: &str, path: &str) -> Result<String, String> {
    let Some(ordinal) = directories.iter().position(|label: &String| label.as_str() == directory) else {
        return Err("selected input has an unknown directory".to_string());
    };
    Ok(format!("{ordinal:020}{path}"))
}
fn directory_ordinal(key: &str) -> Result<usize, String> {
    if key.len() < DIRECTORY_ORDINAL_WIDTH
        || !key.as_bytes()[..DIRECTORY_ORDINAL_WIDTH].iter().all(|byte: &u8| byte.is_ascii_digit()) {
        return Err("input record has an invalid directory ordinal".to_string());
    }
    key[..DIRECTORY_ORDINAL_WIDTH].parse::<usize>()
        .map_err(|_| -> String { "input record has an invalid directory ordinal".to_string() })
}
fn encode(value: &Option<String>) -> Vec<u8> {
    match value {
        None => vec![0u8],
        Some(value) => {
            let mut result = vec![1u8]; result.extend_from_slice(value.as_bytes()); result
        }
    }
}
fn decode(bytes: &[u8]) -> Result<Option<String>, String> {
    if bytes.is_empty() { return Err("empty input expectation record".to_string()); }
    match bytes[0usize] {
        0u8 => {
            if bytes.len() != 1usize { return Err("absent input expectation has trailing bytes".to_string()); }
            Ok(None)
        }
        1u8 => Ok(Some(String::from_utf8(bytes[1usize..].to_vec())
            .map_err(|_| -> String { "input digest is not UTF-8".to_string() })?)),
        _ => Err("unknown input expectation tag".to_string()),
    }
}

pub struct Snapshot {
    required: disk_records::Store,
    directories: Vec<String>,
    observed: BTreeMap<Key, Option<String>>,
    recent: BTreeMap<Key, Option<String>>,
    conflicted: bool,
    reads: usize,
    reused: usize,
}
impl Snapshot {
    pub fn new(file: File, directories: Vec<String>) -> Result<Self, String> {
        // Preserve the key order of length-prefixed directory names while
        // keeping the invocation's full labels out of every index node.
        let mut ordered: BTreeMap<String, String> = BTreeMap::new();
        for label in directories { ordered.insert(format!("{}:{label}", label.len()), label); }
        let mut directories = Vec::new();
        for (_, directory) in ordered { directories.push(directory); }
        Ok(Self { required: disk_records::Store::new(file)?, directories, observed: BTreeMap::new(),
            recent: BTreeMap::new(), conflicted: false, reads: 0usize, reused: 0usize })
    }
    pub fn matches<F: FnMut(&str, &str) -> Option<Option<String>>>(
        &mut self, inputs: &[Expectation], read: &mut F,
    ) -> bool {
        if self.conflicted { return false; }
        let mut current: BTreeMap<Key, Option<String>> = BTreeMap::new();
        for input in inputs {
            let name = (input.directory.clone(), input.path.clone());
            let known = match current.get(&name) {
                Some(value) => Some(value.clone()),
                None => self.observed.get(&name).cloned(),
            };
            let actual = match known {
                Some(value) => { self.reused += 1usize; value }
                None => {
                    let Some(value) = read(&input.directory, &input.path) else {
                        self.observed = current; return false;
                    };
                    self.reads += 1usize; value
                }
            };
            current.insert(name, actual.clone());
            if actual != input.digest { self.observed = current; return false; }
        }
        self.observed = current;
        true
    }
    fn require_values(&mut self, inputs: &[Expectation]) -> Result<bool, String> {
        let mut current: BTreeMap<Key, Option<String>> = BTreeMap::new();
        for input in inputs {
            let name = (input.directory.clone(), input.path.clone());
            let prior = match current.get(&name) {
                Some(value) => Some(value.clone()),
                None => match self.recent.get(&name) {
                    Some(value) => Some(value.clone()),
                    None => match self.required.insert_or_get(
                        &retained_key(&self.directories, &input.directory, &input.path)?, &encode(&input.digest),
                    )? {
                        Some(bytes) => Some(decode(&bytes)?), None => None,
                    },
                },
            };
            if let Some(prior) = prior {
                if prior != input.digest { return Ok(false); }
            }
            current.insert(name, input.digest.clone());
        }
        // Only selected claims enter this cache. Failed speculative reuse
        // observations cannot stand for what fresh admission actually loaded.
        self.observed = current.clone();
        self.recent = current;
        Ok(true)
    }
    pub fn require(&mut self, inputs: &[Expectation]) -> Result<bool, String> {
        if self.conflicted { return Ok(false); }
        let result = self.require_values(inputs);
        let accepted = match &result { Ok(value) => *value, Err(_) => false };
        if !accepted { self.conflicted = true; }
        result
    }
    fn verify_values<F: FnMut(&str, &str) -> Option<Option<String>>>(
        &mut self, read: &mut F,
    ) -> Result<bool, String> {
        let directories = &self.directories;
        self.required.visit(&mut |name: &str, bytes: &[u8]| -> Result<bool, String> {
            let Some(directory) = directories.get(directory_ordinal(name)?) else {
                return Err("input record has an unknown directory ordinal".to_string());
            };
            let expected = decode(bytes)?;
            let Some(actual) = read(directory, &name[DIRECTORY_ORDINAL_WIDTH..]) else { return Ok(false); };
            Ok(actual == expected)
        })
    }
    pub fn verify<F: FnMut(&str, &str) -> Option<Option<String>>>(
        &mut self, read: &mut F,
    ) -> Result<bool, String> {
        if self.conflicted { return Ok(false); }
        let result = self.verify_values(read);
        let accepted = match &result { Ok(value) => *value, Err(_) => false };
        if !accepted { self.conflicted = true; }
        result
    }
    pub fn reads(&self) -> usize { self.reads }
    pub fn reused(&self) -> usize { self.reused }
    pub fn required(&self) -> usize { self.required.len() }
    pub fn cached_entries(&self) -> usize { self.observed.len() + self.recent.len() }
    pub fn finish(self) -> Result<(), String> {
        if self.conflicted { return Err("input snapshot is poisoned by an earlier failure".to_string()); }
        self.required.finish()
    }
}

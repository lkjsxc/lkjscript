//! Driver integration for checked source transactions and bounded semantic review.
use super::{Options, Stats, Memo};
use crate::{authority, entry_grants, ir, meaning, semantic, sha256, structure_edit, structure_write};
use std::collections::{BTreeMap, BTreeSet};

struct Request {
    options: Options,
    request: String,
    dry: bool,
    recover: bool,
    against: String,
    against_source: Option<String>,
    against_library: String,
    limit: usize,
    detail: String,
}
fn parse(values: &[String]) -> Result<Request, String> {
    let mut arguments: Vec<Vec<u8>> = Vec::new();
    arguments.push(b"check"[..].to_vec());
    let mut request = String::new();
    let mut dry = false;
    let mut recover = false;
    let mut against = String::new();
    let mut against_source = None;
    let mut against_library = String::new();
    let mut limit = 27usize;
    let mut detail = String::new();
    let mut at = 1usize;
    while at < values.len() {
        let name = values[at].as_str();
        if name == "--dry-run" { dry = true; }
        else if name == "--recover" { recover = true; }
        else if matches!(name, "--request" | "--against" | "--against-source-dir" | "--against-library-dir" | "--limit" | "--id") {
            at += 1usize;
            if at == values.len() { return Err(format!("E_USAGE {name} needs a value")); }
            match name {
                "--request" => request = values[at].clone(),
                "--against" => against = values[at].clone(),
                "--against-source-dir" => against_source = Some(values[at].clone()),
                "--against-library-dir" => against_library = values[at].clone(),
                "--id" => detail = values[at].clone(),
                _ => limit = super::inline_limit(&values[at])?,
            }
        } else { arguments.push(values[at].as_bytes().to_vec()); }
        at += 1usize;
    }
    if against_source.is_some() && against.is_empty() {
        return Err("E_USAGE --against-source-dir requires --against SOURCE".to_string());
    }
    let mut options = super::options(arguments)?;
    options.command = "check".to_string();
    options.index = false;
    options.inline_limit = Some(0usize);
    Ok(Request { options, request, dry, recover, against, against_source, against_library, limit, detail })
}
fn normal(path: &str) -> String {
    if path.starts_with("./") { path[2usize..].to_string() } else { path.to_string() }
}
fn physical(root: &str, path: &str) -> String {
    if root == "." { normal(path) }
    else if root == "/" { format!("/{path}") }
    else { normal(&format!("{root}/{path}")) }
}
fn replace_snapshot(before: &Memo, after: &mut Memo, draft: &structure_edit::Draft) -> Result<(), String> {
    after.input_snapshot = before.input_snapshot.clone();
    for change in &draft.changes {
        if before.embedded_sources.contains(&normal(&change.file)) {
            return Err(format!("{} E_EDIT_EMBEDDED source is embedded; supply an explicit editable --library-dir",
                semantic::quote(&change.file)));
        }
        let mut keys = Vec::new();
        for ((root, path), _) in &before.input_snapshot {
            if physical(root, path) == normal(&change.file) { keys.push((root.clone(), path.clone())); }
        }
        if keys.is_empty() {
            return Err(format!("{} E_EDIT_EMBEDDED source is embedded; supply an explicit editable --library-dir",
                semantic::quote(&change.file)));
        }
        for key in keys {
            after.input_snapshot.insert(key, (Some(change.after.clone()), Some(sha256::hex_digest(&change.after))));
        }
    }
    Ok(())
}
fn unchanged_inputs(world: &mut World, before: &Memo, after: &Memo,
    prepared: Option<&structure_write::Prepared>) -> Result<(), String> {
    for (key, value) in &after.input_snapshot {
        let expected = before.input_snapshot.get(key).unwrap_or(value);
        let physical_path = physical(&key.0, &key.1);
        let stale = format!("{} E_EDIT_STALE source dependency changed during checking", semantic::quote(&physical_path));
        let mut root = world.directory(&key.0)
            .map_err(|errno: i64| -> String { format!("E_EDIT_IO open {}: errno {errno}", key.0) })?;
        let (parent, name) = super::location(&key.1);
        let mut owner = match root.open_directory(&parent) {
            Ok(owner) => owner,
            Err(2i64) | Err(20i64) if expected.0.is_none() => continue,
            Err(errno) => return Err(format!("{} E_EDIT_IO open source parent: errno {errno}", semantic::quote(&physical_path))),
        };
        if let Some(prepared) = prepared {
            let identity = std::io::directory_identity(&mut owner)
                .map_err(|errno: i64| -> String { format!("{} E_EDIT_IO identify source parent: errno {errno}", semantic::quote(&physical_path)) })?;
            // The spelling must be exactly the one replace_snapshot overlays.
            prepared.check_input(&identity, &name, &physical_path)?;
        }
        let mut file = match owner.open_regular(&name) {
            Ok(file) => file,
            Err(2i64) if expected.0.is_none() => continue,
            Err(errno) => return Err(format!("{} E_EDIT_IO open regular source dependency: errno {errno}", semantic::quote(&physical_path))),
        };
        let bytes = match &expected.0 {
            Some(bytes) => bytes,
            None => return Err(stale),
        };
        // Compare only the captured length plus one EOF byte. A changed file
        // cannot demand an unbounded allocation during publication validation.
        let mut at = 0usize;
        let mut buffer = [0u8; 8192];
        while at < bytes.len() {
            let remaining = bytes.len() - at;
            let size = if remaining < buffer.len() { remaining } else { buffer.len() };
            let count = file.read(&mut buffer[..size])
                .map_err(|errno: i64| -> String { format!("{} E_EDIT_IO read source dependency: errno {errno}", semantic::quote(&physical_path)) })?;
            if count == 0usize || buffer[..count] != bytes[at..at + count] { return Err(stale); }
            at += count;
        }
        let mut extra = [0u8; 1];
        if file.read(&mut extra)
            .map_err(|errno: i64| -> String { format!("{} E_EDIT_IO read source dependency boundary: errno {errno}", semantic::quote(&physical_path)) })? != 0usize {
            return Err(stale);
        }
    }
    Ok(())
}
fn entries(checked: &ir::CheckedProgram, catalog: &semantic::Catalog) -> BTreeMap<String, BTreeSet<String>> { meaning::verified::authority_sets(checked, catalog) }
fn joined(values: &[String]) -> String {
    let mut out = String::new();
    for value in values {
        if !out.is_empty() { out.push(','); }
        out.push_str(value);
    }
    out
}
fn authority_delta(old: &ir::CheckedProgram, old_catalog: &semantic::Catalog, new: &ir::CheckedProgram, new_catalog: &semantic::Catalog) -> String {
    let before = entries(old, old_catalog);
    let after = entries(new, new_catalog);
    let mut names: BTreeSet<String> = BTreeSet::new();
    for (name, _) in &before { names.insert(name.clone()); }
    for (name, _) in &after { names.insert(name.clone()); }
    let mut out = String::new();
    let empty: BTreeSet<String> = BTreeSet::new();
    for name in names {
        let left = before.get(&name).unwrap_or(&empty);
        let right = after.get(&name).unwrap_or(&empty);
        let mut gains: Vec<String> = Vec::new();
        let mut losses: Vec<String> = Vec::new();
        for fact in right { if !left.contains(fact) { gains.push(fact.clone()); } }
        for fact in left { if !right.contains(fact) { losses.push(fact.clone()); } }
        if !gains.is_empty() || !losses.is_empty() || before.contains_key(&name) != after.contains_key(&name) {
            out.push_str(&format!("{} level=checked-ir authority-gained={} authority-lost={} entry-before={} entry-after={}\n",
                semantic::quote(&name), semantic::quote(&joined(&gains)), semantic::quote(&joined(&losses)),
                before.contains_key(&name), after.contains_key(&name)));
        }
    }
    if out.is_empty() { out.push_str("program level=checked-ir authority-delta=none\n"); }
    out
}
fn finish(memo: &mut Memo) {
    if let Some(store) = memo.store.as_mut() { store.finish(); }
}
fn compare(world: &mut World, request: &Request, stats: &mut Stats) -> Result<u8, String> {
    if request.against.is_empty() { return Err("E_USAGE compare requires --against SOURCE".to_string()); }
    let mut before_options = request.options.clone();
    before_options.path = request.against.clone();
    before_options.source_directory = request.against_source.clone();
    if !request.against_library.is_empty() { before_options.library_directory = Some(request.against_library.clone()); }
    let mut before = Memo::new(world, &before_options);
    before.capture_catalog = true;
    before.catalog_items_only = true;
    let old = super::compile(world, &before_options, stats, &mut before)?;
    finish(&mut before);
    let old_catalog = before.catalog.take().ok_or("E_EDIT_SOURCE comparison requires source, not raw IR")?;
    let mut after = Memo::new(world, &request.options);
    after.capture_catalog = true;
    after.catalog_items_only = true;
    let new = super::compile(world, &request.options, stats, &mut after)?;
    finish(&mut after);
    let new_catalog = after.catalog.take().ok_or("E_EDIT_SOURCE comparison requires source, not raw IR")?;
    let text_identical = crate::structure_replay::same_text(&old_catalog, &before.source_inputs,
        &new_catalog, &after.source_inputs);
    let out = meaning::compare(&old_catalog, old.original().checked(), &new_catalog,
        new.original().checked(), text_identical, request.limit, &request.detail)?;
    world.stdout().write(out.as_bytes());
    Ok(0u8)
}

fn source_delta(before: &semantic::Catalog, after: &semantic::Catalog) -> String {
    let mut names: BTreeSet<String> = BTreeSet::new();
    for item in &before.items {
        if !matches!(item.kind.as_str(), "binding" | "call-site") { names.insert(item.identity.clone()); }
    }
    for item in &after.items {
        if !matches!(item.kind.as_str(), "binding" | "call-site") { names.insert(item.identity.clone()); }
    }
    let mut out = String::new();
    for name in names {
        let left = before.by_identity.get(&name).map(|index| &before.items[*index]);
        let right = after.by_identity.get(&name).map(|index| &after.items[*index]);
        let delta = match (left, right) {
            (Some(old), Some(new)) => meaning::item_delta(old, new),
            (Some(_), None) => "removed".to_string(),
            (None, Some(_)) => "added".to_string(),
            _ => String::new(),
        };
        if !delta.is_empty() {
            out.push_str(&format!("{} level=source-claim changed={}\n", semantic::quote(&name), delta));
        }
    }
    out
}

fn changes_library(options: &Options, before: &Memo, draft: &structure_edit::Draft) -> bool {
    let Some(library) = &options.library_directory else { return false; };
    for change in &draft.changes {
        for ((root, path), _) in &before.input_snapshot {
            if root == library && physical(root, path) == normal(&change.file) { return true; }
        }
    }
    false
}

fn replay_target(world: &mut World, request: &Request, options: &Options,
    stats: &mut Stats, before: &Memo, old_catalog: &semantic::Catalog,
    desired_read: &mut Option<Memo>) -> Result<(structure_edit::Request, String), String> {
    let mut desired_options = options.clone();
    desired_options.path = request.against.clone();
    desired_options.source_directory = request.against_source.clone();
    if !request.against_library.is_empty() {
        desired_options.library_directory = Some(request.against_library.clone());
    }
    let mut desired_memo = match desired_read.take() {
        Some(memo) => memo,
        None => Memo::new(world, &desired_options),
    };
    desired_memo.capture_catalog = true; desired_memo.catalog_items_only = true;
    desired_memo.private_source_digest = before.private_source_digest;
    let desired = super::compile(world, &desired_options, stats, &mut desired_memo)?;
    let desired_catalog = desired_memo.catalog.take().ok_or("E_REPLAY_SOURCE desired tree requires source, not raw IR")?;
    let scope = options.source_directory.as_ref().map_or(".", |value| value.as_str());
    let operations = crate::structure_replay::request_with_scope(old_catalog, &before.source_inputs,
        &desired_catalog, &desired_memo.source_inputs, scope)?;
    let identity = meaning::identity(desired.original().checked());
    finish(&mut desired_memo);
    *desired_read = Some(desired_memo);
    Ok((operations, identity))
}
fn edit(world: &mut World, request: &Request, stats: &mut Stats) -> Result<u8, String> {
    if !request.request.is_empty() && !request.against.is_empty() {
        return Err("E_USAGE edit accepts either --request or --against, not both".to_string());
    }
    if request.recover && (!request.request.is_empty() || !request.against.is_empty()) {
        return Err("E_USAGE --recover does not accept a new transaction".to_string());
    }
    if request.options.path.starts_with('/') {
        return Err("E_EDIT_ROOT use a relative source path with --source-dir PROJECT_ROOT".to_string());
    }
    let scope = request.options.source_directory.as_ref().map_or(".", |value| value.as_str());
    let mut writer = if request.dry {
        if request.recover { return Err("E_USAGE --recover cannot be combined with --dry-run".to_string()); }
        None
    } else {
        let key = request.options.store_key.as_ref().ok_or("E_EDIT_KEY apply/recovery requires --store-key PRIVATE_KEY outside source roots")?;
        Some(structure_write::Writer::open(world, scope, key)?)
    };
    if let Some(writer) = writer.as_mut() {
        let count = writer.recover()?;
        if request.recover {
            world.stdout().write(format!("transaction recovered-files={count}\n").as_bytes());
            return Ok(0u8);
        }
    }
    if request.request.is_empty() && request.against.is_empty() {
        return Err("E_USAGE edit requires --request JSON_FILE or --against DESIRED_SOURCE".to_string());
    }
    let mut operations = if request.against.is_empty() {
        structure_edit::parse(&super::read_path(world, &request.request)?)?
    } else { structure_edit::Request { snapshot: String::new(), operations: Vec::new() } };
    let mut desired_identity = String::new();
    let mut desired_read: Option<Memo> = None;
    let mut items_only = true;
    let mut preserving: Vec<structure_edit::Operation> = Vec::new();
    for operation in &operations.operations {
        if !matches!(operation.kind.as_str(), "replace-body" | "replace-item" | "add-item" | "remove-item") { items_only = false; }
        if matches!(operation.kind.as_str(), "rename" | "move") { preserving.push(operation.clone()); }
    }
    let mut active_options = request.options.clone();
    let mut before = Memo::new(world, &active_options);
    before.catalog_items_only = items_only;
    before.capture_catalog = true;
    if let Some(writer) = writer.as_ref() { before.private_source_digest = Some(writer.private_source_digest()); }
    let mut old = super::compile(world, &active_options, stats, &mut before)?;
    let mut old_catalog = before.catalog.take().ok_or("E_EDIT_SOURCE transactions require source, not raw IR")?;
    if !request.against.is_empty() {
        let target = replay_target(world, request, &active_options, stats,
            &before, &old_catalog, &mut desired_read)?;
        operations = target.0; desired_identity = target.1;
    }
    let mut draft = structure_edit::plan(&old_catalog, &before.source_inputs, &operations)?;
    prepare_projections(world, &active_options, &mut before, &old_catalog, &mut draft)?;
    if changes_library(&active_options, &before, &draft) {
        // Reuse the same pinned positive/negative read sets and writer lock.
        // All sides of the transaction now admit every library definition.
        active_options.command = "check-library".to_string();
        old = super::compile(world, &active_options, stats, &mut before)
            .map_err(|problem| -> String { format!("transaction E_EDIT_LIBRARY {problem}") })?;
        old_catalog = before.catalog.take().ok_or("E_EDIT_SOURCE library source catalog is missing")?;
        if !request.against.is_empty() {
            let target = replay_target(world, request, &active_options, stats,
                &before, &old_catalog, &mut desired_read)?;
            operations = target.0; desired_identity = target.1;
        }
        draft = structure_edit::plan(&old_catalog, &before.source_inputs, &operations)?;
        prepare_projections(world, &active_options, &mut before, &old_catalog, &mut draft)?;
    }
    let mut capture_targets: Vec<String> = Vec::new();
    preserving.clear();
    for operation in &operations.operations {
        if matches!(operation.kind.as_str(), "rename" | "move") { preserving.push(operation.clone()); }
        if operation.kind == "rename" {
            if let Some(identity) = structure_edit::capture_rename_target(&old_catalog, operation)? {
                capture_targets.push(identity);
            }
        }
    }
    let mut prepared = match writer.as_mut() {
        Some(writer) => writer.prepare(&draft)?,
        None => structure_write::prepare(world, scope, &draft)?,
    };
    let original_identity = meaning::identity(old.original().checked());
    if !preserving.is_empty() && preserving.len() != operations.operations.len() {
        let preserving_request = structure_edit::Request { snapshot: operations.snapshot.clone(), operations: preserving.clone() };
        let preserving_draft = structure_edit::plan(&old_catalog, &before.source_inputs, &preserving_request)?;
        let mut proof_options = active_options.clone(); proof_options.store_directory = None;
        let mut proof = Memo::new(world, &proof_options);
        proof.capture_catalog = true; proof.catalog_items_only = capture_targets.is_empty();
        proof.private_source_digest = before.private_source_digest;
        replace_snapshot(&before, &mut proof, &preserving_draft)?;
        let preserved = super::compile(world, &proof_options, stats, &mut proof)?;
        if !capture_targets.is_empty() {
            let catalog = proof.catalog.as_ref().ok_or("E_EDIT_SOURCE capture replay catalog is missing")?;
            if let Some(reason) = structure_edit::capture_rename_refusal(&old_catalog, catalog, &capture_targets) {
                return Err(reason);
            }
        }
        if original_identity != meaning::identity(preserved.original().checked()) {
            return Err("transaction E_EDIT_MEANING rename/move subset changed checked IR; no source was published".to_string());
        }
    }
    let mut uncached = active_options.clone();
    uncached.store_directory = None;
    let mut after = Memo::new(world, &uncached);
    after.capture_catalog = true;
    after.catalog_items_only = capture_targets.is_empty();
    after.private_source_digest = before.private_source_digest;
    after.store = before.store.take();
    replace_snapshot(&before, &mut after, &draft)?;
    let new = super::compile(world, &active_options, stats, &mut after)
        .map_err(|problem| -> String { format!("transaction E_EDIT_CHECK identities={} {problem}",
            semantic::quote(&joined(&draft.identities))) })?;
    let new_catalog = after.catalog.take().ok_or("E_EDIT_SOURCE candidate source catalog is missing")?;
    verify_projections(scope, &old_catalog, &new_catalog, &draft)?;
    let candidate_identity = meaning::identity(new.original().checked());
    if !capture_targets.is_empty() && preserving.len() == operations.operations.len() {
        if let Some(reason) = structure_edit::capture_rename_refusal(&old_catalog, &new_catalog, &capture_targets) {
            return Err(reason);
        }
    }
    if !preserving.is_empty() && preserving.len() == operations.operations.len()
        && original_identity != candidate_identity {
        return Err("transaction E_EDIT_MEANING rename/move changed checked IR; no source was published".to_string());
    }
    if !desired_identity.is_empty() && desired_identity != candidate_identity {
        return Err(format!("transaction E_REPLAY_MEANING desired={} candidate={}; no source was published",
            desired_identity, candidate_identity));
    }
    prepared.verify(&draft)?;
    unchanged_inputs(world, &before, &after, Some(&prepared))?;
    if let Some(desired_memo) = &desired_read { unchanged_inputs(world, desired_memo, desired_memo, None)?; }
    let mut report = structure_edit::report(&draft);
    report.push_str(&source_delta(&old_catalog, &new_catalog));
    report.push_str(&authority_delta(old.original().checked(), &old_catalog, new.original().checked(), &new_catalog));
    let total = new.original().program().functions.len();
    let counted = after.checked_reused + after.checked_local_reused;
    let reused = if counted > total { total } else { counted };
    report.push_str(&format!("program level=checked-ir before={} after={} checked-instances={} fresh-checked={} proof-reused={} frontend-resumed={} library-validation={}\n",
        original_identity, candidate_identity,
        total, total - reused, reused, after.front_reused,
        if active_options.command == "check-library" { "all" } else { "demanded" }));
    report.push_str(&format!("transaction source-before={} source-after={} mode={}\n",
        old_catalog.input_digest, new_catalog.input_digest, if request.dry { "dry-run" } else { "apply" }));
    if !desired_identity.is_empty() {
        report.push_str(&format!("replay desired={} candidate={} verified=true operations={}\n",
            desired_identity, candidate_identity, operations.operations.len()));
    }
    if let Some(writer) = writer.as_mut() {
        // The independent checker has admitted this entire candidate. The journal
        // carries only its text projection and grants no reusable checker proof.
        writer.publish_prepared(&draft, &mut prepared)?;
    }
    finish(&mut after);
    world.stdout().write(report.as_bytes());
    Ok(0u8)
}
pub(super) fn run(world: &mut World, values: &[String]) -> Result<u8, String> {
    let request = parse(values)?;
    let mut stats = Stats::new(world, request.options.stats)?;
    let result = if values[0usize] == "compare" { compare(world, &request, &mut stats) }
        else { edit(world, &request, &mut stats) };
    stats.finish(world, if result.is_ok() { "done" } else { "failed" })?;
    result
}

pub(crate) mod consistency {
    use super::Options;
    pub(crate) fn capture(world: &mut World, options: &Options) -> Result<Vec<(String, String)>, String> {
        let root = options.source_directory.as_ref().map_or(".", |value| value.as_str());
        let actual = if options.path.starts_with('/') { options.path.clone() }
            else if root == "." { options.path.clone() } else { format!("{root}/{}", options.path) };
        let mut roots: Vec<String> = vec![root.to_string()];
        if !options.path.starts_with("$toolchain/") {
        if let Some(at) = actual.rfind('/') {
            let parent = if at == 0usize { "/".to_string() } else { actual[..at].to_string() };
            if !roots.contains(&parent) { roots.push(parent); }
        }
        }
        if let Some(path) = &options.library_directory {
            if !roots.contains(path) { roots.push(path.clone()); }
        }
        let mut values = Vec::new();
        for root in roots {
            let stamp = crate::structure_write::stamp(world, &root)?;
            values.push((root, stamp));
        }
        Ok(values)
    }
    pub(crate) fn verify(world: &mut World, values: &[(String, String)]) -> Result<(), String> {
        for (root, before) in values {
            let after = crate::structure_write::stamp(world, root)?;
            if *before != after {
                return Err(format!("{} E_EDIT_STALE source transaction changed during compilation; retry against the completed projection", root));
            }
        }
        Ok(())
    }
}

fn missing_source(world: &mut World, root: &str, path: &str) -> Result<bool, String> {
    let mut directory = world.directory(root)
        .map_err(|errno: i64| -> String { format!("E_EDIT_IO open {root}: errno {errno}") })?;
    let (parent, name) = super::location(path);
    let mut owner = match directory.open_directory(&parent) {
        Ok(owner) => owner,
        // This is a negative dependency observation, not permission to create
        // a leaf. Prepared separately requires every changed parent to exist.
        Err(2i64) | Err(20i64) => return Ok(true),
        Err(errno) => return Err(format!("E_EDIT_IO open dependency parent {parent}: errno {errno}")),
    };
    match owner.open_regular(&name) {
        Ok(file) => { drop(file); Ok(false) },
        Err(2i64) => Ok(true),
        Err(errno) => Err(format!("{} E_EDIT_IO inspect source dependency: errno {errno}", semantic::quote(&physical(root, path)))),
    }
}

fn projection_paths(catalog: &semantic::Catalog, projection: &structure_edit::Projection) -> Result<(String, String, String), String> {
    let mut selected: Option<usize> = None;
    let mut width = 0usize;
    for (index, source) in catalog.module_sources.iter().enumerate() {
        let prefix = format!("{}::", source.identity);
        let matches = if source.identity == "crate" {
            projection.parent != "type@std" && !projection.parent.starts_with("type@std::")
        } else {
            projection.parent == source.identity || projection.parent.starts_with(&prefix)
        };
        let score = if source.identity == "crate" { 0usize } else { source.identity.len() + 1usize };
        if matches && (selected.is_none() || score > width) { selected = Some(index); width = score; }
    }
    let index = selected.ok_or_else(|| structure_edit::error(&projection.identity, "PROJECTION", "parent has no loaded module provenance"))?;
    let source = &catalog.module_sources[index];
    let (parent, leaf) = super::location(&source.file);
    let mut directory = if source.identity == "crate" || source.identity == "type@std" || leaf == "mod.lkj" {
        parent
    } else if source.file.ends_with(".lkj") {
        source.file[..source.file.len() - 4usize].to_string()
    } else { return Err(structure_edit::error(&projection.identity, "PROJECTION", "loaded module is not an .lkj source")); };
    let suffix = if projection.parent == source.identity {
        String::new()
    } else if source.identity == "crate" {
        semantic::resolver_module_path(semantic::source_path(&projection.parent))
    } else {
        projection.parent[source.identity.len() + 2usize..].to_string()
    };
    if !suffix.is_empty() {
        for part in suffix.as_str().split("::") { directory = physical(&directory, part); }
    }
    let name = match projection.identity.rfind("::") {
        Some(at) => &projection.identity[at + 2usize..],
        None => semantic::source_path(&projection.identity),
    };
    let direct = physical(&directory, &format!("{name}.lkj"));
    let nested = physical(&directory, &format!("{name}/mod.lkj"));
    Ok((source.file.clone(), direct, nested))
}

fn relative_input(root: &str, file: &str) -> Result<String, String> {
    let root = normal(root);
    let file = normal(file);
    if root == "." && !file.starts_with('/') { return Ok(file); }
    if root == "/" && file.starts_with('/') { return Ok(file[1usize..].to_string()); }
    let prefix = format!("{root}/");
    if file.starts_with(&prefix) { return Ok(file[prefix.len()..].to_string()); }
    Err(structure_edit::error(&file, "ROOT", "projection is outside its parent's captured source directory"))
}

fn prepare_projections(world: &mut World, options: &Options, before: &mut Memo,
    catalog: &semantic::Catalog, draft: &mut structure_edit::Draft) -> Result<(), String> {
    let scope = options.source_directory.as_ref().map_or(".", |value| value.as_str());
    for projection in &draft.projections {
        let file = physical(scope, &projection.path);
        let (parent_file, direct, nested) = projection_paths(catalog, projection)?;
        if file != normal(&direct) && file != normal(&nested) {
            return Err(structure_edit::error(&projection.identity, "PROJECTION",
                "path is neither loader candidate for this module declaration"));
        }
        if before.embedded_sources.contains(&normal(&parent_file)) {
            return Err(structure_edit::error(&projection.identity, "EMBEDDED",
                "module parent is embedded; supply an explicit editable --library-dir"));
        }
        for change in &draft.changes {
            if normal(&change.file) == file {
                return Err(structure_edit::error(&projection.identity, "OVERLAP", "projection also has another file change"));
            }
        }
        let mut roots: BTreeSet<String> = BTreeSet::new();
        for ((root, path), _) in &before.input_snapshot {
            if physical(root, path) == normal(&parent_file) { roots.insert(root.clone()); }
        }
        if roots.is_empty() {
            return Err(structure_edit::error(&projection.identity, "PROJECTION", "loaded parent has no physical source read"));
        }
        // Both candidates are negative inputs. Candidate loading consumes this
        // same pinned set, and unchanged_inputs rechecks it before publication.
        for root in roots {
            let candidates: Vec<String> = vec![direct.clone(), nested.clone()];
            for candidate in candidates {
                let path = relative_input(&root, &candidate)?;
                let key = (root.clone(), path.clone());
                if let Some((bytes, _)) = before.input_snapshot.get(&key) {
                    if bytes.is_some() {
                        return Err(structure_edit::error(&projection.identity, "EXISTS", "a module candidate was already present in the source snapshot"));
                    }
                }
                if !missing_source(world, &root, &path)? {
                    return Err(structure_edit::error(&projection.identity, "EXISTS", "a module candidate is already occupied"));
                }
                before.input_snapshot.insert(key, (None, None));
            }
        }
        draft.changes.push(structure_edit::Change { file,
            before: structure_edit::PreviousText::Absent, after: projection.source.clone() });
    }
    Ok(())
}

fn verify_projections(scope: &str, before: &semantic::Catalog, after: &semantic::Catalog,
    draft: &structure_edit::Draft) -> Result<(), String> {
    for projection in &draft.projections {
        let file = physical(scope, &projection.path);
        let (_, direct, nested) = projection_paths(before, projection)?;
        let alternate = if file == normal(&direct) { normal(&nested) } else { normal(&direct) };
        let mut count = 0usize;
        for source in &after.module_sources {
            if source.identity == projection.identity && source.parent == projection.parent
                && normal(&source.file) == file && normal(&source.alternate) == alternate {
                count += 1usize;
            }
        }
        if count != 1usize {
            return Err(structure_edit::error(&projection.identity, "PROJECTION",
                "checked candidate did not select this projection as exactly this module's source"));
        }
    }
    Ok(())
}

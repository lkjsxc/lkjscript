//! Streaming unconditional manifest data and an authenticated disk schedule.
use super::{beneath, identifier, Definition};
use crate::native::records;
use crate::{sha256, store, syntax};


mod input;

mod tokens;

mod parser;

mod schedule;

mod tests;

pub(crate) fn contracts(world: &mut World) -> usize { tests::run(world) }

pub(crate) fn smoke_contracts(world: &mut World) -> usize { tests::smoke(world) }

const CHUNK: usize = 65536usize;

fn issue(message: &str) -> String { format!("E_UNIT_SOURCE {message}") }

fn record_error(message: String) -> String { issue(&message) }

fn io(path: &str, operation: &str, errno: i64) -> String {
    format!("{path}:1:1: E_IO {operation}: errno {errno}")
}

fn ordinal_key(prefix: &str, index: usize) -> String {
    let alphabet = b"0123456789abcdef"; let mut digits = [b'0'; 16]; let mut value = index;
    for at in 0usize..16usize {
        digits[15usize - at] = alphabet[value & 15usize]; value >>= 4usize;
    }
    format!("{prefix}{}", String::from_utf8(digits[..].to_vec()).unwrap())
}

fn next_count(value: usize) -> Result<usize, String> {
    value.checked_add(1usize).ok_or_else(|| issue("manifest count overflow"))
}

fn row_bytes(kind: usize, ordinal: usize, value: &str) -> Vec<u8> {
    let mut bytes = b"LKJUNITROW1\n"[..].to_vec();
    store::push_word(&mut bytes, kind); store::push_word(&mut bytes, ordinal);
    store::push_bytes(&mut bytes, value.as_bytes()); bytes
}

fn row_value(bytes: &[u8], kind: usize, ordinal: usize) -> Option<String> {
    let magic = b"LKJUNITROW1\n"; if !bytes.starts_with(magic) { return None; }
    let mut reader = store::Reader::new(&bytes[magic.len()..]);
    if reader.word()? != kind || reader.word()? != ordinal { return None; }
    let value = reader.text()?; if !reader.done() { return None; } Some(value)
}

#[derive(Clone, Copy, PartialEq, Eq)]
pub(crate) struct Fingerprint {
    pub(crate) bytes: usize,
    pub(crate) digest: [u8; 32],
}

pub(crate) fn fingerprint(file: File, path: &str, private: &Option<[u8; 32]>) -> Result<Fingerprint, String> {
    input::fingerprint(file, path, private)
}

pub(crate) struct Plan {
    data: records::Store,
    entry: String,
    count: usize,
    next: usize,
    fingerprint: Fingerprint,
    inventory: usize,
    failed: bool,
}

impl Plan {
    pub(crate) fn open(file: File, scratch: File, path: &str, private: &Option<[u8; 32]>) -> Result<Self, String> {
        let mut data = records::Store::new(scratch).map_err(|message: String| record_error(message))?;
        // No lexer diagnostic may reflect bytes before the exact private-key
        // exclusion and complete UTF-8 validation have finished.
        let captured = input::capture(file, &mut data, path, private)?;
        let tape = tokens::produce(&mut data, captured)?;
        let parsed = parser::parse(&mut data, tape)?;
        schedule::construct(data, captured, tape, parsed)
    }
    fn get_inner(&mut self, name: &str) -> Result<Option<Definition>, String> {
        schedule::definition(&mut self.data, name, self.count, None)
    }
    pub(crate) fn get(&mut self, name: &str) -> Result<Option<Definition>, String> {
        if self.failed { return Err(issue("retained manifest is poisoned")); }
        self.failed = true; let result = self.get_inner(name);
        if result.is_ok() { self.failed = false; } result
    }
    fn next_inner(&mut self) -> Result<Option<Definition>, String> {
        if self.next == self.count { return Ok(None); }
        if self.next > self.count { return Err(issue("invalid retained manifest cursor")); }
        let bytes = self.data.get(&ordinal_key("O", self.next)).map_err(|message: String| record_error(message))?
            .ok_or_else(|| issue("retained manifest order entry disappeared"))?;
        let name = row_value(&bytes, 2usize, self.next)
            .ok_or_else(|| issue("malformed retained manifest order"))?;
        let unit = schedule::definition(&mut self.data, &name, self.count, Some(self.next))?
            .ok_or_else(|| issue("retained manifest definition disappeared"))?;
        self.next = next_count(self.next)?; Ok(Some(unit))
    }
    pub(crate) fn next(&mut self) -> Result<Option<Definition>, String> {
        if self.failed { return Err(issue("retained manifest is poisoned")); }
        self.failed = true; let result = self.next_inner();
        if result.is_ok() { self.failed = false; } result
    }
    pub(crate) fn entry(&self) -> &str { self.entry.as_str() }
    pub(crate) fn len(&self) -> usize { self.count }
    pub(crate) fn fingerprint(&self) -> Fingerprint { self.fingerprint }
    pub(crate) fn finish(self) -> Result<(), String> {
        if self.failed { return Err(issue("retained manifest is poisoned")); }
        if self.next != self.count || self.data.len() != self.inventory {
            return Err(issue("retained manifest was not completely consumed"));
        }
        self.data.finish().map_err(|message: String| record_error(message))
    }
}

pub(crate) fn contracts_main(mut world: World) {
    let count = contracts(&mut world);
    world.stdout().write(format!("ok streaming manifest {count} controls\n").as_bytes());
}

pub(crate) fn smoke_main(mut world: World) {
    let count = smoke_contracts(&mut world);
    world.stdout().write(format!("ok streaming manifest {count} controls\n").as_bytes());
}

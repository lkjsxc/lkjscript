//! Magnitudes shared by source integer expressions, patterns and literal lengths.
pub(crate) fn magnitude(text: &str) -> Option<u64> {
    let (digits, radix) = if text.starts_with("0x") {
        (&text[2..], 16u64)
    } else if text.starts_with("0b") {
        (&text[2..], 2u64)
    } else if text.starts_with("0o") {
        (&text[2..], 8u64)
    } else {
        (text, 10u64)
    };
    let bytes = digits.as_bytes();
    let mut index = if bytes.first() == Some(&b'+') { 1 } else { 0 };
    if index == bytes.len() { return None; }
    let mut value = 0u64;
    while index < bytes.len() {
        let byte = bytes[index];
        let digit = if byte >= b'0' && byte <= b'9' {
            (byte - b'0') as u64
        } else if byte >= b'a' && byte <= b'f' {
            (byte - b'a' + 10) as u64
        } else if byte >= b'A' && byte <= b'F' {
            (byte - b'A' + 10) as u64
        } else {
            return None;
        };
        if digit >= radix || value > (!0u64 - digit) / radix { return None; }
        value = value * radix + digit;
        index += 1;
    }
    Some(value)
}

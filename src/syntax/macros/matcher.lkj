//! Deterministic declarative matchers. Fragment parsing uses the ordinary surface parser.
use super::*;

#[derive(Clone)]
pub(super) struct Rule { pattern: Vec<MacroToken>, template: Vec<MacroToken>, variables: Vec<Binding> }
#[derive(Clone)]
struct Value { path: Vec<usize>, tokens: Vec<MacroToken> }
#[derive(Clone)]
struct Binding { name: String, fragment: String, depth: usize, values: Vec<Value>, repetitions: Vec<(Vec<usize>, usize)> }
struct Repetition { body: Vec<MacroToken>, separator: Option<MacroToken>, minimum: usize, optional: bool, next: usize }
fn repetition(tokens: &[MacroToken], at: usize) -> Result<Repetition, Diagnostic> {
    let end = group_end(tokens, at + 1usize)?;
    let mut next = end + 1usize;
    let mut separator = None;
    if next < tokens.len() && !(tokens[next].kind == 6u8 && matches!(tokens[next].text.as_str(), "*" | "+" | "?")) {
        if tokens[next].kind == 6u8 && (opening(&tokens[next].text) || closing(&tokens[next].text)) {
            return Err(error(tokens[next].span, "E_MACRO_RULE", "repetition separator must be one non-delimiter token"));
        }
        separator = Some(tokens[next].clone());
        next += 1usize;
    }
    if next >= tokens.len() || tokens[next].kind != 6u8 || !matches!(tokens[next].text.as_str(), "*" | "+" | "?") {
        return Err(error(tokens[at].span, "E_MACRO_RULE", "repetition requires *, +, or ?"));
    }
    let optional = tokens[next].text == "?";
    if optional && separator.is_some() {
        return Err(error(tokens[next].span, "E_MACRO_RULE", "optional repetition has no separator"));
    }
    Ok(Repetition { body: tokens[at + 2usize..end].to_vec(), separator,
        minimum: if tokens[next].text == "+" { 1usize } else { 0usize }, optional, next: next + 1usize })
}
fn expression_follower(tokens: &[MacroToken], at: usize, end_allowed: bool) -> Result<bool, Diagnostic> {
    if at == tokens.len() { return Ok(end_allowed); }
    if tokens[at].kind == 6u8 && matches!(tokens[at].text.as_str(), "," | ";" | "=>") { return Ok(true); }
    if symbol(&tokens[at], "$") && at + 1usize < tokens.len() && symbol(&tokens[at + 1usize], "(") {
        let repeat = repetition(tokens, at)?;
        return Ok(expression_follower(&repeat.body, 0usize, end_allowed)?
            && (repeat.minimum != 0usize || expression_follower(tokens, repeat.next, end_allowed)?));
    }
    Ok(false)
}
fn variables(tokens: &[MacroToken], depth: usize, end_allowed: bool, bindings: &mut Vec<Binding>) -> Result<bool, Diagnostic> {
    let mut at = 0usize;
    let mut consumes = false;
    while at < tokens.len() {
        if symbol(&tokens[at], "$") {
            if at + 1usize < tokens.len() && symbol(&tokens[at + 1usize], "(") {
                let repeat = repetition(tokens, at)?;
                let mut follows = expression_follower(tokens, repeat.next, end_allowed)?;
                if let Some(separator) = &repeat.separator {
                    follows &= separator.kind == 6u8 && matches!(separator.text.as_str(), "," | ";" | "=>");
                }
                if !variables(&repeat.body, depth + 1usize, follows, bindings)? {
                    return Err(error(tokens[at].span, "E_MACRO_RULE", "repetition body must consume input"));
                }
                consumes |= repeat.minimum != 0usize;
                at = repeat.next;
                continue;
            }
            if at + 3usize >= tokens.len() || tokens[at + 1usize].kind != 0u8
                || !symbol(&tokens[at + 2usize], ":") || tokens[at + 3usize].kind != 0u8 {
                return Err(error(tokens[at].span, "E_MACRO_RULE", "expected $name:fragment in matcher"));
            }
            let name = tokens[at + 1usize].text.clone();
            let fragment = tokens[at + 3usize].text.clone();
            if name == "crate" { return Err(error(tokens[at + 1usize].span, "E_MACRO_RULE", "$crate is reserved for the defining crate")); }
            if !matches!(fragment.as_str(), "expr" | "ident" | "tt") {
                return Err(error(tokens[at + 3usize].span, "E_UNSUPPORTED_MACRO", "supported declarative fragments are expr, ident, and tt"));
            }
            for binding in &*bindings {
                if binding.name == name { return Err(error(tokens[at + 1usize].span, "E_MACRO_RULE", "duplicate matcher binding")); }
            }
            if fragment == "expr" && !expression_follower(tokens, at + 4usize, end_allowed)? {
                return Err(error(tokens[at + 3usize].span, "E_MACRO_RULE", "expr fragment must be followed by a comma, semicolon, =>, or matcher end"));
            }
            bindings.push(Binding { name, fragment, depth, values: Vec::new(), repetitions: Vec::new() });
            consumes = true;
            at += 4usize;
        } else if tokens[at].kind == 6u8 && opening(&tokens[at].text) {
            let end = group_end(tokens, at)?;
            variables(&tokens[at + 1usize..end], depth, true, bindings)?;
            consumes = true;
            at = end + 1usize;
        } else { consumes = true; at += 1usize; }
    }
    Ok(consumes)
}
pub(super) fn rules(definition: &MacroDefinition) -> Result<Vec<Rule>, Diagnostic> {
    let tokens = &definition.body;
    let mut at = 0usize;
    let mut result = Vec::new();
    while at < tokens.len() {
        if symbol(&tokens[at], ";") { at += 1usize; continue; }
        let pattern_end = group_end(tokens, at)?;
        if pattern_end + 2usize >= tokens.len() || !symbol(&tokens[pattern_end + 1usize], "=>") {
            return Err(error(tokens[at].span, "E_MACRO_RULE", "macro rule requires => and a delimited expansion"));
        }
        let template_start = pattern_end + 2usize;
        let template_end = group_end(tokens, template_start)?;
        let pattern = tokens[at + 1usize..pattern_end].to_vec();
        let mut bindings = Vec::new();
        variables(&pattern, 0usize, true, &mut bindings)?;
        result.push(Rule { pattern, template: tokens[template_start + 1usize..template_end].to_vec(), variables: bindings });
        at = template_end + 1usize;
        if at < tokens.len() && !symbol(&tokens[at], ";") {
            return Err(error(tokens[at].span, "E_MACRO_RULE", "macro rules must be separated by semicolons"));
        }
    }
    if result.is_empty() { return Err(error(definition.span, "E_MACRO_RULE", "macro definition has no rules")); }
    Ok(result)
}
struct Checkpoint {
    inventory: MacroInventory,
    captures: Vec<(Option<ExprId>, usize)>,
    origins: Vec<(usize, usize, usize)>,
}
fn checkpoint(program: &Program, _parent: Option<usize>) -> Checkpoint {
    let mut captures = Vec::new();
    for capture in &program.macro_captures { captures.push((capture.expression, capture.materializations.len())); }
    let mut origins = Vec::new();
    for origin in &program.macro_expansions { origins.push((origin.types.len(), origin.expressions.len(), origin.patterns.len())); }
    Checkpoint { inventory: crate::ast::macros::inventory(program), captures, origins }
}
fn rollback(program: &mut Program, saved: Checkpoint) {
    let counts = saved.inventory;
    for id in counts.types..program.types.len() {
        program.impl_traits.remove(&id); program.constant_arguments.remove(&id);
        program.value_argument_lists.remove(&id); program.array_length_spans.remove(&id); program.relaxed_bounds.remove(&id);
    }
    for id in counts.patterns..program.patterns.len() { program.macro_pattern_bindings.remove(&id); }
    for id in counts.scopes..program.scopes.len() { program.macro_use_modules.remove(&id); }
    program.types.truncate(counts.types); program.exprs.truncate(counts.exprs);
    program.patterns.truncate(counts.patterns); program.blocks.truncate(counts.blocks);
    program.functions.truncate(counts.functions); program.structs.truncate(counts.structs); program.enums.truncate(counts.enums);
    program.traits.truncate(counts.traits); program.impls.truncate(counts.impls); program.uses.truncate(counts.uses);
    program.modules.truncate(counts.modules); program.aliases.truncate(counts.aliases); program.constants.truncate(counts.constants);
    program.scopes.truncate(counts.scopes); program.attrs.truncate(counts.attrs);
    program.macro_definitions.truncate(counts.macro_definitions);
    program.macro_invocations.truncate(counts.macro_invocations); program.macro_captures.truncate(counts.macro_captures);
    for id in 0usize..saved.captures.len() {
        program.macro_captures[id].expression = saved.captures[id].0;
        program.macro_captures[id].materializations.truncate(saved.captures[id].1);
    }
    for id in 0usize..saved.origins.len() {
        let (types, expressions, patterns) = saved.origins[id];
        let origin = &mut program.macro_expansions[id]; origin.types.truncate(types);
        origin.expressions.truncate(expressions); origin.patterns.truncate(patterns);
    }
}
fn same(left: &MacroToken, right: &MacroToken) -> bool {
    left.kind == right.kind && left.kind != 8u8 && left.text == right.text
        && left.literal_spelling == right.literal_spelling
}
// Repetition heads must determine whether to continue without speculative capture choices.
// Pure literal overlaps can be legal in Rust's NFA matcher; this bounded reader locates them
// explicitly instead of choosing a later rule after a greedy mis-match.
fn starts(pattern: &[MacroToken], at: usize, token: &MacroToken) -> Result<(bool, bool), Diagnostic> {
    if at == pattern.len() { return Ok((false, false)); }
    if symbol(&pattern[at], "$") && at + 1usize < pattern.len() && symbol(&pattern[at + 1usize], "(") {
        let repeat = repetition(pattern, at)?;
        let (head, fragment) = starts(&repeat.body, 0usize, token)?;
        if repeat.minimum != 0usize { return Ok((head, fragment)); }
        let (tail, tail_fragment) = starts(pattern, repeat.next, token)?;
        return Ok((head || tail, fragment || tail_fragment));
    }
    if symbol(&pattern[at], "$") {
        let fragment = pattern[at + 3usize].text.as_str();
        let accepts = if fragment == "ident" { token.kind == 0u8 && token.text != "_" }
            else if fragment == "tt" { true }
            else if token.kind == 0u8 {
                !matches!(token.text.as_str(), "_" | "else" | "in" | "let" | "mut" | "ref" | "fn"
                    | "struct" | "enum" | "trait" | "impl" | "mod" | "use" | "pub" | "type" | "where")
            } else if token.kind == 6u8 {
                matches!(token.text.as_str(), "::" | "<" | "(" | "[" | "{" | "-" | "!" | "*" | "&" | "&&" | ".." | "..=" | "|" | "||")
            } else { matches!(token.kind, 1u8 | 2u8 | 3u8 | 4u8 | 8u8) };
        return Ok((accepts, accepts));
    }
    Ok((same(&pattern[at], token), false))
}
fn contains_binding(tokens: &[MacroToken], name: &str) -> bool {
    let mut at = 0usize;
    while at + 2usize < tokens.len() {
        if symbol(&tokens[at], "$") && tokens[at + 1usize].kind == 0u8
            && tokens[at + 1usize].text == name && symbol(&tokens[at + 2usize], ":") { return true; }
        at += 1usize;
    }
    false
}
fn matches(program: &mut Program, invocation: &MacroInvocation, pattern: &[MacroToken],
    input: &[MacroToken], position: &mut usize, path: &[usize], bindings: &mut Vec<Binding>) -> Result<bool, Diagnostic> {
    let mut at = 0usize;
    while at < pattern.len() {
        if symbol(&pattern[at], "$") && at + 1usize < pattern.len() && symbol(&pattern[at + 1usize], "(") {
            let repeat = repetition(pattern, at)?;
            let mut count = 0usize;
            loop {
                if count >= repeat.minimum && *position < input.len() {
                    let token = &input[*position];
                    let (next, next_fragment) = if count != 0usize && repeat.separator.is_some() {
                        (same(repeat.separator.as_ref().unwrap(), token), false)
                    } else { starts(&repeat.body, 0usize, token)? };
                    let (after, after_fragment) = starts(pattern, repeat.next, token)?;
                    if next && after {
                        return Err(error(token.span,
                            if next_fragment || after_fragment { "E_MACRO_AMBIGUITY" } else { "E_UNSUPPORTED_MACRO" },
                            "repetition continuation overlaps its following matcher"));
                    }
                }
                let start = *position;
                let saved = checkpoint(program, invocation.parent);
                let old = bindings.clone();
                if count != 0usize {
                    if let Some(separator) = &repeat.separator {
                        if *position >= input.len() || !same(separator, &input[*position]) { break; }
                        *position += 1usize;
                    }
                }
                let before = *position;
                let mut nested = path.to_vec(); nested.push(count);
                if matches(program, invocation, &repeat.body, input, position, &nested, bindings)? {
                    if *position == before { return Err(error(pattern[at].span, "E_MACRO_RULE", "repetition matched without progress")); }
                    count += 1usize;
                    if repeat.optional || *position == input.len() { break; }
                } else {
                    *position = start; *bindings = old; rollback(program, saved); break;
                }
            }
            if count < repeat.minimum { return Ok(false); }
            for index in 0usize..bindings.len() {
                if contains_binding(&repeat.body, &bindings[index].name) {
                    bindings[index].repetitions.push((path.to_vec(), count));
                }
            }
            at = repeat.next;
            continue;
        }
        if *position >= input.len() { return Ok(false); }
        if symbol(&pattern[at], "$") {
            let name = &pattern[at + 1usize].text;
            let binding = bindings.iter().position(|binding| binding.name == *name).unwrap();
            let fragment = bindings[binding].fragment.clone();
            let start = *position;
            let captured: Vec<MacroToken>;
            if fragment == "ident" {
                if input[start].kind != 0u8 || input[start].text == "_" { return Ok(false); }
                *position += 1usize; captured = input[start..*position].to_vec();
            } else if fragment == "tt" {
                *position = if input[start].kind == 6u8 && opening(&input[start].text) { group_end(input, start)? + 1usize } else { start + 1usize };
                captured = input[start..*position].to_vec();
            } else {
                let saved = checkpoint(program, invocation.parent);
                let parsed = probe_expression(program, &input[start..], invocation);
                let consumed = match parsed { Ok((_, consumed)) => consumed, Err(problem) => { rollback(program, saved); return Err(problem); } };
                rollback(program, saved);
                *position += consumed;
                let mut span = input[start].span;
                if consumed != 0usize && input[*position - 1usize].span.file == span.file { span.end = input[*position - 1usize].span.end; }
                let id = program.macro_captures.len();
                let owner = program.macro_expansions.last().unwrap().invocation;
                program.macro_captures.push(MacroCapture { materializations: Vec::new(), name: name.clone(), path: path.to_vec(), invocation: owner,
                    tokens: input[start..*position].to_vec(), scope: invocation.scope, span,
                    self_context: invocation.self_context, parent: invocation.parent, expression: None });
                captured = vec![MacroToken { kind: 8u8, text: String::new(), literal_spelling: String::new(), span,
                    origin: input[start].origin, context: input[start].context, expression: Some(id) }];
            }
            bindings[binding].values.push(Value { path: path.to_vec(), tokens: captured });
            at += 4usize;
        } else if pattern[at].kind == 6u8 && opening(&pattern[at].text) {
            if !same(&pattern[at], &input[*position]) { return Ok(false); }
            let pattern_end = group_end(pattern, at)?;
            let input_end = group_end(input, *position)?;
            let inner = &input[*position + 1usize..input_end];
            let mut nested = 0usize;
            if !matches(program, invocation, &pattern[at + 1usize..pattern_end], inner, &mut nested, path, bindings)? || nested != inner.len() { return Ok(false); }
            *position = input_end + 1usize; at = pattern_end + 1usize;
        } else {
            if !same(&pattern[at], &input[*position]) { return Ok(false); }
            at += 1usize; *position += 1usize;
        }
    }
    Ok(true)
}
fn root_name(program: &Program, definition: &MacroDefinition) -> String {
    let root = &program.scopes[program.scopes[definition.scope].crate_root].path;
    if root.is_empty() { "crate".to_string() } else { root.clone() }
}
fn projected(token: &MacroToken, invocation: &MacroInvocation, context: usize) -> MacroToken {
    let mut result = token.clone(); result.span = invocation.span; result.context = context; result
}
fn repeat_count(tokens: &[MacroToken], bindings: &[Binding], path: &[usize]) -> Result<usize, Diagnostic> {
    let mut count: Option<usize> = None;
    let mut at = 0usize;
    while at + 1usize < tokens.len() {
        if symbol(&tokens[at], "$") && tokens[at + 1usize].kind == 0u8 {
            let name = &tokens[at + 1usize].text;
            if let Some(binding) = bindings.iter().find(|binding| binding.name == *name) {
                if binding.depth > path.len() {
                    let mut repetitions = 0usize;
                    for (parent, length) in &binding.repetitions {
                        if parent.as_slice() == path { repetitions = *length; }
                    }
                    if count.is_some_and(|prior| prior != repetitions) {
                        return Err(error(tokens[at].span, "E_MACRO_EXPANSION", "repetition bindings have different lengths"));
                    }
                    count = Some(repetitions);
                }
            }
        }
        at += 1usize;
    }
    count.ok_or_else(|| error(tokens.first().map(|token| token.span).unwrap_or(Span::default()),
        "E_MACRO_EXPANSION", "repetition has no binding at this depth"))
}
fn transcribe(program: &Program, definition: &MacroDefinition, invocation: &MacroInvocation,
    template: &[MacroToken], bindings: &[Binding], path: &[usize], context: usize,
    output: &mut Vec<MacroToken>) -> Result<(), Diagnostic> {
    let mut at = 0usize;
    while at < template.len() {
        if symbol(&template[at], "$") {
            if at + 1usize < template.len() && symbol(&template[at + 1usize], "(") {
                let repeat = repetition(template, at)?;
                let count = repeat_count(&repeat.body, bindings, path)?;
                if count < repeat.minimum || repeat.optional && count > 1usize {
                    return Err(error(template[at].span, "E_MACRO_EXPANSION", "repetition cardinality does not match its operator"));
                }
                for index in 0usize..count {
                    if index != 0usize { if let Some(separator) = &repeat.separator { output.push(projected(separator, invocation, context)); } }
                    let mut nested = path.to_vec(); nested.push(index);
                    transcribe(program, definition, invocation, &repeat.body, bindings, &nested, context, output)?;
                }
                at = repeat.next;
                continue;
            }
            if at + 1usize >= template.len() || template[at + 1usize].kind != 0u8 {
                return Err(error(template[at].span, "E_MACRO_RULE", "expected a capture name after $"));
            }
            let name = &template[at + 1usize].text;
            if name == "crate" {
                let mut token = projected(&template[at + 1usize], invocation, 0usize); token.text = root_name(program, definition); output.push(token);
            } else {
                let binding = bindings.iter().find(|binding| binding.name == *name)
                    .ok_or_else(|| error(template[at + 1usize].span, "E_MACRO_RULE", "unknown expansion capture"))?;
                if binding.depth > path.len() { return Err(error(template[at].span, "E_MACRO_EXPANSION", "capture is still repeating at this depth")); }
                let wanted = &path[..binding.depth];
                let value = binding.values.iter().find(|value| value.path.as_slice() == wanted)
                    .ok_or_else(|| error(template[at].span, "E_MACRO_EXPANSION", "capture is missing at this repetition index"))?;
                for token in &value.tokens { output.push(token.clone()); }
            }
            at += 2usize;
        } else {
            if definition.local_inner && template[at].kind == 0u8 && at + 1usize < template.len() && symbol(&template[at + 1usize], "!")
                && (at == 0usize || !symbol(&template[at - 1usize], "::")) {
                let mut root = projected(&template[at], invocation, 0usize); root.text = root_name(program, definition); output.push(root);
                let mut separator = projected(&template[at], invocation, 0usize); separator.kind = 6u8; separator.text = "::".to_string(); output.push(separator);
            }
            output.push(projected(&template[at], invocation, context)); at += 1usize;
        }
    }
    Ok(())
}
pub(super) fn apply(program: &mut Program, definition: &MacroDefinition, rules: &[Rule],
    invocation: &MacroInvocation, context: usize) -> Result<Vec<MacroToken>, Diagnostic> {
    for rule in rules {
        let saved = checkpoint(program, invocation.parent);
        let mut bindings = rule.variables.clone();
        let mut at = 0usize;
        if matches(program, invocation, &rule.pattern, &invocation.tokens, &mut at, &[0usize; 0], &mut bindings)? && at == invocation.tokens.len() {
            let mut output = Vec::new();
            transcribe(program, definition, invocation, &rule.template, &bindings, &[0usize; 0], context, &mut output)?;
            return Ok(output);
        }
        rollback(program, saved);
    }
    Err(error(invocation.span, "E_MACRO_MATCH", "no declarative macro rule matches these tokens"))
}

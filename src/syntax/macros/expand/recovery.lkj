//! Recovery records the same depth-first refusals as strict expansion.
use super::*;
use crate::diagnostics::Recovery;

fn located(program: &Program, mut problem: Diagnostic) -> Diagnostic {
    if problem.path.is_empty() {
        if let Some(file) = program.files.get(problem.file) { problem.path = file.path.clone(); }
    }
    problem
}
fn record(diagnostics: &mut Vec<Diagnostic>, problem: Diagnostic) {
    if !diagnostics.contains(&problem) { diagnostics.push(problem); }
}
fn blocked(program: &Program, regions: &mut Vec<BlockedRegion>, span: Span, kind: &str, code: &str) {
    regions.push(BlockedRegion { path: program.files[span.file].path.clone(), span,
        kind: kind.to_string(), reason: format!("not analyzed after {code}") });
}
fn incomplete_recovery(problem: Diagnostic) -> Recovery {
    Recovery { span: Span::default(), scope: 0usize, block: None, kind: "source input".to_string(),
        names: Vec::new(), namespace: true, coherence: true, diagnostic: problem }
}

// A local textual definition can establish its own selection. Any intervening
// item producer or refused boundary could supply a competing definition.
fn local_selection(program: &Program, report: &ExpansionReport, invocation: &MacroInvocation,
    definition: &MacroDefinition) -> bool {
    if invocation.parent.is_some() || invocation.block.is_some() || invocation.name != definition.name
        || definition.exported || definition.scope != invocation.scope || invocation.scope != invocation.destination
        || definition.span.file != invocation.span.file || definition.span.end > invocation.span.start {
        return false;
    }
    let intervenes = |span: Span| span.file == invocation.span.file
        && definition.span.end <= span.start && span.start < invocation.span.start;
    !program.macro_invocations.iter().enumerate().any(|(id, other)| {
        other.parent.is_none() && other.position == MacroPosition::Item && intervenes(other.span)
            && !program.macro_expansions.iter().any(|expansion| expansion.invocation == id)
            && !report.recovery.iter().any(|failure| bounded_call(failure) && failure.span == other.span)
    })
        && !program.modules.iter().any(|module| program.macro_use_modules.contains(&module.scope)
            && intervenes(module.span))
        && !report.recovery.iter().any(|failure| failure.span.file == invocation.span.file
            && failure.span.start < invocation.span.end && definition.span.start < failure.span.end
            && !bounded_call(failure))
}

fn bounded_call(failure: &Recovery) -> bool {
    failure.kind == "macro invocation" && !failure.coherence
}

// Only complete sequences of plain function declarations have this footprint.
// Examine every token, including bodies and const arguments: a block-local
// impl still contributes to coherence. Opaque captures can conceal producers.
pub(super) fn function_footprint(program: &Program, report: &ExpansionReport, invocation: &MacroInvocation,
    definition: &MacroDefinition, tokens: &[MacroToken]) -> Option<Vec<String>> {
    if tokens.is_empty() || !local_selection(program, report, invocation, definition) { return None; }
    for (index, token) in tokens.iter().enumerate() {
        if token.capture.is_some() || token.kind == 0u8 && matches!(token.text.as_str(),
            "impl" | "mod" | "extern" | "macro" | "macro_rules")
            || token.kind == 6u8 && matches!(token.text.as_str(), "#" | "$")
            || symbol(token, "!") && index > 0usize && tokens[index - 1usize].kind == 0u8 {
            return None;
        }
    }
    let mut names = Vec::new();
    let mut at = 0usize;
    while at < tokens.len() {
        if keyword(tokens.get(at), "pub") { at += 1usize; }
        if !keyword(tokens.get(at), "fn") { return None; }
        let name = tokens.get(at + 1usize)?;
        if name.kind != 0u8 || !recovery_binding_name(&name.text) { return None; }
        at += 2usize;
        let start = tokens.get(at)?;
        if !symbol(start, "(") && !symbol(start, "<") { return None; }
        let mut parameters = false;
        loop {
            let token = tokens.get(at)?;
            if symbol(token, "{") {
                if !parameters { return None; }
                at = group_end(tokens, at).ok()? + 1usize;
                break;
            }
            if token.kind == 6u8 && (closing(&token.text) || matches!(token.text.as_str(), ";" | "="))
                || token.kind == 0u8 && matches!(token.text.as_str(),
                    "fn" | "pub" | "const" | "static" | "struct" | "enum" | "union" | "trait" | "type" | "use") {
                return None;
            }
            if token.kind == 6u8 && opening(&token.text) {
                if symbol(token, "(") { parameters = true; }
                at = group_end(tokens, at).ok()?;
            }
            at += 1usize;
        }
        if !names.contains(&name.text) { names.push(name.text.clone()); }
    }
    Some(names)
}

fn keyword(token: Option<&MacroToken>, text: &str) -> bool {
    token.is_some_and(|token| token.kind == 0u8 && token.text == text)
}

pub(super) fn refused_call(report: &mut ExpansionReport, program: &Program, call: usize,
    problem: Diagnostic, footprint: Option<Vec<String>>) -> Result<(), Diagnostic> {
    let problem = located(program, problem);
    let Some(invocation) = program.macro_invocations.get(call) else { return Err(problem); };
    record(&mut report.diagnostics, problem.clone());
    let kind = if invocation.position == MacroPosition::Item { "item" } else { "statement" };
    blocked(program, &mut report.blocked, invocation.span, kind, &problem.code);
    let mut authored = call;
    while let Some(parent) = program.macro_invocations[authored].parent {
        authored = program.macro_expansions[parent].invocation;
    }
    let owner = &program.macro_invocations[authored];
    let coherence = footprint.is_none();
    report.recovery.push(Recovery { span: owner.span, scope: owner.destination, block: owner.block,
        kind: "macro invocation".to_string(), names: footprint.unwrap_or(Vec::new()),
        namespace: owner.position != MacroPosition::Expression, coherence,
        diagnostic: problem });
    Ok(())
}
pub(super) fn run(program: &mut Program, mut report: ExpansionReport) -> ExpansionReport {
    let mut rules: Vec<Vec<matcher::Rule>> = Vec::new();
    let mut invalid: BTreeMap<usize, Diagnostic> = BTreeMap::new();
    let mut exports: BTreeMap<(usize, String), usize> = BTreeMap::new();
    for (id, definition) in program.macro_definitions.iter().enumerate() {
        if definition.exported {
            let key = (program.scopes[definition.scope].crate_root, definition.name.clone());
            if exports.contains_key(&key) {
                let previous = *exports.get(&key).unwrap();
                let problem = error(definition.name_span, "E_MACRO_RULE", "duplicate exported macro name");
                invalid.insert(previous, problem.clone()); invalid.insert(id, problem.clone());
                blocked(program, &mut report.blocked, definition.span, "item", &problem.code);
                record(&mut report.diagnostics, located(program, problem));
            } else { exports.insert(key, id); }
        }
        match matcher::rules(definition) {
            Ok(value) => rules.push(value),
            Err(problem) => {
                rules.push(Vec::new()); invalid.insert(id, problem.clone());
                blocked(program, &mut report.blocked, definition.span, "item", &problem.code);
                record(&mut report.diagnostics, located(program, problem));
            }
        }
    }
    // The traversal still selects an invalid definition normally and records
    // every refused consumer. A definition alone introduces only a macro name.
    for (id, problem) in &invalid {
        let def = &program.macro_definitions[*id];
        report.recovery.push(Recovery { span: def.span, scope: def.scope, block: None,
            kind: "macro definition".to_string(), names: vec![def.name.clone()],
            namespace: false, coherence: false, diagnostic: located(program, problem.clone()) });
    }
    let mut expander = Expander::new(rules, invalid, Some(report));
    let result = expander.program(program);
    let mut report = expander.report.take().unwrap();
    if let Err(problem) = result {
        let problem = located(program, problem);
        record(&mut report.diagnostics, problem.clone());
        report.recovery.push(incomplete_recovery(problem));
    }
    program.macros_expanded = report.diagnostics.is_empty();
    report
}

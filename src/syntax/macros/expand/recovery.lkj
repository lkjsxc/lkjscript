//! Reporting retries the shared traversal from source after each failed call.
//! Every retry discards all arenas and traversal state; partial trees never resolve.
use super::*;

fn record(program: &Program, diagnostics: &mut Vec<Diagnostic>, mut problem: Diagnostic) {
    if problem.path.is_empty() {
        if let Some(file) = program.files.get(problem.file) { problem.path = file.path.clone(); }
    }
    if !diagnostics.contains(&problem) { diagnostics.push(problem); }
}
fn blocked(program: &Program, regions: &mut Vec<BlockedRegion>, span: Span, kind: &str, code: &str) {
    regions.push(BlockedRegion { path: program.files[span.file].path.clone(), span,
        kind: kind.to_string(), reason: format!("not analyzed after {code}") });
}
pub(super) fn run(program: &mut Program, first: Diagnostic) -> (Vec<Diagnostic>, Vec<BlockedRegion>) {
    let input = program.clone();
    let mut source = input.clone();
    source.macro_input = Some(Box::new(input));
    let mut diagnostics = Vec::new();
    let mut regions = Vec::new();
    record(&source, &mut diagnostics, first);
    let mut rules: Vec<Vec<matcher::Rule>> = Vec::new();
    let mut invalid: BTreeMap<usize, Diagnostic> = BTreeMap::new();
    let mut exports: BTreeMap<(usize, String), usize> = BTreeMap::new();
    for (id, definition) in source.macro_definitions.iter().enumerate() {
        if definition.exported {
            let key = (source.scopes[definition.scope].crate_root, definition.name.clone());
            if exports.contains_key(&key) {
                let previous = *exports.get(&key).unwrap();
                let problem = error(definition.name_span, "E_MACRO_RULE", "duplicate exported macro name");
                invalid.insert(previous, problem.clone()); invalid.insert(id, problem.clone());
                blocked(&source, &mut regions, definition.span, "item", &problem.code);
                record(&source, &mut diagnostics, problem);
            } else { exports.insert(key, id); }
        }
        match matcher::rules(definition) {
            Ok(value) => rules.push(value),
            Err(problem) => {
                rules.push(Vec::new()); invalid.insert(id, problem.clone());
                blocked(&source, &mut regions, definition.span, "item", &problem.code);
                record(&source, &mut diagnostics, problem);
            }
        }
    }
    let mut failed: BTreeSet<usize> = BTreeSet::new();
    loop {
        *program = source.clone();
        let mut expander = Expander::new(rules.clone(), invalid.clone(), failed.clone());
        match expander.program(program) {
            Ok(()) => break,
            Err(problem) => {
                // The completed depth-first prefix fixes invocation IDs on every retry.
                // Skip only the failed leaf: successful generated parents and independent
                // siblings must remain available for the next diagnostic.
                let call = expander.active.last().copied();
                record(program, &mut diagnostics, problem.clone());
                let Some(call) = call else { break; };
                let Some(invocation) = program.macro_invocations.get(call) else { break; };
                if !failed.insert(call) { break; }
                let kind = if invocation.position == MacroPosition::Item { "item" } else { "statement" };
                blocked(program, &mut regions, invocation.span, kind, &problem.code);
            }
        }
    }
    program.macros_expanded = false;
    (diagnostics, regions)
}

//! Expansion keeps authored fragments and generated syntax in distinct provenance tables.
mod recovery;
mod walk;
use super::*;
use std::collections::BTreeMap;

fn before(left: Span, right: Span) -> bool { left.file == right.file && left.start < right.start }
fn module_index(program: &Program, scope: usize) -> Option<usize> {
    program.modules.iter().position(|module| module.scope == scope)
}
fn visible(program: &Program, scope: usize, cutoff: Span, name: &str) -> Option<usize> {
    let mut selected: Option<(usize, usize)> = None;
    for (id, definition) in program.macro_definitions.iter().enumerate() {
        if definition.scope == scope && definition.name == name && before(definition.span, cutoff)
            && selected.is_none_or(|(_, position)| definition.span.start > position) {
            selected = Some((id, definition.span.start));
        }
    }
    for module in &program.modules {
        if program.scopes[module.scope].parent == Some(scope) && program.macro_use_modules.contains(&module.scope)
            && before(module.span, cutoff) {
            let file = program.loaded_modules.iter().find(|loaded| loaded.scope == module.scope)
                .map(|loaded| loaded.file).unwrap_or(module.span.file);
            let end = Span { file, start: 18446744073709551615usize, end: 18446744073709551615usize, ..module.span };
            if let Some(id) = visible(program, module.scope, end, name) {
                if selected.is_none_or(|(_, position)| module.span.start > position) { selected = Some((id, module.span.start)); }
            }
        }
    }
    selected.map(|(id, _)| id)
}
fn exported(program: &Program, root: ModuleId, name: &str) -> Option<usize> {
    program.macro_definitions.iter().position(|definition| definition.exported
        && definition.name == name && program.scopes[definition.scope].crate_root == root)
}
fn alias_shadowed(program: &Program, invocation: &MacroInvocation, alias: &str) -> bool {
    let mut scope = invocation.scope;
    loop {
        let module = &program.scopes[scope];
        if program.modules.iter().any(|child| child.name == alias && program.scopes[child.scope].parent == Some(scope))
            || program.structs.iter().any(|item| item.module == module.path && item.name == alias)
            || program.enums.iter().any(|item| item.module == module.path && item.name == alias)
            || program.traits.iter().any(|item| item.module == module.path && item.name == alias)
            || program.aliases.iter().any(|item| item.module == module.path && item.name == alias)
            || program.uses.iter().any(|import| import.module == module.path && (import.glob || import.alias == alias)) {
            return true;
        }
        let Some(parent) = module.parent else { return false; };
        scope = parent;
    }
}
fn resolve(program: &Program, invocation: &MacroInvocation) -> Result<usize, Diagnostic> {
    let crate_root = program.scopes[invocation.scope].crate_root;
    let mut root = crate_root;
    let mut name = invocation.name.as_str();
    let qualified = name.contains("::");
    if qualified {
        let split = name.rfind("::").unwrap();
        let prefix = &name[..split]; name = &name[split + 2usize..];
        if prefix != "crate" && prefix != program.scopes[crate_root].path {
            let absolute = prefix.starts_with("::");
            let alias = if absolute { &prefix[2usize..] } else { prefix };
            let provider = if crate_root == 0 {
                program.macro_providers.iter().find(|provider| provider.input.alias == alias)
                    .and_then(|provider| provider.root)
            } else { None };
            if let Some(provider) = provider {
                if !absolute && alias_shadowed(program, invocation, alias) {
                    return Err(error(invocation.span, "E_MACRO_PROVIDER",
                        "relative macro provider alias may be shadowed; use the absolute alias"));
                }
                root = provider;
            } else {
                root = program.scopes.iter().position(|scope| scope.parent.is_none() && scope.path == prefix)
                    .ok_or_else(|| error(invocation.span, "E_UNSUPPORTED_MACRO", "macro path must name an exported macro in a source crate"))?;
            }
        }
    } else {
        let mut scope = invocation.scope;
        let mut cutoff = invocation.span;
        loop {
            if let Some(id) = visible(program, scope, cutoff, name) { return Ok(id); }
            match program.scopes[scope].parent {
                Some(parent) => {
                    if let Some(module) = module_index(program, scope) { cutoff = program.modules[module].span; }
                    scope = parent;
                }
                None => break,
            }
        }
    }
    if let Some(id) = exported(program, root, name) { return Ok(id); }
    if !qualified && crate_root == 0 {
        let mut selected: Option<(usize, usize)> = None;
        for provider in &program.macro_providers {
            if let (Some(root), Some(span)) = (provider.root, provider.declaration) {
                if let Some(id) = exported(program, root, name) {
                    if selected.is_none_or(|(_, start)| start < span.start) {
                        selected = Some((id, span.start));
                    }
                }
            }
        }
        if let Some((id, _)) = selected { return Ok(id); }
    }
    Err(error(invocation.span, "E_UNSUPPORTED_MACRO", &format!("unsupported macro: {}!; no visible declarative definition", invocation.name)))
}
fn fingerprint(tokens: &[MacroToken]) -> String {
    let mut result = String::new();
    for token in tokens {
        result.push_str(&format!("{}:{}:{}:{}:{};", token.kind, token.text.len(), token.text, token.literal_spelling.len(), token.literal_spelling));
        if token.capture.is_some() { result.push_str(&format!("{}:{}:{};", token.origin.file, token.origin.start, token.origin.end)); }
    }
    result
}
struct Expander {
    rules: Vec<Vec<matcher::Rule>>,
    invalid_rules: BTreeMap<usize, Diagnostic>,
    expressions: BTreeMap<usize, usize>,
    visited: BTreeSet<(usize, usize)>,
    failed: BTreeSet<usize>,
    report: Option<ExpansionReport>,
}
impl Expander {
    fn new(rules: Vec<Vec<matcher::Rule>>, invalid_rules: BTreeMap<usize, Diagnostic>,
        report: Option<ExpansionReport>) -> Self {
        Self { rules, invalid_rules, expressions: BTreeMap::new(), visited: BTreeSet::new(),
            failed: BTreeSet::new(), report }
    }
    fn attempt(&mut self, program: &Program) -> Option<ParseCheckpoint> {
        let report = self.report.as_mut()?;
        report.attempts += 1usize;
        Some(ParseCheckpoint::new(program))
    }
    fn prepared<T>(&mut self, program: &mut Program, call: usize, saved: Option<ParseCheckpoint>,
        result: Result<T, Diagnostic>) -> Result<Option<T>, Diagnostic> {
        match result {
            Ok(value) => {
                discard_suffix(&mut program.macro_parse_writes, 0usize);
                Ok(Some(value))
            }
            Err(problem) => {
                let Some(saved) = saved else { return Err(problem); };
                // Each invocation prepares its own syntax before walking any
                // child. Roll back failed preparation without touching the
                // completed prefix or renumbering surviving descendants.
                saved.rollback(program);
                recovery::refused_call(self.report.as_mut().unwrap(), program, call, problem)?;
                self.failed.insert(call);
                Ok(None)
            }
        }
    }
    fn invocation(&self, program: &Program, call: usize) -> Result<MacroInvocation, Diagnostic> {
        let invocation = program.macro_invocations.get(call).cloned()
            .ok_or_else(|| error(Span::default(), "E_MACRO_EXPANSION", "macro invocation is absent"))?;
        if invocation.scope >= program.scopes.len() || invocation.destination >= program.scopes.len() {
            return Err(error(invocation.span, "E_MACRO_EXPANSION", "macro destination scope is absent"));
        }
        Ok(invocation)
    }
    fn begin(&self, program: &mut Program, call: usize, invocation: &MacroInvocation) -> Result<(Vec<MacroToken>, usize), Diagnostic> {
        let definition = resolve(program, invocation)?;
        if let Some(problem) = self.invalid_rules.get(&definition) { return Err(problem.clone()); }
        let key = fingerprint(&invocation.tokens);
        let mut ancestor = invocation.parent;
        while let Some(id) = ancestor {
            let expansion = &program.macro_expansions[id];
            let prior = &program.macro_invocations[expansion.invocation];
            if expansion.definition == definition && fingerprint(&prior.tokens) == key {
                return Err(error(invocation.span, "E_MACRO_RECURSION", "declarative expansion repeats an active invocation"));
            }
            ancestor = expansion.parent;
        }
        let expansion = program.macro_expansions.len();
        let context = match expansion.checked_add(1usize) { Some(context) => context,
            None => return Err(error(invocation.span, "E_MACRO_EXPANSION", "macro syntax context is not representable")) };
        let start = crate::ast::macros::inventory(program);
        program.macro_expansions.push(MacroExpansion { start: start.clone(), end: start, definition, invocation: call, context,
            parent: invocation.parent, rule: 0usize, splice: None, types: Vec::new(), expressions: Vec::new(), patterns: Vec::new(),
            functions: Vec::new(), implementations: Vec::new(), items: Vec::new() });
        let declaration = program.macro_definitions[definition].clone();
        let (tokens, rule) = matcher::apply(program, &declaration, &self.rules[definition], invocation, context)?;
        program.macro_expansions[expansion].rule = rule;
        Ok((tokens, expansion))
    }
    fn parse_expression(&self, program: &mut Program, call: usize) -> Result<usize, Diagnostic> {
        let invocation = self.invocation(program, call)?;
        if invocation.position != MacroPosition::Expression { return Err(error(invocation.span, "E_MACRO_EXPANSION", "macro invocation is not an expression")); }
        let (tokens, expansion) = self.begin(program, call, &invocation)?;
        let (id, _) = super::expression(program, &tokens, &invocation, Some(expansion), true)?;
        let end = crate::ast::macros::inventory(program);
        program.macro_expansions[expansion].end = end;
        Ok(id)
    }
    fn expression(&mut self, program: &mut Program, call: usize) -> Result<Option<usize>, Diagnostic> {
        if self.failed.contains(&call) { return Ok(None); }
        if let Some(id) = self.expressions.get(&call) { return Ok(Some(*id)); }
        let saved = self.attempt(program);
        let parsed = self.parse_expression(program, call);
        let Some(id) = self.prepared(program, call, saved, parsed)? else { return Ok(None); };
        self.expression_node(program, id)?;
        self.expressions.insert(call, id);
        Ok(Some(id))
    }
    fn parse_item(&self, program: &mut Program, call: usize) -> Result<Vec<Item>, Diagnostic> {
        let invocation = self.invocation(program, call)?;
        if invocation.position != MacroPosition::Item { return Err(error(invocation.span, "E_MACRO_EXPANSION", "macro invocation is not an item")); }
        let (tokens, expansion) = self.begin(program, call, &invocation)?;
        let expanded = super::items(program, &tokens, &invocation, expansion)?;
        let end = crate::ast::macros::inventory(program);
        program.macro_expansions[expansion].end = end;
        for item in &expanded {
            if let Item::Module(id) = item {
                if program.modules[*id].external { return Err(error(invocation.span,
                    "E_UNSUPPORTED_MACRO", "macro expansion cannot discover an external source module")); }
            }
        }
        Ok(expanded)
    }
    fn items(&mut self, program: &mut Program, input: Vec<Item>) -> Result<Vec<Item>, Diagnostic> {
        let mut output = Vec::new();
        for item in input {
            if let Item::MacroInvocation(call) = item {
                if self.failed.contains(&call) { output.push(item); continue; }
                let saved = self.attempt(program);
                let parsed = self.parse_item(program, call);
                if let Some(items) = self.prepared(program, call, saved, parsed)? {
                    for item in self.items(program, items)? { output.push(item); }
                } else { output.push(item); }
            } else { self.item_node(program, item)?; output.push(item); }
        }
        Ok(output)
    }
}
fn remember_input(program: &mut Program) {
    if !program.macros_expanded && (!program.macro_definitions.is_empty() || !program.macro_invocations.is_empty()
        || !program.macro_providers.is_empty())
        && program.macro_input.is_none() {
        let mut input = program.clone(); input.macro_input = None;
        program.macro_input = Some(Box::new(input));
    }
}
pub(super) fn run(program: &mut Program) -> Result<(), Diagnostic> {
    remember_input(program);
    replay(program)
}
pub(super) fn replay(program: &mut Program) -> Result<(), Diagnostic> {
    if program.macros_expanded { return Ok(()); }
    if program.macro_definitions.is_empty() && program.macro_invocations.is_empty() { program.macros_expanded = true; return Ok(()); }
    let mut rules = Vec::new();
    let mut exports: BTreeSet<(usize, String)> = BTreeSet::new();
    for definition in &program.macro_definitions {
        if definition.exported && !exports.insert((program.scopes[definition.scope].crate_root, definition.name.clone())) {
            return Err(error(definition.name_span, "E_MACRO_RULE", "duplicate exported macro name"));
        }
        rules.push(matcher::rules(definition)?);
    }
    let mut expander = Expander::new(rules, BTreeMap::new(), None);
    expander.program(program)?;
    program.macros_expanded = true;
    Ok(())
}

/// Successful source loading uses the same expansion and provenance as replay.
/// Only a refused input pays for isolated diagnostic recovery.
pub(super) fn report(program: &mut Program) -> ExpansionReport {
    if program.macros_expanded { return ExpansionReport::default(); }
    remember_input(program);
    if program.macro_definitions.is_empty() && program.macro_invocations.is_empty() {
        program.macros_expanded = true;
        return ExpansionReport::default();
    }
    recovery::run(program)
}

//! Token-tree expansion is an untrusted source producer. Captures retain syntax context.
mod matcher;
mod expand;
pub(crate) mod provenance;
use super::{FormatOrigin, Parser, Token, TokenKind};
use crate::ast::*;
use crate::diagnostics::{BlockedRegion, Recovery};
use std::collections::BTreeSet;

/// State appended or materialized by a speculative syntax parse.
pub(super) struct ParseCheckpoint {
    inventory: MacroInventory,
    expansions: usize,
    writes: usize,
}

// These arenas own inert syntax and provenance records. Removing a suffix
// preserves the prefix storage and needs no forward destructor order.
fn discard_suffix<T>(values: &mut Vec<T>, length: usize) {
    while values.len() > length { values.pop(); }
}

impl ParseCheckpoint {
    pub(super) fn new(program: &Program) -> Self {
        Self { inventory: crate::ast::macros::inventory(program),
            expansions: program.macro_expansions.len(), writes: program.macro_parse_writes.len() }
    }

    pub(super) fn rollback(self, program: &mut Program) {
        use crate::ast::macros::MacroParseWrite;
        // Undo appends to existing provenance records before truncating the
        // speculative arena suffix. Nested matcher probes share these writes.
        while program.macro_parse_writes.len() > self.writes {
            match program.macro_parse_writes.pop().unwrap() {
                MacroParseWrite::CaptureExpression(id, prior) => {
                    program.macro_captures[id].expression = prior;
                    program.macro_captures[id].materializations.pop();
                }
                MacroParseWrite::CaptureType(id, prior) => {
                    program.macro_captures[id].ty = prior;
                    program.macro_captures[id].type_materializations.pop();
                }
                MacroParseWrite::OriginType(id) => { program.macro_expansions[id].types.pop(); }
                MacroParseWrite::OriginExpression(id) => { program.macro_expansions[id].expressions.pop(); }
                MacroParseWrite::OriginPattern(id) => { program.macro_expansions[id].patterns.pop(); }
            }
        }
        let counts = self.inventory;
        for id in counts.types..program.types.len() {
            program.impl_traits.remove(&id); program.constant_arguments.remove(&id);
            program.value_argument_lists.remove(&id); program.array_length_spans.remove(&id); program.relaxed_bounds.remove(&id);
            program.array_length_constants.remove(&id);
        }
        for id in counts.patterns..program.patterns.len() { program.macro_pattern_bindings.remove(&id); }
        for id in counts.scopes..program.scopes.len() { program.macro_use_modules.remove(&id); }
        discard_suffix(&mut program.types, counts.types);
        discard_suffix(&mut program.exprs, counts.exprs);
        discard_suffix(&mut program.patterns, counts.patterns);
        discard_suffix(&mut program.blocks, counts.blocks);
        discard_suffix(&mut program.functions, counts.functions);
        discard_suffix(&mut program.structs, counts.structs);
        discard_suffix(&mut program.enums, counts.enums);
        discard_suffix(&mut program.traits, counts.traits);
        discard_suffix(&mut program.impls, counts.impls);
        discard_suffix(&mut program.uses, counts.uses);
        discard_suffix(&mut program.modules, counts.modules);
        discard_suffix(&mut program.aliases, counts.aliases);
        discard_suffix(&mut program.constants, counts.constants);
        discard_suffix(&mut program.scopes, counts.scopes);
        discard_suffix(&mut program.attrs, counts.attrs);
        discard_suffix(&mut program.macro_definitions, counts.macro_definitions);
        discard_suffix(&mut program.macro_identifier_uses, counts.identifier_uses);
        discard_suffix(&mut program.macro_invocations, counts.macro_invocations);
        discard_suffix(&mut program.macro_captures, counts.macro_captures);
        discard_suffix(&mut program.macro_expansions, self.expansions);
    }
}

fn error(span: Span, code: &str, message: &str) -> Diagnostic {
    Diagnostic::new(span, code, message)
}
fn opening(text: &str) -> bool { text == "(" || text == "[" || text == "{" }
fn closing(text: &str) -> bool { text == ")" || text == "]" || text == "}" }
pub(crate) fn builtin_macro(name: &str) -> bool {
    matches!(name, "assert" | "assert_eq" | "assert_ne" | "panic" | "vec" | "format" | "format_args" | "concat"
        | "write" | "writeln" | "matches" | "cfg" | "unreachable" | "debug_assert" | "debug_assert_eq"
        | "debug_assert_ne" | "include_str" | "include_bytes" | "module_path" | "file" | "line" | "print" | "println" | "eprint" | "eprintln")
}
fn partner(text: &str) -> String {
    match text { "(" => ")".to_string(), "[" => "]".to_string(), "{" => "}".to_string(), _ => String::new() }
}
const BLOCK_FRAGMENT: u8 = 10u8;

fn token_kind(kind: &TokenKind) -> u8 {
    match kind {
        TokenKind::Ident => 0u8, TokenKind::Number => 1u8, TokenKind::String => 2u8,
        TokenKind::Char => 3u8, TokenKind::Bytes => 4u8, TokenKind::Lifetime => 5u8,
        TokenKind::Symbol => 6u8, TokenKind::End => 7u8, TokenKind::Expression(_) => 8u8,
        TokenKind::Type(_) => 9u8, TokenKind::Block(_) => BLOCK_FRAGMENT,
    }
}
fn capture_token(token: &Token) -> MacroToken {
    MacroToken { kind: token_kind(&token.kind), text: token.text.clone(), literal_spelling: token.literal_spelling.clone(), span: token.span,
        origin: token.origin, context: token.context,
        capture: match token.kind { TokenKind::Expression(id) | TokenKind::Type(id) | TokenKind::Block(id) => Some(id), _ => None } }
}
fn restore_token(token: MacroToken) -> Token {
    let kind = match token.kind {
        0u8 => TokenKind::Ident, 1u8 => TokenKind::Number, 2u8 => TokenKind::String,
        3u8 => TokenKind::Char, 4u8 => TokenKind::Bytes, 5u8 => TokenKind::Lifetime,
        6u8 => TokenKind::Symbol, 8u8 => TokenKind::Expression(token.capture.unwrap()),
        9u8 => TokenKind::Type(token.capture.unwrap()),
        kind if kind == BLOCK_FRAGMENT => TokenKind::Block(token.capture.unwrap()),
        _ => TokenKind::End,
    };
    Token { kind, text: token.text, literal_spelling: token.literal_spelling, span: token.span, origin: token.origin, context: token.context }
}
fn symbol(token: &MacroToken, text: &str) -> bool { token.kind == 6u8 && token.text == text }
fn group_end(tokens: &[MacroToken], start: usize) -> Result<usize, Diagnostic> {
    if start >= tokens.len() || tokens[start].kind != 6u8 || !opening(&tokens[start].text) {
        return Err(error(tokens.get(start).map(|token| token.span).unwrap_or(Span::default()),
            "E_MACRO_RULE", "expected a delimited token tree"));
    }
    let mut stack = vec![partner(&tokens[start].text).to_string()];
    let mut at = start + 1usize;
    while at < tokens.len() {
        if tokens[at].kind == 6u8 {
            if opening(&tokens[at].text) { stack.push(partner(&tokens[at].text).to_string()); }
            else if closing(&tokens[at].text) {
                if stack.last().unwrap() != &tokens[at].text {
                    return Err(error(tokens[at].span, "E_MACRO_RULE", "mismatched token-tree delimiter"));
                }
                stack.pop();
                if stack.is_empty() { return Ok(at); }
            }
        }
        at += 1usize;
    }
    Err(error(tokens[start].span, "E_MACRO_RULE", "unclosed token-tree delimiter"))
}
impl Parser {
    /// Presentation uses the expansion destination, never a token's lookup context.
    /// Internal crate roots remain unchanged for resolution and exact origin replay.
    pub(super) fn module_path_value(&self, span: Span) -> Result<String, Diagnostic> {
        let scope = self.program.scopes.get(self.scope)
            .ok_or_else(|| error(span, "E_PARSE", "module_path! has no destination module"))?;
        let root = self.program.scopes.get(scope.crate_root)
            .ok_or_else(|| error(span, "E_PARSE", "module_path! has no destination crate"))?;
        let name = if let Some(provider) = self.program.macro_providers.iter()
            .find(|provider| provider.root == Some(scope.crate_root)) {
            provider.input.name.clone()
        } else if root.path == "$std" {
            "std".to_string()
        } else {
            let file = if let Some(loaded) = self.program.loaded_modules.iter()
                .find(|loaded| loaded.scope == scope.crate_root) { loaded.file }
            else { self.program.files.iter().position(|file| file.crate_root == scope.crate_root)
                .ok_or_else(|| error(span, "E_PARSE", "module_path! has no crate source"))? };
            let file = self.program.files.get(file)
                .ok_or_else(|| error(span, "E_PARSE", "module_path! crate source is absent"))?;
            let path = file.path.as_str();
            if path == "<source>" { "source".to_string() } else {
                let base = match path.rfind('/') { Some(at) => &path[at + 1usize..], None => path };
                let stem = match base.rfind('.') { Some(at) => &base[..at], None => base };
                stem.replace("-", "_")
            }
        };
        let relative = if root.path.is_empty() { scope.path.as_str() }
            else if scope.path == root.path { "" }
            else {
                let prefix = format!("{}::", root.path);
                if !scope.path.starts_with(&prefix) {
                    return Err(error(span, "E_PARSE", "module_path! destination is outside its crate"));
                }
                &scope.path[prefix.len()..]
            };
        Ok(if relative.is_empty() { name } else { format!("{name}::{relative}") })
    }
    pub(super) fn macro_provider_declaration(&mut self, attrs: &[Attribute], public: &Visibility)
        -> Result<bool, Diagnostic> {
        if !attrs.iter().any(|attribute| attribute.name == "macro_use")
            || !self.tokens.get(self.at + 1usize).is_some_and(|token| token.text == "crate") {
            return Ok(false);
        }
        let index = match self.tokens.get(self.at + 2usize) {
            Some(name) => self.program.macro_providers.iter().position(|provider| provider.input.name == name.text),
            None => None,
        };
        let Some(index) = index else { return Ok(false); };
        let span = self.token().span;
        if self.fragment || !matches!(public, Visibility::Private)
            || attrs.iter().any(|attribute| attribute.name == "macro_use" && !attribute.args.is_empty()) {
            return Err(error(span, "E_MACRO_PROVIDER", "expected an authored #[macro_use] extern crate declaration"));
        }
        self.expect("extern")?;
        self.expect("crate")?;
        let name = self.ident()?;
        let alias = if self.take("as") { self.ident()? } else { name };
        // Leave the recovery boundary at the semicolon for a bad binding.
        let provider = &self.program.macro_providers[index];
        if provider.input.alias != alias {
            return Err(error(span, "E_MACRO_PROVIDER", "extern crate alias differs from the selected macro provider alias"));
        }
        if provider.declaration.is_some() {
            return Err(error(span, "E_MACRO_PROVIDER", "duplicate macro provider declaration"));
        }
        self.expect(";")?;
        self.program.macro_providers[index].declaration = Some(self.finish_span(span));
        Ok(true)
    }

    pub(super) fn macro_statement_ahead(&self) -> Result<Option<(bool, bool)>, Diagnostic> {
        if !self.macro_item_ahead() { return Ok(None); }
        let mut at = self.at;
        let mut name = String::new();
        while at < self.tokens.len() && self.tokens[at].text != "!" {
            name.push_str(&self.tokens[at].text); at += 1usize;
        }
        if name == "macro_rules" || builtin_macro(&name) {
            return Ok(None);
        }
        at += 1usize;
        if at >= self.tokens.len() || !opening(&self.tokens[at].text) { return Ok(None); }
        let braces = self.tokens[at].text == "{";
        let mut stack = vec![partner(&self.tokens[at].text)];
        at += 1usize;
        while at < self.tokens.len() && self.tokens[at].kind != TokenKind::End {
            let token = &self.tokens[at];
            if token.kind == TokenKind::Symbol {
                if opening(&token.text) { stack.push(partner(&token.text)); }
                else if closing(&token.text) {
                    if stack.last() != Some(&token.text) { return Err(error(token.span, "E_MACRO_RULE", "mismatched token-tree delimiter")); }
                    stack.pop();
                    if stack.is_empty() {
                        let Some(next) = self.tokens.get(at + 1usize) else { return Ok(None); };
                        let semicolon = next.kind == TokenKind::Symbol && next.text == ";";
                        if semicolon || next.kind == TokenKind::End || (braces && next.text != "." && next.text != "?") {
                            return Ok(Some((semicolon, braces)));
                        }
                        return Ok(None);
                    }
                }
            }
            at += 1usize;
        }
        Ok(None)
    }
    fn record_macro_identifiers(&mut self) {
        if self.probing { return; }
        for at in 0usize..self.at {
            let token = &self.tokens[at];
            if token.kind == TokenKind::Ident && token.context == 0usize && token.span == token.origin
                && !self.macro_carriers.iter().any(|(start, end)| *start <= at && at < *end) {
                self.program.macro_identifier_uses.push(token.origin);
            }
        }
    }
    pub(super) fn macro_item_ahead(&self) -> bool {
        let mut at = self.at;
        if self.tokens[at].kind == TokenKind::Symbol && self.tokens[at].text == "::" { at += 1usize; }
        if self.tokens[at].kind != TokenKind::Ident { return false; }
        loop {
            at += 1usize;
            if self.tokens[at].kind != TokenKind::Symbol { return false; }
            if self.tokens[at].text == "!" { return true; }
            if self.tokens[at].text != "::" { return false; }
            at += 1usize;
            if self.tokens[at].kind != TokenKind::Ident { return false; }
        }
    }
    pub(super) fn macro_terminator(&mut self, braces: bool) -> Result<(), Diagnostic> {
        if self.token().kind == TokenKind::Symbol && self.take(";") { return Ok(()); }
        if braces { return Ok(()); }
        Err(self.err("parenthesized or bracketed macro items require a semicolon"))
    }
    fn macro_tree(&mut self) -> Result<Vec<MacroToken>, Diagnostic> {
        if self.token().kind != TokenKind::Symbol || !opening(&self.token().text) { return Err(self.err("expected macro delimiter")); }
        let start = self.token().span;
        let carrier = self.at + 1usize;
        let mut stack = vec![partner(&self.token().text).to_string()];
        self.at += 1usize;
        let mut tokens = Vec::new();
        while self.tokens[self.at].kind != TokenKind::End {
            let token = self.tokens[self.at].clone();
            if token.kind == TokenKind::Symbol {
                if opening(&token.text) { stack.push(partner(&token.text)); }
                else if closing(&token.text) {
                    if stack.last().unwrap() != &token.text {
                        return Err(error(token.span, "E_MACRO_RULE", "mismatched token-tree delimiter"));
                    }
                    stack.pop();
                    if stack.is_empty() { self.macro_carriers.push((carrier, self.at)); self.at += 1usize; return Ok(tokens); }
                }
            }
            tokens.push(capture_token(&token));
            self.at += 1usize;
        }
        Err(error(start, "E_MACRO_RULE", "unclosed macro token tree"))
    }
    pub(super) fn macro_definition(&mut self, attrs: &[Attribute], public: &Visibility) -> Result<(), Diagnostic> {
        let span = self.token().span;
        if self.expansion.is_some() || self.fragment {
            return Err(error(span, "E_UNSUPPORTED_MACRO", "generated macro definitions are not supported"));
        }
        if !matches!(public, Visibility::Private) {
            return Err(error(span, "E_MACRO_RULE", "macro_rules visibility uses macro_export"));
        }
        self.expect("macro_rules")?;
        if self.token().kind != TokenKind::Symbol { return Err(self.err("expected ! after macro_rules")); }
        self.expect("!")?;
        let name_span = self.token().span;
        let name = self.ident()?;
        if builtin_macro(&name) {
            return Err(error(name_span, "E_UNSUPPORTED_MACRO", "built-in macro names are reserved"));
        }
        for attribute in attrs {
            if !matches!(attribute.name.as_str(), "macro_export" | "allow" | "cfg" | "doc" | "deprecated") {
                return Err(error(attribute.span, "E_UNSUPPORTED_MACRO", "unsupported attribute on macro definition"));
            }
            if attribute.name == "macro_export" && !attribute.args.is_empty()
                && (attribute.args.len() != 1usize || attribute.args[0] != "local_inner_macros") {
                return Err(error(attribute.span, "E_MACRO_RULE", "macro_export only accepts local_inner_macros"));
            }
        }
        let braces = self.is("{");
        let body = self.macro_tree()?;
        self.macro_terminator(braces)?;
        let exported = attrs.iter().any(|attribute| attribute.name == "macro_export");
        let local_inner = attrs.iter().any(|attribute| attribute.name == "macro_export"
            && attribute.args.iter().any(|argument| argument == "local_inner_macros"));
        self.program.macro_definitions.push(MacroDefinition { name, scope: self.scope,
            span: self.finish_span(span), name_span, body, exported, local_inner });
        Ok(())
    }
    pub(super) fn macro_invocation(&mut self, name: String, span: Span, name_span: Span, position: MacroPosition)
        -> Result<usize, Diagnostic> {
        let tokens = self.macro_tree()?;
        let id = self.program.macro_invocations.len();
        self.program.macro_invocations.push(MacroInvocation { name,
            scope: self.macro_scope.unwrap_or(self.scope), destination: self.scope, block: self.block,
            span: self.finish_span(span), name_span, tokens, self_context: self.self_context,
            parent: self.expansion, position });
        Ok(id)
    }
}
fn parser(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation,
    expansion: Option<usize>) -> Parser {
    let mut restored = Vec::new();
    for token in tokens { restored.push(restore_token(token.clone())); }
    let span = tokens.last().map(|token| token.span).unwrap_or(invocation.span);
    restored.push(Token { kind: TokenKind::End, text: String::new(), literal_spelling: String::new(), span, origin: span, context: 0usize });
    Parser { tokens: restored, at: 0usize, module: program.scopes[invocation.destination].path.clone(),
        scope: invocation.destination, block: invocation.block, macro_scope: None, program: std::mem::replace(program, Program::default()),
        diagnostics: Vec::new(), blocked: Vec::<BlockedRegion>::new(), recovery: Vec::new(), diagnostic_keys: BTreeSet::new(),
        self_context: invocation.self_context, expansion, probing: false, fragment: true, macro_carriers: Vec::new() }
}
#[derive(Clone, Copy, PartialEq, Eq)]
enum ParsedFragment { Expression, Type, Block }

fn fragment_mode(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation,
    expansion: Option<usize>, fragment: ParsedFragment, complete: bool, probing: bool,
    macro_scope: Option<ModuleId>) -> Result<(usize, usize, Option<MacroToken>), Diagnostic> {
    let mut parser = parser(program, tokens, invocation, expansion);
    parser.probing = probing;
    parser.macro_scope = macro_scope;
    let span = parser.token().span;
    let mut result = match fragment {
        ParsedFragment::Expression => parser.expr(true),
        ParsedFragment::Type => parser.ty(),
        ParsedFragment::Block => parser.block().map(|block| {
            let span = parser.program.blocks[block].span;
            parser.add_expr(Expr::Block(block), span)
        }),
    };
    let inferred = match &result { Ok(id) => *id == 0usize, Err(_) => false };
    if fragment == ParsedFragment::Type && inferred {
        result = Ok(parser.add_type(Type::Infer, span));
    }
    if let Some(diagnostic) = parser.diagnostics.first().cloned() { result = Err(diagnostic); }
    if result.is_ok() && complete && parser.token().kind != TokenKind::End {
        result = Err(error(parser.token().span, "E_MACRO_EXPANSION",
            match fragment {
                ParsedFragment::Type => "macro capture must be one complete type",
                ParsedFragment::Block => "macro capture must be one complete block",
                ParsedFragment::Expression => "statement-list expansion needs statement position; help: use a brace call, a semicolon after the call, or a block template",
            }));
    }
    let consumed = parser.at;
    let remainder = if consumed < tokens.len() && parser.token().text != tokens[consumed].text {
        Some(capture_token(parser.token()))
    } else { None };
    if result.is_ok() { parser.record_macro_identifiers(); }
    *program = parser.program;
    result.map(|id| (id, consumed, remainder))
}
fn expression(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation,
    expansion: Option<usize>, complete: bool) -> Result<(ExprId, usize), Diagnostic> {
    if tokens.is_empty() { return Err(error(invocation.span, "E_MACRO_EXPANSION", "empty expansion in expression position")); }
    if tokens.first().is_some_and(|token| token.kind == 0u8 && matches!(token.text.as_str(), "let" | "use" | "fn" | "struct" | "enum" | "type")) {
        return Err(error(invocation.span, "E_MACRO_EXPANSION", "statement-list expansion needs statement position; help: use a brace call, a semicolon after the call, or a block template"));
    }
    fragment_mode(program, tokens, invocation, expansion, ParsedFragment::Expression, complete, false, None)
        .map(|(id, consumed, _)| (id, consumed))
}
fn probe_fragment(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation, fragment: ParsedFragment)
    -> Result<(usize, usize, Option<MacroToken>), Diagnostic> {
    fragment_mode(program, tokens, invocation, invocation.parent, fragment, false, true, None)
}
impl Parser {
    pub(super) fn macro_type_materialization(&self, id: TypeId) -> bool {
        self.program.macro_captures.iter().any(|capture| capture.type_materializations.contains(&id))
    }
    fn macro_capture(&mut self, id: usize, fragment: ParsedFragment) -> Result<usize, Diagnostic> {
        let tokens = self.program.macro_captures[id].tokens.clone();
        let scope = self.program.macro_captures[id].scope;
        let span = self.program.macro_captures[id].span;
        let parent = self.program.macro_captures[id].parent;
        let invocation = MacroInvocation { name: "$capture".to_string(), scope,
            destination: self.scope, block: self.block, span, name_span: span, tokens: Vec::new(),
            self_context: self.self_context, parent, position: MacroPosition::Expression };
        let (node, _, _) = fragment_mode(&mut self.program, &tokens, &invocation,
            parent, fragment, true, self.probing, Some(scope))?;
        if fragment == ParsedFragment::Type {
            let prior = self.program.macro_captures[id].ty;
            self.program.macro_parse_writes.push(crate::ast::macros::MacroParseWrite::CaptureType(id, prior));
            let capture = &mut self.program.macro_captures[id];
            if capture.ty.is_none() { capture.ty = Some(node); }
            capture.type_materializations.push(node);
        } else {
            let prior = self.program.macro_captures[id].expression;
            self.program.macro_parse_writes.push(crate::ast::macros::MacroParseWrite::CaptureExpression(id, prior));
            let capture = &mut self.program.macro_captures[id];
            if capture.expression.is_none() { capture.expression = Some(node); }
            capture.materializations.push(node);
        }
        Ok(node)
    }
    // Recover the literal token's context through opaque expression captures.
    // Macro-produced strings have no implicit captures, matching Rust's format contract.
    pub(super) fn literal_origin(&self, character: bool) -> FormatOrigin {
        let token = self.token();
        if matches!(token.kind, TokenKind::String) || character && matches!(token.kind, TokenKind::Char) { return FormatOrigin::Literal(token.context); }
        if matches!(token.kind, TokenKind::Ident) && (token.text == "concat" || token.text == "module_path" || token.text == "file") { return FormatOrigin::Expansion; }
        let mut id = match &token.kind { TokenKind::Expression(id) => *id, _ => return FormatOrigin::Other };
        for _ in 0usize..self.program.macro_captures.len() {
            let Some(capture) = self.program.macro_captures.get(id) else { return FormatOrigin::Other; };
            let Some(token) = capture.tokens.first() else { return FormatOrigin::Other; };
            if token.kind == 2u8 || character && token.kind == 3u8 { return FormatOrigin::Literal(token.context); }
            if token.kind == 0u8 && (token.text == "concat" || token.text == "module_path" || token.text == "file") { return FormatOrigin::Expansion; }
            if token.kind != 8u8 { return FormatOrigin::Other; }
            let Some(next) = token.capture else { return FormatOrigin::Other; }; id = next;
        }
        FormatOrigin::Other
    }
    pub(super) fn macro_capture_expression(&mut self, id: usize) -> Result<ExprId, Diagnostic> {
        self.macro_capture(id, ParsedFragment::Expression)
    }
    pub(super) fn macro_capture_type(&mut self, id: usize) -> Result<TypeId, Diagnostic> {
        self.macro_capture(id, ParsedFragment::Type)
    }
    pub(super) fn macro_capture_block_expression(&mut self, id: usize) -> Result<ExprId, Diagnostic> {
        self.macro_capture(id, ParsedFragment::Block)
    }
    pub(super) fn macro_capture_block(&mut self, id: usize) -> Result<BlockId, Diagnostic> {
        let expression = self.macro_capture_block_expression(id)?;
        let Expr::Block(block) = self.program.exprs[expression].kind else { unreachable!() };
        Ok(block)
    }
}
fn items(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation,
    expansion: usize) -> Result<Vec<Item>, Diagnostic> {
    let first_function = program.functions.len();
    let first_impl = program.impls.len();
    let mut parser = parser(program, tokens, invocation, Some(expansion));
    let result = parser.items(false);
    let diagnostic = parser.diagnostics.first().cloned();
    if result.is_ok() && diagnostic.is_none() { parser.record_macro_identifiers(); }
    *program = parser.program;
    if let Some(diagnostic) = diagnostic { return Err(diagnostic); }
    let items = result?;
    for id in first_function..program.functions.len() { program.macro_expansions[expansion].functions.push(id); }
    for id in first_impl..program.impls.len() { program.macro_expansions[expansion].implementations.push(id); }
    program.macro_expansions[expansion].items = items.clone();
    Ok(items)
}

fn statements(program: &mut Program, tokens: &[MacroToken], invocation: &MacroInvocation,
    expansion: usize) -> Result<(Vec<Stmt>, Option<ExprId>), Diagnostic> {
    let mut parser = parser(program, tokens, invocation, Some(expansion));
    let result = parser.block_contents(true);
    let diagnostic = parser.diagnostics.first().cloned();
    if result.is_ok() && diagnostic.is_none() { parser.record_macro_identifiers(); }
    *program = parser.program;
    if let Some(problem) = diagnostic { return Err(problem); }
    result
}

pub(crate) fn expand(program: &mut Program) -> Result<(), Diagnostic> { expand::run(program) }

#[derive(Default)]
pub(crate) struct ExpansionReport {
    pub diagnostics: Vec<Diagnostic>,
    pub blocked: Vec<BlockedRegion>,
    pub recovery: Vec<Recovery>,
    pub attempts: usize,
}
pub(crate) fn expand_report(program: &mut Program) -> ExpansionReport {
    expand::report(program)
}

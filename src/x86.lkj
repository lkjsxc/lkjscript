//! x86-64 encoding and relative relocation. No IR operation is selected here.
use crate::diagnostic::{Diagnostic, Span};
mod units;
pub(crate) use units::{displacement, Linkable, SymbolReference, ImmediateReference};

pub type Label = usize;
pub const A: u8 = 0;
pub const C: u8 = 1;
pub const D: u8 = 2;
pub const B: u8 = 3;
pub const SP: u8 = 4;
pub const BP: u8 = 5;
pub const SI: u8 = 6;
pub const DI: u8 = 7;
pub const R8: u8 = 8;
pub const R9: u8 = 9;
pub const R10: u8 = 10;
pub const R11: u8 = 11;
pub const R12: u8 = 12;
pub const R13: u8 = 13;
pub const R14: u8 = 14;
pub const R15: u8 = 15;
pub const CONTEXT: u8 = R12;
pub const STACK_FLOOR: u8 = R13;
pub const LINE: u8 = R14;
pub const FILE: u8 = R15;

// Mutually exclusive emitted-code categories; these describe machine work,
// independently of the source function which happens to contain it.
pub const KIND_UNKNOWN: u8 = 0;
pub const KIND_COPY: u8 = 1;
pub const KIND_CHECK: u8 = 2;
pub const KIND_CALL: u8 = 3;
pub const KIND_FRAME: u8 = 4;
pub const KIND_MEMORY: u8 = 5;
pub const KIND_ARITHMETIC: u8 = 6;
pub const KIND_BRANCH: u8 = 7;
pub const KIND_ALLOCATOR: u8 = 8;
pub const KIND_RUNTIME: u8 = 9;
pub const KIND_MOVE: u8 = 10;
pub const KIND_ADDRESS: u8 = 11;
pub const KIND_CONSTANT: u8 = 12;
pub const KIND_ARGUMENT: u8 = 13;
pub const KIND_PROLOGUE: u8 = 14;
pub const KIND_RETURN: u8 = 15;
pub const KIND_COUNT: usize = 16;



pub const COPY_ORIGIN_BODY: u64 = 1;

pub const COPY_ORIGIN_PARAMETER: u64 = 2;

pub const COPY_ROLE_LOCAL: u64 = 1;

pub const COPY_ROLE_PLACE: u64 = 2;

pub const COPY_ROLE_CONSTRUCTOR_FIELD: u64 = 3;

pub const COPY_ROLE_ARRAY_ELEMENT: u64 = 4;

pub const COPY_ROLE_ABI_INCOMING: u64 = 5;

pub const COPY_ROLE_PARAM_LOCAL: u64 = 6;

pub const COPY_ROLE_ABI_RESULT: u64 = 7;

pub const COPY_ROLE_VEC_ELEMENT: u64 = 8;

pub const COPY_ROLE_RESULT_FIELD: u64 = 9;

pub const COPY_ROLE_REPEAT_ELEMENT: u64 = 10;

pub const COPY_ROLE_BOX_PAYLOAD: u64 = 11;

pub const COPY_ROLE_REFERENT: u64 = 12;

pub const COPY_ROLE_VIEW_HEADER: u64 = 13;

#[derive(Clone, Copy, PartialEq, Eq)]
pub struct CopySite {
    pub start: usize,
    pub end: usize,
    pub function: usize,
    pub instruction: usize,
    pub subsite: usize,
    pub ty: usize,
    pub width: u64,
    pub tags: u64,
}

pub fn valid_copy_tags(tags: u64) -> bool {
    if tags & !0x0000000707ffffffu64 != 0 { return false; }
    let origin = tags & 255u64;
    let source = (tags >> 8u32) & 255u64;
    let destination = (tags >> 16u32) & 255u64;
    let source_flags = (tags >> 24u32) & 7u64;
    let destination_flags = (tags >> 32u32) & 7u64;
    if (source != COPY_ROLE_PLACE && source_flags != 0)
        || (destination != COPY_ROLE_PLACE && destination_flags != 0) { return false; }
    if origin == COPY_ORIGIN_PARAMETER {
        return source == COPY_ROLE_ABI_INCOMING && destination == COPY_ROLE_PARAM_LOCAL;
    }
    if origin != COPY_ORIGIN_BODY { return false; }
    (source == COPY_ROLE_LOCAL && (destination == COPY_ROLE_LOCAL
        || destination == COPY_ROLE_PLACE || destination == COPY_ROLE_CONSTRUCTOR_FIELD
        || destination == COPY_ROLE_ARRAY_ELEMENT || destination == COPY_ROLE_ABI_RESULT
        || destination == COPY_ROLE_VEC_ELEMENT || destination == COPY_ROLE_REPEAT_ELEMENT
        || destination == COPY_ROLE_BOX_PAYLOAD))
        || (source == COPY_ROLE_PLACE && destination == COPY_ROLE_LOCAL)
        || (source == COPY_ROLE_VEC_ELEMENT && destination == COPY_ROLE_RESULT_FIELD)
        || (source == COPY_ROLE_REFERENT && destination == COPY_ROLE_LOCAL)
        || (source == COPY_ROLE_VIEW_HEADER && destination == COPY_ROLE_VIEW_HEADER)
}

fn valid_copy_coordinates(site: &CopySite) -> bool {
    let origin = site.tags & 255u64;
    site.start < site.end && site.width != 0 && site.function != !0usize && site.ty != !0usize
        && valid_copy_tags(site.tags)
        && ((origin == COPY_ORIGIN_BODY && site.instruction != !0usize)
            || (origin == COPY_ORIGIN_PARAMETER && site.instruction == !0usize))
}

pub(crate) fn copy_interval(kinds: &[(usize, u8)], start: usize, end: usize, length: usize) -> bool {
    if start >= end || end > length { return false; }
    let mut low = 0usize;
    let mut high = kinds.len();
    while low < high {
        let middle = low + (high - low) / 2usize;
        if kinds[middle].0 <= start { low = middle + 1usize; } else { high = middle; }
    }
    low != 0 && kinds[low - 1usize].1 == KIND_COPY
        && (low == kinds.len() || kinds[low].0 >= end)
}
struct Reference {
    at: usize,
    label: Label,
    site: Span,
}


#[derive(Clone, Copy)]
pub(crate) struct Checkpoint {
    bytes: usize,
    labels: usize,
    references: usize,
    kinds: usize,
    copies: usize,
    profile: bool,
}
pub(crate) struct FragmentReference {
    pub at: usize,
    pub label: Label,
    pub site: Span,
}
pub(crate) struct Fragment {
    pub bytes: Vec<u8>,
    pub label_base: usize,
    pub labels: Vec<Option<usize>>,
    pub references: Vec<FragmentReference>,
    pub symbols: Vec<(Label, Vec<u8>)>,
    pub site: Span,
    pub kinds: Vec<(usize, u8)>,
    pub copies: Vec<CopySite>,
}

pub struct Assembler {
    pub bytes: Vec<u8>,
    base: usize,
    symbolic_messages: bool,
    immediate_references: Vec<ImmediateReference>,
    labels: Vec<Option<usize>>,
    references: Vec<Reference>,
    site: Span,
    problem: Option<Diagnostic>,
    profile: bool,
    scope_kind: u8,
    region_kind: u8,
    kinds: Vec<(usize, u8)>,
    copies: Vec<CopySite>,
}
impl Default for Assembler {
    fn default() -> Self {
        Self::new()
    }
}

impl Assembler {
    pub fn new() -> Self {
        Self {
            bytes: Vec::new(),
            base: 0usize,
            symbolic_messages: false,
            immediate_references: Vec::new(),
            labels: Vec::new(),
            references: Vec::new(),
            site: Span {
                file: 0,
                start: 0,
                end: 0,
                line: 1,
                column: 1,
            },
            problem: None,
            profile: false,
            scope_kind: KIND_UNKNOWN,
            region_kind: KIND_UNKNOWN,
            kinds: Vec::new(),
            copies: Vec::new(),
        }
    }


    pub(crate) fn enable_profile(&mut self) {
        self.profile = true;
    }
    pub(crate) fn copy_sites_enabled(&self) -> bool {
        self.profile && (self.region_kind == KIND_UNKNOWN || self.region_kind == KIND_COPY)
    }
    pub(crate) fn record_copy_site(&mut self, site: CopySite) {
        if !self.copy_sites_enabled() { return; }
        if !valid_copy_coordinates(&site)
            || !copy_interval(&self.kinds, site.start, site.end, self.bytes.len())
            || self.copies.last().is_some_and(|previous| previous.end > site.start)
        {
            self.fail("invalid profiled copy-site interval");
            return;
        }
        self.copies.push(site);
    }
    pub(crate) fn take_copy_sites(&mut self) -> Vec<CopySite> {
        std::mem::replace(&mut self.copies, Vec::new())
    }
    pub(crate) fn scope_kind(&mut self, kind: u8) -> u8 {
        let previous = self.scope_kind;
        self.scope_kind = kind;
        previous
    }
    pub(crate) fn region_kind(&mut self, kind: u8) -> u8 {
        let previous = self.region_kind;
        self.region_kind = kind;
        previous
    }
    fn kind(&mut self, default: u8) {
        if self.profile {
            let kind = if self.region_kind != KIND_UNKNOWN {
                self.region_kind
            } else if self.scope_kind != KIND_UNKNOWN {
                self.scope_kind
            } else {
                default
            };
            let offset = self.bytes.len();
            self.record_kind(offset, kind);
        }
    }
    fn transfer_kind(&mut self, kind: u8) {
        // CALL and RET remain visible inside ABI setup/teardown. Runtime and
        // allocator regions still own all of their internal instructions.
        let previous = self.scope_kind(kind);
        self.kind(kind);
        self.scope_kind(previous);
    }
    fn record_kind(&mut self, offset: usize, kind: u8) {
        let count = self.kinds.len();
        if count != 0 {
            if self.kinds[count - 1].0 == offset {
                self.kinds[count - 1].1 = kind;
                if count > 1 && self.kinds[count - 2].1 == kind {
                    self.kinds.pop();
                }
                return;
            }
            if self.kinds[count - 1].1 == kind {
                return;
            }
        }
        self.kinds.push((offset, kind));
    }
    pub(crate) fn take_kinds(&mut self) -> Vec<(usize, u8)> {
        std::mem::replace(&mut self.kinds, Vec::new())
    }
    fn raw_bytes(&mut self, bytes: &[u8]) {
        self.bytes.extend_from_slice(bytes);
    }

    pub(crate) fn label_count(&self) -> usize {
        self.labels.len()
    }
    pub(crate) fn checkpoint(&self) -> Checkpoint {
        Checkpoint {
            bytes: self.bytes.len(),
            labels: self.labels.len(),
            references: self.references.len(),
            kinds: self.kinds.len(),
            copies: self.copies.len(),
            profile: self.profile,
        }
    }
    pub(crate) fn fragment(
        &self,
        checkpoint: Checkpoint,
        symbols: Vec<(Label, Vec<u8>)>,
    ) -> Option<Fragment> {
        if self.problem.is_some() || checkpoint.profile != self.profile
            || checkpoint.bytes > self.bytes.len() || checkpoint.labels > self.labels.len()
            || checkpoint.references > self.references.len() || checkpoint.copies > self.copies.len()
            || (checkpoint.copies != 0 && self.copies[checkpoint.copies - 1usize].end > checkpoint.bytes)
        {
            return None;
        }
        let mut positions = Vec::new();
        for position in &self.labels[checkpoint.labels..] {
            positions.push(match position {
                Some(position) if *position >= checkpoint.bytes => Some(*position - checkpoint.bytes),
                Some(_) => return None,
                None => None,
            });
        }
        let mut references = Vec::new();
        for reference in &self.references[checkpoint.references..] {
            if reference.at < checkpoint.bytes || reference.at > self.bytes.len()
                || self.bytes.len() - reference.at < 4usize { return None; }
            references.push(FragmentReference {
                at: reference.at - checkpoint.bytes,
                label: reference.label,
                site: reference.site,
            });
        }
        let mut kinds = Vec::new();
        if self.profile && checkpoint.bytes < self.bytes.len() {
            let previous = if checkpoint.kinds == 0 { 0 } else { checkpoint.kinds - 1 };
            let previous = previous.min(self.kinds.len());
            let kind = if previous == 0 { KIND_UNKNOWN } else { self.kinds[previous - 1].1 };
            kinds.push((0, kind));
            for (offset, kind) in &self.kinds[previous..] {
                if *offset <= checkpoint.bytes {
                    kinds[0].1 = *kind;
                } else if *offset < self.bytes.len() {
                    kinds.push((*offset - checkpoint.bytes, *kind));
                }
            }
        }
        let mut copies = Vec::new();
        for site in &self.copies[checkpoint.copies..] {
            if !self.profile || site.start < checkpoint.bytes || site.end > self.bytes.len() {
                return None;
            }
            let mut relative = *site;
            relative.start -= checkpoint.bytes;
            relative.end -= checkpoint.bytes;
            if !valid_copy_coordinates(&relative)
                || !copy_interval(&kinds, relative.start, relative.end, self.bytes.len() - checkpoint.bytes)
            { return None; }
            copies.push(relative);
        }
        Some(Fragment {
            bytes: self.bytes[checkpoint.bytes..].to_vec(),
            label_base: checkpoint.labels,
            labels: positions,
            references,
            symbols,
            site: self.site,
            kinds,
            copies,
        })
    }
    /// Append authenticated relocatable bytes only after a complete preflight.
    /// Labels allocated by earlier bodies never identify a literal: its bytes do.
    pub(crate) fn append_fragment(
        &mut self,
        fragment: &Fragment,
        bound: Label,
        prefix: usize,
        symbols: &mut std::collections::BTreeMap<Vec<u8>, Label>,
    ) -> bool {
        if self.problem.is_some() || (self.profile && self.region_kind != KIND_UNKNOWN)
            || bound >= prefix || prefix > self.labels.len()
            || self.labels[bound].is_some() || fragment.label_base < prefix
            || fragment.labels.len() > (!0usize) - fragment.label_base
        {
            return false;
        }
        let limit = fragment.label_base + fragment.labels.len();
        let mut symbolic = std::collections::BTreeMap::new();
        for (label, _) in &fragment.symbols {
            if *label < prefix || *label >= limit || symbolic.contains_key(label) {
                return false;
            }
            if *label >= fragment.label_base
                && fragment.labels[*label - fragment.label_base].is_some()
            {
                return false;
            }
            symbolic.insert(*label, true);
        }
        for position in &fragment.labels {
            if position.is_some_and(|position| position > fragment.bytes.len()) {
                return false;
            }
        }
        for reference in &fragment.references {
            if reference.at > fragment.bytes.len()
                || fragment.bytes.len() - reference.at < 4
                || reference.label >= limit
            {
                return false;
            }
            if reference.label >= prefix && !symbolic.contains_key(&reference.label) {
                if reference.label < fragment.label_base
                    || fragment.labels[reference.label - fragment.label_base].is_none()
                {
                    return false;
                }
            }
        }
        if self.profile != !fragment.kinds.is_empty() {
            return false;
        }
        let mut previous = 0usize;
        for (index, (offset, kind)) in fragment.kinds.iter().enumerate() {
            if *offset >= fragment.bytes.len() || *kind as usize >= KIND_COUNT
                || (index == 0 && *offset != 0) || (index != 0 && *offset <= previous)
            {
                return false;
            }
            previous = *offset;
        }
        if !self.profile && !fragment.copies.is_empty() { return false; }
        let mut previous_end = 0usize;
        for site in &fragment.copies {
            if !valid_copy_coordinates(site) || site.start < previous_end
                || !copy_interval(&fragment.kinds, site.start, site.end, fragment.bytes.len())
            { return false; }
            previous_end = site.end;
        }
        let offset = self.bytes.len();
        if fragment.bytes.len() > (!0usize) - offset
            || fragment.labels.len() > (!0usize) - self.labels.len()
            || fragment.symbols.len() > (!0usize) - self.labels.len() - fragment.labels.len()
            || fragment.copies.len() > (!0usize) - self.copies.len()
            || fragment.kinds.len() > (!0usize) - self.kinds.len()
        { return false; }
        if let Some(first) = fragment.copies.first() {
            if self.copies.last().is_some_and(|last| last.end > offset + first.start) { return false; }
        }
        // No validation failure may allocate a label or introduce a data symbol.
        let mut locals = Vec::new();
        for _ in &fragment.labels {
            locals.push(self.label());
        }
        let mut rebound = std::collections::BTreeMap::new();
        for (label, bytes) in &fragment.symbols {
            let current = match symbols.get(bytes) {
                Some(current) => *current,
                None => {
                    let current = if *label >= fragment.label_base {
                        locals[*label - fragment.label_base]
                    } else {
                        self.label()
                    };
                    symbols.insert(bytes.clone(), current);
                    current
                }
            };
            rebound.insert(*label, current);
        }
        self.bind(bound);
        for (index, position) in fragment.labels.iter().enumerate() {
            if let Some(position) = position {
                self.data_label(locals[index], offset + *position);
            }
        }
        self.bytes.extend_from_slice(&fragment.bytes);
        for (position, kind) in &fragment.kinds {
            self.record_kind(offset + *position, *kind);
        }
        for site in &fragment.copies {
            let mut rebased = *site;
            rebased.start += offset;
            rebased.end += offset;
            self.copies.push(rebased);
        }
        for reference in &fragment.references {
            let label = match rebound.get(&reference.label) {
                Some(label) => *label,
                None if reference.label >= fragment.label_base => locals[reference.label - fragment.label_base],
                None => reference.label,
            };
            self.references.push(Reference {
                at: offset + reference.at,
                label,
                site: reference.site,
            });
        }
        self.site = fragment.site;
        true
    }

    pub fn location(&mut self, file: usize, line: usize, column: usize) {
        self.site.file = file;
        self.site.line = line;
        self.site.column = column;
    }
    fn fail(&mut self, message: &str) {
        if self.problem.is_none() {
            self.problem = Some(Diagnostic::new(self.site, "E_EMIT", message));
        }
    }
    pub fn label(&mut self) -> Label {
        let label = self.labels.len();
        self.labels.push(None);
        label
    }
    pub fn position(&self, label: Label) -> Option<usize> {
        self.labels[label]
    }
    pub fn bind(&mut self, label: Label) {
        let offset = self.base + self.bytes.len();
        self.data_label(label, offset);
    }
    /// Bind a target at an offset relative to the first emitted code byte.
    pub fn data_label(&mut self, label: Label, offset: usize) {
        if label >= self.labels.len() || self.labels[label].is_some() {
            self.fail("invalid or already bound x86-64 label");
            return;
        }
        self.labels[label] = Some(offset);
    }
    pub fn raw(&mut self, bytes: &[u8]) {
        if self.profile { self.kind(KIND_UNKNOWN); }
        self.bytes.extend_from_slice(bytes);
    }
    fn word(&mut self, value: u64, bytes: usize) {
        let mut index = 0usize;
        while index < bytes {
            self.bytes.push((value >> (index * 8usize)) as u8);
            index += 1;
        }
    }
    fn rex_for(&mut self, wide: bool, r: u8, b: u8, force: bool) {
        let prefix = 0x40 | ((wide as u8) << 3) | (((r >> 3) & 1) << 2) | ((b >> 3) & 1);
        if prefix != 0x40 || force {
            self.bytes.push(prefix);
        }
    }
    pub fn rr(&mut self, opcode: u8, dst: u8, src: u8, wide: bool) {
        if self.profile { self.kind(if opcode == 0x88 || opcode == 0x89 { KIND_MOVE } else { KIND_ARITHMETIC }); }
        let byte = opcode == 0x88
            || opcode == 0x00
            || opcode == 0x08
            || opcode == 0x20
            || opcode == 0x28
            || opcode == 0x30
            || opcode == 0x38;
        self.rex_for(wide, src, dst, byte && (src >= 4 || dst >= 4));
        self.raw_bytes(&[opcode, 0xc0 | ((src & 7) << 3) | (dst & 7)]);
    }
    pub fn mov(&mut self, dst: u8, src: u8) {
        if dst != src {
            self.rr(0x89, dst, src, true);
        }
    }
    /// Apply a scalar storage width while retaining the value in a register.
    pub fn normalize(&mut self, reg: u8, bytes: u8, signed: bool) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        match bytes {
            1 | 2 => {
                self.rex_for(signed, reg, reg, bytes == 1 && reg >= 4);
                let opcode = if bytes == 1 {
                    if signed { 0xbe } else { 0xb6 }
                } else if signed {
                    0xbf
                } else {
                    0xb7
                };
                self.raw_bytes(&[0x0f, opcode, 0xc0 | ((reg & 7) << 3) | (reg & 7)]);
            }
            4 if signed => {
                self.rex_for(true, reg, reg, false);
                self.raw_bytes(&[0x63, 0xc0 | ((reg & 7) << 3) | (reg & 7)]);
            }
            4 => self.rr(0x89, reg, reg, false),
            8 => {}
            _ => self.fail("unsupported x86-64 scalar register width"),
        }
    }
    /// Materialize a bit pattern without changing flags. The payload is 4 or 8 bytes.
    pub fn immediate(&mut self, reg: u8, value: u64) -> usize {
        if self.profile { self.kind(KIND_CONSTANT); }
        if value <= 0xffff_ffffu64 {
            self.rex_for(false, 0, reg, false);
            self.bytes.push(0xb8 | (reg & 7));
            let at = self.bytes.len();
            self.word(value, 4);
            at
        } else if value >= 0xffff_ffff_8000_0000u64 {
            self.rex_for(true, 0, reg, false);
            self.raw_bytes(&[0xc7, 0xc0 | (reg & 7)]);
            let at = self.bytes.len();
            self.word(value, 4);
            at
        } else {
            self.rex_for(true, 0, reg, false);
            self.bytes.push(0xb8 | (reg & 7));
            let at = self.bytes.len();
            self.word(value, 8);
            at
        }
    }
    fn relative(&mut self, label: Label) {
        let at = self.bytes.len();
        self.word(0, 4);
        self.references.push(Reference {
            at,
            label,
            site: self.site,
        });
    }
    pub fn address(&mut self, reg: u8, label: Label) {
        if self.profile { self.kind(KIND_ADDRESS); }
        self.rex_for(true, reg, 0, false);
        self.raw_bytes(&[0x8d, 0x05 | ((reg & 7) << 3)]);
        self.relative(label);
    }
    pub fn memory(&mut self, opcode: &[u8], reg: u8, base: u8, offset: i64, wide: bool) {
        if self.profile { self.kind(if opcode.len() == 1 && opcode[0] == 0x8d { KIND_ADDRESS } else if base == BP || base == SP { KIND_FRAME } else { KIND_MEMORY }); }
        if offset < -2147483648i64 || offset > 2147483647i64 {
            self.fail("x86-64 memory displacement exceeds signed 32-bit representation");
        }
        let byte = opcode.len() == 1 && (opcode[0] == 0x88 || opcode[0] == 0x8a);
        self.rex_for(wide, reg, base, byte && reg >= 4);
        self.raw_bytes(opcode);
        let mode = if offset == 0 && (base & 7) != 5 {
            0u8
        } else if offset >= -128i64 && offset <= 127i64 {
            1u8
        } else {
            2u8
        };
        self.bytes.push((mode << 6) | ((reg & 7) << 3) | (base & 7));
        if (base & 7) == 4 {
            self.bytes.push(0x24);
        }
        if mode == 1 {
            self.word(offset as u64, 1);
        } else if mode == 2 {
            self.word(offset as u64, 4);
        }
    }
    pub fn load(&mut self, reg: u8, base: u8, offset: i64) {
        self.memory(&[0x8b], reg, base, offset, true);
    }
    pub fn store(&mut self, base: u8, offset: i64, reg: u8) {
        self.memory(&[0x89], reg, base, offset, true);
    }
    pub fn load_width(&mut self, reg: u8, base: u8, offset: i64, bytes: u8, signed: bool) {
        match bytes {
            1 => self.memory(
                &[0x0f, if signed { 0xbe } else { 0xb6 }],
                reg,
                base,
                offset,
                signed,
            ),
            2 => self.memory(
                &[0x0f, if signed { 0xbf } else { 0xb7 }],
                reg,
                base,
                offset,
                signed,
            ),
            4 if signed => self.memory(&[0x63], reg, base, offset, true),
            4 => self.memory(&[0x8b], reg, base, offset, false),
            8 => self.load(reg, base, offset),
            _ => self.fail("unsupported x86-64 scalar load width"),
        }
    }
    pub fn store_width(&mut self, base: u8, offset: i64, reg: u8, bytes: u8) {
        if self.profile { self.kind(if base == BP || base == SP { KIND_FRAME } else { KIND_MEMORY }); }
        match bytes {
            1 => self.memory(&[0x88], reg, base, offset, false),
            2 => {
                self.bytes.push(0x66);
                self.memory(&[0x89], reg, base, offset, false);
            }
            4 => self.memory(&[0x89], reg, base, offset, false),
            8 => self.store(base, offset, reg),
            _ => self.fail("unsupported x86-64 scalar store width"),
        }
    }
    pub fn lea(&mut self, reg: u8, base: u8, offset: i64) {
        self.memory(&[0x8d], reg, base, offset, true);
    }
    pub fn compare(&mut self, left: u8, right: u8) {
        self.rr(0x39, left, right, true);
    }
    pub fn test(&mut self, reg: u8, wide: bool) {
        self.rr(0x85, reg, reg, wide);
    }
    pub fn shift(&mut self, reg: u8, kind: u8, count: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, reg, false);
        self.raw_bytes(&[0xc1, 0xc0 | ((kind & 7) << 3) | (reg & 7), count]);
    }
    pub fn shift_cl(&mut self, reg: u8, kind: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, reg, false);
        self.raw_bytes(&[0xd3, 0xc0 | ((kind & 7) << 3) | (reg & 7)]);
    }
    pub fn shift32(&mut self, reg: u8, kind: u8, count: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(false, 0, reg, false);
        self.raw_bytes(&[0xc1, 0xc0 | ((kind & 7) << 3) | (reg & 7), count]);
    }


    pub fn shift_cl32(&mut self, reg: u8, kind: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(false, 0, reg, false);
        self.raw_bytes(&[0xd3, 0xc0 | ((kind & 7) << 3) | (reg & 7)]);
    }
    pub fn imul32(&mut self, dst: u8, src: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(false, dst, src, false);
        self.raw_bytes(&[0x0f, 0xaf, 0xc0 | ((dst & 7) << 3) | (src & 7)]);
    }
    pub fn imul(&mut self, dst: u8, src: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, dst, src, false);
        self.raw_bytes(&[0x0f, 0xaf, 0xc0 | ((dst & 7) << 3) | (src & 7)]);
    }
    pub fn mul(&mut self, src: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, src, false);
        self.raw_bytes(&[0xf7, 0xe0 | (src & 7)]);
    }
    pub fn sign_extend_dividend(&mut self) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.raw_bytes(&[0x48, 0x99]);
    }
    /// Divide the caller-prepared RDX:RAX pair. The quotient is RAX, remainder RDX.
    pub fn divide(&mut self, src: u8, signed: bool) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, src, false);
        self.raw_bytes(&[0xf7, (if signed { 0xf8 } else { 0xf0 }) | (src & 7)]);
    }
    pub fn negate(&mut self, reg: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, reg, false);
        self.raw_bytes(&[0xf7, 0xd8 | (reg & 7)]);
    }
    pub fn not(&mut self, reg: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(true, 0, reg, false);
        self.raw_bytes(&[0xf7, 0xd0 | (reg & 7)]);
    }
    /// Both SETcc and MOVZX preserve flags, allowing multiple predicates.
    pub fn setcc(&mut self, reg: u8, condition: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.rex_for(false, 0, reg, reg >= 4);
        self.raw_bytes(&[0x0f, 0x90 | (condition & 15), 0xc0 | (reg & 7)]);
        self.rex_for(false, reg, reg, reg >= 4);
        self.raw_bytes(&[0x0f, 0xb6, 0xc0 | ((reg & 7) << 3) | (reg & 7)]);
    }
    pub fn cmov(&mut self, dst: u8, src: u8, condition: u8) {
        if self.profile { self.kind(KIND_MOVE); }
        self.rex_for(true, dst, src, false);
        self.raw_bytes(&[
            0x0f,
            0x40 | (condition & 15),
            0xc0 | ((dst & 7) << 3) | (src & 7),
        ]);
    }
    pub fn push(&mut self, reg: u8) {
        if self.profile { self.kind(KIND_FRAME); }
        self.rex_for(false, 0, reg, false);
        self.bytes.push(0x50 | (reg & 7));
    }
    pub fn pop(&mut self, reg: u8) {
        if self.profile { self.kind(KIND_FRAME); }
        self.rex_for(false, 0, reg, false);
        self.bytes.push(0x58 | (reg & 7));
    }
    pub fn jump(&mut self, label: Label) {
        if self.profile { self.kind(KIND_BRANCH); }
        self.bytes.push(0xe9);
        self.relative(label);
    }
    pub fn condition(&mut self, condition: u8, label: Label) {
        if self.profile { self.kind(KIND_BRANCH); }
        self.raw_bytes(&[0x0f, 0x80 | (condition & 15)]);
        self.relative(label);
    }
    pub fn call(&mut self, label: Label) {
        if self.profile { self.transfer_kind(KIND_CALL); }
        self.bytes.push(0xe8);
        self.relative(label);
    }
    pub fn jump_register(&mut self, reg: u8) {
        if self.profile { self.kind(KIND_BRANCH); }
        self.rex_for(false, 0, reg, false);
        self.raw_bytes(&[0xff, 0xe0 | (reg & 7)]);
    }
    pub fn call_register(&mut self, reg: u8) {
        if self.profile { self.transfer_kind(KIND_CALL); }
        self.rex_for(false, 0, reg, false);
        self.raw_bytes(&[0xff, 0xd0 | (reg & 7)]);
    }
    pub fn ret(&mut self) {
        if self.profile { self.transfer_kind(KIND_RETURN); }
        self.bytes.push(0xc3);
    }
    pub fn syscall(&mut self) {
        if self.profile { self.kind(KIND_RUNTIME); }
        self.raw_bytes(&[0x0f, 0x05]);
    }
    pub fn load128(&mut self, xmm: u8, base: u8, offset: i64) {
        if self.profile { self.kind(if base == BP || base == SP { KIND_FRAME } else { KIND_MEMORY }); }
        self.raw_bytes(&[0xf3]);
        self.memory(&[0x0f, 0x6f], xmm, base, offset, false);
    }
    pub fn store128(&mut self, base: u8, offset: i64, xmm: u8) {
        if self.profile { self.kind(if base == BP || base == SP { KIND_FRAME } else { KIND_MEMORY }); }
        self.raw_bytes(&[0xf3]);
        self.memory(&[0x0f, 0x7f], xmm, base, offset, false);
    }
    pub fn mov_to_xmm(&mut self, xmm: u8, reg: u8) {
        if self.profile { self.kind(KIND_MOVE); }
        self.bytes.push(0x66);
        self.rex_for(true, xmm, reg, false);
        self.raw_bytes(&[0x0f, 0x6e, 0xc0 | ((xmm & 7) << 3) | (reg & 7)]);
    }
    pub fn mov_from_xmm(&mut self, reg: u8, xmm: u8) {
        if self.profile { self.kind(KIND_MOVE); }
        self.bytes.push(0x66);
        self.rex_for(true, xmm, reg, false);
        self.raw_bytes(&[0x0f, 0x7e, 0xc0 | ((xmm & 7) << 3) | (reg & 7)]);
    }
    pub fn f64_op(&mut self, opcode: u8, dst: u8, src: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.bytes.push(0xf2);
        self.rex_for(false, dst, src, false);
        self.raw_bytes(&[0x0f, opcode, 0xc0 | ((dst & 7) << 3) | (src & 7)]);
    }
    pub fn f64_compare(&mut self, left: u8, right: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.bytes.push(0x66);
        self.rex_for(false, left, right, false);
        self.raw_bytes(&[0x0f, 0x2e, 0xc0 | ((left & 7) << 3) | (right & 7)]);
    }
    pub fn int_to_f64(&mut self, xmm: u8, reg: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.bytes.push(0xf2);
        self.rex_for(true, xmm, reg, false);
        self.raw_bytes(&[0x0f, 0x2a, 0xc0 | ((xmm & 7) << 3) | (reg & 7)]);
    }
    pub fn f64_to_int(&mut self, reg: u8, xmm: u8) {
        if self.profile { self.kind(KIND_ARITHMETIC); }
        self.bytes.push(0xf2);
        self.rex_for(true, reg, xmm, false);
        self.raw_bytes(&[0x0f, 0x2c, 0xc0 | ((reg & 7) << 3) | (xmm & 7)]);
    }
    pub fn finish(mut self) -> Result<Vec<u8>, Diagnostic> {
        if let Some(problem) = self.problem {
            return Err(problem);
        }
        for reference in &self.references {
            let target = match self.labels.get(reference.label) {
                Some(Some(target)) => *target,
                _ => {
                    return Err(Diagnostic::new(
                        reference.site,
                        "E_EMIT",
                        "unbound x86-64 label",
                    ));
                }
            };
            let base = self.base + reference.at + 4usize;
            let displacement = if target >= base {
                let distance = target - base;
                if distance > 2147483647usize {
                    return Err(Diagnostic::new(
                        reference.site,
                        "E_EMIT",
                        "x86-64 relative address exceeds signed 32-bit representation",
                    ));
                }
                distance as i64
            } else {
                let distance = base - target;
                if distance > 2147483648usize {
                    return Err(Diagnostic::new(
                        reference.site,
                        "E_EMIT",
                        "x86-64 relative address exceeds signed 32-bit representation",
                    ));
                }
                -(distance as i64)
            };
            let mut byte = 0usize;
            while byte < 4 {
                self.bytes[reference.at + byte] = ((displacement as u64) >> (byte * 8usize)) as u8;
                byte += 1;
            }
        }
        Ok(self.bytes)
    }
}

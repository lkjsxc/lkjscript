// Disposable, authenticated memo storage. This host adapter never grants a verdict.
// The pure reuse module authenticates entries before consumers see their payload.
use crate::{reuse, sha256};

use std::collections::{BTreeMap, BTreeSet};

// This bounds published authenticated file contents, including the index.
// The index controls eviction only; it never admits a program or a result.
struct StoredEntry { producer: String, bytes: usize }
struct Budget {
    generations: Vec<String>,
    entries: BTreeMap<String, StoredEntry>,
    bytes: usize,
    metadata: usize,
}
fn hex_identity(text: &str) -> bool {
    if text.len() != 64usize { return false; }
    for byte in text.bytes() {
        if !byte.is_ascii_digit() && !(b'a' <= byte && byte <= b'f') { return false; }
    }
    true
}
fn entry_producer(name: &str) -> Option<String> {
    let bytes = name.as_bytes();
    if bytes.len() < 131usize { return None; }
    let key = bytes.len() - 64usize;
    let producer = key - 65usize;
    if bytes[producer - 1usize] != b'-' || bytes[key - 1usize] != b'-' { return None; }
    if !hex_identity(&name[producer..key - 1usize]) || !hex_identity(&name[key..]) { return None; }
    for byte in &bytes[..producer - 1usize] {
        if !byte.is_ascii_lowercase() && !byte.is_ascii_digit() && *byte != b'-' { return None; }
    }
    Some(name[producer..key - 1usize].to_string())
}
impl Budget {
    fn new() -> Self {
        Self { generations: Vec::new(), entries: BTreeMap::new(), bytes: 0, metadata: 24 }
    }
    fn size(&self) -> usize { self.bytes + self.metadata + reuse::header_size() }
    fn forget(&mut self, name: &str) {
    if let Some(entry) = self.entries.remove(&name.to_string()) {
        self.bytes -= entry.bytes;
        self.metadata -= 24usize + name.len() + entry.producer.len();
    }
}
    fn remember(&mut self, name: &str, producer: &str, bytes: usize) {
    self.forget(name);
    if !self.generations.contains(&producer.to_string()) {
        self.generations.push(producer.to_string());
        self.metadata += 8usize + producer.len();
    }
    self.bytes += bytes;
    self.metadata += 24usize + name.len() + producer.len();
    self.entries.insert(name.to_string(), StoredEntry { producer: producer.to_string(), bytes });
}
    fn growth(&self, name: &str, producer: &str, bytes: usize, current_index: usize) -> Option<usize> {
    let generation = if self.generations.contains(&producer.to_string()) { 0usize } else { 8usize + producer.len() };
    let index = self.metadata.checked_add(generation)?
        .checked_add(24usize + name.len() + producer.len())?
        .checked_add(reuse::header_size())?;
    self.bytes.checked_add(bytes)?.checked_add(index.max(current_index))
}
    fn encode(&self) -> Vec<u8> {
    let mut out = Vec::new();
    push_word(&mut out, 2usize);
    push_word(&mut out, self.generations.len());
    for generation in &self.generations { push_bytes(&mut out, generation.as_bytes()); }
    push_word(&mut out, self.entries.len());
    for (name, entry) in &self.entries {
        push_bytes(&mut out, name.as_bytes());
        push_bytes(&mut out, entry.producer.as_bytes());
        push_word(&mut out, entry.bytes);
    }
    out
}
    fn decode(bytes: &[u8]) -> Option<Self> {
    let mut reader = Reader::new(bytes);
    if reader.word()? != 2usize { return None; }
    let count = reader.word()?;
    if count > bytes.len() / 72usize { return None; }
    let mut result = Self::new();
    for _ in 0usize..count {
        let producer = reader.text()?;
        if !hex_identity(&producer) || result.generations.contains(&producer) { return None; }
        result.metadata = result.metadata.checked_add(8usize + producer.len())?;
        result.generations.push(producer);
    }
    let count = reader.word()?;
    if count > bytes.len() / 24usize { return None; }
    for _ in 0usize..count {
        let name = reader.text()?;
        let producer = reader.text()?;
        let length = reader.word()?;
        if !owned_entry(&name, &producer) || !result.generations.contains(&producer)
            || result.entries.contains_key(&name) || length < reuse::header_size() { return None; }
        if query_locator_identity(&name).is_some() && length != reuse::header_size() + 104usize { return None; }
        result.bytes = result.bytes.checked_add(length)?;
        result.metadata = result.metadata.checked_add(24usize + name.len() + producer.len())?;
        result.entries.insert(name, StoredEntry { producer, bytes: length });
    }
    result.bytes.checked_add(result.metadata)?.checked_add(reuse::header_size())?;
    if !reader.done() { return None; }
    Some(result)
}
}

pub struct Store {
    directory: Directory,
    clock: Clock,
    producer: Vec<u8>,
    producer_slot: String,
    secret: Vec<u8>,
    sequence: usize,
    capacity: usize,
    index_bytes: usize,
    writer: Option<File>,
    write_state: u8,
    budget: Budget,
    dirty: bool,
    pub retained_bytes: usize,
    pub evicted: usize,
    pub hits: usize,
    pub misses: usize,
    pub rejected: usize,
    pub writes: usize,
}

fn location(path: &str) -> (&str, &str) {
    match path.rfind('/') {
        Some(0) => ("/", &path[1..]),
        Some(at) => (&path[..at], &path[at + 1..]),
        None => (".", path),
    }
}

// O_RDWR opens a FIFO without waiting for a peer; nonblocking reads then turn
// hostile stream-like entries into misses. Read-only disposable entries may miss.
fn cache_file(directory: &mut Directory, name: &str) -> Option<File> {
    let mut file = directory.open_append(name).ok()?;
    file.set_nonblocking(true).ok()?;
    Some(file)
}

impl Store {
    /// Budget bookkeeping only, never authentication. Queries still verify each
    /// rooted payload. This detects eviction of pages during index publication.
    pub fn query_pages_retained(&self, pages: &[String]) -> bool {
        if self.write_state != 1u8 { return false; }
        for page in pages {
            let name = format!("semantic-page-{}-{page}", self.producer_slot);
            if !self.budget.entries.contains_key(&name) { return false; }
        }
        true
    }
    pub fn invalidate_query_snapshot
(&mut self, identity: &str, selector: &str) { invalidate_store_query_snapshot(self, identity, selector); }
    pub fn query_cursor(&self, query: &str, payload: &[u8]) -> Vec<u8> { seal_query_cursor(&self.producer, &self.secret, query, payload) }
    pub fn open_query_cursor(&self, query: &str, bytes: &[u8]) -> Option<Vec<u8>> { authenticate_query_cursor(&self.producer, &self.secret, query, bytes) }
    pub fn open(world: &mut World, path: &Option<String>, key: &Option<String>) -> Option<Self> {
        Self::open_bounded(world, path, key, 256usize * 1024usize * 1024usize)
    }

    pub fn open_bounded(world: &mut World, path: &Option<String>, key: &Option<String>, capacity: usize) -> Option<Self> {
        let path = path.as_ref()?;
        let key = key.as_ref()?;
        let (parent, name) = location(key);
        let mut owner = world.directory(parent).ok()?;
        let mut key_file = owner.open(name).ok()?;
        let mut secret = vec![0u8; 33];
        let mut length = 0usize;
        while length < secret.len() {
            let count = key_file.read(&mut secret[length..]).ok()?;
            if count == 0 { break; }
            length += count;
        }
        if length != 32 { return None; }
        secret.pop();
        let directory = world.directory(path).ok()?;
        let mut executable = world.executable().ok()?;
        let mut hash = sha256::Sha256::new();
        let mut buffer = [0u8; 65536];
        loop {
            let count = executable.read(&mut buffer).ok()?;
            if count == 0 { break; }
            hash.update(&buffer[..count]);
        }
        let producer = hash.finish();
        Some(Self {
            directory, clock: world.clock(), producer: producer[..].to_vec(),
            producer_slot: sha256::hex_digest(&producer), secret,
            sequence: 0, hits: 0, misses: 0, rejected: 0, writes: 0,
            capacity, index_bytes: 0, writer: None, write_state: 0u8, budget: Budget::new(), dirty: false,
            retained_bytes: 0, evicted: 0,
        })
    }

    fn raw(&mut self, namespace: &str, key: &str) -> Option<reuse::VerifiedPayload> {
        // Generations coexist until the disposable store reaches its size cap.
        // Authentication always binds the original executable digest.
        let name = format!("{namespace}-{}-{key}", self.producer_slot);
        let mut file = cache_file(&mut self.directory, &name)?;
        let result = read_envelope(&mut file, &self.producer, &self.secret, namespace, key, self.capacity);
        if result.is_none() { self.rejected += 1; self.discard(namespace, key); }
        result
    }

    pub fn get(&mut self, namespace: &str, key: &str) -> Option<Vec<u8>> {
        let raw = match self.raw(namespace, key) {
            Some(raw) => raw,
            None => { self.misses += 1; return None; }
        };
        self.hits += 1;
        Some(raw.into_bytes())
    }

    pub fn records(&mut self, namespace: &str, group: &str, keys: &[String]) -> reuse::Records {
        let mut records = reuse::Records::packed(&self.producer, &self.secret, namespace, group);
        if let Some(raw) = self.raw(namespace, group) {
            if !records.load_verified_pack(raw) { self.discard(namespace, group); }
        }
        records.retain(namespace, keys);
        records
    }

    fn erase(&mut self, name: &str) -> bool {
        match self.directory.remove(name) {
            Ok(()) | Err(2) => {
                self.budget.forget(name);
                self.dirty = true;
                self.evicted += 1usize;
                true
            }
            Err(_) => { self.write_state = 2u8; false }
        }
    }

    fn evict_oldest(&mut self) -> bool {
        let Some(producer) = ({ self.budget.generations.first().cloned() }) else { return false; };
        let mut names: Vec<String> = Vec::new();
        for (name, entry) in &self.budget.entries {
            if entry.producer == producer { names.push(name.clone()); }
        }
        for name in names { if !self.erase(&name) { return false; } }
        let generations = std::mem::replace(&mut self.budget.generations, Vec::new());
        for generation in generations {
            if generation == producer { self.budget.metadata -= 8usize + generation.len(); }
            else { self.budget.generations.push(generation); }
        }
        self.dirty = true;
        true
    }

    fn writable(&mut self) -> bool {
        if self.write_state != 0u8 { return self.write_state == 1u8; }
        self.write_state = 2u8;
        let mut lock = match self.directory.open_append(".budget-lock") { Ok(file) => file, Err(_) => return false };
        match lock.lock_exclusive() {
            Ok(()) => {}
            Err(11) => { self.write_state = 0u8; return false; }
            Err(_) => return false,
        }
        self.writer = Some(lock);
        self.write_state = 1u8;
        let identity = sha256::digest(b"lkjscript-store-size-index-1");
        let mut valid_index = false;
        if let Some(mut file) = cache_file(&mut self.directory, ".budget-index") {
            if let Some(raw) = read_envelope(&mut file, &identity[..], &self.secret, "size-index", "1", self.capacity) {
                if let Some(budget) = Budget::decode(raw.bytes()) {
                    self.budget = budget;
                    self.index_bytes = raw.bytes().len() + reuse::header_size();
                    valid_index = true;
                }
            }
        }
        if !valid_index {
            match self.directory.remove(".budget-index") {
                Ok(()) | Err(2) => {}
                Err(_) => { self.write_state = 2u8; return false; }
            }
        }
        let names = match self.directory.list() { Ok(names) => names, Err(_) => { self.write_state = 2u8; return false; } };
        let mut present: BTreeSet<String> = BTreeSet::new();
        for bytes in names {
            let Ok(name) = String::from_utf8(bytes) else { continue; };
            if indexed_name(&name) {
                let expected = match self.budget.entries.get(&name) { Some(entry) => Some(entry.bytes), None => None };
                let mut valid = false;
                if let Some(expected) = expected {
                    if let Some(mut file) = cache_file(&mut self.directory, &name) {
                        let mut header = vec![0u8; reuse::header_size()];
                        if read_exact(&mut file, &mut header) {
                            if let Some(payload) = reuse::payload_length(&header) {
                                valid = payload.checked_add(header.len()) == Some(expected);
                            }
                        }
                    }
                }
                // A failed prior index checkpoint can leave a larger valid pack.
                // Its old accounting is a miss; never undercharge the replacement.
                if valid { present.insert(name); }
                else if !self.erase(&name) { return false; }
            } else if name.starts_with(".tmp-") {
                if let Ok(mut temporary) = self.directory.open_directory(&name) { let _ = temporary.remove("entry"); }
                let _ = self.directory.remove_directory(&name);
            }
        }
        let mut absent: Vec<String> = Vec::new();
        for (name, _) in &self.budget.entries {
            if !present.contains(name) { absent.push(name.clone()); }
        }
        for name in absent { self.budget.forget(&name); self.dirty = true; }
        while self.budget.size() > self.capacity {
            if !self.evict_oldest() {
                let _ = self.directory.remove(".budget-index");
                self.write_state = 2u8;
                self.retained_bytes = 0usize;
                return false;
            }
        }
        self.retained_bytes = self.budget.bytes + self.index_bytes;
        true
    }

    fn discard(&mut self, namespace: &str, key: &str) {
        let name = format!("{namespace}-{}-{key}", self.producer_slot);
        if entry_producer(&name).is_some() && self.writable() { let _ = self.erase(&name); }
    }

    fn atomic_publish(&mut self, name: &str, bytes: &[u8]) -> bool {
        let stamp = match self.clock.nanoseconds() { Ok(stamp) => stamp, Err(_) => return false };
        let temporary: String = loop {
            self.sequence = self.sequence.wrapping_add(1);
            let name = format!(".tmp-{stamp}-{}", self.sequence);
            match self.directory.create_directory(&name) {
                Ok(()) => break name,
                Err(17) => continue,
                Err(_) => return false,
            }
        };
        let mut written = false;
        if let Ok(mut directory) = self.directory.open_directory(&temporary) {
            if let Ok(mut file) = directory.create("entry") { written = file.write_all(bytes).is_ok(); }
        }
        let from = format!("{temporary}/entry");
        let published = written && self.directory.rename(&from, name).is_ok();
        let _ = self.directory.remove(&from);
        let _ = self.directory.remove_directory(&temporary);
        published
    }

    fn checkpoint(&mut self) {
        if self.write_state != 1u8 || !self.dirty { return; }
        let payload = self.budget.encode();
        let identity = sha256::digest(b"lkjscript-store-size-index-1");
        let bytes = reuse::seal(&identity[..], &self.secret, "size-index", "1", &payload);
        if self.atomic_publish(".budget-index", &bytes) {
            self.dirty = false;
            self.index_bytes = bytes.len();
        }
        self.retained_bytes = self.budget.bytes + self.index_bytes;
    }

    fn publish(&mut self, namespace: &str, key: &str, bytes: &[u8]) {
    let name = format!("{namespace}-{}-{key}", self.producer_slot);
    self.publish_named(&name, bytes);
}

    pub fn put(&mut self, namespace: &str, key: &str, payload: &[u8]) {
        if payload.len() > self.capacity || !self.writable() { return; }
        let envelope = reuse::seal(&self.producer, &self.secret, namespace, key, payload);
        self.publish(namespace, key, &envelope);
    }

    pub fn flush(&mut self, records: &reuse::Records) {
        self.hits += records.hits;
        self.misses += records.misses;
        self.rejected += records.rejected;
        if let Some(pending) = records.sealed_pack() {
            self.publish(&pending.namespace, &pending.key, &pending.bytes);
        }
    }

    /// Commit policy metadata once at the process boundary, while holding its lock.
    pub fn finish(&mut self) { self.checkpoint(); }
}

impl Drop for Store {
    fn drop(&mut self) { self.finish(); }
}

// Every loader request is recorded, including absent alternative module paths.
// Embedded sources are bound by the producer identity instead of reread here.
#[derive(Clone)]
pub struct Input {
    pub directory: String,
    pub path: String,
    pub digest: Option<String>,
}

pub fn input(directory: &str, path: &str, bytes: &Option<Vec<u8>>) -> Input {
    Input {
        directory: directory.to_string(), path: path.to_string(),
        digest: bytes.as_ref().map(|bytes: &Vec<u8>| sha256::hex_digest(bytes)),
    }
}

pub fn push_word(out: &mut Vec<u8>, value: usize) {
    for shift in 0..8usize { out.push((value >> (shift * 8)) as u8); }
}
pub fn push_bytes(out: &mut Vec<u8>, bytes: &[u8]) {
    push_word(out, bytes.len());
    out.extend_from_slice(bytes);
}
pub struct Reader<'a> {
    bytes: &'a [u8],
    at: usize,
}
impl<'a> Reader<'a> {
    pub fn new(bytes: &'a [u8]) -> Self { Self { bytes, at: 0 } }
    pub fn word(&mut self) -> Option<usize> {
        if self.bytes.len() - self.at < 8 { return None; }
        let mut result = 0usize;
        for shift in 0..8usize { result |= (self.bytes[self.at + shift] as usize) << (shift * 8); }
        self.at += 8;
        Some(result)
    }
    pub fn bytes(&mut self) -> Option<Vec<u8>> {
        let length = self.word()?;
        if length > self.bytes.len() - self.at { return None; }
        let result = self.bytes[self.at..self.at + length].to_vec();
        self.at += length;
        Some(result)
    }
    pub fn text(&mut self) -> Option<String> { String::from_utf8(self.bytes()?).ok() }
    pub fn done(&self) -> bool { self.at == self.bytes.len() }
}

pub fn encode_inputs(inputs: &[Input]) -> Vec<u8> {
    let mut out = Vec::new();
    push_word(&mut out, inputs.len());
    for input in inputs {
        push_bytes(&mut out, input.directory.as_bytes());
        push_bytes(&mut out, input.path.as_bytes());
        match &input.digest {
            Some(digest) => push_bytes(&mut out, digest.as_bytes()),
            None => push_bytes(&mut out, b""),
        }
    }
    out
}

pub fn inputs_match(world: &mut World, bytes: &[u8]) -> bool {
    let mut reader = Reader::new(bytes);
    let count = match reader.word() { Some(count) => count, None => return false };
    // Each record has three length words even when every string is empty.
    if count > bytes.len() / 24 { return false; }
    for _ in 0..count {
        let root = match reader.text() { Some(root) => root, None => return false };
        let path = match reader.text() { Some(path) => path, None => return false };
        let digest = match reader.text() { Some(digest) => digest, None => return false };
        let mut directory = match world.directory(&root) { Ok(dir) => dir, Err(_) => return false };
        match directory.open(&path) {
            Ok(mut file) => {
                if digest.is_empty() { return false; }
                let current = match file.read_to_end() { Ok(bytes) => bytes, Err(_) => return false };
                if sha256::hex_digest(&current) != digest { return false; }
            }
            Err(errno) => { if (errno != 2 && errno != 20) || !digest.is_empty() { return false; } }
        }
    }
    reader.done()
}

fn read_exact(file: &mut File, bytes: &mut [u8]) -> bool {
    let mut at = 0usize;
    while at < bytes.len() {
        let count = match file.read(&mut bytes[at..]) { Ok(count) => count, Err(_) => return false };
        if count == 0 { return false; }
        at += count;
    }
    true
}
fn at_end(file: &mut File) -> bool {
    let mut byte = [0u8; 1];
    match file.read(&mut byte) { Ok(0) => true, _ => false }
}
fn read_envelope(
    file: &mut File, producer: &[u8], secret: &[u8], namespace: &str, key: &str, capacity: usize,
) -> Option<reuse::VerifiedPayload> {
    let mut header = vec![0u8; reuse::header_size()];
    if !read_exact(file, &mut header) { return None; }
    // Authenticate the root before its length may drive allocation. The cap is
    // disposable-store policy, not a source or IR acceptance limit.
    let root = reuse::AuthenticatedRoot::new(producer, secret, namespace, key, &header)?;
    let length = root.length();
    if length.checked_add(header.len())? > capacity { return None; }
    let mut bytes = vec![0u8; length];
    if !read_exact(file, &mut bytes) || !at_end(file) { return None; }
    // Verify exactly these owned bytes once. Concurrent writers, stale roots,
    // swapped entries, truncation and trailing bytes cannot alter this snapshot.
    root.verify(bytes)
}

/// Query-only access never exposes a compiler proof namespace or writer.
pub trait QueryAccess {
    fn query_producer(&self) -> String;
    fn query_bound_root(&self) -> Option<String>;
    fn query_root(&mut self, identity: &str) -> Option<Vec<u8>>;
    fn query_latest(&mut self, selector: &str) -> Option<Vec<u8>>;
    fn query_page(&mut self, identity: &str) -> Option<Vec<u8>>;
    fn query_cursor(&self, question: &str, payload: &[u8]) -> Vec<u8>;
    fn open_query_cursor(&self, question: &str, bytes: &[u8]) -> Option<Vec<u8>>;
    fn invalidate_query_snapshot(&mut self, identity: &str, selector: &str);
}

/// An authenticated historical query capability, never convertible to Store.
pub struct QueryReader {
    directory: Directory,
    secret: Vec<u8>,
    producer: Vec<u8>,
    producer_slot: String,
    identity: String,
    selector: String,
    root: String,
    capacity: usize,
}

fn query_hex(bytes: &[u8]) -> String {
    let alphabet = b"0123456789abcdef";
    let mut result = String::new();
    for byte in bytes {
        result.push(alphabet[(*byte >> 4u8) as usize] as char);
        result.push(alphabet[(*byte & 15u8) as usize] as char);
    }
    result
}

fn query_digest(identity: &str) -> Option<Vec<u8>> {
    if !hex_identity(identity) { return None; }
    let mut bytes = Vec::new();
    for index in 0usize..32usize {
        let high = identity.as_bytes()[index * 2usize];
        let low = identity.as_bytes()[index * 2usize + 1usize];
        let high = if high.is_ascii_digit() { high - b'0' } else { high - b'a' + 10u8 };
        let low = if low.is_ascii_digit() { low - b'0' } else { low - b'a' + 10u8 };
        bytes.push(high * 16u8 + low);
    }
    Some(bytes)
}

fn query_locator_name(identity: &str) -> String { format!("semantic-locator-{identity}") }

fn query_locator_identity(name: &str) -> Option<&str> {
    if !name.starts_with("semantic-locator-") || name.len() != 81usize { return None; }
    let identity = &name[17usize..];
    if hex_identity(identity) { Some(identity) } else { None }
}

fn indexed_name(name: &str) -> bool {
    if name.starts_with("semantic-locator-") { query_locator_identity(name).is_some() }
    else { entry_producer(name).is_some() }
}

fn owned_entry(name: &str, producer: &str) -> bool {
    if !hex_identity(producer) { return false; }
    if name.starts_with("semantic-locator-") { return query_locator_identity(name).is_some(); }
    entry_producer(name).is_some_and(|owner| owner == producer)
}

fn read_store_secret(world: &mut World, key: &str) -> Option<Vec<u8>> {
    let (parent, name) = location(key);
    let mut owner = world.directory(parent).ok()?;
    let mut file = owner.open(name).ok()?;
    let mut secret = vec![0u8; 33usize];
    let mut length = 0usize;
    while length < secret.len() {
        let count = file.read(&mut secret[length..]).ok()?;
        if count == 0usize { break; }
        length += count;
    }
    if length != 32usize { return None; }
    secret.pop();
    Some(secret)
}

fn query_locator_producer() -> [u8; 32] { sha256::digest(b"lkjscript-semantic-locator-2") }

fn read_query_locator(directory: &mut Directory, secret: &[u8], capacity: usize,
    identity: &str) -> Option<(Vec<u8>, String, String)> {
    if !hex_identity(identity) { return None; }
    let mut file = cache_file(directory, &query_locator_name(identity))?;
    let protocol = query_locator_producer();
    let limit = capacity.min(reuse::header_size() + 104usize);
    let payload = read_envelope(&mut file, &protocol, secret, "semantic-locator", identity, limit)?.into_bytes();
    if payload.len() != 104usize { return None; }
    let mut reader = Reader::new(&payload);
    if reader.word() != Some(2usize) { return None; }
    Some((payload[8usize..40usize].to_vec(), query_hex(&payload[40usize..72usize]),
        query_hex(&payload[72usize..104usize])))
}

fn query_cursor_key(producer: &[u8], question: &str) -> String {
    let mut bytes = b"lkjscript-semantic-cursor-question-2"[..].to_vec();
    push_bytes(&mut bytes, producer);
    push_bytes(&mut bytes, question.as_bytes());
    sha256::hex_digest(&bytes)
}

fn seal_query_cursor(producer: &[u8], secret: &[u8], question: &str, payload: &[u8]) -> Vec<u8> {
    let protocol = sha256::digest(b"lkjscript-semantic-cursor-2");
    reuse::seal(&protocol, secret, "semantic-cursor-2", &query_cursor_key(producer, question), payload)
}

fn authenticate_query_cursor(producer: &[u8], secret: &[u8], question: &str, bytes: &[u8]) -> Option<Vec<u8>> {
    let protocol = sha256::digest(b"lkjscript-semantic-cursor-2");
    reuse::authenticate(&protocol, secret, "semantic-cursor-2", &query_cursor_key(producer, question), bytes)
}

impl Store {
    /// The actual executable digest, not the doubly hashed storage slot.
    pub fn query_producer(&self) -> String { query_hex(&self.producer) }
    fn publish_named(&mut self, name: &str, bytes: &[u8]) {
        let valid = owned_entry(name, &self.producer_slot);
        if !valid || !self.writable() { return; }
        if self.budget.entries.contains_key(&name.to_string()) && !self.erase(name) { return; }
        loop {
            let fits = match self.budget.growth(name, &self.producer_slot, bytes.len(), self.index_bytes) {
                Some(size) => size <= self.capacity, None => false,
            };
            if fits { break; }
            if !self.evict_oldest() {
                self.checkpoint();
                let fits = match self.budget.growth(name, &self.producer_slot, bytes.len(), self.index_bytes) {
                    Some(size) => size <= self.capacity, None => false,
                };
                if fits { break; }
                return;
            }
        }
        if self.atomic_publish(name, bytes) {
            self.budget.remember(name, &self.producer_slot, bytes.len());
            self.dirty = true;
            self.writes += 1usize;
            self.retained_bytes = self.budget.bytes + self.index_bytes;
        }
    }
    pub fn publish_query_locator(&mut self, identity: &str, selector: &str, root: &str) -> bool {
        if !hex_identity(identity) || self.producer.len() != 32usize { return false; }
        let Some(selector_bytes) = query_digest(selector) else { return false; };
        let Some(root_bytes) = query_digest(root) else { return false; };
        let mut payload = Vec::new();
        push_word(&mut payload, 2usize);
        payload.extend_from_slice(&self.producer);
        payload.extend_from_slice(&selector_bytes);
        payload.extend_from_slice(&root_bytes);
        let protocol = query_locator_producer();
        let bytes = reuse::seal(&protocol, &self.secret, "semantic-locator", identity, &payload);
        self.publish_named(&query_locator_name(identity), &bytes);
        self.query_locator_retained(identity, selector, root)
    }
    pub fn query_locator_retained(&mut self, identity: &str, selector: &str, root: &str) -> bool {
        let Some((producer, actual_selector, actual_root)) =
            read_query_locator(&mut self.directory, &self.secret, self.capacity, identity) else { return false; };
        producer == self.producer && actual_selector == selector && actual_root == root
    }
}

impl QueryAccess for Store {
    fn query_producer(&self) -> String { query_hex(&self.producer) }
    fn query_bound_root(&self) -> Option<String> { None }
    fn query_root(&mut self, identity: &str) -> Option<Vec<u8>> {
        if !hex_identity(identity) { return None; }
        self.get("semantic-root", identity)
    }
    fn query_latest(&mut self, selector: &str) -> Option<Vec<u8>> {
        if !hex_identity(selector) { return None; }
        self.get("semantic-latest", selector)
    }
    fn query_page(&mut self, identity: &str) -> Option<Vec<u8>> {
        if !hex_identity(identity) { return None; }
        self.get("semantic-page", identity)
    }
    fn query_cursor(&self, question: &str, payload: &[u8]) -> Vec<u8> {
        seal_query_cursor(&self.producer, &self.secret, question, payload)
    }
    fn open_query_cursor(&self, question: &str, bytes: &[u8]) -> Option<Vec<u8>> {
        authenticate_query_cursor(&self.producer, &self.secret, question, bytes)
    }
    fn invalidate_query_snapshot(&mut self, identity: &str, selector: &str) {
        invalidate_store_query_snapshot(self, identity, selector)
    }
}

impl QueryReader {
    pub fn open(world: &mut World, path: &Option<String>, key: &Option<String>, capacity: usize,
        identity: &str, selector: &str) -> Result<Self, String> {
        if !hex_identity(identity) || !hex_identity(selector) {
            return Err("E_QUERY_SNAPSHOT expected exact snapshot and selector digests".to_string());
        }
        let path = path.as_ref().ok_or("E_QUERY_STORE query needs an authenticated --store and --store-key")?;
        let key = key.as_ref().ok_or("E_QUERY_STORE query needs an authenticated --store and --store-key")?;
        let secret = read_store_secret(world, key)
            .ok_or("E_QUERY_STORE query key must be readable and contain exactly 32 bytes")?;
        let mut directory = world.directory(path).map_err(|_: i64| -> String {
            "E_QUERY_STORE query store is unavailable".to_string()
        })?;
        let (producer, actual_selector, root) = read_query_locator(&mut directory, &secret, capacity, identity)
            .ok_or("E_QUERY_SNAPSHOT no authenticated pinned locator; build with --index first")?;
        if actual_selector != selector {
            return Err("E_QUERY_SNAPSHOT snapshot belongs to another source selection".to_string());
        }
        let producer_slot = sha256::hex_digest(&producer);
        Ok(Self { directory, secret, producer, producer_slot,
            identity: identity.to_string(), selector: selector.to_string(), root, capacity })
    }
    fn raw(&mut self, namespace: &str, identity: &str, limit: usize) -> Option<Vec<u8>> {
        if !hex_identity(identity) { return None; }
        let name = format!("{namespace}-{}-{identity}", self.producer_slot);
        let mut file = cache_file(&mut self.directory, &name)?;
        read_envelope(&mut file, &self.producer, &self.secret, namespace, identity,
            self.capacity.min(limit)).map(|payload| payload.into_bytes())
    }
}

impl QueryAccess for QueryReader {
    fn query_producer(&self) -> String { query_hex(&self.producer) }
    fn query_bound_root(&self) -> Option<String> { Some(self.root.clone()) }
    fn query_root(&mut self, identity: &str) -> Option<Vec<u8>> {
        if identity != self.identity { return None; }
        // Snapshot v2: version + five length-framed 64-byte digests + fact count.
        self.raw("semantic-root", identity, reuse::header_size() + 376usize)
    }
    fn query_latest(&mut self, _selector: &str) -> Option<Vec<u8>> { None }
    fn query_page(&mut self, identity: &str) -> Option<Vec<u8>> {
        self.raw("semantic-page", identity, reuse::header_size() + 32768usize)
    }
    fn query_cursor(&self, question: &str, payload: &[u8]) -> Vec<u8> {
        seal_query_cursor(&self.producer, &self.secret, question, payload)
    }
    fn open_query_cursor(&self, question: &str, bytes: &[u8]) -> Option<Vec<u8>> {
        authenticate_query_cursor(&self.producer, &self.secret, question, bytes)
    }
    fn invalidate_query_snapshot(&mut self, identity: &str, selector: &str) {
        if identity != self.identity || selector != self.selector { return; }
        let root = format!("semantic-root-{}-{identity}", self.producer_slot);
        let locator = query_locator_name(identity);
        let _ = self.directory.remove(&root);
        let _ = self.directory.remove(&locator);
        // Never unlink latest without the ordinary writer lock: another build
        // may replace it after a reader compares its authenticated payload.
        // These removals only overcharge the signed budget until its next writer.
    }
}

fn invalidate_store_query_snapshot(store: &mut Store, identity: &str, selector: &str) {
    if !store.writable() { return; }
    // Compare latest while holding the same lock as every ordinary publisher.
    let latest_matches = store.get("semantic-latest", selector)
        .is_some_and(|bytes| sha256::hex_digest(&bytes) == identity);
    store.discard("semantic-root", identity);
    if latest_matches { store.discard("semantic-latest", selector); }
    let name = query_locator_name(identity);
    if hex_identity(identity)
        && store.budget.entries.get(&name).is_some_and(|entry| entry.producer == store.producer_slot) {
        let _ = store.erase(&name);
    }
}

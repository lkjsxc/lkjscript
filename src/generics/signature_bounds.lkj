//! Argument-aware trait proofs for symbolic implementation signatures.
//!
//! Implementation parameters are flexible patterns; the caller's parameters
//! remain rigid. Every selected implementation's bounds are proved in turn.
//! The complete applied trait is matched together with its receiver. Declaration
//! parameters and implementation parameters have independent environments.
use super::*;

type Goal = (usize, usize);

#[derive(Default)]
struct Canonical {
    terms: BTreeMap<Term, usize>,
    ids: BTreeMap<usize, usize>,
}
impl Canonical {
    fn term(&mut self, terms: &[Term], first: usize) -> usize {
        let mut work = vec![(first, false)];
        let empty: Vec<usize> = Vec::new();
        while let Some((id, finish)) = work.pop() {
            if self.ids.contains_key(&id) {
                continue;
            }
            let children = match &terms[id] {
                Term::Named(_, children) | Term::DeclaredTrait(_, children) => children.as_slice(),
                _ => empty.as_slice(),
            };
            if !finish {
                work.push((id, true));
                let mut index = children.len();
                while index > 0 {
                    index -= 1;
                    work.push((children[index], false));
                }
                continue;
            }
            let mut child_ids = Vec::new();
            for child in children {
                child_ids.push(*self.ids.get(child).unwrap());
            }
            let key = match &terms[id] {
                Term::Named(name, _) => Term::Named(name.clone(), child_ids),
                Term::DeclaredTrait(declaration, _) => Term::DeclaredTrait(*declaration, child_ids),
                leaf => leaf.clone(),
            };
            let canonical = match self.terms.get(&key) {
                Some(previous) => *previous,
                None => {
                    self.terms.insert(key, id);
                    id
                }
            };
            self.ids.insert(id, canonical);
        }
        *self.ids.get(&first).unwrap()
    }
    fn goal(&mut self, terms: &[Term], goal: Goal) -> Goal {
        let (ty, bound) = goal;
        (self.term(terms, ty), self.term(terms, bound))
    }
}

/// Match only implementation variables. Query variables cannot be unified with
/// a concrete type merely to make an implementation appear applicable.
fn match_terms(
    terms: &[Term],
    pairs: Vec<Goal>,
    flexible: &BTreeSet<usize>,
    mut substitutions: BTreeMap<usize, usize>,
) -> Option<BTreeMap<usize, usize>> {
    let mut pending = pairs;
    while let Some((pattern, actual)) = pending.pop() {
        if let Term::Variable(variable) | Term::ConstantVariable(variable) = terms[pattern] {
            if flexible.contains(&variable) {
                let constant_pattern = matches!(terms[pattern], Term::ConstantVariable(_));
                let constant_actual = matches!(terms[actual], Term::Constant(_) | Term::ConstantVariable(_));
                if constant_pattern != constant_actual { return None; }
                let previous = substitutions.get(&variable).copied();
                if let Some(previous) = previous {
                    if !equivalent(terms, previous, actual) {
                        return None;
                    }
                } else {
                    substitutions.insert(variable, actual);
                }
                continue;
            }
        }
        match (&terms[pattern], &terms[actual]) {
            (Term::Variable(a), Term::Variable(b)) if a == b => {}
            (Term::ConstantVariable(a), Term::ConstantVariable(b)) if a == b => {}
            (Term::Constant(a), Term::Constant(b)) if a == b => {}
            (Term::Named(a, ac), Term::Named(b, bc)) if a == b && ac.len() == bc.len() => {
                for index in 0..ac.len() {
                    pending.push((ac[index], bc[index]));
                }
            }
            (Term::DeclaredTrait(a, ac), Term::DeclaredTrait(b, bc))
                if a == b && ac.len() == bc.len() =>
            {
                for index in 0..ac.len() {
                    pending.push((ac[index], bc[index]));
                }
            }
            _ => return None,
        }
    }
    Some(substitutions)
}

fn prerequisites(
    source: &Program,
    index: &ImplementationIndex,
    terms: &mut Vec<Term>,
    goal: Goal,
    known: &[Goal],
    projection: &Option<(String, usize)>,
) -> Result<Option<Vec<Goal>>, Diagnostic> {
    let (ty, bound) = goal;
    let mut equality = None;
    let mut selected_bound = bound;
    if let Term::Named(name, constraints) = &terms[bound] {
        if name == "$associated-bound" {
            return Ok(Some(constraints.iter().map(|constraint| (ty, *constraint)).collect()));
        }
        if name == "$associated-equality" && constraints.len() == 3 {
            selected_bound = constraints[0];
            let Term::Named(member, arguments) = &terms[constraints[1]] else { return Ok(None); };
            if !arguments.is_empty() { return Ok(None); }
            let Some(member) = member.as_str().strip_prefix("$associated-member:") else { return Ok(None); };
            equality = Some((member.to_string(), constraints[2]));
        }
    }
    let declaration = match &terms[selected_bound] {
        Term::DeclaredTrait(declaration, _) => *declaration,
        _ => return Ok(None),
    };
    let Some(candidates) = index.by_trait.get(&TraitIdentity::Declared(declaration)) else {
        return Ok(None);
    };
    let head = term_head(terms, ty);
    let mut selected = None;
    for candidate in candidates.matching(optional_name(&head)) {
        let implementation = &source.impls[candidate];
        let Some(trait_ty) = implementation.trait_ty else {
            continue;
        };
        // All existing variable identities are below the arena's next index.
        let mut next = terms.len();
        let environment = variables(source, &implementation.generics, terms, &mut next);
        let mut flexible = BTreeSet::new();
        for id in environment.values() {
            if let Term::Variable(variable) | Term::ConstantVariable(variable) = terms[*id] {
                flexible.insert(variable);
            }
        }
        let target = signature_type(source, implementation.target, &environment, terms)?;
        let implemented = signature_type(source, trait_ty, &environment, terms)?;
        let Some(mut substitutions) = match_terms(
            terms,
            vec![(target, ty), (implemented, selected_bound)],
            &flexible,
            BTreeMap::new(),
        ) else {
            continue;
        };
        // Callable output equations may determine an implementation parameter
        // absent from its nominal target. Only implementation variables are
        // flexible; the caller's type/region variables remain rigid.
        loop {
            let before = substitutions.len();
            let mut current = BTreeMap::new();
            for (name, id) in &environment {
                let value = match terms[*id] {
                    Term::Variable(variable) | Term::ConstantVariable(variable) => {
                        substitutions.get(&variable).copied().unwrap_or(*id)
                    }
                    _ => *id,
                };
                current.insert(name.clone(), value);
            }
            // Callable equations use the same trait-qualified projection as
            // the caller's known bound. Keep the parameter arena itself free
            // of derived entries: only its original variables are flexible.
            parameter_projection_terms(source, &implementation.generics, &mut current, terms);
            for parameter in &implementation.generics {
                if parameter.lifetime {
                    continue;
                }
                let value = *current.get(&parameter.name).unwrap();
                if matches!(terms[value], Term::Variable(variable) | Term::ConstantVariable(variable) if flexible.contains(&variable))
                {
                    continue;
                }
                for constraint in &parameter.bounds {
                    if !matches!(&source.types[*constraint].kind, Type::Path(path)
                        if path.declaration.is_none() && matches!(path.name.as_str(), "Fn" | "FnMut" | "FnOnce"))
                    {
                        continue;
                    }
                    let pattern = signature_type(source, *constraint, &current, terms)?;
                    let mut found: Option<BTreeMap<usize, usize>> = None;
                    let mut ambiguous = false;
                    for (known_ty, known_bound) in known {
                        if !equivalent(terms, value, *known_ty) {
                            continue;
                        }
                        let Some(candidate) = match_terms(
                            terms,
                            vec![(pattern, *known_bound)],
                            &flexible,
                            substitutions.clone(),
                        ) else {
                            continue;
                        };
                        if found.as_ref().is_some_and(|prior| {
                            prior.len() != candidate.len()
                                || prior.iter().any(|(variable, previous)| {
                                    candidate
                                        .get(variable)
                                        .is_none_or(|next| !equivalent(terms, *previous, *next))
                                })
                        }) {
                            ambiguous = true;
                            break;
                        }
                        found = Some(candidate);
                    }
                    if !ambiguous {
                        if let Some(found) = found {
                            substitutions = found;
                        }
                    }
                }
            }
            if substitutions.len() == before {
                break;
            }
        }
        let mut resolved = BTreeMap::new();
        let mut complete = true;
        for (name, id) in environment {
            let value = match terms[id] {
                Term::Variable(variable) | Term::ConstantVariable(variable) => substitutions.get(&variable).copied(),
                _ => None,
            };
            if let Some(value) = value {
                resolved.insert(name, value);
            } else {
                complete = false;
                break;
            }
        }
        if !complete {
            continue;
        }
        let mut environment = resolved;
        environment.insert("Self".to_string(), ty);
        parameter_projection_terms(source, &implementation.generics, &mut environment, terms);
        if (projection.is_some() || equality.is_some() || !implementation.predicates.is_empty() || !source.traits[declaration].predicates.is_empty())
            && !implementation_projection_terms(source, candidate, implementation, declaration, &mut environment, terms)? {
            continue;
        }
        let mut declared = implemented_trait_environment(source, declaration, selected_bound, ty, &environment, terms);
        parameter_projection_terms(source, &source.traits[declaration].generics, &mut declared, terms);
        if let Some((member, expected)) = &equality {
            let supplied = implementation.associated.iter().find(|item| item.name == *member).and_then(|item| item.value);
            let definition = supplied.or_else(|| source.traits[declaration].associated.iter()
                .find(|item| item.name == *member).and_then(|item| item.value));
            let Some(definition) = definition else { continue; };
            let actual = signature_type(source, definition, if supplied.is_some() { &environment } else { &declared }, terms)?;
            if !equivalent(terms, actual, *expected) { continue; }
        }
        let mut children = Vec::new();
        for parameter in &implementation.generics {
            if parameter.lifetime {
                continue;
            }
            let value = *environment.get(&parameter.name).unwrap();
            if parameter_requires_sized(source, parameter) {
                let sized = push(terms, Term::Named("Sized".to_string(), Vec::new()));
                children.push((value, sized));
            }
            for constraint in &parameter.bounds {
                if source.relaxed_bounds.contains(constraint) { continue; }
                children.push((
                    value,
                    signature_type(source, *constraint, &environment, terms)?,
                ));
            }
        }
        for constraint in &source.traits[declaration].bounds {
            children.push((
                ty,
                signature_type(source, *constraint, &declared, terms)?,
            ));
        }
        for predicate in &implementation.predicates {
            let receiver = signature_type(source, predicate.target, &environment, terms)?;
            for bound in &predicate.bounds {
                children.push((receiver, signature_type(source, *bound, &environment, terms)?));
            }
        }
        for predicate in &source.traits[declaration].predicates {
            let receiver = signature_type(source, predicate.target, &declared, terms)?;
            for bound in &predicate.bounds {
                children.push((receiver, signature_type(source, *bound, &declared, terms)?));
            }
        }
        for parameter in &source.traits[declaration].generics {
            let Some(value) = declared.get(&parameter.name).copied() else { continue; };
            if parameter_requires_sized(source, parameter) {
                let sized = push(terms, Term::Named("Sized".to_string(), Vec::new())); children.push((value, sized));
            }
            for bound in &parameter.bounds {
                if !source.relaxed_bounds.contains(bound) { children.push((value, signature_type(source, *bound, &declared, terms)?)); }
            }
        }
        if let Some((member, bound)) = projection {
            let Some(value) = environment.get(&format!("Self::{member}")) else { continue; };
            children.push((*value, *bound));
        }
        // Coherence normally ensures uniqueness; never choose arbitrarily if a
        // caller provides source that has not passed that global validation.
        if selected.is_some() {
            return Ok(None);
        }
        selected = Some(children);
    }
    Ok(selected)
}

fn projection(terms: &[Term], ty: usize) -> Option<(Goal, String)> {
    let Term::Named(name, children) = &terms[ty] else { return None; };
    let member = name.as_str().strip_prefix("$projection:")?;
    if children.len() != 2 { return None; }
    if !matches!(&terms[children[1]], Term::DeclaredTrait(_, _)) {
        return None;
    }
    Some(((children[0], children[1]), member.to_string()))
}

fn declared_projection_bound(source: &Program, terms: &mut Vec<Term>, goal: Goal, known: &[Goal]) -> Result<bool, Diagnostic> {
    let Some(((receiver, owner), member)) = projection(terms, goal.0) else { return Ok(false); };
    if !known.iter().any(|(ty, bound)| equivalent(terms, receiver, *ty) && equivalent(terms, owner, *bound)) {
        return Ok(false);
    }
    let (declaration, argument_count) = match &terms[owner] {
        Term::DeclaredTrait(declaration, arguments) => (*declaration, arguments.len()),
        _ => return Ok(false),
    };
    let declared = &source.traits[declaration];
    if declared.generics.len() != argument_count { return Ok(false); }
    // The exact applied owner is an assumption. Instantiate its member's
    // contract with the owner's arguments, keeping sibling projections symbolic.
    let mut environment = implemented_trait_environment(source, declaration, owner, receiver, &BTreeMap::new(), terms);
    parameter_projection_terms(source, &declared.generics, &mut environment, terms);
    let mut bounds = Vec::new();
    for item in &declared.associated {
        if !item.generics.is_empty() { continue; }
        if item.name == member { bounds = item.bounds.clone(); }
        let value = push(terms, Term::Named(projection_name(&item.name), vec![receiver, owner]));
        environment.insert(format!("Self::{}", item.name), value);
        environment.insert(format!("$self-projection:{declaration}:{}", item.name), value);
    }
    environment.insert("$bound-self".to_string(), goal.0);
    for constraint in bounds {
        let bound = signature_type(source, constraint, &environment, terms)?;
        for inherited in bound_closure(source, bound, goal.0, terms)? {
            if equivalent(terms, goal.1, inherited) { return Ok(true); }
        }
    }
    Ok(false)
}

fn concrete_projection(terms: &[Term], ty: usize) -> Option<(Goal, String)> {
    let ((receiver, owner), member) = projection(terms, ty)?;
    let mut pending = vec![receiver, owner];
    while let Some(ty) = pending.pop() {
        match &terms[ty] {
            Term::Unknown | Term::Variable(_) | Term::ConstantVariable(_) => return None,
            Term::Constant(_) => {}
            Term::Named(name, children) => {
                if name.starts_with("$projection:") { return None; }
                pending.extend_from_slice(children);
            }
            Term::DeclaredTrait(_, children) => pending.extend_from_slice(children),
        }
    }
    Some(((receiver, owner), member))
}

fn term_contains(terms: &[Term], outer: usize, inner: usize) -> bool {
    let mut pending = vec![outer];
    let mut seen = BTreeSet::new();
    while let Some(value) = pending.pop() {
        if equivalent(terms, value, inner) { return true; }
        if !seen.insert(value) { continue; }
        match &terms[value] {
            Term::Named(_, children) | Term::DeclaredTrait(_, children) => pending.extend_from_slice(children),
            _ => {}
        }
    }
    false
}

fn expanding_goal(terms: &[Term], goal: Goal, previous: Goal) -> bool {
    let (Term::DeclaredTrait(owner, arguments), Term::DeclaredTrait(earlier_owner, earlier)) =
        (&terms[goal.1], &terms[previous.1]) else { return false; };
    if owner != earlier_owner || arguments.len() != earlier.len() || !term_contains(terms, goal.0, previous.0) { return false; }
    let mut larger = !equivalent(terms, goal.0, previous.0);
    for position in 0..arguments.len() {
        if !term_contains(terms, arguments[position], earlier[position]) { return false; }
        larger = larger || !equivalent(terms, arguments[position], earlier[position]);
    }
    larger
}

pub(super) fn prove(
    source: &Program,
    index: &ImplementationIndex,
    terms: &mut Vec<Term>,
    ty: usize,
    bound: usize,
    known: &[Goal],
) -> Result<bool, Diagnostic> {
    if sized_bounds::symbolic_goal(source, terms, ty, bound, known) || symbolic_bound(terms, ty, bound, known) {
        return Ok(true);
    }
    let mut canonical = Canonical::default();
    let first = canonical.goal(terms, (ty, bound));
    // 0 is active, 1 disproved, 2 proved. A user-implementation cycle is not
    // evidence; structural builtin proofs are already handled independently.
    let mut state = BTreeMap::<Goal, u8>::new();
    let mut pending: Vec<(Goal, Option<Vec<Goal>>)> = vec![(first, None)];
    while let Some((goal, children)) = pending.pop() {
        if let Some(children) = children {
            let unfinished = state.get(&goal).copied() != Some(1u8);
            if unfinished {
                let mut valid = true;
                for child in &children {
                    if state.get(child).copied() != Some(2u8) {
                        valid = false;
                        break;
                    }
                }
                state.insert(goal, if valid { 2u8 } else { 1u8 });
            }
            continue;
        }
        let previous = state.get(&goal).copied();
        if let Some(previous) = previous {
            if previous == 0 {
                state.insert(goal, 1);
            }
            continue;
        }
        if sized_bounds::symbolic_goal(source, terms, goal.0, goal.1, known)
            || symbolic_bound(terms, goal.0, goal.1, known)
            || declared_projection_bound(source, terms, goal, known)? {
            state.insert(goal, 2);
            continue;
        }
        let mut expanding = false;
        for (previous, status) in &state {
            if *status == 0u8 && expanding_goal(terms, goal, *previous) { expanding = true; break; }
        }
        if expanding {
            state.insert(goal, 1); continue;
        }
        // A concrete projection may belong to a different trait than the
        // implementation whose signature is being checked. Select that exact
        // owner and retain all its prerequisites before using its type equation.
        let children = if let Some((owner, member)) = concrete_projection(terms, goal.0) {
            prerequisites(source, index, terms, owner, known, &Some((member, goal.1)))?
        } else {
            prerequisites(source, index, terms, goal, known, &None)?
        };
        let Some(children) = children else {
            state.insert(goal, 1);
            continue;
        };
        let mut canonical_children: Vec<Goal> = Vec::new();
        for child in children {
            canonical_children.push(canonical.goal(terms, child));
        }
        let mut children = canonical_children;
        state.insert(goal, 0);
        pending.push((goal, Some(children.clone())));
        while let Some(child) = children.pop() {
            pending.push((child, None));
        }
    }
    Ok(state.get(&first).copied() == Some(2u8))
}

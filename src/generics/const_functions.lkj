//! Source const qualification is separate from constant evaluation.
//! Runtime calls use ordinary IR. Unsupported constant calls never run at compile time.
use super::*;

// A nominal namespace is not itself a constructor: Holder::new and
// Alias::ordinary are functions. Retain the exact selected member identity.
pub(crate) fn const_data_constructor(source: &Program, path: &Path) -> bool {
    let Some(mut declaration) = path.declaration else { return false; };
    let owner = source.declarations[declaration].name.clone();
    let prefix = format!("{owner}::");
    let member = if path.name == owner { String::new() }
        else if path.name.starts_with(&prefix) { path.name[prefix.len()..].to_string() }
        else { return false; };
    if member.contains("::") { return false; }
    let mut aliases = BTreeSet::new();
    let mut aliased = false;
    loop {
        match source.declarations[declaration].item {
            Item::Struct(index) => return !aliased && member.is_empty() && source.structs[index].tuple,
            Item::Enum(index) => {
                if member.is_empty() { return false; }
                for variant in &source.enums[index].variants {
                    if variant.name == member && matches!(variant.style, VariantStyle::Tuple) {
                        return true;
                    }
                }
                return false;
            }
            Item::Alias(index) => {
                if !aliases.insert(declaration) { return false; }
                aliased = true;
                let Type::Path(target) = &source.types[source.aliases[index].ty].kind
                    else { return false; };
                let Some(next) = target.declaration else { return false; };
                declaration = next;
            }
            _ => return false,
        }
    }
}

fn associated_initializer(source: &Program, names: &crate::resolve::Resolver<'_>, index: usize,
    edges: &mut Vec<Edge>) -> Result<(), Diagnostic> {
    let mut pending = vec![source.constants[index].value];
    while let Some(expression) = pending.pop() {
        let node = &source.exprs[expression];
        match &node.kind {
            Expr::Int(_) | Expr::Float(_) | Expr::Bool(_) | Expr::Char(_) => continue,
            Expr::Unary { op, value } if op == "-" && matches!(&source.exprs[*value].kind, Expr::Int(_)) => continue,
            Expr::Tuple(items) => {
                pending.extend_from_slice(items);
                continue;
            }
            Expr::Struct { fields, base: None, .. } => {
                for (_, value) in fields { pending.push(*value); }
                continue;
            }
            Expr::Call { callee, args } => {
                let callee = &source.exprs[*callee];
                if let Expr::Path(path) = &callee.kind {
                    let path = names.value_path(callee.scope, path, callee.span)?;
                    if const_data_constructor(source, &path) {
                        pending.extend_from_slice(args);
                        continue;
                    }
                }
            }
            Expr::Path(path) => {
                let path = names.value_path(node.scope, path, node.span)?;
                if let Some(declaration) = path.declaration {
                    let entry = &source.declarations[declaration];
                    let inert = match entry.item {
                        Item::Constant(target) if source.constants[target].owner.is_some() => {
                            edges.push(Edge { from: index, to: target, expanding: false,
                                unknown: false, span: node.span });
                            true
                        }
                        Item::Struct(index) => source.structs[index].unit && path.name == entry.name,
                        Item::Enum(index) => source.enums[index].variants.iter().any(|variant|
                            variant.style == VariantStyle::Unit && path.name == qualified(&entry.name, &variant.name)),
                        _ => false,
                    };
                    if inert { continue; }
                }
            }
            _ => {}
        }
        return Err(Diagnostic::new(node.span, "E_UNSUPPORTED",
            "associated constant initializer requires literal data, data constructors or another inherent constant"));
    }
    Ok(())
}

pub(super) fn validate(source: &Program) -> Result<(), Diagnostic> {
    for (index, function) in source.functions.iter().enumerate() {
        if !function.const_qualified { continue; }
        match source.function_owner(FunctionId { index }) {
            FunctionOwner::Free => {}
            FunctionOwner::Implementation(owner) if source.impls[owner.index].trait_ty.is_none() => {}
            _ => return Err(Diagnostic::new(function.span, "E_UNSUPPORTED",
                "const fn is supported on free functions and inherent methods, not trait methods")),
        }
        if function.body.is_none() {
            return Err(Diagnostic::new(function.span, "E_TYPE", "const fn requires a body"));
        }
    }
    // Initializers are currently projected into ordinary execution. Do not
    // silently turn an apparent compile-time const call into a runtime call.
    let names = crate::resolve::Resolver::new(source)?;
    let mut edges = Vec::new();
    for (index, constant) in source.constants.iter().enumerate() {
        if constant.owner.is_some() {
            associated_initializer(source, &names, index, &mut edges)?;
            continue;
        }
        let span = source.exprs[constant.value].span;
        for expression in &source.exprs {
            if expression.span.file != span.file || expression.span.start < span.start
                || expression.span.end > span.end { continue; }
            let call = match &expression.kind {
                Expr::Call { callee, .. } => {
                    match &source.exprs[*callee].kind {
                        Expr::Path(path) => {
                            let resolved = names.value_path(source.exprs[*callee].scope, path, expression.span)?;
                            !const_data_constructor(source, &resolved)
                        }
                        _ => true,
                    }
                }
                Expr::Method { .. } => true,
                _ => false,
            };
            if call {
                return Err(Diagnostic::new(expression.span, "E_UNSUPPORTED",
                    "function calls in constant initializers require compile-time evaluation; const fn runtime calls are supported"));
            }
        }
    }
    constant_dependency_cycles(source.constants.len(), &edges)?;
    Ok(())
}

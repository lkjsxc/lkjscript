//! Exact IR signatures for authority-bearing host operations.
use crate::ir::*;

fn authority(types: &[Type], ty: usize, kind: &TypeKind) -> bool {
    matches!(types[ty].kind, TypeKind::Ref { inner, mutable: true }
        if types[inner].kind == *kind)
}
fn bytes(types: &[Type], ty: usize, mutable: bool) -> bool {
    matches!(types[ty].kind, TypeKind::Ref { inner, mutable: m } if m == mutable
        && matches!(types[inner].kind, TypeKind::Slice { inner: byte, mutable: false } if byte == U8))
}
fn opened(types: &[Type], ty: usize, kind: &TypeKind) -> bool {
    match &types[ty].kind {
        TypeKind::Enum {
            variants,
            copy: false,
        } if variants.len() == 2 => {
            variants[0].fields.len() == 1
                && variants[1].fields.len() == 1
                && types[variants[0].fields[0].ty].kind == *kind
                && variants[1].fields[0].ty == I64
        }
        _ => false,
    }
}
fn status_result(types: &[Type], ty: usize) -> bool {
    match &types[ty].kind {
        TypeKind::Enum { variants, .. } if variants.len() == 2 => {
            variants[0].fields.len() == 1 && variants[0].fields[0].ty == UNIT
                && variants[1].fields.len() == 1 && variants[1].fields[0].ty == I64
        }
        _ => false,
    }
}
fn scalar_result(types: &[Type], ty: usize, success: &TypeKind) -> bool {
    match &types[ty].kind {
        TypeKind::Enum { variants, .. } if variants.len() == 2 => {
            variants[0].fields.len() == 1 && types[variants[0].fields[0].ty].kind == *success
                && variants[1].fields.len() == 1 && variants[1].fields[0].ty == I64
        }
        _ => false,
    }
}
fn events_result(types: &[Type], ty: usize) -> bool {
    let TypeKind::Enum { variants, copy: false } = &types[ty].kind else { return false; };
    if variants.len() != 2 || variants[0].fields.len() != 1 || variants[1].fields.len() != 1 || variants[1].fields[0].ty != I64 { return false; }
    let TypeKind::Vec { inner } = types[variants[0].fields[0].ty].kind else { return false; };
    matches!(&types[inner].kind, TypeKind::Struct { fields, copy: true }
        if fields.len() == 2 && fields[0].ty == U64 && fields[1].ty == U8)
}
fn files(types: &[Type], ty: usize) -> bool {
    matches!(types[ty].kind, TypeKind::Vec { inner } if types[inner].kind == TypeKind::File)
}
fn message_result(types: &[Type], ty: usize) -> bool {
    let TypeKind::Enum { variants, copy: false } = &types[ty].kind else { return false; };
    if variants.len() != 2 || variants[0].fields.len() != 1 || variants[1].fields.len() != 1 || variants[1].fields[0].ty != I64 { return false; }
    matches!(&types[variants[0].fields[0].ty].kind, TypeKind::Struct { fields, copy: false }
        if fields.len() == 2 && fields[0].ty == U64 && files(types, fields[1].ty))
}
pub(super) fn signature(

    types: &[Type],
    result: usize,
    args: &[usize],
    name: IntrinsicOp,
) -> Option<bool> {
    let valid = match name {
        IntrinsicOp::WorldStdout | IntrinsicOp::WorldStdin | IntrinsicOp::WorldStderr => {
            let kind = match name {
                IntrinsicOp::WorldStdout => TypeKind::Stdout,
                IntrinsicOp::WorldStdin => TypeKind::Stdin,
                _ => TypeKind::Stderr,
            };
            args.len() == 1
                && authority(types, args[0], &TypeKind::World)
                && types[result].kind == kind
        }
        IntrinsicOp::WorldArgCount => {
            args.len() == 1 && (authority(types, args[0], &TypeKind::World) || authority(types, args[0], &TypeKind::Arguments)) && result == U64
        }
        IntrinsicOp::WorldArgLen => {
            args.len() == 2
                && (authority(types, args[0], &TypeKind::World) || authority(types, args[0], &TypeKind::Arguments))
                && args[1] == U64
                && result == U64
        }
        IntrinsicOp::WorldArgCopy => {
            args.len() == 3
                && (authority(types, args[0], &TypeKind::World) || authority(types, args[0], &TypeKind::Arguments))
                && args[1] == U64
                && bytes(types, args[2], true)
                && result == U64
        }
        IntrinsicOp::EnvironmentLen => {
            args.len() == 1 && authority(types, args[0], &TypeKind::Environment) && result == I64
        }
        IntrinsicOp::EnvironmentCopy => {
            args.len() == 2 && authority(types, args[0], &TypeKind::Environment)
                && bytes(types, args[1], true) && result == U64
        }
        IntrinsicOp::WorldExitStatus => {
            args.len() == 2
                && (authority(types, args[0], &TypeKind::World) || authority(types, args[0], &TypeKind::ExitStatus))
                && args[1] == U8
                && result == UNIT
        }
        IntrinsicOp::WorldEntropy => {
            args.len() == 1 && authority(types, args[0], &TypeKind::World) && types[result].kind == TypeKind::Entropy
        }
        IntrinsicOp::EntropyFill => {
            args.len() == 2 && authority(types, args[0], &TypeKind::Entropy)
                && bytes(types, args[1], true) && status_result(types, result)
        }
        IntrinsicOp::ClockUnixNanoseconds => {
            args.len() == 1 && authority(types, args[0], &TypeKind::Clock)
                && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: false })
        }
        IntrinsicOp::ClockUnixSeconds => {
            args.len() == 1 && authority(types, args[0], &TypeKind::Clock)
                && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: true })
        }
        IntrinsicOp::FileSetPrivate | IntrinsicOp::ChildRequestStop => {
            let kind = if name == IntrinsicOp::FileSetPrivate { TypeKind::File } else { TypeKind::Child };
            args.len() == 1 && authority(types, args[0], &kind) && status_result(types, result)
        }
        IntrinsicOp::WorldStop => {
            args.len() == 1 && authority(types, args[0], &TypeKind::World) && opened(types, result, &TypeKind::Stop)
        }
        IntrinsicOp::StopRequested | IntrinsicOp::StopTarget => {
            let success = if name == IntrinsicOp::StopRequested { TypeKind::Bool } else { TypeKind::Int { bits: 32, signed: false } };
            args.len() == 1 && authority(types, args[0], &TypeKind::Stop) && scalar_result(types, result, &success)
        }
        IntrinsicOp::ReadinessWatchStop => {
            args.len() == 3 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &TypeKind::Stop) && args[2] == U64 && status_result(types, result)
        }
        IntrinsicOp::ReadinessUnwatchStop => {
            args.len() == 2 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &TypeKind::Stop) && status_result(types, result)
        }
        IntrinsicOp::WorldReadiness => {
            args.len() == 1 && authority(types, args[0], &TypeKind::World)
                && opened(types, result, &TypeKind::Readiness)
        }
        IntrinsicOp::FileSetNonblocking | IntrinsicOp::ListenerSetNonblocking => {
            let kind = if name == IntrinsicOp::FileSetNonblocking { TypeKind::File } else { TypeKind::Listener };
            args.len() == 2 && authority(types, args[0], &kind) && args[1] == BOOL && status_result(types, result)
        }
        IntrinsicOp::ReadinessWatchFile => {
            args.len() == 4 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &TypeKind::File) && args[2] == U64 && args[3] == U8 && status_result(types, result)
        }
        IntrinsicOp::ReadinessWatchListener => {
            args.len() == 3 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &TypeKind::Listener) && args[2] == U64 && status_result(types, result)
        }
        IntrinsicOp::ReadinessUnwatchFile | IntrinsicOp::ReadinessUnwatchListener => {
            let kind = if name == IntrinsicOp::ReadinessUnwatchFile { TypeKind::File } else { TypeKind::Listener };
            args.len() == 2 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &kind) && status_result(types, result)
        }
        IntrinsicOp::ReadinessWait => {
            args.len() == 3 && authority(types, args[0], &TypeKind::Readiness)
                && authority(types, args[1], &TypeKind::Clock) && args[2] == U64 && events_result(types, result)
        }
        IntrinsicOp::WorldUnixConnect | IntrinsicOp::DirectoryUnixConnect => {
            let kind = if name == IntrinsicOp::WorldUnixConnect { TypeKind::World } else { TypeKind::Directory };
            args.len() == 2 && authority(types, args[0], &kind) && bytes(types, args[1], false) && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::FileSendMessage => {
            args.len() == 4 && authority(types, args[0], &TypeKind::File) && bytes(types, args[1], false)
                && files(types, args[2]) && args[3] == U64 && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: false })
        }
        IntrinsicOp::FileReceiveMessage => {
            args.len() == 4 && authority(types, args[0], &TypeKind::File) && bytes(types, args[1], true)
                && args[2] == U64 && args[3] == U64 && message_result(types, result)
        }
        IntrinsicOp::WorldDirectory => {

            args.len() == 2
                && authority(types, args[0], &TypeKind::World)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::Directory)
        }
        IntrinsicOp::WorldListen => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::World)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::Listener)
        }
        IntrinsicOp::WorldConnector => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::World)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::Connector)
        }
        IntrinsicOp::ConnectorConnectDeadline => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Connector)
                && args[1] == U64
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::ConnectorConnect => {
            args.len() == 1
                && authority(types, args[0], &TypeKind::Connector)
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::ListenerAccept | IntrinsicOp::ListenerAcceptNoDelay => {
            args.len() == 1
                && authority(types, args[0], &TypeKind::Listener)
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::ListenerAddress => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Listener)
                && bytes(types, args[1], true)
                && result == I64
        }
        IntrinsicOp::DirectoryCreateNew | IntrinsicOp::DirectoryCreatePrivate | IntrinsicOp::DirectoryOpenAppend => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::DirectorySync | IntrinsicOp::FileSync | IntrinsicOp::FileLockExclusive | IntrinsicOp::FileLockWait => {
            let kind = if name == IntrinsicOp::DirectorySync { TypeKind::Directory } else { TypeKind::File };
            args.len() == 1 && authority(types, args[0], &kind) && status_result(types, result)
        }
        IntrinsicOp::ForeignRun | IntrinsicOp::ForeignStart => {
            args.len() == 5 && authority(types, args[0], &TypeKind::ForeignCommand)
                && authority(types, args[1], &TypeKind::ReadDirectory)
                && authority(types, args[2], &TypeKind::NullDevice)
                && bytes(types, args[3], false) && args[4] == U64
                && opened(types, result, &if name == IntrinsicOp::ForeignStart { TypeKind::ForeignSession } else { TypeKind::ReadFile })
        }
        IntrinsicOp::ForeignImage => {

            args.len() == 1 && authority(types, args[0], &TypeKind::ForeignCommand)
                && opened(types, result, &TypeKind::ReadFile)
        }
        IntrinsicOp::ForeignExchange => { args.len() == 4 && authority(types, args[0], &TypeKind::ForeignSession) && bytes(types, args[1], false) && bytes(types, args[2], true) && args[3] == U64 && result == I64 }
        IntrinsicOp::ForeignFinish => { args.len() == 2 && authority(types, args[0], &TypeKind::ForeignSession) && args[1] == U64 && result == I64 }
        IntrinsicOp::FileSeek => {
            args.len() == 3 && authority(types, args[0], &TypeKind::File)
                && args[1] == I64 && args[2] == U8
                && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: false })
        }
        IntrinsicOp::FileModifiedNanoseconds => {
            args.len() == 1 && (authority(types, args[0], &TypeKind::File) || authority(types, args[0], &TypeKind::ReadFile))
                && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: false })
        }
        IntrinsicOp::ReadDirectoryOpen | IntrinsicOp::ReadDirectoryOpenDirectory => {
            let kind = if name == IntrinsicOp::ReadDirectoryOpen { TypeKind::ReadFile } else { TypeKind::ReadDirectory };
            args.len() == 2 && authority(types, args[0], &TypeKind::ReadDirectory)
                && bytes(types, args[1], false) && opened(types, result, &kind)
        }
        IntrinsicOp::FileTruncate => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::File)
                && args[1] == U64
                && status_result(types, result)
        }
        IntrinsicOp::DirectoryOpen => {
            args.len() == 3
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && args[2] == BOOL
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::StdinRead | IntrinsicOp::FileRead => {
            let kind = if name == IntrinsicOp::StdinRead {
                TypeKind::Stdin
            } else {
                TypeKind::File
            };
            args.len() == 2
                && (authority(types, args[0], &kind) || (name == IntrinsicOp::FileRead && authority(types, args[0], &TypeKind::ReadFile)))
                && bytes(types, args[1], true)
                && result == I64
        }
        IntrinsicOp::FileWrite => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::File)
                && bytes(types, args[1], false)
                && result == I64
        }
        IntrinsicOp::StdoutWrite | IntrinsicOp::StderrWrite => {
            let kind = if name == IntrinsicOp::StdoutWrite {
                TypeKind::Stdout
            } else {
                TypeKind::Stderr
            };
            args.len() == 2
                && authority(types, args[0], &kind)
                && bytes(types, args[1], false)
                && result == UNIT
        }
        IntrinsicOp::WorldProcess | IntrinsicOp::WorldClock => {
            args.len() == 1
                && authority(types, args[0], &TypeKind::World)
                && types[result].kind
                    == if name == IntrinsicOp::WorldProcess {
                        TypeKind::Process
                    } else {
                        TypeKind::Clock
                    }
        }
        IntrinsicOp::WorldFile => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::World)
                && args[1] == U8
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::ClockRead => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Clock)
                && bytes(types, args[1], true)
                && result == I64
        }
        IntrinsicOp::ImageBuffer => args.len() == 2 && authority(types,args[0],&TypeKind::Image) && bytes(types,args[1],false) && opened(types,result,&TypeKind::File),
        IntrinsicOp::FileMapReadonly => args.len() == 1 && authority(types,args[0],&TypeKind::File) && opened(types,result,&TypeKind::ReadRegion),
        IntrinsicOp::ReadRegionBytes | IntrinsicOp::ReadRegionLen => args.len() == 1
            && matches!(types[args[0]].kind, TypeKind::Ref {inner,mutable:false} if types[inner].kind == TypeKind::ReadRegion)
            && if name == IntrinsicOp::ReadRegionBytes { bytes(types,result,false) } else { result == U64 },
        IntrinsicOp::ImageSpawn => args.len() == 2 && args[1] == U64 && authority(types, args[0], &TypeKind::Image) && opened(types, result, &TypeKind::Worker),
        IntrinsicOp::ChannelSend | IntrinsicOp::ChannelReceive | IntrinsicOp::WorkerSend | IntrinsicOp::WorkerReceive => {
            let worker = matches!(name, IntrinsicOp::WorkerSend | IntrinsicOp::WorkerReceive);
            let receive = matches!(name, IntrinsicOp::WorkerReceive | IntrinsicOp::ChannelReceive);
            args.len() == 3 && authority(types, args[0], &if worker { TypeKind::Worker } else { TypeKind::Channel })
                && bytes(types, args[1], receive) && args[2] == U64
                && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: false })
        }
        IntrinsicOp::ChannelSendFile | IntrinsicOp::WorkerSendFile => {
            args.len() == 3 && authority(types, args[0], &if name == IntrinsicOp::WorkerSendFile { TypeKind::Worker } else { TypeKind::Channel })
                && types[args[1]].kind == TypeKind::File && args[2] == U64 && status_result(types, result)
        }
        IntrinsicOp::ChannelReceiveFile | IntrinsicOp::WorkerReceiveFile => {
            args.len() == 2 && authority(types, args[0], &if name == IntrinsicOp::WorkerReceiveFile { TypeKind::Worker } else { TypeKind::Channel })
                && args[1] == U64 && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::WorkerWait => args.len() == 2 && authority(types, args[0], &TypeKind::Worker) && args[1] == U64
            && scalar_result(types, result, &TypeKind::Int { bits: 64, signed: true }),
        IntrinsicOp::WorkerTerminate => args.len() == 1 && authority(types, args[0], &TypeKind::Worker) && status_result(types, result),
        IntrinsicOp::WorkerResult => args.len() == 1 && authority(types, args[0], &TypeKind::Worker) && opened(types, result, &TypeKind::ReadFile),
        IntrinsicOp::ProcessSpawn => {
            if args.len() != 7
                || !authority(types, args[0], &TypeKind::Process)
                || !bytes(types, args[2], false)
                || !opened(types, result, &TypeKind::Child)
            {
                false
            } else {
                let mut valid = true;
                for index in vec![1usize, 3, 4, 5, 6] {
                    if !matches!(types[args[index]].kind, TypeKind::Ref { inner, mutable: false } if types[inner].kind == TypeKind::File)
                    {
                        valid = false;
                    }
                }
                valid
            }
        }
        IntrinsicOp::ChildWait => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Child)
                && args[1] == BOOL
                && result == I64
        }
        IntrinsicOp::ChildTerminate => {
            args.len() == 1 && authority(types, args[0], &TypeKind::Child) && result == I64
        }
        IntrinsicOp::DirectoryOpenDirectory => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::Directory)
        }
        IntrinsicOp::DirectoryRead => {
            args.len() == 2
                && (authority(types, args[0], &TypeKind::Directory) || authority(types, args[0], &TypeKind::ReadDirectory))
                && bytes(types, args[1], true)
                && result == I64
        }
        IntrinsicOp::DirectoryRewind => {
            args.len() == 1 && (authority(types, args[0], &TypeKind::Directory) || authority(types, args[0], &TypeKind::ReadDirectory)) && result == I64
        }
        IntrinsicOp::DirectoryCreate => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && result == I64
        }
        IntrinsicOp::DirectoryRemove => {
            args.len() == 3
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && args[2] == BOOL
                && result == I64
        }
        IntrinsicOp::DirectoryIdentity => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], true)
                && result == I64
        }
        IntrinsicOp::DirectoryRenameNew => {
            args.len() == 3
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && bytes(types, args[2], false)
                && result == I64
        }
        IntrinsicOp::DirectoryOpenRegular => {
            args.len() == 2
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::DirectoryRename => {
            args.len() == 4
                && authority(types, args[0], &TypeKind::Directory)
                && bytes(types, args[1], false)
                && authority(types, args[2], &TypeKind::Directory)
                && bytes(types, args[3], false)
                && result == I64
        }
        IntrinsicOp::FileDuplicate | IntrinsicOp::FileReadOnly => {
            args.len() == 1
                && authority(types, args[0], &TypeKind::File)
                && opened(types, result, &TypeKind::File)
        }
        IntrinsicOp::FileRewind | IntrinsicOp::FileExecutable | IntrinsicOp::FileSeal => {
            args.len() == 1 && authority(types, args[0], &TypeKind::File) && result == I64
        }
        _ => return None,
    };
    Some(valid)
}

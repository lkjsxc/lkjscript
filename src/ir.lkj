//! Explicit, monomorphic meaning. Backends accept only independently checked programs or units.
#[derive(Clone, PartialEq)]
pub enum TypeKind {
    Unit,
    Bool,
    /// A Unicode scalar value: 0..=0x10ffff excluding 0xd800..=0xdfff.
    Char,
    Int {
        bits: u8,
        signed: bool,
    },
    F64,
    Struct {
        fields: Vec<Field>,
        copy: bool,
    },
    Enum {
        variants: Vec<Variant>,
        copy: bool,
    },
    Ref {
        inner: usize,
        mutable: bool,
    },
    Slice {
        inner: usize,
        mutable: bool,
    },
    Array {
        inner: usize,
        len: usize,
    },
    Vec {
        inner: usize,
    },
    Box {
        inner: usize,
    },
    /// Unsized pure borrowed callable. Shared references carry an environment
    /// address and a checked code address; no owned or mutable value exists.
    Function { params: Vec<usize>, result: usize },
    /// Unsized immutable UTF-8 text; stored values use a shared Ref.
    Str,
    World,
    /// Affine access to invocation arguments, one environment name, or exit status.
    Arguments,
    Environment,
    ExitStatus,
    /// Affine authority to write standard output, derived from World.
    Stdout,
    Stdin,
    Stderr,
    /// Affine directory authority; descendants remain beneath this root.
    Directory,
    ReadDirectory,
    ReadFile,
    /// Affine immutable admitted foreign image; only confined execution can use it.
    ForeignCommand,
    /// Attached confined worker; destruction terminates and reaps its process.
    ForeignSession,
    /// Authenticated immutable child image, kernel IPC endpoint, and owned worker.
    Image,
    Channel,
    Worker,
    ReadRegion,
    /// Explicit descriptor authority for the kernel's null device.
    NullDevice,
    /// Affine open file; structural destruction closes its handle.
    File,
    Process,
    Clock,
    Child,
    /// Affine IPv4 TCP listener; structural destruction closes its handle.
    Listener,
    /// Affine authority to connect to one numeric IPv4 endpoint.
    Connector,
    /// Affine authority to choose numeric IPv4 destinations on one outbound port.
    TcpPort,
    /// Affine authority to create anonymous read/write Files, without named storage.
    TemporaryFiles,
    /// Affine readiness set; destruction closes only its kernel event handle.
    Readiness,
    /// Affine authority to obtain kernel random bytes.
    Entropy,
    /// Affine SIGTERM endpoint; consumption is sticky within this owned value.
    Stop,
}

/// Explicit host provisioning data; executors validate every descriptor against
/// the selected entry's parameter type before creating owned values.
#[derive(Clone)]
pub enum EntryGrant {
    World,
    Arguments,
    /// Exactly one NUL-terminated environment name; never an enumeration grant.
    Environment(Vec<u8>),
    /// Launcher snapshot for native run; standalone builds retain the named grant.
    EnvironmentValue(Option<Vec<u8>>),
    ExitStatus,
    Stdout,
    Stdin,
    Stderr,
    Clock,
    Process,
    /// NUL-terminated path, matching the sealed WorldDirectory ABI.
    Directory(Vec<u8>),
    /// Directory selected at invocation by exactly one named environment value.
    DirectoryEnvironment(Vec<u8>),
    /// Native launcher snapshot retains the original named grant for diagnostics.
    DirectoryEnvironmentValue(Vec<u8>, Option<Vec<u8>>),
    ReadDirectory(Vec<u8>),
    ReadDirectoryEnvironment(Vec<u8>),
    /// Read-only launcher snapshot retains the original named grant too.
    ReadDirectoryEnvironmentValue(Vec<u8>, Option<Vec<u8>>),
    /// Exactly one absolute NUL-terminated executable path, snapshotted at entry.
    ForeignCommand(Vec<u8>),
    /// Host-only unresolved path; never reaches execution.
    ImagePath(Vec<u8>),
    /// Authenticated manifest identity, image digest and exact ELF bytes.
    Image(Vec<u8>),
    NullDevice,
    /// Exact sixteen-byte IPv4 sockaddr, matching WorldListen.
    Listener(Vec<u8>),
    Connector(Vec<u8>),
    /// Connected Unix stream acquired from exactly one explicit invocation path.
    UnixStream(Vec<u8>),
    UnixStreamEnvironment(Vec<u8>),
    UnixStreamEnvironmentValue(Vec<u8>, Option<Vec<u8>>),
    TcpPort(u16),
    TemporaryFiles,
    Readiness,
    Entropy,
    Stop,
}

#[derive(Clone, PartialEq)]
pub struct Field {

    pub name: String,
    pub ty: usize,
}
#[derive(Clone, PartialEq)]
pub struct Variant {
    pub name: String,
    pub fields: Vec<Field>,
}
#[derive(Clone, PartialEq)]
pub struct Type {
    pub name: String,
    pub kind: TypeKind,
}
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord)]
pub enum Projection {
    Deref,
    Field(usize),
    VariantField(usize, usize),
    Index(usize),
}
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord)]
pub struct Place {
    pub local: usize,
    pub projections: Vec<Projection>,
}
impl Place {
    pub fn local(local: usize) -> Place {
        Place {
            local,
            projections: Vec::new(),
        }
    }
}
#[derive(Clone, PartialEq)]
pub struct Local {
    pub name: String,
    pub ty: usize,
    pub mutable: bool,
}
/// Closed operation vocabulary; textual spellings are only an interchange format.
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum UnaryOp {
    Neg,
    Not,
}
impl UnaryOp {
    pub fn parse(text: &str) -> Option<UnaryOp> {
        match text {
            "-" => Some(UnaryOp::Neg),
            "!" => Some(UnaryOp::Not),
            _ => None,
        }
    }
    pub fn as_str(self) -> &'static str {
        match self {
            UnaryOp::Neg => "-",
            UnaryOp::Not => "!",
        }
    }
}
/// Closed operation vocabulary; textual spellings are only an interchange format.
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
    WrappingAdd,
    WrappingSub,
    WrappingMul,
}
impl BinaryOp {
    pub fn parse(text: &str) -> Option<BinaryOp> {
        match text {
            "+" => Some(BinaryOp::Add),
            "-" => Some(BinaryOp::Sub),
            "*" => Some(BinaryOp::Mul),
            "/" => Some(BinaryOp::Div),
            "%" => Some(BinaryOp::Rem),
            "&" => Some(BinaryOp::BitAnd),
            "|" => Some(BinaryOp::BitOr),
            "^" => Some(BinaryOp::BitXor),
            "<<" => Some(BinaryOp::Shl),
            ">>" => Some(BinaryOp::Shr),
            "==" => Some(BinaryOp::Eq),
            "!=" => Some(BinaryOp::Ne),
            "<" => Some(BinaryOp::Lt),
            "<=" => Some(BinaryOp::Le),
            ">" => Some(BinaryOp::Gt),
            ">=" => Some(BinaryOp::Ge),
            "&&" => Some(BinaryOp::And),
            "||" => Some(BinaryOp::Or),
            "wrapping_add" => Some(BinaryOp::WrappingAdd),
            "wrapping_sub" => Some(BinaryOp::WrappingSub),
            "wrapping_mul" => Some(BinaryOp::WrappingMul),
            _ => None,
        }
    }
    pub fn as_str(self) -> &'static str {
        match self {
            BinaryOp::Add => "+",
            BinaryOp::Sub => "-",
            BinaryOp::Mul => "*",
            BinaryOp::Div => "/",
            BinaryOp::Rem => "%",
            BinaryOp::BitAnd => "&",
            BinaryOp::BitOr => "|",
            BinaryOp::BitXor => "^",
            BinaryOp::Shl => "<<",
            BinaryOp::Shr => ">>",
            BinaryOp::Eq => "==",
            BinaryOp::Ne => "!=",
            BinaryOp::Lt => "<",
            BinaryOp::Le => "<=",
            BinaryOp::Gt => ">",
            BinaryOp::Ge => ">=",
            BinaryOp::And => "&&",
            BinaryOp::Or => "||",
            BinaryOp::WrappingAdd => "wrapping_add",
            BinaryOp::WrappingSub => "wrapping_sub",
            BinaryOp::WrappingMul => "wrapping_mul",
        }
    }
}

//! Checked collection, text and capability operations over inline native values.
use super::*;

impl Body<'_> {
    fn intrinsic_unit(&mut self, dst: usize) {
        self.mark(dst);
    }

    fn intrinsic_open_result(&mut self, dst: usize) {
        let ty = self.ty(dst);
        let success = self.layout.field_offset(ty, Some(0), 0);
        let failure = self.layout.field_offset(ty, Some(1), 0);
        let error = self.a.label();
        let done = self.a.label();
        self.local_address(dst, R8);
        self.a.test(A, true);
        self.a.condition(8, error);
        self.a.immediate(C, 0);
        self.a.store(R8, 0, C);
        self.a.store(R8, success as i64, A);
        self.a.jump(done);
        self.a.bind(error);
        self.a.negate(A);
        self.a.immediate(C, 1);
        self.a.store(R8, 0, C);
        self.a.store(R8, failure as i64, A);
        self.a.bind(done);
        self.mark(dst);
    }

    fn intrinsic_scalar_result(&mut self, dst: usize, success_register: u8) {
        let ty = self.ty(dst);
        let success = self.layout.field_offset(ty, Some(0), 0);
        let failure = self.layout.field_offset(ty, Some(1), 0);
        let error = self.a.label();
        let done = self.a.label();
        self.local_address(dst, R8);
        self.a.test(A, true);
        self.a.condition(8, error);
        self.a.immediate(C, 0);
        self.a.store(R8, 0, C);
        self.a.store(R8, success as i64, success_register);
        self.a.jump(done);
        self.a.bind(error);
        self.a.negate(A);
        self.a.immediate(C, 1);
        self.a.store(R8, 0, C);
        self.a.store(R8, failure as i64, A);
        self.a.bind(done);
        self.mark(dst);
    }

    fn intrinsic_io(
        &mut self,
        dst: usize,
        name: IntrinsicOp,
        args: &[usize],
    ) -> Result<bool, Diagnostic> {
        if name == IntrinsicOp::WorldStdout
            || name == IntrinsicOp::WorldStderr
            || name == IntrinsicOp::WorldStdin
            || name == IntrinsicOp::WorldProcess
            || name == IntrinsicOp::WorldClock
            || name == IntrinsicOp::WorldEntropy
        {
            self.a.immediate(A, 1);
            self.write(dst, A);
            return Ok(true);
        }
        match name {
            IntrinsicOp::StdoutWrite | IntrinsicOp::StderrWrite => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(if name == IntrinsicOp::StdoutWrite {
                    self.platform.stdout_write
                } else {
                    self.platform.stderr_write
                });
                let ready = self.a.label();
                self.a.test(A, true); self.a.condition(9, ready);
                diagnostics::failure(self.a, if name == IntrinsicOp::StdoutWrite { self.platform.stdout_identity } else { self.platform.stderr_identity }, 8);
                diagnostics::operation(self.a, 1); self.trap(7);
                self.a.bind(ready);
            }
            IntrinsicOp::WorldArgCount => self.a.call(self.platform.argument_count),
            IntrinsicOp::WorldArgLen => {
                self.read(args[1], DI);
                self.a.call(self.platform.argument_length);
            }
            IntrinsicOp::WorldArgCopy => {
                self.read(args[1], DI);
                self.read_word(args[2], 0, SI);
                self.read_word(args[2], 1, D);
                self.a.call(self.platform.argument_copy);
            }
            IntrinsicOp::EnvironmentLen => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(self.platform.environment_length);
            }
            IntrinsicOp::EnvironmentCopy => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(self.platform.environment_copy);
            }
            IntrinsicOp::WorldExitStatus => {
                self.read(args[1], DI);
                self.a.call(self.platform.set_exit_status);
            }
            IntrinsicOp::EntropyFill => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.entropy_fill);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ClockUnixSeconds | IntrinsicOp::ClockUnixNanoseconds => {
                self.a.call(if name == IntrinsicOp::ClockUnixSeconds { self.platform.clock_unix_seconds } else { self.platform.clock_unix_nanoseconds });
                self.intrinsic_scalar_result(dst, D);
                return Ok(true);
            }
            IntrinsicOp::FileSetPrivate => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(self.platform.file_set_private);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::WorldStop => {
                self.a.call(self.platform.world_stop);
                self.intrinsic_open_result(dst);
                let success = self.layout.field_offset(self.ty(dst), Some(0), 0);
                self.local_address(dst, R8);
                self.a.immediate(A, 0);
                self.a.store(R8, success as i64 + 8, A);
                return Ok(true);
            }
            IntrinsicOp::StopRequested | IntrinsicOp::StopTarget | IntrinsicOp::ChildRequestStop => {
                self.read(args[0], DI);
                self.a.call(match name {
                    IntrinsicOp::StopRequested => self.platform.stop_requested,
                    IntrinsicOp::StopTarget => self.platform.stop_target,
                    _ => self.platform.child_request_stop,
                });
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::WorldReadiness => {
                self.a.call(self.platform.world_readiness);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::FileSetNonblocking | IntrinsicOp::ListenerSetNonblocking => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read(args[1], SI);
                self.a.call(self.platform.handle_nonblocking);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ReadinessWatchFile | IntrinsicOp::ReadinessWatchListener | IntrinsicOp::ReadinessWatchStop => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read(args[1], SI);
                self.a.load(SI, SI, 0);
                self.read(args[2], D);
                if name == IntrinsicOp::ReadinessWatchFile { self.read(args[3], C); } else { self.a.immediate(C, 1); }
                self.a.call(self.platform.readiness_watch);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ReadinessUnwatchFile | IntrinsicOp::ReadinessUnwatchListener | IntrinsicOp::ReadinessUnwatchStop => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read(args[1], SI);
                self.a.load(SI, SI, 0);
                self.a.call(self.platform.readiness_unwatch);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ReadinessWait => {
                self.intrinsic_readiness_wait(dst, args);
                return Ok(true);
            }
            IntrinsicOp::WorldDirectory => {

                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.directory_open);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::WorldListen => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.world_listen);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::WorldConnector => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.world_connector);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ConnectorConnect => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(self.platform.connector_connect);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ListenerAccept | IntrinsicOp::ListenerAcceptNoDelay => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(if name == IntrinsicOp::ListenerAcceptNoDelay {
                    self.platform.listener_accept_nodelay
                } else { self.platform.listener_accept });
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ListenerAddress => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(self.platform.listener_address);
            }
            IntrinsicOp::DirectoryCreateNew | IntrinsicOp::DirectoryCreatePrivate | IntrinsicOp::DirectoryOpenAppend => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.immediate(C, if name == IntrinsicOp::DirectoryOpenAppend { 0xa0442 } else { 0x800c2 });
                self.a.immediate(R8, if name == IntrinsicOp::DirectoryCreatePrivate { 0o600 } else { 0o666 });
                self.a.call(self.platform.file_storage_open);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::DirectorySync | IntrinsicOp::FileSync | IntrinsicOp::FileTruncate | IntrinsicOp::FileLockExclusive | IntrinsicOp::FileLockWait => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                if name == IntrinsicOp::FileTruncate { self.read(args[1], SI); }
                self.a.call(match name {
                    IntrinsicOp::DirectorySync => self.platform.directory_sync,
                    IntrinsicOp::FileSync => self.platform.file_sync,
                    IntrinsicOp::FileTruncate => self.platform.file_truncate,
                    IntrinsicOp::FileLockWait => self.platform.file_lock_wait,
                    _ => self.platform.file_lock_exclusive,
                });
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::FileSeek | IntrinsicOp::FileModifiedNanoseconds => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                if name == IntrinsicOp::FileSeek {
                    self.read(args[1], SI);
                    self.read(args[2], D);
                    self.a.call(self.platform.file_seek);
                } else { self.a.call(self.platform.file_modified_nanoseconds); }
                self.intrinsic_scalar_result(dst, D);
                return Ok(true);
            }
            IntrinsicOp::ReadDirectoryOpen => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(self.platform.file_open_regular);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::DirectoryOpen => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.read(args[2], C);
                self.a.call(self.platform.file_open);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::StdinRead => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.stdin_read);
            }
            IntrinsicOp::FileRead | IntrinsicOp::FileWrite => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.test(DI, true);
                self.a.immediate(A, !0u64);
                self.a.cmov(DI, A, 4);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(if name == IntrinsicOp::FileRead {
                    self.platform.file_read
                } else {
                    self.platform.file_write
                });
            }
            IntrinsicOp::FileDuplicate | IntrinsicOp::FileReadOnly => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(if name == IntrinsicOp::FileReadOnly {
                    self.platform.file_readonly
                } else {
                    self.platform.file_duplicate
                });
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::WorldFile => {
                self.read(args[1], DI);
                self.a.call(self.platform.world_file);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ClockRead => {
                self.read_word(args[1], 0, DI);
                self.read_word(args[1], 1, SI);
                self.a.call(self.platform.clock_read);
            }
            IntrinsicOp::ForeignImage => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.call(self.platform.file_readonly);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ForeignRun | IntrinsicOp::ForeignStart => {
                for index in 0usize..3usize {
                    self.read(args[index], A);
                    self.a.load(A, A, 0);
                    self.a.store(BP, self.scratch[index], A);
                }
                self.read_word(args[3], 0, A);
                self.a.store(BP, self.scratch[3], A);
                self.read_word(args[3], 1, A);
                self.a.store(BP, self.scratch[4], A);
                self.read(args[4], A);
                self.a.store(BP, self.scratch[5], A);
                self.a.lea(DI, BP, self.scratch[0]);
                self.a.call(if name == IntrinsicOp::ForeignStart { self.platform.foreign_start } else { self.platform.foreign_run });
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ForeignExchange => {
                self.read(args[0], A); self.a.load(A, A, 0); self.a.store(BP, self.scratch[0], A);
                for index in 1usize..3usize { self.read_word(args[index], 0, A); self.a.store(BP, self.scratch[index*2-1], A); self.read_word(args[index], 1, A); self.a.store(BP, self.scratch[index*2], A); }
                self.read(args[3], A); self.a.store(BP, self.scratch[5], A);
                self.a.lea(DI, BP, self.scratch[0]); self.a.call(self.platform.foreign_exchange);
            }
            IntrinsicOp::ForeignFinish => { self.read(args[0], DI); self.a.load(DI, DI, 0); self.read(args[1], SI); self.a.call(self.platform.foreign_finish); }
            IntrinsicOp::ImageBuffer => {
                self.read_word(args[1],0,DI); self.read_word(args[1],1,SI); self.a.call(self.platform.image_buffer);
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::FileMapReadonly => {
                self.read(args[0],DI); self.a.load(DI,DI,0); self.a.call(self.platform.file_map_readonly);
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::ReadRegionBytes => {
                self.read(args[0],DI); self.a.load(DI,DI,0); self.a.load(A,DI,8); self.write_word(dst,0,A);
                self.a.load(A,DI,16); self.write_word(dst,1,A); self.mark(dst); return Ok(true);
            }
            IntrinsicOp::ReadRegionLen => {
                self.read(args[0],DI); self.a.load(DI,DI,0); self.a.load(A,DI,16); self.write(dst,A); return Ok(true);
            }
            IntrinsicOp::ImageSpawn => {
                self.read(args[0], DI); self.a.load(DI, DI, 0); self.read(args[1], SI); self.a.call(self.platform.image_spawn);
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::ChannelSend | IntrinsicOp::ChannelReceive | IntrinsicOp::WorkerSend | IntrinsicOp::WorkerReceive => {
                self.read(args[0], DI); self.a.load(DI, DI, 0);
                if matches!(name, IntrinsicOp::WorkerSend | IntrinsicOp::WorkerReceive) { self.a.load(DI, DI, 8); }
                self.read_word(args[1], 0, SI); self.read_word(args[1], 1, D); self.read(args[2], C);
                self.a.call(if matches!(name, IntrinsicOp::ChannelReceive | IntrinsicOp::WorkerReceive) { self.platform.channel_receive } else { self.platform.channel_send });
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::ChannelSendFile | IntrinsicOp::WorkerSendFile | IntrinsicOp::ChannelReceiveFile | IntrinsicOp::WorkerReceiveFile => {
                self.read(args[0], DI); self.a.load(DI, DI, 0);
                if matches!(name, IntrinsicOp::WorkerSendFile | IntrinsicOp::WorkerReceiveFile) { self.a.load(DI, DI, 8); }
                if matches!(name, IntrinsicOp::WorkerSendFile | IntrinsicOp::ChannelSendFile) {
                    self.read(args[1], SI); self.read(args[2], D); self.a.call(self.platform.channel_send_file);
                } else { self.a.immediate(SI, 0); self.read(args[1], D); self.a.call(self.platform.channel_receive_file); }
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::WorkerWait | IntrinsicOp::WorkerTerminate | IntrinsicOp::WorkerResult => {
                self.read(args[0], DI); self.a.load(DI, DI, 0);
                if name == IntrinsicOp::WorkerWait { self.read(args[1], SI); self.a.call(self.platform.worker_wait); }
                else if name == IntrinsicOp::WorkerTerminate { self.a.call(self.platform.worker_terminate); }
                else {
                    let running = self.a.label(); let ready = self.a.label();
                    self.a.load(A, DI, 0); self.a.test(A, true); self.a.condition(5, running);
                    self.a.load(DI, DI, 16); self.a.call(self.platform.file_readonly); self.a.jump(ready);
                    self.a.bind(running); self.a.immediate(A, (-16i64) as u64); self.a.bind(ready);
                }
                self.intrinsic_open_result(dst); return Ok(true);
            }
            IntrinsicOp::ProcessSpawn => {
                self.read(args[1], A);
                self.a.load(A, A, 0);
                self.a.store(BP, self.scratch[0], A);
                self.read_word(args[2], 0, A);
                self.a.store(BP, self.scratch[1], A);
                self.read_word(args[2], 1, A);
                self.a.store(BP, self.scratch[2], A);
                for index in 3..7 {
                    self.read(args[index], A);
                    self.a.load(A, A, 0);
                    self.a.store(BP, self.scratch[index], A);
                }
                self.a.lea(DI, BP, self.scratch[0]);
                self.a.call(self.platform.process_spawn);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::ChildWait => {
                self.read(args[0], DI);
                self.read(args[1], SI);
                self.a.call(self.platform.child_wait);
            }
            IntrinsicOp::ChildTerminate => {
                self.read(args[0], DI);
                self.a.call(self.platform.child_terminate);
            }
            IntrinsicOp::DirectoryOpenDirectory | IntrinsicOp::ReadDirectoryOpenDirectory => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(self.platform.directory_open_directory);
                self.intrinsic_open_result(dst);
                return Ok(true);
            }
            IntrinsicOp::DirectoryRead => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.a.call(self.platform.directory_read);
            }
            IntrinsicOp::FileRewind
            | IntrinsicOp::DirectoryRewind
            | IntrinsicOp::FileExecutable
            | IntrinsicOp::FileSeal => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.a.test(DI, true);
                self.a.immediate(A, !0u64);
                self.a.cmov(DI, A, 4);
                self.a.call(if name == IntrinsicOp::FileExecutable {
                    self.platform.file_executable
                } else if name == IntrinsicOp::FileSeal {
                    self.platform.file_seal
                } else {
                    self.platform.handle_rewind
                });
            }
            IntrinsicOp::DirectoryCreate | IntrinsicOp::DirectoryRemove => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                if name == IntrinsicOp::DirectoryRemove {
                    self.read(args[2], C);
                }
                self.a.call(if name == IntrinsicOp::DirectoryCreate {
                    self.platform.directory_create
                } else {
                    self.platform.directory_remove
                });
            }
            IntrinsicOp::DirectoryRename => {
                self.read(args[0], DI);
                self.a.load(DI, DI, 0);
                self.read_word(args[1], 0, SI);
                self.read_word(args[1], 1, D);
                self.read(args[2], C);
                self.a.load(C, C, 0);
                self.read_word(args[3], 0, R8);
                self.read_word(args[3], 1, R9);
                self.a.call(self.platform.directory_rename);
            }
            _ => return Ok(false),
        }
        if name == IntrinsicOp::WorldArgLen || name == IntrinsicOp::WorldArgCopy {
            self.check_test(A, true, 8, 3);
        }
        self.write(dst, A);
        Ok(true)
    }

    fn intrinsic_readiness_wait(&mut self, dst: usize, args: &[usize]) {
        // The checked event pair is (u64, u8), with a sixteen-byte native stride.
        let ty = self.ty(dst);
        let success = self.layout.field_offset(ty, Some(0), 0);
        let failure = self.layout.field_offset(ty, Some(1), 0);
        let error = self.a.label();
        let done = self.a.label();
        self.a.immediate(DI, 64 * 16);
        self.a.call(self.runtime.allocate);
        self.a.store(BP, self.scratch[0], A);
        self.a.mov(D, A);
        self.read(args[0], DI);
        self.a.load(DI, DI, 0);
        self.read(args[2], SI);
        self.a.call(self.platform.readiness_wait);
        self.a.store(BP, self.scratch[1], A);
        self.a.test(A, true);
        self.a.condition(8, error);
        self.local_address(dst, R8);
        self.a.immediate(C, 0);
        self.a.store(R8, 0, C);
        self.a.load(C, BP, self.scratch[0]);
        self.a.store(R8, success as i64, C);
        self.a.store(R8, success as i64 + 8, A);
        self.a.immediate(C, 64);
        self.a.store(R8, success as i64 + 16, C);
        self.a.jump(done);
        self.a.bind(error);
        self.a.load(DI, BP, self.scratch[0]);
        self.a.call(self.runtime.release);
        self.a.load(A, BP, self.scratch[1]);
        self.a.negate(A);
        self.local_address(dst, R8);
        self.a.immediate(C, 1);
        self.a.store(R8, 0, C);
        self.a.store(R8, failure as i64, A);
        self.a.bind(done);
        self.mark(dst);
    }
    fn intrinsic_vec_push(&mut self, dst: usize, args: &[usize]) {

        let element = self.ty(args[1]);
        let stride = self.layout.stride(element);
        let ready = self.a.label();
        let grow = self.a.label();
        self.read(args[0], R8);
        self.a.store(BP, self.scratch[0], R8);
        self.a.load(R9, R8, 8);
        self.a.store(BP, self.scratch[1], R9);
        self.a.load(A, R8, 16);
        self.a.compare(R9, A);
        self.a.condition(5, ready);
        self.a.test(A, true);
        self.a.condition(5, grow);
        self.a.immediate(A, 2);
        self.a.bind(grow);
        self.a.immediate(C, (!0u64) / 2);
        self.check_compare(A, C, 7, 6);
        self.a.shift(A, 4, 1);
        self.a.store(BP, self.scratch[2], A);
        self.a.immediate(C, stride);
        self.a.mul(C);
        self.check_test(D, true, 5, 6);
        self.a.mov(SI, A);
        self.a.load(DI, R8, 0);
        self.a.call(self.runtime.reallocate);
        self.a.load(R8, BP, self.scratch[0]);
        self.a.store(R8, 0, A);
        self.a.load(C, BP, self.scratch[2]);
        self.a.store(R8, 16, C);
        self.a.bind(ready);
        self.a.load(R8, BP, self.scratch[0]);
        self.a.load(A, BP, self.scratch[1]);
        self.a.immediate(C, stride);
        self.a.imul(A, C);
        self.a.load(DI, R8, 0);
        self.a.rr(0x01, DI, A, true);
        self.copy_from_local(DI, args[1], element);
        self.a.load(R8, BP, self.scratch[0]);
        self.a.load(A, BP, self.scratch[1]);
        self.a.immediate(C, 1);
        self.a.rr(0x01, A, C, true);
        self.a.store(R8, 8, A);
        self.intrinsic_unit(dst);
    }

    fn intrinsic_vec_pop(&mut self, dst: usize, args: &[usize]) -> Result<(), Diagnostic> {
        let result_ty = self.ty(dst);
        let element = match &self.program.types[result_ty].kind {
            TypeKind::Enum { variants, .. } => variants[1].fields[0].ty,
            _ => return Err(self.problem("vec_pop result is not an enum")),
        };
        let field = self.layout.field_offset(result_ty, Some(1), 0);
        let stride = self.layout.stride(element);
        let empty = self.a.label();
        let done = self.a.label();
        self.read(args[0], R8);
        self.a.load(A, R8, 8);
        self.a.test(A, true);
        self.a.condition(4, empty);
        self.a.immediate(C, 1);
        self.a.rr(0x29, A, C, true);
        self.a.store(R8, 8, A);
        self.a.immediate(C, stride);
        self.a.imul(A, C);
        self.a.load(SI, R8, 0);
        self.a.rr(0x01, SI, A, true);
        self.local_address(dst, DI);
        self.a.immediate(C, 1);
        self.a.store(DI, 0, C);
        self.a.lea(DI, DI, field as i64);
        self.copy_value(DI, SI, element);
        self.a.jump(done);
        self.a.bind(empty);
        self.a.immediate(A, 0);
        self.write_word(dst, 0, A);
        self.a.bind(done);
        self.mark(dst);
        Ok(())
    }

    fn intrinsic_replace(&mut self, dst: usize, args: &[usize]) {
        let bytes = self.layout.storage(self.ty(dst)).bytes;
        let scalar = self.layout.storage(self.ty(dst)).scalar;
        if bytes == 0 {
            self.mark(dst);
            return;
        }
        if scalar {
            self.read(args[0], R8);
            self.read(args[1], C);
            let storage = self.layout.storage(self.ty(dst));
            self.a
                .load_width(A, R8, 0, storage.bytes as u8, storage.signed);
            self.a.store_width(R8, 0, C, storage.bytes as u8);
            self.write(dst, A);
            return;
        }
        // Swap a byte at a time so dst may reuse the consumed replacement local.
        self.read(args[0], R8);
        self.local_address(args[1], R9);
        self.local_address(dst, R10);
        let bytes = self.layout.storage(self.ty(dst)).bytes;
        self.a.immediate(C, bytes);
        self.a.immediate(D, 1);
        let again = self.a.label();
        let done = self.a.label();
        self.a.bind(again);
        self.a.test(C, true);
        self.a.condition(4, done);
        self.a.load_width(A, R8, 0, 1, false);
        self.a.load_width(DI, R9, 0, 1, false);
        self.a.store_width(R8, 0, DI, 1);
        self.a.store_width(R10, 0, A, 1);
        self.a.rr(0x01, R8, D, true);
        self.a.rr(0x01, R9, D, true);
        self.a.rr(0x01, R10, D, true);
        self.a.rr(0x29, C, D, true);
        self.a.jump(again);
        self.a.bind(done);
        self.mark(dst);
    }

    fn intrinsic_array_repeat(&mut self, dst: usize, src: usize) -> Result<(), Diagnostic> {
        let (inner, len) = match self.program.types[self.ty(dst)].kind {
            TypeKind::Array { inner, len } => (inner, len),
            _ => return Err(self.problem("array_repeat result is not an array")),
        };
        let stride = self.layout.stride(inner);
        self.local_address(dst, A);
        self.a.store(BP, self.scratch[0], A);
        self.a.immediate(A, len as u64);
        self.a.store(BP, self.scratch[1], A);
        let again = self.a.label();
        let done = self.a.label();
        self.a.bind(again);
        self.a.load(A, BP, self.scratch[1]);
        self.a.test(A, true);
        self.a.condition(4, done);
        self.a.load(DI, BP, self.scratch[0]);
        self.copy_from_local(DI, src, inner);
        self.a.load(A, BP, self.scratch[0]);
        self.a.immediate(C, stride);
        self.a.rr(0x01, A, C, true);
        self.a.store(BP, self.scratch[0], A);
        self.a.load(A, BP, self.scratch[1]);
        self.a.immediate(C, 1);
        self.a.rr(0x29, A, C, true);
        self.a.store(BP, self.scratch[1], A);
        self.a.jump(again);
        self.a.bind(done);
        self.mark(dst);
        Ok(())
    }

    pub(super) fn intrinsic(
        &mut self,
        dst: usize,
        name: IntrinsicOp,
        args: &[usize],
    ) -> Result<(), Diagnostic> {
        if self.intrinsic_io(dst, name, args)? {
            return Ok(());
        }
        match name {
            IntrinsicOp::Assert => {
                self.read(args[0], A);
                self.check_test(A, true, 4, 5);
                self.intrinsic_unit(dst);
            }
            IntrinsicOp::Cast => self.scalar_cast(dst, args[0])?,
            IntrinsicOp::ArrayRepeat => self.intrinsic_array_repeat(dst, args[0])?,
            IntrinsicOp::Replace => self.intrinsic_replace(dst, args),
            IntrinsicOp::BoxNew => {
                let inner = self.ty(args[0]);
                self.a.immediate(DI, self.layout.storage(inner).bytes);
                self.a.call(self.runtime.allocate);
                self.a.store(BP, self.scratch[0], A);
                self.a.mov(DI, A);
                self.copy_from_local(DI, args[0], inner);
                self.a.load(A, BP, self.scratch[0]);
                self.write(dst, A);
            }
            IntrinsicOp::VecNew => {
                self.a.immediate(A, 0);
                self.write_word(dst, 0, A);
                self.write_word(dst, 1, A);
                self.write_word(dst, 2, A);
                self.mark(dst);
            }
            IntrinsicOp::VecPush => self.intrinsic_vec_push(dst, args),
            IntrinsicOp::VecPop => self.intrinsic_vec_pop(dst, args)?,
            IntrinsicOp::VecLen => {
                let inner = match self.program.types[self.ty(args[0])].kind {
                    TypeKind::Ref { inner, .. } => inner,
                    _ => return Err(self.problem("vec_len input is not a reference")),
                };
                match self.program.types[inner].kind {
                    TypeKind::Array { len, .. } => {
                        self.a.immediate(A, len as u64);
                    }
                    TypeKind::Slice { .. } => self.read_word(args[0], 1, A),
                    TypeKind::Vec { .. } => {
                        self.read(args[0], A);
                        self.a.load(A, A, 8);
                    }
                    _ => return Err(self.problem("vec_len input is not a sequence")),
                }
                self.write(dst, A);
            }
            IntrinsicOp::Clone => {
                self.read(args[0], SI);
                let ty = self.ty(dst);
                let bytes = self.layout.storage(ty).bytes;
                let scalar = self.layout.storage(ty).scalar;
                let signed = self.layout.storage(ty).signed;
                if bytes == 0 {
                    self.mark(dst);
                } else if scalar {
                    self.a.load_width(A, SI, 0, bytes as u8, signed);
                    self.write(dst, A);
                } else {
                    self.local_address(dst, DI);
                    self.copy_value(DI, SI, ty);
                    self.mark(dst);
                }
            }
            IntrinsicOp::F64FromBits | IntrinsicOp::F64ToBits => {
                self.read(args[0], A);
                self.write(dst, A);
            }
            IntrinsicOp::CharFromU32 => {
                let ty = self.ty(dst);
                let field = self.layout.field_offset(ty, Some(1), 0);
                let valid = self.a.label();
                let done = self.a.label();
                self.read(args[0], A);
                self.local_address(dst, R8);
                self.a.immediate(C, 0);
                self.a.store(R8, 0, C);
                self.a.immediate(C, 0x110000);
                self.a.compare(A, C);
                self.a.condition(3, done);
                self.a.immediate(C, 0xd800);
                self.a.compare(A, C);
                self.a.condition(2, valid);
                self.a.immediate(C, 0xe000);
                self.a.compare(A, C);
                self.a.condition(2, done);
                self.a.bind(valid);
                self.a.immediate(C, 1);
                self.a.store(R8, 0, C);
                self.a.store_width(R8, field as i64, A, 4);
                self.a.bind(done);
                self.mark(dst);
            }
            IntrinsicOp::StrAsBytes => {
                self.copy_local(dst, args[0]);
            }
            IntrinsicOp::StrLen => {
                self.read_word(args[0], 1, A);
                self.write(dst, A);
            }
            IntrinsicOp::StrFromUtf8 => {
                let ty = self.ty(dst);
                let ok_field = self.layout.field_offset(ty, Some(0), 0);
                let err_field = self.layout.field_offset(ty, Some(1), 0);
                let invalid = self.a.label();
                let done = self.a.label();
                self.read_word(args[0], 0, DI);
                self.read_word(args[0], 1, SI);
                self.a.call(self.runtime.utf8_validate);
                self.local_address(dst, R8);
                self.a.test(A, true);
                self.a.condition(4, invalid);
                self.a.immediate(A, 0);
                self.a.store(R8, 0, A);
                self.read_word(args[0], 0, A);
                self.a.store(R8, ok_field as i64, A);
                self.read_word(args[0], 1, A);
                self.a.store(R8, ok_field as i64 + 8, A);
                self.a.jump(done);
                self.a.bind(invalid);
                self.a.immediate(A, 1);
                self.a.store(R8, 0, A);
                self.a.immediate(A, 0);
                self.a.store_width(R8, err_field as i64, A, 1);
                self.a.bind(done);
                self.mark(dst);
            }
            _ => {
                return Err(
                    self.problem(&format!("unsupported checked intrinsic {}", name.as_str()))
                );
            }
        }
        Ok(())
    }
}

//! Checked units become authenticated local objects; linking never loads their IR together.
use super::*;
use crate::check::units::{Binding, CheckedUnit, Interface};
use crate::reuse::{ProofDomain, VerifiedPayload};


mod claims;

mod image_tables;

mod table_data;

mod table_tests;

pub use image_tables::ImageTables;
const NAMESPACE: &str = "unit-native-2";
const LISTENER: u64 = 1u64 << 0u32;
const CONNECTOR: u64 = 1u64 << 1u32;
const READINESS: u64 = 1u64 << 2u32;
const STOP: u64 = 1u64 << 3u32;
const ENTROPY: u64 = 1u64 << 4u32;
const WALL: u64 = 1u64 << 5u32;
const NANO: u64 = 1u64 << 6u32;
const LOCK: u64 = 1u64 << 7u32;
const ENVIRONMENT: u64 = 1u64 << 8u32;
const FOREIGN: u64 = 1u64 << 9u32;
const PRIVATE: u64 = 1u64 << 10u32;
const CHILD_STOP: u64 = 1u64 << 11u32;
const NONBLOCKING: u64 = 1u64 << 12u32;
const STORAGE: u64 = 1u64 << 13u32;
const NODELAY: u64 = 1u64 << 14u32;
const WORKERS: u64 = 1u64 << 15u32;
const REGION: u64 = 1u64 << 16u32;
const CONNECT_DEADLINE: u64 = 1u64 << 17u32;
const UNIX: u64 = 1u64 << 18u32;

fn error(message: &str) -> Diagnostic { Diagnostic::new(Span::default(), "E_UNIT_LINK", message) }
fn io(operation: &str, errno: i64) -> Diagnostic { error(&format!("{operation}: errno {errno}")) }
fn word(bytes: &mut Vec<u8>, value: usize) {
    for index in 0usize..8usize { bytes.push(((value as u64) >> (index * 8usize)) as u8); }
}
fn blob(bytes: &mut Vec<u8>, value: &[u8]) { word(bytes, value.len()); bytes.extend_from_slice(value); }
fn string(bytes: &mut Vec<u8>, value: &str) { blob(bytes, value.as_bytes()); }
fn take_word(bytes: &[u8], at: &mut usize) -> Option<usize> {
    if *at > bytes.len() || bytes.len() - *at < 8usize { return None; }
    let mut value = 0u64;
    for index in 0usize..8usize { value |= (bytes[*at + index] as u64) << (index * 8usize); }
    *at += 8usize;
    if value > (!0usize) as u64 { None } else { Some(value as usize) }
}
fn take_blob(bytes: &[u8], at: &mut usize) -> Option<Vec<u8>> {
    let length = take_word(bytes, at)?;
    if length > bytes.len() - *at { return None; }
    let result = bytes[*at..*at + length].to_vec(); *at += length; Some(result)
}
fn take_string(bytes: &[u8], at: &mut usize) -> Option<String> { String::from_utf8(take_blob(bytes, at)?).ok() }
fn site(bytes: &mut Vec<u8>, value: Span) {
    word(bytes, value.file); word(bytes, value.line); word(bytes, value.column);
}
fn take_site(bytes: &[u8], at: &mut usize) -> Option<Span> {
    Some(Span { file: take_word(bytes, at)?, line: take_word(bytes, at)?, column: take_word(bytes, at)?, start: 0usize, end: 0usize })
}
fn symbol(binding: &Binding) -> String {
    format!("unit:{}:{}:{}:{}:{}", binding.unit.len(), binding.unit,
        binding.interface_identity.len(), binding.interface_identity, binding.name)
}

fn symbol_part(bytes: &[u8], at: &mut usize) -> Option<String> {
    let first = *at;
    let mut length = 0usize;
    while *at < bytes.len() && bytes[*at] >= b'0' && bytes[*at] <= b'9' {
        length = length.checked_mul(10usize)?.checked_add((bytes[*at] - b'0') as usize)?;
        *at += 1usize;
    }
    if *at == first || *at >= bytes.len() || bytes[*at] != b':'
        || (*at - first > 1usize && bytes[first] == b'0') { return None; }
    *at += 1usize;
    let end = (*at).checked_add(length)?;
    if end >= bytes.len() || bytes[end] != b':' { return None; }
    let value = String::from_utf8(bytes[*at..end].to_vec()).ok()?;
    *at = end + 1usize;
    Some(value)
}

fn parse_symbol(name: &str) -> Option<Binding> {
    let bytes = name.as_bytes();
    if !bytes.starts_with(b"unit:") { return None; }
    let mut at = 5usize;
    let unit = symbol_part(bytes, &mut at)?;
    let interface_identity = symbol_part(bytes, &mut at)?;
    if unit.is_empty() || interface_identity.len() != 64usize || at == bytes.len() { return None; }
    for byte in interface_identity.as_str().bytes() {
        if !byte.is_ascii_digit() && !(byte >= b'a' && byte <= b'f') { return None; }
    }
    let name = String::from_utf8(bytes[at..].to_vec()).ok()?;
    Some(Binding { unit, interface_identity, name })
}
fn platform_symbol(index: usize) -> String { format!("platform:{index}") }
fn runtime_symbol(name: &str) -> String { format!("runtime:{name}") }
fn context_key(runtime: &Runtime) -> String {
    let mut bytes = b"lkjscript-unit-native-context-1\0linux-x86_64\0"[..].to_vec();
    blob(&mut bytes, &crate::ir_binary::write(runtime.checked_program()));
    crate::sha256::hex_digest(&bytes)
}

pub struct Context<'a> {
    runtime: &'a Runtime,
    identity: String,
}

impl<'a> Context<'a> {
    pub fn new(runtime: &'a Runtime) -> Self {
        Self { runtime, identity: context_key(runtime) }
    }
}
pub fn namespace() -> &'static str { NAMESPACE }
pub fn object_key(interface: &Interface, context: &Context<'_>, source_base: usize, sources: &[String]) -> String {
    let mut bytes = b"lkjscript-unit-native-object-2\0"[..].to_vec();
    string(&mut bytes, interface.name()); string(&mut bytes, interface.identity());
    string(&mut bytes, interface.body_identity()); string(&mut bytes, interface.input_identity());
    string(&mut bytes, &context.identity); word(&mut bytes, source_base);
    word(&mut bytes, sources.len());
    for path in sources { string(&mut bytes, path); }
    crate::sha256::hex_digest(&bytes)
}
fn features(program: &Program) -> u64 {
    let mut flags = 0u64;
    for ty in &program.types {
        flags |= match ty.kind {
            TypeKind::Connector => CONNECTOR,
            TypeKind::Readiness => READINESS,
            TypeKind::Stop => STOP,
            TypeKind::Environment => ENVIRONMENT,
            TypeKind::ForeignSession => FOREIGN,
            TypeKind::Image => WORKERS | REGION,
            TypeKind::Channel | TypeKind::Worker => WORKERS,
            TypeKind::ReadRegion => REGION,
            _ => 0u64,
        };
    }
    for function in &program.functions {
        for instruction in &function.body {
            if let Op::Intrinsic { name, .. } = instruction.op {
                flags |= match name {
                    IntrinsicOp::WorldListen => LISTENER,
                    IntrinsicOp::WorldUnixConnect | IntrinsicOp::DirectoryUnixConnect | IntrinsicOp::FileSendMessage | IntrinsicOp::FileReceiveMessage => UNIX | STORAGE,
                    IntrinsicOp::EntropyFill => ENTROPY,
                    IntrinsicOp::ClockUnixSeconds => WALL,
                    IntrinsicOp::ClockUnixNanoseconds => NANO,
                    IntrinsicOp::FileLockWait => LOCK | STORAGE,
                    IntrinsicOp::ForeignRun | IntrinsicOp::ForeignImage | IntrinsicOp::ForeignStart
                        | IntrinsicOp::ForeignExchange | IntrinsicOp::ForeignFinish => FOREIGN,
                    IntrinsicOp::FileSetPrivate => PRIVATE,
                    IntrinsicOp::ChildRequestStop => CHILD_STOP,
                    IntrinsicOp::FileSetNonblocking | IntrinsicOp::ListenerSetNonblocking => NONBLOCKING,
                    IntrinsicOp::DirectoryCreateNew | IntrinsicOp::DirectoryCreatePrivate | IntrinsicOp::DirectoryOpenAppend
                        | IntrinsicOp::DirectorySync | IntrinsicOp::FileSync | IntrinsicOp::FileTruncate
                        | IntrinsicOp::FileLockExclusive | IntrinsicOp::ReadDirectoryOpen | IntrinsicOp::DirectoryOpenRegular
                        | IntrinsicOp::FileSeek | IntrinsicOp::FileModifiedNanoseconds => STORAGE,
                    IntrinsicOp::ListenerAcceptNoDelay => NODELAY,
                    IntrinsicOp::ConnectorConnectDeadline => CONNECT_DEADLINE,
                    _ => 0u64,
                };
            }
        }
    }
    flags
}
struct Claim {
    name: String,
    interface: String,
    body: String,
    dependencies: Vec<(String, String)>,
    imports: Vec<Binding>,
    definitions: Vec<String>,
    exports: BTreeMap<String, (usize, Span)>,
}
fn claim(interface: &Interface) -> Claim {
    let mut dependencies = Vec::new();
    for dependency in interface.dependencies() { dependencies.push((dependency.name.clone(), dependency.identity.clone())); }
    let mut imports = Vec::new();
    let mut definitions = Vec::new();
    for index in 0usize..interface.program().functions.len() {
        if interface.defined(index) {
            definitions.push(interface.program().functions[index].name.clone());
        } else { imports.push(interface.binding(index)); }
    }
    Claim { name: interface.name().to_string(), interface: interface.identity().to_string(),
        body: interface.body_identity().to_string(), dependencies, imports, definitions, exports: BTreeMap::new() }
}



struct ObjectReference {
    at: usize,
    name: usize,
    site: Span,
}
pub struct Object {
    claim: Claim,
    context: String,
    key: String,
    source_base: usize,
    flags: u64,
    sites: Vec<Span>,
    sources: Vec<String>,
    messages: Vec<String>,
    code: Linkable,
    symbols: Vec<String>,
    references: Vec<ObjectReference>,
    immediates: Vec<ObjectReference>,
    payload: Vec<u8>,
    code_start: usize,
    code_length: usize,
}


impl Object {
    pub fn key(&self) -> &str { &self.key }
    pub fn bytes(&self) -> usize { self.code_length }
    fn code_bytes(&self) -> &[u8] {
        if self.payload.is_empty() { return self.code.bytes.as_slice(); }
        &self.payload[self.code_start..self.code_start + self.code_length]
    }
    pub fn encode(&self) -> Vec<u8> {
        let mut bytes = b"LKJUNITOBJECT2\n"[..].to_vec();
        string(&mut bytes, &self.key); string(&mut bytes, &self.context);
        word(&mut bytes, self.source_base); word(&mut bytes, self.flags as usize);
        word(&mut bytes, self.sources.len());
        for path in &self.sources { string(&mut bytes, path); }
        word(&mut bytes, self.messages.len());
        for message in &self.messages { string(&mut bytes, message); }
        // Exact interface order supplies the authenticated export names.
        word(&mut bytes, self.code.definitions.len());
        for (index, (_, offset)) in self.code.definitions.iter().enumerate() {
            word(&mut bytes, *offset); site(&mut bytes, self.sites[index]);
        }
        blob(&mut bytes, self.code_bytes());
        word(&mut bytes, self.symbols.len());
        for name in &self.symbols { string(&mut bytes, name); }
        word(&mut bytes, self.references.len());
        for reference in &self.references {
            word(&mut bytes, reference.at); word(&mut bytes, reference.name); site(&mut bytes, reference.site);
        }
        word(&mut bytes, self.immediates.len());
        for reference in &self.immediates {
            word(&mut bytes, reference.at); word(&mut bytes, reference.name); site(&mut bytes, reference.site);
        }
        bytes
    }
    pub fn open(domain: &ProofDomain, interface: &Interface, context: &Context<'_>,
        source_base: usize, sources: &[String], payload: VerifiedPayload,
    ) -> Option<Self> {
        let key = object_key(interface, context, source_base, sources);
        if !payload.matches_domain(domain, NAMESPACE, &key) { return None; }
        let bytes = payload.into_bytes();
        let magic = b"LKJUNITOBJECT2\n";
        if !bytes.starts_with(magic) { return None; }
        let mut at = magic.len();
        if take_string(&bytes, &mut at)? != key { return None; }
        let stored_context = take_string(&bytes, &mut at)?;
        if stored_context != context.identity || take_word(&bytes, &mut at)? != source_base { return None; }
        let flags = take_word(&bytes, &mut at)? as u64;
        if flags & !0x7ffffu64 != 0u64 { return None; }
        let count = take_word(&bytes, &mut at)?;
        if count != sources.len() || count > (bytes.len() - at) / 8usize { return None; }
        let mut own_sources = Vec::new();
        for index in 0usize..count {
            let path = take_string(&bytes, &mut at)?;
            if path != sources[index] { return None; }
            own_sources.push(path);
        }
        let count = take_word(&bytes, &mut at)?;
        if count > (bytes.len() - at) / 16usize { return None; }
        let mut own_messages = Vec::new();
        for _ in 0usize..count {
            let message = take_string(&bytes, &mut at)?;
            if own_messages.contains(&message) { return None; }
            own_messages.push(message);
        }
        let claim = claim(interface);
        let count = take_word(&bytes, &mut at)?;
        if count != claim.definitions.len() || count > (bytes.len() - at) / 32usize { return None; }
        let mut sites = Vec::new();
        let mut definitions = Vec::new();
        for index in 0usize..count {
            let offset = take_word(&bytes, &mut at)?;
            let value = take_site(&bytes, &mut at)?;
            if value.file < source_base || value.file - source_base >= sources.len() { return None; }
            definitions.push((claim.definitions[index].clone(), offset));
            sites.push(value);
        }
        // Keep the exact already-authenticated owned bytes. Cloning this span
        // would copy every code byte again on every unchanged build.
        let code_length = take_word(&bytes, &mut at)?;
        if code_length > bytes.len() - at { return None; }
        let code_start = at;
        at += code_length;
        for (_, offset) in &definitions { if *offset >= code_length { return None; } }
        let count = take_word(&bytes, &mut at)?;
        if count > (bytes.len() - at) / 8usize { return None; }
        let mut symbols = Vec::new();
        let mut unique_symbols: BTreeSet<String> = BTreeSet::new();
        for _ in 0usize..count {
            let name = take_string(&bytes, &mut at)?;
            if name.is_empty() || !unique_symbols.insert(name.clone())
                || (name.as_str().starts_with("unit:") && parse_symbol(name.as_str()).is_none()) { return None; }
            symbols.push(name);
        }
        let count = take_word(&bytes, &mut at)?;
        if count > (bytes.len() - at) / 40usize { return None; }
        let mut references = Vec::new();
        let mut previous = None;
        for _ in 0usize..count {
            let position = take_word(&bytes, &mut at)?;
            let name = take_word(&bytes, &mut at)?;
            let value = take_site(&bytes, &mut at)?;
            if name >= symbols.len() || position > code_length || code_length - position < 4usize
                || value.file < source_base || value.file - source_base >= sources.len()
                || previous.is_some_and(|last| last + 4usize > position) { return None; }
            previous = Some(position);
            references.push(ObjectReference { at: position, name, site: value });
        }
        let count = take_word(&bytes, &mut at)?;
        if count > (bytes.len() - at) / 40usize { return None; }
        let mut immediates = Vec::new();
        for _ in 0usize..count {
            let position = take_word(&bytes, &mut at)?;
            let name = take_word(&bytes, &mut at)?;
            let value = take_site(&bytes, &mut at)?;
            if name >= own_messages.len() || position > code_length || code_length - position < 8usize
                || value.file < source_base || value.file - source_base >= sources.len() { return None; }
            immediates.push(ObjectReference { at: position, name, site: value });
        }
        if at != bytes.len() { return None; }
        Some(Self { claim, context: stored_context, key, source_base, flags, sites, sources: own_sources, messages: own_messages,
            code: Linkable { bytes: Vec::new(), definitions, references: Vec::new(), immediates: Vec::new() },
            symbols, references, immediates, payload: bytes, code_start, code_length })
    }
}
pub fn emit(unit: &CheckedUnit, context: &Context<'_>, source_base: usize) -> Result<Object, Diagnostic> {
    let runtime = context.runtime;
    let program = unit.program();
    if program.sources.len().max(1usize) > (!0usize) - source_base { return Err(error("unit source table extent overflow")); }
    let messages = super::messages(program);
    let layout = Layouts::new(program)?;
    if unit.layouts().len() != program.types.len() { return Err(error("unit layout inventory differs")); }
    for (index, expected) in unit.layouts().iter().enumerate() {
        let actual = layout.storage(index);
        if actual.bytes != expected.bytes || actual.alignment != expected.alignment
            || actual.fields != expected.fields || actual.variants != expected.variants
            || actual.scalar != expected.scalar || actual.signed != expected.signed || actual.cleanup != expected.cleanup {
            return Err(error("native layout disagrees with the authenticated unit layout"));
        }
    }
    let mut a = Assembler::new();
    a.enable_symbolic_messages();
    let p = platform::Platform::new(&mut a);
    let mut names = Vec::new();
    for index in 0usize..a.label_count() { names.push((index, platform_symbol(index))); }
    let runtime_functions = labels(&mut a, runtime.checked_program().functions.len());
    for (index, function) in runtime.checked_program().functions.iter().enumerate() {
        names.push((runtime_functions[index], runtime_symbol(&function.name)));
    }
    let functions = labels(&mut a, program.functions.len());
    for index in 0usize..functions.len() {
        if unit.imported(index) || unit.exported(index) { names.push((functions[index], symbol(&unit.binding(index)))); }
    }
    let drops = labels(&mut a, program.types.len());
    let runtime_labels = RuntimeLabels::new(runtime, &runtime_functions);
    let mut needed = vec![false; functions.len()];
    let mut needed_drops = vec![false; drops.len()];
    let mut emitted_drops = vec![false; drops.len()];
    let mut literals = BTreeMap::new();
    let mut sites = Vec::new();
    let selection = Selection { program, layout: &layout, functions: &functions, drops: &drops,
        runtime: runtime_labels, messages: &messages, source_base };
    for index in 0usize..functions.len() {
        if !unit.imported(index) {
            let mut site = first_site(&program.functions[index]); site.file += source_base;
            if unit.exported(index) { sites.push((symbol(&unit.binding(index)), site)); }
            emit_function(&mut a, p, &selection, index, &mut needed, &mut needed_drops, &mut literals)?;
        }
    }
    loop {
        let mut progress = false;
        for ty in 0usize..drops.len() {
            if needed_drops[ty] && !emitted_drops[ty] {
                emitted_drops[ty] = true; progress = true;
                emit_drop(&mut a, p, &selection, ty, &mut needed_drops, &mut needed)?;
            }
        }
        if !progress { break; }
    }
    for (bytes, label) in &literals { a.bind(*label); a.raw(bytes); }
    let mut code = a.linkable(&names)?;
    let claim = claim(unit.interface());
    let mut by_name = BTreeMap::new();
    for (name, offset) in code.definitions { by_name.insert(name, offset); }
    code.definitions = Vec::new();
    let mut by_site = BTreeMap::new();
    for (name, value) in sites { by_site.insert(name, value); }
    let mut export_sites = Vec::new();
    for name in &claim.definitions {
        let external = symbol(&Binding { unit: claim.name.clone(),
            interface_identity: claim.interface.clone(), name: name.clone() });
        let offset = *by_name.get(&external).ok_or_else(|| error("exported function has no code"))?;
        let value = *by_site.get(&external).ok_or_else(|| error("exported function has no source site"))?;
        code.definitions.push((name.clone(), offset)); export_sites.push(value);
    }
    let own_sources = if program.sources.is_empty() { vec!["<ir>".to_string()] } else { program.sources.clone() };
    let mut symbols: Vec<String> = Vec::new();
    let mut symbol_indices: BTreeMap<String, usize> = BTreeMap::new();
    let mut references = Vec::new();
    for reference in code.references {
        let known: Option<usize> = {
            let value = symbol_indices.get(&reference.name);
            match value { Some(value) => Some(*value), None => None }
        };
        let index = match known {
            Some(index) => index,
            None => {
                let index = symbols.len();
                symbol_indices.insert(reference.name.clone(), index);
                symbols.push(reference.name);
                index
            }
        };
        references.push(ObjectReference { at: reference.at, name: index, site: reference.site });
    }
    code.references = Vec::new();
    let mut own_messages: Vec<String> = Vec::new();
    let mut message_indices: BTreeMap<String, usize> = BTreeMap::new();
    let mut immediates = Vec::new();
    for reference in code.immediates {
        let known: Option<usize> = {
            let value = message_indices.get(&reference.message);
            match value { Some(value) => Some(*value), None => None }
        };
        let index = match known {
            Some(index) => index,
            None => {
                let index = own_messages.len();
                message_indices.insert(reference.message.clone(), index);
                own_messages.push(reference.message);
                index
            }
        };
        immediates.push(ObjectReference { at: reference.at, name: index, site: reference.site });
    }
    code.immediates = Vec::new();
    let code_length = code.bytes.len();
    Ok(Object { claim, context: context.identity.clone(),
        key: object_key(unit.interface(), context, source_base, &own_sources), source_base,
        flags: features(program), sites: export_sites, sources: own_sources, messages: own_messages, code,
        symbols, references, immediates, payload: Vec::new(), code_start: 0usize, code_length })
}

struct Tables {
    source_base: usize,
    sources: Vec<String>,
    messages: Vec<String>,
}
/// Own the unpublished output descriptor until every dependency and relocation is verified.
/// Bodies, local labels and encoded bytes are released after each push.
pub struct Linker {
    output: File,
    position: usize,
    context: Option<String>,
    flags: u64,
    claims: super::records::Store,
    provider: Option<claims::StoredClaim>,
    units: usize,
    symbols: BTreeMap<String, usize>,
    relocations: File,
    record_count: usize,
    relocation_bytes: usize,
    maximum_packet_bytes: usize,
    maximum_name_bytes: usize,
    relocation_hash: crate::sha256::Sha256,
    failed: bool,
}




impl Linker {
    pub fn new(mut output: File, mut relocations: File, records: File) -> Result<Self, Diagnostic> {
        output.truncate(0usize).map_err(|errno: i64| io("truncate unit output", errno))?;
        output.seek(0i64, 0u8).map_err(|errno: i64| io("seek unit output", errno))?;
        relocations.truncate(0usize).map_err(|errno: i64| io("truncate relocation spool", errno))?;
        relocations.seek(0i64, 0u8).map_err(|errno: i64| io("seek relocation spool", errno))?;
        output.write_all(&vec![0u8; platform::CODE_OFFSET]).map_err(|errno: i64| io("reserve ELF header", errno))?;
        output.write_all(&[0xe9u8, 0u8, 0u8, 0u8, 0u8]).map_err(|errno: i64| io("write entry branch", errno))?;
        let claims = super::records::Store::new(records).map_err(|message: String| error(&message))?;
        let mut result = Self { output, position: 5usize, context: None, flags: 0u64,
            claims, provider: None, units: 0usize, symbols: BTreeMap::new(),
            relocations, record_count: 0usize, relocation_bytes: 0usize,
            maximum_packet_bytes: 0usize, maximum_name_bytes: 0usize,
            relocation_hash: crate::sha256::Sha256::new(), failed: false };
        result.reference(0usize, 1usize, "entry", Span::default())?;
        Ok(result)
    }
    fn reference(&mut self, kind: usize, position: usize, name: &str, value: Span) -> Result<(), Diagnostic> {
        let mut record = Vec::new();
        word(&mut record, kind); word(&mut record, position); string(&mut record, name); site(&mut record, value);
        self.maximum_name_bytes = self.maximum_name_bytes.max(name.len());
        self.records(&record, 1usize)
    }
    fn records(&mut self, records: &[u8], count: usize) -> Result<(), Diagnostic> {
        if records.is_empty() { return Ok(()); }
        let next = self.relocation_bytes.checked_add(records.len()).ok_or_else(|| error("relocation spool extent overflow"))?;
        let next_count = self.record_count.checked_add(count).ok_or_else(|| error("relocation record count overflow"))?;
        if next > 9223372036854775807usize { return Err(error("relocation spool exceeds file seek representation")); }
        self.relocations.seek(self.relocation_bytes as i64, 0u8).map_err(|errno: i64| io("seek relocation append", errno))?;
        self.relocations.write_all(records).map_err(|errno: i64| io("write relocation spool", errno))?;
        self.relocation_hash.update(records);
        self.relocation_bytes = next;
        self.record_count = next_count;
        Ok(())
    }
    fn append(&mut self, code: &Linkable, bytes: &[u8]) -> Result<(), Diagnostic> {
        let next = self.position.checked_add(bytes.len()).ok_or_else(|| error("unit image extent overflow"))?;
        if next > 9223372036854775807usize - platform::CODE_OFFSET { return Err(error("unit image exceeds file seek representation")); }
        for (name, offset) in &code.definitions {
            if *offset > bytes.len() || self.symbols.contains_key(name) {
                return Err(error(&format!("duplicate or out-of-range unit symbol {name}")));
            }
            self.symbols.insert(name.clone(), self.position + *offset);
        }
        let mut records = Vec::new();
        let mut count = 0usize;
        for reference in &code.references {
            if reference.at > bytes.len() || bytes.len() - reference.at < 4usize {
                return Err(error("unit relocation is outside its object"));
            }
            word(&mut records, 0usize); word(&mut records, self.position + reference.at);
            string(&mut records, &reference.name); site(&mut records, reference.site); count += 1usize;
            self.maximum_name_bytes = self.maximum_name_bytes.max(reference.name.len());
        }
        for reference in &code.immediates {
            if reference.at > bytes.len() || bytes.len() - reference.at < 8usize { return Err(error("unit message relocation is outside its object")); }
            word(&mut records, 1usize); word(&mut records, self.position + reference.at);
            string(&mut records, &reference.message); site(&mut records, reference.site); count += 1usize;
            self.maximum_name_bytes = self.maximum_name_bytes.max(reference.message.len());
        }
        self.records(&records, count)?;
        let position = self.position + platform::CODE_OFFSET;
        self.output.seek(position as i64, 0u8).map_err(|errno: i64| io("seek unit object", errno))?;
        self.output.write_all(bytes).map_err(|errno: i64| io("write unit object", errno))?;
        self.position = next;
        Ok(())
    }
    fn append_object(&mut self, object: &Object) -> Result<(), Diagnostic> {
        let bytes = object.code_bytes();
        let next = self.position.checked_add(bytes.len()).ok_or_else(|| error("unit image extent overflow"))?;
        if next > 9223372036854775807usize - platform::CODE_OFFSET { return Err(error("unit image exceeds file seek representation")); }
        // Keep each object's names once through the spool as well as its stored payload.
        let mut records = Vec::new();
        word(&mut records, 2usize); word(&mut records, 0usize);
        word(&mut records, object.symbols.len());
        for name in &object.symbols { string(&mut records, name); }
        word(&mut records, object.messages.len());
        for message in &object.messages { string(&mut records, message); }
        let count = object.references.len().checked_add(object.immediates.len())
            .ok_or_else(|| error("unit relocation count overflow"))?;
        word(&mut records, count);
        for reference in &object.references {
            if reference.name >= object.symbols.len() || reference.at > bytes.len()
                || bytes.len() - reference.at < 4usize { return Err(error("unit relocation is outside its object")); }
            word(&mut records, 0usize); word(&mut records, self.position + reference.at);
            word(&mut records, reference.name); site(&mut records, reference.site);
        }
        for reference in &object.immediates {
            if reference.name >= object.messages.len() || reference.at > bytes.len()
                || bytes.len() - reference.at < 8usize { return Err(error("unit message relocation is outside its object")); }
            word(&mut records, 1usize); word(&mut records, self.position + reference.at);
            word(&mut records, reference.name); site(&mut records, reference.site);
        }
        let payload_length = records.len() - 16usize;
        for index in 0usize..8usize { records[8usize + index] = (payload_length >> (index * 8usize)) as u8; }
        self.records(&records, 1usize)?;
        // This bound comes from the trusted writer, never from the spool reader.
        self.maximum_packet_bytes = self.maximum_packet_bytes.max(payload_length);
        let position = self.position + platform::CODE_OFFSET;
        self.output.seek(position as i64, 0u8).map_err(|errno: i64| io("seek unit object", errno))?;
        self.output.write_all(bytes).map_err(|errno: i64| io("write unit object", errno))?;
        self.position = next;
        Ok(())
    }
    pub fn push(&mut self, object: Object) -> Result<(), Diagnostic> {
        if self.failed { return Err(error("unit linker is poisoned by an earlier failure")); }
        self.failed = true;
        let result = self.push_object(object);
        if result.is_ok() { self.failed = false; }
        result
    }
    fn push_object(&mut self, object: Object) -> Result<(), Diagnostic> {
        let existing_context = self.context.clone();
        if let Some(context) = existing_context {
            if context != object.context { return Err(error("unit objects use different runtime or target identities")); }
        } else { self.context = Some(object.context.clone()); }
        if self.claims.contains(&claims::claim_key(&object.claim.name)).map_err(|message: String| error(&message))? {
            return Err(error(&format!("duplicate unit implementation {}", object.claim.name)));
        }
        if object.code.definitions.len() != object.claim.definitions.len()
            || object.sites.len() != object.claim.definitions.len() {
            return Err(error("unit object does not define its complete checked interface"));
        }
        for (index, (name, offset)) in object.code.definitions.iter().enumerate() {
            if *name != object.claim.definitions[index] || *offset >= object.bytes() {
                return Err(error("unit object export differs from checked interface"));
            }
        }
        let base = self.position;
        let code_length = object.bytes();
        self.append_object(&object)?;
        self.flags |= object.flags;
        let mut claim = object.claim;
        let mut index = 0usize;
        for (name, offset) in object.code.definitions {
            if claim.exports.insert(name, (base + offset, object.sites[index])).is_some() {
                return Err(error("duplicate unit export"));
            }
            index += 1usize;
        }
        // The exact ordinal/name comparison is finished. Release every function
        // name after writing this unit's writer-bound claim.
        claim.definitions = Vec::new();
        let stored = claims::StoredClaim { claim, base, bytes: code_length, source_base: object.source_base,
            source_count: object.sources.len() };
        self.claims.insert(&claims::claim_key(&stored.claim.name), &claims::claim_bytes(&stored, &object.context))
            .map_err(|message: String| error(&message))?;
        self.claims.insert(&claims::identity_key(&stored.claim.name),
            &claims::identity_bytes(&stored.claim.name, &stored.claim.interface, &object.context))
            .map_err(|message: String| error(&message))?;
        let table = Tables { source_base: object.source_base, sources: object.sources, messages: object.messages };
        self.claims.insert(&claims::table_key(self.units), &claims::table_bytes(&table, self.units, &object.context))
            .map_err(|message: String| error(&message))?;
        self.units = self.units.checked_add(1usize).ok_or_else(|| error("unit registry count overflow"))?;
        Ok(())
    }
    pub fn finish(self, context: &Context<'_>, entry: &Interface, entry_name: &str,
        grants: &[ir::EntryGrant], sources: &[String], messages: &[String], result_fd: Option<u32>,
    ) -> Result<(File, usize), Diagnostic> {
        self.finish_input(context, entry, entry_name, grants, image_tables::Input::slice(sources, messages), result_fd)
    }
    pub fn finish_with_tables(self, context: &Context<'_>, entry: &Interface, entry_name: &str,
        grants: &[ir::EntryGrant], tables: ImageTables, result_fd: Option<u32>,
    ) -> Result<(File, usize), Diagnostic> {
        self.finish_input(context, entry, entry_name, grants, image_tables::Input::Disk(tables), result_fd)
    }
    fn finish_input(mut self, context: &Context<'_>, entry: &Interface, entry_name: &str,
        grants: &[ir::EntryGrant], mut tables: image_tables::Input<'_>, result_fd: Option<u32>,
    ) -> Result<(File, usize), Diagnostic> {
        let runtime = context.runtime;
        let source_count = tables.source_count();
        if self.failed { return Err(error("unit linker is poisoned by an earlier failure")); }
        if self.context.as_ref() != Some(&context.identity) {
            return Err(error("linked runtime differs from unit object runtime"));
        }
        let entry_unit_name = entry.name().to_string();
        {
            let selected = claims::read_claim(&mut self.claims, &entry_unit_name, &context.identity)?
                .ok_or_else(|| error("entry unit has no implementation"))?;
            if selected.claim.interface.as_str() != entry.identity() || selected.claim.body.as_str() != entry.body_identity() {
                return Err(error("entry interface or implementation is stale"));
            }
        }
        let mut key = self.claims.first().map_err(|message: String| error(&message))?;
        let mut checked_claims = 0usize;
        while let Some(current) = key {
            if !current.as_str().starts_with("C") { break; }
            let stored = claims::read_claim(&mut self.claims, &current[1usize..], &context.identity)?
                .ok_or_else(|| error("unit registry lost a selected claim"))?;
            let claim = stored.claim;
            let stored_identity = claims::read_identity(&mut self.claims, &claim.name, &context.identity)?
                .ok_or_else(|| error("unit registry lost an identity"))?;
            if stored_identity != claim.interface { return Err(error("unit registry identity differs from its claim")); }
            for (name, identity) in &claim.dependencies {
                let Some(actual) = claims::read_identity(&mut self.claims, name, &context.identity)? else {
                    return Err(error(&format!("unit {} is missing dependency {name}", claim.name)));
                };
                if actual != *identity {
                    return Err(error(&format!("unit {} has a stale dependency interface {name}", claim.name)));
                }
            }
            claims::check_claim_imports(&mut self.claims, &mut self.provider, &claim, &context.identity)?;
            checked_claims += 1usize;
            key = self.claims.after(&current).map_err(|message: String| error(&message))?;
        }
        if checked_claims != self.units || self.units.checked_mul(3usize) != Some(self.claims.len()) {
            return Err(error("unit registry inventory changed"));
        }
        self.provider = None;
        // Preserve arrival order independently of lexicographic claim order.
        for ordinal in 0usize..self.units {
            let bytes = self.claims.get(&claims::table_key(ordinal)).map_err(|message: String| error(&message))?
                .ok_or_else(|| error("unit registry lost a source table"))?;
            let table = claims::decode_table(&bytes, ordinal, &context.identity).ok_or_else(|| error("malformed stored unit table"))?;
            if table.source_base > source_count || table.sources.len() > source_count - table.source_base {
                return Err(error("unit source table does not fit the final image"));
            }
            for (index, path) in table.sources.iter().enumerate() {
                if *path != tables.source(table.source_base + index)? { return Err(error("unit source table changed after emission")); }
            }
            for message in &table.messages {
                if !tables.contains_message(message)? { return Err(error("unit trap message is absent from the final image")); }
            }
        }
        tables.prepare()?;
        let program = entry.program();
        let selected = program.functions.iter().position(|function| function.name == entry_name)
            .ok_or_else(|| error(&format!("unknown unit entry {entry_name}")))?;
        if !entry.defined(selected) { return Err(error("entry must be defined by its selected unit")); }
        let selected_binding = entry.binding(selected);
        let binding = symbol(&selected_binding);
        let (_, site) = claims::resolve_binding(&mut self.claims, &mut self.provider, &selected_binding, &context.identity)?
            .ok_or_else(|| error("entry site has no implementation"))?;
        let support = support_stream(runtime, program, selected, &binding, site, grants,
            &mut tables, result_fd, self.flags, self.position, &mut self.output)?;
        let data_offset = support.data_offset;
        self.append(&support.code, &support.code.bytes)?;
        if self.position != data_offset || support.end < data_offset {
            return Err(error("streamed support code differs from its data boundary"));
        }
        // Only the support writer may export these already-written data labels.
        // Ordinary object and assembler definition bounds remain unchanged.
        for (name, position) in &support.data_definitions {
            if *position < data_offset || *position > support.end || self.symbols.contains_key(name) {
                return Err(error(&format!("duplicate or out-of-range unit data symbol {name}")));
            }
            self.symbols.insert(name.clone(), *position);
        }
        self.position = support.end;
        self.relocations.seek(0i64, 0u8).map_err(|errno: i64| io("rewind relocation spool", errno))?;
        let expected_hash = std::mem::replace(&mut self.relocation_hash, crate::sha256::Sha256::new()).finish();
        {
            let mut records = Relocations::new(&mut self.relocations, self.relocation_bytes);
            let mut patches = PatchWindow::new(&mut self.output, platform::CODE_OFFSET + self.position);
            for _ in 0usize..self.record_count {
                let kind = records.word()?;
                if kind == 2usize {
                    records.packet(self.maximum_packet_bytes, &mut self.claims, &mut self.provider, &context.identity,
                        &self.symbols, &mut tables, &mut patches, data_offset, source_count)?;
                } else {
                    if kind > 1usize { return Err(error("unknown unit relocation kind")); }
                    let (position, name, site) = records.named_record(self.maximum_name_bytes)?;
                    relocation_position(kind, position, data_offset)?;
                    let target = if kind == 0usize {
                        claims::resolve_symbol(&mut self.claims, &mut self.provider, &self.symbols, &name, &context.identity)?
                            .ok_or_else(|| Diagnostic::new(site, "E_UNIT_LINK", &format!("unresolved unit symbol {name}")))?
                    } else {
                        tables.code(&name)?.ok_or_else(|| error("unit message relocation is absent from final table"))?
                    };
                    apply_relocation(&mut patches, kind, position, target, site)?;
                }
            }
            records.finish(expected_hash)?;
            self.claims.finish().map_err(|message: String| error(&message))?;
            tables.finish()?;
            patches.flush()?;
        }
        let header = platform::elf_header(self.position, data_offset)?;
        self.output.seek(0i64, 0u8).map_err(|errno: i64| io("seek ELF header", errno))?;
        self.output.write_all(&header).map_err(|errno: i64| io("write ELF header", errno))?;
        let length = platform::CODE_OFFSET + self.position;
        self.output.seek(length as i64, 0u8).map_err(|errno: i64| io("seek finished image", errno))?;
        Ok((self.output, length))
    }
}
const LINK_BUFFER: usize = 65536usize;

struct Relocations<'a> {
    file: &'a mut File,
    buffer: Vec<u8>,
    at: usize,
    available: usize,
    unread: usize,
    remaining: usize,
    hash: crate::sha256::Sha256,
}



impl<'a> Relocations<'a> {
    fn new(file: &'a mut File, length: usize) -> Self {
        Self { file, buffer: vec![0u8; LINK_BUFFER], at: 0usize, available: 0usize,
            unread: length, remaining: length, hash: crate::sha256::Sha256::new() }
    }
    fn exact(&mut self, bytes: &mut [u8]) -> Result<(), Diagnostic> {
        if bytes.len() > self.remaining { return Err(error("truncated relocation spool")); }
        let mut written = 0usize;
        while written < bytes.len() {
            if self.at == self.available {
                let wanted = self.unread.min(LINK_BUFFER);
                if wanted == 0usize { return Err(error("truncated relocation spool")); }
                let count = self.file.read(&mut self.buffer[..wanted]).map_err(|errno: i64| io("read relocation spool", errno))?;
                if count == 0usize { return Err(error("truncated relocation spool")); }
                self.hash.update(&self.buffer[..count]);
                self.unread -= count;
                self.at = 0usize;
                self.available = count;
            }
            let count = (bytes.len() - written).min(self.available - self.at);
            bytes[written..written + count].copy_from_slice(&self.buffer[self.at..self.at + count]);
            self.at += count;
            written += count;
            self.remaining -= count;
        }
        Ok(())
    }
    fn word(&mut self) -> Result<usize, Diagnostic> {
        let mut bytes = [0u8; 8]; self.exact(&mut bytes)?;
        let mut at = 0usize;
        Ok(take_word(&bytes, &mut at).unwrap())
    }
    fn named_record(&mut self, maximum_name_bytes: usize) -> Result<(usize, String, Span), Diagnostic> {
        if self.remaining < 40usize { return Err(error("truncated relocation record")); }
        let mut prefix = [0u8; 16]; self.exact(&mut prefix)?;
        let mut at = 0usize;
        let position = take_word(&prefix, &mut at).unwrap();
        let length = take_word(&prefix, &mut at).unwrap();
        if length > self.remaining - 24usize || length > maximum_name_bytes {
            return Err(error("invalid relocation symbol extent"));
        }
        let mut name = vec![0u8; length]; self.exact(&mut name)?;
        let name = String::from_utf8(name).map_err(|_| error("relocation symbol is not UTF-8"))?;
        let mut coordinates = [0u8; 24]; self.exact(&mut coordinates)?;
        let mut at = 0usize;
        let site = take_site(&coordinates, &mut at).unwrap();
        Ok((position, name, site))
    }
    fn packet_word(&mut self, remaining: &mut usize) -> Result<usize, Diagnostic> {
        if *remaining < 8usize { return Err(error("truncated relocation packet")); }
        *remaining -= 8usize;
        self.word()
    }
    fn packet_names(&mut self, remaining: &mut usize, symbolic: bool) -> Result<Vec<RelocationName>, Diagnostic> {
        let count = self.packet_word(remaining)?;
        if count > *remaining / 8usize { return Err(error("invalid relocation table count")); }
        let mut names = Vec::new();
        let mut seen: BTreeSet<String> = BTreeSet::new();
        for _ in 0usize..count {
            let length = self.packet_word(remaining)?;
            if length > *remaining { return Err(error("invalid relocation symbol extent")); }
            let mut bytes = vec![0u8; length]; self.exact(&mut bytes)?;
            *remaining -= length;
            let name = String::from_utf8(bytes).map_err(|_| error("relocation symbol is not UTF-8"))?;
            if !seen.insert(name.clone()) { return Err(error("duplicate relocation table name")); }
            if symbolic && name.is_empty() { return Err(error("empty relocation symbol")); }
            let binding = if symbolic && name.as_str().starts_with("unit:") {
                Some(parse_symbol(&name).ok_or_else(|| error("invalid unit relocation symbol"))?)
            } else { None };
            names.push(RelocationName { name, binding, value: None });
        }
        Ok(names)
    }
    fn packet(&mut self, maximum_packet_bytes: usize, claims: &mut super::records::Store,
        cached: &mut Option<claims::StoredClaim>, context: &str,
        symbols: &BTreeMap<String, usize>, tables: &mut image_tables::Input<'_>,
        patches: &mut PatchWindow<'_>, data_offset: usize, source_count: usize,
    ) -> Result<(), Diagnostic> {
        let length = self.word()?;
        if length < 24usize || length > maximum_packet_bytes || length > self.remaining {
            return Err(error("invalid relocation packet extent"));
        }
        let mut remaining = length;
        let mut names = self.packet_names(&mut remaining, true)?;
        let mut messages = self.packet_names(&mut remaining, false)?;
        prepare_names(&mut names, claims, cached, symbols, context)?;
        let count = self.packet_word(&mut remaining)?;
        if remaining % 48usize != 0usize || count != remaining / 48usize {
            return Err(error("invalid relocation packet rows"));
        }
        for _ in 0usize..count {
            let mut row = [0u8; 48]; self.exact(&mut row)?;
            remaining -= 48usize;
            let mut at = 0usize;
            let kind = take_word(&row, &mut at).unwrap();
            let position = take_word(&row, &mut at).unwrap();
            let ordinal = take_word(&row, &mut at).unwrap();
            let site = take_site(&row, &mut at).unwrap();
            relocation_position(kind, position, data_offset)?;
            if site.file >= source_count { return Err(error("invalid relocation reference site")); }
            let target = if kind == 0usize {
                if ordinal >= names.len() { return Err(error("invalid relocation symbol ordinal")); }
                names[ordinal].resolve(tables, false, site)?
            } else {
                if ordinal >= messages.len() { return Err(error("invalid relocation message ordinal")); }
                messages[ordinal].resolve(tables, true, site)?
            };
            apply_relocation(patches, kind, position, target, site)?;
        }
        if remaining != 0usize { return Err(error("relocation packet has trailing bytes")); }
        Ok(())
    }
    fn finish(mut self, expected: [u8; 32]) -> Result<(), Diagnostic> {
        if self.remaining != 0usize || self.unread != 0usize || self.at != self.available {
            return Err(error("relocation spool has trailing bytes"));
        }
        let mut extra = [0u8; 1];
        if self.file.read(&mut extra).map_err(|errno: i64| io("check relocation EOF", errno))? != 0usize {
            return Err(error("relocation spool changed its extent"));
        }
        if self.hash.finish() != expected { return Err(error("relocation spool changed after emission")); }
        Ok(())
    }
}

struct RelocationName {
    name: String,
    binding: Option<Binding>,
    value: Option<usize>,
}


fn prepare_names(names: &mut [RelocationName], claims: &mut super::records::Store,
    cached: &mut Option<claims::StoredClaim>, symbols: &BTreeMap<String, usize>, context: &str,
) -> Result<(), Diagnostic> {
    let mut groups: BTreeMap<(String, String), Vec<usize>> = BTreeMap::new();
    for (index, name) in names.iter().enumerate() {
        if let Some(binding) = &name.binding {
            let key = (binding.unit.clone(), binding.interface_identity.clone());
            if !groups.contains_key(&key) { groups.insert(key.clone(), Vec::new()); }
            groups.get_mut(&key).unwrap().push(index);
        }
    }
    for (_, indices) in groups {
        for index in indices {
            let binding = names[index].binding.as_ref().unwrap();
            let target = claims::resolve_binding(claims, cached, binding, context)?.map(|value: (usize, Span)| value.0);
            names[index].value = target;
        }
    }
    for index in 0usize..names.len() {
        if names[index].binding.is_none() {
            let value = symbols.get(&names[index].name).copied();
            names[index].value = value;
        }
    }
    Ok(())
}
impl RelocationName {
    fn resolve(&mut self, tables: &mut image_tables::Input<'_>, message: bool, site: Span,
    ) -> Result<usize, Diagnostic> {
        if let Some(value) = self.value { return Ok(value); }
        let value = if message {
            tables.code(&self.name)?.ok_or_else(|| error("unit message relocation is absent from final table"))?
        } else {
            // A missing target is reported only by its first original row,
            // including when an earlier unused table entry has no provider.
            return Err(Diagnostic::new(site, "E_UNIT_LINK", &format!("unresolved unit symbol {}", self.name)));
        };
        self.value = Some(value);
        Ok(value)
    }
}

fn relocation_position(kind: usize, position: usize, data_offset: usize) -> Result<(), Diagnostic> {
    let width = if kind == 0usize { 4usize } else if kind == 1usize { 8usize }
        else { return Err(error("unknown unit relocation kind")); };
    if position > data_offset || width > data_offset - position {
        return Err(error("unit relocation is outside image code"));
    }
    Ok(())
}

fn apply_relocation(patches: &mut PatchWindow<'_>, kind: usize, position: usize, target: usize, site: Span)
    -> Result<(), Diagnostic> {
    if kind == 0usize {
        let bytes = crate::x86::displacement(target, position, site)?;
        patches.write(platform::CODE_OFFSET + position, &bytes)
    } else {
        let mut bytes = [0u8; 8];
        for index in 0usize..8usize { bytes[index] = (target >> (index * 8usize)) as u8; }
        patches.write(platform::CODE_OFFSET + position, &bytes)
    }
}
struct PatchWindow<'a> {
    file: &'a mut File,
    buffer: Vec<u8>,
    start: usize,
    length: usize,
    image_length: usize,
    dirty: bool,
}

impl<'a> PatchWindow<'a> {
    fn new(file: &'a mut File, image_length: usize) -> Self {
        Self { file, buffer: vec![0u8; LINK_BUFFER], start: 0usize, length: 0usize, image_length, dirty: false }
    }
    fn flush(&mut self) -> Result<(), Diagnostic> {
        if self.dirty {
            self.file.seek(self.start as i64, 0u8).map_err(|errno: i64| io("seek relocation window", errno))?;
            self.file.write_all(&self.buffer[..self.length]).map_err(|errno: i64| io("write relocation window", errno))?;
            self.dirty = false;
        }
        Ok(())
    }
    fn load(&mut self, start: usize) -> Result<(), Diagnostic> {
        self.flush()?;
        if start >= self.image_length { return Err(error("relocation window is outside image")); }
        self.start = start;
        self.length = (self.image_length - start).min(LINK_BUFFER);
        self.file.seek(start as i64, 0u8).map_err(|errno: i64| io("seek relocation window", errno))?;
        let mut at = 0usize;
        while at < self.length {
            let count = self.file.read(&mut self.buffer[at..self.length]).map_err(|errno: i64| io("read relocation window", errno))?;
            if count == 0usize { return Err(error("linked image was truncated before relocation")); }
            at += count;
        }
        Ok(())
    }
    fn write(&mut self, position: usize, bytes: &[u8]) -> Result<(), Diagnostic> {
        if position > self.image_length || bytes.len() > self.image_length - position {
            return Err(error("relocation patch is outside image"));
        }
        let mut written = 0usize;
        while written < bytes.len() {
            let at = position + written;
            let start = at - at % LINK_BUFFER;
            if self.length == 0usize || start != self.start { self.load(start)?; }
            let offset = at - start;
            let count = (bytes.len() - written).min(self.length - offset);
            self.buffer[offset..offset + count].copy_from_slice(&bytes[written..written + count]);
            self.dirty = true;
            written += count;
        }
        Ok(())
    }
}

struct SupportCode {
    assembler: Assembler,
    platform: platform::Platform,
    names: Vec<(Label, String)>,
    plan: entry::Plan,
    literals: BTreeMap<Vec<u8>, Label>,
    runtime_messages: Vec<String>,
    flags: u64,
    data_offset: usize,
}

struct SupportImage {
    code: Linkable,
    data_definitions: Vec<(String, usize)>,
    data_offset: usize,
    end: usize,
}

fn support_code(runtime: &Runtime, program: &Program, selected: usize, binding: &str, site: Span,
    grants: &[ir::EntryGrant], source_count: usize, result_fd: Option<u32>,
    mut flags: u64, base: usize,
) -> Result<SupportCode, Diagnostic> {
    let function = &program.functions[selected];
    if !scalar_entry(&program.types[function.result].kind) || grants.len() != function.params {
        return Err(error("unit entry must return a scalar and have exactly its declared grants"));
    }
    for index in 0usize..grants.len() {
        if !grant_matches(&program.types[function.locals[index].ty].kind, &grants[index], function.params) {
            return Err(error("unit entry grant does not match its checked parameter"));
        }
        match &grants[index] {
            ir::EntryGrant::Listener(_) => flags |= LISTENER,
            ir::EntryGrant::DirectoryEnvironment(_) | ir::EntryGrant::ReadDirectoryEnvironment(_) => flags |= ENVIRONMENT,
            ir::EntryGrant::UnixStreamEnvironment(_) => flags |= ENVIRONMENT | UNIX | STORAGE,
            ir::EntryGrant::UnixStream(_) | ir::EntryGrant::UnixStreamEnvironmentValue(_, _) => flags |= UNIX | STORAGE,
            ir::EntryGrant::ForeignCommand(_) | ir::EntryGrant::NullDevice => flags |= FOREIGN,
            _ => {},
        }
    }
    let mut a = Assembler::at_base(base);
    let mut p = platform::Platform::new(&mut a);
    p.source_base = source_count;
    p.stop_signals = flags & STOP != 0u64;
    p.listener_reuse = flags & LISTENER != 0u64;
    p.command_environment = flags & ENVIRONMENT != 0u64;
    p.blocking_lock = flags & LOCK != 0u64;
    p.diagnostic_stdout = grants.iter().any(|grant| matches!(grant, ir::EntryGrant::World | ir::EntryGrant::Stdout));
    p.diagnostic_stderr = grants.iter().any(|grant| matches!(grant, ir::EntryGrant::World | ir::EntryGrant::Stderr));
    let mut names = Vec::new();
    for index in 0usize..a.label_count() { names.push((index, platform_symbol(index))); }
    let runtime_program = runtime.checked_program();
    let runtime_functions = labels(&mut a, runtime_program.functions.len());
    for (index, function) in runtime_program.functions.iter().enumerate() {
        names.push((runtime_functions[index], runtime_symbol(&function.name)));
    }
    let entry_label = a.label(); names.push((entry_label, binding.to_string()));
    let start = a.label(); a.bind(start); names.push((start, "entry".to_string()));
    let plan = entry::Plan::new(&mut a, grants, site);
    let entry = Entry { function: 0usize, arguments: vec![0i64; grants.len()], result_fd };
    platform::emit(&mut a, p, entry_label, &entry, None, Some(&plan));
    if flags & FOREIGN != 0u64 { foreign::emit(&mut a, p); }
    if flags & WORKERS != 0u64 { workers::emit(&mut a, p); }
    if flags & REGION != 0u64 { read_region::emit(&mut a, p); }
    if flags & CONNECTOR != 0u64 { network::emit_connector(&mut a, p); }
    if flags & CONNECT_DEADLINE != 0u64 { connect_deadline::emit(&mut a, p); }
    if flags & NODELAY != 0u64 { network::emit_accept_nodelay(&mut a, p); }
    if flags & READINESS != 0u64 { readiness::emit(&mut a, p); }
    if flags & NONBLOCKING != 0u64 { readiness::emit_nonblocking(&mut a, p); }
    if flags & STORAGE != 0u64 { storage::emit(&mut a, p); }
    if flags & UNIX != 0u64 { unix::emit(&mut a, p); }
    if flags & ENTROPY != 0u64 { lifecycle::entropy(&mut a, p); }
    if flags & WALL != 0u64 { lifecycle::wall_time(&mut a, p); }
    if flags & NANO != 0u64 { lifecycle::wall_nanoseconds(&mut a, p); }
    if flags & PRIVATE != 0u64 { lifecycle::private_file(&mut a, p); }
    if flags & CHILD_STOP != 0u64 { lifecycle::child_stop(&mut a, p); }
    if flags & STOP != 0u64 { lifecycle::stop(&mut a, p); }
    let layout = Layouts::new(runtime_program)?;
    let runtime_labels = RuntimeLabels::new(runtime, &runtime_functions);
    let drops = labels(&mut a, runtime_program.types.len());
    let mut needed = vec![true; runtime_functions.len()];
    let mut needed_drops = vec![false; drops.len()];
    let mut emitted_drops = vec![false; drops.len()];
    let mut literals = BTreeMap::new();
    let runtime_messages = super::messages(runtime_program);
    {
    let selection = Selection { program: runtime_program, layout: &layout, functions: &runtime_functions,
        drops: &drops, runtime: runtime_labels, messages: &runtime_messages, source_base: source_count };
    for index in 0usize..runtime_functions.len() {
        if let Some(primitive) = runtime.primitive(index) {
            let mut site = first_site(&runtime_program.functions[index]); site.file += source_count;
            emit_primitive(&mut a, p, runtime_functions[index], primitive, site);
        } else {
            emit_function(&mut a, p, &selection, index, &mut needed, &mut needed_drops, &mut literals)?;
        }
    }
    loop {
        let mut progress = false;
        for ty in 0usize..drops.len() {
            if needed_drops[ty] && !emitted_drops[ty] {
                emitted_drops[ty] = true; progress = true;
                emit_drop(&mut a, p, &selection, ty, &mut needed_drops, &mut needed)?;
            }
        }
        if !progress { break; }
    }
    }
    let code_end = base.checked_add(a.bytes.len()).ok_or_else(|| error("unit runtime extent overflow"))?;
    let data_offset = code_end.checked_add(4095usize).ok_or_else(|| error("unit data alignment overflow"))? & !4095usize;
    Ok(SupportCode { assembler: a, platform: p, names, plan, literals, runtime_messages, flags, data_offset })
}
// Preserve the vector encoder as an independent small-input byte oracle.
fn support(runtime: &Runtime, program: &Program, selected: usize, binding: &str, site: Span,
    grants: &[ir::EntryGrant], sources: &[String], messages: &[String], result_fd: Option<u32>,
    flags: u64, base: usize,
) -> Result<(Linkable, usize), Diagnostic> {
    let code = support_code(runtime, program, selected, binding, site, grants, sources.len(), result_fd, flags, base)?;
    let mut a = code.assembler; let p = code.platform; let names = code.names;
    let plan = code.plan; let literals = code.literals; let runtime_messages = code.runtime_messages;
    let flags = code.flags; let data_offset = code.data_offset;
    let runtime_program = runtime.checked_program();
    let mut data = Vec::new();
    platform::data(&mut a, p, &mut data, data_offset, messages);
    platform::message_data(&mut a, p.runtime_messages, &mut data, data_offset, &runtime_messages);
    let mut paths = sources.to_vec();
    for path in &runtime_program.sources { paths.push(path.clone()); }
    diagnostics::data(&mut a, p, &mut data, data_offset, &paths);
    if flags & STOP != 0u64 { lifecycle::data(&mut a, p, &mut data, data_offset); }
    plan.data(&mut a, &mut data, data_offset);
    for (bytes, label) in &literals {
        a.data_label(*label, data_offset + data.len()); data.extend_from_slice(bytes);
    }
    while a.bytes.len() < data_offset - base { a.bytes.push(0u8); }
    a.bytes.extend_from_slice(&data);
    Ok((a.linkable(&names)?, data_offset))
}


fn support_stream(runtime: &Runtime, program: &Program, selected: usize, binding: &str, site: Span,
    grants: &[ir::EntryGrant], tables: &mut image_tables::Input<'_>, result_fd: Option<u32>,
    flags: u64, base: usize, output: &mut File,
) -> Result<SupportImage, Diagnostic> {
    let code = support_code(runtime, program, selected, binding, site, grants, tables.source_count(), result_fd, flags, base)?;
    let mut a = code.assembler;
    let data_offset = code.data_offset;
    let end = table_data::support(output, &mut a, code.platform, data_offset, tables,
        &runtime.checked_program().sources, &code.runtime_messages, code.flags, &code.plan, &code.literals)?;
    while a.bytes.len() < data_offset - base { a.bytes.push(0u8); }
    for label in 0usize..a.label_count() {
        if let Some(position) = a.position(label) {
            if position < base || position > end { return Err(error("support label is outside its written image extent")); }
        }
    }
    let mut code_names = Vec::new();
    let mut data_definitions = Vec::new();
    for (label, name) in code.names {
        let data = match a.position(label) { Some(position) => position >= data_offset, None => false };
        if data {
            let position = a.position(label).unwrap();
            if position > end { return Err(error("support data label is outside its written extent")); }
            data_definitions.push((name, position));
        } else { code_names.push((label, name)); }
    }
    let code = a.linkable(&code_names)?;
    Ok(SupportImage { code, data_definitions, data_offset, end })
}

pub(crate) fn table_contracts(world: &mut World, runtime: &Context<'_>, entry: &CheckedUnit) -> usize {
    table_tests::run(world, runtime, entry)
}
pub(crate) fn identity_contracts(world: &mut World, context: &Context<'_>, unit: &CheckedUnit) -> usize {
    claims::contracts(world, context, unit)
}

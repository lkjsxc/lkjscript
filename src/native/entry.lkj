//! Native startup for explicitly granted owned entry capabilities.
use super::platform::Platform;
use crate::diagnostic::Span;
use crate::ir::EntryGrant;
use crate::x86::*;

fn path_value(bytes: &[u8]) -> String {
    let raw = if bytes.last() == Some(&0u8) { &bytes[..bytes.len() - 1] } else { bytes };
    match String::from_utf8(raw.to_vec()) {
        Ok(value) => value,
        Err(_) => { let mut text = String::new(); for byte in raw { text.push_str(&format!("\\x{:02x}", *byte)); } text }
    }
}
fn description(grant: &EntryGrant) -> String {
    match grant {
        EntryGrant::Directory(path) => format!("Directory {}", path_value(path)),
        EntryGrant::ReadDirectory(path) => format!("ReadDirectory {}", path_value(path)),
        EntryGrant::ReadDirectoryEnvironment(name) | EntryGrant::ReadDirectoryEnvironmentValue(name, _) => format!("ReadDirectory env:{}", path_value(name)),
        EntryGrant::ForeignCommand(path) => format!("ForeignCommand {}", path_value(path)),
        EntryGrant::NullDevice => "NullDevice /dev/null".to_string(),
        EntryGrant::DirectoryEnvironment(name) | EntryGrant::DirectoryEnvironmentValue(name, _) => format!("Directory env:{}", path_value(name)),
        EntryGrant::Listener(_) => format!("Listener {}", crate::entry_grants::endpoint(grant).unwrap_or("<invalid endpoint>".to_string())),
        EntryGrant::Connector(_) => format!("Connector {}", crate::entry_grants::endpoint(grant).unwrap_or("<invalid endpoint>".to_string())),
        EntryGrant::Readiness => "Readiness epoll".to_string(),
        EntryGrant::Stop => "Stop SIGTERM".to_string(),
        EntryGrant::Environment(name) => format!("Environment {}", path_value(name)),
        EntryGrant::EnvironmentValue(_) => "Environment supplied value".to_string(),
        EntryGrant::Stdout => "Stdout 1".to_string(), EntryGrant::Stderr => "Stderr 2".to_string(),
        EntryGrant::Stdin => "Stdin 0".to_string(), EntryGrant::Arguments => "Arguments argv".to_string(),
        EntryGrant::ExitStatus => "ExitStatus status".to_string(), EntryGrant::Clock => "Clock kernel".to_string(),
        EntryGrant::Entropy => "Entropy getrandom".to_string(), EntryGrant::Process => "Process children".to_string(),
        EntryGrant::World => "World host".to_string(),
    }
}

pub struct Plan {
    values: Label,
    paths: Vec<Label>,
    grants: Vec<EntryGrant>,
    site: Span,
    identities: Vec<Label>,
    descriptions: Vec<String>,
    child: Option<super::child_entry::Plan>,
}
impl Plan {
    pub(super) fn fallible(grant: &EntryGrant) -> bool {
        !matches!(grant, EntryGrant::World | EntryGrant::Stdout | EntryGrant::Stdin
            | EntryGrant::Stderr | EntryGrant::Clock | EntryGrant::Process | EntryGrant::Entropy)
    }
    pub fn new(a: &mut Assembler, grants: &[EntryGrant], site: Span) -> Self {
        let values = a.label();
        let mut paths = Vec::new();
        for _ in grants { paths.push(a.label()); }
        let mut identities = Vec::new(); let mut descriptions = Vec::new();
        for grant in grants {
            identities.push(a.label());
            descriptions.push(crate::runtime_diagnostics::escaped(&description(grant), 512, false));
        }
        Self { values, paths, grants: grants.to_vec(), site, identities, descriptions, child: None }
    }
    pub fn child(a: &mut Assembler, manifest: &crate::child_image::Manifest, site: Span) -> Self {
        let empty: Vec<EntryGrant> = Vec::new();
        let mut plan = Self::new(a, &empty, site);
        plan.child = Some(super::child_entry::Plan::new(a, manifest));
        plan
    }
    pub fn is_child(&self) -> bool { self.child.is_some() }
    fn offset(&self, index: usize) -> i64 {
        let mut offset = 0i64;
        for at in 0..index { offset += if matches!(self.grants[at], EntryGrant::Stop) { 16i64 } else { 8i64 }; }
        offset
    }
    pub fn prepare(&self, a: &mut Assembler, p: Platform) {
        if let Some(child) = &self.child { child.prepare(a, p); return; }
        for (index, grant) in self.grants.iter().enumerate() {
            super::diagnostics::operation(a, if matches!(grant, EntryGrant::DirectoryEnvironment(_) | EntryGrant::DirectoryEnvironmentValue(_, _) | EntryGrant::ReadDirectoryEnvironment(_) | EntryGrant::ReadDirectoryEnvironmentValue(_, _)) { 1001 } else { 1000 });
            match grant {
                EntryGrant::Environment(_) => {
                    a.address(DI, self.paths[index]);
                    a.call(p.environment_lookup);
                },
                EntryGrant::EnvironmentValue(value) => {
                    if value.is_some() { a.address(A, self.paths[index]); } else { a.immediate(A, 0); }
                },
                EntryGrant::DirectoryEnvironment(_) | EntryGrant::ReadDirectoryEnvironment(_) => {
                    // Resolve only the invocation-reviewed key, before application code.
                    let missing = a.label();
                    let scan = a.label();
                    let open = a.label();
                    let done = a.label();
                    a.address(DI, self.paths[index]);
                    a.call(p.environment_lookup);
                    a.test(A, true);
                    a.condition(4, missing);
                    a.load_width(C, A, 0, 1, false);
                    a.test(C, false);
                    a.condition(4, missing);
                    a.mov(DI, A);
                    a.mov(R8, A);
                    a.immediate(SI, 1);
                    a.bind(scan);
                    a.load_width(C, R8, 0, 1, false);
                    a.test(C, false);
                    a.condition(4, open);
                    a.lea(R8, R8, 1);
                    a.lea(SI, SI, 1);
                    a.jump(scan);
                    a.bind(open);
                    a.call(p.directory_open);
                    a.jump(done);
                    a.bind(missing);
                    a.immediate(A, (-2i64) as u64);
                    a.bind(done);
                }
                EntryGrant::DirectoryEnvironmentValue(_, value) | EntryGrant::ReadDirectoryEnvironmentValue(_, value) => {
                    if let Some(path) = value {
                        if !path.is_empty() {
                            a.address(DI, self.paths[index]); a.immediate(SI, path.len() as u64 + 1);
                            a.call(p.directory_open);
                        } else { a.immediate(A, (-2i64) as u64); }
                    } else { a.immediate(A, (-2i64) as u64); }
                }
                EntryGrant::Directory(path) | EntryGrant::ReadDirectory(path) => {
                    a.address(DI, self.paths[index]);
                    a.immediate(SI, path.len() as u64);
                    a.call(p.directory_open);
                }
                EntryGrant::ForeignCommand(path) => {
                    a.address(DI, self.paths[index]);
                    a.immediate(SI, path.len() as u64);
                    a.call(p.foreign_open);
                }
                EntryGrant::NullDevice => { a.call(p.null_open); },
                EntryGrant::Connector(address) => {
                    a.address(DI, self.paths[index]);
                    a.immediate(SI, address.len() as u64);
                    a.call(p.world_connector);
                }
                EntryGrant::Listener(address) => {
                    a.address(DI, self.paths[index]);
                    a.immediate(SI, address.len() as u64);
                    a.call(p.world_listen);
                }
                EntryGrant::Readiness => { a.call(p.world_readiness); },
                EntryGrant::Stop => { a.call(p.world_stop); },
                _ => { a.immediate(A, 1); },
            }
            let ready = a.label();
            a.test(A, true);
            a.condition(9, ready);
            super::diagnostics::failure(a, self.identities[index], self.descriptions[index].len());
            a.immediate(LINE, self.site.line as u64);
            a.immediate(FILE, self.site.file as u64);
            a.immediate(A, 7);
            a.jump(p.trap);
            a.bind(ready);
            a.address(R11, self.values);
            a.store(R11, self.offset(index), A);
            if matches!(grant, EntryGrant::Stop) { a.immediate(A, 0); a.store(R11, self.offset(index) + 8, A); }
        }
    }
    pub fn load(&self, a: &mut Assembler, index: usize, register: u8) {
        if let Some(child) = &self.child { child.load(a, index, register); return; }
        a.address(R11, self.values);
        if matches!(self.grants[index], EntryGrant::Stop) { a.lea(register, R11, self.offset(index)); }
        else { a.load(register, R11, self.offset(index)); }
    }
    pub fn data(&self, a: &mut Assembler, bytes: &mut Vec<u8>, offset: usize) {
        if let Some(child) = &self.child { child.data(a, bytes, offset); return; }
        a.data_label(self.values, offset + bytes.len());
        for grant in &self.grants {
            bytes.extend_from_slice(&[0u8; 8]);
            if matches!(grant, EntryGrant::Stop) { bytes.extend_from_slice(&[0u8; 8]); }
        }
        for (index, grant) in self.grants.iter().enumerate() {
            a.data_label(self.identities[index], offset + bytes.len());
            bytes.extend_from_slice(self.descriptions[index].as_bytes());
            a.data_label(self.paths[index], offset + bytes.len());
            match grant {
                EntryGrant::ForeignCommand(path) | EntryGrant::Directory(path) | EntryGrant::DirectoryEnvironment(path) | EntryGrant::ReadDirectory(path) | EntryGrant::ReadDirectoryEnvironment(path) | EntryGrant::Environment(path) => bytes.extend_from_slice(path),
                EntryGrant::EnvironmentValue(Some(value)) | EntryGrant::DirectoryEnvironmentValue(_, Some(value)) | EntryGrant::ReadDirectoryEnvironmentValue(_, Some(value)) => { bytes.extend_from_slice(value); bytes.push(0); },
                EntryGrant::Listener(address) | EntryGrant::Connector(address) => bytes.extend_from_slice(address),
                _ => {}
            }
        }
    }
}

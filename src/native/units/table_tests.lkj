//! Source/message table module introduced for checked operation replay.

//! Small byte oracles only; these fixtures make no whole-program memory claim.
use super::*;

use super::image_tables::{Input, ImageTables};

fn repeat(value: &str, count: usize) -> String {
    let mut result = String::new();
    for _ in 0usize..count { result.push_str(value); }
    result
}

fn fixture(index: usize) -> (Vec<String>, Vec<String>) {
    match index {
        0usize => (Vec::new(), Vec::new()),
        1usize => (vec!["".to_string(), "same.lkj".to_string(), "same.lkj".to_string(), "雪\n\"quoted\".lkj".to_string()],
            vec!["zeta".to_string(), "".to_string(), "line\nquoted\"雪".to_string(), "alpha".to_string(), "zeta".to_string()]),
        2usize => {
            let paths = vec![repeat("p", 511usize), repeat("p", 512usize), repeat("p", 513usize)];
            let common = repeat("m", 1100usize);
            let first = format!("{common}A"); let second = format!("{common}B");
            assert!(first != second);
            assert_eq!(crate::runtime_diagnostics::escaped(&first, 1024usize, false),
                crate::runtime_diagnostics::escaped(&second, 1024usize, false));
            (paths, vec![second, repeat("n", 1025usize), first, repeat("n", 1023usize), repeat("n", 1024usize)])
        }
        3usize => (vec![repeat("雪", 300usize), repeat("\"\\\n", 200usize)],
            vec![repeat("é雪\n\"", 400usize), "\n".to_string(), "\"".to_string(), "é".to_string(), "é".to_string()]),
        _ => {
            let mut sources = Vec::new();
            for index in 0usize..17usize {
                sources.push(if index % 2usize == 0usize { "repeated.lkj".to_string() } else { format!("unit-{index}.lkj") });
            }
            (sources, vec!["z".to_string(), "a".to_string(), "z".to_string(), "middle".to_string()])
        }
    }
}

fn same_site(left: Span, right: Span) {
    assert_eq!(left.file, right.file); assert_eq!(left.start, right.start); assert_eq!(left.end, right.end);
    assert_eq!(left.line, right.line); assert_eq!(left.column, right.column);
}

fn same_symbols(expected: &Linkable, actual: &SupportImage, base: usize) {
    let mut definitions = BTreeMap::new();
    for (name, offset) in &actual.code.definitions { assert!(definitions.insert(name.clone(), *offset).is_none()); }
    for (name, position) in &actual.data_definitions {
        assert!(*position >= actual.data_offset && *position <= actual.end);
        assert!(definitions.insert(name.clone(), *position - base).is_none());
    }
    assert_eq!(definitions.len(), expected.definitions.len());
    for (name, offset) in &expected.definitions { assert_eq!(definitions.get(name).copied(), Some(*offset)); }
    assert_eq!(actual.code.references.len(), expected.references.len());
    for index in 0usize..expected.references.len() {
        let left = &expected.references[index]; let right = &actual.code.references[index];
        assert_eq!(left.at, right.at); assert_eq!(left.name, right.name); same_site(left.site, right.site);
    }
    assert_eq!(actual.code.immediates.len(), expected.immediates.len());
    for index in 0usize..expected.immediates.len() {
        let left = &expected.immediates[index]; let right = &actual.code.immediates[index];
        assert_eq!(left.at, right.at); assert_eq!(left.message, right.message); same_site(left.site, right.site);
    }
}

fn byte_oracles(world: &mut World, runtime: &Context<'_>, entry: &CheckedUnit) -> usize {
    let base = 73usize;
    let program = entry.interface().program();
    let binding = symbol(&entry.interface().binding(0usize));
    let site = first_site(&entry.program().functions[0usize]);
    let grants: Vec<ir::EntryGrant> = Vec::new();
    for case in 0usize..5usize {
        let (sources, messages) = fixture(case);
        let mut unique: BTreeSet<String> = BTreeSet::new();
        for message in &messages { unique.insert(message.clone()); }
        let mut ordered = Vec::new();
        for message in unique { ordered.push(message); }
        let (expected, data_offset) = support(runtime.runtime, program, 0usize, &binding, site,
            &grants, &sources, &ordered, Some(3u32), 0u64, base).unwrap();
        for disk in vec![false, true] {
            let mut tables = if disk {
                let mut tables = ImageTables::new(world.temporary_file().unwrap()).unwrap();
                let split = sources.len() / 2usize;
                tables.push(&sources[..split], &messages).unwrap();
                tables.push(&sources[split..], &messages).unwrap();
                Input::Disk(tables)
            } else { Input::slice(&sources, &messages) };
            assert_eq!(tables.source_count(), sources.len());
            if !sources.is_empty() {
                for index in vec![sources.len() - 1usize, 0usize, sources.len() / 2usize, 0usize] {
                    assert_eq!(tables.source(index).unwrap(), sources[index]);
                }
            }
            tables.prepare().unwrap();
            for (index, message) in ordered.iter().enumerate() {
                assert_eq!(tables.code(message).unwrap(), Some(index + 16usize));
            }
            let mut output = world.temporary_file().unwrap();
            let actual = support_stream(runtime.runtime, program, 0usize, &binding, site,
                &grants, &mut tables, Some(3u32), 0u64, base, &mut output).unwrap();
            assert_eq!(actual.data_offset, data_offset);
            assert_eq!(actual.code.bytes.len(), data_offset - base);
            same_symbols(&expected, &actual, base);
            output.seek((platform::CODE_OFFSET + base) as i64, 0u8).unwrap();
            output.write_all(&actual.code.bytes).unwrap();
            output.seek((platform::CODE_OFFSET + base) as i64, 0u8).unwrap();
            assert_eq!(output.read_to_end().unwrap(), expected.bytes);
            tables.finish().unwrap();
        }
    }
    // The shared code/object encoder still refuses a data export beyond bytes.
    let mut ordinary = Assembler::at_base(37usize);
    let outside = ordinary.label(); ordinary.data_label(outside, 38usize);
    assert!(ordinary.linkable(&[(outside, "outside".to_string())]).is_err());
    11usize
}

fn corrupted_tables(world: &mut World, runtime: &Context<'_>, entry: &CheckedUnit) -> usize {
    let messages: Vec<String> = Vec::new();
    let grants: Vec<ir::EntryGrant> = Vec::new();
    for attack in 0usize..5usize {
        let mut file = world.temporary_file().unwrap(); let mut alias = file.duplicate().unwrap();
        let mut tables = ImageTables::new(file).unwrap();
        tables.push(&entry.program().sources, &messages).unwrap();
        if attack == 4usize {
            let mut prepared = Input::Disk(tables); prepared.prepare().unwrap();
            let Input::Disk(mut selected) = prepared else { panic!("expected disk tables"); };
            let empty: Vec<String> = Vec::new();
            assert!(selected.push(&empty, &empty).is_err());
            tables = selected;
        } else {
            if attack == 3usize {
                // The final file check must catch a value changed after a
                // successful authenticated read populated the one-block cache.
                let mut cached = Input::Disk(tables);
                assert_eq!(cached.source(0usize).unwrap(), entry.program().sources[0usize]);
                let Input::Disk(selected) = cached else { panic!("expected disk tables"); };
                tables = selected;
            }
            alias.seek(0i64, 0u8).unwrap(); let bytes = alias.read_to_end().unwrap();
            if attack == 0usize { alias.seek(0i64, 0u8).unwrap(); alias.write_all(b"!").unwrap(); }
            else if attack == 1usize { alias.seek(bytes.len() as i64, 0u8).unwrap(); alias.write_all(b"!").unwrap(); }
            else if attack == 2usize {
                alias.seek((bytes.len() - 1usize) as i64, 0u8).unwrap();
                alias.write_all(&[bytes[bytes.len() - 1usize] ^ 1u8]).unwrap();
            } else {
                let expected = entry.program().sources[0usize].as_bytes();
                let mut selected = None;
                for index in 0usize..bytes.len() - expected.len() + 1usize {
                    if &bytes[index..index + expected.len()] == expected { selected = Some(index); break; }
                }
                let index = selected.unwrap();
                alias.seek(index as i64, 0u8).unwrap(); alias.write_all(&[bytes[index] ^ 1u8]).unwrap();
            }
        }
        let mut output = world.temporary_file().unwrap(); let mut unpublished = output.duplicate().unwrap();
        let mut linker = Linker::new(output, world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
        linker.push(emit(entry, runtime, 0usize).unwrap()).unwrap();
        assert!(linker.finish_with_tables(runtime, entry.interface(), &entry.interface().program().functions[0usize].name,
            &grants, tables, Some(3u32)).is_err());
        unpublished.seek(0i64, 0u8).unwrap(); let mut header = [0u8; 4];
        assert_eq!(unpublished.read(&mut header).unwrap(), 4usize); assert_eq!(header, [0u8; 4]);
    }
    5usize
}

pub(super) fn run(world: &mut World, runtime: &Context<'_>, entry: &CheckedUnit) -> usize {
    byte_oracles(world, runtime, entry) + corrupted_tables(world, runtime, entry)
}

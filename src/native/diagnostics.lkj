//! Cold diagnostic output uses static tables and the preallocated decimal buffer.
//! Paths and messages are escaped/bounded while emitting, never after failure.
use super::platform::{self, Platform, HOST_ERRNO, HOST_NAME, HOST_NAME_LEN, HOST_OPERATION, TRAP_CODE, TRAP_FILE, TRAP_LINE, DIAGNOSTIC_LENGTH};
use crate::x86::*;

pub(super) fn operation(a: &mut Assembler, number: u64) {
    a.immediate(R11, number);
    a.store(CONTEXT, HOST_OPERATION, R11);
}
pub(super) fn failure(a: &mut Assembler, identity: Label, length: usize) {
    a.store(CONTEXT, HOST_ERRNO, A);
    a.address(R11, identity);
    a.store(CONTEXT, HOST_NAME, R11);
    a.immediate(R11, length as u64);
    a.store(CONTEXT, HOST_NAME_LEN, R11);
}
fn append(a: &mut Assembler, p: Platform) {
    a.load(A, CONTEXT, DIAGNOSTIC_LENGTH);
    a.immediate(C, 2048); a.rr(0x29, C, A, true);
    a.compare(D, C); a.cmov(D, C, 7);
    a.address(DI, p.line_buffer); a.rr(0x01, DI, A, true);
    a.rr(0x01, A, D, true); a.store(CONTEXT, DIAGNOSTIC_LENGTH, A);
    a.mov(C, D); a.raw(&[0xfc, 0xf3, 0xa4]);
}
fn literal(a: &mut Assembler, p: Platform, fd: u32, value: &str) {
    a.address(R8, p.diagnostic_buffer);
    a.lea(R8, R8, 128);
    platform::diagnostic_text(a, value);
    a.mov(SI, R8);
    a.immediate(D, value.len() as u64);
    append(a, p);
}
fn pair(a: &mut Assembler, p: Platform, table: Label) {
    a.address(R8, table);
    a.load(C, R8, 0);
    a.compare(A, C);
    let valid = a.label();
    a.condition(2, valid);
    a.immediate(A, 0);
    a.bind(valid);
    a.shift(A, 4, 4);
    a.rr(0x01, R8, A, true);
    a.load(SI, R8, 8);
    a.load(D, R8, 16);
    append(a, p);
}
// A private supervisor receives an exact static identity before the bounded
// human line. This does not grant any program output and requires no allocation.
pub(super) fn private_header(a: &mut Assembler, p: Platform, fd: u32) {
    let done = a.label();
    a.load(A, CONTEXT, TRAP_CODE); a.test(A, true); a.condition(4, done);
    a.address(R8, p.diagnostic_buffer);
    a.immediate(C, 0x32504152544a4b4cu64); a.store(R8, 0, C);
    a.store(R8, 8, A);
    a.load(C, CONTEXT, TRAP_FILE); a.store(R8, 16, C);
    a.load(C, CONTEXT, TRAP_LINE); a.store(R8, 24, C);
    a.mov(SI, R8); a.immediate(D, 32); platform::diagnostic_write(a, fd);
    a.bind(done);
}
pub(super) fn emit(a: &mut Assembler, p: Platform, fd: u32) {
    a.immediate(A, 0); a.store(CONTEXT, DIAGNOSTIC_LENGTH, A);
    let complete = a.label();
    let ordinary = a.label();
    a.load(A, CONTEXT, TRAP_CODE);
    a.test(A, true);
    a.condition(4, complete);
    a.load(A, CONTEXT, TRAP_FILE);
    pair(a, p, p.sources);
    a.address(R8, p.diagnostic_buffer);
    a.lea(R8, R8, 128);
    platform::diagnostic_text(a, " ");
    a.load(A, CONTEXT, TRAP_CODE);
    platform::diagnostic_decimal(a, 4);
    platform::diagnostic_text(a, ": R");
    a.load(A, CONTEXT, TRAP_LINE);
    platform::diagnostic_decimal(a, 1);
    platform::diagnostic_text(a, ":");
    a.mov(SI, R8);
    a.address(D, p.diagnostic_buffer);
    a.lea(D, D, 128);
    a.rr(0x29, D, SI, true);
    append(a, p);
    a.load(A, CONTEXT, TRAP_CODE);
    a.immediate(C, 7);
    a.compare(A, C);
    a.condition(5, ordinary);
    a.load(D, CONTEXT, HOST_NAME_LEN);
    a.test(D, true);
    a.condition(4, ordinary);
    a.load(SI, CONTEXT, HOST_NAME);
    append(a, p);
    literal(a, p, fd, " ");
    a.address(R8, p.operations);
    a.load(R9, R8, 0);
    a.lea(R8, R8, 8);
    a.load(A, CONTEXT, HOST_OPERATION);
    let search = a.label();
    let found = a.label();
    a.bind(search);
    a.load(C, R8, 0);
    a.compare(A, C);
    a.condition(4, found);
    a.lea(R8, R8, 24);
    a.lea(R9, R9, -1);
    a.test(R9, true);
    a.condition(5, search);
    a.address(R8, p.operations);
    a.lea(R8, R8, 8);
    a.bind(found);
    a.load(SI, R8, 8);
    a.load(D, R8, 16);
    append(a, p);
    literal(a, p, fd, ": ");
    a.load(A, CONTEXT, HOST_ERRNO);
    a.negate(A);
    pair(a, p, p.errnos);
    a.address(R8, p.diagnostic_buffer);
    a.lea(R8, R8, 128);
    platform::diagnostic_text(a, ")\n");
    a.load(A, CONTEXT, HOST_ERRNO);
    a.negate(A);
    platform::diagnostic_decimal(a, 1);
    platform::diagnostic_text(a, " (");
    a.mov(SI, R8);
    a.address(D, p.diagnostic_buffer);
    a.lea(D, D, 128);
    a.rr(0x29, D, SI, true);
    append(a, p);
    a.jump(complete);
    a.bind(ordinary);
    let runtime = a.label();
    a.load(A, CONTEXT, TRAP_FILE); a.immediate(C, p.source_base as u64); a.compare(A, C);
    a.condition(3, runtime);
    a.load(A, CONTEXT, TRAP_CODE); pair(a, p, p.messages); a.jump(complete);
    a.bind(runtime);
    a.load(A, CONTEXT, TRAP_CODE); pair(a, p, p.runtime_messages);
    a.bind(complete);
    a.address(SI, p.line_buffer); a.load(D, CONTEXT, DIAGNOSTIC_LENGTH);
    platform::diagnostic_write(a, fd);
}
fn table(a: &mut Assembler, label: Label, bytes: &mut Vec<u8>, offset: usize, values: &[String]) {
    a.data_label(label, offset + bytes.len());
    let start = bytes.len();
    for _ in 0..8 + values.len() * 16 { bytes.push(0); }
    platform::put(bytes, start, values.len() as u64, 8);
    for (index, value) in values.iter().enumerate() {
        let pointer = platform::IMAGE_BASE + platform::CODE_OFFSET as u64 + offset as u64 + bytes.len() as u64;
        platform::put(bytes, start + 8 + index * 16, pointer, 8);
        platform::put(bytes, start + 16 + index * 16, value.len() as u64, 8);
        bytes.extend_from_slice(value.as_bytes());
    }
}
pub(super) fn data(a: &mut Assembler, p: Platform, bytes: &mut Vec<u8>, offset: usize, sources: &[String]) {
    let mut paths = Vec::new();
    for source in sources { paths.push(crate::runtime_diagnostics::escaped(source, 512, true)); }
    if paths.is_empty() { paths.push("<ir>".to_string()); }
    table(a, p.sources, bytes, offset, &paths);
    fixed_data(a, p, bytes, offset);
}

pub(super) fn fixed_data(a: &mut Assembler, p: Platform, bytes: &mut Vec<u8>, offset: usize) {
    let mut names = Vec::new();
    for number in 0..134 { names.push(crate::runtime_diagnostics::errno_name(number).to_string()); }
    table(a, p.errnos, bytes, offset, &names);
    let operations = [1999u64, 0, 1, 3, 5, 8, 9, 13, 14, 17, 18, 38, 41, 42, 49, 50, 54, 72, 91, 131, 257, 289, 291, 319, 437, 1000, 1001, 1002, 1003];
    a.data_label(p.operations, offset + bytes.len());
    let start = bytes.len();
    for _ in 0..8 + operations.len() * 24 { bytes.push(0); }
    platform::put(bytes, start, operations.len() as u64, 8);
    for index in 0..operations.len() {
        let number = operations[index];
        let name = crate::runtime_diagnostics::syscall_name(number);
        let pointer = platform::IMAGE_BASE + platform::CODE_OFFSET as u64 + offset as u64 + bytes.len() as u64;
        platform::put(bytes, start + 8 + index * 24, number, 8);
        platform::put(bytes, start + 16 + index * 24, pointer, 8);
        platform::put(bytes, start + 24 + index * 24, name.len() as u64, 8);
        bytes.extend_from_slice(name.as_bytes());
    }
    a.data_label(p.stdout_identity, offset + bytes.len()); bytes.extend_from_slice(b"Stdout 1");
    a.data_label(p.stderr_identity, offset + bytes.len()); bytes.extend_from_slice(b"Stderr 2");
    a.data_label(p.runtime_identity, offset + bytes.len()); bytes.extend_from_slice(b"Runtime SIGPIPE");
}

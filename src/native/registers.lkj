//! Scalar storage selection. Intervals preserve loop-carried values and addresses.
//! Volatile registers may hold values across instructions that preserve them.
//! Three saved registers can also carry values through calls.
use super::*;

const POOL: [u8; 8] = [R8, R9, R10, DI, SI, B, R14, R15];
const VOLATILE_COUNT: usize = 5;

fn primitive(program: &Program, ty: usize) -> bool {
    matches!(program.types[ty].kind, TypeKind::Bool | TypeKind::Char | TypeKind::Int { .. }
        | TypeKind::F64)
}

// Prefix entries contain the point just after the last clobber. The baseline
// barrier preserves the existing linear-scan assignments. The other entries
// distinguish the common barrier and the two additional address temporaries.
#[derive(Clone, Copy)]
struct Clobbers {
    baseline: usize,
    all: usize,
    r10: usize,
    si: usize,
}

impl Clobbers {
    fn preserves(self, register: u8, begin: usize) -> bool {
        self.all <= begin && (register != R10 || self.r10 <= begin)
            && (register != SI || self.si <= begin)
    }
}

// The order of decisions is the order of interval starts. For each register
// only the latest accepted interval and the next incumbent can overlap a
// proposed interval. A decision removes its own incumbent before choosing.
struct Reservations {
    future: Vec<Vec<usize>>,
    next: [usize; 8],
    past_end: [usize; 8],
}

impl Reservations {
    fn new(order: &[(usize, usize)], assigned: &[Option<usize>]) -> Self {
        let mut future = vec![Vec::new(); POOL.len()];
        for (first, local) in order {
            if let Some(register) = assigned[*local] {
                future[register].push(*first);
            }
        }
        Self { future, next: [0; 8], past_end: [0; 8] }
    }

    fn available(&self, register: usize, first: usize, last: usize) -> bool {
        self.past_end[register] <= first
            && self.future[register].get(self.next[register]).is_none_or(|next| *next > last)
    }
}

struct Intervals {
    first: Vec<usize>,
    last: Vec<usize>,
    address: Vec<bool>,
    borrowed: Vec<bool>,
}
impl Intervals {
    fn access(&mut self, local: usize, point: usize, loops: &[usize], ends: &[usize]) {
        self.first[local] = self.first[local].min(point);
        self.last[local] = self.last[local].max(point);
        for start in loops {
            if self.first[local] <= *start * 2 {
                self.last[local] = self.last[local].max(ends[*start] * 2);
                break;
            }
        }
    }
    fn place(
        &mut self,
        place: &Place,
        point: usize,
        loops: &[usize],
        ends: &[usize],
        address: bool,
    ) {
        self.access(place.local, point, loops, ends);
        if address || !place.projections.is_empty() {
            self.address[place.local] = true;
        }
        for projection in &place.projections {
            if let Projection::Index(local) = projection {
                self.access(*local, point, loops, ends);
            }
        }
    }
}

pub(super) struct Registers {
    pub locals: Vec<Option<u8>>,
    pub saved: Vec<u8>,
    pub storage: Vec<usize>,
}
impl Registers {
    pub fn new(program: &Program, function: &Function, layout: &Layouts) -> Self {
        let count = function.locals.len();
        let mut spans = Intervals {
            first: vec![!0usize; count],
            last: vec![0; count],
            address: vec![false; count],
            borrowed: vec![false; count],
        };
        for local in 0..function.params {
            spans.first[local] = 0;
        }
        let mut ends = vec![0usize; function.body.len()];
        let mut regions: Vec<(usize, bool)> = Vec::new();
        for index in 0..function.body.len() {
            match function.body[index].op {
                Op::If { .. } => regions.push((index, false)),
                Op::Loop => regions.push((index, true)),
                Op::End => {
                    if let Some((start, true)) = regions.pop() {
                        ends[start] = index + 1;
                    }
                }
                _ => {}
            }
        }
        let mut loops: Vec<usize> = Vec::new();
        let mut clobbers = vec![Clobbers { baseline: 0, all: 0, r10: 0, si: 0 }];
        let mut blocks = vec![0usize];
        for index in 0..function.body.len() {
            let op = &function.body[index].op;
            let read = index * 2;
            let write = read + 1;
            match op {
                Op::Loop => {
                    regions.push((index, true));
                    loops.push(index);
                }
                Op::If { .. } => regions.push((index, false)),
                Op::End => {
                    if let Some((_, true)) = regions.pop() {
                        loops.pop();
                    }
                }
                _ => {}
            }
            match op {
                Op::Int { dst, .. }
                | Op::Float { dst, .. }
                | Op::Unit { dst }
                | Op::Text { dst, .. } => spans.access(*dst, write, &loops, &ends),
                Op::Read { dst, place, .. } => {
                    spans.place(place, read, &loops, &ends, false);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::Borrow { dst, place, .. } | Op::SliceBorrow { dst, place, .. } => {
                    spans.borrowed[place.local] = true;
                    spans.place(place, read, &loops, &ends, true);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::ViewRange {
                    dst,
                    place,
                    start,
                    end,
                    ..
                } => {
                    spans.borrowed[place.local] = true;
                    spans.place(place, read, &loops, &ends, true);
                    spans.access(*start, read, &loops, &ends);
                    spans.access(*end, read, &loops, &ends);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::Assign { place, src } => {
                    spans.access(*src, read, &loops, &ends);
                    spans.place(
                        place,
                        if place.projections.is_empty() {
                            write
                        } else {
                            read
                        },
                        &loops,
                        &ends,
                        false,
                    );
                }
                Op::Drop { place } | Op::DropIf { place } => {
                    if layout.storage(function.locals[place.local].ty).cleanup
                        || !place.projections.is_empty()
                    {
                        spans.place(place, read, &loops, &ends, true);
                    }
                }
                Op::Unary { dst, src, .. } => {
                    spans.access(*src, read, &loops, &ends);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::Binary {
                    dst, left, right, ..
                } => {
                    spans.access(*left, read, &loops, &ends);
                    spans.access(*right, read, &loops, &ends);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::Call { dst, args, .. }
                | Op::Intrinsic { dst, args, .. }
                | Op::Array {
                    dst,
                    elements: args,
                }
                | Op::Struct { dst, fields: args }
                | Op::Variant {
                    dst, fields: args, ..
                } => {
                    for arg in args {
                        spans.access(*arg, read, &loops, &ends);
                    }
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::Discriminant { dst, src } => {
                    spans.access(*src, read, &loops, &ends);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::TagTest { dst, place, .. } => {
                    spans.place(place, read, &loops, &ends, true);
                    spans.access(*dst, write, &loops, &ends);
                }
                Op::If { condition } => spans.access(*condition, read, &loops, &ends),
                Op::Return { src } => spans.access(*src, read, &loops, &ends),
                _ => {}
            }
            let scalar = match op {
                Op::Int { .. }
                | Op::Float { .. }
                | Op::Unit { .. }
                | Op::Unary { .. }
                | Op::Binary { .. }
                | Op::If { .. }
                | Op::Else
                | Op::Loop
                | Op::End
                | Op::Break
                | Op::Continue
                | Op::BreakTo { .. }
                | Op::ContinueTo { .. } => true,
                Op::Read { dst, place, .. } => {
                    place.projections.is_empty() && layout.storage(function.locals[*dst].ty).scalar
                }
                Op::Assign { place, src } => {
                    place.projections.is_empty() && layout.storage(function.locals[*src].ty).scalar
                }
                Op::Drop { place } | Op::DropIf { place } => {
                    place.projections.is_empty()
                        && !layout.storage(function.locals[place.local].ty).cleanup
                }
                Op::Return { src } => layout.storage(function.locals[*src].ty).scalar,
                Op::Intrinsic {
                    name: IntrinsicOp::Assert | IntrinsicOp::Cast,
                    ..
                } => true,
                _ => false,
            };
            let mut clobber = clobbers[index];
            if !scalar {
                clobber.baseline = index + 1;
                match op {
                    Op::Discriminant { .. } => {}
                    Op::TagTest { .. } => clobber.r10 = index + 1,
                    Op::Read { dst, place, .. } if !place.projections.is_empty()
                        && primitive(program, function.locals[*dst].ty) => {
                        clobber.r10 = index + 1;
                        clobber.si = index + 1;
                    }
                    _ => clobber.all = index + 1,
                }
            }
            clobbers.push(clobber);
            blocks.push(if storage_plan::ends_block(op) { index + 1 } else { blocks[index] });
        }
        let mut order = Vec::new();
        for local in 0..count {
            let ty = function.locals[local].ty;
            if spans.first[local] != !0usize
                && !spans.address[local]
                && layout.storage(ty).scalar
                && !matches!(program.types[ty].kind, TypeKind::Unit)
            {
                order.push((spans.first[local], local));
            }
        }
        order.sort();
        let mut occupied: Vec<Option<usize>> = vec![None; POOL.len()];
        let mut assigned = vec![None; count];
        let mut saved = Vec::new();
        for (first, local) in &order {
            let begin = first / 2 + first % 2;
            let end = (spans.last[*local] / 2 + 1).min(function.body.len());
            let volatile = *local >= function.params && clobbers[end].baseline <= begin;
            for index in 0..POOL.len() {
                let available = match occupied[index] {
                    Some(previous) => spans.last[previous] < *first,
                    None => true,
                };
                if available && (index >= VOLATILE_COUNT || volatile) {
                    assigned[*local] = Some(index);
                    occupied[index] = Some(*local);
                    if index >= VOLATILE_COUNT && !saved.contains(&POOL[index]) {
                        saved.push(POOL[index]);
                    }
                    break;
                }
            }
        }
        let mut reservations = Reservations::new(&order, &assigned);
        for (first, local) in &order {
            if let Some(mut register) = assigned[*local] {
                reservations.next[register] += 1;
                let index = *first / 2;
                if *first % 2 == 1 && primitive(program, function.locals[*local].ty) {
                    if let Some((destination, source)) =
                        storage_plan::direct_transfer(&function.body[index].op)
                    {
                        if let Some(preferred) = assigned[source] {
                            if destination == *local && preferred != register
                                && (preferred < VOLATILE_COUNT) == (register < VOLATILE_COUNT)
                                && function.locals[source].ty == function.locals[*local].ty
                                && spans.last[source] == index * 2
                                && spans.first[source] >= blocks[index] * 2 + 1
                                && spans.first[source] < index * 2
                                && spans.first[source] % 2 == 1
                                && reservations.available(preferred, *first, spans.last[*local])
                            {
                                assigned[*local] = Some(preferred);
                                register = preferred;
                            }
                        }
                    }
                }
                reservations.past_end[register] = spans.last[*local] + 1;
            }
        }
        let mut reservations = Reservations::new(&order, &assigned);
        let mut spills = Vec::new();
        for (first, local) in &order {
            let last = spans.last[*local];
            if let Some(register) = assigned[*local] {
                reservations.next[register] += 1;
                reservations.past_end[register] = last + 1;
            } else if *local >= function.params && primitive(program, function.locals[*local].ty) {
                let begin = first / 2 + first % 2;
                let end = (last / 2 + 1).min(function.body.len());
                for register in 0..VOLATILE_COUNT {
                    if clobbers[end].preserves(POOL[register], begin)
                        && reservations.available(register, *first, last)
                    {
                        assigned[*local] = Some(register);
                        reservations.past_end[register] = last + 1;
                        break;
                    }
                }
                if assigned[*local].is_none() {
                    spills.push((*first, *local));
                }
            }
        }
        let mut storage =
            storage_plan::coalesce(function, layout, &spans.first, &spans.last, &spans.borrowed);
        storage_plan::reuse_spill_homes(function, layout, &spills, &spans.last, &blocks, &mut storage);
        let mut locals = Vec::new();
        for register in assigned {
            locals.push(register.map(|index| POOL[index]));
        }
        Self { locals, saved, storage }
    }
}

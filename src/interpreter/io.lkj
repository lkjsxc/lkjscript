//! Independent capability execution over typed cells and host-owned handles.
use super::*;

impl<H: Host> Interpreter<'_, H> {
    fn io_reference(
        &self,
        values: &[(usize, Value)],
        index: usize,
        mutable: bool,
    ) -> Result<Access, RunError> {
        let Some((ty, Value::Reference(reference))) = values.get(index) else {
            return Err(self.invalid("I/O argument must be a reference"));
        };
        if !matches!(self.kind(*ty)?, TypeKind::Ref { mutable: m, .. } if *m == mutable) {
            return Err(self.invalid("I/O reference mutability differs"));
        }
        let access = self.reference_access(reference)?;
        self.access(&access, mutable, true)?;
        Ok(access)
    }
    fn io_authority(
        &self,
        values: &[(usize, Value)],
        expected: TypeKind,
    ) -> Result<Access, RunError> {
        let access = self.io_reference(values, 0, true)?;
        if *self.kind(access.ty)? != expected {
            return Err(self.invalid("I/O requires the declared capability"));
        }
        Ok(access)
    }
    fn io_either(&self, values: &[(usize, Value)], first: TypeKind, second: TypeKind) -> Result<Access, RunError> {
        let access = self.io_reference(values, 0, true)?;
        if *self.kind(access.ty)? != first && *self.kind(access.ty)? != second {
            return Err(self.invalid("I/O requires one of its declared capability types"));
        }
        Ok(access)
    }
    fn io_world_or(&self, values: &[(usize, Value)], narrow: TypeKind) -> Result<Access, RunError> {
        let access = self.io_reference(values, 0, true)?;
        if *self.kind(access.ty)? != TypeKind::World && *self.kind(access.ty)? != narrow {
            return Err(self.invalid("I/O requires World or its declared narrow capability"));
        }
        Ok(access)
    }
    fn io_buffer(
        &self,
        values: &[(usize, Value)],
        index: usize,
        mutable: bool,
    ) -> Result<Access, RunError> {
        let access = self.io_reference(values, index, mutable)?;
        if !matches!(
            self.kind(access.ty)?,
            TypeKind::Slice {
                inner,
                mutable: false
            } if *inner == ir::U8
        ) {
            return Err(self.invalid("I/O buffer must be a byte slice"));
        }
        for element in self.sequence(&access)? {
            let child = Access {
                extent: None,
                cell: *element,
                ty: ir::U8,
                permissions: access.permissions.clone(),
                writable: mutable,
            };
            self.access(&child, mutable, true)?;
        }
        Ok(access)
    }
    fn io_number(
        &self,
        values: &[(usize, Value)],
        index: usize,
        expected: usize,
    ) -> Result<u64, RunError> {
        match values.get(index) {
            Some((ty, Value::Bits(value))) if *ty == expected => Ok(*value),
            _ => Err(self.invalid("I/O scalar argument type differs")),
        }
    }
    fn io_result_type(&self, actual: usize, expected: usize) -> Result<(), RunError> {
        if actual == expected {
            Ok(())
        } else {
            Err(self.invalid("I/O result type differs"))
        }
    }
    fn io_open_types(&self, result: usize, success: TypeKind) -> Result<(usize, usize), RunError> {
        let TypeKind::Enum {
            variants,
            copy: false,
        } = self.kind(result)?
        else {
            return Err(self.invalid("open result must be an affine Result enum"));
        };
        if variants.len() != 2 || variants[0].fields.len() != 1 || variants[1].fields.len() != 1 {
            return Err(self.invalid("open result needs one success and one error field"));
        }
        let ok = variants[0].fields[0].ty;
        let error = variants[1].fields[0].ty;
        if *self.kind(ok)? != success || error != ir::I64 {
            return Err(self.invalid("open result must contain its capability or i64 errno"));
        }
        Ok((ok, error))
    }
    fn io_open_result(
        &mut self,
        types: (usize, usize),
        result: Result<u64, i64>,
        kind: TypeKind,
    ) -> Result<Value, RunError> {
        let (tag, ty, value) = match result {
            Ok(handle) if handle != 0 => (
                0,
                types.0,
                match kind {
                    TypeKind::Directory => Value::Directory(handle),
                    TypeKind::ReadDirectory => Value::ReadDirectory(handle),
                    TypeKind::ReadFile => Value::ReadFile(handle),
                    TypeKind::ForeignSession => Value::ForeignSession(handle),
                    TypeKind::File => Value::File(handle),
                    TypeKind::Image => Value::Image(handle), TypeKind::Worker => Value::Worker(handle), TypeKind::Channel => Value::Channel(handle),
                    TypeKind::Child => Value::Child(handle),
                    TypeKind::Listener => Value::Listener(handle),
                    TypeKind::Readiness => Value::Readiness(handle),
                    TypeKind::Stop => Value::Stop(handle),
                    _ => return Err(self.invalid("open result is not a handle capability")),
                },
            ),
            Err(errno) if errno > 0 => (1, types.1, Value::Bits(errno as u64)),
            _ => return Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid open result")),
        };
        let child = self.allocate(ty, Some(value), false)?;
        Ok(Value::Aggregate {
            variant: Some(tag),
            fields: vec![child],
        })
    }
    fn io_handle(&self, access: &Access) -> Result<u64, RunError> {
        match self.value(access.cell)? {
            Value::Directory(handle)
            | Value::ReadDirectory(handle)
            | Value::ReadFile(handle)
            | Value::Image(handle) | Value::Channel(handle) | Value::Worker(handle)
            | Value::ForeignCommand(handle)
            | Value::ForeignSession(handle)
            | Value::NullDevice(handle)
            | Value::File(handle)
            | Value::Child(handle)
            | Value::Listener(handle)
            | Value::Readiness(handle)
            | Value::Stop(handle) => Ok(*handle),
            _ => Err(self.invalid("I/O capability has no live handle")),
        }
    }
    fn io_write_buffer(&mut self, access: &Access, bytes: &[u8]) -> Result<(), RunError> {
        let cells = self.sequence_cells(access)?;
        if bytes.len() > cells.len() {
            return Err(self.error(super::InterpreterError::InvalidHost, "host read exceeded its buffer"));
        }
        for index in 0..bytes.len() {
            self.cells[cells[index].index].value = Some(Value::Bits(bytes[index] as u64));
        }
        Ok(())
    }
    fn io_count(&self, result: Result<usize, i64>, extent: usize) -> Result<u64, RunError> {
        match result {
            Ok(count) if count <= extent && count <= 9223372036854775807i64 as usize => {
                Ok(count as u64)
            }
            Err(errno) if errno > 0 => Ok((-errno) as u64),
            _ => Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid I/O count")),
        }
    }
    fn io_status(&self, result: Result<(), i64>) -> Result<Value, RunError> {
        match result {
            Ok(()) => Ok(Value::Bits(0)),
            Err(errno) if errno > 0 => Ok(Value::Bits((-errno) as u64)),
            _ => Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid I/O status")),
        }
    }
    fn io_sum_types(&self, result: usize) -> Result<(usize, usize), RunError> {
        let TypeKind::Enum { variants, .. } = self.kind(result)? else { return Err(self.invalid("I/O result must be an enum")); };
        if variants.len() != 2 || variants[0].fields.len() != 1 || variants[1].fields.len() != 1 || variants[1].fields[0].ty != ir::I64 {
            return Err(self.invalid("I/O result must contain its success value or i64 errno"));
        }
        Ok((variants[0].fields[0].ty, ir::I64))
    }
    fn io_unit_types(&self, result: usize) -> Result<(usize, usize), RunError> {
        let types = self.io_sum_types(result)?;
        if types.0 != ir::UNIT { return Err(self.invalid("I/O status success must be unit")); }
        Ok(types)
    }
    fn io_unit_result(&mut self, types: (usize, usize), result: Result<(), i64>) -> Result<Value, RunError> {
        let (tag, ty, value) = match result {
            Ok(()) => (0usize, types.0, Value::Unit),
            Err(errno) if errno > 0 => (1usize, types.1, Value::Bits(errno as u64)),
            _ => return Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid I/O status")),
        };
        let child = self.allocate(ty, Some(value), false)?;
        Ok(Value::Aggregate { variant: Some(tag), fields: vec![child] })
    }
    fn io_scalar_types(&self, result: usize, success: TypeKind) -> Result<(usize, usize), RunError> {
        let types = self.io_sum_types(result)?;
        if *self.kind(types.0)? != success { return Err(self.invalid("I/O scalar result type differs")); }
        Ok(types)
    }
    fn io_scalar_result(&mut self, types: (usize, usize), result: Result<u64, i64>) -> Result<Value, RunError> {
        let (tag, ty, bits) = match result {
            Ok(bits) => (0usize, types.0, bits),
            Err(errno) if errno > 0 => (1usize, types.1, errno as u64),
            _ => return Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid scalar result")),
        };
        let value = Value::Bits(bits);
        if self.validate_value(ty, &value).is_err() { return Err(self.error(super::InterpreterError::InvalidHost, "host scalar is outside its result representation")); }
        let child = self.allocate(ty, Some(value), false)?;
        Ok(Value::Aggregate { variant: Some(tag), fields: vec![child] })
    }
    fn io_events_types(&self, result: usize) -> Result<(usize, usize, usize), RunError> {
        let types = self.io_sum_types(result)?;
        if !matches!(self.kind(result)?, TypeKind::Enum { copy: false, .. }) { return Err(self.invalid("readiness result must be affine")); }
        let TypeKind::Vec { inner } = self.kind(types.0)? else { return Err(self.invalid("readiness events must be a vector")); };
        if !matches!(self.kind(*inner)?, TypeKind::Struct { fields, copy: true }
            if fields.len() == 2 && fields[0].ty == ir::U64 && fields[1].ty == ir::U8) {
            return Err(self.invalid("readiness events must contain (usize, u8) pairs"));
        }
        Ok((types.0, *inner, types.1))
    }
    fn io_events_result(&mut self, types: (usize, usize, usize), events: Result<Vec<(usize, u8)>, i64>) -> Result<Value, RunError> {
        let (tag, child) = match events {
            Ok(events) => {
                let mut fields = Vec::new();
                for (token, flags) in events {
                    if flags == 0 || flags > 15 { return Err(self.error(super::InterpreterError::InvalidHost, "host returned invalid readiness event flags")); }
                    let token = self.allocate(ir::U64, Some(Value::Bits(token as u64)), false)?;
                    let flags = self.allocate(ir::U8, Some(Value::Bits(flags as u64)), false)?;
                    let pair = self.allocate(types.1, Some(Value::Aggregate { variant: None, fields: vec![token, flags] }), false)?;
                    fields.push(pair);
                }
                (0usize, self.allocate(types.0, Some(Value::Sequence(fields)), false)?)
            }
            Err(errno) if errno > 0 => (1usize, self.allocate(types.2, Some(Value::Bits(errno as u64)), false)?),
            _ => return Err(self.error(super::InterpreterError::InvalidHost, "host returned an invalid readiness result")),
        };
        Ok(Value::Aggregate { variant: Some(tag), fields: vec![child] })
    }
    fn io_file(&self, values: &[(usize, Value)], index: usize) -> Result<u64, RunError> {

        let access = self.io_reference(values, index, false)?;
        if !matches!(self.kind(access.ty)?, TypeKind::File) {
            return Err(self.invalid("process stream requires a File capability"));
        }
        self.io_handle(&access)
    }
    pub(super) fn io_intrinsic(
        &mut self,
        result: usize,
        name: ir::IntrinsicOp,
        values: &[(usize, Value)],
    ) -> Result<Option<Value>, RunError> {
        let storage_arity = match name {
            ir::IntrinsicOp::DirectoryRenameNew => 3usize,
            ir::IntrinsicOp::DirectoryOpenRegular | ir::IntrinsicOp::DirectoryIdentity => 2usize,
            ir::IntrinsicOp::ForeignRun | ir::IntrinsicOp::ForeignStart => 5usize,
            ir::IntrinsicOp::ForeignImage => 1usize,
            ir::IntrinsicOp::ForeignExchange => 4usize,
            ir::IntrinsicOp::ForeignFinish => 2usize,
            ir::IntrinsicOp::DirectoryCreateNew | ir::IntrinsicOp::DirectoryCreatePrivate | ir::IntrinsicOp::DirectoryOpenAppend | ir::IntrinsicOp::FileTruncate | ir::IntrinsicOp::ReadDirectoryOpen | ir::IntrinsicOp::ReadDirectoryOpenDirectory => 2usize,
            ir::IntrinsicOp::DirectorySync | ir::IntrinsicOp::FileSync | ir::IntrinsicOp::FileLockExclusive | ir::IntrinsicOp::FileLockWait => 1usize,
            ir::IntrinsicOp::WorldEntropy | ir::IntrinsicOp::ClockUnixSeconds | ir::IntrinsicOp::ClockUnixNanoseconds | ir::IntrinsicOp::FileSetPrivate
                | ir::IntrinsicOp::WorldStop | ir::IntrinsicOp::StopRequested | ir::IntrinsicOp::StopTarget
                | ir::IntrinsicOp::ChildRequestStop => 1usize,
            ir::IntrinsicOp::EntropyFill | ir::IntrinsicOp::ReadinessUnwatchStop => 2usize,
            ir::IntrinsicOp::ReadinessWatchStop => 3usize,
            ir::IntrinsicOp::FileSeek => 3usize,
            ir::IntrinsicOp::FileModifiedNanoseconds => 1usize,
            _ => 0usize,
        };
        if storage_arity != 0 && values.len() != storage_arity {
            return Err(self.invalid("capability intrinsic argument count differs"));
        }
        let value = match name {
            ir::IntrinsicOp::ImageBuffer if values.len() == 2 => {
                let authority=self.io_authority(values,TypeKind::Image)?; let handle=self.io_handle(&authority)?;
                let types=self.io_open_types(result,TypeKind::File)?;
                let buffer=self.io_buffer(values,1,false)?; let bytes=self.bytes(&buffer)?;
                let opened=self.host.image_buffer(handle,&bytes);
                self.io_open_result(types,opened,TypeKind::File)?
            }
            ir::IntrinsicOp::FileMapReadonly if values.len() == 1 => {
                let authority=self.io_authority(values,TypeKind::File)?; let handle=self.io_handle(&authority)?;
                let types=self.io_open_types(result,TypeKind::ReadRegion)?;
                match self.host.map_readonly_file(handle) {
                    Ok((handle,bytes)) if handle != 0 => {
                        let mut cells=Vec::new();
                        for byte in bytes {cells.push(self.allocate(ir::U8,Some(Value::Bits(byte as u64)),false)?);}
                        let child=self.allocate(types.0,Some(Value::ReadRegion {handle,bytes:cells}),false)?;
                        Value::Aggregate {variant:Some(0),fields:vec![child]}
                    }
                    Err(errno) if errno > 0 => {
                        let child=self.allocate(types.1,Some(Value::Bits(errno as u64)),false)?;
                        Value::Aggregate {variant:Some(1),fields:vec![child]}
                    }
                    _=>return Err(self.error(super::InterpreterError::InvalidHost,"invalid readonly region")),
                }
            }
            ir::IntrinsicOp::ReadRegionLen if values.len() == 1 => {
                let authority=self.io_reference(values,0,false)?;
                if self.kind(authority.ty)? != &TypeKind::ReadRegion {return Err(self.invalid("region length requires ReadRegion"));}
                self.io_result_type(result,ir::U64)?;
                Value::Bits(self.sequence(&authority)?.len() as u64)
            }
            ir::IntrinsicOp::ImageSpawn if values.len() == 2 => {
                let authority = self.io_authority(values, TypeKind::Image)?;
                let types = self.io_open_types(result, TypeKind::Worker)?;
                let handle = self.io_handle(&authority)?;
                let deadline = self.io_number(values, 1, ir::U64)? as usize;
                let opened = self.host.spawn_image(handle, deadline);
                self.io_open_result(types, opened, TypeKind::Worker)?
            }
            ir::IntrinsicOp::ChannelSend | ir::IntrinsicOp::ChannelReceive | ir::IntrinsicOp::WorkerSend | ir::IntrinsicOp::WorkerReceive if values.len() == 3 => {
                let worker = matches!(name, ir::IntrinsicOp::WorkerSend | ir::IntrinsicOp::WorkerReceive);
                let receive = matches!(name, ir::IntrinsicOp::WorkerReceive | ir::IntrinsicOp::ChannelReceive);
                let authority = self.io_authority(values, if worker { TypeKind::Worker } else { TypeKind::Channel })?;
                let handle = self.io_handle(&authority)?;
                let buffer = self.io_buffer(values, 1, receive)?;
                let mut bytes = self.bytes(&buffer)?;
                let deadline = self.io_number(values, 2, ir::U64)? as usize;
                let types = self.io_scalar_types(result, TypeKind::Int { bits: 64, signed: false })?;
                let outcome = if receive { self.host.ipc_receive(handle, worker, &mut bytes, deadline) } else { self.host.ipc_send(handle, worker, &bytes, deadline) };
                if receive {
                    if let Ok(count) = &outcome {
                        if *count > bytes.len() as u64 { return Err(self.error(super::InterpreterError::InvalidHost, "IPC read exceeded buffer")); }
                        self.io_write_buffer(&buffer, &bytes[..*count as usize])?;
                    }
                }
                self.io_scalar_result(types, outcome)?
            }
            ir::IntrinsicOp::ChannelSendFile | ir::IntrinsicOp::WorkerSendFile if values.len() == 3 => {
                let worker = name == ir::IntrinsicOp::WorkerSendFile;
                let authority = self.io_authority(values, if worker { TypeKind::Worker } else { TypeKind::Channel })?;
                let handle = self.io_handle(&authority)?;
                if *self.kind(values[1].0)? != TypeKind::File { return Err(self.invalid("IPC transfers require an owned File, never a borrow")); }
                let Value::File(file) = &values[1].1 else { return Err(self.invalid("IPC transfer value is not File")); };
                let deadline = self.io_number(values, 2, ir::U64)? as usize;
                let types = self.io_unit_types(result)?;
                let outcome = self.host.ipc_send_file(handle, worker, *file, deadline);
                self.io_unit_result(types, outcome)?
            }
            ir::IntrinsicOp::ChannelReceiveFile | ir::IntrinsicOp::WorkerReceiveFile if values.len() == 2 => {
                let worker = name == ir::IntrinsicOp::WorkerReceiveFile;
                let authority = self.io_authority(values, if worker { TypeKind::Worker } else { TypeKind::Channel })?;
                let handle = self.io_handle(&authority)?;
                let deadline = self.io_number(values, 1, ir::U64)? as usize;
                let types = self.io_open_types(result, TypeKind::File)?;
                let outcome = self.host.ipc_receive_file(handle, worker, deadline);
                self.io_open_result(types, outcome, TypeKind::File)?
            }
            ir::IntrinsicOp::WorkerWait if values.len() == 2 => {
                let authority = self.io_authority(values, TypeKind::Worker)?;
                let handle = self.io_handle(&authority)?;
                let deadline = self.io_number(values, 1, ir::U64)? as usize;
                let types = self.io_scalar_types(result, TypeKind::Int { bits: 64, signed: true })?;
                let outcome = self.host.wait_worker(handle, deadline); self.io_scalar_result(types, outcome)?
            }
            ir::IntrinsicOp::WorkerTerminate if values.len() == 1 => {
                let authority = self.io_authority(values, TypeKind::Worker)?; let handle = self.io_handle(&authority)?;
                let types = self.io_unit_types(result)?; let outcome = self.host.terminate_worker(handle); self.io_unit_result(types, outcome)?
            }
            ir::IntrinsicOp::WorkerResult if values.len() == 1 => {
                let authority = self.io_authority(values, TypeKind::Worker)?; let handle = self.io_handle(&authority)?;
                let types = self.io_open_types(result, TypeKind::ReadFile)?; let outcome = self.host.result_worker(handle); self.io_open_result(types, outcome, TypeKind::ReadFile)?
            }
            ir::IntrinsicOp::ForeignImage => {
                let authority = self.io_authority(values, TypeKind::ForeignCommand)?;
                let types = self.io_open_types(result, TypeKind::ReadFile)?;
                let handle = self.io_handle(&authority)?;
                let opened = self.host.foreign_image(handle);
                self.io_open_result(types, opened, TypeKind::ReadFile)?
            }
            ir::IntrinsicOp::ForeignRun | ir::IntrinsicOp::ForeignStart => {
                let authority = self.io_authority(values, TypeKind::ForeignCommand)?;
                let root = self.io_reference(values, 1, true)?;
                let sink = self.io_reference(values, 2, true)?;
                if *self.kind(root.ty)? != TypeKind::ReadDirectory || *self.kind(sink.ty)? != TypeKind::NullDevice {
                    return Err(self.invalid("foreign execution requires its borrowed read root and null device"));
                }
                let kind = if name == ir::IntrinsicOp::ForeignStart { TypeKind::ForeignSession } else { TypeKind::ReadFile };
                let types = self.io_open_types(result, kind.clone())?;
                let command = self.io_handle(&authority)?;
                let root = self.io_handle(&root)?;
                let sink = self.io_handle(&sink)?;
                let arguments = self.io_buffer(values, 3, false)?;
                let arguments = self.bytes(&arguments)?;
                let duration = self.io_number(values, 4, ir::U64)? as usize;
                let opened = if name == ir::IntrinsicOp::ForeignStart { self.host.start_foreign(command, root, sink, &arguments, duration) } else { self.host.run_foreign(command, root, sink, &arguments, duration) };
                self.io_open_result(types, opened, kind)?
            }
            ir::IntrinsicOp::ForeignExchange => {
                let authority = self.io_authority(values, TypeKind::ForeignSession)?; self.io_result_type(result, ir::I64)?;
                let handle = self.io_handle(&authority)?; let request = self.io_buffer(values, 1, false)?; let request = self.bytes(&request)?;
                let target = self.io_buffer(values, 2, true)?; let mut response = self.bytes(&target)?;
                let duration = self.io_number(values, 3, ir::U64)? as usize;
                let outcome = self.host.exchange_foreign(handle, &request, &mut response, duration);
                let count = self.io_count(outcome, response.len())?; if (count as i64) >= 0 { self.io_write_buffer(&target, &response)?; }
                Value::Bits(count)
            }
            ir::IntrinsicOp::ForeignFinish => {
                let authority = self.io_authority(values, TypeKind::ForeignSession)?; self.io_result_type(result, ir::I64)?;
                let handle = self.io_handle(&authority)?; let duration = self.io_number(values, 1, ir::U64)? as usize;
                let outcome = self.host.finish_foreign(handle, duration);
                Value::Bits(match outcome { Ok(status) => status, Err(errno) => (-errno) as u64 })
            }
            ir::IntrinsicOp::FileDuplicate | ir::IntrinsicOp::FileReadOnly if values.len() == 1 => {
                let authority = self.io_authority(values, TypeKind::File)?;
                let types = self.io_open_types(result, TypeKind::File)?;
                let handle = self.io_handle(&authority)?;
                let opened = if name == ir::IntrinsicOp::FileReadOnly {
                    self.host.readonly_file(handle)
                } else {
                    self.host.duplicate_file(handle)
                };
                self.io_open_result(types, opened, TypeKind::File)?
            }
            ir::IntrinsicOp::WorldProcess | ir::IntrinsicOp::WorldClock if values.len() == 1 => {
                self.io_authority(values, TypeKind::World)?;
                let (expected, value) = if name == ir::IntrinsicOp::WorldProcess {
                    (TypeKind::Process, Value::Process)
                } else {
                    (TypeKind::Clock, Value::Clock)
                };
                if *self.kind(result)? != expected {
                    return Err(self.invalid("derived capability result differs"));
                }
                value
            }
            ir::IntrinsicOp::WorldFile if values.len() == 2 => {
                self.io_authority(values, TypeKind::World)?;
                let types = self.io_open_types(result, TypeKind::File)?;
                let kind = self.io_number(values, 1, ir::U8)?;
                let opened = self.host.world_file(kind as u8);
                self.io_open_result(types, opened, TypeKind::File)?
            }
            ir::IntrinsicOp::WorldListen if values.len() == 2 => {
                self.io_authority(values, TypeKind::World)?;
                let types = self.io_open_types(result, TypeKind::Listener)?;
                let address = self.io_buffer(values, 1, false)?;
                let address = self.bytes(&address)?;
                let opened = if address.len() != 16 || address[0] != 2 || address[1] != 0 {
                    Err(22)
                } else {
                    self.host.open_listener(&address)
                };
                self.io_open_result(types, opened, TypeKind::Listener)?
            }
            ir::IntrinsicOp::WorldEntropy => {
                self.io_authority(values, TypeKind::World)?;
                if *self.kind(result)? != TypeKind::Entropy { return Err(self.invalid("entropy derivation result differs")); }
                Value::Entropy
            }
            ir::IntrinsicOp::EntropyFill => {
                self.io_authority(values, TypeKind::Entropy)?;
                let types = self.io_unit_types(result)?;
                let buffer = self.io_buffer(values, 1, true)?;
                let mut bytes = self.bytes(&buffer)?;
                let status = self.host.fill_entropy(&mut bytes);
                // getrandom may fill a prefix before a later failure.
                self.io_write_buffer(&buffer, &bytes)?;
                self.io_unit_result(types, status)?
            }
            ir::IntrinsicOp::ClockUnixNanoseconds => {
                self.io_authority(values, TypeKind::Clock)?;
                let types = self.io_scalar_types(result, TypeKind::Int { bits: 64, signed: false })?;
                let time = match self.host.realtime_nanoseconds() { Ok(value) => Ok(value as u64), Err(errno) => Err(errno) };
                self.io_scalar_result(types, time)?
            }
            ir::IntrinsicOp::ClockUnixSeconds => {

        let (handle, _) = self.request(13, &[0u64; 0], b"")?;
        Ok(handle as u64)
    }
    pub fn register_interest(&mut self, selector: u64, file: u64, token: usize, interest: u8) -> Result<(), i64> {
        self.unit_request(14, &[selector, file, token as u64, interest as u64])
    }
    pub fn remove_interest(&mut self, selector: u64, file: u64) -> Result<(), i64> {
        self.unit_request(15, &[selector, file])
    }
    pub fn wait_events(&mut self, selector: u64, deadline: usize) -> Result<Vec<(usize, u8)>, i64> {
        let (count, bytes) = self.request(16, &[selector, deadline as u64], b"")?;
        if bytes.len() % 16usize != 0 || bytes.len() / 16usize != count as usize { return Err(5); }
        let mut events = Vec::new();
        let mut offset = 0usize;
        while offset < bytes.len() {
            events.push((word(&bytes[offset..offset + 8]) as usize, word(&bytes[offset + 8..offset + 16]) as u8));
            offset += 16;
        }
        Ok(events)
    }
    pub fn import_owned(&mut self, world: &mut World, file: &File) -> Result<u64, i64> {
        self.ensure(world)?;
        let connection = self.broker.as_ref().ok_or(9i64)?;
        let image = broker::import_image(&connection.address, &connection.nonce)?;
        let mut executable = world.temporary_file()?;
        executable.write_all(&image)?;
        executable.set_executable()?;
        let mut output = world.temporary_file()?;
        let empty = world.temporary_file()?;
        let mut process = world.process();
        let arguments: Vec<Vec<u8>> = Vec::new();
        let mut child = process.spawn_file(&executable, &arguments, file, &output, &empty, &empty)?;
        if child.wait()? != 0 { return Err(5); }
        output.rewind()?;
        let mut bytes = [0u8; 8];
        read_exact(&mut output, &mut bytes)?;
        let result = word(&bytes) as i64;
        if result < 0 { return Err(-result); }
        Ok(result as u64)
    }
    pub fn open_root(&mut self, world: &mut World, path: &[u8]) -> Result<u64, i64> {

// Independent syscall broker for interpreter effects; no IR or native lowering.
// Explicit paths also preserve child resolution when the Rust witness includes this file.
#[path = "host_network/broker.lkj"]
mod broker;
#[path = "host_network/process.lkj"]
mod process;
#[path = "host_network/directories.lkj"]
mod directories;
#[path = "host_network/lifecycle.lkj"]
mod lifecycle;
#[path = "host_network/foreign.lkj"]
mod foreign;
#[path = "host_network/foreign_session.lkj"]
mod foreign_session;
use crate::x86::*;

struct Connection {
    control: Option<File>,
    child: Child,
    address: Vec<u8>,
    nonce: Vec<u8>,
}
pub struct Network {
    broker: Option<Connection>,
    sleeper: Option<File>,
    last_operation: u64,
}
fn read_exact(file: &mut File, bytes: &mut [u8]) -> Result<(), i64> {
    let mut offset = 0usize;
    while offset < bytes.len() {
        let count = file.read(&mut bytes[offset..])?;
        if count == 0 { return Err(5); }
        offset += count;
    }
    Ok(())
}
fn word(bytes: &[u8]) -> u64 {
    let mut result = 0u64;
    for index in 0usize..8usize {
        result |= (bytes[index] as u64) << ((index * 8) as u64);
    }
    result
}
impl Network {
    pub fn failure_operation(&self) -> u64 { self.last_operation }
    pub fn new() -> Self {
        Self { broker: None, sleeper: None, last_operation: 1999 }
    }
    pub fn finish(&mut self) {
        if let Some(mut connection) = self.broker.take() {
            drop(connection.control.take());
            let _ = connection.child.wait();
        }
    }
    fn pause(&mut self, world: &mut World, empty: &File) -> Result<(), i64> {
        if self.sleeper.is_none() {
            let mut file = world.temporary_file()?;
            file.write_all(&sleep_image()?)?;
            file.set_executable()?;
            self.sleeper = Some(file);
        }
        let executable = self.sleeper.as_ref().ok_or(5i64)?;
        let mut process = world.process();
        let arguments: Vec<Vec<u8>> = Vec::new();
        let mut child = process.spawn_file(executable, &arguments, empty, empty, empty, empty)?;
        if child.wait()? != 0 { return Err(5); }
        Ok(())
    }
    fn started(&mut self, world: &mut World, child: &mut Child, status: &mut File, empty: &File) -> Result<(), i64> {
        let mut bytes = [0u8; 8];
        let mut exited = false;
        loop {
            status.rewind()?;
            let count = status.read(&mut bytes)?;
            if count == 8 {
                let error = word(&bytes);
                if error == 0 { return Ok(()); }
                if error > 4095 { return Err(5); }
                return Err(error as i64);
            }
            if exited { return Err(5); }
            exited = child.try_wait()?.is_some();
            if !exited { self.pause(world, empty)?; }
        }
    }
    fn ensure(&mut self, world: &mut World) -> Result<(), i64> {
        self.last_operation = 1999;
        if self.broker.is_some() { return Ok(()); }
        let mut random_root = world.directory("/dev")?;
        let mut random = random_root.open("urandom")?;
        let mut nonce = vec![0u8; 32];
        read_exact(&mut random, &mut nonce)?;
        let mut address = vec![1u8, 0, 0];
        address.extend_from_slice(&nonce);
        let mut listener = world.listen("127.0.0.1", 0u16)?;
        let mut local = [0u8; 16];
        let status = listener.__lkjscript_address(&mut local);
        if status < 0 { return Err(-status); }
        let image = broker::image(&local, &address, &nonce)?;
        let mut executable = world.temporary_file()?;
        executable.write_all(&image)?;
        executable.set_executable()?;
        let empty = world.temporary_file()?;
        let mut startup = world.temporary_file()?;
        let arguments: Vec<Vec<u8>> = Vec::new();
        let mut process = world.process();
        let mut child = process.spawn_file(&executable, &arguments, &empty, &startup, &empty, &empty)?;
        self.started(world, &mut child, &mut startup, &empty)?;
        let mut stream = listener.accept()?;
        let mut claimed = [0u8; 32];
        read_exact(&mut stream, &mut claimed)?;
        if claimed[..] != nonce[..] { return Err(13); }
        set_nodelay(world, &stream, true)?;
        self.broker = Some(Connection { control: Some(stream), child, address, nonce });
        Ok(())
    }
    fn request(&mut self, operation: u64, arguments: &[u64], payload: &[u8]) -> Result<(i64, Vec<u8>), i64> {
        self.last_operation = 1999;
        assert!(arguments.len() <= 6);
        let connection = self.broker.as_mut().ok_or(9i64)?;
        let control = connection.control.as_mut().ok_or(9i64)?;
        let mut header = Vec::new();
        append_word(&mut header, operation, 8);
        for argument in arguments { append_word(&mut header, *argument, 8); }
        for _index in arguments.len()..6usize { append_word(&mut header, 0, 8); }
        append_word(&mut header, payload.len() as u64, 8);
        control.write_all(&header)?;
        control.write_all(payload)?;
        let mut response = [0u8; 24];
        read_exact(control, &mut response)?;
        let result = word(&response[..8]) as i64;
        let length = word(&response[8..16]) as usize;
        self.last_operation = word(&response[16..24]);
        let mut body = vec![0u8; length];
        read_exact(control, &mut body)?;
        if result < 0 { return Err(-result); }
        Ok((result, body))
    }
    fn unit_request(&mut self, operation: u64, arguments: &[u64]) -> Result<(), i64> {
        self.request(operation, arguments, b"")?;
        Ok(())
    }
    pub fn open_stream(&mut self, world: &mut World, address: &[u8]) -> Result<u64, i64> {
        self.ensure(world)?;
        let (handle, _) = self.request(1, &[0u64; 0], address)?;
        Ok(handle as u64)
    }
    pub fn open_listener(&mut self, world: &mut World, address: &[u8]) -> Result<u64, i64> {

    }
    pub fn open_regular_file(&mut self, directory: u64, path: &[u8]) -> Result<u64, i64> {
        let (identity, _) = self.request(36, &[directory, 2u64], path)?;
        let identity = identity as u64;
        // The O_PATH descriptor opens no device/FIFO for data access.
        if let Err(errno) = self.request(51, &[identity], b"") {
            self.close_remote(identity);
            return Err(errno);
        }
        let readable = self.readonly_remote(identity);
        self.close_remote(identity);
        readable
    }
    pub fn seek_remote(&mut self, file: u64, offset: i64, whence: u8) -> Result<usize, i64> {

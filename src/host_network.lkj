    }
    pub fn take_connection(&mut self, listener: u64, nodelay: bool) -> Result<u64, i64> {
        let (handle, _) = self.request(3, &[listener, nodelay as u64], b"")?;
        Ok(handle as u64)
    }
    pub fn address_of(&mut self, listener: u64, bytes: &mut [u8]) -> Result<(), i64> {
        if bytes.len() != 16 { return Err(22); }
        let (_, address) = self.request(4, &[listener], b"")?;
        if address.len() != 16 { return Err(5); }
        bytes.copy_from_slice(&address);
        Ok(())
    }
    pub fn read_remote(&mut self, file: u64, bytes: &mut [u8]) -> Result<usize, i64> {
        let (count, body) = self.request(5, &[file, bytes.len() as u64], b"")?;
        if count as usize != body.len() || body.len() > bytes.len() { return Err(5); }
        bytes[..body.len()].copy_from_slice(&body);
        Ok(body.len())
    }
    pub fn write_remote(&mut self, file: u64, bytes: &[u8]) -> Result<usize, i64> {
        let (count, _) = self.request(6, &[file], bytes)?;
        if count as usize > bytes.len() { return Err(5); }
        Ok(count as usize)
    }
    pub fn close_remote(&mut self, file: u64) {
        let _ = self.unit_request(7, &[file]);
    }
    pub fn duplicate_remote(&mut self, file: u64) -> Result<u64, i64> {
        let (handle, _) = self.request(8, &[file], b"")?;
        Ok(handle as u64)
    }
    pub fn open_foreign_command(&mut self, world: &mut World, path: &[u8]) -> Result<u64, i64> {
        self.ensure(world)?;
        let (handle, _) = self.request(52, &[0u64; 0], path)?;
        Ok(handle as u64)
    }
    pub fn open_null_device(&mut self, world: &mut World) -> Result<u64, i64> {
        self.ensure(world)?;

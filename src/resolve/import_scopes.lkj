//! Lexical imports follow explicit block ownership, independently of source locations.
use crate::ast::{Diagnostic, ModuleId, Program, Use};
use std::collections::BTreeMap;

fn valid_context(program: &Program, scope: ModuleId, block: Option<usize>) -> bool {
    let module = if scope < program.scopes.len() { scope }
        else if let Some(owner) = program.blocks.get(scope - program.scopes.len()) { owner.scope }
        else { return false; };
    block.is_none_or(|id| program.blocks.get(id).is_some_and(|owner| owner.scope == module))
}

#[derive(Default)]
pub(super) struct ImportScopes {
    parents: BTreeMap<usize, usize>,
    modules: usize,
}
impl ImportScopes {
    pub fn new(program: &Program, _modules: &BTreeMap<String, ModuleId>)
        -> Result<Self, Diagnostic> {
        let mut result = Self { parents: BTreeMap::new(), modules: program.scopes.len() };
        for (id, block) in program.blocks.iter().enumerate() {
            if block.scope >= program.scopes.len() || block.parent.is_some_and(|parent|
                parent >= id || program.blocks[parent].scope != block.scope) {
                return Err(Diagnostic::new(block.span, "E_IMPORT", "block has no structural lexical owner"));
            }
            let owner = program.scopes.len().checked_add(id).ok_or_else(||
                Diagnostic::new(block.span, "E_IMPORT", "lexical scope index overflow"))?;
            result.parents.insert(owner, block.parent.map(|parent|
                program.scopes.len() + parent).unwrap_or(block.scope));
        }
        for node in &program.types {
            if !valid_context(program, node.scope, node.block) {
                return Err(Diagnostic::new(node.span, "E_IMPORT", "type has no structural lexical owner"));
            }
        }
        for node in &program.exprs {
            if !valid_context(program, node.scope, node.block) {
                return Err(Diagnostic::new(node.span, "E_IMPORT", "expression has no structural lexical owner"));
            }
        }
        for node in &program.patterns {
            if !valid_context(program, node.scope, node.block) {
                return Err(Diagnostic::new(node.span, "E_IMPORT", "pattern has no structural lexical owner"));
            }
        }
        for import in &program.uses {
            if import.block.is_some_and(|id| id >= program.blocks.len()
                || program.scopes[program.blocks[id].scope].path != import.module) {
                return Err(Diagnostic::new(import.span, "E_IMPORT", "import has no structural block owner"));
            }
        }
        Ok(result)
    }
    pub fn import_owner(&self, import: &Use, module: ModuleId) -> usize {
        import.block.map(|id| self.modules + id).unwrap_or(module)
    }
    pub fn parent(&self, owner: usize) -> Option<usize> {
        self.parents.get(&owner).copied()
    }
}

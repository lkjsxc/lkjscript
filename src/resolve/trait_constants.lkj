//! Required nongeneric constants use exact concrete implementation identities.
//! This source selection grants no IR authority and performs no evaluation.
use super::*;

impl Resolver<'_> {
    fn constant_trait(&self, ty: TypeId) -> Result<Option<usize>> {
        let node = &self.program.types[ty];
        let Type::Path(path) = &node.kind else { return Ok(None); };
        if path.qualification.is_some() { return Ok(None); }
        if let Some(declaration) = path.declaration {
            // Index only exact resolved identities. Origin validation still
            // checks the identity relation of an already resolved program.
            return Ok(self.exact_trait(declaration, &path.name, node.span).unwrap_or(None));
        }
        let scope = node.block.map(|id| self.program.scopes.len() + id).unwrap_or(node.scope);
        let Some(binding) = self.path(scope, &path.name, Namespace::Type, node.span, false)?
            .and_then(|resolved| resolved.binding) else { return Ok(None); };
        self.exact_trait(binding.declaration, &binding.target, node.span)
    }

    fn constant_trait_arguments(&self, ty: TypeId) -> Result<()> {
        let node = &self.program.types[ty];
        let Type::Path(path) = &node.kind else { return Ok(()); };
        if !path.args.is_empty() || !path.bindings.is_empty() {
            return Err(Diagnostic::new(node.span, "E_TYPE", "trait constant qualifiers take no generic arguments or associated bindings"));
        }
        Ok(())
    }

    fn constant_target(&self, ty: TypeId) -> Result<Option<(associated_constants::Receiver, String)>> {
        let node = &self.program.types[ty];
        let Type::Path(path) = &node.kind else { return Ok(None); };
        if path.qualification.is_some() || !path.args.is_empty() || !path.bindings.is_empty() { return Ok(None); }
        if let Some(owner) = self.constant_owner(ty)? {
            return Ok(Some((associated_constants::Receiver::Nominal(owner.declaration),
                nominal_receiver_name(&self.declarations[owner.declaration].name))));
        }
        let scope = node.block.map(|id| self.program.scopes.len() + id).unwrap_or(node.scope);
        if path.declaration.is_none() && !self.generic(node.span, &path.name)
            && self.path(scope, &path.name, Namespace::Type, node.span, true)?.is_some_and(|resolved| resolved.binding.is_none())
            && matches!(path.name.as_str(),
                "u8" | "u16" | "u32" | "u64" | "usize" | "i8" | "i16" | "i32" | "i64" | "isize" | "bool" | "char" | "f64") {
            return Ok(Some((associated_constants::Receiver::Primitive(path.name.clone()), path.name.clone())));
        }
        Ok(None)
    }

    pub(super) fn index_trait_constants(&mut self) -> Result<()> {
        for (index, implementation) in self.program.impls.iter().enumerate() {
            let Some(trait_ty) = implementation.trait_ty else { continue; };
            let Some(trait_index) = self.constant_trait(trait_ty)? else {
                if !implementation.constants.is_empty() {
                    return Err(Diagnostic::new(implementation.span, "E_TRAIT", "this trait declares no associated constants"));
                }
                continue;
            };
            let declaration = &self.program.traits[trait_index];
            if declaration.constants.is_empty() && implementation.constants.is_empty() { continue; }
            self.constant_trait_arguments(trait_ty)?;
            if !implementation.generics.is_empty() || !implementation.predicates.is_empty() {
                return Err(Diagnostic::new(implementation.span, "E_UNSUPPORTED", "trait constants require a nongeneric implementation"));
            }
            let Some((receiver, target)) = self.constant_target(implementation.target)? else {
                return Err(Diagnostic::new(implementation.span, "E_UNSUPPORTED", "trait constants require a concrete primitive or nongeneric nominal receiver"));
            };
            let trait_name = qualified(&declaration.module, &declaration.name);
            for constant in &implementation.constants {
                let value = &self.program.constants[*constant];
                let name = format!("<{target} as {trait_name}>::{}", value.name);
                let scope = self.scope(&value.module);
                let id = self.declarations.len();
                let binding = Binding { declaration: id, target: name.clone(), scope, public: Visibility::Public,
                    glob: false, ambiguous: false, import: None, semantic_alias: false };
                if self.associated_constants.trait_members.insert((receiver.clone(), trait_index, value.name.clone()), binding).is_some() {
                    return Err(Diagnostic::new(value.span, "E_NAME", "duplicate trait implementation constant"));
                }
                self.associated_constants.trait_implementations.insert(*constant, index);
                self.declarations.push(Declaration { name, scope, item: Item::Constant(*constant), public: Visibility::Public, span: value.span });
            }
        }
        Ok(())
    }

    pub(super) fn resolve_trait_constant(&self, path: &mut Path, span: Span) -> Result<()> {
        let Some(qualification) = &path.qualification else { return Ok(()); };
        let Some(trait_ty) = qualification.trait_ty else { return Ok(()); };
        let Some(trait_index) = self.constant_trait(trait_ty)? else { return Ok(()); };
        let name = match path.name.rfind("::") { Some(at) => path.name[at + 2usize..].to_string(), None => path.name.clone() };
        let mut declared = false;
        for member in &self.program.traits[trait_index].constants {
            if member.name == name { declared = true; break; }
        }
        if !declared { return Ok(()); }
        self.constant_trait_arguments(trait_ty)?;
        if !path.args.is_empty() || !path.bindings.is_empty() {
            return Err(Diagnostic::new(span, "E_TYPE", "associated constants take no generic arguments"));
        }
        let Some((receiver, _)) = self.constant_target(qualification.receiver)? else {
            return Err(Diagnostic::new(span, "E_UNSUPPORTED", "trait constant selection requires a concrete primitive or nongeneric nominal receiver"));
        };
        let Some(binding) = self.associated_constants.trait_members.get(&(receiver, trait_index, name)) else {
            return Err(Diagnostic::new(span, "E_TRAIT", "no exact implementation supplies this required trait constant"));
        };
        path.name = binding.target.clone();
        path.declaration = Some(binding.declaration);
        Ok(())
    }
}

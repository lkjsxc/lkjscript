pub(super) fn emit(a: &mut Assembler, p: ForeignCode) {
    let write=a.label(); let copy=a.label(); let name=a.label(); let loader=a.label(); let null_path=a.label();
    let filter=a.label(); let empty=a.label(); let bytes=policy_bytes(); let readable=a.label();
    let texts=vec!["LD_LIBRARY_PATH=/proc/self/fd/5/.runtime".to_string(),"HOME=/proc/self/fd/5".to_string(),"GIT_CONFIG_GLOBAL=/proc/self/fd/5/.no-global-config".to_string(),"GIT_CONFIG_NOSYSTEM=1".to_string(),"GIT_OPTIONAL_LOCKS=0".to_string(),"GIT_TERMINAL_PROMPT=0".to_string(),"LC_ALL=C".to_string()];
    let mut environment=Vec::new(); for _text in &texts { environment.push(a.label()); }
    reopen(a,p,readable);
    image(a,p,write,copy,name,loader,readable); null_device(a,p,null_path,readable);
    run(a,p,write,copy,name,filter,bytes.len()/8,&environment,empty);
    a.bind(write);
    let writing=a.label(); let written=a.label(); let write_error=a.label();
    a.bind(writing); a.test(D,true); a.condition(4,written); call(a,1); a.test(A,true); a.condition(8,write_error);
    a.condition(4,write_error); a.rr(0x01,SI,A,true); a.rr(0x29,D,A,true); a.jump(writing);
    a.bind(written); a.immediate(A,0); a.ret();
    a.bind(write_error); let negative=a.label(); a.test(A,true); a.condition(8,negative); a.immediate(A,(-5i64) as u64); a.bind(negative); a.ret();
    a.bind(copy); enter(a,p,8256); a.store(BP,-8,DI); a.store(BP,-16,SI);
    let reading=a.label(); let copied=a.label(); let copy_error=a.label();
    a.bind(reading); a.load(DI,BP,-8); a.lea(SI,BP,-8256); a.immediate(D,8192); call(a,0);
    a.test(A,true); a.condition(8,copy_error); a.condition(4,copied);
    a.mov(D,A); a.load(DI,BP,-16); a.lea(SI,BP,-8256); a.call(write); a.test(A,true); a.condition(8,copy_error); a.jump(reading);
    a.bind(copied); a.immediate(A,0); a.bind(copy_error); epilogue(a);
    a.bind(name); a.raw(b"lkjscript-foreign\0"); a.bind(loader); a.raw(b"/proc/self/fd/5/.runtime/ld.so\0");
    a.bind(null_path); a.raw(b"/dev/null\0"); a.bind(empty); a.raw(&[0]); a.bind(filter); a.raw(&bytes);
    for (index,text) in texts.iter().enumerate() { a.bind(environment[index]); a.raw(text.as_bytes()); a.raw(&[0]); }
}

fn dispatch_call(a: &mut Assembler, function: Label) {
    a.push(R13); a.lea(R13, BP, LAST_OPERATION);
    a.call(function); a.pop(R13);
}
pub(super) fn dispatch(a: &mut Assembler, p: ForeignCode, labels: &[Label], reply: Label, bad: Label) {
    a.bind(labels[0]); a.mov(DI,R14); a.mov(SI,R15); dispatch_call(a,p.foreign_open); reply_empty(a,reply);
    a.bind(labels[1]); dispatch_call(a,p.null_open); reply_empty(a,reply);
    a.bind(labels[2]);
    for index in 0usize..3usize {
        a.load(A,BP,REQUEST+8+index as i64*8); check_fd(a,A,bad); a.store(BP,SCRATCH-index as i64*8,A);
    }
    a.store(BP,SCRATCH-24,R14); a.store(BP,SCRATCH-32,R15);
    a.load(A,BP,REQUEST+32); a.store(BP,SCRATCH-40,A);
    a.lea(DI,BP,SCRATCH); dispatch_call(a,p.foreign_run); reply_empty(a,reply);
}

//! Independent interpreter broker implementation of a bounded TCP connection.
use crate::x86::*;
use super::broker::{empty, LAST_OPERATION, REQUEST, SCRATCH};
const FILE: i64 = SCRATCH;
const ERROR: i64 = SCRATCH + 8;
const POLL: i64 = SCRATCH + 16;
const CLOCK: i64 = SCRATCH + 32;
const REMAINING: i64 = SCRATCH + 48;
const SOCKET_ERROR: i64 = SCRATCH + 64;

fn operation(a: &mut Assembler, number: u64) {
    a.immediate(R11, number);
    a.store(BP, LAST_OPERATION, R11);
}
fn call(a: &mut Assembler, number: u64) {
    operation(a, number);
    super::syscall(a, number);
}
fn clock(a: &mut Assembler, failed: Label) {
    a.immediate(DI, 1);
    a.lea(SI, BP, CLOCK);
    call(a, 228);
    a.test(A, true);
    a.condition(8, failed);
    a.load(A, BP, CLOCK);
    a.immediate(C, 1000000000);
    a.imul(A, C);
    a.load(C, BP, CLOCK + 8);
    a.rr(0x01, A, C, true);
}

pub(super) fn emit(a: &mut Assembler, entry: Label, reply: Label, invalid: Label) {
    let failed = a.label();
    let closed = a.label();
    let timeout = a.label();
    let waiting = a.label();
    let started = a.label();
    let connected = a.label();
    let bad_descriptor = a.label();
    let bad_reply = a.label();
    a.bind(entry);
    a.immediate(A, 16);
    a.compare(R15, A);
    a.condition(5, invalid);
    a.load_width(A, R14, 0, 2, false);
    a.immediate(C, 2);
    a.compare(A, C);
    a.condition(5, invalid);
    a.immediate(A, !0u64);
    a.store(BP, FILE, A);
    clock(a, failed);
    a.load(C, BP, REQUEST + 8);
    a.compare(C, A);
    a.condition(6, timeout);
    a.immediate(DI, 2);
    a.immediate(SI, 0x80801);
    a.immediate(D, 0);
    call(a, 41);
    a.test(A, true);
    a.condition(8, failed);
    a.store(BP, FILE, A);
    a.mov(DI, A);
    a.mov(SI, R14);
    a.immediate(D, 16);
    operation(a, 42);
    a.immediate(A, 42);
    a.syscall();
    a.test(A, true);
    a.condition(9, connected);
    a.immediate(C, (-106i64) as u64);
    a.compare(A, C);
    a.condition(4, connected);
    for error in vec![115i64, 114i64, 4i64] {
        a.immediate(C, (-error) as u64);
        a.compare(A, C);
        a.condition(4, started);
    }
    a.jump(failed);
    a.bind(started);
    a.load(A, BP, FILE);
    a.immediate(C, 4u64 << 32);
    a.rr(0x09, A, C, true);
    a.store(BP, POLL, A);
    a.bind(waiting);
    clock(a, failed);
    a.load(B, BP, REQUEST + 8);
    a.compare(B, A);
    a.condition(6, timeout);
    a.rr(0x29, B, A, true);
    a.mov(A, B);
    a.immediate(D, 0);
    a.immediate(C, 1000000000);
    a.divide(C, false);
    a.store(BP, REMAINING, A);
    a.store(BP, REMAINING + 8, D);
    a.lea(DI, BP, POLL);
    a.immediate(SI, 1);
    a.lea(D, BP, REMAINING);
    a.immediate(R10, 0);
    a.immediate(R8, 8);
    operation(a, 271);
    a.immediate(A, 271);
    a.syscall();
    a.immediate(C, (-4i64) as u64);
    a.compare(A, C);
    a.condition(4, waiting);
    a.test(A, true);
    a.condition(8, failed);
    a.condition(4, timeout);
    a.load_width(A, BP, POLL + 6, 2, false);
    a.immediate(C, 32);
    a.rr(0x21, A, C, true);
    a.test(A, true);
    a.condition(5, bad_descriptor);
    a.immediate(A, 4);
    a.store_width(BP, SOCKET_ERROR + 4, A, 4);
    a.load(DI, BP, FILE);
    a.immediate(SI, 1);
    a.immediate(D, 4);
    a.lea(R10, BP, SOCKET_ERROR);
    a.lea(R8, BP, SOCKET_ERROR + 4);
    call(a, 55);
    a.test(A, true);
    a.condition(8, failed);
    a.load_width(A, BP, SOCKET_ERROR + 4, 4, false);
    a.immediate(C, 4);
    a.compare(A, C);
    a.condition(5, bad_reply);
    a.load_width(C, BP, SOCKET_ERROR, 4, false);
    a.immediate(A, 0);
    a.rr(0x29, A, C, true);
    a.test(A, true);
    a.condition(5, failed);
    a.bind(connected);
    a.load(DI, BP, FILE);
    a.immediate(SI, 3);
    a.immediate(D, 0);
    call(a, 72);
    a.test(A, true);
    a.condition(8, failed);
    a.mov(D, A);
    a.immediate(C, !2048u64);
    a.rr(0x21, D, C, true);
    a.load(DI, BP, FILE);
    a.immediate(SI, 4);
    call(a, 72);
    a.test(A, true);
    a.condition(8, failed);
    a.load(A, BP, FILE);
    empty(a, reply);
    a.bind(bad_descriptor);
    a.immediate(A, (-9i64) as u64);
    a.jump(failed);
    a.bind(bad_reply);
    a.immediate(A, (-5i64) as u64);
    a.jump(failed);
    a.bind(timeout);
    a.immediate(A, (-110i64) as u64);
    a.bind(failed);
    a.store(BP, ERROR, A);
    a.load(DI, BP, FILE);
    a.test(DI, true);
    a.condition(8, closed);
    a.immediate(A, 3);
    a.syscall();
    a.bind(closed);
    a.load(A, BP, ERROR);
    empty(a, reply);
}

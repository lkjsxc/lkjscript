//! Source loading owns module discovery; the host supplies bytes for requested paths.
use crate::ast::*;
use crate::diagnostics::{BlockedRegion, Recovery};
use crate::syntax;
use std::collections::BTreeMap;

pub struct SourceInput {
    pub path: String,
    pub text: String,
}
pub struct SourceBundle {
    pub configuration: BuildConfiguration,
    pub root: String,
    pub library: Option<String>,
    pub files: Vec<SourceInput>,
}

/// Recovered syntax is retained for diagnostics only. An error in
/// this report prevents every production path from constructing checked IR.
pub struct SourceReport {
    pub program: Program,
    pub diagnostics: Vec<Diagnostic>,
    pub blocked: Vec<BlockedRegion>,
    pub recovery: Vec<Recovery>,
    pub macro_expansion_attempts: usize,
    /// Original loaded UTF-8 source bytes, indexed by program.files. Recovered
    /// syntax and these texts support diagnostics only, never source admission.
    pub texts: Vec<String>,
}
impl SourceReport {
    pub fn into_result(self) -> Result<Program, Diagnostic> {
        match self.diagnostics.into_iter().next() {
            Some(error) => Err(error),
            None => Ok(self.program),
        }
    }
}

pub fn parse_bundle(bundle: &SourceBundle) -> Result<Program, Diagnostic> {
    parse_bundle_report(bundle).into_result()
}

pub fn parse_bundle_report(bundle: &SourceBundle) -> SourceReport {
    let mut files: BTreeMap<String, usize> = BTreeMap::new();
    let mut duplicates = Vec::new();
    for index in 0..bundle.files.len() {
        let file = &bundle.files[index];
        if files.contains_key(&file.path) {
            let mut error = Diagnostic::new(
                Span::default(),
                "E_SOURCE_DUPLICATE",
                &format!("source bundle repeats {}", file.path),
            );
            error.path = file.path.clone();
            duplicates.push(error);
        } else {
            files.insert(file.path.clone(), index);
        }
    }
    let library = match &bundle.library {
        Some(path) => Some(path.as_str()),
        None => None,
    };
    let providers: Vec<crate::ast::macros::MacroProviderInput> = Vec::new();
    let mut report = load_report_with_providers(&bundle.root, library, &providers, bundle.configuration, &mut |path: &str| {
        let text = match files.get(&path.to_string()) {
            Some(index) => Some(bundle.files[*index].text.as_bytes().to_vec()),
            None => None,
        };
        Ok(text)
    });
    if !duplicates.is_empty() {
        for diagnostic in &duplicates {
            report.recovery.push(Recovery {
                span: Span::default(), scope: 0usize, block: None,
                kind: "source bundle".to_string(), names: Vec::new(),
                namespace: true, coherence: true, diagnostic: diagnostic.clone(),
            });
        }
        let mut diagnostics = duplicates;
        for diagnostic in report.diagnostics {
            diagnostics.push(diagnostic);
        }
        report.diagnostics = diagnostics;
        report.blocked.push(BlockedRegion {
            path: bundle.root.clone(),
            span: Span::default(),
            kind: "source bundle".to_string(),
            reason: "duplicate source inputs prevent an unambiguous compilation".to_string(),
        });
    }
    report
}

fn parent(path: &str) -> &str {
    match path.rfind('/') {
        Some(0) => &path[..1],
        Some(at) => &path[..at],
        None => "",
    }
}
fn join(directory: &str, file: &str) -> String {
    if directory.is_empty() {
        file.to_string()
    } else if directory == "/" {
        format!("/{file}")
    } else {
        format!("{directory}/{file}")
    }
}
fn stem(path: &str) -> &str {
    let start = match path.rfind('/') {
        Some(at) => at + 1,
        None => 0,
    };
    let name = &path[start..];
    if name.ends_with(".lkj") {
        &name[..name.len() - 4]
    } else {
        path
    }
}

fn read_source<F: FnMut(&str) -> std::result::Result<Option<Vec<u8>>, String>>(
    read: &mut F,
    path: &str,
    span: Span,
) -> Result<Option<String>, Diagnostic> {
    let bytes = read(path).map_err(|message| {
        let mut e = Diagnostic::new(span, "E_IO", &message);
        e.path = path.to_string();
        e
    })?;
    match bytes {
        Some(bytes) => match String::from_utf8(bytes) {
            Ok(text) => Ok(Some(text)),
            Err(_) => {
                let mut error = Diagnostic::new(span, "E_IO", "source is not valid UTF-8");
                error.path = path.to_string();
                Err(error)
            }
        },
        None => Ok(None),
    }
}

fn include_path(source: &str, requested: &str) -> Result<String, String> {
    if requested.is_empty() || requested.starts_with('/') {
        return Err(
            "an embedded file needs a nonempty path beneath the source directory".to_string(),
        );
    }
    for byte in requested.bytes() {
        if byte == 0u8 {
            return Err("an embedded file path cannot contain a NUL byte".to_string());
        }
    }
    let directory = parent(source);
    let absolute = directory.starts_with('/');
    let mut parts: Vec<String> = Vec::new();
    for part in directory.split('/') {
        if part != "" && part != "." {
            if part == ".." {
                if parts.pop().is_none() {
                    return Err("embedded file escapes the source directory".to_string());
                }
            } else {
                parts.push(part.to_string());
            }
        }
    }
    let floor = if !parts.is_empty() && parts[0] == "$std" {
        1usize
    } else {
        0usize
    };
    for part in requested.split('/') {
        if part != "" && part != "." {
            if part == ".." {
                if parts.len() == floor {
                    return Err("embedded file escapes the source directory".to_string());
                }
                parts.pop();
            } else {
                parts.push(part.to_string());
            }
        }
    }
    let mut path = if absolute {
        "/".to_string()
    } else {
        String::new()
    };
    for part in parts {
        if !path.is_empty() && path != "/" {
            path.push('/');
        }
        path.push_str(&part);
    }
    Ok(path)
}

fn expand_includes<F: FnMut(&str) -> Result<Option<Vec<u8>>, String>>(
    program: &mut Program,
    first: usize,
    read: &mut F,
    diagnostics: &mut Vec<Diagnostic>,
) {
    let mut index = first;
    while index < program.exprs.len() {
        let expression = program.exprs[index].clone();
        if let Expr::Macro {
            name,
            args,
            separator,
        } = expression.kind
        {
            if name == "include_str" || name == "include_bytes" {
                let span = expression.span;
                let requested: Option<String> = if args.len() == 1 && separator == "," {
                    match &program.exprs[args[0]].kind {
                        Expr::String(path) => Some(path.clone()),
                        _ => None,
                    }
                } else {
                    None
                };
                let result: Result<String, String> = match requested {
                    Some(requested) => include_path(&program.files[span.file].path, &requested),
                    None => Err(format!("{name}! requires one literal file path")),
                };
                let path = match result {
                    Ok(path) => path,
                    Err(message) => {
                        diagnostics.push(load_error(program, span, "E_INCLUDE_PATH", &message));
                        index += 1;
                        continue;
                    }
                };
                match read(&path) {
                    Ok(Some(bytes)) => {
                        if name == "include_bytes" {
                            program.exprs[index].kind = Expr::Bytes(bytes);
                        } else {
                            match String::from_utf8(bytes) {
                                Ok(text) => program.exprs[index].kind = Expr::String(text),
                                Err(_) => diagnostics.push(load_error(
                                    program,
                                    span,
                                    "E_INCLUDE_UTF8",
                                    &format!("embedded file {path} is not valid UTF-8"),
                                )),
                            }
                        }
                    }
                    Ok(None) => diagnostics.push(load_error(
                        program,
                        span,
                        "E_INCLUDE_MISSING",
                        &format!("missing embedded file {path}"),
                    )),
                    Err(message) => diagnostics.push(load_error(
                        program,
                        span,
                        "E_IO",
                        &format!("cannot read embedded file {path}: {message}"),
                    )),
                }
            }
        }
        index += 1;
    }
}

fn capture_macro_includes<F: FnMut(&str) -> Result<Option<Vec<u8>>, String>>(
    program: &mut Program, read: &mut F, diagnostics: &mut Vec<Diagnostic>,
) {
    let mut inputs: Vec<(String, Vec<u8>)> = Vec::new();
    {
        let mut captured = |path: &str| -> Result<Option<Vec<u8>>, String> {
            match read(path) {
                Ok(Some(bytes)) => {
                    let mut found = false;
                    for input in &inputs {
                        if input.0.as_str() == path {
                            if input.1 != bytes { return Err("macro include input changed during expansion".to_string()); }
                            found = true;
                        }
                    }
                    if !found { inputs.push((path.to_string(), bytes.clone())); }
                    Ok(Some(bytes))
                }
                other => other,
            }
        };
        expand_includes(program, 0usize, &mut captured, diagnostics);
    }
    program.macro_inputs = inputs;
}

/// Replay only immutable include receipts, never ambient filesystem access.
pub(crate) fn replay_macro_includes(program: &mut Program, inputs: &[(String, Vec<u8>)]) -> Result<(), Diagnostic> {
    let span = program.macro_invocations.first().map(|invocation| invocation.span).unwrap_or(Span::default());
    let mut paths: std::collections::BTreeSet<String> = std::collections::BTreeSet::new();
    for input in inputs {
        if !paths.insert(input.0.clone()) {
            return Err(Diagnostic::new(span, "E_IDENTITY_ORIGIN", "duplicate macro include receipt"));
        }
    }
    let mut seen = vec![false; inputs.len()];
    let mut diagnostics = Vec::new();
    {
        let mut captured = |path: &str| -> Result<Option<Vec<u8>>, String> {
            let mut at = 0usize;
            while at < inputs.len() {
                if inputs[at].0.as_str() == path {
                    seen[at] = true;
                    return Ok(Some(inputs[at].1.clone()));
                }
                at += 1usize;
            }
            Err("macro include read has no captured receipt".to_string())
        };
        expand_includes(program, 0usize, &mut captured, &mut diagnostics);
    }
    if !diagnostics.is_empty() {
        let mut diagnostic = diagnostics[0usize].clone();
        diagnostic.code = "E_IDENTITY_ORIGIN".to_string();
        return Err(diagnostic);
    }
    for read in seen {
        if !read { return Err(Diagnostic::new(span, "E_IDENTITY_ORIGIN", "unused macro include receipt")); }
    }
    program.macro_inputs = inputs.to_vec();
    Ok(())
}

/// Both bundle compilation and the bootstrap CLI use this module interpretation.
/// `read` supplies bytes only; it does not resolve source names or select modules.
pub fn load<F: FnMut(&str) -> std::result::Result<Option<Vec<u8>>, String>>(
    root: &str,
    standard: Option<&str>,
    read: &mut F,
) -> Result<Program, Diagnostic> {
    load_report(root, standard, read).into_result()
}

/// Load every independently discoverable file even after source errors. File
/// reads and parsing use the same path rules as ordinary compilation.
pub fn load_report<F: FnMut(&str) -> std::result::Result<Option<Vec<u8>>, String>>(
    root: &str,
    standard: Option<&str>,
    read: &mut F,
) -> SourceReport {
    let providers: Vec<crate::ast::macros::MacroProviderInput> = Vec::new();
    load_report_with_providers(root, standard, &providers, BuildConfiguration::default(), read)
}

// Parser failures carry their exact recovery owner. Loader and expansion failures
// only receive a narrower owner when an authored source edge proves it; unknown
// input or expansion failures poison the global namespace and coherence context.
fn complete_recovery(program: &Program, texts: &[String], diagnostics: &[Diagnostic],
    recovery: &mut Vec<Recovery>) {
    for diagnostic in diagnostics {
        if recovery.iter().any(|failure| failure.diagnostic == *diagnostic) { continue; }
        let mut span = Span { file: diagnostic.file, line: diagnostic.line,
            column: diagnostic.column, ..Span::default() };
        let mut scope = 0usize;
        let mut block = None;
        let mut names = Vec::new();
        let mut kind = "source input".to_string();
        let mut namespace = true;
        let mut coherence = true;
        if let Some(file) = program.files.iter().position(|file| file.path == diagnostic.path) {
            span.file = file;
            span.start = 0usize;
            span.end = texts.get(file).map(|text| text.len()).unwrap_or(0usize);
        }
        let mut matches = 0usize;
        for invocation in &program.macro_invocations {
            if invocation.parent.is_none() && invocation.span.file < program.files.len()
                && program.files[invocation.span.file].path == diagnostic.path
                && invocation.span.line == diagnostic.line && invocation.span.column == diagnostic.column {
                matches += 1usize;
                span = invocation.span; scope = invocation.destination; block = invocation.block;
                kind = "macro invocation".to_string();
            }
        }
        if matches == 0usize {
            for module in &program.modules {
                if module.span.file < program.files.len()
                    && program.files[module.span.file].path == diagnostic.path
                    && module.span.line == diagnostic.line && module.span.column == diagnostic.column {
                    matches += 1usize; span = module.span;
                    scope = program.scopes[module.scope].parent.unwrap_or(0usize);
                    names = vec![module.name.clone()]; kind = "module".to_string();
                }
            }
        }
        if matches == 0usize && (diagnostic.code.starts_with("E_INCLUDE") || diagnostic.code == "E_IO") {
            for expression in &program.exprs {
                if expression.span.file >= program.files.len()
                    || program.files[expression.span.file].path != diagnostic.path
                    || expression.span.line != diagnostic.line || expression.span.column != diagnostic.column { continue; }
                if let Expr::Macro { name, .. } = &expression.kind {
                    if name == "include_str" || name == "include_bytes" {
                        matches += 1usize; span = expression.span;
                        scope = expression.scope; block = expression.block; kind = "expression".to_string();
                        namespace = false; coherence = false;
                        // Partial replay retains these declarations and their exact
                        // attributes. Module/crate documentation is a context input:
                        // empty module wrappers cannot discharge its failed read.
                        let owns = |owner: Span| owner.file == expression.span.file
                            && owner.start <= expression.span.start && expression.span.end <= owner.end;
                        let retained = program.functions.iter().any(|value| owns(value.span)
                            || value.attrs.iter().any(|attr| owns(attr.span)))
                            || program.structs.iter().any(|value| owns(value.span)
                                || value.attrs.iter().any(|attr| owns(attr.span)))
                            || program.enums.iter().any(|value| owns(value.span)
                                || value.attrs.iter().any(|attr| owns(attr.span)))
                            || program.constants.iter().any(|value| owns(value.span));
                        if !retained {
                            namespace = true; coherence = true; kind = "source input".to_string();
                        }
                    }
                }
            }
        }
        if matches > 1usize {
            scope = 0usize; block = None; names.clear();
            namespace = true; coherence = true; kind = "source input".to_string();
        }
        recovery.push(Recovery { span, scope, block, kind, names, namespace, coherence,
            diagnostic: diagnostic.clone() });
    }
}

pub(crate) fn load_report_with_providers<F: FnMut(&str) -> std::result::Result<Option<Vec<u8>>, String>>(
    root: &str,
    standard: Option<&str>,
    providers: &[crate::ast::macros::MacroProviderInput],
    configuration: BuildConfiguration,
    read: &mut F,
) -> SourceReport {
    let mut diagnostics = Vec::new();
    let mut blocked = Vec::new();
    let mut recovery = Vec::new();
    let mut texts = Vec::new();
    let mut program = Program::default();
    program.configuration = configuration;
    for input in providers {
        program.macro_providers.push(crate::ast::macros::MacroProvider {
            input: input.clone(), declaration: None, root: None,
        });
    }
    program.scopes.push(ModuleScope {
        path: String::new(),
        parent: None,
        crate_root: 0,
    });
    let mut pending: Vec<(String, ModuleId, Option<usize>, String)> = Vec::new();
    if let Some(path) = standard {
        program.scopes.push(ModuleScope {
            path: "$std".to_string(),
            parent: None,
            crate_root: 1,
        });
        pending.push((path.to_string(), 1, None, String::new()));
    }
    pending.push((root.to_string(), 0, None, String::new()));
    let mut directories: BTreeMap<ModuleId, String> = BTreeMap::new();
    let mut loaded: BTreeMap<ModuleId, String> = BTreeMap::new();
    let mut next_module = 0;
    while let Some((path, scope, owner, alternate)) = pending.pop() {
        let text = match read_source(read, &path, Span::default()) {
            Ok(Some(text)) => text,
            result => {
                let mut error = match result {
                    Err(error) => error,
                    _ => Diagnostic::new(
                        Span::default(),
                        "E_MODULE_MISSING",
                        &format!("missing source file {path}"),
                    ),
                };
                error.path = path.clone();
                blocked.push(BlockedRegion {
                    path: path.clone(),
                    span: Span::default(),
                    kind: "file".to_string(),
                    reason: error.message.clone(),
                });
                if let Some(index) = owner { recovery.push(unloaded_module(&program, index, &error)); }
                diagnostics.push(error);
                continue;
            }
        };
        // A file can be mounted in multiple modules, but an ancestor inclusion cycle cannot terminate.
        let mut ancestor = Some(scope);
        let mut cycle = false;
        while let Some(a) = ancestor {
            if loaded.get(&a) == Some(&path) {
                cycle = true;
                break;
            }
            ancestor = program.scopes[a].parent;
        }
        if cycle {
            let mut error = Diagnostic::new(
                Span::default(),
                "E_MODULE_CYCLE",
                &format!("recursive module file {path}"),
            );
            error.path = path.clone();
            blocked.push(BlockedRegion {
                path: path.clone(),
                span: Span::default(),
                kind: "file".to_string(),
                reason: error.message.clone(),
            });
            if let Some(index) = owner { recovery.push(unloaded_module(&program, index, &error)); }
            diagnostics.push(error);
            continue;
        }
        loaded.insert(scope, path.clone());
        let file = program.files.len();
        program.files.push(SourceFile {
            path: path.clone(),
            crate_root: program.scopes[scope].crate_root,
        });
        program.loaded_modules.push(LoadedModule { scope, file, alternate });
        let base = if program.scopes[scope].parent.is_none() || stem(&path) == "mod" {
            parent(&path).to_string()
        } else {
            join(parent(&path), stem(&path))
        };
        directories.insert(scope, base);
        let first_expression = program.exprs.len();
        let parsed = syntax::parse_file_report(&mut program, &text, file, scope);
        texts.push(text);
        for failure in parsed.recovery { recovery.push(failure); }
        expand_includes(&mut program, first_expression, read, &mut diagnostics);
        for diagnostic in parsed.diagnostics {
            diagnostics.push(diagnostic);
        }
        for region in parsed.blocked {
            blocked.push(region);
        }
        let mut items = parsed.items;
        if scope == 0 && !providers.is_empty() {
            let mut index = program.macro_providers.len();
            while index > 0usize {
                index -= 1usize;
                if program.macro_providers[index].declaration.is_some() {
                    let scope = program.scopes.len();
                    program.scopes.push(ModuleScope {
                        path: format!("$macro_provider{index}"), parent: None, crate_root: scope,
                    });
                    let provider = &mut program.macro_providers[index];
                    provider.root = Some(scope);
                    pending.push((provider.input.path.clone(), scope, None, String::new()));
                } else {
                    let provider = &program.macro_providers[index];
                    let span = Span { file, ..Span::default() };
                    let mut problem = Diagnostic::new(span, "E_MACRO_PROVIDER", &format!(
                        "no matching crate-root #[macro_use] extern crate {} as {} declaration",
                        provider.input.name, provider.input.alias,
                    ));
                    problem.path = path.clone();
                    diagnostics.push(problem);
                }
            }
        }
        // New capability helpers are ordinary, checked library source. Mounting
        // this optional module here keeps the library root readable by the
        // stored seed, whose resolver predates Arguments and Environment.
        // The old seed does not know these authority types. Their ordinary
        // source helpers join only a current compiler's library namespace.
        if scope == 1 && path == "$std/lib.lkj" {
            match read_source(read, "$std/read_io.lkj", Span::default()) {
                Ok(Some(_)) => {
                    let mut declared = false;
                    for module in &program.modules {
                        if module.name == "read_io" && program.scopes[module.scope].parent == Some(scope) { declared = true; }
                    }
                    if !declared {
                        let extra = syntax::parse_file_report(
                            &mut program, "pub mod read_io;", file, scope,
                        );
                        for item in extra.items { items.push(item); }
                    }
                }
                Ok(None) => {}
                Err(error) => diagnostics.push(error),
            }
        }
        if scope == 1 && path == "$std/lib.lkj" {
            match read_source(read, "$std/foreign.lkj", Span::default()) {
                Ok(Some(_)) => {
                    let mut declared = false;
                    for module in &program.modules {
                        if module.name == "foreign" && program.scopes[module.scope].parent == Some(scope) { declared = true; }
                    }
                    if !declared {
                        let extra = syntax::parse_file_report(
                            &mut program, "pub mod foreign;", file, scope,
                        );
                        for item in extra.items { items.push(item); }
                    }
                }
                Ok(None) => {}
                Err(error) => diagnostics.push(error),
            }
        }
        if scope == 1 && path == "$std/lib.lkj" {
            for name in vec!["foreign_session".to_string(),"workers".to_string(),"process_model".to_string()] {
                let module_path=format!("$std/{name}.lkj");
                match read_source(read,&module_path,Span::default()) {
                    Ok(Some(_))=>{
                        let mut declared=false;
                        for module in &program.modules {
                            if module.name==name && program.scopes[module.scope].parent==Some(scope) {declared=true;}
                        }
                        if !declared {
                            let extra=syntax::parse_file_report(&mut program,&format!("pub mod {name};"),file,scope);
                            for item in extra.items {items.push(item);}
                        }
                    }
                    Ok(None)=>{},
                    Err(error)=>diagnostics.push(error),
                }
            }
        }
        let mut command_declared = false;
        for module in &program.modules {
            if module.name == "command" && program.scopes[module.scope].parent == Some(scope) {
                command_declared = true;
            }
        }
        if scope == 1 && path == "$std/lib.lkj" && !command_declared {
            match read_source(read, "$std/command.lkj", Span::default()) {
                Ok(Some(_)) => {
                    let extra = syntax::parse_file_report(
                        &mut program, "pub mod command;", file, scope,
                    );
                    for item in extra.items { items.push(item); }
                }
                Ok(None) => {}
                Err(error) => diagnostics.push(error),
            }
        }
        if let Some(index) = owner {
            let module: &mut Module = &mut program.modules[index];
            module.items = items;
            module.external = false;
        } else {
            for item in items {
                program.items.push(item);
            }
        }
        while next_module < program.modules.len() {
            let index = next_module;
            next_module += 1;
            let module = &program.modules[index];
            let parent_scope = program.scopes[module.scope].parent.unwrap();
            let mut parent_path = directories.get(&parent_scope).cloned();
            let mut at = parent_scope;
            let mut inline: Vec<String> = Vec::new();
            while parent_path.is_none() {
                let info = &program.scopes[at];
                let start = match info.path.rfind("::") {
                    Some(position) => position + 2,
                    None => 0,
                };
                inline.push(info.path[start..].to_string());
                at = info.parent.unwrap();
                parent_path = directories.get(&at).cloned();
            }
            let mut directory = parent_path.unwrap();
            while let Some(part) = inline.pop() {
                directory = join(&directory, &part);
            }
            if !module.external {
                directories.insert(module.scope, join(&directory, &module.name));
                continue;
            }
            let direct = join(&directory, &format!("{}.lkj", module.name));
            let nested = join(&directory, &format!("{}/mod.lkj", module.name));
            let first = read_source(read, &direct, module.span);
            let second = read_source(read, &nested, module.span);
            let (first, second) = match (first, second) {
                (Ok(first), Ok(second)) => (first, second),
                (first, second) => {
                    for candidate in vec![first.err(), second.err()] {
                        if let Some(error) = candidate {
                            blocked.push(BlockedRegion {
                                path: error.path.clone(),
                                span: module.span,
                                kind: "module".to_string(),
                                reason: error.message.clone(),
                            });
                            recovery.push(unloaded_module(&program, index, &error));
                            diagnostics.push(error);
                        }
                    }
                    continue;
                }
            };
            let (selected, alternate) = match (first, second) {
                (Some(_), Some(_)) => {
                    let error = load_error(
                        &program,
                        module.span,
                        "E_MODULE_AMBIGUOUS",
                        &format!("both {direct} and {nested} define module {}", module.name),
                    );
                    blocked.push(BlockedRegion {
                        path: error.path.clone(),
                        span: module.span,
                        kind: "module".to_string(),
                        reason: error.message.clone(),
                    });
                    recovery.push(unloaded_module(&program, index, &error));
                    diagnostics.push(error);
                    continue;
                }
                (Some(_), None) => (direct, nested),
                (None, Some(_)) => (nested, direct),
                (None, None) => {
                    let error = load_error(
                        &program,
                        module.span,
                        "E_MODULE_MISSING",
                        &format!("module {} needs {direct} or {nested}", module.name),
                    );
                    blocked.push(BlockedRegion {
                        path: error.path.clone(),
                        span: module.span,
                        kind: "module".to_string(),
                        reason: error.message.clone(),
                    });
                    recovery.push(unloaded_module(&program, index, &error));
                    diagnostics.push(error);
                    continue;
                }
            };
            pending.push((selected, module.scope, Some(index), alternate));
        }
    }
    if !providers.is_empty() {
        for definition in &program.macro_definitions {
            let crate_root = program.scopes[definition.scope].crate_root;
            if definition.exported && syntax::macros::builtin_macro(&definition.name)
                && program.macro_providers.iter().any(|provider: &crate::ast::macros::MacroProvider|
                    -> bool { provider.root == Some(crate_root) }) {
                diagnostics.push(load_error(&program, definition.name_span, "E_MACRO_PROVIDER",
                    "macro provider export conflicts with a built-in macro"));
            }
        }
    }
    let expansion = syntax::macros::expand_report(&mut program, recovery);
    for mut diagnostic in expansion.diagnostics {
        if diagnostic.path.is_empty() { diagnostic.path = program.files[diagnostic.file].path.clone(); }
        diagnostics.push(diagnostic);
    }
    for region in expansion.blocked { blocked.push(region); }
    let mut recovery = expansion.recovery;
    if !program.macro_expansions.is_empty() { capture_macro_includes(&mut program, read, &mut diagnostics); }
    if !diagnostics.is_empty() {
        blocked.push(BlockedRegion {
            path: root.to_string(),
            span: Span::default(),
            kind: "semantic phase".to_string(),
            reason: "source errors prevent complete name resolution and semantic checking"
                .to_string(),
        });
    }
    complete_recovery(&program, &texts, &diagnostics, &mut recovery);
    SourceReport {
        program,
        diagnostics,
        blocked,
        recovery,
        macro_expansion_attempts: expansion.attempts,
        texts,
    }
}

fn unloaded_module(program: &Program, index: usize, error: &Diagnostic) -> Recovery {
    let module = &program.modules[index];
    Recovery { span: module.span, scope: program.scopes[module.scope].parent.unwrap(),
        block: None, kind: "module".to_string(), names: vec![module.name.clone()],
        namespace: true, coherence: true, diagnostic: error.clone() }
}

fn load_error(program: &Program, span: Span, code: &str, message: &str) -> Diagnostic {
    let mut e = Diagnostic::new(span, code, message);
    e.path = program.files[span.file].path.clone();
    e
}

//! Non-authorizing item facts for a source closure which already refused.
//! A recovered arena is never admitted. Independently complete item closures
//! are replayed from the exact loaded text and checked normally.
use crate::ast as a;
use crate::diagnostics::Recovery;
use crate::generics::TraitIdentity;
use crate::resolve::{LookupRead, LookupTrace, Namespace, Resolver};
use crate::source::SourceReport;
use std::collections::{BTreeMap, BTreeSet};

pub struct Report {
    pub text: String,
    pub checked: usize,
    pub blocked: usize,
    pub rejected: usize,
    pub problems: Vec<a::Diagnostic>,
}
#[derive(Clone)]
struct Failure { cause: a::Diagnostic, reason: String }
#[derive(Clone)]
struct Lookup {
    span: a::Span,
    namespace: Namespace,
    written: String,
    result: Option<(String, Option<a::Item>)>,
    reads: Vec<LookupRead>,
    import_site: Option<usize>,
    pattern_site: bool,
}
enum Receiver {
    Struct(usize),
    Scalar(String),
}
#[derive(Clone, Default)]
struct Plan {
    dependencies: Vec<usize>,
    declarations: Vec<a::Item>,
    lookups: Vec<Lookup>,
    imports: BTreeSet<(usize, Namespace, String)>,
    parameters: Vec<String>,
    expansions: Vec<usize>,
    implementation: Option<usize>,
    receiver: Option<usize>,
    structural: bool,
}
struct Record {
    function: usize,
    status: String,
    failure: Option<Failure>,
    dependencies: Vec<usize>,
}
fn located(program: &a::Program, mut problem: a::Diagnostic) -> a::Diagnostic {
    if problem.path.is_empty() {
        if let Some(file) = program.files.get(problem.file) { problem.path = file.path.clone(); }
    }
    problem
}
fn id(program: &a::Program, index: usize) -> String {
    let f = &program.functions[index];
    let path = &program.files[f.span.file].path;
    let mut same = 0usize;
    for other in &program.functions {
        if other.span.line == f.span.line && other.span.column == f.span.column
            && program.files[other.span.file].path == *path { same += 1usize; }
    }
    if same > 1usize { format!("{path}@{}:{}#item={index}", f.span.line, f.span.column) }
    else { format!("{path}@{}:{}", f.span.line, f.span.column) }
}
fn name(program: &a::Program, index: usize) -> String {
    let f = &program.functions[index];
    crate::names::qualified(&f.module, &f.name)
}
fn contains(outer: a::Span, inner: a::Span) -> bool {
    outer.file == inner.file && outer.start <= inner.start && inner.end <= outer.end
        && outer.start < outer.end
}
fn intersects(left: a::Span, right: a::Span) -> bool {
    left.file == right.file && left.start < right.end && right.start < left.end
}
fn module_scope(program: &a::Program, scope: usize) -> usize {
    if scope < program.scopes.len() { scope } else { program.blocks[scope - program.scopes.len()].scope }
}
fn block_within(program: &a::Program, scope: usize, owner: usize) -> bool {
    if scope < program.scopes.len() { return false; }
    let mut current = Some(scope - program.scopes.len());
    while let Some(block) = current {
        if block == owner { return true; }
        current = program.blocks[block].parent;
    }
    false
}
fn global(recovery: &Recovery) -> bool {
    matches!(recovery.kind.as_str(), "source input" | "source bundle" | "file")
}
fn poisoned(program: &a::Program, failures: &[Recovery], scope: usize, written: &str) -> Option<Failure> {
    let module = module_scope(program, scope);
    let qualified = written.contains("::");
    let mut lexical = None;
    let mut distant = None;
    for (index, failure) in failures.iter().enumerate() {
        if !failure.namespace { continue; }
        // Qualified paths can cross a poisoned intermediate alias. Until each
        // segment has a dependency record, conservatively include every nonlocal
        // poison whose spelling intersects that path.
        let local = if failure.scope >= program.scopes.len() { false }
            else if let Some(block) = failure.block { block_within(program, scope, block) }
            // Unqualified ordinary lookup stops at its own module. An
            // ancestor's imports enter only through a separate path or glob.
            else { module == failure.scope
                || program.scopes[failure.scope].path == "$std::prelude" };
        if !local && !global(failure) && failure.scope < program.scopes.len()
            && !(qualified && failure.block.is_none()) { continue; }
        let mut matches = failure.names.is_empty();
        for part in written.split("::") {
            if failure.names.iter().any(|name| name.as_str() == part) { matches = true; }
        }
        if !matches { continue; }
        if local {
            // Prefer an identified lexical binding over the fallback for a
            // wildcard or a potentially traversed alias in another module.
            if !failure.names.is_empty() { lexical = Some(index); break; }
            if lexical.is_none() { lexical = Some(index); }
        } else if distant.is_none() {
            distant = Some(index);
        }
    }
    let selected = lexical.or(distant)?;
    Some(Failure { cause: located(program, failures[selected].diagnostic.clone()),
        reason: format!("blocked name lookup {written}; refused source may change its binding") })
}
fn traced_poison(program: &a::Program, failures: &[Recovery], scope: usize, written: &str,
    reads: &[LookupRead]) -> Option<Failure> {
    if reads.is_empty() { return poisoned(program, failures, scope, written); }
    let mut wildcard = None;
    for read in reads {
        for (index, failure) in failures.iter().enumerate() {
            if !failure.namespace { continue; }
            let owner = failure.block.map(|id| program.scopes.len() + id).unwrap_or(failure.scope);
            if owner != read.owner && !global(failure) && failure.scope < program.scopes.len()
                && failure.block.is_none_or(|block| block < program.blocks.len()) { continue; }
            if failure.names.iter().any(|name| name == &read.spelling) {
                return Some(Failure { cause: located(program, failure.diagnostic.clone()),
                    reason: format!("blocked name lookup {written}; refused source may change its binding") });
            }
            if failure.names.is_empty() && wildcard.is_none() { wildcard = Some(index); }
        }
    }
    let failure = &failures[wildcard?];
    Some(Failure { cause: located(program, failure.diagnostic.clone()),
        reason: format!("blocked name lookup {written}; refused source may change its binding") })
}
fn complete_context(first: &a::Diagnostic, detail: &str) -> Failure {
    Failure { cause: first.clone(), reason: format!("complete context required: {detail}") }
}
fn scalar(name: &str) -> bool {
    matches!(name, "bool" | "char" | "str" | "u8" | "u16" | "u32" | "u64" | "usize"
        | "i8" | "i16" | "i32" | "i64" | "isize" | "f64")
}
fn attributed_span(span: a::Span, attrs: &[a::Attribute]) -> a::Span {
    if let Some(first) = attrs.first() {
        let mut extent = first.span;
        extent.end = span.end;
        extent
    } else { span }
}
fn plain_path(path: &a::Path) -> bool {
    path.qualification.is_none() && path.bindings.is_empty()
}
struct Inspector<'a> {
    program: &'a a::Program,
    resolver: &'a Resolver<'a>,
    failures: &'a [Recovery],
    first: &'a a::Diagnostic,
    ambiguous_modules: &'a BTreeSet<String>,
    recovery_owners: &'a BTreeMap<(usize, usize, usize), Option<usize>>,
}
impl<'a> Inspector<'a> {
    fn boundary(&self, detail: &str) -> Failure { complete_context(self.first, detail) }
    fn declaration_scope(&self, path: &str) -> Result<usize, Failure> {
        let scope = crate::resolve::module(self.program, path);
        if self.program.scopes[scope].path != path { return Err(self.boundary("missing declaration scope")); }
        let mut ancestor = Some(scope);
        while let Some(current) = ancestor {
            let owner = &self.program.scopes[current];
            if self.ambiguous_modules.contains(&owner.path) {
                if let Some(parent) = owner.parent {
                    let start = owner.path.rfind("::").map(|at: usize| at + 2usize).unwrap_or(0usize);
                    if let Some(failure) = poisoned(self.program, self.failures, parent, &owner.path[start..]) {
                        return Err(failure);
                    }
                }
                return Err(self.boundary("declaration scope has more than one source owner"));
            }
            ancestor = owner.parent;
        }
        Ok(scope)
    }
    fn observe(&self, scope: usize, written: &str, span: a::Span, namespace: Namespace,
        prelude: bool) -> Result<LookupTrace, Failure> {
        let trace = self.resolver.diagnostic_trace(scope, written, namespace, span, prelude)
            .map_err(|cause| Failure { cause: located(self.program, cause),
                reason: "original source lookup refused".to_string() })?;
        if let Some(failure) = traced_poison(self.program, self.failures, scope, written, &trace.reads) {
            return Err(failure);
        }
        for read in &trace.reads {
            let owner = module_scope(self.program, read.owner);
            self.declaration_scope(&self.program.scopes[owner].path)?;
            if let Some((_, a::Item::Module(index))) = &read.binding {
                let destination = self.program.modules[*index].scope;
                self.declaration_scope(&self.program.scopes[destination].path)?;
            }
        }
        Ok(trace)
    }
    fn path_trace(&self, scope: usize, path: &a::Path, span: a::Span,
        namespace: Namespace) -> Result<LookupTrace, Failure> {
        if !plain_path(path) {
            return Err(self.boundary("generic or qualified selection"));
        }
        self.observe(scope, &path.name, span, namespace, true)
    }
    fn lookup(&self, scope: usize, path: &a::Path, span: a::Span,
        namespace: Namespace) -> Result<(String, Option<a::Item>), Failure> {
        self.path_trace(scope, path, span, namespace)?.result
            .ok_or_else(|| self.boundary(&format!("unresolved input {}", path.name)))
    }
    fn record_imports(&self, reads: &[LookupRead], plan: &mut Plan) -> Result<(), Failure> {
        for read in reads {
            let Some(index) = read.import else { continue; };
            // A glob leaf can supply several independent slots in one namespace.
            if !plan.imports.insert((index, read.namespace, read.spelling.clone())) { continue; }
            let value = &self.program.uses[index];
            if value.statement.is_none() {
                return Err(self.boundary("import statement has no authored extent"));
            }
            let module = self.declaration_scope(&value.module)?;
            let scope = value.block.map(|block| self.program.scopes.len() + block).unwrap_or(module);
            let written = if value.glob {
                let target = self.resolver.diagnostic_glob_scope(scope, &value.path, value.span)
                    .map_err(|cause| Failure { cause: located(self.program, cause),
                        reason: "original glob target refused".to_string() })?;
                if target.is_none() { return Err(self.boundary("glob target needs an exact module")); }
                // Trace the exported slot, including any reexport, rather than
                // looking up a module in the member's value namespace.
                format!("{}::{}", value.path, read.spelling)
            } else { value.path.clone() };
            let trace = self.observe(scope, &written, value.span, read.namespace, false)?;
            let Some((target, item)) = trace.result else {
                return Err(self.boundary("import antecedent is unresolved"));
            };
            if !matches!(&read.binding, Some((name, expected)) if name == &target && Some(*expected) == item) {
                return Err(self.boundary("import antecedent differs from its selected slot"));
            }
            self.record_imports(&trace.reads, plan)?;
            plan.lookups.push(Lookup { span: value.span, namespace: read.namespace,
                written, result: Some((target, item)), reads: trace.reads,
                import_site: Some(index), pattern_site: false });
        }
        Ok(())
    }
    fn binding(&self, scope: usize, path: &a::Path, span: a::Span,
        namespace: Namespace, plan: &mut Plan) -> Result<Option<a::Item>, Failure> {
        let trace = self.path_trace(scope, path, span, namespace)?;
        let Some((target, item)) = trace.result else {
            return Err(self.boundary(&format!("unresolved input {}", path.name)));
        };
        let function = match item { Some(a::Item::Function(index)) => Some(index), _ => None };
        if let Some(index) = function {
            let scope = crate::resolve::module(self.program, &self.program.functions[index].module);
            if let Some(failure) = poisoned(self.program, self.failures, scope, &self.program.functions[index].name) {
                return Err(failure);
            }
        }
        self.record_imports(&trace.reads, plan)?;
        plan.lookups.push(Lookup { span, namespace, written: path.name.clone(), result: Some((target, item)),
            reads: trace.reads, import_site: None, pattern_site: false });
        Ok(item)
    }
    fn ty(&self, id: usize, plan: &mut Plan) -> Result<(), Failure> {
        let node = &self.program.types[id];
        match &node.kind {
            a::Type::Infer => { plan.structural = true; Ok(()) },
            a::Type::Never => Ok(()),
            a::Type::Tuple(parts) => {
                plan.structural = true;
                for part in parts { self.ty(*part, plan)?; } Ok(())
            }
            a::Type::Ref { inner, .. } | a::Type::Slice(inner) => {
                plan.structural = true; self.ty(*inner, plan)
            },
            a::Type::Array { inner, len } => {
                plan.structural = true;
                if len.is_empty() || !len.as_bytes().iter().all(|b| *b >= b'0' && *b <= b'9' || *b == b'_') {
                    return Err(self.boundary("array length declaration dependency"));
                }
                self.ty(*inner, plan)
            }
            a::Type::Path(path) if path.args.is_empty()
                && (scalar(&path.name) || plan.parameters.contains(&path.name)) => {
                if path.name == "str" { plan.structural = true; }
                if self.binding(node.scope, path, node.span, Namespace::Type, plan)?.is_some() {
                    return Err(self.boundary("a scalar spelling has a source declaration"));
                }
                Ok(())
            }
            _ => Err(self.boundary("nominal, generic or callable type inputs")),
        }
    }
    fn pattern(&self, id: usize, locals: &mut BTreeSet<String>, plan: &mut Plan) -> Result<(), Failure> {
        let node = &self.program.patterns[id];
        match &node.kind {
            a::Pattern::Wild | a::Pattern::Rest => Ok(()),
            a::Pattern::Bind { name, by_ref, ref_mut, .. } => {
                if *by_ref || *ref_mut { plan.structural = true; }
                let written = a::macros::source_name(name);
                if let Some(failure) = poisoned(self.program, self.failures, node.scope, written) { return Err(failure); }
                let trace = self.observe(node.scope, written, node.span, Namespace::Value, true)?;
                match &trace.result {
                    Some((_, Some(a::Item::Function(index)))) => {
                        if !plan.dependencies.contains(index) { plan.dependencies.push(*index); }
                    }
                    Some(_) => return Err(self.boundary("a binding pattern may select a source constant or constructor")),
                    None => (),
                }
                self.record_imports(&trace.reads, plan)?;
                // A reduced glob can expose a previously hidden constant. The
                // absence of a pattern binding is a dependency too.
                plan.lookups.push(Lookup { span: node.span, namespace: Namespace::Value,
                    written: written.to_string(), result: trace.result, reads: trace.reads,
                    import_site: None, pattern_site: true });
                locals.insert(name.clone()); Ok(())
            }
            a::Pattern::Tuple(parts) => {
                plan.structural = true;
                for part in parts { self.pattern(*part, locals, plan)?; } Ok(())
            }
            a::Pattern::Or(parts) => {
                for part in parts { self.pattern(*part, locals, plan)?; } Ok(())
            }
            a::Pattern::Ref { inner, .. } => {
                plan.structural = true; self.pattern(*inner, locals, plan)
            },
            a::Pattern::Literal(value) => self.expression(*value, locals, plan),
            a::Pattern::Range { start, end, .. } => {
                if let Some(value) = start { self.expression(*value, locals, plan)?; }
                if let Some(value) = end { self.expression(*value, locals, plan)?; }
                Ok(())
            }
            _ => Err(self.boundary("pattern declaration or variant inputs")),
        }
    }
    fn block(&self, id: usize, inherited: &BTreeSet<String>, plan: &mut Plan) -> Result<(), Failure> {
        let mut locals = inherited.clone();
        let block = &self.program.blocks[id];
        if self.program.uses.iter().any(|input| input.block == Some(id)) {
            // Ordinary lowering currently searches inherited locals before all
            // imports. An inner import can hide that local in Rust; do not
            // certify the wrong meaning until shared local lookup models it.
            let scope = self.program.scopes.len() + id;
            for name in inherited {
                let written = a::macros::source_name(name);
                let trace = self.observe(scope, written, block.span, Namespace::Value, true)?;
                if trace.reads.iter().any(|read| read.owner == scope && read.binding.is_some()) {
                    return Err(self.boundary("block import shadows an inherited local"));
                }
            }
        }
        if block.tail.is_none() { plan.structural = true; }
        let mut import_statements = BTreeSet::new();
        for statement in &block.statements {
            match statement {
                a::Stmt::Let { pattern, ty, value, .. } => {
                    if ty.is_none() && value.is_none() { plan.structural = true; }
                    if let Some(ty) = ty { self.ty(*ty, plan)?; }
                    if let Some(value) = value { self.expression(*value, &locals, plan)?; }
                    self.pattern(*pattern, &mut locals, plan)?;
                }
                a::Stmt::Expr { value, .. } => self.expression(*value, &locals, plan)?,
                // Exact function replay reparses these statements. Only leaves
                // observed by a lookup survive the isolated import projection.
                a::Stmt::Item(a::Item::Use(index)) => {
                    if !import_statements.insert(*index) || !self.program.uses.get(*index)
                        .is_some_and(|input| input.block == Some(id) && input.statement.is_some()) {
                        return Err(self.boundary("local import statement needs a distinct authored leaf"));
                    }
                }
                _ => return Err(self.boundary("local declarations or incomplete statement expansion")),
            }
        }
        if let Some(value) = block.tail { self.expression(value, &locals, plan)?; }
        Ok(())
    }
    fn expression(&self, id: usize, locals: &BTreeSet<String>, plan: &mut Plan) -> Result<(), Failure> {
        let node = &self.program.exprs[id];
        match &node.kind {
            a::Expr::Int(_) | a::Expr::Float(_) | a::Expr::Bool(_) | a::Expr::Char(_)
            | a::Expr::Continue => Ok(()),
            a::Expr::String(_) | a::Expr::Bytes(_) => { plan.structural = true; Ok(()) },
            a::Expr::FilePath => { plan.structural = true; Ok(()) },
            a::Expr::Tuple(parts) | a::Expr::Array(parts) => {
                plan.structural = true;
                for part in parts { self.expression(*part, locals, plan)?; } Ok(())
            }
            a::Expr::Path(path) if path.qualification.is_none() && path.args.is_empty()
                && path.bindings.is_empty() && locals.contains(&path.name) => {
                if path.name == "self" && plan.receiver.is_some_and(|index| !self.program.structs[index].unit) {
                    return Err(self.boundary("receiver use outside a direct field"));
                }
                Ok(())
            }
            a::Expr::Path(path) => {
                if !path.args.is_empty() { return Err(self.boundary("applied nonlocal value")); }
                let Some(a::Item::Constant(index)) = self.binding(node.scope, path, node.span, Namespace::Value, plan)? else {
                    return Err(self.boundary("nonlocal value is not an independent constant"));
                };
                let value = &self.program.constants[index];
                if value.owner.is_some() || !matches!(self.program.exprs[value.value].kind,
                    a::Expr::Int(_) | a::Expr::Float(_) | a::Expr::Bool(_) | a::Expr::Char(_)) {
                    return Err(self.boundary("constant initializer requires additional dependencies"));
                }
                self.declaration(a::Item::Constant(index), &value.module, &value.name, value.span, plan)?;
                self.ty(value.ty, plan)
            }
            a::Expr::Unary { op, value } => {
                if op == "*" { plan.structural = true; }
                self.expression(*value, locals, plan)
            }
            a::Expr::Diverge(value) => self.expression(*value, locals, plan),
            a::Expr::Borrow { value, .. } => { plan.structural = true; self.expression(*value, locals, plan) },
            a::Expr::Cast { value, ty } => {
                self.expression(*value, locals, plan)?; self.ty(*ty, plan)
            }
            a::Expr::Binary { left, right, .. } => {
                self.expression(*left, locals, plan)?; self.expression(*right, locals, plan)
            }
            a::Expr::Assign { place, value, .. } => {
                plan.structural = true;
                self.expression(*place, locals, plan)?; self.expression(*value, locals, plan)
            }
            a::Expr::Index { value, index } => {
                plan.structural = true;
                self.expression(*value, locals, plan)?; self.expression(*index, locals, plan)
            }
            a::Expr::Field { value, name } => {
                plan.structural = true;
                if let Some(receiver) = plan.receiver {
                    if matches!(&self.program.exprs[*value].kind, a::Expr::Path(path)
                        if plain_path(path) && path.args.is_empty() && path.name == "self") {
                        if self.program.structs[receiver].fields.iter().any(|field| &field.name == name) {
                            return Ok(());
                        }
                        return Err(self.boundary("field is outside the certified receiver"));
                    }
                }
                if name.is_empty() || !name.as_bytes().iter().all(|b| *b >= b'0' && *b <= b'9') {
                    return Err(self.boundary("nominal field selection"));
                }
                self.expression(*value, locals, plan)
            }
            a::Expr::Repeat { value, count } => {
                plan.structural = true;
                self.expression(*value, locals, plan)?; self.expression(*count, locals, plan)
            }
            a::Expr::Call { callee, args } => {
                let target = &self.program.exprs[*callee];
                let a::Expr::Path(path) = &target.kind else {
                    return Err(self.boundary("indirect callable selection"));
                };
                if locals.contains(&path.name) { return Err(self.boundary("local callable selection")); }
                for argument in &path.args { self.ty(*argument, plan)?; }
                match self.binding(target.scope, path, target.span, Namespace::Value, plan)? {
                    Some(a::Item::Function(function)) => {
                        if !plan.dependencies.contains(&function) { plan.dependencies.push(function); }
                    }
                    None if matches!(&plan.lookups.last().unwrap().result,
                        Some((target, _)) if target == crate::resolve::SCALAR_SIZE_OF) => {
                        plan.structural = true;
                    }
                    _ => return Err(self.boundary("call target is not a declared free function")),
                }
                for argument in args { self.expression(*argument, locals, plan)?; }
                Ok(())
            }
            a::Expr::Block(block) | a::Expr::Loop { body: block } => self.block(*block, locals, plan),
            a::Expr::If { condition, then_block, otherwise } => {
                if otherwise.is_none() { plan.structural = true; }
                self.expression(*condition, locals, plan)?;
                self.block(*then_block, locals, plan)?;
                if let Some(value) = otherwise { self.expression(*value, locals, plan)?; }
                Ok(())
            }
            a::Expr::While { condition, body } => {
                plan.structural = true;
                self.expression(*condition, locals, plan)?; self.block(*body, locals, plan)
            }
            a::Expr::IfLet { pattern, value, then_block, otherwise } => {
                if otherwise.is_none() { plan.structural = true; }
                self.expression(*value, locals, plan)?;
                let mut inner = locals.clone(); self.pattern(*pattern, &mut inner, plan)?;
                self.block(*then_block, &inner, plan)?;
                if let Some(value) = otherwise { self.expression(*value, locals, plan)?; }
                Ok(())
            }
            a::Expr::WhileLet { pattern, value, body } => {
                plan.structural = true;
                self.expression(*value, locals, plan)?;
                let mut inner = locals.clone(); self.pattern(*pattern, &mut inner, plan)?;
                self.block(*body, &inner, plan)
            }
            a::Expr::Match { value, arms } => {
                self.expression(*value, locals, plan)?;
                for arm in arms {
                    let mut inner = locals.clone(); self.pattern(arm.pattern, &mut inner, plan)?;
                    if let Some(guard) = arm.guard { self.expression(guard, &inner, plan)?; }
                    self.expression(arm.value, &inner, plan)?;
                }
                Ok(())
            }
            a::Expr::Return(value) | a::Expr::Break(value) => {
                if let Some(value) = value { self.expression(*value, locals, plan)?; }
                else { plan.structural = true; }
                Ok(())
            }
            _ => Err(self.boundary("macro, trait, iterator, closure or generated-helper inputs")),
        }
    }
    fn parameters(&self, function: &a::Function, plan: &mut Plan) -> Result<(), Failure> {
        if !function.predicates.is_empty() || !function.outlives.is_empty() {
            return Err(self.boundary("where-clause or outlives context"));
        }
        for parameter in &function.generics {
            if parameter.default.is_some() || parameter.constant || parameter.implicit {
                return Err(self.boundary("defaulted, constant or implicit generic parameter"));
            }
            if !parameter.lifetime { plan.parameters.push(parameter.name.clone()); }
            for bound in &parameter.bounds {
                let node = &self.program.types[*bound];
                let a::Type::Path(path) = &node.kind else {
                    return Err(self.boundary("generic bound is not a plain trait path"));
                };
                if !path.args.is_empty() || self.program.relaxed_bounds.contains(bound) {
                    return Err(self.boundary("applied or relaxed trait bound"));
                }
                match self.binding(node.scope, path, node.span, Namespace::Type, plan)? {
                    None if matches!(path.name.as_str(), "Copy" | "Sized") => {}
                    Some(a::Item::Trait(index)) => {
                        let declaration = &self.program.traits[index];
                        if !declaration.generics.is_empty() || !declaration.predicates.is_empty()
                            || !declaration.bounds.is_empty() || !declaration.methods.is_empty()
                            || !declaration.associated.is_empty() || !declaration.constants.is_empty() {
                            return Err(self.boundary("trait bound has additional declaration dependencies"));
                        }
                        self.declaration(a::Item::Trait(index), &declaration.module, &declaration.name,
                            declaration.span, plan)?;
                    }
                    _ => return Err(self.boundary("generic bound has an unproved trait contract")),
                }
            }
        }
        if !function.generics.is_empty() { plan.structural = true; }
        Ok(())
    }
    fn declaration(&self, item: a::Item, module: &str, name: &str, span: a::Span,
        plan: &mut Plan) -> Result<(), Failure> {
        if let Some(refusal) = self.overlap(span) { return Err(refusal); }
        let scope = self.declaration_scope(module)?;
        if let Some(refusal) = poisoned(self.program, self.failures, scope, name) { return Err(refusal); }
        if !plan.declarations.contains(&item) { plan.declarations.push(item); }
        Ok(())
    }
    fn overlap(&self, span: a::Span) -> Option<Failure> {
        self.failures.iter().find(|failure| intersects(span, failure.span))
            .map(|failure| Failure { cause: located(self.program, failure.diagnostic.clone()),
                reason: "the authored item overlaps a refused source region".to_string() })
    }
    fn nominal_field_type(&self, id: usize, plan: &mut Plan) -> Result<(), Failure> {
        let node = &self.program.types[id];
        if !matches!(&node.kind, a::Type::Path(path)
            if plain_path(path) && path.args.is_empty() && scalar(&path.name) && path.name != "str"
                && !self.resolver.generic(node.span, &path.name)) {
            return Err(self.boundary("receiver field needs an additional type or destructor"));
        }
        self.ty(id, plan)
    }
    fn receiver(&self, index: usize, root: usize, plan: &mut Plan) -> Result<Vec<String>, Failure> {
        let declaration = &self.program.structs[index];
        let item = a::Item::Struct(index);
        if !declaration.generics.is_empty() || !declaration.predicates.is_empty()
            || self.program.macro_expansions.iter().any(|origin| origin.items.contains(&item))
            || self.program.files[declaration.span.file].crate_root != root {
            return Err(self.boundary("receiver needs a complete nominal declaration"));
        }
        let mut derives = Vec::new();
        for attr in &declaration.attrs {
            if attr.name == "derive" && attr.args.iter().all(|name| matches!(name.as_str(),
                "Copy" | "Clone" | "PartialEq" | "Eq" | "PartialOrd" | "Ord")) {
                derives.extend_from_slice(&attr.args);
            } else if !matches!(attr.name.as_str(), "cfg" | "allow" | "doc" | "deprecated") {
                return Err(self.boundary("receiver attribute needs additional declaration evidence"));
            }
        }
        let extent = attributed_span(declaration.span, &declaration.attrs);
        self.declaration(item, &declaration.module, &declaration.name, extent, plan)?;
        for field in &declaration.fields { self.nominal_field_type(field.ty, plan)?; }
        Ok(derives)
    }
    fn trait_head(&self, id: usize) -> Option<TraitIdentity> {
        let node = &self.program.types[id];
        let a::Type::Path(path) = &node.kind else { return None; };
        if self.resolver.generic(node.span, &path.name) { return None; }
        let (target, item) = self.lookup(node.scope, path, node.span, Namespace::Type).ok()?;
        match item {
            Some(a::Item::Trait(index)) => {
                let declaration = &self.program.traits[index];
                if target == crate::names::qualified(&declaration.module, &declaration.name) {
                    return Some(TraitIdentity::Declared(index));
                }
                None
            }
            None if crate::generics::builtin_trait(&target) => Some(TraitIdentity::Builtin(target)),
            _ => None,
        }
    }
    fn trait_arguments(&self, id: usize) -> Option<Vec<String>> {
        let a::Type::Path(path) = &self.program.types[id].kind else { return None; };
        let mut arguments = Vec::new();
        for argument in &path.args {
            let node = &self.program.types[*argument];
            let a::Type::Path(path) = &node.kind else { return None; };
            if !path.args.is_empty() || self.resolver.generic(node.span, &path.name) { return None; }
            let (target, item) = self.lookup(node.scope, path, node.span, Namespace::Type).ok()?;
            if item.is_some() || !scalar(&target) || target == "str" { return None; }
            arguments.push(target);
        }
        Some(arguments)
    }
    fn trait_input(&self, id: usize, plan: &mut Plan) -> Result<(TraitIdentity, Vec<String>), Failure> {
        let node = &self.program.types[id];
        let a::Type::Path(path) = &node.kind else { return Err(self.boundary("non-path trait implementation")); };
        self.binding(node.scope, path, node.span, Namespace::Type, plan)?;
        let Some(identity) = self.trait_head(id) else {
            return Err(self.boundary("implementation needs an exact trait declaration"));
        };
        let Some(arguments) = self.trait_arguments(id) else {
            return Err(self.boundary("trait application needs closed scalar arguments"));
        };
        for argument in &path.args { self.ty(*argument, plan)?; }
        match &identity {
            TraitIdentity::Builtin(name) if name == "Drop" && arguments.is_empty() => {}
            TraitIdentity::Declared(index) => {
                let declaration = &self.program.traits[*index];
                let item = a::Item::Trait(*index);
                if !declaration.predicates.is_empty() || !declaration.bounds.is_empty()
                    || !declaration.associated.is_empty() || !declaration.constants.is_empty()
                    || self.program.macro_expansions.iter().any(|origin| origin.items.contains(&item))
                    || declaration.generics.len() != arguments.len() || declaration.generics.iter().any(|parameter|
                        parameter.lifetime || parameter.constant || parameter.implicit
                            || parameter.default.is_some() || !parameter.bounds.is_empty()) {
                    return Err(self.boundary("trait declaration needs additional contracts"));
                }
                self.declaration(item, &declaration.module, &declaration.name, declaration.span, plan)?;
                let previous = plan.parameters.len();
                plan.parameters.push("Self".to_string());
                for parameter in &declaration.generics { plan.parameters.push(parameter.name.clone()); }
                for method in &declaration.methods {
                    let method = &self.program.functions[*method];
                    if method.body.is_some() || !method.generics.is_empty() || !method.predicates.is_empty()
                        || !method.outlives.is_empty() || !method.attrs.is_empty() {
                        return Err(self.boundary("trait method needs additional declaration evidence"));
                    }
                    for parameter in &method.params { self.ty(parameter.ty, plan)?; }
                    self.ty(method.result, plan)?;
                }
                while plan.parameters.len() > previous { plan.parameters.pop(); }
            }
            _ => return Err(self.boundary("intrinsic trait implementation needs additional contracts")),
        }
        Ok((identity, arguments))
    }
    fn disjoint_receiver(&self, id: usize, receiver: &Receiver) -> bool {
        let node = &self.program.types[id];
        match &node.kind {
            a::Type::Tuple(_) | a::Type::Ref { .. } | a::Type::Slice(_) | a::Type::Array { .. }
            | a::Type::Never | a::Type::Function { .. } => true,
            a::Type::Path(path) if !self.resolver.generic(node.span, &path.name) => {
                let Ok((target, item)) = self.lookup(node.scope, path, node.span, Namespace::Type) else {
                    return false;
                };
                match item {
                    Some(a::Item::Struct(index)) if !matches!(receiver, Receiver::Struct(selected) if *selected == index) => {
                        let declaration = &self.program.structs[index];
                        target == crate::names::qualified(&declaration.module, &declaration.name)
                    }
                    Some(a::Item::Enum(index)) => {
                        let declaration = &self.program.enums[index];
                        target == crate::names::qualified(&declaration.module, &declaration.name)
                    }
                    None => crate::resolve::intrinsic_type_name(&target)
                        && !matches!(receiver, Receiver::Scalar(name) if name == &target),
                    _ => false,
                }
            }
            _ => false,
        }
    }
    fn competing(&self, implementation: &a::Impl) -> Failure {
        let mut inputs = vec![implementation.target];
        if let Some(trait_ty) = implementation.trait_ty {
            inputs.push(trait_ty);
            if let a::Type::Path(path) = &self.program.types[trait_ty].kind {
                inputs.extend_from_slice(&path.args);
            }
        }
        for input in inputs {
            let node = &self.program.types[input];
            if let a::Type::Path(path) = &node.kind {
                if let Ok(trace) = self.resolver.diagnostic_trace(node.scope, &path.name, Namespace::Type, node.span, true) {
                    if let Some(refusal) = traced_poison(self.program, self.failures, node.scope, &path.name, &trace.reads) {
                        return refusal;
                    }
                }
            }
        }
        let cause = a::Diagnostic::new(implementation.span, "E_BLOCKED",
            "implementation header may overlap the independent item closure");
        Failure { cause: located(self.program, cause),
            reason: "receiver selection or destruction needs a competing implementation".to_string() }
    }
    fn recovery_owner(&self, failure: &Recovery) -> Option<&a::Impl> {
        if failure.kind != "item" || failure.namespace { return None; }
        let span = failure.span;
        let index = self.recovery_owners.get(&(span.file, span.start, span.end)).copied().flatten()?;
        self.program.impls.get(index)
    }
    fn possibly_applicable(&self, implementation: &a::Impl, receiver: &Receiver,
        application: Option<&(TraitIdentity, Vec<String>)>, derives: &[String]) -> bool {
        if self.disjoint_receiver(implementation.target, receiver) { return false; }
        let Some(ty) = implementation.trait_ty else { return application.is_none(); };
        let Some(identity) = self.trait_head(ty) else { return true; };
        if let TraitIdentity::Builtin(name) = &identity {
            if name == "Drop" || derives.contains(name) { return true; }
        }
        if let Some((selected, arguments)) = application {
            return &identity == selected && self.trait_arguments(ty).is_none_or(|other|
                other.len() != arguments.len() || &other == arguments);
        }
        false
    }
    fn refused_coherence(&self, failure: &Recovery) -> Failure {
        Failure { cause: located(self.program, failure.diagnostic.clone()),
            reason: "implementation coherence depends on refused source".to_string() }
    }
    fn coherence(&self, owner: usize, receiver: &Receiver, application: Option<&(TraitIdentity, Vec<String>)>,
        derives: &[String], plan: &mut Plan) -> Result<(), Failure> {
        let mut destructor = None;
        for (other, implementation) in self.program.impls.iter().enumerate() {
            if other == owner || self.disjoint_receiver(implementation.target, receiver) { continue; }
            let Some(trait_ty) = implementation.trait_ty else {
                if application.is_none() { return Err(self.competing(implementation)); }
                continue;
            };
            let Some(identity) = self.trait_head(trait_ty) else { return Err(self.competing(implementation)); };
            if let Some((selected, arguments)) = application {
                if &identity == selected {
                    if self.trait_arguments(trait_ty).is_none_or(|other|
                        other.len() != arguments.len() || &other == arguments) {
                        return Err(self.competing(implementation));
                    }
                }
            }
            if let TraitIdentity::Builtin(name) = &identity {
                if derives.contains(name) { return Err(self.competing(implementation)); }
                if name == "Drop" {
                    if destructor.is_some() || implementation.methods.is_empty() {
                        return Err(self.competing(implementation));
                    }
                    destructor = Some(other);
                }
            }
        }
        if let Some(destructor) = destructor {
            let implementation = &self.program.impls[destructor];
            // The dependency must recheck the destructor as an ordinary impl.
            // An unknown receiver could instead hide an overlap.
            let node = &self.program.types[implementation.target];
            if !matches!(&node.kind, a::Type::Path(path) if path.args.is_empty()
                && matches!(self.lookup(node.scope, path, node.span, Namespace::Type),
                    Ok((_, Some(a::Item::Struct(index)))) if matches!(receiver, Receiver::Struct(selected) if *selected == index))) {
                return Err(self.competing(implementation));
            }
            for method in &implementation.methods { plan.dependencies.push(*method); }
        }
        Ok(())
    }
    fn inherent_members(&self, implementation: &a::Impl, selected: usize) -> Result<(), Failure> {
        let Some(authored) = &implementation.authored else {
            return Err(self.boundary("inherent implementation has no authored header"));
        };
        if let Some(refusal) = self.overlap(authored.header) { return Err(refusal); }
        let method = &self.program.functions[selected];
        if implementation.methods.iter().any(|other|
            *other != selected && self.program.functions[*other].name == method.name)
            || implementation.constants.iter().any(|other| self.program.constants[*other].name == method.name) {
            return Err(self.competing(implementation));
        }
        for failure in self.failures {
            if !intersects(implementation.span, failure.span) { continue; }
            // A retained sibling body cannot supply this method or its header.
            // Unknown member text and possible declaration producers still block.
            if !failure.coherence && implementation.methods.iter().any(|other| {
                *other != selected && self.program.functions[*other].body.is_some_and(|body|
                    contains(self.program.blocks[body].span, failure.span))
            }) { continue; }
            return Err(Failure { cause: located(self.program, failure.diagnostic.clone()),
                reason: "the implementation has a refused header or member boundary".to_string() });
        }
        Ok(())
    }
    fn implementation(&self, owner: usize, selected: usize, plan: &mut Plan) -> Result<(), Failure> {
        let implementation = &self.program.impls[owner];
        if implementation.trait_ty.is_none() {
            self.inherent_members(implementation, selected)?;
        } else if let Some(refusal) = self.overlap(implementation.span) { return Err(refusal); }
        // A missing implementation can change receiver selection or destruction.
        for failure in self.failures {
            if failure.coherence && self.recovery_owner(failure).is_none() {
                return Err(self.refused_coherence(failure));
            }
        }
        if !implementation.generics.is_empty() || !implementation.predicates.is_empty()
            || !implementation.associated.is_empty()
            || implementation.trait_ty.is_some() && !implementation.constants.is_empty()
            || library_scope(self.program, implementation.span.file)
            || self.program.macro_expansions.iter().any(|origin| origin.implementations.contains(&owner)) {
            return Err(self.boundary("implementation owner is not independently complete"));
        }
        let node = &self.program.types[implementation.target];
        let a::Type::Path(path) = &node.kind else { return Err(self.boundary("non-nominal receiver")); };
        if !path.args.is_empty() { return Err(self.boundary("applied receiver type")); }
        let binding = self.binding(node.scope, path, node.span, Namespace::Type, plan)?;
        let target = plan.lookups.last().unwrap().result.as_ref().unwrap().0.clone();
        let (receiver, derives) = match binding {
            Some(a::Item::Struct(index)) => {
                let declaration = &self.program.structs[index];
                if target != crate::names::qualified(&declaration.module, &declaration.name) {
                    return Err(self.boundary("receiver path has an unexpected suffix"));
                }
                let root = self.program.files[implementation.span.file].crate_root;
                (Receiver::Struct(index), self.receiver(index, root, plan)?)
            }
            None if scalar(&target) && target != "str" && implementation.trait_ty.is_some()
                && !self.resolver.generic(node.span, &path.name) =>
                (Receiver::Scalar(target), Vec::new()),
            _ => return Err(self.boundary("implementation receiver needs a source struct or scalar trait application")),
        };
        let application = if let Some(trait_ty) = implementation.trait_ty {
            Some(self.trait_input(trait_ty, plan)?)
        } else { None };
        if matches!(receiver, Receiver::Scalar(_))
            && !matches!(&application, Some((TraitIdentity::Declared(_), _))) {
            return Err(self.boundary("scalar receiver needs a declared trait"));
        }
        for failure in self.failures {
            if failure.coherence && self.recovery_owner(failure).is_some_and(|owner|
                self.possibly_applicable(owner, &receiver, application.as_ref(), &derives)) {
                return Err(self.refused_coherence(failure));
            }
        }
        self.coherence(owner, &receiver, application.as_ref(), &derives, plan)?;
        plan.parameters.push("Self".to_string());
        plan.implementation = Some(owner);
        if let Receiver::Struct(index) = receiver { plan.receiver = Some(index); }
        plan.structural = true;
        Ok(())
    }
    fn expansions(&self, function: &a::Function, plan: &mut Plan) -> Result<(), Failure> {
        let scope = crate::resolve::module(self.program, &function.module);
        let crate_root = self.program.scopes[scope].crate_root;
        for (call, invocation) in self.program.macro_invocations.iter().enumerate() {
            if invocation.parent.is_some() || !contains(function.span, invocation.span) { continue; }
            if invocation.position != a::macros::MacroPosition::Expression
                || invocation.name.contains("::") || invocation.scope != scope
                || !self.program.macro_providers.is_empty() {
                return Err(self.boundary("macro selection has nonlocal or item dependencies"));
            }
            for failure in self.failures {
                if global(failure) || (failure.scope < self.program.scopes.len()
                    && self.program.scopes[failure.scope].crate_root == crate_root
                    && (failure.namespace && failure.block.is_none()
                        || failure.kind == "macro definition" && failure.names.contains(&invocation.name))) {
                    return Err(Failure { cause: located(self.program, failure.diagnostic.clone()),
                        reason: "macro selection depends on refused source".to_string() });
                }
            }
            let Some(index) = self.program.macro_expansions.iter().position(|origin| origin.invocation == call) else {
                return Err(self.boundary("macro invocation has no complete expansion"));
            };
            let origin = &self.program.macro_expansions[index];
            let definition = &self.program.macro_definitions[origin.definition];
            if definition.exported || definition.scope != scope || definition.span.file != function.span.file
                || self.program.macro_expansions.iter().any(|nested| nested.parent == Some(index)) {
                return Err(self.boundary("macro expansion has external or nested producer dependencies"));
            }
            if let Some(refusal) = self.overlap(definition.span) { return Err(refusal); }
            plan.expansions.push(index);
        }
        Ok(())
    }
    fn function(&self, index: usize) -> Result<Plan, Failure> {
        let f = &self.program.functions[index];
        if let Some(refusal) = self.overlap(f.span) { return Err(refusal); }
        let scope = self.declaration_scope(&f.module)?;
        if let Some(failure) = poisoned(self.program, self.failures, scope, &f.name) { return Err(failure); }
        if self.program.traits.iter().any(|owner| owner.methods.contains(&index)) {
            return Err(self.boundary("method ownership and coherence"));
        }
        for (other, owner) in self.program.functions.iter().enumerate() {
            if other != index && contains(owner.span, f.span) {
                return Err(self.boundary("nested function declaration context"));
            }
        }
        if self.program.macro_expansions.iter().any(|origin| origin.functions.contains(&index))
            || self.program.macro_invocations.iter().any(|call| contains(call.span, f.span)) {
            return Err(self.boundary("generated function ownership"));
        }
        let mut plan = Plan::default();
        self.parameters(f, &mut plan)?;
        self.expansions(f, &mut plan)?;
        if let Some(owner) = self.program.impls.iter().position(|owner| owner.methods.contains(&index)) {
            self.implementation(owner, index, &mut plan)?;
            let implementation = &self.program.impls[owner];
            if implementation.trait_ty.is_some() {
                for method in &implementation.methods {
                    if *method != index && !plan.dependencies.contains(method) { plan.dependencies.push(*method); }
                }
            }
        }
        let nominal = plan.receiver.is_some_and(|index| !self.program.structs[index].unit);
        if nominal {
            let Some(param) = f.params.first() else { return Err(self.boundary("nominal method needs a borrowed receiver")); };
            if !(param.name == "self"
                && matches!(&self.program.types[param.ty].kind, a::Type::Ref { inner, .. }
                    if matches!(&self.program.types[*inner].kind, a::Type::Path(path)
                        if plain_path(path) && path.args.is_empty() && path.name == "Self"))) {
                return Err(self.boundary("nominal method needs a borrowed receiver"));
            }
            self.ty(param.ty, &mut plan)?;
            plan.parameters.pop();
        }
        let mut locals = BTreeSet::new();
        for (offset, parameter) in f.params.iter().enumerate() {
            if !nominal || offset != 0usize { self.ty(parameter.ty, &mut plan)?; }
            locals.insert(parameter.name.clone());
        }
        self.ty(f.result, &mut plan)?;
        let Some(body) = f.body else { return Err(self.boundary("function body is absent")); };
        self.block(body, &locals, &mut plan)?;
        Ok(plan)
    }
}
fn library_scope(program: &a::Program, file: usize) -> bool {
    let root = program.files[file].crate_root;
    program.scopes.get(root).is_some_and(|scope| scope.path == "$std")
}
fn user_function(program: &a::Program, index: usize) -> bool {
    let f = &program.functions[index];
    f.body.is_some() && !library_scope(program, f.span.file)
}
fn append_problem(problems: &mut Vec<a::Diagnostic>, problem: a::Diagnostic) {
    if !problems.contains(&problem) { problems.push(problem); }
}
fn import_failures(program: &a::Program, problems: &[(usize, a::Diagnostic)], inherited: &BTreeSet<usize>,
    failures: &mut Vec<Recovery>) {
    for (index, problem) in problems {
        if inherited.contains(index) { continue; }
        let item = &program.uses[*index];
        let names = if item.glob { Vec::new() } else { vec![item.alias.clone()] };
        failures.push(Recovery { span: item.span,
            scope: crate::resolve::module(program, &item.module), block: item.block,
            kind: "import".to_string(), names, namespace: true, coherence: false,
            diagnostic: located(program, problem.clone()) });
    }
}
// A surviving import can depend on a refused alias at any path segment.
// Propagate that exact cause before considering a caller's final spelling.
fn propagate_import_poison(program: &a::Program, resolver: &Resolver<'_>,
    failures: &mut Vec<Recovery>, marked: &mut BTreeSet<usize>) {
    loop {
        let mut changed = false;
        for (index, item) in program.uses.iter().enumerate() {
            if marked.contains(&index) { continue; }
            let scope = crate::resolve::module(program, &item.module);
            let lookup_scope = match item.block { Some(block) => program.scopes.len() + block, None => scope };
            let mut cause = None;
            for slot in 0usize..2usize {
                let namespace = if slot == 0usize { Namespace::Type } else { Namespace::Value };
                if let Ok(trace) = resolver.diagnostic_trace(lookup_scope, &item.path, namespace, item.span, false) {
                    cause = traced_poison(program, failures, lookup_scope, &item.path, &trace.reads)
                        .map(|failure| failure.cause);
                    if cause.is_some() { break; }
                }
            }
            if cause.is_none() && item.glob {
                // A glob can depend on refused members even when the module
                // binding itself is intact. Propagate before checking a use.
                if let Ok(Some(target)) = resolver.diagnostic_glob_scope(lookup_scope, &item.path, item.span) {
                    cause = failures.iter().find(|failure| failure.namespace
                        && failure.scope == target && failure.block.is_none())
                        .map(|failure| failure.diagnostic.clone());
                }
            }
            if let Some(diagnostic) = cause {
                let names = if item.glob { Vec::new() } else { vec![item.alias.clone()] };
                failures.push(Recovery { span: item.span, scope, block: item.block,
                    kind: "dependent import".to_string(), names, namespace: true, coherence: false,
                    diagnostic });
                marked.insert(index); changed = true;
            }
        }
        if !changed { break; }
    }
}
fn closure(root: usize, plans: &[Option<Plan>], failures: &[Option<Failure>],
    first: &a::Diagnostic) -> Result<Vec<usize>, Failure> {
    let mut pending = vec![root];
    let mut seen = BTreeSet::new();
    let mut result = Vec::new();
    while let Some(index) = pending.pop() {
        if !seen.insert(index) { continue; }
        if let Some(failure) = &failures[index] { return Err(failure.clone()); }
        let Some(plan) = &plans[index] else { return Err(complete_context(first, "callee contract outside the independent population")); };
        result.push(index);
        for dependency in &plan.dependencies { pending.push(*dependency); }
    }
    result.sort(); Ok(result)
}
fn parse_extents(source: &SourceReport, projected: &mut a::Program, spans: &[a::Span],
    module: &str) -> Result<Vec<a::Item>, String> {
    let Some(first) = spans.first() else { return Err("source replay has no extents".to_string()); };
    let file = first.file;
    let Some(text) = source.texts.get(file) else { return Err("source text is absent".to_string()); };
    let mut bytes = text.as_bytes().to_vec();
    let mut end = 0usize;
    for span in spans {
        if span.file != file || span.start < end || span.end > bytes.len() || span.start >= span.end {
            return Err("source span is outside its input or out of order".to_string());
        }
        for at in end..span.start {
            if bytes[at] != b'\n' && bytes[at] != b'\r' { bytes[at] = b' '; }
        }
        end = span.end;
    }
    for at in end..bytes.len() {
        if bytes[at] != b'\n' && bytes[at] != b'\r' { bytes[at] = b' '; }
    }
    let text = String::from_utf8(bytes).map_err(|_| -> String { "source projection is not UTF-8".to_string() })?;
    let scope = crate::resolve::module(projected, module);
    let parsed = crate::syntax::parse_file_report(projected, &text, file, scope);
    if !parsed.diagnostics.is_empty() || !parsed.recovery.is_empty() {
        return Err("authored source replay refused".to_string());
    }
    Ok(parsed.items)
}
fn parse_extent(source: &SourceReport, projected: &mut a::Program, span: a::Span,
    module: &str) -> Result<Vec<a::Item>, String> {
    parse_extents(source, projected, &[span], module)
}
fn replay_members(original: &a::Program, projected: &mut a::Program, before: usize,
    members: &[usize], source_indices: &mut Vec<usize>, inside_owner: bool) -> Result<(), String> {
    if projected.functions.len() != before + members.len() {
        return Err("authored function population changed during replay".to_string());
    }
    for (offset, member) in members.iter().enumerate() {
        let f = &original.functions[*member];
        let next = &mut projected.functions[before + offset];
        if next.name != f.name || next.module != f.module || next.span != f.span
            || next.const_qualified != f.const_qualified || next.body.is_some() != f.body.is_some()
            || inside_owner && (next.public != f.public || next.attrs != f.attrs) {
            return Err("authored function identity changed during replay".to_string());
        }
        if !inside_owner { next.public = f.public; next.attrs = f.attrs.clone(); }
        source_indices.push(*member);
    }
    Ok(())
}
fn replay_item(source: &SourceReport, original: &a::Program, projected: &mut a::Program,
    item: a::Item, source_indices: &mut Vec<usize>) -> Result<(), String> {
    let before = projected.functions.len();
    let (span, module, expected) = match item {
        a::Item::Struct(index) => {
            let value = &original.structs[index];
            (attributed_span(value.span, &value.attrs), value.module.as_str(), a::Item::Struct(projected.structs.len()))
        }
        a::Item::Trait(index) => {
            let value = &original.traits[index];
            (value.span, value.module.as_str(), a::Item::Trait(projected.traits.len()))
        }
        a::Item::Constant(index) => {
            let value = &original.constants[index];
            (value.span, value.module.as_str(), a::Item::Constant(projected.constants.len()))
        }
        _ => return Err("item has no independent declaration replay".to_string()),
    };
    if parse_extent(source, projected, span, module)? != vec![expected] {
        return Err("authored declaration changed during replay".to_string());
    }
    match (item, expected) {
        (a::Item::Struct(original_id), a::Item::Struct(id)) => {
            let value = &original.structs[original_id];
            if projected.structs[id].span != value.span || projected.structs[id].attrs != value.attrs {
                return Err("receiver declaration changed during replay".to_string());
            }
            projected.structs[id].public = value.public;
        }
        (a::Item::Trait(original_id), a::Item::Trait(id)) => {
            let value = &original.traits[original_id];
            if projected.traits[id].span != value.span || projected.traits[id].methods.len() != value.methods.len() {
                return Err("trait declaration changed during replay".to_string());
            }
            projected.traits[id].public = value.public;
            replay_members(original, projected, before, &value.methods, source_indices, true)?;
        }
        (a::Item::Constant(original_id), a::Item::Constant(id)) =>
            projected.constants[id].public = original.constants[original_id].public,
        _ => return Err("authored declaration kind changed during replay".to_string()),
    }
    projected.items.push(expected);
    Ok(())
}
fn same_item(expected: Option<a::Item>, actual: Option<a::Item>,
    original: &a::Program, replayed: &a::Program, source_indices: &[usize]) -> bool {
    match (expected, actual) {
        (None, None) => true,
        (Some(a::Item::Function(a)), Some(a::Item::Function(b))) =>
            Some(a) == source_indices.get(b).copied(),
        (Some(a::Item::Struct(a)), Some(a::Item::Struct(b))) =>
            original.structs[a].span == replayed.structs[b].span,
        (Some(a::Item::Trait(a)), Some(a::Item::Trait(b))) =>
            original.traits[a].span == replayed.traits[b].span,
        (Some(a::Item::Constant(a)), Some(a::Item::Constant(b))) =>
            original.constants[a].span == replayed.constants[b].span,
        (Some(a::Item::Module(a)), Some(a::Item::Module(b))) =>
            original.modules[a].scope == replayed.modules[b].scope
                && original.modules[a].span == replayed.modules[b].span,
        _ => false,
    }
}
fn same_lexical_scope(original: &a::Program, mut left: usize,
    replayed: &a::Program, mut right: usize) -> bool {
    loop {
        let left_module = left < original.scopes.len();
        let right_module = right < replayed.scopes.len();
        if left_module || right_module {
            return left_module && right_module && left == right
                && original.scopes[left].path == replayed.scopes[right].path;
        }
        let expected = &original.blocks[left - original.scopes.len()];
        let actual = &replayed.blocks[right - replayed.scopes.len()];
        if expected.scope != actual.scope || expected.span != actual.span { return false; }
        left = expected.parent.map(|block| original.scopes.len() + block).unwrap_or(expected.scope);
        right = actual.parent.map(|block| replayed.scopes.len() + block).unwrap_or(actual.scope);
    }
}
fn same_use(left: &a::Use, right: &a::Use, original: &a::Program, replayed: &a::Program) -> bool {
    let mut expected = left.clone();
    expected.block = right.block;
    expected == *right && match (left.block, right.block) {
        (None, None) => true,
        (Some(left), Some(right)) => same_lexical_scope(original, original.scopes.len() + left,
            replayed, replayed.scopes.len() + right),
        _ => false,
    }
}
fn same_import(left: Option<usize>, right: Option<usize>, original: &a::Program,
    replayed: &a::Program) -> bool {
    match (left, right) {
        (None, None) => true,
        (Some(left), Some(right)) => same_use(&original.uses[left], &replayed.uses[right], original, replayed),
        _ => false,
    }
}
fn same_binding(lookup: &Lookup, actual: LookupTrace,
    original: &a::Program, replayed: &a::Program, source_indices: &[usize]) -> bool {
    match (&lookup.result, &actual.result) {
        (None, None) => (),
        (Some((target, item)), Some((actual, replayed_item))) if target == actual
            && same_item(*item, *replayed_item, original, replayed, source_indices) => (),
        _ => return false,
    }
    if actual.reads.len() != lookup.reads.len() { return false; }
    for (position, left) in lookup.reads.iter().enumerate() {
        let right = &actual.reads[position];
        if left.spelling != right.spelling || left.namespace != right.namespace
            || left.visibility != right.visibility
            || !same_lexical_scope(original, left.owner, replayed, right.owner)
            || !same_import(left.import, right.import, original, replayed) {
            return false;
        }
        match (&left.binding, &right.binding) {
            (None, None) => (),
            (Some((name, item)), Some((actual, replayed_item))) if name == actual
                && same_item(Some(*item), Some(*replayed_item), original, replayed, source_indices) => (),
            _ => return false,
        }
    }
    true
}
fn replay_imports(source: &SourceReport, original: &a::Program, projected: &mut a::Program,
    selected: &BTreeSet<usize>) -> Result<(), String> {
    let mut statements = BTreeSet::new();
    for index in selected {
        let input = &original.uses[*index];
        if input.block.is_some() { continue; }
        let Some(statement) = input.statement else { return Err("import statement is unavailable".to_string()); };
        if !statements.insert((statement.file, statement.start, statement.end)) { continue; }
        let before = projected.uses.len();
        if parse_extent(source, projected, statement, &input.module)? != vec![a::Item::Use(before)] {
            return Err("authored import did not replay as one statement".to_string());
        }
        let leaves = projected.uses[before..].to_vec();
        let mut offset = 0usize;
        while projected.uses.len() > before { projected.uses.pop(); }
        for (item, original) in original.uses.iter().enumerate() {
            if original.statement != Some(statement) || original.module != input.module { continue; }
            let Some(leaf) = leaves.get(offset) else { return Err("import leaf is absent in replay".to_string()); };
            if leaf != original { return Err("authored import leaf changed during replay".to_string()); }
            if selected.contains(&item) { projected.uses.push(leaf.clone()); }
            offset += 1usize;
        }
        if offset != leaves.len() { return Err("unexpected leaf in replayed import".to_string()); }
        projected.items.push(a::Item::Use(before));
    }
    Ok(())
}
// Whole-function parsing retains every local use-tree leaf. Authenticate those
// leaves before selecting the dependency slice, including unused grouped siblings.
// No runtime statement is removed, and every surviving lookup is compared below.
fn select_local_imports(original: &a::Program, projected: &mut a::Program,
    selected: &BTreeSet<usize>) -> Result<(), String> {
    let mut replacements: Vec<Option<usize>> = vec![None; projected.uses.len()];
    let mut retained = Vec::new();
    let mut seen = BTreeSet::new();
    let mut start = 0usize;
    while start < projected.uses.len() {
        let first = &projected.uses[start];
        let mut end = start + 1usize;
        while end < projected.uses.len() && projected.uses[end].statement == first.statement
            && projected.uses[end].module == first.module && projected.uses[end].block == first.block {
            end += 1usize;
        }
        let before = retained.len();
        for index in start..end {
            let input = &projected.uses[index];
            let mut source = None;
            for (id, expected) in original.uses.iter().enumerate() {
                if same_use(expected, input, original, projected) {
                    if source.is_some() { return Err("replayed import has ambiguous source ownership".to_string()); }
                    source = Some(id);
                }
            }
            let Some(source) = source else { return Err("local import leaf changed during replay".to_string()); };
            if !seen.insert(source) { return Err("authored import leaf replayed more than once".to_string()); }
            if selected.contains(&source) { retained.push(input.clone()); }
        }
        if retained.len() != before {
            for index in start..end { replacements[index] = Some(before); }
        }
        start = end;
    }
    if selected.iter().any(|index| !seen.contains(index)) {
        return Err("selected import is absent from its authored owner".to_string());
    }
    projected.uses = retained;
    let items = projected.items.clone();
    projected.items.clear();
    for item in items {
        if let a::Item::Use(index) = item {
            if index >= replacements.len() { return Err("import item has no replayed leaf".to_string()); }
            if let Some(next) = replacements[index] { projected.items.push(a::Item::Use(next)); }
        } else { projected.items.push(item); }
    }
    for id in 0usize..projected.blocks.len() {
        let block = &mut projected.blocks[id];
        let statements = block.statements.clone();
        block.statements.clear();
        for statement in statements {
            if let a::Stmt::Item(a::Item::Use(index)) = statement {
                if index >= replacements.len() { return Err("local import statement has no replayed leaf".to_string()); }
                if let Some(next) = replacements[index] { block.statements.push(a::Stmt::Item(a::Item::Use(next))); }
            } else { block.statements.push(statement); }
        }
    }
    Ok(())
}
fn replay_expansion_inputs(source: &SourceReport, original: &a::Program, projected: &mut a::Program,
    expansions: &[usize]) -> Result<(), String> {
    let mut definitions = BTreeSet::new();
    for index in expansions {
        let definition = original.macro_expansions[*index].definition;
        if !definitions.insert(definition) { continue; }
        let old = &original.macro_definitions[definition];
        let before = projected.macro_definitions.len();
        if !parse_extent(source, projected, old.span, &original.scopes[old.scope].path)?.is_empty()
            || projected.macro_definitions.len() != before + 1usize
            || projected.macro_definitions[before] != *old {
            return Err("macro definition changed during exact replay".to_string());
        }
    }
    Ok(())
}
fn same_expansions(original: &a::Program, projected: &a::Program, expected: &[usize]) -> bool {
    if expected.len() != projected.macro_expansions.len() { return false; }
    for index in expected {
        let old = &original.macro_expansions[*index];
        let call = &original.macro_invocations[old.invocation];
        let mut matches = 0usize;
        for origin in &projected.macro_expansions {
            let invocation = &projected.macro_invocations[origin.invocation];
            if invocation.span == call.span && invocation.name_span == call.name_span
                && invocation.name == call.name && invocation.destination == call.destination
                && invocation.position == call.position
                && invocation.tokens == call.tokens && origin.parent.is_none() && origin.rule == old.rule
                && projected.macro_definitions[origin.definition] == original.macro_definitions[old.definition] {
                matches += 1usize;
            }
        }
        if matches != 1usize { return false; }
    }
    true
}
fn replay_implementation(source: &SourceReport, projected: &mut a::Program,
    implementation: &a::Impl, selected: &[usize]) -> Result<Vec<usize>, String> {
    let Some(authored) = &implementation.authored else {
        return Err("implementation has no authored source extent".to_string());
    };
    let id = projected.impls.len();
    let mut syntax = a::ImplSyntax { header: authored.header, close: authored.close,
        methods: Vec::new(), refused_members: Vec::new() };
    let mut members = Vec::new();
    let parsed = if implementation.trait_ty.is_some() {
        let mut extent = authored.header;
        extent.end = authored.close.end;
        syntax.methods = authored.methods.clone();
        members = implementation.methods.clone();
        parse_extent(source, projected, extent, &implementation.module)?
    } else {
        if authored.methods.len() != implementation.methods.len() {
            return Err("implementation member extents are incomplete".to_string());
        }
        let mut spans = vec![authored.header];
        for (offset, method) in implementation.methods.iter().enumerate() {
            if selected.contains(method) {
                let span = authored.methods[offset];
                spans.push(span);
                syntax.methods.push(span);
                members.push(*method);
            }
        }
        spans.push(authored.close);
        parse_extents(source, projected, &spans, &implementation.module)?
    };
    if parsed != vec![a::Item::Impl(id)] || projected.impls[id].authored != Some(syntax)
        || projected.impls[id].span != implementation.span {
        return Err("authored implementation header or member extent changed during replay".to_string());
    }
    projected.items.push(a::Item::Impl(id));
    Ok(members)
}
fn replay(source: &SourceReport, original: &a::Program, selected: &[usize],
    plans: &[Option<Plan>]) -> Result<a::Program, String> {
    let mut projected = a::Program::default();
    projected.configuration = original.configuration;
    projected.files = original.files.clone();
    projected.scopes = original.scopes.clone();
    projected.loaded_modules = original.loaded_modules.clone();
    let mut scopes = BTreeSet::new();
    let mut declarations = Vec::new();
    let mut expansions = Vec::new();
    let mut imports = BTreeSet::new();
    let mut modules: Vec<String> = selected.iter().map(|index| original.functions[*index].module.clone()).collect();
    for index in selected {
        let plan = plans[*index].as_ref().unwrap();
        for declaration in &plan.declarations {
            if !declarations.contains(declaration) { declarations.push(*declaration); }
        }
        for expansion in &plan.expansions { expansions.push(*expansion); }
        for (input, _, _) in &plan.imports { imports.insert(*input); }
        for lookup in &plan.lookups {
            for read in &lookup.reads {
                modules.push(original.scopes[module_scope(original, read.owner)].path.clone());
                if let Some((_, a::Item::Module(index))) = &read.binding {
                    modules.push(original.scopes[original.modules[*index].scope].path.clone());
                }
            }
        }
    }
    for item in &declarations {
        match item {
            a::Item::Struct(index) => modules.push(original.structs[*index].module.clone()),
            a::Item::Trait(index) => modules.push(original.traits[*index].module.clone()),
            a::Item::Constant(index) => modules.push(original.constants[*index].module.clone()),
            _ => {}
        }
    }
    for module in &modules {
        let mut scope = Some(crate::resolve::module(original, module));
        while let Some(current) = scope { scopes.insert(current); scope = original.scopes[current].parent; }
    }
    for module in &original.modules {
        if scopes.contains(&module.scope) {
            let mut module = module.clone(); module.items.clear(); module.external = false;
            let index = projected.modules.len();
            projected.modules.push(module); projected.items.push(a::Item::Module(index));
        }
    }
    let mut source_indices = Vec::new();
    for item in declarations { replay_item(source, original, &mut projected, item, &mut source_indices)?; }
    replay_imports(source, original, &mut projected, &imports)?;
    replay_expansion_inputs(source, original, &mut projected, &expansions)?;
    let mut implementations = BTreeSet::new();
    for index in selected {
        let f = &original.functions[*index];
        let before = projected.functions.len();
        let owner = plans[*index].as_ref().unwrap().implementation;
        let members = if let Some(owner) = owner {
            if !implementations.insert(owner) { continue; }
            replay_implementation(source, &mut projected, &original.impls[owner], selected)?
        } else {
            if parse_extent(source, &mut projected, f.span, &f.module)? != vec![a::Item::Function(before)] {
                return Err("authored function replay did not yield one complete item".to_string());
            }
            projected.items.push(a::Item::Function(before));
            vec![*index]
        };
        replay_members(original, &mut projected, before, &members, &mut source_indices, owner.is_some())?;
    }
    crate::syntax::macros::expand(&mut projected).map_err(|_| -> String { "isolated source expansion refused".to_string() })?;
    if !same_expansions(original, &projected, &expansions) {
        return Err("macro invocation, token provenance or selected rule changed during replay".to_string());
    }
    if projected.scopes.len() != original.scopes.len() {
        return Err("source replay changed the module scope population".to_string());
    }
    select_local_imports(original, &mut projected, &imports)?;
    crate::resolve::bind_lexical_scopes(&mut projected);
    let resolved = crate::resolve::resolve(&projected).map_err(|_| -> String { "isolated declaration lookup refused".to_string() })?;
    let names = Resolver::new(&resolved).map_err(|_| -> String { "isolated declaration catalog refused".to_string() })?;
    for index in selected {
        let plan = plans[*index].as_ref().unwrap();
        for lookup in &plan.lookups {
            if let Some(import) = lookup.import_site {
                let value = &original.uses[import];
                let mut owner = None;
                for input in &resolved.uses {
                    if same_use(value, input, original, &resolved) {
                        if owner.is_some() { return Err("import replay has ambiguous lexical ownership".to_string()); }
                        let module = crate::resolve::module(&resolved, &input.module);
                        owner = Some(input.block.map(|block| resolved.scopes.len() + block).unwrap_or(module));
                    }
                }
                let Some(scope) = owner else { return Err("import replay lost its lexical owner".to_string()); };
                let actual = names.diagnostic_trace(scope, &lookup.written, lookup.namespace, lookup.span, false)
                    .map_err(|_| -> String { "replayed import antecedent refused".to_string() })?;
                if !same_binding(lookup, actual, original, &resolved, &source_indices) {
                    return Err("import antecedent changed during replay".to_string());
                }
                continue;
            }
            let mut matched = false;
            if lookup.pattern_site {
                for node in &projected.patterns {
                    if node.span == lookup.span {
                        if let a::Pattern::Bind { name, .. } = &node.kind {
                            if a::macros::source_name(name) == lookup.written.as_str() {
                                let actual = names.diagnostic_trace(node.scope, &lookup.written, Namespace::Value, node.span, true)
                                    .map_err(|_| -> String { "replayed pattern lookup refused".to_string() })?;
                                if !same_binding(lookup, actual, original, &resolved, &source_indices) {
                                    return Err("a recorded pattern binding changed during replay".to_string());
                                }
                                matched = true;
                            }
                        }
                    }
                }
            } else if lookup.namespace == Namespace::Type {
                for node in &projected.types {
                    if node.span == lookup.span {
                        if let a::Type::Path(path) = &node.kind {
                            if path.name == lookup.written {
                                let actual = names.diagnostic_trace(node.scope, &path.name, Namespace::Type, node.span, true)
                                    .map_err(|_| -> String { "replayed type lookup refused".to_string() })?;
                                if !same_binding(lookup, actual, original, &resolved, &source_indices) {
                                    return Err("a recorded source type binding changed during replay".to_string());
                                }
                                matched = true;
                            }
                        }
                    }
                }
            } else {
                for node in &projected.exprs {
                    if node.span == lookup.span {
                        if let a::Expr::Path(path) = &node.kind {
                            if path.name == lookup.written {
                                let actual = names.diagnostic_trace(node.scope, &path.name, Namespace::Value, node.span, true)
                                    .map_err(|_| -> String { "replayed call lookup refused".to_string() })?;
                                if !same_binding(lookup, actual, original, &resolved, &source_indices) {
                                    return Err("a recorded source value binding changed during replay".to_string());
                                }
                                matched = true;
                            }
                        }
                    }
                }
            }
            if !matched { return Err("a recorded source binding changed during isolated replay".to_string()); }
        }
    }
    drop(names);
    Ok(resolved)
}
fn owns_problem(source: &SourceReport, span: a::Span, problem: &a::Diagnostic) -> bool {
    if span.file != problem.file { return false; }
    let Some(text) = source.texts.get(span.file) else { return false; };
    let mut line = 1usize; let mut column = 1usize;
    let mut offset = 0usize;
    while offset < text.len() && (line < problem.line || line == problem.line && column < problem.column) {
        if text.as_bytes()[offset] == b'\n' { line += 1usize; column = 1usize; } else { column += 1usize; }
        offset += 1usize;
    }
    span.start <= offset && offset < span.end
}
pub(crate) fn retained_body_failure(source: &SourceReport, problems: &[a::Diagnostic]) -> bool {
    let program = &source.program;
    for implementation in &program.impls {
        if implementation.trait_ty.is_some() || implementation.authored.is_none()
            || implementation.methods.len() < 2usize || library_scope(program, implementation.span.file) {
            continue;
        }
        for method in &implementation.methods {
            if let Some(body) = program.functions[*method].body {
                let span = program.blocks[body].span;
                if problems.iter().any(|problem| owns_problem(source, span, problem)) { return true; }
            }
        }
    }
    false
}
fn string(out: &mut Vec<u8>, value: &str) { crate::json::write_string(out, value); }
fn diagnostic(out: &mut Vec<u8>, value: &a::Diagnostic) {
    out.extend_from_slice(b"{\"path\":"); string(out, &value.path);
    out.extend_from_slice(format!(",\"line\":{},\"column\":{},\"code\":", value.line, value.column).as_bytes());
    string(out, &value.code); out.extend_from_slice(b",\"message\":"); string(out, &value.message); out.push(b'}');
}
fn finish(program: &a::Program, records: Vec<Record>, failures: &[Recovery], problems: Vec<a::Diagnostic>) -> Report {
    let mut checked = 0usize; let mut blocked = 0usize; let mut rejected = 0usize;
    for row in &records {
        match row.status.as_str() { "checked" => checked += 1usize, "rejected" => rejected += 1usize, _ => blocked += 1usize }
    }
    let mut out = format!("LKJSCRIPT_ITEMS {{\"schema\":1,\"checked\":{checked},\"blocked\":{blocked},\"rejected\":{rejected},\"items\":[").into_bytes();
    for (at, row) in records.iter().enumerate() {
        if at != 0usize { out.push(b','); }
        let f = &program.functions[row.function];
        out.extend_from_slice(b"{\"id\":"); string(&mut out, &id(program, row.function));
        out.extend_from_slice(b",\"path\":"); string(&mut out, &program.files[f.span.file].path);
        out.extend_from_slice(format!(",\"line\":{},\"column\":{},\"start\":{},\"end\":{},\"name\":", f.span.line, f.span.column, f.span.start, f.span.end).as_bytes());
        string(&mut out, &name(program, row.function));
        out.extend_from_slice(b",\"status\":"); string(&mut out, &row.status);
        out.extend_from_slice(b",\"cause\":");
        if let Some(failure) = &row.failure { diagnostic(&mut out, &failure.cause); } else { out.extend_from_slice(b"null"); }
        out.extend_from_slice(b",\"reason\":");
        let reason = match &row.failure { Some(failure) => failure.reason.clone(),
            None => "ordinary checked independent function closure".to_string() };
        string(&mut out, &reason);
        out.extend_from_slice(b",\"dependencies\":[");
        for (at, dependency) in row.dependencies.iter().enumerate() {
            if at != 0usize { out.push(b','); } string(&mut out, &id(program, *dependency));
        }
        out.extend_from_slice(b"]}");
    }
    out.extend_from_slice(b"],\"tombstones\":[");
    for (at, failure) in failures.iter().enumerate() {
        if at != 0usize { out.push(b','); }
        out.extend_from_slice(format!("{{\"scope\":{},\"block\":", failure.scope).as_bytes());
        if let Some(block) = failure.block { out.extend_from_slice(format!("{block}").as_bytes()); } else { out.extend_from_slice(b"null"); }
        out.extend_from_slice(b",\"kind\":"); string(&mut out, &failure.kind);
        out.extend_from_slice(b",\"path\":");
        let path = if global(failure) || failure.span.file >= program.files.len() { "" }
            else { program.files[failure.span.file].path.as_str() };
        string(&mut out, path);
        out.extend_from_slice(format!(",\"line\":{},\"column\":{},\"module\":", failure.span.line, failure.span.column).as_bytes());
        let module = if failure.scope < program.scopes.len() { program.scopes[failure.scope].path.as_str() } else { "" };
        string(&mut out, module);
        out.extend_from_slice(format!(",\"start\":{},\"end\":{},\"namespace\":{},\"coherence\":{},\"names\":[",
            failure.span.start, failure.span.end, failure.namespace, failure.coherence).as_bytes());
        for (at, name) in failure.names.iter().enumerate() { if at != 0usize { out.push(b','); } string(&mut out, name); }
        out.extend_from_slice(b"],\"cause\":"); diagnostic(&mut out, &located(program, failure.diagnostic.clone()));
        out.push(b'}');
    }
    out.extend_from_slice(b"]}");
    Report { text: String::from_utf8(out).unwrap(), checked, blocked, rejected, problems }
}
fn blocked_declarations(program: &a::Program, problem: a::Diagnostic, failures: &[Recovery]) -> Report {
    let problem = located(program, problem);
    let mut records = Vec::new();
    for index in 0usize..program.functions.len() {
        if user_function(program, index) {
            records.push(Record { function: index, status: "blocked".to_string(),
                failure: Some(Failure { cause: problem.clone(), reason: "declaration environment is incomplete".to_string() }),
                dependencies: Vec::new() });
        }
    }
    finish(program, records, failures, vec![problem])
}
pub fn analyze(source: &SourceReport) -> Report {
    if source.diagnostics.is_empty() { return finish(&source.program, Vec::new(), &source.recovery, Vec::new()); }
    let mut program = source.program.clone();
    crate::resolve::bind_lexical_scopes(&mut program);
    let first = located(&program, source.diagnostics[0usize].clone());
    let mut failures = source.recovery.clone();
    let mut problems = Vec::new();
    let (resolver, imported) = match Resolver::partial_catalog(&program) {
        Ok(value) => value,
        Err(problem) => {
            return blocked_declarations(&program, problem, &failures);
        }
    };
    for (_, problem) in &imported { append_problem(&mut problems, located(&program, problem.clone())); }
    // Prefer an authored upstream refusal to the consequent unresolved import.
    let mut inherited = BTreeSet::new();
    propagate_import_poison(&program, &resolver, &mut failures, &mut inherited);
    import_failures(&program, &imported, &inherited, &mut failures);
    propagate_import_poison(&program, &resolver, &mut failures, &mut inherited);
    let mut module_paths: BTreeSet<String> = BTreeSet::new();
    let mut ambiguous_modules: BTreeSet<String> = BTreeSet::new();
    for scope in &program.scopes {
        if !module_paths.insert(scope.path.clone()) { ambiguous_modules.insert(scope.path.clone()); }
    }
    let mut recovery_owners = BTreeMap::new();
    for (index, implementation) in program.impls.iter().enumerate() {
        let Some(authored) = &implementation.authored else { continue; };
        for span in &authored.refused_members {
            let key = (span.file, span.start, span.end);
            let owner = if recovery_owners.contains_key(&key) { None } else { Some(index) };
            recovery_owners.insert(key, owner);
        }
    }
    let inspector = Inspector { program: &program, resolver: &resolver, failures: &failures,
        first: &first, ambiguous_modules: &ambiguous_modules, recovery_owners: &recovery_owners };
    let mut plans: Vec<Option<Plan>> = vec![None; program.functions.len()];
    let mut refused: Vec<Option<Failure>> = vec![None; program.functions.len()];
    let mut pending = Vec::new();
    for index in 0usize..program.functions.len() {
        if user_function(&program, index) { pending.push(index); }
    }
    let mut visited = BTreeSet::new();
    while let Some(index) = pending.pop() {
        if !visited.insert(index) { continue; }
        match inspector.function(index) {
            Ok(plan) => {
                for dependency in &plan.dependencies { pending.push(*dependency); }
                plans[index] = Some(plan);
            }
            Err(problem) => refused[index] = Some(problem),
        }
    }
    let mut records = Vec::new();
    for index in 0usize..program.functions.len() {
        if !user_function(&program, index) { continue; }
        let mut dependencies = Vec::new();
        if let Some(plan) = &plans[index] {
            for dependency in &plan.dependencies {
                if user_function(&program, *dependency) { dependencies.push(*dependency); }
            }
        }
        let mut record = Record { function: index, status: "blocked".to_string(), failure: None, dependencies };
        match closure(index, &plans, &refused, &first) {
            Err(failure) => record.failure = Some(failure),
            Ok(selected) => match replay(source, &program, &selected, &plans) {
                Err(reason) => record.failure = Some(complete_context(&first, &reason)),
                Ok(projected) => match crate::frontend::check_item_replay(&projected) {
                    Ok(_) => record.status = "checked".to_string(),
                    Err(problem) => {
                        let problem = located(&program, problem);
                        let scalar_inputs = selected.iter().all(|selected| {
                            match &plans[*selected] { Some(plan) => !plan.structural, None => false }
                        });
                        // Structural operations can need omitted library or trait
                        // declarations even when the isolated diagnostic is E_TYPE.
                        // Only closed primitive inputs justify a new local refusal.
                        if scalar_inputs && matches!(problem.code.as_str(), "E_TYPE" | "E_BORROW") {
                            let own = owns_problem(source, program.functions[index].span, &problem);
                            record.status = if own { "rejected".to_string() } else { "blocked".to_string() };
                            record.failure = Some(Failure { cause: problem.clone(),
                                reason: if own { "ordinary item checking refused".to_string() }
                                    else { "a checked dependency refused".to_string() } });
                            append_problem(&mut problems, problem);
                        } else {
                            record.failure = Some(complete_context(&first,
                                "isolated validation needs library, trait or structural inputs"));
                        }
                    }
                }
            }
        }
        records.push(record);
    }
    // Exact upstream refusals are visible once even when many items depend on them.
    for row in &records {
        if let Some(failure) = &row.failure {
            if !source.diagnostics.contains(&failure.cause) { append_problem(&mut problems, failure.cause.clone()); }
        }
    }
    finish(&program, records, &failures, problems)
}

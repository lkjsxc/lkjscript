fn trap_word(raw: &[u8], at: usize) -> u64 {
    let mut word = 0u64;
    for index in 0..8 { word |= (raw[at + index] as u64) << (index * 8); }
    word
}
fn static_trap_message(program: &crate::ir::Program, code: u64) -> Option<String> {
    let fixed: &str = match code {
        1 => "integer overflow", 2 => "division by zero", 3 => "index out of bounds",
        4 => "explicit trap", 5 => "assertion failed", 6 => "heap allocation failed",
        8 => "stack exhausted", 9..=15 => "trap", _ => "",
    };
    if !fixed.is_empty() { return Some(fixed.to_string()); }
    if code < 16 { return None; }
    let messages = crate::native::messages(program);
    messages.get((code - 16) as usize).cloned()
}
pub fn main_site(program: &crate::ir::Program, raw: &[u8]) -> bool {
    raw.len() >= 32 && trap_word(raw, 16) < program.sources.len().max(1) as u64
}
pub fn decode(path: &str, program: &crate::ir::Program, runtime: &crate::runtime::Runtime, raw: &[u8]) -> Option<(u64, String, String)> {
    if raw.len() < 32 || &raw[..8] != b"LKJTRAP2" { return None; }
    let code = trap_word(raw, 8);
    let file = trap_word(raw, 16) as usize;
    let line = trap_word(raw, 24) as usize;
    let base = program.sources.len().max(1);
    let meaning = if file < base { program } else { runtime.checked_program() };
    let local = if file < base { file } else { file - base };
    let source = if meaning.sources.is_empty() && local == 0 {
        if file < base { path } else { "library/runtime.lkj" }
    } else { meaning.sources.get(local)?.as_str() };
    let text = String::from_utf8(raw[32..].to_vec()).ok()?;
    if !text.ends_with("\n") || text.len() > 2048 { return None; }
    let text = &text[..text.len() - 1];
    if text.as_bytes().contains(&b'\n') || text.as_bytes().contains(&b'\r') { return None; }
    let marker = text.find(": R")?;
    let rest = &text[marker + 3..];
    let space = rest.find(' ')?;
    if space < 4 || rest[..space].parse::<u64>().ok()? != code { return None; }
    let message: String = if code == 7 { crate::runtime_diagnostics::decoded(&rest[space + 1..])? }
        else { static_trap_message(meaning, code)? };
    let label = format!("R{code:04}");
    // The full bounded record must agree with the same checked message table,
    // source namespace and location; partial writes and forged headers reject.
    if text != crate::runtime_diagnostics::located(source, line, &label, &message) { return None; }
    Some((code, crate::runtime_diagnostics::full_located(source, line, &label, &message), message))
}

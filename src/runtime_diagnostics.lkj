//! Bounded, single-line external diagnostics. These helpers grant no output authority.
pub const PATH_LIMIT: usize = 512;
pub const MESSAGE_LIMIT: usize = 1024;

pub fn escaped(text: &str, limit: usize, path: bool) -> String {
    let mut out = String::new();
    let mut truncated = false;
    for value in text.chars() {
        let mut piece = String::new();
        match value {
            '\\' => piece.push_str("\\\\"),
            '\n' => piece.push_str("\\n"),
            '\r' => piece.push_str("\\r"),
            '\t' => piece.push_str("\\t"),
            ':' if path => piece.push_str("\\x3a"),
            _ if value.is_control() => {
                let mut encoded = String::new(); encoded.push(value);
                for byte in encoded.as_bytes() { piece.push_str(&format!("\\x{:02x}", *byte)); }
            }
            _ => piece.push(value),
        }
        if out.len() + piece.len() > limit - 3 { truncated = true; break; }
        out.push_str(&piece);
    }
    if truncated { out.push_str("..."); }
    out
}
pub fn decoded(text: &str) -> Option<String> {
    let mut bytes = Vec::new();
    let raw = text.as_bytes();
    let mut at = 0usize;
    while at < raw.len() {
        let byte = raw[at]; at += 1;
        if byte != b'\\' { bytes.push(byte); continue; }
        if at == raw.len() { return None; }
        let code = raw[at]; at += 1;
        match code {
            b'\\' => bytes.push(b'\\'), b'n' => bytes.push(b'\n'),
            b'r' => bytes.push(b'\r'), b't' => bytes.push(b'\t'),
            b'x' => {
                if raw.len() - at < 2 { return None; }
                let mut value = 0u8;
                for _ in 0..2 {
                    let digit = raw[at]; at += 1;
                    let part = if digit >= b'0' && digit <= b'9' { digit - b'0' }
                        else if digit >= b'a' && digit <= b'f' { digit - b'a' + 10 }
                        else { return None; };
                    value = value * 16 + part;
                }
                bytes.push(value);
            }
            _ => return None,
        }
    }
    String::from_utf8(bytes).ok()
}
pub fn located(path: &str, line: usize, code: &str, message: &str) -> String {
    format!("{}:{line}: {code} {}", escaped(path, PATH_LIMIT, true), escaped(message, MESSAGE_LIMIT, false))
}
pub fn full_located(path: &str, line: usize, code: &str, message: &str) -> String {
    format!("{}:{line}: {code} {}", escaped(path, !0usize, true), escaped(message, !0usize, false))
}
// Machine observations keep complete identities. Only user delivery is bounded.
pub fn bounded(text: &str) -> String {
    let marker = match text.find(": ") { Some(marker) => marker, None => return escaped(text, 2047, false) };
    let location = &text[..marker];
    let at = match location.rfind(':') { Some(at) => at, None => return escaped(text, 2047, false) };
    let path = match decoded(&location[..at]) { Some(path) => path, None => return escaped(text, 2047, false) };
    let line = match location[at + 1..].parse::<usize>() { Ok(line) => line, Err(_) => return escaped(text, 2047, false) };
    let rest = &text[marker + 2..];
    let space = match rest.find(' ') { Some(space) => space, None => return escaped(text, 2047, false) };
    let message = match decoded(&rest[space + 1..]) { Some(message) => message, None => return escaped(text, 2047, false) };
    located(&path, line, &rest[..space], &message)
}
pub fn syscall_name(number: u64) -> &'static str {
    match number {
        0 => "read", 1 => "write", 3 => "close", 5 => "fstat", 8 => "lseek", 9 => "mmap", 13 => "rt_sigaction",
        14 => "rt_sigprocmask", 17 => "pread64", 18 => "pwrite64", 38 => "setitimer", 41 => "socket", 42 => "connect", 49 => "bind",
        50 => "listen", 54 => "setsockopt", 72 => "fcntl", 91 => "fchmod", 131 => "sigaltstack", 257 => "openat",
        289 => "signalfd4", 291 => "epoll_create1", 319 => "memfd_create", 437 => "openat2",
        1000 => "validate", 1001 => "lookup", 1002 => "validate-image", 1003 => "validate-device", _ => "acquire",
    }
}


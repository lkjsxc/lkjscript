//! Cross-unit execution and exact authenticated-object refusal controls.
use crate::{check, ir, ir_text, native, reuse, runtime};
use crate::check::units::{CheckedUnit, Import, Interface};
fn local(name: &str, ty: usize) -> ir::Local { ir::Local { name: name.to_string(), ty, mutable: false } }
fn function(name: &str, locals: Vec<ir::Local>, ops: Vec<ir::Op>) -> ir::Function {
    let mut body = Vec::new();
    for op in ops { body.push(ir::Instruction { file: None, line: 7usize, column: 3usize, op }); }
    ir::Function { file: 0usize, name: name.to_string(), params: 0usize, result: ir::I64,
        return_source: None, locals, body, test: false }
}
fn provider(value: i64, trapping: bool) -> CheckedUnit {
    let mut program = ir::Program { sources: vec!["numbers.lkj".to_string()], types: ir::primitives(),
        functions: Vec::new(), destructors: Vec::new() };
    program.functions.push(function("numbers::value", vec![local("result", ir::I64)],
        vec![ir::Op::Call { dst: 0usize, function: 1usize, args: Vec::new() }, ir::Op::Return { src: 0usize }]));
    let ops = if trapping { vec![ir::Op::Trap { message: "zeta custom failure".to_string() }] }
        else { vec![ir::Op::Int { dst: 0usize, value }, ir::Op::Return { src: 0usize }] };
    program.functions.push(function("numbers::private", vec![local("value", ir::I64)], ops));
    let imports: Vec<Import> = Vec::new();
    check::units::check_unit_with_exports("numbers", &format!("numbers-{value}-{trapping}"), program,
        &imports, &[0usize], &[0usize; 0]).unwrap()
}
fn imported(interface: &Interface) -> Import {
    let mut types = Vec::new(); let mut functions = Vec::new();
    for index in 0usize..interface.program().types.len() { types.push((index, index)); }
    for index in 0usize..interface.program().functions.len() { functions.push((index, index)); }
    Import { interface: interface.clone(), types, functions }
}
fn consumer(interface: &Interface, extra_message: bool) -> CheckedUnit {
    let mut program = interface.program().clone();
    program.sources.push("user.lkj".to_string());
    let mut main = function("user::main", vec![local("result", ir::I64), local("one", ir::I64), local("sum", ir::I64)],
        vec![ir::Op::Call { dst: 0usize, function: 0usize, args: Vec::new() },
            ir::Op::Int { dst: 1usize, value: 1i64 },
            ir::Op::Binary { dst: 2usize, op: ir::BinaryOp::Add, left: 0usize, right: 1usize },
            ir::Op::Return { src: 2usize }]);
    main.file = program.sources.len() - 1usize;
    program.functions.push(main);
    if extra_message {
        program.functions.push(function("user::unreachable", vec![local("never", ir::I64)],
            vec![ir::Op::Trap { message: "alpha unused failure".to_string() }]));
    }
    check::units::check_unit_with_exports("user", "user-input", program, &[imported(interface)], &[1usize], &[0usize; 0]).unwrap()
}
fn runtime(world: &mut World) -> runtime::Runtime {
    let mut directory = world.directory(".").unwrap();
    let mut file = directory.open("target/unit-native-runtime.lkjir").unwrap();
    let text = String::from_utf8(file.read_to_end().unwrap()).unwrap();
    runtime::seal(check::check(ir_text::read(&text).unwrap()).unwrap()).unwrap()
}
fn no_grants() -> Vec<ir::EntryGrant> { Vec::new() }
fn no_messages() -> Vec<String> { Vec::new() }
fn sources(first: &CheckedUnit, second: &CheckedUnit) -> Vec<String> {
    let mut result = first.program().sources.clone();
    for path in &second.program().sources { result.push(path.clone()); }
    result
}
fn read_word(bytes: &[u8], at: usize) -> usize {
    let mut value = 0usize;
    for index in 0usize..8usize { value |= (bytes[at + index] as usize) << (index * 8usize); }
    value
}
fn execute(world: &mut World, mut executable: File) -> (i64, Vec<u8>) {
    executable.set_executable().unwrap();
    let input = world.temporary_file().unwrap();
    let output = world.temporary_file().unwrap();
    let errors = world.temporary_file().unwrap();
    let mut result = world.temporary_file().unwrap();
    let args: Vec<Vec<u8>> = Vec::new();
    let mut process = world.process();
    let mut child = process.spawn_file(&executable, &args, &input, &output, &errors, &result).unwrap();
    let status = child.wait().unwrap();
    result.rewind().unwrap();
    (status, result.read_to_end().unwrap())
}
fn verified(namespace: &str, key: &str, bytes: &[u8], producer: &[u8], secret: &[u8]) -> reuse::VerifiedPayload {
    let encoded = reuse::seal(producer, secret, namespace, key, bytes);
    let header = reuse::header_size();
    let root = reuse::AuthenticatedRoot::new(producer, secret, namespace, key, &encoded[..header]).unwrap();
    root.verify(encoded[header..].to_vec()).unwrap()
}
fn objects(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, false);
    let second = consumer(first.interface(), false);
    let source_base = first.program().sources.len();
    let all_sources = sources(&first, &second);
    let a = native::units::emit(&first, runtime, 0usize).unwrap();
    let b = native::units::emit(&second, runtime, source_base).unwrap();
    let output = world.temporary_file().unwrap(); let spool = world.temporary_file().unwrap();
    let mut linker = native::units::Linker::new(output, spool).unwrap();
    linker.push(a).unwrap(); linker.push(b).unwrap();
    let (file, length) = linker.finish(runtime, second.interface(), "user::main", &no_grants(), &all_sources, &no_messages(), Some(3u32)).unwrap();
    assert!(length > 4096usize);
    let (status, bytes) = execute(world, file);
    assert_eq!(status, 0i64); assert_eq!(bytes.len(), 8usize); assert_eq!(read_word(&bytes, 0usize), 42usize);
    let object = native::units::emit(&first, runtime, 0usize).unwrap();
    let encoded = object.encode(); let key = object.key().to_string();
    let producer = [7u8; 32]; let secret = [9u8; 32]; let domain = reuse::ProofDomain::new(&producer, &secret);
    let token = verified(native::units::namespace(), &key, &encoded, &producer, &secret);
    let reopened = native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).unwrap();
    assert_eq!(reopened.encode(), encoded);
    let changed = provider(99i64, false);
    assert_eq!(changed.interface().identity(), first.interface().identity());
    let token = verified(native::units::namespace(), &key, &encoded, &producer, &secret);
    assert!(native::units::Object::open(&domain, changed.interface(), runtime, 0usize, &first.program().sources, token).is_none());
    let token = verified("front", &key, &encoded, &producer, &secret);
    assert!(native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).is_none());
    let token = verified(native::units::namespace(), &key, &encoded, &producer, &[8u8; 32]);
    assert!(native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).is_none());
    let token = verified(native::units::namespace(), &key, &encoded, &[6u8; 32], &secret);
    assert!(native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).is_none());
    let token = verified(native::units::namespace(), &key, &encoded, &producer, &secret);
    assert!(native::units::Object::open(&domain, first.interface(), runtime, 1usize, &first.program().sources, token).is_none());
    let mut changed_sources = first.program().sources.clone(); changed_sources[0] = "different.lkj".to_string();
    let token = verified(native::units::namespace(), &key, &encoded, &producer, &secret);
    assert!(native::units::Object::open(&domain, first.interface(), runtime, 0usize, &changed_sources, token).is_none());
    for variant in 0usize..3usize {
        let mut malformed = encoded.clone();
        match variant { 0usize => { malformed.pop(); }, 1usize => malformed.push(0u8), _ => malformed[0] ^= 1u8 }
        let token = verified(native::units::namespace(), &key, &malformed, &producer, &secret);
        assert!(native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).is_none());
    }
    // An authenticated cold object may enter an otherwise fresh link.
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    linker.push(reopened).unwrap(); linker.push(native::units::emit(&second, runtime, source_base).unwrap()).unwrap();
    let (file, _) = linker.finish(runtime, second.interface(), "user::main", &no_grants(), &all_sources, &no_messages(), Some(3u32)).unwrap();
    let (status, bytes) = execute(world, file); assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), 42usize);
    13usize
}
fn refusals(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, false); let second = consumer(first.interface(), false);
    let all_sources = sources(&first, &second);
    let base = first.program().sources.len();
    let mut missing = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    missing.push(native::units::emit(&second, runtime, base).unwrap()).unwrap();
    assert!(missing.finish(runtime, second.interface(), "user::main", &no_grants(), &all_sources, &no_messages(), None).is_err());
    let mut duplicate = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    duplicate.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    assert!(duplicate.push(native::units::emit(&first, runtime, 0usize).unwrap()).is_err());
    assert!(duplicate.finish(runtime, first.interface(), "numbers::value", &no_grants(), &all_sources, &no_messages(), None).is_err());
    let mut table = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    table.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    table.push(native::units::emit(&second, runtime, base).unwrap()).unwrap();
    let mut wrong_sources = all_sources.clone(); wrong_sources[0] = "forged.lkj".to_string();
    assert!(table.finish(runtime, second.interface(), "user::main", &no_grants(), &wrong_sources, &no_messages(), None).is_err());
    let mut stale = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    stale.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    let changed = provider(9i64, false);
    assert!(stale.finish(runtime, changed.interface(), "numbers::value", &no_grants(), &first.program().sources, &no_messages(), None).is_err());
    let mut spool = world.temporary_file().unwrap(); let mut alias = spool.duplicate().unwrap();
    let mut changed_spool = native::units::Linker::new(world.temporary_file().unwrap(), spool).unwrap();
    changed_spool.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    alias.seek(8i64, 0u8).unwrap(); alias.write_all(&[2u8,0u8,0u8,0u8,0u8,0u8,0u8,0u8]).unwrap();
    let refusal = changed_spool.finish(runtime, first.interface(), "numbers::value", &no_grants(), &first.program().sources, &no_messages(), None).err().unwrap();
    assert_eq!(refusal.message, "relocation spool changed after emission");
    // Buffered prefetch must not swallow an appended extent. Leave a hole past
    // all support records, which are appended during finish.
    let mut spool = world.temporary_file().unwrap(); let mut alias = spool.duplicate().unwrap();
    let mut trailing = native::units::Linker::new(world.temporary_file().unwrap(), spool).unwrap();
    trailing.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    alias.seek(1048576i64, 0u8).unwrap(); alias.write_all(&[0u8]).unwrap();
    let refusal = trailing.finish(runtime, first.interface(), "numbers::value", &no_grants(), &first.program().sources, &no_messages(), None).err().unwrap();
    assert_eq!(refusal.message, "relocation spool changed its extent");
    7usize
}
fn traps
(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, true); let second = consumer(first.interface(), true);
    let all_sources = sources(&first, &second);
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    let object = native::units::emit(&first, runtime, 0usize).unwrap();
    let producer = [7u8; 32]; let secret = [9u8; 32];
    let domain = reuse::ProofDomain::new(&producer, &secret);
    let token = verified(native::units::namespace(), object.key(), &object.encode(), &producer, &secret);
    let reopened = native::units::Object::open(&domain, first.interface(), runtime, 0usize, &first.program().sources, token).unwrap();
    linker.push(reopened).unwrap();

    linker.push(native::units::emit(&second, runtime, first.program().sources.len()).unwrap()).unwrap();
    let messages = vec!["zeta custom failure".to_string(), "alpha unused failure".to_string()];
    let (file, _) = linker.finish(runtime, second.interface(), "user::main", &no_grants(), &all_sources, &messages, Some(3u32)).unwrap();
    let (status, raw) = execute(world, file);
    assert!(status != 0i64);
    assert!(raw.starts_with(b"LKJTRAP2"));
    assert_eq!(read_word(&raw, 8usize), 17usize);
    assert_eq!(read_word(&raw, 16usize), 0usize);
    assert_eq!(read_word(&raw, 24usize), 7usize);
    let message = String::from_utf8(raw[32usize..].to_vec()).unwrap();
    assert_eq!(message, "numbers.lkj:7: R0017 zeta custom failure\n");
    1usize
}
fn relocation_edges() -> usize {
    let mut a = crate::x86::Assembler::at_base(37usize);
    let local = a.label(); let external = a.label();
    a.jump(local); a.raw(&[0x90u8]); a.bind(local); a.call(external); a.ret();
    let object = a.linkable(&[(local, "local".to_string()), (external, "external".to_string())]).unwrap();
    assert_eq!(object.bytes.len(), 12usize); assert_eq!(object.bytes[1], 1u8);
    assert_eq!(object.definitions[0].1, 6usize); assert_eq!(object.references[0].at, 7usize);
    let mut absent = crate::x86::Assembler::new(); let missing = absent.label(); absent.call(missing);
    let empty: Vec<(usize, String)> = Vec::new(); assert!(absent.linkable(&empty).is_err());
    let mut duplicate = crate::x86::Assembler::new(); let first = duplicate.label(); let second = duplicate.label();
    assert!(duplicate.linkable(&[(first, "a".to_string()), (second, "a".to_string())]).is_err());
    let site = crate::diagnostic::Span::default();
    assert!(crate::x86::displacement(2147483651usize, 0usize, site).is_ok());
    assert!(crate::x86::displacement(2147483652usize, 0usize, site).is_err());
    assert!(crate::x86::displacement(0usize, 2147483644usize, site).is_ok());
    assert!(crate::x86::displacement(0usize, 2147483645usize, site).is_err());
    8usize
}

fn runtime_binding(world: &mut World, sealed: &runtime::Runtime) -> usize {
    let runtime = native::units::Context::new(sealed);
    let first = provider(41i64, false);
    let object = native::units::emit(&first, &runtime, 0usize).unwrap();
    let mut changed = sealed.checked_program().clone();
    changed.sources[0] = "different-runtime-source.lkj".to_string();
    let changed = runtime::seal(check::check(changed).unwrap()).unwrap();
    let other = native::units::Context::new(&changed);
    let producer = [7u8; 32]; let secret = [9u8; 32];
    let domain = reuse::ProofDomain::new(&producer, &secret);
    let token = verified(native::units::namespace(), object.key(), &object.encode(), &producer, &secret);
    assert!(native::units::Object::open(&domain, first.interface(), &other, 0usize, &first.program().sources, token).is_none());
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    linker.push(object).unwrap();
    let refusal = linker.finish(&other, first.interface(), "numbers::value", &no_grants(), &first.program().sources, &no_messages(), None).err().unwrap();
    assert_eq!(refusal.message, "linked runtime differs from unit object runtime");
    2usize
}

fn buffered_extents(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let mut name = "numbers::value".to_string();
    for _ in 0usize..65560usize { name.push('x'); }
    let mut program = ir::Program { sources: vec!["numbers.lkj".to_string()], types: ir::primitives(),
        functions: Vec::new(), destructors: Vec::new() };
    program.functions.push(function(&name, vec![local("result", ir::I64)],
        vec![ir::Op::Int { dst: 0usize, value: 41i64 }, ir::Op::Return { src: 0usize }]));
    for index in 0usize..1600usize {
        program.functions.push(function(&format!("numbers::private{index}"), vec![local("result", ir::I64)],
            vec![ir::Op::Int { dst: 0usize, value: index as i64 }, ir::Op::Return { src: 0usize }]));
    }
    let imports: Vec<Import> = Vec::new();
    let first = check::units::check_unit_with_exports("numbers", "buffered-extents", program,
        &imports, &[0usize], &[0usize; 0]).unwrap();
    let second = consumer(first.interface(), false);
    let object = native::units::emit(&first, runtime, 0usize).unwrap();
    assert!(object.bytes() > 65536usize);
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    linker.push(object).unwrap();
    linker.push(native::units::emit(&second, runtime, first.program().sources.len()).unwrap()).unwrap();
    let (file, _) = linker.finish(runtime, second.interface(), "user::main", &no_grants(), &sources(&first, &second), &no_messages(), Some(3u32)).unwrap();
    let (status, bytes) = execute(world, file);
    assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), 42usize);
    // Selecting the long name directly exercises ordinary support records too.
    let mut direct = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    direct.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    let (file, _) = direct.finish(runtime, first.interface(), name.as_str(), &no_grants(),
        &first.program().sources, &no_messages(), Some(3u32)).unwrap();
    let (status, bytes) = execute(world, file);
    assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), 41usize);
    2usize
}

fn put_word(bytes: &mut Vec<u8>, at: usize, value: usize) {
    for index in 0usize..8usize { bytes[at + index] = (value >> (index * 8usize)) as u8; }
}

fn skip_blob(bytes: &[u8], at: usize) -> usize { at + 8usize + read_word(bytes, at) }

struct ObjectFields {
    exports: usize,
    export_count: usize,
    code_length: usize,
    symbols: Vec<(usize, usize, usize)>,
    references: usize,
    reference_count: usize,
    immediates: usize,
    immediate_count: usize,
}

fn object_fields(bytes: &[u8]) -> ObjectFields {
    assert!(bytes.starts_with(b"LKJUNITOBJECT2\n"));
    let mut at = b"LKJUNITOBJECT2\n".len();
    at = skip_blob(bytes, at); at = skip_blob(bytes, at);
    at += 16usize;
    let count = read_word(bytes, at); at += 8usize;
    for _ in 0usize..count { at = skip_blob(bytes, at); }
    let count = read_word(bytes, at); at += 8usize;
    for _ in 0usize..count { at = skip_blob(bytes, at); }
    let exports = at;
    let export_count = read_word(bytes, at); at += 8usize + export_count * 32usize;
    let code_length = read_word(bytes, at); at += 8usize + code_length;
    let count = read_word(bytes, at); at += 8usize;
    let mut symbols = Vec::new();
    for _ in 0usize..count {
        let length = read_word(bytes, at);
        symbols.push((at, at + 8usize, length));
        at += 8usize + length;
    }
    let reference_count = read_word(bytes, at);
    let references = at + 8usize;
    at = references + reference_count * 40usize;
    let immediate_count = read_word(bytes, at);
    let immediates = at + 8usize;
    assert_eq!(immediates + immediate_count * 40usize, bytes.len());
    ObjectFields { exports, export_count, code_length, symbols, references,
        reference_count, immediates, immediate_count }
}

fn open_object(unit: &CheckedUnit, runtime: &native::units::Context<'_>, base: usize, bytes: &[u8])
    -> Option<native::units::Object> {
    let producer = [7u8; 32]; let secret = [9u8; 32];
    let domain = reuse::ProofDomain::new(&producer, &secret);
    let key = native::units::object_key(unit.interface(), runtime, base, &unit.program().sources);
    let token = verified(native::units::namespace(), &key, bytes, &producer, &secret);
    native::units::Object::open(&domain, unit.interface(), runtime, base, &unit.program().sources, token)
}

fn replace_symbol(bytes: &[u8], location: (usize, usize, usize), replacement: &str) -> Vec<u8> {
    let mut result = bytes[..location.0].to_vec();
    let size_at = result.len();
    result.extend_from_slice(&[0u8; 8]);
    put_word(&mut result, size_at, replacement.len());
    result.extend_from_slice(replacement.as_bytes());
    result.extend_from_slice(&bytes[location.1 + location.2..]);
    result
}

fn compact_objects(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, false);
    let second = consumer(first.interface(), false);
    let base = first.program().sources.len();
    let encoded = native::units::emit(&second, runtime, base).unwrap().encode();
    let fields = object_fields(&encoded);
    assert_eq!(fields.export_count, 1usize);
    assert!(fields.reference_count > 0usize);
    // A valid authenticated compact object still links in reverse arrival order.
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    linker.push(open_object(&second, runtime, base, &encoded).unwrap()).unwrap();
    linker.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    let (file, _) = linker.finish(runtime, second.interface(), "user::main",
        &no_grants(), &sources(&first, &second), &no_messages(), Some(3u32)).unwrap();
    let (status, bytes) = execute(world, file);
    assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), 42usize);
    for variant in 0usize..6usize {
        let mut malformed = encoded.clone();
        match variant {
            0usize => put_word(&mut malformed, fields.exports, 2usize),
            1usize => put_word(&mut malformed, fields.exports + 8usize, fields.code_length),
            2usize => put_word(&mut malformed, fields.exports + 16usize, base + second.program().sources.len()),
            3usize => put_word(&mut malformed, fields.references + 8usize, fields.symbols.len()),
            4usize => put_word(&mut malformed, fields.references, fields.code_length),
            _ => malformed[b"LKJUNITOBJECT".len()] = b'1',
        }
        assert!(open_object(&second, runtime, base, &malformed).is_none());
    }
    let producer = [7u8; 32]; let secret = [9u8; 32];
    let domain = reuse::ProofDomain::new(&producer, &secret);
    let key = native::units::object_key(second.interface(), runtime, base, &second.program().sources);
    let old = verified("unit-native-1", &key, &encoded, &producer, &secret);
    assert!(native::units::Object::open(&domain, second.interface(), runtime, base, &second.program().sources, old).is_none());
    let trapped = provider(41i64, true);
    let mut malformed = native::units::emit(&trapped, runtime, 0usize).unwrap().encode();
    let fields = object_fields(&malformed);
    assert!(fields.immediate_count > 0usize);
    put_word(&mut malformed, fields.immediates + 8usize, 1usize);
    assert!(open_object(&trapped, runtime, 0usize, &malformed).is_none());
    9usize
}

fn compact_bindings(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, false);
    let second = consumer(first.interface(), false);
    let base = first.program().sources.len();
    let encoded = native::units::emit(&second, runtime, base).unwrap().encode();
    let fields = object_fields(&encoded);
    let mut selected = None;
    for location in &fields.symbols {
        let name = String::from_utf8(encoded[location.1..location.1 + location.2].to_vec()).unwrap();
        if name.as_str().starts_with("unit:") { selected = Some(*location); break; }
    }
    let location = selected.unwrap();
    let identity = first.interface().identity().to_string();
    let wrong_identity = format!("{}{}", if identity.as_bytes()[0] == b'0' { "1" } else { "0" }, &identity[1usize..]);
    let replacements: Vec<String> = vec![
        format!("unit:8:numbers:64:{identity}:numbers::value"),
        format!("unit:07:numbers:64:{identity}:numbers::value"),
        format!("unit:7:numbers:65:{identity}:numbers::value"),
        format!("unit:7:numbers:64:g{}:numbers::value", &identity[1usize..]),
        format!("unit:184467440737095516160:numbers:64:{identity}:numbers::value"),
        format!("unit:1:é:64:{identity}:numbers::value"),
        format!("unit:7:xumbers:64:{identity}:numbers::value"),
        format!("unit:7:numbers:64:{wrong_identity}:numbers::value"),
        format!("unit:7:numbers:64:{identity}:numbers::absent"),
    ];
    for (index, replacement) in replacements.iter().enumerate() {
        let malformed = replace_symbol(&encoded, location, replacement.as_str());
        let object = open_object(&second, runtime, base, &malformed);
        if index < 6usize {
            assert!(object.is_none());
        } else {
            let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
            linker.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
            linker.push(object.unwrap()).unwrap();
            let failure = linker.finish(runtime, second.interface(), "user::main",
                &no_grants(), &sources(&first, &second), &no_messages(), None).err().unwrap();
            assert_eq!(failure.message, format!("unresolved unit symbol {replacement}"));
            assert_eq!(failure.file, base + second.program().functions[1usize].file);
            assert_eq!(failure.line, 7usize); assert_eq!(failure.column, 3usize);
        }
    }
    9usize
}

fn same_name_unit(name: &str, value: i64) -> CheckedUnit {
    let program = ir::Program { sources: vec![format!("{name}.lkj")], types: ir::primitives(),
        functions: vec![function("shared::value", vec![local("result", ir::I64)],
            vec![ir::Op::Int { dst: 0usize, value }, ir::Op::Return { src: 0usize }])],
        destructors: Vec::new() };
    let imports: Vec<Import> = Vec::new();
    check::units::check_unit(name, name, program, &imports).unwrap()
}

fn grouped_exports(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = same_name_unit("first", 41i64);
    let second = same_name_unit("second", 99i64);
    let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
    linker.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
    let object = native::units::emit(&second, runtime, 1usize).unwrap();
    linker.push(open_object(&second, runtime, 1usize, &object.encode()).unwrap()).unwrap();
    let (file, _) = linker.finish(runtime, second.interface(), "shared::value",
        &no_grants(), &sources(&first, &second), &no_messages(), Some(3u32)).unwrap();
    let (status, bytes) = execute(world, file);
    assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), 99usize);
    let mut program = first.program().clone();
    program.functions[0].name = "shared::z".to_string();
    program.functions.push(function("shared::a", vec![local("result", ir::I64)],
        vec![ir::Op::Int { dst: 0usize, value: 99i64 }, ir::Op::Return { src: 0usize }]));
    let imports: Vec<Import> = Vec::new();
    let multiple = check::units::check_unit("multiple", "multiple", program, &imports).unwrap();
    let encoded = native::units::emit(&multiple, runtime, 0usize).unwrap().encode();
    for (entry, expected) in vec![("shared::z".to_string(), 41usize), ("shared::a".to_string(), 99usize)] {
        let mut linker = native::units::Linker::new(world.temporary_file().unwrap(), world.temporary_file().unwrap()).unwrap();
        linker.push(open_object(&multiple, runtime, 0usize, &encoded).unwrap()).unwrap();
        let (file, _) = linker.finish(runtime, multiple.interface(), entry.as_str(), &no_grants(),
            &multiple.program().sources, &no_messages(), Some(3u32)).unwrap();
        let (status, bytes) = execute(world, file);
        assert_eq!(status, 0i64); assert_eq!(read_word(&bytes, 0usize), expected);
    }
    3usize
}

struct PacketFields {
    packet: usize,
    length: usize,
    symbols: Vec<(usize, usize, usize)>,
    messages: Vec<(usize, usize, usize)>,
    message_count: usize,
    row_count: usize,
    rows: usize,
}

fn packet_fields(bytes: &[u8]) -> PacketFields {
    // The initial entry record keeps its ordinary name framing.
    assert_eq!(read_word(bytes, 0usize), 0usize);
    let packet = 48usize + read_word(bytes, 16usize);
    assert_eq!(read_word(bytes, packet), 2usize);
    let length = read_word(bytes, packet + 8usize);
    let mut at = packet + 16usize;
    let count = read_word(bytes, at); at += 8usize;
    let mut symbols = Vec::new();
    for _ in 0usize..count {
        let size = read_word(bytes, at);
        symbols.push((at, at + 8usize, size)); at += 8usize + size;
    }
    let message_count = at;
    let count = read_word(bytes, at); at += 8usize;
    let mut messages = Vec::new();
    for _ in 0usize..count {
        let size = read_word(bytes, at);
        messages.push((at, at + 8usize, size)); at += 8usize + size;
    }
    let row_count = read_word(bytes, at);
    let rows = at + 8usize;
    assert_eq!(rows + row_count * 48usize, packet + 16usize + length);
    PacketFields { packet, length, symbols, messages, message_count, row_count, rows }
}

fn append_word(bytes: &mut Vec<u8>, value: usize) {
    let at = bytes.len(); bytes.extend_from_slice(&[0u8; 8]); put_word(bytes, at, value);
}

fn append_string(bytes: &mut Vec<u8>, value: &str) {
    append_word(bytes, value.len()); bytes.extend_from_slice(value.as_bytes());
}

fn packet_refusals(world: &mut World, runtime: &native::units::Context<'_>) -> usize {
    let first = provider(41i64, true);
    let messages = vec!["zeta custom failure".to_string()];
    for variant in 0usize..22usize {
        let mut spool = world.temporary_file().unwrap(); let mut alias = spool.duplicate().unwrap();
        let mut output = world.temporary_file().unwrap(); let mut unpublished = output.duplicate().unwrap();
        let mut linker = native::units::Linker::new(output, spool).unwrap();
        linker.push(native::units::emit(&first, runtime, 0usize).unwrap()).unwrap();
        alias.rewind().unwrap();
        let mut bytes = alias.read_to_end().unwrap();
        let fields = packet_fields(&bytes);
        assert!(!fields.symbols.is_empty()); assert!(!fields.messages.is_empty()); assert!(fields.row_count > 0usize);
        let mut immediate = None;
        for index in 0usize..fields.row_count {
            let row = fields.rows + index * 48usize;
            if read_word(&bytes, row) == 1usize { immediate = Some(row); break; }
        }
        match variant {
            0usize => put_word(&mut bytes, fields.packet, 3usize),
            1usize => put_word(&mut bytes, fields.packet + 8usize, !0usize),
            2usize => put_word(&mut bytes, fields.packet + 8usize, 23usize),
            3usize => put_word(&mut bytes, fields.packet + 16usize, !0usize),
            4usize => put_word(&mut bytes, fields.symbols[0].0, !0usize),
            5usize => bytes[fields.symbols[0].1] = 255u8,
            6usize => put_word(&mut bytes, fields.message_count, !0usize),
            7usize => put_word(&mut bytes, fields.rows - 8usize, !0usize),
            8usize => put_word(&mut bytes, fields.rows, 2usize),
            9usize => put_word(&mut bytes, fields.rows + 16usize, !0usize),
            10usize => put_word(&mut bytes, fields.rows + 8usize, !0usize),
            11usize => put_word(&mut bytes, fields.rows + 24usize, !0usize),
            12usize => {
                let line = read_word(&bytes, fields.rows + 32usize);
                put_word(&mut bytes, fields.rows + 32usize, line + 1usize);
            },
            13usize => put_word(&mut bytes, 16usize, !0usize),
            14usize => put_word(&mut bytes, 0usize, 2usize),
            15usize => {
                put_word(&mut bytes, fields.packet, 0usize);
                put_word(&mut bytes, fields.packet + 16usize, !0usize);
            },
            16usize => put_word(&mut bytes, fields.packet + 8usize, fields.length - 1usize),
            17usize => put_word(&mut bytes, immediate.unwrap() + 16usize, !0usize),
            _ => {
                // Unused table entries must also be parsed and validated.
                let mut payload = Vec::new();
                if variant == 18usize {
                    append_word(&mut payload, 2usize);
                    append_string(&mut payload, "same"); append_string(&mut payload, "same");
                } else if variant == 19usize {
                    append_word(&mut payload, 1usize); append_string(&mut payload, "unit:x");
                } else if variant == 20usize {
                    append_word(&mut payload, 1usize); append_string(&mut payload, "");
                } else { append_word(&mut payload, 0usize); }
                if variant == 21usize {
                    append_word(&mut payload, 2usize);
                    append_string(&mut payload, ""); append_string(&mut payload, "");
                } else { append_word(&mut payload, 0usize); }
                append_word(&mut payload, 0usize);
                assert!(payload.len() <= fields.length);
                put_word(&mut bytes, fields.packet + 8usize, payload.len());
                bytes[fields.packet + 16usize..fields.packet + 16usize + payload.len()].copy_from_slice(&payload);
            },
        }
        let expected = match variant {
            0usize | 8usize => "unknown unit relocation kind",
            1usize | 2usize | 14usize => "invalid relocation packet extent",
            3usize | 6usize => "invalid relocation table count",
            4usize | 13usize | 15usize => "invalid relocation symbol extent",
            5usize => "relocation symbol is not UTF-8",
            7usize | 16usize => "invalid relocation packet rows",
            9usize => "invalid relocation symbol ordinal",
            10usize => "unit relocation is outside image code",
            11usize => "invalid relocation reference site",
            12usize => "relocation spool changed after emission",
            17usize => "invalid relocation message ordinal",
            18usize | 21usize => "duplicate relocation table name",
            19usize => "invalid unit relocation symbol",
            _ => "empty relocation symbol",
        };
        alias.rewind().unwrap(); alias.write_all(&bytes).unwrap();
        let failure = linker.finish(runtime, first.interface(), "numbers::value", &no_grants(),
            &first.program().sources, &messages, None).err().unwrap();
        assert_eq!(failure.message, expected);
        unpublished.rewind().unwrap();
        let image = unpublished.read_to_end().unwrap();
        assert_eq!(&image[..4usize], &[0u8; 4]);
    }
    22usize
}
pub fn run(world: &mut World) -> usize {
    let sealed = runtime(world);
    let runtime = native::units::Context::new(&sealed);
    objects(world, &runtime) + refusals(world, &runtime) + traps(world, &runtime) + relocation_edges()
        + runtime_binding(world, &sealed) + buffered_extents(world, &runtime)
        + compact_objects(world, &runtime) + compact_bindings(world, &runtime) + grouped_exports(world, &runtime)
        + packet_refusals(world, &runtime)
}

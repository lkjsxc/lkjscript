//! Toolchain sources are embedded by the same checked source loader.
pub fn library(path: &str) -> Option<Vec<u8>> {
    let text = match path {
        "$std/lib.lkj" => include_str!("../library/lib.lkj"),
        "$std/prelude.lkj" => include_str!("../library/prelude.lkj"),
        "$std/sequence.lkj" => include_str!("../library/sequence.lkj"),
        "$std/arena.lkj" => include_str!("../library/arena.lkj"),
        "$std/process_model.lkj" => include_str!("../library/process_model.lkj"),
        "$std/buffer.lkj" => include_str!("../library/buffer.lkj"),
        "$std/timers.lkj" => include_str!("../library/timers.lkj"),
        "$std/http_protocol.lkj" => include_str!("../library/http_protocol.lkj"),
        "$std/http_policy.lkj" => include_str!("../library/http_policy.lkj"),
        "$std/http_server.lkj" => include_str!("../library/http_server.lkj"),
        "$std/json.lkj" => include_str!("../library/json.lkj"),
        "$std/hmac.lkj" => include_str!("../library/hmac.lkj"),
        "$std/time.lkj" => include_str!("../library/time.lkj"),
        "$std/text.lkj" => include_str!("../library/text.lkj"),
        "$std/text_lower.lkj" => include_str!("../library/text_lower.lkj"),
        "$std/text_debug.lkj" => include_str!("../library/text_debug.lkj"),
        "$std/bytes.lkj" => include_str!("../library/bytes.lkj"),
        "$std/string.lkj" => include_str!("../library/string.lkj"),
        "$std/str.lkj" => include_str!("../library/str.lkj"),
        "$std/sha256.lkj" => include_str!("../library/sha256.lkj"),
        "$std/char.lkj" => include_str!("../library/char.lkj"),
        "$std/fmt.lkj" => include_str!("../library/fmt.lkj"),
        "$std/iter.lkj" => include_str!("../library/iter.lkj"),
        "$std/integer.lkj" => include_str!("../library/integer.lkj"),
        "$std/io.lkj" => include_str!("../library/io.lkj"),
        "$std/command.lkj" => include_str!("../library/command.lkj"),
        "$std/read_io.lkj" => include_str!("../library/read_io.lkj"),
        "$std/foreign.lkj" => include_str!("../library/foreign.lkj"),
        "$std/foreign_session.lkj" => include_str!("../library/foreign_session.lkj"),
        "$std/workers.lkj" => include_str!("../library/workers.lkj"),
        "$std/ordered_map.lkj" => include_str!("../library/ordered_map.lkj"),
        "$std/ordered_set.lkj" => include_str!("../library/ordered_set.lkj"),
        _ => return None,
    };
    Some(text.as_bytes().to_vec())
}
pub fn runtime() -> Option<String> {
    Some(include_str!("../library/runtime.lkj").to_string())
}

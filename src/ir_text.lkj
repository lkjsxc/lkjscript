//! Text IR is a flat instruction listing for inspection and adversarial checks.
use crate::diagnostic::{Diagnostic, Edit, Span};
use crate::ir::*;

type Result<T> = std::result::Result<T, Diagnostic>;

fn error(line: usize, message: &str) -> Diagnostic {
    Diagnostic::new(
        Span {
            file: 0,
            start: 0,
            end: 0,
            line,
            column: 1,
        },
        "E_IR_TEXT",
        message,
    )
}

fn hex(chars: &[char], at: &mut usize, line: usize) -> Result<u32> {
    let mut value = 0;
    for _ in 0..4 {
        let digit = chars
            .get(*at)
            .and_then(|c: &char| -> Option<u32> { c.to_digit(16) })
            .ok_or_else(|| error(line, "expected four hexadecimal digits after \\u"))?;
        value = value * 16 + digit;
        *at += 1;
    }
    Ok(value)
}

fn words(text: &str, line: usize) -> Result<Vec<String>> {
    let mut chars: Vec<char> = Vec::new();
    for c in text.chars() {
        chars.push(c);
    }
    let mut result = Vec::new();
    let mut at = 0;
    while at < chars.len() {
        if chars[at].is_whitespace() {
            at += 1;
            continue;
        }
        if chars[at] == '#' {
            break;
        }
        let mut word = String::new();
        if chars[at] == '"' {
            at += 1;
            let mut closed = false;
            while at < chars.len() {
                let c = chars[at];
                at += 1;
                if c == '"' {
                    closed = true;
                    break;
                }
                if c != '\\' {
                    if c.is_control() {
                        return Err(error(line, "control character in quoted string"));
                    }
                    word.push(c);
                    continue;
                }
                let escaped = *chars
                    .get(at)
                    .ok_or_else(|| error(line, "unfinished string escape"))?;
                at += 1;
                match escaped {
                    '"' | '\\' | '/' => word.push(escaped),
                    'n' => word.push('\n'),
                    'r' => word.push('\r'),
                    't' => word.push('\t'),
                    'b' => word.push('\u{0008}'),
                    'f' => word.push('\u{000c}'),
                    'u' => {
                        let mut value = hex(&chars, &mut at, line)?;
                        if value >= 0xd800 && value <= 0xdbff {
                            if chars.get(at) != Some(&'\\') || chars.get(at + 1) != Some(&'u') {
                                return Err(error(line, "high surrogate needs a low surrogate"));
                            }
                            at += 2;
                            let low = hex(&chars, &mut at, line)?;
                            if low < 0xdc00 || low > 0xdfff {
                                return Err(error(line, "invalid low surrogate"));
                            }
                            value = 0x10000 + (value - 0xd800) * 1024 + low - 0xdc00;
                        }
                        word.push(
                            char::from_u32(value)
                                .ok_or_else(|| error(line, "invalid Unicode scalar"))?,
                        );
                    }
                    _ => return Err(error(line, "unknown string escape")),
                }
            }
            if !closed {
                return Err(error(line, "unterminated quoted string"));
            }
            if at < chars.len() && !chars[at].is_whitespace() && chars[at] != '#' {
                return Err(error(line, "quoted word needs a separator"));
            }
        } else {
            while at < chars.len() && !chars[at].is_whitespace() && chars[at] != '#' {
                if chars[at] == '"' {
                    return Err(error(line, "quote inside an unquoted word"));
                }
                word.push(chars[at]);
                at += 1;
            }
        }
        result.push(word);
    }
    Ok(result)
}

fn word<'a>(words: &'a [String], at: usize, line: usize) -> Result<&'a str> {
    match words.get(at) {
        Some(value) => Ok(value.as_str()),
        None => Err(error(line, "missing operand")),
    }
}

fn number(words: &[String], at: usize, line: usize) -> Result<usize> {
    word(words, at, line)?
        .parse::<usize>()
        .map_err(|_| error(line, "invalid index or extent"))
}

fn exact(words: &[String], size: usize, line: usize) -> Result<()> {
    if words.len() != size {
        return Err(error(line, "wrong number of operands"));
    }
    Ok(())
}

fn flag(words: &[String], at: usize, yes: &str, no: &str, line: usize) -> Result<bool> {
    let value = word(words, at, line)?;
    if value == yes {
        Ok(true)
    } else if value == no {
        Ok(false)
    } else {
        Err(error(line, &format!("invalid flag {}; expected `{yes}` or `{no}` (docs/ir.md)", quoted(value))))
    }
}

// Error-path spelling help does not change which IR the parser accepts.
// Recover the fourth token's UTF-8 byte extent after normal lexing succeeded;
// search neither quoted names nor comments for the spelling being corrected.
fn affine_enum_edit(text: &str, row: &str, line: usize) -> Option<Edit> {
    let mut line_start = 0usize;
    let mut current = 1usize;
    for (at, byte) in text.as_bytes().iter().enumerate() {
        if current == line { break; }
        if *byte == b'\n' { current += 1usize; line_start = at + 1usize; }
    }
    if current != line { return None; }
    let mut chars: Vec<char> = Vec::new();
    let mut offsets: Vec<usize> = Vec::new();
    let mut offset = 0usize;
    for ch in row.chars() {
        offsets.push(offset);
        chars.push(ch);
        offset += ch.len_utf8();
    }
    offsets.push(offset);
    let mut at = 0usize;
    let mut token = 0usize;
    while at < chars.len() {
        if chars[at].is_whitespace() { at += 1usize; continue; }
        if chars[at] == '#' { return None; }
        let start = at;
        if chars[at] == '"' {
            at += 1usize;
            while at < chars.len() {
                let ch = chars[at];
                at += 1usize;
                if ch == '"' { break; }
                if ch == '\\' && at < chars.len() { at += 1usize; }
            }
        } else {
            while at < chars.len() && !chars[at].is_whitespace() && chars[at] != '#' {
                at += 1usize;
            }
        }
        if token == 3usize {
            return Some(Edit {
                start: line_start + offsets[start],
                end: line_start + offsets[at],
                replacement: "move".to_string(),
            });
        }
        token += 1usize;
    }
    None
}

fn enum_flag(text: &str, row: &str, words: &[String], line: usize) -> Result<bool> {
    match flag(words, 3usize, "copy", "move", line) {
        Ok(copy) => Ok(copy),
        Err(mut problem) => {
            let value = word(words, 3usize, line)?;
            problem.message = format!("invalid enum flag {}; expected `copy` or `move` (docs/ir.md, Types)", quoted(value));
            if value == "affine" {
                problem.message.push_str("; help: use `move` for a non-Copy affine enum");
                if let Some(edit) = affine_enum_edit(text, row, line) { problem.edits.push(edit); }
            }
            Err(problem)
        }
    }
}

fn fields(words: &[String], start: usize, line: usize) -> Result<Vec<Field>> {
    if (words.len() - start) % 2 != 0 {
        return Err(error(line, "field needs a name and type index"));
    }
    let mut result = Vec::new();
    let mut at = start;
    while at < words.len() {
        result.push(Field {
            name: words[at].clone(),
            ty: number(words, at + 1, line)?,
        });
        at += 2;
    }
    Ok(result)
}

fn indices(words: &[String], start: usize, line: usize) -> Result<Vec<usize>> {
    let mut result = Vec::new();
    for at in start..words.len() {
        result.push(number(words, at, line)?);
    }
    Ok(result)
}

fn place(words: &[String], start: usize, line: usize) -> Result<Place> {
    let mut result = Place::local(number(words, start, line)?);
    let mut at = start + 1;
    while at < words.len() {
        let projection = match words[at].as_str() {
            "deref" => {
                at += 1;
                Projection::Deref
            }
            "field" => {
                let index = number(words, at + 1, line)?;
                at += 2;
                Projection::Field(index)
            }
            "index" => {
                let index = number(words, at + 1, line)?;
                at += 2;
                Projection::Index(index)
            }
            "variant" => {
                let tag = number(words, at + 1, line)?;
                let index = number(words, at + 2, line)?;
                at += 3;
                Projection::VariantField(tag, index)
            }
            _ => return Err(error(line, "unknown place projection")),
        };
        result.projections.push(projection);
    }
    Ok(result)
}

fn instruction(words: &[String], line: usize) -> Result<Instruction> {
    let location = word(words, 0, line)?
        .strip_prefix('@')
        .ok_or_else(|| error(line, "instruction needs @[file/]source-line[:column]"))?;
    let (file, location) = match location.split_once('/') {
        Some((file, location)) => (
            Some(file.parse::<usize>().map_err(|_| error(line, "invalid source file"))?),
            location,
        ),
        None => (None, location),
    };
    let (source_line, column) = location.split_once(':').unwrap_or((location, "1"));
    let source_line = source_line
        .parse::<usize>()
        .map_err(|_| error(line, "invalid source line"))?;
    let column = column
        .parse::<usize>()
        .map_err(|_| error(line, "invalid source column"))?;
    let op = match word(words, 1, line)? {
        "text" => {
            exact(words, 4, line)?;
            let encoded = word(words, 3, line)?.as_bytes();
            if encoded.len() % 2 != 0 {
                return Err(error(
                    line,
                    "text bytes require pairs of hexadecimal digits",
                ));
            }
            let mut bytes = Vec::new();
            let mut at = 0;
            while at < encoded.len() {
                let mut value: u8 = 0;
                for _ in 0..2 {
                    let digit = encoded[at];
                    let nibble = if digit >= b'0' && digit <= b'9' {
                        digit - b'0'
                    } else if digit >= b'a' && digit <= b'f' {
                        digit - b'a' + 10
                    } else if digit >= b'A' && digit <= b'F' {
                        digit - b'A' + 10
                    } else {
                        return Err(error(line, "invalid text byte encoding"));
                    };
                    value = value * 16 + nibble;
                    at += 1;
                }
                bytes.push(value);
            }
            Op::Text {
                dst: number(words, 2, line)?,
                bytes,
            }
        }
        "int" => {
            exact(words, 4, line)?;
            Op::Int {
                dst: number(words, 2, line)?,
                value: word(words, 3, line)?
                    .parse::<i64>()
                    .map_err(|_| error(line, "invalid signed integer"))?,
            }
        }
        "float" => {
            exact(words, 4, line)?;
            Op::Float {
                dst: number(words, 2, line)?,
                bits: word(words, 3, line)?
                    .parse::<u64>()
                    .map_err(|_| error(line, "invalid float bit pattern"))?,
            }
        }
        "unit" => {
            exact(words, 3, line)?;
            Op::Unit {
                dst: number(words, 2, line)?,
            }
        }
        "read" => Op::Read {
            dst: number(words, 2, line)?,
            moving: flag(words, 3, "move", "copy", line)?,
            place: place(words, 4, line)?,
        },
        "array" => Op::Array {
            dst: number(words, 2, line)?,
            elements: indices(words, 3, line)?,
        },
        "slice-borrow" => Op::SliceBorrow {
            dst: number(words, 2, line)?,
            mutable: flag(words, 3, "mut", "shared", line)?,
            place: place(words, 4, line)?,
        },
        "view-range" => Op::ViewRange {
            dst: number(words, 2, line)?,
            mutable: flag(words, 3, "mut", "shared", line)?,
            inclusive: flag(words, 4, "inclusive", "exclusive", line)?,
            start: number(words, 5, line)?,
            end: number(words, 6, line)?,
            place: place(words, 7, line)?,
        },
        "borrow" => Op::Borrow {
            dst: number(words, 2, line)?,
            mutable: flag(words, 3, "mut", "shared", line)?,
            place: place(words, 4, line)?,
        },
        "assign" => Op::Assign {
            src: number(words, 2, line)?,
            place: place(words, 3, line)?,
        },
        "drop" => Op::Drop {
            place: place(words, 2, line)?,
        },
        "drop-if" => Op::DropIf {
            place: place(words, 2, line)?,
        },
        "unary" => {
            exact(words, 5, line)?;
            Op::Unary {
                dst: number(words, 2, line)?,
                op: UnaryOp::parse(word(words, 3, line)?)
                    .ok_or_else(|| error(line, "unknown unary operation"))?,
                src: number(words, 4, line)?,
            }
        }
        "binary" => {
            exact(words, 6, line)?;
            Op::Binary {
                dst: number(words, 2, line)?,
                op: BinaryOp::parse(word(words, 3, line)?)
                    .ok_or_else(|| error(line, "unknown binary operation"))?,
                left: number(words, 4, line)?,
                right: number(words, 5, line)?,
            }
        }
        "call" => Op::Call {
            dst: number(words, 2, line)?,
            function: number(words, 3, line)?,
            args: indices(words, 4, line)?,
        },
        "struct" => Op::Struct {
            dst: number(words, 2, line)?,
            fields: indices(words, 3, line)?,
        },
        "variant" => Op::Variant {
            dst: number(words, 2, line)?,
            variant: number(words, 3, line)?,
            fields: indices(words, 4, line)?,
        },
        "tag" => {
            exact(words, 4, line)?;
            Op::Discriminant {
                dst: number(words, 2, line)?,
                src: number(words, 3, line)?,
            }
        }
        "tag-test" => {
            exact(words, 5, line)?;
            Op::TagTest {
                dst: number(words, 2, line)?,
                place: Place::local(number(words, 3, line)?),
                variant: number(words, 4, line)?,
            }
        }
        "tag-test-place" => Op::TagTest {
            dst: number(words, 2, line)?,
            variant: number(words, 3, line)?,
            place: place(words, 4, line)?,
        },
        "intrinsic" => Op::Intrinsic {
            dst: number(words, 2, line)?,
            name: IntrinsicOp::parse(word(words, 3, line)?)
                .ok_or_else(|| error(line, "unknown intrinsic operation"))?,
            args: indices(words, 4, line)?,
        },
        "if" => {
            exact(words, 3, line)?;
            Op::If {
                condition: number(words, 2, line)?,
            }
        }
        "break-to" | "continue-to" => {
            exact(words, 3, line)?;
            let depth = number(words, 2, line)?;
            if words[1] == "break-to" {
                Op::BreakTo { depth }
            } else {
                Op::ContinueTo { depth }
            }
        }
        "return" => {
            exact(words, 3, line)?;
            Op::Return {
                src: number(words, 2, line)?,
            }
        }
        "trap" => {
            exact(words, 3, line)?;
            Op::Trap {
                message: word(words, 2, line)?.to_string(),
            }
        }
        name => {
            exact(words, 2, line)?;
            match name {
                "else" => Op::Else,
                "end" => Op::End,
                "loop" => Op::Loop,
                "break" => Op::Break,
                "continue" => Op::Continue,
                _ => return Err(error(line, "unknown instruction")),
            }
        }
    };
    Ok(Instruction {
        op,
        file,
        line: source_line,
        column,
    })
}

/// Parse text into unchecked IR. Only check::check may grant backend access.
pub fn read(text: &str) -> Result<Program> {
    if text.is_empty() {
        return Err(error(1, "expected lkjscript-ir 1 header"));
    }
    let mut program = Program {
        sources: Vec::new(), destructors: Vec::new(),
        types: Vec::new(),
        functions: Vec::new(),
    };
    let mut current: Option<Function> = None;
    let mut enumeration: Option<Type> = None;
    let mut last_line = 1;
    for (offset, line_text) in text.lines().enumerate() {
        let line = offset + 1;
        last_line = line;
        if offset == 0 {
            if line_text != "lkjscript-ir 1" {
                return Err(error(1, "expected lkjscript-ir 1 header"));
            }
            continue;
        }
        let words = words(line_text, line)?;
        if words.is_empty() {
            continue;
        }
        if let Some(mut ty) = enumeration.take() {
            match words[0].as_str() {
                "variant" => {
                    let variant = Variant {
                        name: word(&words, 1, line)?.to_string(),
                        fields: fields(&words, 2, line)?,
                    };
                    if let TypeKind::Enum { variants, .. } = &mut ty.kind {
                        variants.push(variant);
                    }
                    enumeration = Some(ty);
                }
                "endtype" => {
                    exact(&words, 1, line)?;
                    program.types.push(ty);
                }
                _ => return Err(error(line, "expected variant or endtype")),
            }
            continue;
        }
        if let Some(mut function) = current.take() {
            match words[0].as_str() {
                "local" => {
                    exact(&words, 4, line)?;
                    function.locals.push(Local {
                        name: words[1].clone(),
                        ty: number(&words, 2, line)?,
                        mutable: flag(&words, 3, "mut", "let", line)?,
                    });
                }
                "return-leaf" => {
                    let pivot = words
                        .iter()
                        .position(|word| matches!(word.as_str(), "exact" | "bound" | "static"))
                        .ok_or_else(|| {
                            error(line, "return leaf needs exact, bound, or static origin")
                        })?;
                    let result = place(&words[..pivot], 1, line)?;
                    if result.local != 0 {
                        return Err(error(line, "result place uses root zero"));
                    }
                    let origin = if words[pivot] == "static" {
                        exact(&words, pivot + 1, line)?;
                        LeafOrigin::Static
                    } else {
                        let mut inputs = Vec::new();
                        for words in words[pivot + 1..].split(|word| word == "or") {
                            let input = place(words, 0, line)?;
                            inputs.push(InputLeaf {
                                index: input.local,
                                projections: input.projections,
                            });
                        }
                        LeafOrigin::Inputs {
                            inputs,
                            exact: words[pivot] == "exact",
                        }
                    };
                    if function.return_source.is_none() {
                        function.return_source = Some(ReturnSource::Leaves(Vec::new()));
                    }
                    match &mut function.return_source {
                        Some(ReturnSource::Leaves(leaves)) => leaves.push(ReturnLeaf {
                            projections: result.projections,
                            origin,
                        }),
                        _ => {
                            return Err(error(
                                line,
                                "cannot combine aggregate and per-leaf return contracts",
                            ));
                        }
                    }
                }
                "endfn" => {
                    exact(&words, 1, line)?;
                    program.functions.push(function);
                    continue;
                }
                _ => function.body.push(instruction(&words, line)?),
            }
            current = Some(function);
            continue;
        }
        match words[0].as_str() {
            "source" => {
                exact(&words, 2, line)?;
                program.sources.push(words[1].clone());
            }
            "type" => {
                let name = word(&words, 1, line)?.to_string();
                let kind = match word(&words, 2, line)? {
                    "unit" => {
                        exact(&words, 3, line)?;
                        TypeKind::Unit
                    }
                    "bool" => {
                        exact(&words, 3, line)?;
                        TypeKind::Bool
                    }
                    "char" => {
                        exact(&words, 3, line)?;
                        TypeKind::Char
                    }
                    "f64" => {
                        exact(&words, 3, line)?;
                        TypeKind::F64
                    }
                    "str" => {
                        exact(&words, 3, line)?;
                        TypeKind::Str
                    }
                    "world" => {
                        exact(&words, 3, line)?;
                        TypeKind::World
                    }
                    "stdout" => {
                        exact(&words, 3, line)?;
                        TypeKind::Stdout
                    }
                    "stdin" | "stderr" | "directory" | "read_directory" | "read_file" | "image" | "channel" | "worker" | "read_region" | "foreign_command" | "foreign_session" | "null_device" | "file" | "process" | "clock" | "child"
                    | "listener" | "connector" | "tcp_port" | "readiness" | "entropy" | "stop"
                    | "arguments" | "environment" | "exit_status" => {
                        exact(&words, 3, line)?;
                        match words[2].as_str() {
                            "arguments" => TypeKind::Arguments,
                            "environment" => TypeKind::Environment,
                            "exit_status" => TypeKind::ExitStatus,
                            "stdin" => TypeKind::Stdin,
                            "stderr" => TypeKind::Stderr,
                            "directory" => TypeKind::Directory,
                            "read_directory" => TypeKind::ReadDirectory,
                            "read_file" => TypeKind::ReadFile,
                            "image" => TypeKind::Image,
                            "channel" => TypeKind::Channel,
                            "worker" => TypeKind::Worker,
                            "read_region" => TypeKind::ReadRegion,
                            "foreign_command" => TypeKind::ForeignCommand,
                            "foreign_session" => TypeKind::ForeignSession,
                            "null_device" => TypeKind::NullDevice,
                            "process" => TypeKind::Process,
                            "clock" => TypeKind::Clock,
                            "child" => TypeKind::Child,
                            "listener" => TypeKind::Listener,
                            "connector" => TypeKind::Connector,
                            "tcp_port" => TypeKind::TcpPort,
                            "readiness" => TypeKind::Readiness,
                            "entropy" => TypeKind::Entropy,
                            "stop" => TypeKind::Stop,
                            _ => TypeKind::File,
                        }
                    }
                    "int" => {
                        exact(&words, 5, line)?;
                        let bits = word(&words, 3, line)?
                            .parse::<u8>()
                            .map_err(|_| error(line, "invalid integer bit width"))?;
                        TypeKind::Int {
                            bits,
                            signed: flag(&words, 4, "signed", "unsigned", line)?,
                        }
                    }
                    "ref" | "slice" => {
                        exact(&words, 5, line)?;
                        let mutable = flag(&words, 3, "mut", "shared", line)?;
                        let inner = number(&words, 4, line)?;
                        if words[2] == "ref" {
                            TypeKind::Ref { inner, mutable }
                        } else {
                            TypeKind::Slice { inner, mutable }
                        }
                    }
                    "array" => {
                        exact(&words, 5, line)?;
                        TypeKind::Array {
                            inner: number(&words, 3, line)?,
                            len: number(&words, 4, line)?,
                        }
                    }
                    "vec" | "box" => {
                        exact(&words, 4, line)?;
                        let inner = number(&words, 3, line)?;
                        if words[2] == "vec" {
                            TypeKind::Vec { inner }
                        } else {
                            TypeKind::Box { inner }
                        }
                    }
                    "struct" => TypeKind::Struct {
                        copy: flag(&words, 3, "copy", "move", line)?,
                        fields: fields(&words, 4, line)?,
                    },
                    "enum" => {
                        exact(&words, 4, line)?;
                        TypeKind::Enum {
                            copy: enum_flag(text, line_text, &words, line)?,
                            variants: Vec::new(),
                        }
                    }
                    _ => return Err(error(line, "unknown type shape")),
                };
                if matches!(kind, TypeKind::Enum { .. }) {
                    enumeration = Some(Type { name, kind });
                } else {
                    program.types.push(Type { name, kind });
                }
            }
            "destructor" => {
                exact(&words, 3, line)?;
                program
                    .destructors
                    .push((number(&words, 1, line)?, number(&words, 2, line)?));
            }
            "fn" => {
                if words.len() < 4 {
                    return Err(error(
                        line,
                        "function needs name, parameter count, and result type",
                    ));
                }
                let mut test = false;
                let mut return_source = None;
                let mut file = None;
                let mut at = 4;
                while at < words.len() {
                    match words[at].as_str() {
                        "test" if !test => {
                            test = true;
                            at += 1;
                        }
                        "file" if file.is_none() => {
                            file = Some(number(&words, at + 1, line)?);
                            at += 2;
                        }
                        "from" if return_source.is_none() => {
                            return_source = Some(if word(&words, at + 1, line)? == "static" {
                                ReturnSource::Static
                            } else {
                                let mut end = at + 2;
                                while end < words.len()
                                    && !matches!(words[end].as_str(), "test" | "file" | "from")
                                {
                                    end += 1;
                                }
                                let source = place(&words[..end], at + 1, line)?;
                                at = end - 2;
                                ReturnSource::Parameter {
                                    index: source.local,
                                    projections: source.projections,
                                }
                            });
                            at += 2;
                        }
                        _ => return Err(error(line, "unknown or repeated function flag")),
                    }
                }
                current = Some(Function {
                    file: file.unwrap_or(0),
                    name: words[1].clone(),
                    params: number(&words, 2, line)?,
                    result: number(&words, 3, line)?,
                    return_source,
                    locals: Vec::new(),
                    body: Vec::new(),
                    test,
                });
            }
            _ => return Err(error(line, "expected type or function")),
        }
    }
    if enumeration.is_some() {
        return Err(error(last_line, "missing endtype"));
    }
    if current.is_some() {
        return Err(error(last_line, "missing endfn"));
    }
    Ok(program)
}

fn quoted(text: &str) -> String {
    let mut result = String::from("\"");
    for c in text.chars() {
        match c {
            '"' => result.push_str("\\\""),
            '\\' => result.push_str("\\\\"),
            '\n' => result.push_str("\\n"),
            '\r' => result.push_str("\\r"),
            '\t' => result.push_str("\\t"),
            c if c.is_control() => result.push_str(&format!("\\u{:04x}", c as u32)),
            _ => result.push(c),
        }
    }
    result.push('"');
    result
}

fn write_fields(text: &mut String, fields: &[Field]) {
    for field in fields {
        text.push_str(&format!(" {} {}", quoted(&field.name), field.ty));
    }
}

fn write_indices(text: &mut String, indices: &[usize]) {
    for index in indices {
        text.push_str(&format!(" {index}"));
    }
}

fn write_place(text: &mut String, place: &Place) {
    text.push_str(&format!(" {}", place.local));
    write_projections(text, &place.projections);
}
fn write_projections(text: &mut String, projections: &[Projection]) {
    for projection in projections {
        match projection {
            Projection::Deref => text.push_str(" deref"),
            Projection::Field(field) => text.push_str(&format!(" field {field}")),
            Projection::VariantField(variant, field) => {
                text.push_str(&format!(" variant {variant} {field}"))
            }
            Projection::Index(index) => text.push_str(&format!(" index {index}")),
        }
    }
}

fn write_instruction(text: &mut String, instruction: &Instruction) {
    text.push('@');
    if let Some(file) = instruction.file { text.push_str(&format!("{file}/")); }
    text.push_str(&format!("{}:{} ", instruction.line, instruction.column));
    match &instruction.op {
        Op::Text { dst, bytes } => {
            let mut encoded = String::new();
            for byte in bytes {
                encoded.push_str(&format!("{byte:02x}"));
            }
            text.push_str(&format!("text {dst} {}", quoted(&encoded)));
        }
        Op::Int { dst, value } => text.push_str(&format!("int {dst} {value}")),
        Op::Float { dst, bits } => text.push_str(&format!("float {dst} {bits}")),
        Op::Unit { dst } => text.push_str(&format!("unit {dst}")),
        Op::Read { dst, place, moving } => {
            text.push_str(&format!(
                "read {dst} {}",
                if *moving { "move" } else { "copy" }
            ));
            write_place(text, place);
        }
        Op::Borrow {
            dst,
            place,
            mutable,
        } => {
            text.push_str(&format!(
                "borrow {dst} {}",
                if *mutable { "mut" } else { "shared" }
            ));
            write_place(text, place);
        }
        Op::Array { dst, elements } => {
            text.push_str(&format!("array {dst}"));
            write_indices(text, elements);
        }
        Op::SliceBorrow {
            dst,
            place,
            mutable,
        } => {
            text.push_str(&format!(
                "slice-borrow {dst} {}",
                if *mutable { "mut" } else { "shared" }
            ));
            write_place(text, place);
        }
        Op::ViewRange {
            dst,
            place,
            start,
            end,
            inclusive,
            mutable,
        } => {
            text.push_str(&format!(
                "view-range {dst} {} {} {start} {end}",
                if *mutable { "mut" } else { "shared" },
                if *inclusive { "inclusive" } else { "exclusive" },
            ));
            write_place(text, place);
        }
        Op::Assign { place, src } => {
            text.push_str(&format!("assign {src}"));
            write_place(text, place);
        }
        Op::Drop { place } => {
            text.push_str("drop");
            write_place(text, place);
        }
        Op::DropIf { place } => {
            text.push_str("drop-if");
            write_place(text, place);
        }
        Op::Unary { dst, op, src } => {
            text.push_str(&format!("unary {dst} {} {src}", quoted(op.as_str())))
        }
        Op::Binary {
            dst,
            op,
            left,
            right,
        } => text.push_str(&format!(
            "binary {dst} {} {left} {right}",
            quoted(op.as_str())
        )),
        Op::Call {
            dst,
            function,
            args,
        } => {
            text.push_str(&format!("call {dst} {function}"));
            write_indices(text, args);
        }
        Op::Struct { dst, fields } => {
            text.push_str(&format!("struct {dst}"));
            write_indices(text, fields);
        }
        Op::Variant {
            dst,
            variant,
            fields,
        } => {
            text.push_str(&format!("variant {dst} {variant}"));
            write_indices(text, fields);
        }
        Op::Discriminant { dst, src } => text.push_str(&format!("tag {dst} {src}")),
        Op::TagTest {
            dst,
            place,
            variant,
        } => {
            text.push_str(&format!("tag-test-place {dst} {variant}"));
            write_place(text, place);
        }
        Op::Intrinsic { dst, name, args } => {
            text.push_str(&format!("intrinsic {dst} {}", quoted(name.as_str())));
            write_indices(text, args);
        }
        Op::If { condition } => text.push_str(&format!("if {condition}")),
        Op::Else => text.push_str("else"),
        Op::End => text.push_str("end"),
        Op::Loop => text.push_str("loop"),
        Op::Break => text.push_str("break"),
        Op::Continue => text.push_str("continue"),
        Op::BreakTo { depth } => text.push_str(&format!("break-to {depth}")),
        Op::ContinueTo { depth } => text.push_str(&format!("continue-to {depth}")),
        Op::Return { src } => text.push_str(&format!("return {src}")),
        Op::Trap { message } => text.push_str(&format!("trap {}", quoted(message))),
    }
    text.push('\n');
}

/// Source-less IR is its own source: annotate actual input lines before admission.
/// Explicit source maps retain the producer's recorded locations unchanged.
pub fn read_located(text: &str, path: &str) -> Result<Program> {
    let mut program = read(text)?;
    if !program.sources.is_empty() { return Ok(program); }
    program.sources.push(path.to_string());
    let mut function = 0usize;
    let mut instruction_index = 0usize;
    let mut inside = false;
    for (offset, line_text) in text.lines().enumerate() {
        let line = offset + 1;
        let fields = words(line_text, line)?;
        if fields.is_empty() { continue; }
        if fields[0] == "fn" {
            inside = true;
            instruction_index = 0;
            program.functions[function].file = 0;
        } else if fields[0] == "endfn" {
            inside = false;
            function += 1;
        } else if inside && fields[0] != "local" && fields[0] != "return-leaf" {
            let instruction = &mut program.functions[function].body[instruction_index];
            instruction.file = None;
            instruction.line = line;
            instruction.column = 1;
            instruction_index += 1;
        }
    }
    Ok(program)
}

pub fn write(program: &Program) -> String {
    let mut text = "lkjscript-ir 1\n".to_string();
    for source in &program.sources { text.push_str(&format!("source {}\n", quoted(source))); }
    for ty in &program.types {
        text.push_str(&format!("type {} ", quoted(&ty.name)));
        match &ty.kind {
            TypeKind::Unit => text.push_str("unit"),
            TypeKind::Bool => text.push_str("bool"),
            TypeKind::Char => text.push_str("char"),
            TypeKind::F64 => text.push_str("f64"),
            TypeKind::Str => text.push_str("str"),
            TypeKind::World => text.push_str("world"),
            TypeKind::Arguments => text.push_str("arguments"),
            TypeKind::Environment => text.push_str("environment"),
            TypeKind::ExitStatus => text.push_str("exit_status"),
            TypeKind::Stdout => text.push_str("stdout"),
            TypeKind::Stdin => text.push_str("stdin"),
            TypeKind::Stderr => text.push_str("stderr"),
            TypeKind::Directory => text.push_str("directory"),
            TypeKind::ReadDirectory => text.push_str("read_directory"),
            TypeKind::ReadFile => text.push_str("read_file"),
            TypeKind::Image => text.push_str("image"),
            TypeKind::Channel => text.push_str("channel"),
            TypeKind::Worker => text.push_str("worker"),
            TypeKind::ReadRegion => text.push_str("read_region"),
            TypeKind::ForeignCommand => text.push_str("foreign_command"),
            TypeKind::ForeignSession => text.push_str("foreign_session"),
            TypeKind::NullDevice => text.push_str("null_device"),
            TypeKind::File => text.push_str("file"),
            TypeKind::Process => text.push_str("process"),
            TypeKind::Clock => text.push_str("clock"),
            TypeKind::Child => text.push_str("child"),
            TypeKind::Listener => text.push_str("listener"),
            TypeKind::Connector => text.push_str("connector"),
            TypeKind::TcpPort => text.push_str("tcp_port"),
            TypeKind::Readiness => text.push_str("readiness"),
            TypeKind::Entropy => text.push_str("entropy"),
            TypeKind::Stop => text.push_str("stop"),
            TypeKind::Int { bits, signed } => text.push_str(&format!(
                "int {bits} {}",
                if *signed { "signed" } else { "unsigned" }
            )),
            TypeKind::Ref { inner, mutable } | TypeKind::Slice { inner, mutable } => {
                text.push_str(&format!(
                    "{} {} {inner}",
                    if matches!(ty.kind, TypeKind::Ref { .. }) {
                        "ref"
                    } else {
                        "slice"
                    },
                    if *mutable { "mut" } else { "shared" }
                ));
            }
            TypeKind::Array { inner, len } => text.push_str(&format!("array {inner} {len}")),
            TypeKind::Vec { inner } => text.push_str(&format!("vec {inner}")),
            TypeKind::Box { inner } => text.push_str(&format!("box {inner}")),
            TypeKind::Struct { fields, copy } => {
                text.push_str(if *copy { "struct copy" } else { "struct move" });
                write_fields(&mut text, fields);
            }
            TypeKind::Enum { variants, copy } => {
                text.push_str(if *copy { "enum copy\n" } else { "enum move\n" });
                for variant in variants {
                    text.push_str(&format!("variant {}", quoted(&variant.name)));
                    write_fields(&mut text, &variant.fields);
                    text.push('\n');
                }
                text.push_str("endtype");
            }
        }
        text.push('\n');
    }
    for (ty, function) in &program.destructors {
        text.push_str(&format!("destructor {ty} {function}\n"));
    }
    for function in &program.functions {
        write_function_into(&mut text, function);
    }
    text
}

fn write_function_into(text: &mut String, function: &Function) {
    text.push_str(&format!(
        "fn {} {} {}",
        quoted(&function.name),
        function.params,
        function.result
    ));
    if function.file != 0 {
        text.push_str(&format!(" file {}", function.file));
    }
    if let Some(source) = &function.return_source {
        match source {
            ReturnSource::Parameter { index, projections } => {
                text.push_str(&format!(" from {index}"));
                write_projections(text, projections);
            }
            ReturnSource::Static => text.push_str(" from static"),
            ReturnSource::Leaves(_) => {}
        }
    }
    if function.test {
        text.push_str(" test");
    }
    text.push('\n');
    if let Some(ReturnSource::Leaves(leaves)) = &function.return_source {
        for leaf in leaves {
            text.push_str("return-leaf 0");
            write_projections(text, &leaf.projections);
            match &leaf.origin {
                LeafOrigin::Static => text.push_str(" static"),
                LeafOrigin::Inputs { inputs, exact } => {
                    text.push_str(if *exact { " exact " } else { " bound " });
                    for (index, input) in inputs.iter().enumerate() {
                        if index != 0 {
                            text.push_str(" or ");
                        }
                        text.push_str(&format!("{}", input.index));
                        write_projections(text, &input.projections);
                    }
                }
            }
            text.push('\n');
        }
    }
    for local in &function.locals {
        text.push_str(&format!(
            "local {} {} {}\n",
            quoted(&local.name),
            local.ty,
            if local.mutable { "mut" } else { "let" }
        ));
    }
    for instruction in &function.body {
        write_instruction(text, instruction);
    }
    text.push_str("endfn\n");
}

/// Canonical local body bytes for content identities, without cloning the body.
pub(crate) fn write_function(function: &Function) -> String {
    let mut text = String::new();
    write_function_into(&mut text, function);
    text
}

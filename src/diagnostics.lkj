//! Reporting data does not carry checked IR and cannot authorize emission.
mod static_label_edits;
mod borrow_edits;
mod consumer_edits;
mod site_edits;
mod iterator_edits;
use crate::ast::{Span, Type};
use crate::source::SourceReport;
use std::collections::BTreeSet;

#[derive(Clone)]
pub struct BlockedRegion {
    pub path: String,
    pub span: Span,
    pub kind: String,
    pub reason: String,
}

/// A refused source region and its exact cause. This is diagnostic metadata, never
/// evidence that a recovered declaration, body or namespace is complete. Empty
/// names with namespace=true poison the whole indicated namespace conservatively.
#[derive(Clone)]
pub struct Recovery {
    pub span: Span,
    pub scope: usize,
    pub block: Option<usize>,
    pub kind: String,
    pub names: Vec<String>,
    pub namespace: bool,
    pub coherence: bool,
    pub diagnostic: crate::ast::Diagnostic,
}

/// Report every recognized unsupported site, including those after the first
/// failed body. Existing diagnostics retain their more specific explanation.
pub fn complete_unsupported(report: &mut SourceReport) {
    let original = report.program.clone();
    crate::resolve::bind_lexical_scopes(&mut report.program);
    complete_lexical_unsupported(report);
    report.program = original;
}

fn complete_lexical_unsupported(report: &mut SourceReport) {
    site_edits::complete(report);
    static_label_edits::complete(&report.program, &mut report.diagnostics);
    iterator_edits::complete(&report.program, &mut report.diagnostics);
    consumer_edits::complete(&report.program, &mut report.diagnostics);
    borrow_edits::complete(&report.program, &mut report.diagnostics);
    let mut seen: BTreeSet<(usize, usize, usize)> = BTreeSet::new();
    for problem in &report.diagnostics {
        seen.insert((problem.file, problem.line, problem.column));
    }
    for node in &report.program.types {
        let span = node.span;
        if matches!(node.kind, Type::Function { .. })
            && seen.insert((span.file, span.line, span.column))
        {
            let mut problem = crate::ast::Diagnostic::new(
                span,
                "E_UNSUPPORTED",
                "unsupported construct: function pointer",
            );
            if let Some(file) = report.program.files.get(span.file) {
                problem.path = file.path.clone();
            }
            report.diagnostics.push(problem);
        }
    }
}

/// Machine-applicable replacements refer to byte offsets in this exact input,
/// never to line/column display coordinates or an already edited intermediate.
pub fn edit_record(path: &str, problem: &crate::diagnostic::Diagnostic) -> String {
    let mut out: Vec<u8> = Vec::new();
    out.extend_from_slice(b"LKJSCRIPT_EDITS {\"version\":1,\"path\":");
    crate::json::write_string(&mut out, path);
    out.extend_from_slice(b",\"code\":");
    crate::json::write_string(&mut out, &problem.code);
    out.extend_from_slice(b",\"edits\":[");
    for (index, edit) in problem.edits.iter().enumerate() {
        if index != 0 { out.push(b','); }
        out.extend_from_slice(
            format!("{{\"start\":{},\"end\":{},\"replacement\":", edit.start, edit.end).as_bytes(),
        );
        crate::json::write_string(&mut out, &edit.replacement);
        out.push(b'}');
    }
    out.extend_from_slice(b"]}");
    String::from_utf8(out).unwrap()
}

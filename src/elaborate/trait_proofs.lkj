//! Typed callable prerequisites extend the ordinary iterative trait solver.
//! Type equations do not prove a bound; full callable evidence is checked only
//! after every ordinary prerequisite. Session evidence is discarded afterward.
use super::{Compiler, Result, a, err};
use crate::generics::{
    BoundContext, BoundSolver, BoundStep, Goal, ImplementationWitness, TraitIdentity,
};
use std::collections::{BTreeMap, BTreeSet};

#[derive(Default)]
pub(super) struct Session {
    active: BTreeSet<Goal>,
    pub(super) arguments: Vec<Goal>,
    proved: BTreeMap<Goal, Option<ImplementationWitness>>,
    projections: BTreeMap<Goal, BTreeMap<String, usize>>,
}

impl Compiler<'_> {
    pub(super) fn active_associated_type(
        &self,
        receiver: usize,
        bound: &TraitIdentity,
        member: &str,
    ) -> Option<usize> {
        let session = self.trait_proofs.as_ref()?;
        let goal = Goal { ty: receiver, bound: bound.clone() };
        session.projections.get(&goal)?.get(&member.to_string()).copied()
    }

    fn infer_implementation(
        &mut self,
        mut witness: ImplementationWitness,
    ) -> Result<ImplementationWitness> {
        let parameters = self.source.impls[witness.implementation].generics.clone();
        self.prepare_callable_arguments(&parameters, &mut witness.substitutions)?;
        Ok(witness)
    }

    fn validate_implementation(
        &mut self,
        goal: &Goal,
        mut witness: ImplementationWitness,
        constraints: &[(a::TypeId, usize, Option<BTreeMap<String, usize>>)],
    ) -> Result<ImplementationWitness> {
        let parameters = self.source.impls[witness.implementation].generics.clone();
        witness.substitutions.insert("Self".to_string(), goal.ty);
        // Child proofs are already available in this session. Resolving an
        // associated projection consumes that evidence, not a trait-name guess.
        self.prepare_parameter_associated(&parameters, &mut witness.substitutions)?;
        for (bound, ty, environment) in constraints {
            let node = self.source.types[*bound].clone();
            let a::Type::Path(path) = node.kind else {
                return Err(err(
                    node.span,
                    "E_TRAIT",
                    "invalid parameterized trait prerequisite",
                ));
            };
            let _ = path;
            // Implementation prerequisites consume the completed callable and
            // projection environment. Declared trait parameters keep their own
            // names and must never capture same-spelled implementation names.
            let environment = environment.as_ref().unwrap_or(&witness.substitutions);
            self.check_type_bound(*ty, *bound, environment, node.span)?;
        }
        let predicates = self.source.impls[witness.implementation].predicates.clone();
        let trait_predicates = goal.bound.declaration().map_or(Vec::new(), |index| self.source.traits[index].predicates.clone());
        if predicates.is_empty() && trait_predicates.is_empty() { return Ok(witness); }
        if self.trait_proofs.as_ref().unwrap().projections.contains_key(goal) {
            return Err(err(self.source.impls[witness.implementation].span, "E_TRAIT",
                "recursive implementation predicates do not establish a trait witness"));
        }
        // The selected implementation supplies equations for its associated
        // types while its own predicates are checked. Those equations do not
        // establish the trait goal: recursive satisfaction still fails through
        // Session.active until every outer prerequisite has been proved.
        let associated = self.implementation_associated(witness.implementation, witness.substitutions.clone())?;
        let proved = self.trait_proofs.as_ref().unwrap().proved.clone();
        self.trait_proofs.as_mut().unwrap().projections.insert(goal.clone(), associated);
        let mut checked = self.check_where_predicates(&predicates, &witness.substitutions);
        if checked.is_ok() {
            let environment = self.trait_environment(goal.ty, &goal.bound);
            checked = self.check_where_predicates(&trait_predicates, &environment);
        }
        let session = self.trait_proofs.as_mut().unwrap();
        session.projections.remove(goal);
        if checked.is_err() { session.proved = proved; }
        checked?;
        Ok(witness)
    }

    fn prove_identity(
        &mut self,
        ty: usize,
        bound: &TraitIdentity,
    ) -> Option<Option<ImplementationWitness>> {
        let goal = Goal {
            ty,
            bound: bound.clone(),
        };
        let outermost = self.trait_proofs.is_none();
        if self.trait_proofs.is_none() {
            self.trait_proofs = Some(Session::default());
        }
        let expanding = self.trait_proofs.as_ref().unwrap().active.iter().any(|previous| self.expanding_trait_goal(&goal, previous));
        if expanding { if outermost { self.trait_proofs = None; } return None; }
        let session = self.trait_proofs.as_mut().unwrap();
        if let Some(proof) = session.proved.get(&goal) {
            return Some(proof.clone());
        }
        if !session.active.insert(goal.clone()) {
            return None;
        }
        let mut solver = BoundSolver::new(ty, bound.clone());
        let result = loop {
            let empty = BTreeMap::new();
            let rigid = self
                .contracts
                .as_ref()
                .map_or(&empty, |contracts| &contracts.rigid);
            let step = solver.advance(BoundContext {
                source: self.source,
                index: &self.implementations,
                types: &self.types,
                applications: &self.applications,
                rigid,
            });
            for (completed_goal, evidence) in solver.completed() {
                self.trait_proofs
                    .as_mut()
                    .unwrap()
                    .proved
                    .insert(completed_goal, evidence);
            }
            match step {
                BoundStep::Done(valid) => {
                    break if valid {
                        Some(
                            self.trait_proofs
                                .as_ref()
                                .unwrap()
                                .proved
                                .get(&goal)
                                .unwrap()
                                .clone(),
                        )
                    } else {
                        None
                    };
                }
                BoundStep::Infer { goal, witness } => {
                    let completed = self.infer_implementation(witness).ok();
                    solver.inferred(goal, completed);
                }
                BoundStep::Validate {
                    goal,
                    witness,
                    constraints,
                } => {
                    let completed = self
                        .validate_implementation(&goal, witness, &constraints)
                        .ok();
                    solver.validated(goal, completed);
                }
            }
        };
        self.trait_proofs.as_mut().unwrap().active.remove(&goal);
        if outermost {
            self.trait_proofs = None;
        }
        result
    }

    pub(super) fn expanding_trait_goal(&self, goal: &Goal, previous: &Goal) -> bool {
        if goal.bound.head() != previous.bound.head() { return false; }
        let mut arguments = goal.bound.arguments(); arguments.push(goal.ty);
        let mut earlier = previous.bound.arguments(); earlier.push(previous.ty);
        if arguments.len() != earlier.len() { return false; }
        let mut larger = false;
        for position in 0..arguments.len() {
            if !self.associated_argument_contains(arguments[position], earlier[position]) { return false; }
            larger = larger || arguments[position] != earlier[position];
        }
        larger
    }

    pub(super) fn satisfies_bound(&mut self, ty: usize, bound: &str) -> bool {
        self.satisfies_identity(ty, &TraitIdentity::Builtin(bound.to_string()))
    }
    pub(super) fn satisfies_identity(&mut self, ty: usize, bound: &TraitIdentity) -> bool {
        self.prove_identity(ty, bound).is_some()
    }
    pub(super) fn implementation_witness(
        &mut self,
        ty: usize,
        bound: &TraitIdentity,
    ) -> Option<ImplementationWitness> {
        let proof = self.prove_identity(ty, bound)?;
        proof.or_else(|| {
            crate::generics::select_implementation(
                self.source,
                &self.implementations,
                &self.types,
                &self.applications,
                ty,
                bound,
            )
        })
    }
}

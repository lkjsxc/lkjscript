//! Capability methods lower to checked IR primitives or ordinary source helpers.
use super::{Builder, Result, a, capabilities, err, ir, methods};
use std::collections::BTreeMap;

impl Builder<'_, '_> {
    fn capability_type(&mut self, value: capabilities::Value, span: a::Span) -> Result<usize> {
        use capabilities::Value;
        Ok(match value {
            Value::Unit => ir::UNIT,
            Value::Byte => ir::U8,
            Value::Count => ir::U64,
            Value::Error => ir::I64,
            Value::Boolean => ir::BOOL,
            Value::Stdout => self.compiler.intern(String::new(), ir::TypeKind::Stdout),
            Value::Stdin => self.compiler.intern(String::new(), ir::TypeKind::Stdin),
            Value::Stderr => self.compiler.intern(String::new(), ir::TypeKind::Stderr),
            Value::Directory => self.compiler.intern(String::new(), ir::TypeKind::Directory),
            Value::ReadDirectory => self.compiler.intern(String::new(), ir::TypeKind::ReadDirectory),
            Value::ReadFile => self.compiler.intern(String::new(), ir::TypeKind::ReadFile),
            Value::Image => self.compiler.intern(String::new(), ir::TypeKind::Image),
            Value::Channel => self.compiler.intern(String::new(), ir::TypeKind::Channel),
            Value::Worker => self.compiler.intern(String::new(), ir::TypeKind::Worker),
            Value::ReadRegion => self.compiler.intern(String::new(), ir::TypeKind::ReadRegion),
            Value::ForeignCommand => self.compiler.intern(String::new(), ir::TypeKind::ForeignCommand),
            Value::ForeignSession => self.compiler.intern(String::new(), ir::TypeKind::ForeignSession),
            Value::NullDevice => self.compiler.intern(String::new(), ir::TypeKind::NullDevice),
            Value::File => self.compiler.intern(String::new(), ir::TypeKind::File),
            Value::Process => self.compiler.intern(String::new(), ir::TypeKind::Process),
            Value::Clock => self.compiler.intern(String::new(), ir::TypeKind::Clock),
            Value::Child => self.compiler.intern(String::new(), ir::TypeKind::Child),
            Value::Listener => self.compiler.intern(String::new(), ir::TypeKind::Listener),
            Value::Connector => self.compiler.intern(String::new(), ir::TypeKind::Connector),
            Value::Readiness => self.compiler.intern(String::new(), ir::TypeKind::Readiness),
            Value::Entropy => self.compiler.intern(String::new(), ir::TypeKind::Entropy),
            Value::Stop => self.compiler.intern(String::new(), ir::TypeKind::Stop),
            Value::Pid => *self.compiler.type_names.get(&"u32".to_string()).unwrap(),
            Value::Port => *self.compiler.type_names.get(&"u16".to_string()).unwrap(),
            Value::FileRef | Value::DirectoryRef | Value::ReadDirectoryRef | Value::NullDeviceRef | Value::MutableFileRef | Value::ListenerRef | Value::ClockRef | Value::StopRef => {
                let kind = match value {
                    Value::FileRef | Value::MutableFileRef => ir::TypeKind::File,
                    Value::ListenerRef => ir::TypeKind::Listener,
                    Value::ClockRef => ir::TypeKind::Clock,
                    Value::StopRef => ir::TypeKind::Stop,
                    Value::ReadDirectoryRef => ir::TypeKind::ReadDirectory,
                    Value::NullDeviceRef => ir::TypeKind::NullDevice,
                    _ => ir::TypeKind::Directory,
                };
                let inner = self.compiler.intern(String::new(), kind);
                self.compiler.reference(inner, !matches!(value, Value::FileRef))
            }
            Value::ArgumentsView => {
                let bytes = self
                    .compiler
                    .intern(String::new(), ir::TypeKind::Vec { inner: ir::U8 });
                let values = self.compiler.intern(
                    String::new(),
                    ir::TypeKind::Slice {
                        inner: bytes,
                        mutable: false,
                    },
                );
                self.compiler.reference(values, false)
            }
            Value::Text => {
                let text = self.compiler.intern(String::new(), ir::TypeKind::Str);
                self.compiler.reference(text, false)
            }
            Value::Bytes | Value::MutableBytes => {
                let bytes = self.compiler.intern(
                    String::new(),
                    ir::TypeKind::Slice {
                        inner: ir::U8,
                        mutable: false,
                    },
                );
                self.compiler
                    .reference(bytes, matches!(value, Value::MutableBytes))
            }
            Value::MaybeBytes => {
                let bytes = self.compiler.intern(String::new(), ir::TypeKind::Vec { inner: ir::U8 });
                let path = self.compiler.names.library_type("prelude", "Option", span)?;
                let mut arguments = BTreeMap::new();
                arguments.insert("T".to_string(), bytes);
                self.compiler.named_type(&path, &arguments, span)?
            }
            Value::Files => {
                let inner = self.compiler.intern(String::new(), ir::TypeKind::File);
                self.compiler.intern(String::new(), ir::TypeKind::Vec { inner })
            }
            Value::Arguments => {
                let bytes = self
                    .compiler
                    .intern(String::new(), ir::TypeKind::Vec { inner: ir::U8 });
                self.compiler
                    .intern(String::new(), ir::TypeKind::Vec { inner: bytes })
            }
            Value::ResultDirectory
            | Value::ResultReadDirectory
            | Value::ResultReadFile
            | Value::ResultForeignSession
            | Value::ResultFile
            | Value::ResultCount
            | Value::ResultBytes
            | Value::ResultUnit
            | Value::ResultChild
            | Value::ResultReadRegion | Value::ResultWorker
            | Value::ResultListener
            | Value::ResultConnector
            | Value::ResultReadiness
            | Value::ResultStop
            | Value::ResultBoolean
            | Value::ResultPid
            | Value::ResultEvents
            | Value::ResultMessage
            | Value::ResultPort
            | Value::ResultNames
            | Value::ResultStatus
            | Value::ResultMaybeStatus => {
                let success = match value {
                    Value::ResultDirectory => self.capability_type(Value::Directory, span)?,
                    Value::ResultReadDirectory => self.capability_type(Value::ReadDirectory, span)?,
                    Value::ResultReadFile => self.capability_type(Value::ReadFile, span)?,
                    Value::ResultForeignSession => self.capability_type(Value::ForeignSession, span)?,
                    Value::ResultFile => self.capability_type(Value::File, span)?,
                    Value::ResultReadRegion => self.capability_type(Value::ReadRegion, span)?,
                    Value::ResultWorker => self.capability_type(Value::Worker, span)?,
                    Value::ResultChild => self.capability_type(Value::Child, span)?,
                    Value::ResultListener => self.capability_type(Value::Listener, span)?,
                    Value::ResultConnector => self.capability_type(Value::Connector, span)?,
                    Value::ResultReadiness => self.capability_type(Value::Readiness, span)?,
                    Value::ResultStop => self.capability_type(Value::Stop, span)?,
                    Value::ResultBoolean => self.capability_type(Value::Boolean, span)?,
                    Value::ResultPid => self.capability_type(Value::Pid, span)?,
                    Value::ResultPort => self.capability_type(Value::Port, span)?,
                    Value::ResultNames => self.capability_type(Value::Arguments, span)?,
                    Value::ResultStatus => ir::I64,
                    Value::ResultMessage => {
                        let files = self.capability_type(Value::Files, span)?;
                        self.compiler.intern(String::new(), ir::TypeKind::Struct {
                            fields: vec![ir::Field { name: "0".to_string(), ty: ir::U64 }, ir::Field { name: "1".to_string(), ty: files }], copy: false,
                        })
                    }
                    Value::ResultEvents => {
                        let pair = self.compiler.intern(String::new(), ir::TypeKind::Struct {
                            fields: vec![ir::Field { name: "0".to_string(), ty: ir::U64 }, ir::Field { name: "1".to_string(), ty: ir::U8 }],
                            copy: true,
                        });
                        self.compiler.intern(String::new(), ir::TypeKind::Vec { inner: pair })
                    }

                    Value::ResultMaybeStatus => {
                        let path = self
                            .compiler
                            .names
                            .library_type("prelude", "Option", span)?;
                        let mut arguments = BTreeMap::new();
                        arguments.insert("T".to_string(), ir::I64);
                        self.compiler.named_type(&path, &arguments, span)?
                    }
                    Value::ResultCount => ir::U64,
                    Value::ResultBytes => self
                        .compiler
                        .intern(String::new(), ir::TypeKind::Vec { inner: ir::U8 }),
                    _ => ir::UNIT,
                };
                let path = self
                    .compiler
                    .names
                    .library_type("prelude", "Result", span)?;
                let mut arguments = BTreeMap::new();
                arguments.insert("T".to_string(), success);
                arguments.insert("E".to_string(), ir::I64);
                self.compiler.named_type(&path, &arguments, span)?
            }
        })
    }
    pub(super) fn output_method(
        &mut self,
        target: ir::Place,
        base: usize,
        name: &str,
        args: &[usize],
        span: a::Span,
    ) -> Result<(usize, usize)> {
        let method = capabilities::method(methods::receiver(&self.compiler.types[base].kind), name)
            .ok_or_else(|| {
                err(
                    span,
                    "E_TYPE",
                    &format!(
                        "capability {} has no method {name}",
                        self.compiler.display_type(base)
                    ),
                )
            })?;
        let (parameters, result) = method.signature();
        if args.len() != parameters.len() {
            return Err(err(
                span,
                "E_TYPE",
                &format!(
                    "capability method {name} expects {} arguments, found {}",
                    parameters.len(),
                    args.len()
                ),
            ));
        }
        let result = self.capability_type(result, span)?;
        let receiver = self.borrow(target, !matches!(method, capabilities::Method::ReadRegionBytes | capabilities::Method::ReadRegionLen), span.line)?.0;
        let mut values = vec![receiver];
        let mut index = 0;
        while index < parameters.len() {
            let expected = self.capability_type(parameters[index], span)?;
            let value = self.expr(args[index], Some(expected))?;
            if value.1 != expected {
                return Err(err(
                    self.compiler.source.exprs[args[index]].span,
                    "E_TYPE",
                    &format!(
                        "{name} argument {} expects {}, found {}",
                        index + 1,
                        self.compiler.display_type(expected),
                        self.compiler.display_type(value.1)
                    ),
                ));
            }
            values.push(value.0);
            index += 1;
        }
        if matches!(method, capabilities::Method::DirectoryCreateNew | capabilities::Method::DirectoryCreatePrivate | capabilities::Method::DirectoryOpenAppend) {
            let path = self.source_library_call(
                "io", "__lkjscript_storage_path", BTreeMap::new(), vec![values[1]], span,
            )?;
            let bytes = self.capability_type(capabilities::Value::Bytes, span)?;
            let borrowed = self.temp(bytes);
            self.emit(ir::Op::SliceBorrow {
                dst: borrowed, place: ir::Place::local(path.0), mutable: false,
            }, span.line);
            let operation = if matches!(method, capabilities::Method::DirectoryCreateNew) {
                ir::IntrinsicOp::DirectoryCreateNew
            } else if matches!(method, capabilities::Method::DirectoryCreatePrivate) {
                ir::IntrinsicOp::DirectoryCreatePrivate
            } else { ir::IntrinsicOp::DirectoryOpenAppend };
            let dst = self.temp(result);
            self.emit(ir::Op::Intrinsic {
                dst, name: operation, args: vec![values[0], borrowed],
            }, span.line);
            return Ok((dst, result));
        }
        if matches!(method, capabilities::Method::WorldConnector) {
            let address = self.source_library_call(
                "io", "__lkjscript_ipv4_address", BTreeMap::new(),
                vec![values[1], values[2]], span,
            )?;
            let bytes = self.capability_type(capabilities::Value::Bytes, span)?;
            let borrowed = self.temp(bytes);
            self.emit(ir::Op::SliceBorrow {
                dst: borrowed, place: ir::Place::local(address.0), mutable: false,
            }, span.line);
            let dst = self.temp(result);
            self.emit(ir::Op::Intrinsic {
                dst, name: ir::IntrinsicOp::WorldConnector, args: vec![values[0], borrowed],
            }, span.line);
            return Ok((dst, result));
        }
        if let Some(operation) = method.intrinsic() {
            let dst = self.temp(result);
            self.emit(
                ir::Op::Intrinsic {
                    dst,
                    name: operation,
                    args: values,
                },
                span.line,
            );
            Ok((dst, result))
        } else {
            let helper = method.helper().expect("source capability operation");
            let module = if matches!(method, capabilities::Method::CommandArgs | capabilities::Method::EnvironmentGet) {
                "command"
            } else if matches!(method, capabilities::Method::ForeignRun) {
                "foreign"
            } else if matches!(method, capabilities::Method::ReadDirectoryOpen | capabilities::Method::ReadOpenDirectory | capabilities::Method::ReadDirectoryList | capabilities::Method::ReadFileRead | capabilities::Method::ReadFileReadToEnd) {
                "read_io"
            } else { "io" };
            let value = self.source_library_call(module, helper, BTreeMap::new(), values, span)?;
            if value.1 != result {
                return Err(err(
                    span,
                    "E_TYPE",
                    &format!(
                        "source IO helper {helper} returns {}, expected {}",
                        self.compiler.display_type(value.1),
                        self.compiler.display_type(result)
                    ),
                ));
            }
            Ok(value)
        }
    }
}

//! Qualified source paths select a declared trait, never a same-spelled member.
//! These producer witnesses erase to the existing concrete types and calls.
use super::{Compiler, Instance, Result, a, err};
use super::generic_check::{MethodSelection, MethodTarget};
use crate::generics::TraitIdentity;
use std::collections::BTreeMap;

impl Compiler<'_> {
    fn contains_qualified_type(&self, first: a::TypeId) -> bool {
        let mut pending = vec![first];
        while let Some(ty) = pending.pop() {
            match &self.source.types[ty].kind {
                a::Type::Path(path) => {
                    if path.qualification.is_some() { return true; }
                    pending.extend_from_slice(&path.args);
                }
                a::Type::Ref { inner, .. } | a::Type::Slice(inner)
                | a::Type::Array { inner, .. } => pending.push(*inner),
                a::Type::Tuple(items) => pending.extend_from_slice(items),
                a::Type::Function { params, result } => {
                    pending.extend_from_slice(params);
                    pending.push(*result);
                }
                _ => {}
            }
        }
        false
    }

    pub(super) fn validate_qualified_headers(&mut self) -> Result<()> {
        // Declaration signatures are obligations even when no body or concrete
        // instantiation is demanded. Type aliases keep their existing lazy rule.
        for index in 0..self.source.declarations.len() {
            let (parameters, predicates, fields) = match self.source.declarations[index].item {
                a::Item::Struct(index) => {
                    let item = &self.source.structs[index];
                    (item.generics.clone(), item.predicates.clone(), item.fields.clone())
                }
                a::Item::Enum(index) => {
                    let item = &self.source.enums[index];
                    let mut fields: Vec<a::Field> = Vec::new();
                    for variant in &item.variants { fields.extend_from_slice(&variant.fields); }
                    (item.generics.clone(), item.predicates.clone(), fields)
                }
                _ => continue,
            };
            // Storage obligations apply to unused nominal declarations too.
            let mut environment = BTreeMap::new();
            self.declare_parameters_with_predicates(&parameters, &predicates, &mut environment)?;
            for field in &fields {
                let ty = self.resolve(field.ty, &environment)?;
                self.require_source_sized(ty, field.span)?;
            }
        }
        for index in 0..self.source.traits.len() {
            let declaration = self.source.traits[index].clone();
            if !declaration.predicates.is_empty() { let _ = self.trait_parameters(index)?; }
            for method in &declaration.methods {
                let function = self.source.functions[*method].clone();
                if function.body.is_some() { continue; }
                let environment = self.definition_parameters(*method)?;
                let self_type = environment.get(&"Self".to_string()).copied();
                for parameter in &function.params {
                    let ty = self.resolve(parameter.ty, &environment)?;
                    // Abstract trait signatures may name Self by value. Every
                    // nested storage position and ordinary parameter still checks.
                    if Some(ty) != self_type { self.require_source_sized(ty, parameter.span)?; }
                }
                let result = self.resolve(function.result, &environment)?;
                if Some(result) != self_type { self.require_source_sized(result, function.span)?; }
            }
        }
        // An unused, methodless implementation still has a source contract.
        // Only rigid parameter targets become assumptions; a concrete target
        // such as bool must actually satisfy the written predicate.
        for index in 0..self.source.impls.len() {
            let implementation = self.source.impls[index].clone();
            let mut environment = BTreeMap::new();
            let predicates = self.parameter_where_predicates(&implementation.predicates);
            self.declare_parameters_with_predicates(&implementation.generics, &predicates, &mut environment)?;
            let receiver = self.resolve(implementation.target, &environment)?;
            environment.insert("Self".to_string(), receiver);
            self.assume_where_predicates(&implementation.predicates, &environment)?;
            let _ = self.implementation_associated(index, environment)?;
        }
        Ok(())
    }

    pub(super) fn qualified_trait(&self, qualification: &a::QualifiedPath, span: a::Span) -> Result<usize> {
        let Some(trait_ty) = qualification.trait_ty else {
            return Err(err(span, "E_UNSUPPORTED", "associated type projections require an explicit declared trait"));
        };
        let a::Type::Path(path) = &self.source.types[trait_ty].kind else {
            return Err(err(span, "E_TRAIT", "fully qualified path requires a declared trait"));
        };
        if !path.bindings.is_empty() {
            return Err(err(path.bindings[0].span, "E_TRAIT",
                "associated-type equality bindings are not allowed in a qualified as-clause"));
        }
        if !path.args.is_empty() {
            return Err(err(self.source.types[trait_ty].span, "E_UNSUPPORTED",
                "parameterized trait applications in fully qualified paths are not implemented"));
        }
        let TraitIdentity::Declared(index) = crate::generics::bound_identity(self.source, path) else {
            return Err(err(span, "E_TRAIT", "fully qualified path requires a declared trait"));
        };
        if self.source.traits[index].generics.iter().any(|parameter| !parameter.lifetime) {
            return Err(err(span, "E_UNSUPPORTED", "parameterized trait applications in fully qualified paths are not implemented"));
        }
        Ok(index)
    }

    pub(super) fn qualified_associated_type(
        &mut self,
        receiver: usize,
        qualification: &a::QualifiedPath,
        name: &str,
        span: a::Span,
    ) -> Result<usize> {
        let owner = self.qualified_trait(qualification, span)?;
        self.associated_type_for_trait(receiver, owner, name, qualification.member_span)
    }

    pub(super) fn associated_type_for_trait(&mut self, receiver: usize, owner: usize, name: &str, span: a::Span) -> Result<usize> {
        if !self.source.traits[owner].associated.iter().any(|item| item.name == name) {
            return Err(err(span, "E_TRAIT",
                &format!("fully qualified associated type {name} is not declared by the selected trait")));
        }
        let identity = TraitIdentity::Declared(owner);
        if let Some(value) = self.active_associated_type(receiver, &identity, name) {
            return Ok(value);
        }
        if !self.satisfies_identity(receiver, &identity) {
            return Err(err(span, "E_TRAIT", "fully qualified associated type requires its declared trait bound"));
        }
        let abstract_receiver = self.contracts.as_ref()
            .is_some_and(|contracts| contracts.traits.contains_key(&(receiver, owner)));
        if abstract_receiver {
            return self.associated_identity(receiver, owner, name);
        }
        let mut witness = self.implementation_witness(receiver, &identity).ok_or_else(||
            err(span, "E_TRAIT", "fully qualified associated type has no implementation witness"))?;
        witness.substitutions.insert("Self".to_string(), receiver);
        self.implementation_associated_member(witness.implementation, witness.substitutions, name)
    }

    pub(super) fn qualified_method(
        &mut self,
        receiver: usize,
        qualification: &a::QualifiedPath,
        name: &str,
        expression: a::ExprId,
        span: a::Span,
    ) -> Result<Instance> {
        let owner = self.qualified_trait(qualification, span)?;
        self.declared_associated_method(receiver, owner, name, expression, qualification.member_span, span)
    }

    pub(super) fn declared_associated_method(
        &mut self, receiver: usize, owner: usize, name: &str, expression: a::ExprId,
        member_span: a::Span, span: a::Span,
    ) -> Result<Instance> {
        let declaration = self.source.traits[owner].clone();
        let mut method = None;
        for index in &declaration.methods {
            if self.source.functions[*index].name == name { method = Some(*index); break; }
        }
        let method = method.ok_or_else(|| err(member_span, "E_TRAIT",
            &format!("fully qualified function {name} is not declared by the selected trait")))?;
        let identity = TraitIdentity::Declared(owner);
        if !self.satisfies_identity(receiver, &identity) {
            return Err(err(span, "E_TRAIT", "fully qualified function requires its declared trait bound"));
        }
        let abstract_receiver = self.contracts.as_ref()
            .is_some_and(|contracts| contracts.traits.contains_key(&(receiver, owner)));
        let (source, mut substitutions) = if abstract_receiver {
            (method, BTreeMap::new())
        } else {
            let witness = self.implementation_witness(receiver, &identity).ok_or_else(||
                err(span, "E_TRAIT", "fully qualified function has no implementation witness"))?;
            let implementation = &self.source.impls[witness.implementation];
            let mut selected = None;
            for index in &implementation.methods {
                if self.source.functions[*index].name == name { selected = Some(*index); break; }
            }
            let source = if let Some(selected) = selected { selected }
                else if self.source.functions[method].body.is_some() { method }
                else { return Err(err(member_span, "E_TRAIT",
                    "fully qualified function has no implementation definition")); };
            // A provided body has the trait's parameter scope. Implementation
            // parameter spellings must not capture its own method parameters.
            let substitutions = if source == method { BTreeMap::new() }
                else { witness.substitutions };
            (source, substitutions)
        };
        substitutions.insert("Self".to_string(), receiver);
        for item in &declaration.associated {
            let ty = self.associated_type_for_trait(receiver, owner, &item.name, span)?;
            substitutions.insert(format!("Self::{}", item.name), ty);
        }
        self.method_selections.insert(expression, MethodSelection {
            dereferences: 0,
            target: MethodTarget::Trait(identity),
        });
        Ok(Instance { source, substitutions })
    }
}

impl super::Builder<'_, '_> {
    fn scoped_associated_contract(
        &mut self, receiver: usize, name: &str, expression: a::ExprId, span: a::Span,
    ) -> Result<Option<Instance>> {
        if self.compiler.contracts.is_none() {
            return self.compiler.static_contract(receiver, name, expression, span);
        }
        let mut candidates = Vec::new();
        for candidate in self.compiler.declared_methods(receiver, name)? {
            if self.compiler.source.functions[candidate.method].params.first()
                .is_some_and(|parameter| parameter.name == "self") { continue; }
            let mut visible = false;
            for (declaration, item) in self.compiler.source.declarations.iter().enumerate() {
                if matches!(item.item, a::Item::Trait(index) if index == candidate.declaration) {
                    visible = self.compiler.names.trait_in_scope(self.scope, declaration, span);
                    break;
                }
            }
            if visible { candidates.push(candidate); }
        }
        if candidates.len() > 1 {
            return Err(err(span, "E_TRAIT", "associated function is ambiguous between declared traits in scope"));
        }
        if let Some(candidate) = candidates.pop() {
            self.compiler.method_selections.insert(expression, MethodSelection {
                dereferences: 0,
                target: MethodTarget::Trait(TraitIdentity::Declared(candidate.declaration)),
            });
            return Ok(Some(Instance { source: candidate.method, substitutions: candidate.substitutions }));
        }
        Ok(None)
    }

    pub(super) fn associated_receiver(
        &mut self,
        receiver: usize,
        name: &str,
        expression: a::ExprId,
        explicit_receiver: bool,
        span: a::Span,
    ) -> Result<Option<Instance>> {
        let contract = if explicit_receiver {
            self.scoped_associated_contract(receiver, name, expression, span)?
        } else { self.compiler.static_contract(receiver, name, expression, span)? };
        if let Some(instance) = contract {
            return Ok(Some(instance));
        }
        let fixed: Option<usize> = if explicit_receiver && self.compiler.contracts.is_none() {
            match self.compiler.method_selections.get(&expression) {
                Some(MethodSelection { target: MethodTarget::Source(source), .. }) => Some(*source),
                _ => None,
            }
        } else { None };
        let implementations = self.compiler.implementations.associated_method_candidates(
            self.compiler.source, &self.compiler.types, &self.compiler.applications, receiver, name);
        let mut candidates: Vec<(usize, BTreeMap<String, usize>)> = Vec::new();
        let mut inherent: Vec<(usize, BTreeMap<String, usize>)> = Vec::new();
        let mut prerequisite_problem = None;
        for index in implementations {
            let implementation = self.compiler.source.impls[index].clone();
            let mut methods = Vec::new();
            if let Some(candidate) = crate::generics::implementation_method(self.compiler.source, index, name) {
                let function = &self.compiler.source.functions[candidate];
                let selected = match fixed { Some(source) => source == candidate, None => true };
                if function.name == name
                    && function.params.first().is_none_or(|parameter| parameter.name != "self")
                    && selected
                {
                    methods.push(candidate);
                }
            }
            if methods.is_empty() { continue; }
            let mut substitutions = BTreeMap::new();
            if !self.infer_type_matches(implementation.target, receiver, &mut substitutions)? { continue; }
            substitutions.insert("Self".to_string(), receiver);
            if self.compiler.resolve(implementation.target, &substitutions).ok() != Some(receiver)
                || !self.trait_available(&implementation, receiver, span) {
                continue;
            }
            if let Err(problem) = self.compiler.implementation_bounds(&implementation, &substitutions) {
                prerequisite_problem.get_or_insert(problem);
                continue;
            }
            for candidate in methods {
                if implementation.trait_ty.is_none() { inherent.push((candidate, substitutions.clone())); }
                else { candidates.push((candidate, substitutions.clone())); }
            }
        }
        if !inherent.is_empty() { candidates = inherent; }
        if candidates.len() > 1 { return Err(err(span, "E_TRAIT", "ambiguous associated function")); }
        if let Some((source, substitutions)) = candidates.pop() {
            if let a::FunctionOwner::Trait(owner) = self.compiler.source.function_owner(a::FunctionId { index: source }) {
                let instance = self.compiler.declared_associated_method(receiver, owner.index, name, expression, span, span)?;
                return Ok(Some(instance));
            }
            if explicit_receiver && self.compiler.contracts.is_some() {
                self.compiler.method_selections.insert(expression, MethodSelection {
                    dereferences: 0, target: MethodTarget::Source(source),
                });
            }
            return Ok(Some(Instance { source, substitutions }));
        }
        if let Some(problem) = prerequisite_problem { return Err(problem); }
        if fixed.is_some() {
            return Err(err(span, "E_GENERIC", "checked associated function no longer matches its receiver"));
        }
        Ok(None)
    }
}

//! One public/raw signature table drives capability inference and construction.
use super::methods::Receiver;
use crate::ir;
#[derive(Clone, Copy)]
pub(super) enum Value {
    Unit,
    Byte,
    Count,
    Error,
    Boolean,
    Text,
    Bytes,
    MutableBytes,
    MaybeBytes,
    Stdout,
    Stdin,
    Stderr,
    Directory,
    ReadDirectory,
    ReadFile,
    ForeignCommand,
    NullDevice,
    File,
    Arguments,
    ResultDirectory,
    ResultReadDirectory,
    ResultReadFile,
    ResultFile,
    ResultCount,
    ResultBytes,
    ResultUnit,
    Process,
    Clock,
    Child,
    Listener,
    Connector,
    ResultConnector,
    Readiness,
    Entropy,
    Stop,
    StopRef,
    Pid,
    ResultStop,
    ResultBoolean,
    ResultPid,
    ResultReadiness,
    ResultEvents,
    MutableFileRef,
    ListenerRef,
    ClockRef,
    Port,
    ResultListener,
    ResultPort,
    FileRef,
    DirectoryRef,
    ReadDirectoryRef,
    NullDeviceRef,
    ArgumentsView,
    ResultChild,
    ResultNames,
    ResultStatus,
    ResultMaybeStatus,
}
#[derive(Clone, Copy)]
pub(super) enum Method {
    Stdout,
    Stdin,
    Stderr,
    Args,
    CommandArgs,
    EnvironmentGet,
    EnvironmentLen,
    EnvironmentCopy,
    Directory,
    ExitStatus,
    ArgCount,
    ArgLen,
    ArgCopy,
    DirectoryRaw,
    StdoutWrite,
    StderrWrite,
    StdinRead,
    StdinReadRaw,
    StdinReadToEnd,
    DirectoryOpen,
    ReadDirectoryOpen,
    ReadDirectoryOpenRaw,
    ReadOpenDirectory,
    ReadOpenDirectoryRaw,
    ReadDirectoryList,
    ReadFileRead,
    ReadFileReadToEnd,
    FileSeek,
    FileModifiedNanoseconds,
    ForeignRun,
    ForeignRunRaw,
    ForeignImage,
    DirectoryCreate,
    DirectoryCreateNew,
    DirectoryCreatePrivate,
    DirectoryCreatePrivateRaw,
    DirectoryOpenAppend,
    DirectoryCreateNewRaw,
    DirectoryOpenAppendRaw,
    DirectorySync,
    FileSync,
    FileTruncate,
    FileLockExclusive,
    FileLockWait,
    DirectoryOpenRaw,
    FileRead,
    FileWrite,
    FileReadRaw,
    FileWriteRaw,
    FileReadToEnd,
    FileWriteAll,
    Process,
    Clock,
    WorldFile,
    TemporaryFile,
    StdinFile,
    StdoutFile,
    StderrFile,
    Executable,
    ClockRead,
    ClockNow,
    ProcessSpawn,
    ProcessSpawnRaw,
    ChildWait,
    ChildTryWait,
    ChildWaitRaw,
    ChildTerminate,
    ChildTerminateRaw,
    FileRewind,
    FileRewindRaw,
    FileExecutable,
    FileExecutableRaw,
    FileSeal,
    FileSealRaw,
    FileDuplicate,
    FileReadOnly,
    FileReadOnlyRaw,
    OpenDirectory,
    OpenDirectoryRaw,
    DirectoryRead,
    DirectoryRewind,
    DirectoryList,
    CreateDirectory,
    CreateDirectoryRaw,
    DirectoryRemove,
    DirectoryRemoveDirectory,
    DirectoryRemoveRaw,
    DirectoryRename,
    DirectoryRenameRaw,
    WorldConnector,
    WorldConnectorRaw,
    ConnectorConnect,
    WorldListen,
    WorldListenRaw,
    ListenerAccept,
    ListenerAcceptNoDelay,
    ListenerPort,
    ListenerAddressRaw,
    WorldReadiness,
    FileSetNonblocking,
    ListenerSetNonblocking,
    ReadinessWatchFile,
    ReadinessWatchListener,
    ReadinessUnwatchFile,
    ReadinessUnwatchListener,
    ReadinessWait,
    WorldEntropy,
    EntropyFill,
    ClockUnixSeconds,
    ClockUnixNanoseconds,
    FileSetPrivate,
    WorldStop,
    StopRequested,
    StopTarget,
    ReadinessWatchStop,
    ReadinessUnwatchStop,
    ChildRequestStop,
}
pub(super) fn method(receiver: Receiver, name: &str) -> Option<Method> {
    Some(match (receiver, name) {
        (Receiver::World, "stdout") => Method::Stdout,
        (Receiver::World, "stdin") => Method::Stdin,
        (Receiver::World, "stderr") => Method::Stderr,
        (Receiver::World, "args") => Method::Args,
        (Receiver::Arguments, "args") => Method::CommandArgs,
        (Receiver::Arguments, "__lkjscript_arg_count") => Method::ArgCount,
        (Receiver::Arguments, "__lkjscript_arg_len") => Method::ArgLen,
        (Receiver::Arguments, "__lkjscript_arg_copy") => Method::ArgCopy,
        (Receiver::Environment, "get") => Method::EnvironmentGet,
        (Receiver::Environment, "__lkjscript_len") => Method::EnvironmentLen,
        (Receiver::Environment, "__lkjscript_copy") => Method::EnvironmentCopy,
        (Receiver::ExitStatus, "set_status") => Method::ExitStatus,
        (Receiver::World, "directory") => Method::Directory,
        (Receiver::World, "readiness") => Method::WorldReadiness,
        (Receiver::World, "entropy") => Method::WorldEntropy,
        (Receiver::Entropy, "fill") => Method::EntropyFill,
        (Receiver::Clock, "unix_seconds") => Method::ClockUnixSeconds,
        (Receiver::Clock, "unix_nanoseconds") => Method::ClockUnixNanoseconds,
        (Receiver::File, "set_private") => Method::FileSetPrivate,
        (Receiver::World, "stop") => Method::WorldStop,
        (Receiver::Stop, "requested") => Method::StopRequested,
        (Receiver::Stop, "target") => Method::StopTarget,
        (Receiver::Readiness, "watch_stop") => Method::ReadinessWatchStop,
        (Receiver::Readiness, "unwatch_stop") => Method::ReadinessUnwatchStop,
        (Receiver::Child, "request_stop") => Method::ChildRequestStop,
        (Receiver::File, "set_nonblocking") => Method::FileSetNonblocking,
        (Receiver::Listener, "set_nonblocking") => Method::ListenerSetNonblocking,
        (Receiver::Readiness, "watch_file") => Method::ReadinessWatchFile,
        (Receiver::Readiness, "watch_listener") => Method::ReadinessWatchListener,
        (Receiver::Readiness, "unwatch_file") => Method::ReadinessUnwatchFile,
        (Receiver::Readiness, "unwatch_listener") => Method::ReadinessUnwatchListener,
        (Receiver::Readiness, "wait") => Method::ReadinessWait,

        (Receiver::World, "connector") => Method::WorldConnector,
        (Receiver::World, "__lkjscript_connector") => Method::WorldConnectorRaw,
        (Receiver::Connector, "connect" | "__lkjscript_connect") => Method::ConnectorConnect,
        (Receiver::World, "listen") => Method::WorldListen,
        (Receiver::World, "__lkjscript_listen") => Method::WorldListenRaw,
        (Receiver::Listener, "accept" | "__lkjscript_accept") => Method::ListenerAccept,
        (Receiver::Listener, "accept_nodelay") => Method::ListenerAcceptNoDelay,
        (Receiver::Listener, "port") => Method::ListenerPort,
        (Receiver::Listener, "__lkjscript_address") => Method::ListenerAddressRaw,
        (Receiver::World, "set_exit_status") => Method::ExitStatus,
        (Receiver::World, "__lkjscript_arg_count") => Method::ArgCount,
        (Receiver::World, "__lkjscript_arg_len") => Method::ArgLen,
        (Receiver::World, "__lkjscript_arg_copy") => Method::ArgCopy,
        (Receiver::World, "__lkjscript_directory") => Method::DirectoryRaw,
        (Receiver::Stdout, "write") => Method::StdoutWrite,
        (Receiver::Stderr, "write") => Method::StderrWrite,
        (Receiver::Stdin, "read") => Method::StdinRead,
        (Receiver::Stdin, "__lkjscript_read") => Method::StdinReadRaw,
        (Receiver::Stdin, "read_to_end") => Method::StdinReadToEnd,
        (Receiver::Directory, "open") => Method::DirectoryOpen,
        (Receiver::ForeignCommand, "run") => Method::ForeignRun,
        (Receiver::ForeignCommand, "__lkjscript_run") => Method::ForeignRunRaw,
        (Receiver::ForeignCommand, "image" | "__lkjscript_image") => Method::ForeignImage,
        (Receiver::ReadDirectory, "open") => Method::ReadDirectoryOpen,
        (Receiver::ReadDirectory, "__lkjscript_open") => Method::ReadDirectoryOpenRaw,
        (Receiver::ReadDirectory, "open_directory") => Method::ReadOpenDirectory,
        (Receiver::ReadDirectory, "__lkjscript_open_directory") => Method::ReadOpenDirectoryRaw,
        (Receiver::ReadDirectory, "list") => Method::ReadDirectoryList,
        (Receiver::ReadDirectory, "__lkjscript_read") => Method::DirectoryRead,
        (Receiver::ReadDirectory, "__lkjscript_rewind") => Method::DirectoryRewind,
        (Receiver::ReadFile, "read") => Method::ReadFileRead,
        (Receiver::ReadFile, "__lkjscript_read") => Method::FileReadRaw,
        (Receiver::ReadFile, "read_to_end") => Method::ReadFileReadToEnd,
        (Receiver::File, "seek") => Method::FileSeek,
        (Receiver::File | Receiver::ReadFile, "modified_nanoseconds") => Method::FileModifiedNanoseconds,
        (Receiver::Directory, "create") => Method::DirectoryCreate,
        (Receiver::Directory, "create_new") => Method::DirectoryCreateNew,
        (Receiver::Directory, "create_private") => Method::DirectoryCreatePrivate,
        (Receiver::Directory, "__lkjscript_create_private") => Method::DirectoryCreatePrivateRaw,
        (Receiver::Directory, "open_append") => Method::DirectoryOpenAppend,
        (Receiver::Directory, "__lkjscript_create_new") => Method::DirectoryCreateNewRaw,
        (Receiver::Directory, "__lkjscript_open_append") => Method::DirectoryOpenAppendRaw,
        (Receiver::Directory, "sync") => Method::DirectorySync,
        (Receiver::File, "sync") => Method::FileSync,
        (Receiver::File, "truncate") => Method::FileTruncate,
        (Receiver::File, "lock_exclusive") => Method::FileLockExclusive,
        (Receiver::File, "lock_wait") => Method::FileLockWait,
        (Receiver::Directory, "__lkjscript_open") => Method::DirectoryOpenRaw,
        (Receiver::File, "read") => Method::FileRead,
        (Receiver::File, "write") => Method::FileWrite,
        (Receiver::File, "__lkjscript_read") => Method::FileReadRaw,
        (Receiver::File, "__lkjscript_write") => Method::FileWriteRaw,
        (Receiver::File, "read_to_end") => Method::FileReadToEnd,
        (Receiver::File, "write_all") => Method::FileWriteAll,
        (Receiver::World, "process") => Method::Process,
        (Receiver::World, "clock") => Method::Clock,
        (Receiver::World, "__lkjscript_file") => Method::WorldFile,
        (Receiver::World, "temporary_file") => Method::TemporaryFile,
        (Receiver::World, "stdin_file") => Method::StdinFile,
        (Receiver::World, "stdout_file") => Method::StdoutFile,
        (Receiver::World, "stderr_file") => Method::StderrFile,
        (Receiver::World, "executable") => Method::Executable,
        (Receiver::Clock, "__lkjscript_read") => Method::ClockRead,
        (Receiver::Clock, "nanoseconds") => Method::ClockNow,
        (Receiver::Process, "spawn_file") => Method::ProcessSpawn,
        (Receiver::Process, "__lkjscript_spawn") => Method::ProcessSpawnRaw,
        (Receiver::Child, "wait") => Method::ChildWait,
        (Receiver::Child, "try_wait") => Method::ChildTryWait,
        (Receiver::Child, "__lkjscript_wait") => Method::ChildWaitRaw,
        (Receiver::Child, "terminate") => Method::ChildTerminate,
        (Receiver::Child, "__lkjscript_terminate") => Method::ChildTerminateRaw,
        (Receiver::File, "rewind") => Method::FileRewind,
        (Receiver::File, "__lkjscript_rewind") => Method::FileRewindRaw,
        (Receiver::File, "set_executable") => Method::FileExecutable,
        (Receiver::File, "duplicate" | "__lkjscript_duplicate") => Method::FileDuplicate,
        (Receiver::File, "readonly") => Method::FileReadOnly,
        (Receiver::File, "__lkjscript_readonly") => Method::FileReadOnlyRaw,
        (Receiver::File, "__lkjscript_executable") => Method::FileExecutableRaw,
        (Receiver::File, "seal") => Method::FileSeal,
        (Receiver::File, "__lkjscript_seal") => Method::FileSealRaw,
        (Receiver::Directory, "open_directory") => Method::OpenDirectory,
        (Receiver::Directory, "__lkjscript_open_directory") => Method::OpenDirectoryRaw,
        (Receiver::Directory, "__lkjscript_read") => Method::DirectoryRead,
        (Receiver::Directory, "__lkjscript_rewind") => Method::DirectoryRewind,
        (Receiver::Directory, "list") => Method::DirectoryList,
        (Receiver::Directory, "create_directory") => Method::CreateDirectory,
        (Receiver::Directory, "__lkjscript_create_directory") => Method::CreateDirectoryRaw,
        (Receiver::Directory, "remove") => Method::DirectoryRemove,
        (Receiver::Directory, "remove_directory") => Method::DirectoryRemoveDirectory,
        (Receiver::Directory, "__lkjscript_remove") => Method::DirectoryRemoveRaw,
        (Receiver::Directory, "rename") => Method::DirectoryRename,
        (Receiver::Directory, "__lkjscript_rename") => Method::DirectoryRenameRaw,
        _ => return None,
    })
}
impl Method {
    pub(super) fn signature(self) -> (Vec<Value>, Value) {
        match self {
            Method::Stdout => (vec![], Value::Stdout),
            Method::Stdin => (vec![], Value::Stdin),
            Method::Stderr => (vec![], Value::Stderr),
            Method::Args | Method::CommandArgs => (vec![], Value::Arguments),
            Method::EnvironmentGet => (vec![], Value::MaybeBytes),
            Method::EnvironmentLen => (vec![], Value::Error),
            Method::EnvironmentCopy => (vec![Value::MutableBytes], Value::Count),
            Method::Directory => (vec![Value::Text], Value::ResultDirectory),
            Method::WorldReadiness => (vec![], Value::ResultReadiness),
            Method::WorldEntropy => (vec![], Value::Entropy),
            Method::EntropyFill => (vec![Value::MutableBytes], Value::ResultUnit),
            Method::ClockUnixSeconds => (vec![], Value::ResultStatus),
            Method::ClockUnixNanoseconds => (vec![], Value::ResultCount),
            Method::FileSetPrivate | Method::ChildRequestStop => (vec![], Value::ResultUnit),
            Method::WorldStop => (vec![], Value::ResultStop),
            Method::StopRequested => (vec![], Value::ResultBoolean),
            Method::StopTarget => (vec![], Value::ResultPid),
            Method::ReadinessWatchStop => (vec![Value::StopRef, Value::Count], Value::ResultUnit),
            Method::ReadinessUnwatchStop => (vec![Value::StopRef], Value::ResultUnit),
            Method::FileSetNonblocking | Method::ListenerSetNonblocking => (vec![Value::Boolean], Value::ResultUnit),
            Method::ReadinessWatchFile => (vec![Value::MutableFileRef, Value::Count, Value::Byte], Value::ResultUnit),
            Method::ReadinessWatchListener => (vec![Value::ListenerRef, Value::Count], Value::ResultUnit),
            Method::ReadinessUnwatchFile => (vec![Value::MutableFileRef], Value::ResultUnit),
            Method::ReadinessUnwatchListener => (vec![Value::ListenerRef], Value::ResultUnit),
            Method::ReadinessWait => (vec![Value::ClockRef, Value::Count], Value::ResultEvents),

            Method::WorldConnector => (vec![Value::Text, Value::Port], Value::ResultConnector),
            Method::WorldConnectorRaw => (vec![Value::Bytes], Value::ResultConnector),
            Method::ConnectorConnect => (vec![], Value::ResultFile),
            Method::WorldListen => (vec![Value::Text, Value::Port], Value::ResultListener),
            Method::WorldListenRaw => (vec![Value::Bytes], Value::ResultListener),
            Method::ListenerAccept | Method::ListenerAcceptNoDelay => (vec![], Value::ResultFile),
            Method::ListenerPort => (vec![], Value::ResultPort),
            Method::ListenerAddressRaw => (vec![Value::MutableBytes], Value::Error),
            Method::ExitStatus => (vec![Value::Byte], Value::Unit),
            Method::ArgCount => (vec![], Value::Count),
            Method::ArgLen => (vec![Value::Count], Value::Count),
            Method::ArgCopy => (vec![Value::Count, Value::MutableBytes], Value::Count),
            Method::DirectoryRaw => (vec![Value::Bytes], Value::ResultDirectory),
            Method::ReadDirectoryOpen => (vec![Value::Text], Value::ResultReadFile),
            Method::ReadDirectoryOpenRaw => (vec![Value::Bytes], Value::ResultReadFile),
            Method::ReadOpenDirectory => (vec![Value::Text], Value::ResultReadDirectory),
            Method::ReadOpenDirectoryRaw => (vec![Value::Bytes], Value::ResultReadDirectory),
            Method::ReadDirectoryList => (vec![], Value::ResultNames),
            Method::ReadFileRead => (vec![Value::MutableBytes], Value::ResultCount),
            Method::ReadFileReadToEnd => (vec![], Value::ResultBytes),
            Method::FileSeek => (vec![Value::Error, Value::Byte], Value::ResultCount),
            Method::FileModifiedNanoseconds => (vec![], Value::ResultCount),
            Method::ForeignRun => (vec![Value::ReadDirectoryRef, Value::NullDeviceRef, Value::ArgumentsView, Value::Count], Value::ResultReadFile),
            Method::ForeignRunRaw => (vec![Value::ReadDirectoryRef, Value::NullDeviceRef, Value::Bytes, Value::Count], Value::ResultReadFile),
            Method::ForeignImage => (vec![], Value::ResultReadFile),
            Method::StdoutWrite | Method::StderrWrite => (vec![Value::Bytes], Value::Unit),
            Method::StdinRead | Method::FileRead => (vec![Value::MutableBytes], Value::ResultCount),
            Method::StdinReadRaw | Method::FileReadRaw => (vec![Value::MutableBytes], Value::Error),
            Method::StdinReadToEnd | Method::FileReadToEnd => (vec![], Value::ResultBytes),
            Method::DirectoryOpen | Method::DirectoryCreate | Method::DirectoryCreateNew | Method::DirectoryCreatePrivate | Method::DirectoryOpenAppend => {
                (vec![Value::Text], Value::ResultFile)
            }
            Method::DirectoryOpenRaw => (vec![Value::Bytes, Value::Boolean], Value::ResultFile),
            Method::DirectoryCreateNewRaw | Method::DirectoryCreatePrivateRaw | Method::DirectoryOpenAppendRaw => (vec![Value::Bytes], Value::ResultFile),
            Method::DirectorySync | Method::FileSync | Method::FileLockExclusive | Method::FileLockWait => (vec![], Value::ResultUnit),
            Method::FileTruncate => (vec![Value::Count], Value::ResultUnit),
            Method::FileWrite => (vec![Value::Bytes], Value::ResultCount),
            Method::FileWriteRaw => (vec![Value::Bytes], Value::Error),
            Method::FileWriteAll => (vec![Value::Bytes], Value::ResultUnit),
            Method::Process => (vec![], Value::Process),
            Method::Clock => (vec![], Value::Clock),
            Method::WorldFile => (vec![Value::Byte], Value::ResultFile),
            Method::TemporaryFile => (vec![], Value::ResultFile),
            Method::StdinFile => (vec![], Value::ResultFile),
            Method::StdoutFile => (vec![], Value::ResultFile),
            Method::StderrFile => (vec![], Value::ResultFile),
            Method::Executable => (vec![], Value::ResultFile),
            Method::ClockRead => (vec![Value::MutableBytes], Value::Error),
            Method::ClockNow => (vec![], Value::ResultCount),
            Method::ProcessSpawn => (
                vec![
                    Value::FileRef,
                    Value::ArgumentsView,
                    Value::FileRef,
                    Value::FileRef,
                    Value::FileRef,
                    Value::FileRef,
                ],
                Value::ResultChild,
            ),
            Method::ProcessSpawnRaw => (
                vec![
                    Value::FileRef,
                    Value::Bytes,
                    Value::FileRef,
                    Value::FileRef,
                    Value::FileRef,
                    Value::FileRef,
                ],
                Value::ResultChild,
            ),
            Method::ChildWait => (vec![], Value::ResultStatus),
            Method::ChildTryWait => (vec![], Value::ResultMaybeStatus),
            Method::ChildWaitRaw => (vec![Value::Boolean], Value::Error),
            Method::ChildTerminate => (vec![], Value::ResultUnit),
            Method::ChildTerminateRaw => (vec![], Value::Error),
            Method::FileRewind => (vec![], Value::ResultUnit),
            Method::FileRewindRaw => (vec![], Value::Error),
            Method::FileExecutable | Method::FileSeal => (vec![], Value::ResultUnit),
            Method::FileExecutableRaw | Method::FileSealRaw => (vec![], Value::Error),
            Method::FileDuplicate | Method::FileReadOnly | Method::FileReadOnlyRaw => {
                (vec![], Value::ResultFile)
            }
            Method::OpenDirectory => (vec![Value::Text], Value::ResultDirectory),
            Method::OpenDirectoryRaw => (vec![Value::Bytes], Value::ResultDirectory),
            Method::DirectoryRead => (vec![Value::MutableBytes], Value::Error),
            Method::DirectoryRewind => (vec![], Value::Error),
            Method::DirectoryList => (vec![], Value::ResultNames),
            Method::CreateDirectory => (vec![Value::Text], Value::ResultUnit),
            Method::CreateDirectoryRaw => (vec![Value::Bytes], Value::Error),
            Method::DirectoryRemove => (vec![Value::Text], Value::ResultUnit),
            Method::DirectoryRemoveDirectory => (vec![Value::Text], Value::ResultUnit),
            Method::DirectoryRemoveRaw => (vec![Value::Bytes, Value::Boolean], Value::Error),
            Method::DirectoryRename => (vec![Value::Text, Value::Text], Value::ResultUnit),
            Method::DirectoryRenameRaw => (
                vec![Value::Bytes, Value::DirectoryRef, Value::Bytes],
                Value::Error,
            ),
        }
    }
    pub(super) fn intrinsic(self) -> Option<ir::IntrinsicOp> {
        Some(match self {
            Method::Stdout => ir::IntrinsicOp::WorldStdout,
            Method::Stdin => ir::IntrinsicOp::WorldStdin,
            Method::Stderr => ir::IntrinsicOp::WorldStderr,
            Method::ExitStatus => ir::IntrinsicOp::WorldExitStatus,
            Method::EnvironmentLen => ir::IntrinsicOp::EnvironmentLen,
            Method::EnvironmentCopy => ir::IntrinsicOp::EnvironmentCopy,
            Method::ArgCount => ir::IntrinsicOp::WorldArgCount,
            Method::ArgLen => ir::IntrinsicOp::WorldArgLen,
            Method::ArgCopy => ir::IntrinsicOp::WorldArgCopy,
            Method::DirectoryRaw => ir::IntrinsicOp::WorldDirectory,
            Method::WorldListenRaw => ir::IntrinsicOp::WorldListen,
            Method::WorldConnectorRaw => ir::IntrinsicOp::WorldConnector,
            Method::ConnectorConnect => ir::IntrinsicOp::ConnectorConnect,
            Method::ListenerAccept => ir::IntrinsicOp::ListenerAccept,
            Method::ListenerAcceptNoDelay => ir::IntrinsicOp::ListenerAcceptNoDelay,
            Method::ListenerAddressRaw => ir::IntrinsicOp::ListenerAddress,
            Method::WorldReadiness => ir::IntrinsicOp::WorldReadiness,
            Method::WorldEntropy => ir::IntrinsicOp::WorldEntropy,
            Method::EntropyFill => ir::IntrinsicOp::EntropyFill,
            Method::ClockUnixSeconds => ir::IntrinsicOp::ClockUnixSeconds,
            Method::ClockUnixNanoseconds => ir::IntrinsicOp::ClockUnixNanoseconds,
            Method::FileSetPrivate => ir::IntrinsicOp::FileSetPrivate,
            Method::WorldStop => ir::IntrinsicOp::WorldStop,
            Method::StopRequested => ir::IntrinsicOp::StopRequested,
            Method::StopTarget => ir::IntrinsicOp::StopTarget,
            Method::ReadinessWatchStop => ir::IntrinsicOp::ReadinessWatchStop,
            Method::ReadinessUnwatchStop => ir::IntrinsicOp::ReadinessUnwatchStop,
            Method::ChildRequestStop => ir::IntrinsicOp::ChildRequestStop,
            Method::FileSetNonblocking => ir::IntrinsicOp::FileSetNonblocking,
            Method::ListenerSetNonblocking => ir::IntrinsicOp::ListenerSetNonblocking,
            Method::ReadinessWatchFile => ir::IntrinsicOp::ReadinessWatchFile,
            Method::ReadinessWatchListener => ir::IntrinsicOp::ReadinessWatchListener,
            Method::ReadinessUnwatchFile => ir::IntrinsicOp::ReadinessUnwatchFile,
            Method::ReadinessUnwatchListener => ir::IntrinsicOp::ReadinessUnwatchListener,
            Method::ReadinessWait => ir::IntrinsicOp::ReadinessWait,

            Method::StdoutWrite => ir::IntrinsicOp::StdoutWrite,
            Method::StderrWrite => ir::IntrinsicOp::StderrWrite,
            Method::StdinReadRaw => ir::IntrinsicOp::StdinRead,
            Method::DirectoryOpenRaw => ir::IntrinsicOp::DirectoryOpen,
            Method::ReadDirectoryOpenRaw => ir::IntrinsicOp::ReadDirectoryOpen,
            Method::ReadOpenDirectoryRaw => ir::IntrinsicOp::ReadDirectoryOpenDirectory,
            Method::FileSeek => ir::IntrinsicOp::FileSeek,
            Method::FileModifiedNanoseconds => ir::IntrinsicOp::FileModifiedNanoseconds,
            Method::ForeignRunRaw => ir::IntrinsicOp::ForeignRun,
            Method::ForeignImage => ir::IntrinsicOp::ForeignImage,
            Method::DirectoryCreateNewRaw => ir::IntrinsicOp::DirectoryCreateNew,
            Method::DirectoryCreatePrivateRaw => ir::IntrinsicOp::DirectoryCreatePrivate,
            Method::DirectoryOpenAppendRaw => ir::IntrinsicOp::DirectoryOpenAppend,
            Method::DirectorySync => ir::IntrinsicOp::DirectorySync,
            Method::FileSync => ir::IntrinsicOp::FileSync,
            Method::FileTruncate => ir::IntrinsicOp::FileTruncate,
            Method::FileLockExclusive => ir::IntrinsicOp::FileLockExclusive,
            Method::FileLockWait => ir::IntrinsicOp::FileLockWait,
            Method::FileReadRaw => ir::IntrinsicOp::FileRead,
            Method::FileWriteRaw => ir::IntrinsicOp::FileWrite,
            Method::Process => ir::IntrinsicOp::WorldProcess,
            Method::Clock => ir::IntrinsicOp::WorldClock,
            Method::WorldFile => ir::IntrinsicOp::WorldFile,
            Method::ClockRead => ir::IntrinsicOp::ClockRead,
            Method::ProcessSpawnRaw => ir::IntrinsicOp::ProcessSpawn,
            Method::ChildWaitRaw => ir::IntrinsicOp::ChildWait,
            Method::ChildTerminateRaw => ir::IntrinsicOp::ChildTerminate,
            Method::FileRewindRaw => ir::IntrinsicOp::FileRewind,
            Method::FileExecutableRaw => ir::IntrinsicOp::FileExecutable,
            Method::FileSealRaw => ir::IntrinsicOp::FileSeal,
            Method::FileDuplicate => ir::IntrinsicOp::FileDuplicate,
            Method::FileReadOnlyRaw => ir::IntrinsicOp::FileReadOnly,
            Method::OpenDirectoryRaw => ir::IntrinsicOp::DirectoryOpenDirectory,
            Method::DirectoryRead => ir::IntrinsicOp::DirectoryRead,
            Method::DirectoryRewind => ir::IntrinsicOp::DirectoryRewind,
            Method::CreateDirectoryRaw => ir::IntrinsicOp::DirectoryCreate,
            Method::DirectoryRemoveRaw => ir::IntrinsicOp::DirectoryRemove,
            Method::DirectoryRenameRaw => ir::IntrinsicOp::DirectoryRename,
            _ => return None,
        })
    }
    pub(super) fn helper(self) -> Option<&'static str> {
        Some(match self {
            Method::Args => "__lkjscript_args",
            Method::CommandArgs => "__lkjscript_command_args",
            Method::EnvironmentGet => "__lkjscript_environment_get",
            Method::Directory => "__lkjscript_directory",
            Method::WorldListen => "__lkjscript_listen",
            Method::ListenerPort => "__lkjscript_listener_port",
            Method::StdinRead => "__lkjscript_stdin_read",
            Method::StdinReadToEnd => "__lkjscript_stdin_read_to_end",
            Method::DirectoryOpen => "__lkjscript_open",
            Method::ReadDirectoryOpen => "__lkjscript_read_open",
            Method::ReadOpenDirectory => "__lkjscript_read_open_directory",
            Method::ReadDirectoryList => "__lkjscript_read_directory_list",
            Method::ReadFileRead => "__lkjscript_read_file_read",
            Method::ReadFileReadToEnd => "__lkjscript_read_file_read_to_end",
            Method::ForeignRun => "__lkjscript_run",
            Method::DirectoryCreate => "__lkjscript_create",
            Method::FileRead => "__lkjscript_file_read",
            Method::FileWrite => "__lkjscript_file_write",
            Method::FileReadToEnd => "__lkjscript_file_read_to_end",
            Method::FileWriteAll => "__lkjscript_file_write_all",
            Method::TemporaryFile => "__lkjscript_temporary_file",
            Method::StdinFile => "__lkjscript_stdin_file",
            Method::StdoutFile => "__lkjscript_stdout_file",
            Method::StderrFile => "__lkjscript_stderr_file",
            Method::Executable => "__lkjscript_executable",
            Method::ClockNow => "__lkjscript_clock_nanoseconds",
            Method::ProcessSpawn => "__lkjscript_process_spawn",
            Method::ChildWait => "__lkjscript_child_wait",
            Method::ChildTryWait => "__lkjscript_child_try_wait",
            Method::ChildTerminate => "__lkjscript_child_terminate",
            Method::FileRewind => "__lkjscript_file_rewind",
            Method::FileExecutable => "__lkjscript_file_executable",
            Method::FileSeal => "__lkjscript_file_seal",
            Method::FileReadOnly => "__lkjscript_file_readonly",
            Method::OpenDirectory => "__lkjscript_open_directory",
            Method::DirectoryList => "__lkjscript_directory_list",
            Method::CreateDirectory => "__lkjscript_create_directory",
            Method::DirectoryRemove => "__lkjscript_directory_remove",
            Method::DirectoryRemoveDirectory => "__lkjscript_directory_remove_directory",
            Method::DirectoryRename => "__lkjscript_directory_rename",
            _ => return None,
        })
    }
}

fn storage_method(name: &str) -> bool {
    matches!(name, "create_new" | "open_append" | "__lkjscript_create_new" | "__lkjscript_open_append"
        | "sync" | "seek" | "modified_nanoseconds" | "truncate" | "lock_exclusive" | "lock_wait" | "unix_nanoseconds" | "get" | "set_status"
        | "entropy" | "fill" | "unix_seconds" | "set_private" | "stop" | "requested" | "target"
        | "watch_stop" | "unwatch_stop" | "request_stop" | "create_private" | "__lkjscript_create_private"
        | "run" | "__lkjscript_run" | "image" | "__lkjscript_image")
}

fn nominal_storage_target(source: &super::a::Program, mut target: usize) -> bool {
    // New builtin spellings must not eagerly intern unrelated ordinary types.
    // Resolve aliases syntactically so an alias to File still receives the check.
    let mut seen = std::collections::BTreeSet::new();
    while seen.insert(target) {
        let super::a::Type::Path(path) = &source.types[target].kind else { return false; };
        let Some(declaration) = path.declaration else { return false; };
        match source.declarations[declaration].item {
            super::a::Item::Struct(_) | super::a::Item::Enum(_) => return true,
            super::a::Item::Alias(alias) => target = source.aliases[alias].ty,
            _ => return false,
        }
    }
    false
}

fn reserved(name: &str) -> bool {
    let receivers = [
        Receiver::World,
        Receiver::Arguments,
        Receiver::Environment,
        Receiver::ExitStatus,
        Receiver::Stdout,
        Receiver::Stdin,
        Receiver::Stderr,
        Receiver::Directory,
        Receiver::ReadDirectory,
        Receiver::ReadFile,
        Receiver::ForeignCommand,
        Receiver::NullDevice,
        Receiver::File,
        Receiver::Process,
        Receiver::Clock,
        Receiver::Child,
        Receiver::Listener,
        Receiver::Connector,
        Receiver::Readiness,
        Receiver::Entropy,
        Receiver::Stop,
    ];
    let mut index = 0;
    while index < receivers.len() {
        if method(receivers[index], name).is_some() {
            return true;
        }
        index += 1;
    }
    false
}

impl super::Compiler<'_> {
    pub(super) fn check_capability_methods(&mut self) -> super::Result<()> {
        let mut implementation_index = 0;
        while implementation_index < self.source.impls.len() {
            let implementation = self.source.impls[implementation_index].clone();
            implementation_index += 1;
            if implementation.trait_ty.is_some() {
                continue;
            }
            let mut relevant = false;
            let nominal = nominal_storage_target(self.source, implementation.target);
            for method in &implementation.methods {
                let name = &self.source.functions[*method].name;
                if reserved(name) && !(nominal && storage_method(name)) {
                    relevant = true;
                }
            }
            if !relevant {
                continue;
            }
            let Ok(target) =
                self.resolve(implementation.target, &std::collections::BTreeMap::new())
            else {
                continue;
            };
            let receiver = super::methods::receiver(&self.types[target].kind);
            for index in &implementation.methods {
                let function = &self.source.functions[*index];
                if method(receiver, &function.name).is_some() {
                    return Err(super::err(
                        function.span,
                        "E_TRAIT",
                        &format!(
                            "inherent method {} duplicates builtin {}::{}; help: rename it or define an extension trait",
                            function.name,
                            self.display_type(target),
                            function.name
                        ),
                    ));
                }
            }
        }
        Ok(())
    }
}

//! Definition-site verification through the production elaborator and IR checker.
//!
//! Rigid IDs are abstract type variables, not sampled concrete instantiations.
//! Their private IR storage shape supplies only affine/Copy behavior. Trait proof
//! consults the explicit assumptions below before structural rules, and source
//! cannot name or construct these IDs. Verification programs are consumed here;
//! no abstract value, assumed method, or verification artifact reaches emission.
use super::{Compiler, Instance, Result, a, err, ir};
use crate::generics::TraitIdentity;
use std::collections::{BTreeMap, BTreeSet};

#[derive(Clone)]
pub(super) struct MethodWitness {
    pub(super) declaration: usize,
    pub(super) identity: TraitIdentity,
    pub(super) method: usize,
    pub(super) substitutions: BTreeMap<String, usize>,
}

/// Builtin operations have typed contracts only in the discarded verification
/// program. Concrete instantiations still select and compile real methods.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub(super) enum BuiltinMethod {
    Clone,
    CloneFrom,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    // Private comparison classification: -1, 0, 1, or 2 (unordered).
    Order,
}

impl BuiltinMethod {
    pub(super) fn named(name: &str) -> Option<Self> {
        match name {
            "clone" => Some(Self::Clone),
            "clone_from" => Some(Self::CloneFrom),
            "eq" => Some(Self::Eq),
            "ne" => Some(Self::Ne),
            "lt" => Some(Self::Lt),
            "le" => Some(Self::Le),
            "gt" => Some(Self::Gt),
            "ge" => Some(Self::Ge),
            _ => None,
        }
    }

    pub(super) fn name(self) -> &'static str {
        match self {
            Self::Clone => "clone",
            Self::CloneFrom => "clone_from",
            Self::Eq => "eq",
            Self::Ne => "ne",
            Self::Lt => "lt",
            Self::Le => "le",
            Self::Gt => "gt",
            Self::Ge => "ge",
            Self::Order => "$order",
        }
    }

    pub(super) fn required(self) -> &'static str {
        match self {
            Self::Clone | Self::CloneFrom => "Clone",
            Self::Eq | Self::Ne => "PartialEq",
            Self::Lt | Self::Le | Self::Gt | Self::Ge | Self::Order => "PartialOrd",
        }
    }

    pub(super) fn arguments(self) -> usize {
        if self == Self::Clone { 0 } else { 1 }
    }

    pub(super) fn result(self, receiver: usize) -> usize {
        match self {
            Self::Clone => receiver,
            Self::CloneFrom => ir::UNIT,
            Self::Eq | Self::Ne | Self::Lt | Self::Le | Self::Gt | Self::Ge => ir::BOOL,
            Self::Order => ir::I32,
        }
    }
}

/// Source-bound choices survive verification; no verification type/function ID
/// is retained. Replaying a call specializes this choice, never name lookup.
#[derive(Clone)]
pub(super) enum MethodTarget {
    Builtin,
    Trait(TraitIdentity),
    AppliedTrait(usize, super::trait_arguments::Recipe),
    Source(usize),
}

#[derive(Clone)]
pub(super) struct MethodSelection {
    pub(super) dereferences: usize,
    pub(super) target: MethodTarget,
}

pub(super) type MethodSelections = BTreeMap<a::ExprId, MethodSelection>;

#[derive(Default)]
pub(super) struct Contracts {
    pub(super) active_scope: usize,
    pub(super) rigid: BTreeMap<usize, BTreeSet<TraitIdentity>>,
    pub(super) type_outlives: BTreeMap<usize, BTreeSet<crate::check::scoped::Region>>,
    pub(super) active_where_predicates: BTreeSet<a::TypeId>,
    // (rigid receiver, resolved trait declaration) -> associated-type identities.
    pub(super) traits: BTreeMap<(usize, TraitIdentity), BTreeMap<String, usize>>,
    pub(super) equalities: BTreeMap<(usize, TraitIdentity, String), usize>,
    pub(super) equality_sources: BTreeMap<(usize, TraitIdentity, String), Vec<(a::TypeId, BTreeMap<String, usize>, a::Span)>>,
    pub(super) equality_active: BTreeSet<(usize, TraitIdentity, String)>,
    pub(super) equality_collecting: bool,
    applied_sources: BTreeMap<(usize, a::TypeId, Vec<(String, usize)>), BTreeSet<TraitIdentity>>,
    obsolete_applications: BTreeSet<(usize, TraitIdentity)>,
    methods: BTreeMap<usize, MethodWitness>,
    comparisons: BTreeMap<(usize, String), usize>,
    builtin_methods: BTreeMap<(usize, BuiltinMethod), usize>,
    pub(super) families: BTreeMap<(usize, TraitIdentity, String, Vec<usize>), usize>,
    pub(super) active_families: Vec<(usize, TraitIdentity, String, Vec<usize>)>,
}

#[derive(Default)]
pub(super) struct DefinitionEvidence {
    pub(super) methods: MethodSelections,
    pub(super) types: BTreeMap<usize, super::definition_types::DefinitionTypes>,
    pub(super) closures: super::closures::Evidence,
}

pub(super) fn validate_report<'source>(
    source: &'source a::Program,
    definitions: BTreeMap<usize, super::definition_types::DefinitionTypes>,
    capture_references: bool,
) -> Result<(Compiler<'source>, DefinitionEvidence, Vec<a::Diagnostic>)> {
    let mut compiler = Compiler::new_with_capture(source, capture_references)?;
    let (evidence, problems) = validate_selected(source, &mut compiler, definitions, true)?;
    Ok((compiler, evidence, problems))
}

pub(super) fn validate_demand(
    source: &a::Program,
    compiler: &mut Compiler<'_>,
    definitions: BTreeMap<usize, super::definition_types::DefinitionTypes>,
) -> Result<(DefinitionEvidence, Vec<a::Diagnostic>)> {
    validate_selected(source, compiler, definitions, false)
}

fn validate_selected(
    source: &a::Program,
    compiler: &mut Compiler<'_>,
    definitions: BTreeMap<usize, super::definition_types::DefinitionTypes>,
    validate_derives: bool,
) -> Result<(DefinitionEvidence, Vec<a::Diagnostic>)> {
    let mut roots = Vec::new();
    for index in definitions.keys() {
        let index = *index;
        let function = &source.functions[index];
        if function.body.is_none() {
            continue;
        }
        let mut generic = false;
        for parameter in &function.generics {
            if !parameter.lifetime || !parameter.bounds.is_empty() {
                generic = true;
                break;
            }
        }
        if function.const_qualified || generic || !function.predicates.is_empty() || !function.outlives.is_empty()
            || source.function_owner(a::FunctionId { index }) != a::FunctionOwner::Free
            || source.impl_traits.values().any(|form| form.result.is_some()) {
            roots.push(index);
        }
    }
    if roots.is_empty() && !validate_derives {
        return Ok((
            DefinitionEvidence {
                methods: MethodSelections::default(),
                closures: super::closures::Evidence::default(),
                types: definitions,
            },
            Vec::new(),
        ));
    }
    compiler.reset_definition_verification();
    compiler.definition_types = definitions;
    compiler.contracts = Some(Contracts::default());
    if validate_derives {
        compiler.validate_qualified_headers()?;
        super::instantiate_type_headers(source, compiler, true)?;
        super::derive_check::validate(compiler)?;
    }
    if roots.is_empty() {
        return Ok((
            DefinitionEvidence {
                methods: MethodSelections::default(),
                closures: super::closures::Evidence::default(),
                types: std::mem::replace(&mut compiler.definition_types, BTreeMap::new()),
            },
            Vec::new(),
        ));
    }
    let mut checked_roots = BTreeSet::<usize>::new();
    let mut problems: Vec<a::Diagnostic> = Vec::new();
    for index in roots {
        let substitutions = compiler.definition_parameters(index)?;
        let declaration = compiler.instantiate(index, substitutions.clone())?;
        let function = compiler.opaque_definition(declaration, index, &substitutions)?;
        let instance = Instance {
            source: index,
            substitutions,
        };
        let checked = if compiler.opaque.checked_functions.contains(&function) {
            Ok(compiler.functions[function].clone())
        } else { compiler.compile_function(function, &instance) };
        match checked {
            Ok(body) => {
                compiler.functions[function] = body;
                checked_roots.insert(function);
            }
            Err(problem) => problems.push(problem),
        }
    }

    // User destructors retain their ordinary IR obligations. Their definitions
    // were checked above; this declaration pass attaches concrete signatures to
    // the abstract nominal layouts created while checking those definitions.
    let mut next_type = 0;
    let mut next_function = 0;
    while next_type < compiler.types.len() || next_function < compiler.pending_functions.len() {
        while next_type < compiler.types.len() {
            compiler.register_drop(next_type)?;
            next_type += 1;
        }
        let pending = match compiler.pending_functions.get(next_function) {
            Some(pending) => Some(pending.clone()),
            None => None,
        };
        if let Some((index, pending)) = pending {
            if let super::PendingFunction::Derived(instance) = pending {
                let body = compiler.compile_derived(index, &instance)?;
                compiler.functions[index] = body;
                checked_roots.insert(index);
            }
            next_function += 1;
        }
    }

    // A call uses a checked declaration's signature, or an identified declared
    // trait/builtin contract. It does not recursively re-check a specialization
    // of the callee. Each production definition has its own rigid root above;
    // nongeneric free functions still go through the normal concrete pipeline.
    let mut declared = BTreeSet::<usize>::new();
    for function in compiler.instance_names.values() {
        declared.insert(*function);
    }
    // Opaque producer roots have a separate hidden-result signature. If body
    // checking reports an error, retain that diagnostic and give its unused
    // verification declaration the same trap stub as an ordinary failed root.
    for (function, pending) in &compiler.pending_functions {
        if matches!(pending, super::PendingFunction::Source(_)) { declared.insert(*function); }
    }
    for function in &compiler.closures.checked_functions {
        checked_roots.insert(*function);
    }
    for function in &compiler.opaque.checked_functions { checked_roots.insert(*function); }
    let callable_functions = compiler.assumed_callable_functions();
    let builtin_methods = compiler.validate_builtin_methods()?;
    let contracts = compiler.contracts.as_ref().unwrap();
    for index in 0..compiler.functions.len() {
        let function = &mut compiler.functions[index];
        if checked_roots.contains(&index) {
            continue;
        }
        if let Some(witness) = contracts.methods.get(&index) {
            let receiver = witness
                .substitutions
                .get(&"Self".to_string())
                .copied()
                .ok_or_else(|| {
                    err(
                        a::Span::default(),
                        "E_GENERIC",
                        "trait witness is missing its receiver type",
                    )
                })?;
            if !source.traits[witness.declaration]
                .methods
                .contains(&witness.method)
                || !contracts
                    .traits
                    .contains_key(&(receiver, witness.identity.clone()))
            {
                return Err(err(
                    a::Span::default(),
                    "E_GENERIC",
                    "call does not match its declared trait witness",
                ));
            }
        }
        let mut builtin = callable_functions.contains(&index) || builtin_methods.contains(&index);
        if !builtin {
            for value in contracts.comparisons.values() {
                if *value == index {
                    builtin = true;
                    break;
                }
            }
        }
        if !declared.contains(&index) && !builtin {
            return Err(err(
                a::Span {
                    file: function.file,
                    ..a::Span::default()
                },
                "E_GENERIC",
                "verification call has no declaration or trait contract",
            ));
        }
        function.body = vec![ir::Instruction {
            file: None,
            column: 1,
            op: ir::Op::Trap {
                message: "abstract declared contract".to_string(),
            },
            line: 1,
        }];
    }
    if let Err(problem) = compiler.check_phantom_types() { problems.push(problem); }
    let mut refinement = compiler.closures.checked_functions.clone();
    for function in &compiler.return_inference {
        refinement.insert(*function);
    }
    let (scopes, scoped_problems) = compiler.scoped_definitions(&checked_roots);
    for problem in scoped_problems {
        problems.push(problem);
    }
    let mut program = ir::Program {
        sources: super::source_paths(compiler.source), types: std::mem::replace(&mut compiler.types, Vec::new()),
        functions: std::mem::replace(&mut compiler.functions, Vec::new()),
        destructors: std::mem::replace(&mut compiler.destructors, Vec::new()),
    };
    for problem in crate::check::refine_return_contracts(&mut program, &refinement) {
        problems.push(problem);
    }
    for problem in crate::check::scoped::check_definitions(&program, &scopes) {
        problems.push(problem);
    }
    if let Some(errors) = crate::check::check_all(program).err() {
        for problem in errors {
            problems.push(problem);
        }
    }
    Ok((
        DefinitionEvidence {
            methods: std::mem::replace(&mut compiler.method_selections, BTreeMap::new()),
            closures: std::mem::replace(
                &mut compiler.closures.evidence,
                super::closures::Evidence::default(),
            ),
            types: std::mem::replace(&mut compiler.definition_types, BTreeMap::new()),
        },
        problems,
    ))
}

impl Compiler<'_> {
    // Keep immutable source indexes; only the discarded verification IR belongs
    // to a batch. Rebuilding the indexes here would scan the entire input for
    // every newly demanded library method.
    fn reset_definition_verification(&mut self) {
        self.anonymous_fields = BTreeMap::new();
        self.types = ir::primitives();
        self.type_names = BTreeMap::new();
        self.type_keys = BTreeMap::new();
        self.functions = Vec::new();
        self.pending_functions = Vec::new();
        self.derived_functions = BTreeMap::new();
        self.instance_names = BTreeMap::new();
        self.applications = BTreeMap::new();
        self.phantom_spans = BTreeMap::new();
        self.destructors = Vec::new();
        self.contracts = None;
        self.method_selections = BTreeMap::new();
        self.definition_types = BTreeMap::new();
        self.closures = super::closures::Catalog::default();
        self.opaque = super::opaque::Catalog::default();
        self.scoped_bodies = BTreeMap::new();
        self.trait_proofs = None;
        self.return_inference = BTreeSet::new();
        self.associated_queries = super::associated_types::Queries::default();
        self.diagnostic_functions = None;
        self.initialize_primitive_names();
    }

    pub(super) fn rigid_type(&mut self, name: &str) -> usize {
        let id = self.types.len();
        self.types.push(ir::Type {
            name: format!("$rigid:{name}:{id}"),
            kind: ir::TypeKind::Struct {
                fields: Vec::new(),
                copy: false,
            },
        });
        let mut assumptions = BTreeSet::new();
        assumptions.insert(TraitIdentity::Builtin("Sized".to_string()));
        self.contracts
            .as_mut()
            .unwrap()
            .rigid
            .insert(id, assumptions);
        id
    }

    fn introduce_parameters(
        &mut self,
        parameters: &[a::GenericParam],
        substitutions: &mut BTreeMap<String, usize>,
    ) -> Result<()> {
        for parameter in parameters {
            if parameter.lifetime {
                continue;
            }
            if substitutions.contains_key(&parameter.name) {
                return Err(err(
                    parameter.span,
                    "E_GENERIC",
                    "type parameter shadows an enclosing parameter",
                ));
            }
            let ty = if parameter.constant { self.rigid_constant(&parameter.name) }
                else { self.rigid_type(&parameter.name) };
            if !parameter.constant && !crate::generics::parameter_requires_sized(self.source, parameter) {
                self.contracts.as_mut().unwrap().rigid.get_mut(&ty).unwrap()
                    .remove(&TraitIdentity::Builtin("Sized".to_string()));
            }
            substitutions.insert(parameter.name.clone(), ty);
        }
        Ok(())
    }

    pub(super) fn declare_parameters(
        &mut self,
        parameters: &[a::GenericParam],
        substitutions: &mut BTreeMap<String, usize>,
    ) -> Result<()> {
        self.introduce_parameters(parameters, substitutions)?;
        self.assume_parameter_bounds(parameters, substitutions)
    }

    pub(super) fn declare_parameters_with_predicates(
        &mut self,
        parameters: &[a::GenericParam],
        predicates: &[a::WherePredicate],
        substitutions: &mut BTreeMap<String, usize>,
    ) -> Result<()> {
        self.introduce_parameters(parameters, substitutions)?;
        self.assume_parameter_contract(parameters, predicates, substitutions)
    }

    pub(super) fn assume_parameter_bounds(
        &mut self,
        parameters: &[a::GenericParam],
        substitutions: &BTreeMap<String, usize>,
    ) -> Result<()> {
        let predicates: Vec<a::WherePredicate> = Vec::new();
        self.assume_parameter_contract(parameters, &predicates, substitutions)
    }

    fn introduce_parameter_headers(&mut self, parameters: &[a::GenericParam],
        predicates: &[a::WherePredicate], substitutions: &BTreeMap<String, usize>)
        -> Result<Vec<(a::WherePredicate, usize)>> {
        let mut pending: Vec<(usize, a::TypeId)> = Vec::new();
        for parameter in parameters {
            if parameter.lifetime { continue; }
            let receiver = *substitutions.get(&parameter.name).unwrap();
            for bound in &parameter.bounds {
                if !self.is_callable_bound(*bound) { pending.push((receiver, *bound)); }
            }
        }
        let mut where_pending = predicates.to_vec();
        let mut resolved: Vec<(a::WherePredicate, usize)> = Vec::new();
        while !pending.is_empty() || !where_pending.is_empty() {
            let before = pending.len() + where_pending.len();
            let mut retry: Vec<(usize, a::TypeId)> = Vec::new();
            let mut where_retry: Vec<a::WherePredicate> = Vec::new();
            let mut failure: Option<a::Diagnostic> = None;
            for (receiver, bound) in pending {
                match self.assume_bound_with_equalities(receiver, bound, substitutions, false) {
                    Ok(_) => {}
                    Err(problem) => { failure = Some(problem); retry.push((receiver, bound)); }
                }
            }
            for predicate in where_pending {
                match self.introduce_where_predicates(&vec![predicate.clone()], substitutions) {
                    Ok(found) => resolved.extend_from_slice(&found),
                    Err(problem) => { failure = Some(problem); where_retry.push(predicate); }
                }
            }
            if retry.len() + where_retry.len() == before { return Err(failure.unwrap()); }
            pending = retry; where_pending = where_retry;
        }
        Ok(resolved)
    }

    fn retire_refined_applications(&mut self) {
        let obsolete = std::mem::replace(&mut self.contracts.as_mut().unwrap().obsolete_applications, BTreeSet::new());
        for (receiver, identity) in obsolete {
            let mut retained = false;
            for (source, identities) in &self.contracts.as_ref().unwrap().applied_sources {
                if source.0 == receiver && identities.contains(&identity) { retained = true; break; }
            }
            if retained { continue; }
            let contracts = self.contracts.as_mut().unwrap();
            contracts.rigid.get_mut(&receiver).unwrap().remove(&identity);
            contracts.traits.remove(&(receiver, identity.clone()));
            let mut removed: Vec<(usize, TraitIdentity, String)> = Vec::new();
            for key in contracts.equalities.keys() {
                if key.0 == receiver && key.1 == identity { removed.push(key.clone()); }
            }
            for key in removed { contracts.equalities.remove(&key); }
        }
    }

    fn refine_applied_parameter_bounds(&mut self, parameters: &[a::GenericParam],
        predicates: &[(a::WherePredicate, usize)], substitutions: &BTreeMap<String, usize>)
        -> Result<Option<Vec<(Vec<a::WherePredicate>, BTreeMap<String, usize>)>>> {
        if self.contracts.as_ref().unwrap().applied_sources.is_empty() { return Ok(None); }
        loop {
            let before = self.contracts.as_ref().unwrap().applied_sources.clone();
            let before_equalities = self.contracts.as_ref().unwrap().equalities.clone();
            self.contracts.as_mut().unwrap().equality_collecting = true;
            let mut declared_predicates: Vec<(Vec<a::WherePredicate>, BTreeMap<String, usize>)> = Vec::new();
            for parameter in parameters {
                if parameter.lifetime { continue; }
                let receiver = *substitutions.get(&parameter.name).unwrap();
                for bound in &parameter.bounds {
                    if !self.is_callable_bound(*bound) {
                        let declared = self.assume_bound_with_equalities(receiver, *bound, substitutions, true)?;
                        declared_predicates.extend_from_slice(&declared);
                    }
                }
            }
            self.collect_where_equalities(predicates, substitutions)?;
            self.contracts.as_mut().unwrap().equality_collecting = false;
            self.finish_associated_equalities()?;
            self.retire_refined_applications();
            if self.contracts.as_ref().unwrap().applied_sources == before
                && self.contracts.as_ref().unwrap().equalities == before_equalities { return Ok(Some(declared_predicates)); }
        }
    }

    fn assume_parameter_contract(
        &mut self,
        parameters: &[a::GenericParam],
        predicates: &[a::WherePredicate],
        substitutions: &BTreeMap<String, usize>,
    ) -> Result<()> {
        // Associated identities come from declared trait bounds. Establish all
        // of them before a callable signature resolves a sibling's I::Item,
        // regardless of the source order of generic parameter declarations.
        let where_headers = self.introduce_parameter_headers(parameters, predicates, substitutions)?;
        for phase in 1..3usize {
            // Register every sibling equation before resolving any of them.
            // A projection on the right may be defined by a later parameter.
            self.contracts.as_mut().unwrap().equality_collecting = phase == 1;
            let callable = phase == 2;
            let mut declared_predicates = Vec::new();
            for parameter in parameters {
                if parameter.lifetime {
                    continue;
                }
                let ty = *substitutions.get(&parameter.name).unwrap();
                for bound in &parameter.bounds {
                    if self.is_callable_bound(*bound) == callable {
                        let declared = self.assume_bound_with_equalities(ty, *bound, substitutions, phase != 0)?;
                        if phase == 1 { declared_predicates.extend_from_slice(&declared); }
                    }
                }
            }
            if phase == 1 {
                let collected = self.collect_where_equalities(&where_headers, substitutions);
                self.contracts.as_mut().unwrap().equality_collecting = false;
                collected?;
                self.finish_associated_equalities()?;
                if let Some(refined) = self.refine_applied_parameter_bounds(parameters, &where_headers, substitutions)? {
                    declared_predicates = refined;
                }
                // Trait predicates can use a sibling equality or a supertrait
                // projection. Establish both before resolving their targets.
                for (declared, environment) in declared_predicates {
                    self.assume_where_predicates(&declared, &environment)?;
                }
                self.finish_where_predicates(&where_headers, substitutions)?;
                for parameter in parameters {
                    if parameter.lifetime || parameter.constant { continue; }
                    let ty = *substitutions.get(&parameter.name).unwrap();
                    let identities = self.contracts.as_ref().unwrap().rigid.get(&ty).unwrap().clone();
                    for identity in identities { self.trait_argument_contract(ty, &identity, parameter.span)?; }
                }
            }
        }
        Ok(())
    }

    pub(super) fn assume_builtin(&mut self, ty: usize, name: &str) {
        let assumptions = self.contracts.as_mut().unwrap().rigid.get_mut(&ty).unwrap();
        assumptions.insert(TraitIdentity::Builtin(name.to_string()));
        for parent in crate::generics::builtin_parents(name) {
            assumptions.insert(TraitIdentity::Builtin(parent));
        }
        if name == "Copy" {
            self.types[ty].kind = ir::TypeKind::Struct {
                fields: Vec::new(),
                copy: true,
            };
        }
    }

    pub(super) fn assume_bound(
        &mut self,
        ty: usize,
        first: a::TypeId,
        substitutions: &BTreeMap<String, usize>,
    ) -> Result<()> {
        let predicates = self.assume_bound_with_equalities(ty, first, substitutions, true)?;
        for (predicates, environment) in predicates { self.assume_where_predicates(&predicates, &environment)?; }
        let identities = self.contracts.as_ref().unwrap().rigid.get(&ty).unwrap().clone();
        let span = self.source.types[first].span;
        for identity in identities { self.trait_argument_contract(ty, &identity, span)?; }
        Ok(())
    }

    pub(super) fn assume_bound_with_equalities(
        &mut self,
        ty: usize,
        first: a::TypeId,
        substitutions: &BTreeMap<String, usize>,
        equalities: bool,
    ) -> Result<Vec<(Vec<a::WherePredicate>, BTreeMap<String, usize>)>> {
        let mut pending = vec![(first, substitutions.clone())];
        let mut seen = BTreeSet::<TraitIdentity>::new();
        let mut bindings: Vec<(a::Path, BTreeMap<String, usize>)> = Vec::new();
        let mut predicates = Vec::new();
        while let Some((id, inherited_substitutions)) = pending.pop() {
            if self.source.relaxed_bounds.contains(&id) { continue; }
            let node = self.source.types[id].clone();
            if let a::Type::Path(path) = &node.kind {
                if self.assume_callable(ty, path, &inherited_substitutions, node.span)? {
                    continue;
                }
            }
            let path = match node.kind {
                a::Type::Path(path) => path,
                _ => {
                    return Err(err(
                        node.span,
                        "E_UNSUPPORTED",
                        "definition-site parameterized trait bounds are not implemented",
                    ));
                }
            };
            if path.name.starts_with('\'') {
                self.assume_type_outlives(ty, &path.name);
                continue;
            }
            let identity = self.trait_identity(&path, &inherited_substitutions, node.span)?;
            if !seen.insert(identity.clone()) { continue; }
            let inserted = self
                .contracts
                .as_mut()
                .unwrap()
                .rigid
                .get_mut(&ty)
                .unwrap()
                .insert(identity.clone());
            if !inserted && !equalities {
                continue;
            }
            let builtin = match &identity {
                TraitIdentity::Builtin(name) => name.as_str(),
                _ => "",
            };
            if !builtin.is_empty() {
                self.assume_builtin(ty, builtin);
            }
            let trait_index = identity.declaration();
            if let Some(trait_index) = trait_index {
                let declaration = self.source.traits[trait_index].clone();
                let environment = self.trait_environment(ty, &identity);
                for bound in &declaration.bounds {
                    pending.push((*bound, environment.clone()));
                }
                // Associated projections are introduced lazily. A valid bound
                // such as A::Next: A must not eagerly create an infinite family.
                {
                    let traits = &mut self.contracts.as_mut().unwrap().traits;
                    let key = (ty, identity.clone());
                    if !traits.contains_key(&key) {
                        traits.insert(key, BTreeMap::new());
                    }
                }
                if equalities && !path.bindings.is_empty() { bindings.push((path.clone(), inherited_substitutions)); }
                predicates.push((declaration.predicates.clone(), environment));
            } else if !matches!(
                builtin,
                "Copy"
                    | "Clone"
                    | "Sized"
                    | "Data"
                    | "Send"
                    | "Sync"
                    | "Ord"
                    | "Eq"
                    | "PartialOrd"
                    | "PartialEq"
            ) {
                return Err(err(
                    node.span,
                    "E_TRAIT",
                    "unknown declared trait constraint",
                ));
            }
        }
        for (path, environment) in bindings { self.assume_associated_bindings(ty, &path, &environment)?; }
        let mut applied = false;
        for identity in &seen { if matches!(identity, TraitIdentity::Applied(_, _)) { applied = true; break; } }
        if applied {
            let mut captures: Vec<(String, usize)> = Vec::new();
            for (name, value) in substitutions { if !name.contains("::") { captures.push((name.clone(), *value)); } }
            let key = (ty, first, captures);
            let previous = self.contracts.as_mut().unwrap().applied_sources.insert(key, seen.clone());
            if let Some(previous) = previous {
                for identity in previous {
                    if matches!(identity, TraitIdentity::Applied(_, _)) && !seen.contains(&identity) {
                        self.contracts.as_mut().unwrap().obsolete_applications.insert((ty, identity));
                    }
                }
            }
        }
        Ok(predicates)
    }

    pub(super) fn definition_parameters(&mut self, index: usize) -> Result<BTreeMap<String, usize>> {
        self.contracts.as_mut().unwrap().active_scope = index;
        let function = self.source.functions[index].clone();
        let mut substitutions = BTreeMap::new();
        let owner = self.source.function_owner(a::FunctionId { index });
        if let a::FunctionOwner::Implementation(owner) = owner {
            let implementation = self.source.impls[owner.index].clone();
            let predicates = self.parameter_where_predicates(&implementation.predicates);
            self.declare_parameters_with_predicates(&implementation.generics, &predicates, &mut substitutions)?;
            let self_ty = self.resolve(implementation.target, &substitutions)?;
            substitutions.insert("Self".to_string(), self_ty);
            substitutions.insert(format!("$family::implementation:{}", owner.index), self_ty);
            self.assume_where_predicates(&implementation.predicates, &substitutions)?;
            let mut remaining = implementation.associated.clone();
            while !remaining.is_empty() {
                let before = remaining.len();
                let mut retry: Vec<a::AssociatedType> = Vec::new();
                for associated in remaining {
                    if !associated.generics.is_empty() { continue; }
                    let Some(value) = associated.value else {
                        return Err(err(
                            associated.span,
                            "E_TRAIT",
                            "implementation associated type needs a definition",
                        ));
                    };
                    match self.resolve(value, &substitutions) {
                        Ok(ty) => {
                            substitutions.insert(format!("Self::{}", associated.name), ty);
                        }
                        Err(_) => retry.push(associated),
                    }
                }
                if retry.len() == before {
                    return Err(err(
                        implementation.span,
                        "E_TRAIT",
                        "associated types are cyclic or unresolved",
                    ));
                }
                remaining = retry;
            }
        } else if let a::FunctionOwner::Trait(owner) = owner {
            substitutions = self.trait_parameters(owner.index)?;
        }
        self.declare_parameters_with_predicates(&function.generics, &function.predicates, &mut substitutions)?;
        self.assume_input_type_outlives(index, &substitutions);
        Ok(substitutions)
    }

    pub(super) fn trait_parameters(&mut self, trait_index: usize) -> Result<BTreeMap<String, usize>> {
        let mut substitutions = BTreeMap::new();
        let declaration = self.source.traits[trait_index].clone();
        let self_ty = self.rigid_type("Self");
        self.contracts.as_mut().unwrap().rigid.get_mut(&self_ty).unwrap()
            .remove(&TraitIdentity::Builtin("Sized".to_string()));
        substitutions.insert("Self".to_string(), self_ty);
        substitutions.insert(format!("$family::trait:{trait_index}"), self_ty);
        self.introduce_parameters(&declaration.generics, &mut substitutions)?;
        let mut arguments = Vec::new();
        for parameter in &declaration.generics {
            if !parameter.lifetime { arguments.push(*substitutions.get(&parameter.name).unwrap()); }
        }
        let identity = TraitIdentity::application(trait_index, arguments);
        self.contracts
            .as_mut()
            .unwrap()
            .rigid
            .get_mut(&self_ty)
            .unwrap()
            .insert(identity.clone());
        let mut associated: BTreeMap<String, usize> = BTreeMap::new();
        for item in &declaration.associated {
            if !item.generics.is_empty() { continue; }
            let ty = self.rigid_type(&format!("Self::{}", item.name));
            associated.insert(item.name.clone(), ty);
            substitutions.insert(format!("Self::{}", item.name), ty);
        }
        self.contracts
            .as_mut()
            .unwrap()
            .traits
            .insert((self_ty, identity), associated.clone());
        // Introduce every parameter and Self contract before checking a trait
        // argument that names a sibling parameter or Self.
        for bound in &declaration.bounds {
            let _ = self.assume_bound_with_equalities(self_ty, *bound, &substitutions, false)?;
        }
        self.assume_parameter_contract(&declaration.generics, &declaration.predicates, &substitutions)?;
        for bound in &declaration.bounds {
            self.assume_bound(self_ty, *bound, &substitutions)?;
        }
        for item in &declaration.associated {
            if !item.generics.is_empty() { continue; }
            for bound in &item.bounds {
                self.assume_bound(
                    *associated.get(&item.name).unwrap(),
                    *bound,
                    &substitutions,
                )?;
            }
        }
        self.assume_where_predicates(&declaration.predicates, &substitutions)?;
        Ok(substitutions)
    }

    pub(super) fn implementation_associated(
        &mut self,
        index: usize,
        environment: BTreeMap<String, usize>,
    ) -> Result<BTreeMap<String, usize>> {
        let implementation = self.source.impls[index].clone();
        let mut pending = implementation.associated.clone();
        if let Some(trait_type) = implementation.trait_ty {
            if let a::Type::Path(path) = &self.source.types[trait_type].kind {
                if let TraitIdentity::Declared(trait_index) =
                    crate::generics::bound_identity(self.source, path)
                {
                    for item in &self.source.traits[trait_index].associated {
                        let mut found = false;
                        for entry in &pending {
                            if entry.name == item.name {
                                found = true;
                                break;
                            }
                        }
                        if !found {
                            pending.push(item.clone());
                        }
                    }
                }
            }
        }
        let mut result = BTreeMap::new();
        for associated in pending {
            if !associated.generics.is_empty() { continue; }
            let ty = self.implementation_associated_member(index, environment.clone(), &associated.name)?;
            // Normalize first so a projection cycle keeps its own diagnostic.
            if !self.source_sized(ty) {
                return Err(err(associated.span, "E_TRAIT",
                    "associated type must establish its implicit Sized bound"));
            }
            result.insert(associated.name, ty);
        }
        Ok(result)
    }

    pub(super) fn prepare_parameter_associated(
        &mut self, parameters: &[a::GenericParam], substitutions: &mut BTreeMap<String, usize>,
    ) -> Result<()> {
        let mut pending = parameters.to_vec();
        while !pending.is_empty() {
            let before = pending.len();
            let mut retry: Vec<a::GenericParam> = Vec::new();
            let mut failure: Option<a::Diagnostic> = None;
            for parameter in pending {
                match self.prepare_one_parameter_associated(&parameter, substitutions) {
                    Ok(()) => {}
                    Err(problem) => { failure = Some(problem); retry.push(parameter); }
                }
            }
            if retry.len() == before { return Err(failure.unwrap()); }
            pending = retry;
        }
        Ok(())
    }

    fn prepare_one_parameter_associated(&mut self, parameter: &a::GenericParam,
        substitutions: &mut BTreeMap<String, usize>) -> Result<()> {
            if parameter.lifetime { return Ok(()); }
            let ty = match substitutions.get(&parameter.name) {
                Some(ty) => *ty,
                None => return Ok(()),
            };
            if self
                .contracts
                .as_ref()
                .is_some_and(|contracts| contracts.rigid.contains_key(&ty))
            { return Ok(()); }
            let mut pending: Vec<(a::TypeId, BTreeMap<String, usize>)> = parameter.bounds.iter()
                .map(|bound| (*bound, substitutions.clone())).collect();
            let mut seen = BTreeSet::<TraitIdentity>::new();
            let mut members: BTreeMap<String, Option<usize>> = BTreeMap::new();
            while let Some((bound, environment)) = pending.pop() {
                let path = match self.source.types[bound].kind.clone() {
                    a::Type::Path(path) => path,
                    _ => continue,
                };
                if crate::generics::bound_identity(self.source, &path).declaration().is_none() { continue; }
                let span = self.source.types[bound].span;
                let identity = self.trait_identity(&path, &environment, span)?;
                let Some(trait_index) = identity.declaration() else {
                    continue;
                };
                if !seen.insert(identity.clone()) { continue; }
                self.record_family_bound(&parameter.name, ty, &identity, substitutions);
                let declared_environment = self.trait_environment(ty, &identity);
                for parent in &self.source.traits[trait_index].bounds { pending.push((*parent, declared_environment.clone())); }
                if self.source.traits[trait_index].associated.is_empty() {
                    continue;
                }
                let mut witness = self.implementation_witness(ty, &identity).ok_or_else(|| {
                    err(
                        parameter.span,
                        "E_TRAIT",
                        "associated projection needs its declared implementation witness",
                    )
                })?;
                witness.substitutions.insert("Self".to_string(), ty);
                let associated =
                    self.implementation_associated(witness.implementation, witness.substitutions)?;
                self.record_family_result_bounds(&parameter.name, ty, &identity, &associated, substitutions)?;
                for (name, ty) in associated {
                    if members.contains_key(&name) { members.insert(name, None); }
                    else { members.insert(name, Some(ty)); }
                }
            }
            for (name, ty) in members {
                let key = format!("{}::{name}", parameter.name);
                if let Some(ty) = ty { substitutions.insert(key, ty); }
                else { substitutions.remove(&key); }
            }
        Ok(())
    }

    pub(super) fn prepare_associated(
        &mut self,
        index: usize,
        substitutions: &mut BTreeMap<String, usize>,
    ) -> Result<()> {
        let function = self.source.functions[index].clone();
        let owner = match self.source.function_owner(a::FunctionId { index }) {
            a::FunctionOwner::Implementation(owner) => Some(owner.index),
            _ => None,
        };
        let mut parameters = function.generics.clone();
        if let Some(owner) = owner {
            for parameter in &self.source.impls[owner].generics {
                parameters.push(parameter.clone());
            }
        }
        self.prepare_callable_arguments(&parameters, substitutions)?;
        self.prepare_parameter_associated(&parameters, substitutions)?;
        if let Some(owner) = owner {
            let mut environment = substitutions.clone();
            if !environment.contains_key(&"Self".to_string()) {
                let target = self.source.impls[owner].target;
                let ty = self.resolve(target, &environment)?;
                environment.insert("Self".to_string(), ty);
            }
            let receiver = *environment.get(&"Self".to_string()).unwrap();
            substitutions.insert(format!("$family::implementation:{owner}"), receiver);
            let associated = self.implementation_associated(owner, environment)?;
            for (name, ty) in associated {
                substitutions.insert(format!("Self::{name}"), ty);
            }
        }
        Ok(())
    }

    pub(super) fn associated_identity(
        &mut self,
        receiver: usize,
        identity: &TraitIdentity,
        name: &str,
    ) -> Result<usize> {
        let trait_index = identity.declaration().unwrap();
        let key = (receiver, identity.clone(), name.to_string());
        let pending = self.contracts.as_ref().unwrap().equality_sources.contains_key(&key);
        if pending {
            return self.resolve_associated_equality(key);
        }
        if let Some(ty) = self
            .contracts
            .as_ref()
            .unwrap()
            .traits
            .get(&(receiver, identity.clone()))
            .and_then(|items| items.get(&name.to_string()))
        {
            return Ok(*ty);
        }
        let mut declaration: Option<a::AssociatedType> = None;
        for item in &self.source.traits[trait_index].associated {
            if item.name == name {
                declaration = Some(item.clone());
                break;
            }
        }
        let declaration = declaration.unwrap();
        if !declaration.generics.is_empty() {
            return Err(err(declaration.span, "E_TRAIT", "generic associated type needs its type arguments"));
        }
        let ty = self.rigid_type(&format!("t{receiver}::trait{trait_index}::{name}"));
        {
            let traits = &mut self.contracts.as_mut().unwrap().traits;
            let key = (receiver, identity.clone());
            if !traits.contains_key(&key) {
                traits.insert(key.clone(), BTreeMap::new());
            }
            traits.get_mut(&key).unwrap().insert(name.to_string(), ty);
        }
        let mut substitutions = self.trait_environment(receiver, identity);
        substitutions.insert(format!("Self::{name}"), ty);
        for bound in declaration.bounds {
            self.assume_bound(ty, bound, &substitutions)?;
        }
        Ok(ty)
    }

    pub(super) fn associated_contract(
        &mut self,
        path: &a::Path,
        substitutions: &BTreeMap<String, usize>,
        span: a::Span,
    ) -> Result<Option<usize>> {
        if self.contracts.is_none() {
            return Ok(None);
        }
        let Some(separator) = path.name.rfind("::") else {
            return Ok(None);
        };
        let owner = &path.name.as_str()[..separator];
        let name = &path.name.as_str()[separator + 2..];
        let ty = match substitutions.get(&owner.to_string()) {
            Some(ty) => *ty,
            None => return Ok(None),
        };
        let declarations = {
            let contracts = self.contracts.as_ref().unwrap();
            let mut declarations = Vec::new();
            for (receiver, identity) in contracts.traits.keys() {
                if *receiver == ty {
                    for item in &self.source.traits[identity.declaration().unwrap()].associated {
                        if item.name == name {
                            declarations.push(identity.clone());
                            break;
                        }
                    }
                }
            }
            declarations
        };
        if declarations.len() > 1 {
            return Err(err(
                span,
                "E_TRAIT",
                "associated type name is ambiguous between declared trait bounds",
            ));
        }
        if let Some(identity) = declarations.first() {
            Ok(Some(self.associated_identity(ty, identity, name)?))
        } else {
            Ok(None)
        }
    }

    pub(super) fn depends_on_rigid(&self, ty: usize) -> bool {
        let Some(contracts) = &self.contracts else {
            return false;
        };
        let mut seen = BTreeSet::<usize>::new();
        let mut pending = vec![ty];
        while let Some(ty) = pending.pop() {
            if !seen.insert(ty) {
                continue;
            }
            if contracts.rigid.contains_key(&ty)
                || matches!(crate::generics::const_arguments::array_length(&self.types, ty),
                    Some(crate::generics::const_arguments::Value::Rigid(_))) {
                return true;
            }
            match &self.types[ty].kind {
                ir::TypeKind::Ref { inner, .. }
                | ir::TypeKind::Slice { inner, .. }
                | ir::TypeKind::Vec { inner }
                | ir::TypeKind::Box { inner }
                | ir::TypeKind::Array { inner, .. } => pending.push(*inner),
                ir::TypeKind::Struct { fields, .. } => {
                    for field in fields {
                        pending.push(field.ty);
                    }
                }
                ir::TypeKind::Enum { variants, .. } => {
                    for variant in variants {
                        for field in &variant.fields {
                            pending.push(field.ty);
                        }
                    }
                }
                _ => {}
            }
        }
        false
    }

    pub(super) fn comparison_contract(
        &mut self,
        ty: usize,
        operation: &str,
        span: a::Span,
    ) -> Result<usize> {
        let required = if operation == "==" || operation == "!=" {
            "PartialEq"
        } else {
            "PartialOrd"
        };
        if !self.satisfies_bound(ty, required) {
            return Err(err(
                span,
                "E_TRAIT",
                &format!("generic comparison requires a declared {required} contract"),
            ));
        }
        let key = (ty, operation.to_string());
        if let Some(index) = self.contracts.as_ref().unwrap().comparisons.get(&key) {
            return Ok(*index);
        }
        let reference = self.reference(ty, false);
        let index = self.functions.len();
        self.functions.push(ir::Function {
            file: span.file,
            name: format!("$contract:{operation}:{ty}"),
            params: 2,
            result: ir::BOOL,
            return_source: None,
            locals: vec![
                ir::Local {
                    name: "left".to_string(),
                    ty: reference,
                    mutable: false,
                },
                ir::Local {
                    name: "right".to_string(),
                    ty: reference,
                    mutable: false,
                },
            ],
            body: Vec::new(),
            test: false,
        });
        self.contracts
            .as_mut()
            .unwrap()
            .comparisons
            .insert(key, index);
        Ok(index)
    }

    pub(super) fn builtin_method_contract(
        &mut self,
        receiver: usize,
        method: BuiltinMethod,
        span: a::Span,
    ) -> Result<usize> {
        let rigid = self
            .contracts
            .as_ref()
            .unwrap()
            .rigid
            .contains_key(&receiver);
        if !rigid || !self.satisfies_bound(receiver, method.required()) {
            return Err(err(
                span,
                "E_TRAIT",
                &format!(
                    "generic method {} requires a declared {} contract",
                    method.name(),
                    method.required(),
                ),
            ));
        }
        let key = (receiver, method);
        if let Some(index) = self.contracts.as_ref().unwrap().builtin_methods.get(&key) {
            return Ok(*index);
        }
        let receiver_type = self.reference(receiver, method == BuiltinMethod::CloneFrom);
        let mut locals = vec![ir::Local {
            name: "self".to_string(),
            ty: receiver_type,
            mutable: false,
        }];
        if method.arguments() != 0 {
            let shared = self.reference(receiver, false);
            locals.push(ir::Local {
                name: "other".to_string(),
                ty: shared,
                mutable: false,
            });
        }
        let return_source = self.builtin_method_return_source(receiver, method);
        let index = self.functions.len();
        self.functions.push(ir::Function {
            file: span.file,
            name: format!("$contract:{}:{receiver}", method.name()),
            params: locals.len(),
            result: method.result(receiver),
            return_source,
            locals,
            body: Vec::new(),
            test: false,
        });
        self.contracts
            .as_mut()
            .unwrap()
            .builtin_methods
            .insert(key, index);
        Ok(index)
    }

    fn builtin_method_return_source(&self, receiver: usize, method: BuiltinMethod) -> Option<ir::ReturnSource> {
        if method == BuiltinMethod::Clone && self.has_view(receiver) {
            Some(ir::ReturnSource::Parameter { index: 0, projections: vec![ir::Projection::Deref] })
        } else { None }
    }

    fn validate_builtin_methods(&mut self) -> Result<BTreeSet<usize>> {
        let methods = self.contracts.as_ref().unwrap().builtin_methods.clone();
        let mut checked = BTreeSet::<usize>::new();
        for ((receiver, method), index) in &methods {
            let return_source = self.builtin_method_return_source(*receiver, *method);
            let (signature_matches, file) = {
                let function = &self.functions[*index];
                let mut signature_matches = function.params == method.arguments() + 1
                    && function.locals.len() == function.params
                    && function.result == method.result(*receiver)
                    && function.return_source == return_source;
                if signature_matches {
                    for parameter in 0..function.locals.len() {
                        let local = &function.locals[parameter];
                        if !matches!(self.types[local.ty].kind,
                        ir::TypeKind::Ref { inner, mutable }
                        if inner == *receiver
                            && mutable == (parameter == 0 && *method == BuiltinMethod::CloneFrom))
                        {
                            signature_matches = false;
                            break;
                        }
                    }
                }
                (signature_matches, function.file)
            };
            let rigid = self
                .contracts
                .as_ref()
                .unwrap()
                .rigid
                .contains_key(receiver);
            if !rigid || !self.satisfies_bound(*receiver, method.required()) || !signature_matches {
                return Err(err(
                    a::Span {
                        file,
                        ..a::Span::default()
                    },
                    "E_GENERIC",
                    "call does not match its typed builtin method witness",
                ));
            }
            checked.insert(*index);
        }
        Ok(checked)
    }

    pub(super) fn static_contract(
        &mut self,
        base: usize,
        name: &str,
        expression: a::ExprId,
        span: a::Span,
        caller: &BTreeMap<String, usize>,
    ) -> Result<Option<Instance>> {
        let selection = if self.contracts.is_none() {
            match self.method_selections.get(&expression) {
                Some(selection) => Some(selection.clone()),
                None => None,
            }
        } else {
            None
        };
        if self.contracts.is_some() {
            let mut candidates = Vec::new();
            for candidate in self.declared_methods(base, name)? {
                if self.source.functions[candidate.method]
                    .params
                    .first()
                    .is_none_or(|p| p.name != "self")
                {
                    candidates.push(candidate);
                }
            }
            if candidates.len() > 1 {
                return Err(err(
                    span,
                    "E_TRAIT",
                    &format!(
                        "associated function {name} is ambiguous between declared trait bounds"
                    ),
                ));
            }
            if let Some(witness) = candidates.pop() {
                let target = self.bound_method_target(&witness.identity, caller, span)?;
                self.method_selections.insert(
                    expression,
                    MethodSelection {
                        dereferences: 0,
                        target,
                    },
                );
                return Ok(Some(Instance {
                    source: witness.method,
                    substitutions: witness.substitutions,
                }));
            }
        } else if let Some(selection) = selection {
            let identity = match selection.target {
                MethodTarget::Trait(identity) => identity,
                MethodTarget::AppliedTrait(owner, recipe) => {
                    let arguments = self.instantiate_trait_recipe(&recipe, caller, span)?;
                    TraitIdentity::application(owner, arguments)
                }
                _ => return Ok(None),
            };
            if !self.satisfies_identity(base, &identity) {
                return Err(err(
                    span,
                    "E_TRAIT",
                    "associated function receiver lacks its checked trait bound",
                ));
            }
            if let Some(witness) = self.implementation_witness(base, &identity) {
                if let Some(source) = named_method(
                    self.source,
                    &self.source.impls[witness.implementation].methods,
                    name,
                ) {
                    let mut substitutions = witness.substitutions;
                    substitutions.insert("Self".to_string(), base);
                    return Ok(Some(Instance {
                        source,
                        substitutions,
                    }));
                }
            }
            if let Some(owner) = identity.declaration() {
                let provided = self.source.traits[owner].methods.iter().any(|method|
                    self.source.functions[*method].name == name && self.source.functions[*method].body.is_some());
                if provided {
                    let instance = self.declared_associated_method(base, &identity, name, expression, span, span, caller)?;
                    return Ok(Some(instance));
                }
            }
            return Err(err(
                span,
                "E_UNSUPPORTED",
                &format!("selected associated function {name} has no executable implementation"),
            ));
        }
        Ok(None)
    }

    pub(super) fn record_static_contract(
        &mut self,
        called: usize,
        source: usize,
        substitutions: BTreeMap<String, usize>,
    ) {
        if let a::FunctionOwner::Trait(owner) =
            self.source.function_owner(a::FunctionId { index: source })
        {
            let identity = self.environment_trait_identity(owner.index, &substitutions);
            if let Some(contracts) = &mut self.contracts {
                contracts.methods.insert(
                    called,
                    MethodWitness {
                        declaration: owner.index,
                        identity,
                        method: source,
                        substitutions,
                    },
                );
            }
        }
    }

    pub(super) fn declared_methods(&mut self, base: usize, name: &str) -> Result<Vec<MethodWitness>> {
        let declarations = {
            let Some(contracts) = &self.contracts else {
                return Ok(Vec::new());
            };
            let mut declarations = Vec::new();
            for (receiver, identity) in contracts.traits.keys() {
                if *receiver == base {
                    declarations.push(identity.clone());
                }
            }
            declarations
        };
        let mut candidates = Vec::new();
        for identity in declarations {
            let trait_index = identity.declaration().unwrap();
            let declaration = self.source.traits[trait_index].clone();
            for method in declaration.methods {
                if self.source.functions[method].name == name {
                    let mut substitutions = self.trait_environment(base, &identity);
                    for item in &declaration.associated {
                        if !item.generics.is_empty() { continue; }
                        let ty = self.associated_identity(base, &identity, &item.name)?;
                        substitutions.insert(format!("Self::{}", item.name), ty);
                    }
                    candidates.push(MethodWitness {
                        declaration: trait_index,
                        identity: identity.clone(),
                        method,
                        substitutions,
                    });
                }
            }
        }
        Ok(candidates)
    }
}

impl super::Builder<'_, '_> {
    fn builtin_method(
        &mut self,
        target: &ir::Place,
        base: usize,
        method: BuiltinMethod,
        types: &[usize],
        args: &[usize],
        span: a::Span,
    ) -> Result<(usize, usize)> {
        if !types.is_empty() {
            return Err(err(
                span,
                "E_TYPE",
                "builtin methods take no generic arguments",
            ));
        }
        if args.len() != method.arguments() {
            return Err(err(
                span,
                "E_TYPE",
                "method argument count differs from builtin contract",
            ));
        }
        let called = self.compiler.builtin_method_contract(base, method, span)?;
        let receiver = self.borrow(
            target.clone(),
            method == BuiltinMethod::CloneFrom,
            span.line,
        )?;
        let mut values = vec![receiver.0];
        for argument in args {
            let expected = self.compiler.reference(base, false);
            let value = self.expr(*argument, Some(expected))?;
            if value.1 != expected {
                return Err(err(
                    span,
                    "E_TYPE",
                    "method argument type differs from builtin contract",
                ));
            }
            values.push(value.0);
        }
        let result = method.result(base);
        let dst = self.temp(result);
        self.emit(
            ir::Op::Call {
                dst,
                function: called,
                args: values,
            },
            span.line,
        );
        Ok((dst, result))
    }

    /// Replay a trait selected by the generic body using the actual receiver's
    /// implementation evidence. Inherent methods cannot displace this choice.
    pub(super) fn witnessed_method(
        &mut self,
        target: &ir::Place,
        base: usize,
        identity: &TraitIdentity,
        expression: a::ExprId,
        types: &[usize],
        args: &[usize],
    ) -> Result<(usize, usize)> {
        let span = self.compiler.source.exprs[expression].span;
        let name: String = match &self.compiler.source.exprs[expression].kind {
            a::Expr::Method { name, .. } => name.clone(),
            _ => {
                return Err(err(
                    span,
                    "E_GENERIC",
                    "method witness is not bound to a method expression",
                ));
            }
        };
        if !self.compiler.satisfies_identity(base, identity) {
            return Err(err(
                span,
                "E_TRAIT",
                "specialized receiver lacks its checked trait contract",
            ));
        }
        if identity.declaration().is_some() {
            // Use the same implementation/default-body and associated-type
            // environment as a qualified call, retaining the recorded autoderef.
            let selection = self.compiler.method_selections.get(&expression).cloned();
            let instance = self.compiler.declared_associated_method(base, identity, &name,
                expression, span, span, &self.sub);
            if let Some(selection) = selection {
                self.compiler.method_selections.insert(expression, selection);
            } else {
                self.compiler.method_selections.remove(&expression);
            }
            return self.source_method(target, base, instance?, types, args, span);
        }
        let implementation = self.compiler.implementation_witness(base, identity);
        if let Some(witness) = implementation {
            let method = {
                let implementation = &self.compiler.source.impls[witness.implementation];
                named_method(self.compiler.source, &implementation.methods, &name)
            };
            if let Some(index) = method {
                return self.source_method(
                    target,
                    base,
                    Instance {
                        source: index,
                        substitutions: witness.substitutions,
                    },
                    types,
                    args,
                    span,
                );
            }
        }
        if let Some(method) = BuiltinMethod::named(&name) {
            if identity == &TraitIdentity::Builtin(method.required().to_string()) {
                return self.builtin_trait_method(target, base, &name, types, args, span);
            }
        }
        Err(err(
            span,
            "E_UNSUPPORTED",
            &format!("selected trait method {name} has no executable implementation"),
        ))
    }

    /// A source method selected while validating a known receiver remains the
    /// same declaration after substitution, even if another method then applies.
    pub(super) fn fixed_source_method(
        &mut self,
        target: &ir::Place,
        base: usize,
        expression: a::ExprId,
        index: usize,
        types: &[usize],
        args: &[usize],
        span: a::Span,
    ) -> Result<(usize, usize)> {
        let owner = match self.compiler.source.function_owner(a::FunctionId { index }) {
            a::FunctionOwner::Implementation(owner) => Some(owner.index),
            _ => None,
        }
        .ok_or_else(|| {
            err(
                span,
                "E_GENERIC",
                "checked source method has no implementation",
            )
        })?;
        let implementation = self.compiler.source.impls[owner].clone();
        let mut substitutions = BTreeMap::new();
        self.infer_type(implementation.target, base, &mut substitutions)?;
        substitutions.insert("Self".to_string(), base);
        if self
            .compiler
            .resolve(implementation.target, &substitutions)?
            != base
        {
            return Err(err(
                span,
                "E_GENERIC",
                "specialized receiver differs from checked method target",
            ));
        }
        let inputs = substitutions.clone();
        if !self.complete_method_application(expression, owner, index, &mut substitutions) {
            return Err(err(span, "E_TYPE", "method implementation arguments disagree with its receiver"));
        }
        self.compiler.implementation_bounds(&implementation, &substitutions)?;
        self.source_method_with_application(
            target,
            base,
            Instance {
                source: index,
                substitutions: inputs,
            },
            types,
            args,
            span,
            substitutions,
        )
    }

    pub(super) fn complete_method_application(&self, expression: a::ExprId,
        implementation: usize, method: usize, substitutions: &mut BTreeMap<String, usize>) -> bool {
        let Some(application) = self.inferred.method_applications.get(&expression) else { return true; };
        if application.implementation != implementation || application.method != method { return true; }
        let mut completed = substitutions.clone();
        for (name, value) in &application.arguments {
            if let Some(previous) = completed.insert(name.clone(), *value) {
                if previous != *value { return false; }
            }
        }
        *substitutions = completed;
        true
    }

    pub(super) fn source_method(
        &mut self,
        target: &ir::Place,
        base: usize,
        instance: Instance,
        types: &[usize],
        args: &[usize],
        span: a::Span,
    ) -> Result<(usize, usize)> {
        self.source_method_with_application(target, base, instance, types, args, span, BTreeMap::new())
    }

    pub(super) fn source_method_with_application(
        &mut self,
        target: &ir::Place,
        base: usize,
        instance: Instance,
        types: &[usize],
        args: &[usize],
        span: a::Span,
        application: BTreeMap<String, usize>,
    ) -> Result<(usize, usize)> {
        let index = instance.source;
        let mut substitutions = instance.substitutions;
        self.compiler.method_access(index, self.scope, span)?;
        let definition = self.compiler.source.functions[index].clone();
        substitutions.insert("Self".to_string(), base);
        let parameters = type_parameter_indices(&definition.generics);
        if !types.is_empty() {
            if types.len() != parameters.len() {
                return Err(err(span, "E_TYPE", "wrong generic method argument count"));
            }
            for index in 0..parameters.len() {
                let ty = self.compiler.generic_argument(types[index], definition.generics[parameters[index]].constant, &self.sub)?;
                substitutions.insert(definition.generics[parameters[index]].name.clone(), ty);
            }
        }
        if definition.params.is_empty() {
            return Err(err(span, "E_TYPE", "method has no receiver"));
        }
        if definition.params.len() != args.len() + 1 {
            return Err(err(span, "E_TYPE", "method argument count differs"));
        }
        let first = self
            .compiler
            .resolve(definition.params[0].ty, &substitutions)?;
        let receiver = if first == base {
            // A by-value Self may itself be a reference. Reborrowing it would
            // change the declared receiver from Self to &Self (or &mut Self).
            self.read(target.clone(), span.line)?
        } else if let ir::TypeKind::Ref { inner, mutable } = self.compiler.types[first].kind {
            if inner != base {
                return Err(err(
                    span,
                    "E_TYPE",
                    "method receiver differs from its implementation target",
                ));
            }
            self.borrow(target.clone(), mutable, span.line)?
        } else {
            return Err(err(
                span,
                "E_TYPE",
                "method receiver differs from its implementation target",
            ));
        };
        let mut values = vec![receiver.0];
        for index in 0..args.len() {
            let ty = definition.params[index + 1].ty;
            let expected = self.compiler.resolve(ty, &substitutions).ok();
            let value = self.expr(args[index], expected)?;
            self.infer_type(ty, value.1, &mut substitutions)?;
            values.push(value.0);
        }
        // The solved application proves candidate eligibility, but does not
        // turn an inferred reference argument into an authored coercion site.
        // Evaluate with the receiver/preceding arguments first, then complete
        // the exact application before ordinary instantiation checks it again.
        for (name, value) in application {
            if let Some(previous) = substitutions.insert(name, value) {
                if previous != value { return Err(err(span, "E_TYPE", "method arguments differ from the inferred implementation application")); }
            }
        }
        let called = self
            .compiler
            .instantiate(index, substitutions)
            .map_err(|problem| super::at_use_site(problem, span))?;
        let result = self.compiler.functions[called].result;
        let dst = self.temp(result);
        self.emit(
            ir::Op::Call {
                dst,
                function: called,
                args: values,
            },
            span.line,
        );
        Ok((dst, result))
    }

    pub(super) fn generic_method(
        &mut self,
        expression: a::ExprId,
        target: &ir::Place,
        base: usize,
        name: &str,
        types: &[usize],
        args: &[usize],
    ) -> Result<Option<(usize, usize)>> {
        let span = self.compiler.source.exprs[expression].span;
        let candidates = self.compiler.declared_methods(base, name)?;
        let builtin = BuiltinMethod::named(name).filter(|_| {
            self.compiler
                .contracts
                .as_ref()
                .is_some_and(|contracts| contracts.rigid.contains_key(&base))
        });
        let proven =
            builtin.filter(|method| self.compiler.satisfies_bound(base, method.required()));
        if candidates.len() + if proven.is_some() { 1 } else { 0 } > 1 {
            return Err(err(
                span,
                "E_TRAIT",
                "method is ambiguous between builtin and declared trait contracts",
            ));
        }
        if let Some(method) = proven {
            // A blanket source implementation can supply another method even
            // without an explicit bound. Do not silently choose the builtin.
            if self.has_declared_method(base, name, span)? {
                return Err(err(
                    span,
                    "E_TRAIT",
                    "method is ambiguous between trait contracts",
                ));
            }
            self.compiler
                .method_selections
                .get_mut(&expression)
                .unwrap()
                .target =
                MethodTarget::Trait(TraitIdentity::Builtin(method.required().to_string()));
            return Ok(Some(
                self.builtin_method(target, base, method, types, args, span)?,
            ));
        }
        if candidates.is_empty() {
            if let Some(method) = builtin {
                // Preserve ordinary source implementation lookup, including
                // blanket implementations of a distinct same-spelled method.
                if !self.has_declared_method(base, name, span)? {
                    return Err(err(
                        span,
                        "E_TRAIT",
                        &format!(
                            "generic method {} requires a declared {} contract",
                            method.name(),
                            method.required(),
                        ),
                    ));
                }
            }
            return Ok(None);
        }
        let witness = candidates[0].clone();
        let trait_index = witness.declaration;
        let identity = witness.identity.clone();
        let selected_target = self.compiler.bound_method_target(&identity, &self.sub, span)?;
        self.compiler
            .method_selections
            .get_mut(&expression)
            .unwrap()
            .target = selected_target;
        let index = witness.method;
        let mut substitutions = witness.substitutions;
        let function = self.compiler.source.functions[index].clone();
        let parameters = type_parameter_indices(&function.generics);
        if !types.is_empty() {
            if types.len() != parameters.len() {
                return Err(err(span, "E_TYPE", "wrong generic method argument count"));
            }
            for index in 0..parameters.len() {
                let ty = self.compiler.generic_argument(types[index], function.generics[parameters[index]].constant, &self.sub)?;
                substitutions.insert(function.generics[parameters[index]].name.clone(), ty);
            }
        }
        if function.params.len() != args.len() + 1 {
            return Err(err(
                span,
                "E_TYPE",
                "method argument count differs from declared contract",
            ));
        }
        let first = self
            .compiler
            .resolve(function.params[0].ty, &substitutions)?;
        let receiver = match self.compiler.types[first].kind {
            ir::TypeKind::Ref { mutable, .. } => self.borrow(target.clone(), mutable, span.line)?,
            _ => self.read(target.clone(), span.line)?,
        };
        let mut values = vec![receiver.0];
        for index in 0..args.len() {
            let ty = function.params[index + 1].ty;
            let expected = self.compiler.resolve(ty, &substitutions).ok();
            let value = self.expr(args[index], expected)?;
            self.infer_type(ty, value.1, &mut substitutions)?;
            values.push(value.0);
        }
        let called = self.compiler.instantiate(index, substitutions.clone())?;
        self.compiler.contracts.as_mut().unwrap().methods.insert(
            called,
            MethodWitness {
                declaration: trait_index,
                identity,
                method: index,
                substitutions,
            },
        );
        let result = self.compiler.functions[called].result;
        let dst = self.temp(result);
        self.emit(
            ir::Op::Call {
                dst,
                function: called,
                args: values,
            },
            span.line,
        );
        Ok(Some((dst, result)))
    }
}

fn named_method(source: &a::Program, methods: &[usize], name: &str) -> Option<usize> {
    for method in methods {
        if source.functions[*method].name == name {
            return Some(*method);
        }
    }
    None
}

fn type_parameter_indices(parameters: &[a::GenericParam]) -> Vec<usize> {
    let mut indices = Vec::new();
    for index in 0..parameters.len() {
        if !parameters[index].lifetime && !parameters[index].implicit {
            indices.push(index);
        }
    }
    indices
}

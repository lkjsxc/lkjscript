//! Conditional associated-type equations, indexed by the declaring trait.
//!
//! A unique structural implementation can determine a type without proving that
//! the implementation is eligible. These equations never become trait evidence:
//! ordinary definition checking and concrete selection still prove every bound.
use super::*;
use std::collections::BTreeSet;

pub(super) enum Match {
    No,
    Deferred,
    Yes(BTreeMap<String, Variable>),
}

impl Infer<'_, '_> {
    // Equal receiver structure shares its projection result. This comparison
    // creates no equations: different unknowns and opaque projections remain
    // different, and equality of outputs never constrains their receivers.
    pub(super) fn same_projection_receiver(&self, left: Variable, right: Variable) -> bool {
        let mut pending = vec![(left, right)];
        let mut seen = BTreeSet::<(Variable, Variable)>::new();
        while let Some((left, right)) = pending.pop() {
            let left = self.definition.root(left);
            let right = self.definition.root(right);
            if left == right || !seen.insert((left, right)) { continue; }
            match (self.shape(left), self.shape(right)) {
                (Some(Shape::Atom(left)), Some(Shape::Atom(right))) if left == right => {}
                (Some(Shape::Projection(ld, lm, lr, la)), Some(Shape::Projection(rd, rm, rr, ra))) => {
                    if ld != rd || lm != rm || la.len() != ra.len() { return false; }
                    pending.push((lr, rr));
                    for index in 0..la.len() { pending.push((la[index], ra[index])); }
                }
                (Some(Shape::Never), Some(Shape::Never)) => {}
                (Some(Shape::Vec(left)), Some(Shape::Vec(right)))
                | (Some(Shape::Box(left)), Some(Shape::Box(right)))
                | (Some(Shape::Slice(left)), Some(Shape::Slice(right))) => pending.push((left, right)),
                (Some(Shape::Ref(lm, left)), Some(Shape::Ref(rm, right))) if lm == rm => pending.push((left, right)),
                (Some(Shape::Array(left, ln)), Some(Shape::Array(right, rn))) => {
                    pending.push((left, right)); pending.push((ln, rn));
                }
                (Some(Shape::Constant(left)), Some(Shape::Constant(right))) if left == right => {}
                (Some(Shape::ConstantRigid(left)), Some(Shape::ConstantRigid(right))) if left == right => {}
                (Some(Shape::Tuple(left)), Some(Shape::Tuple(right))) if left.len() == right.len() => {
                    for index in 0..left.len() { pending.push((left[index], right[index])); }
                }
                (Some(Shape::Nominal(ld, left)), Some(Shape::Nominal(rd, right)))
                | (Some(Shape::Closure(ld, left)), Some(Shape::Closure(rd, right)))
                    if ld == rd && left.len() == right.len() => {
                    for index in 0..left.len() { pending.push((left[index], right[index])); }
                }
                _ => return false,
            }
        }
        true
    }

    pub(super) fn projection_receiver(&mut self, receiver: Variable) -> Variable {
        let receiver = self.root(receiver);
        for previous in &self.projection_receivers {
            if self.same_projection_receiver(*previous, receiver) {
                return self.definition.root(*previous);
            }
        }
        self.projection_receivers.push(receiver);
        receiver
    }

    pub(super) fn same_trait_arguments(&self, left: &[Variable], right: &[Variable]) -> bool {
        if left.len() != right.len() { return false; }
        for index in 0..left.len() {
            if !self.same_projection_receiver(left[index], right[index]) { return false; }
        }
        true
    }

    pub(super) fn projection_key(&self, root: Variable, declaration: a::DeclarationId,
        arguments: &[Variable], member: &str) -> (a::DeclarationId, Vec<Variable>, String) {
        for key in self.projections[root].keys() {
            if key.0 == declaration && key.2 == member && self.same_trait_arguments(&key.1, arguments) {
                return key.clone();
            }
        }
        (declaration, arguments.to_vec(), member.to_string())
    }

    pub(super) fn trait_application(&mut self, receiver: Variable, path: &a::Path,
        environment: &BTreeMap<String, Variable>)
        -> Result<Option<(a::DeclarationId, Vec<Variable>, BTreeMap<String, Variable>)>> {
        let Some(declaration) = path.declaration else { return Ok(None); };
        let a::Item::Trait(owner) = self.source.declarations[declaration].item else { return Ok(None); };
        let parameters = self.source.traits[owner].generics.clone();
        if parameters.len() != path.args.len() || parameters.iter().any(|p: &a::GenericParam| p.lifetime || p.constant) {
            return Ok(None);
        }
        let mut arguments = Vec::new();
        let mut substitutions = BTreeMap::new();
        substitutions.insert("Self".to_string(), receiver);
        substitutions.insert(format!("$family::trait:{owner}"), receiver);
        for index in 0..parameters.len() {
            let value = self.source_type(path.args[index], environment)?;
            arguments.push(value);
            substitutions.insert(parameters[index].name.clone(), value);
        }
        Ok(Some((declaration, arguments, substitutions)))
    }

    fn binding_application(&mut self, receiver: Variable, first: &a::Path, member: &str,
        environment: &BTreeMap<String, Variable>, span: a::Span)
        -> Result<(a::DeclarationId, Vec<Variable>, BTreeMap<String, Variable>)> {
        let mut pending = vec![(first.clone(), environment.clone())];
        let mut seen: Vec<(a::DeclarationId, Vec<Variable>)> = Vec::new();
        let mut selected: Option<(a::DeclarationId, Vec<Variable>, BTreeMap<String, Variable>)> = None;
        while let Some((path, environment)) = pending.pop() {
            let Some((declaration, arguments, substitutions)) = self.trait_application(receiver, &path, &environment)? else { continue; };
            if seen.iter().any(|(owner, previous)| *owner == declaration && self.same_trait_arguments(previous, &arguments)) { continue; }
            seen.push((declaration, arguments.clone()));
            let a::Item::Trait(owner) = self.source.declarations[declaration].item else { continue; };
            let definition = self.source.traits[owner].clone();
            if definition.associated.iter().any(|item: &a::AssociatedType| item.name == member) {
                if selected.is_some() { return Err(err(span, "E_TRAIT", "associated-type equality binding is ambiguous")); }
                selected = Some((declaration, arguments, substitutions.clone()));
            }
            for bound in &definition.bounds {
                if let a::Type::Path(parent) = &self.source.types[*bound].kind {
                    pending.push((parent.clone(), substitutions.clone()));
                }
            }
        }
        selected.ok_or_else(|| err(span, "E_TRAIT", "associated-type equality binding has no declared member"))
    }

    fn projection_argument_contains(&self, outer: Variable, inner: Variable) -> bool {
        let mut pending = vec![outer];
        let mut seen = BTreeSet::<Variable>::new();
        while let Some(variable) = pending.pop() {
            let root = self.definition.root(variable);
            if self.same_projection_receiver(root, inner) { return true; }
            if !seen.insert(root) { continue; }
            if let Some(shape) = self.shape(root) { pending.extend_from_slice(&shape.children()); }
        }
        false
    }

    pub(super) fn parameter_equations(
        &mut self,
        parameters: &[a::GenericParam],
        environment: &mut BTreeMap<String, Variable>,
        rigid: bool,
    ) -> Result<()> {
        // Establish projected names before callable signatures use them. A
        // declaration's bounds, not the spelling `Item`, choose its identity.
        for parameter in parameters {
            let receiver = match environment.get(&parameter.name) {
                Some(receiver) => Some(*receiver),
                None => None,
            };
            if let Some(receiver) = receiver {
                for bound in &parameter.bounds {
                    self.trait_equations(receiver, &parameter.name, *bound, environment, rigid)?;
                }
            }
        }
        for parameter in parameters {
            let receiver = match environment.get(&parameter.name) {
                Some(receiver) => Some(*receiver),
                None => None,
            };
            if let Some(receiver) = receiver {
                for bound in &parameter.bounds {
                    self.binding_equations(receiver, *bound, environment, rigid)?;
                }
            }
        }
        for parameter in parameters {
            let receiver = match environment.get(&parameter.name) {
                Some(receiver) => Some(*receiver),
                None => None,
            };
            if let Some(receiver) = receiver {
                for bound in &parameter.bounds {
                    self.callable_bound(receiver, *bound, environment)?;
                }
            }
        }
        Ok(())
    }

    pub(super) fn binding_equations(
        &mut self,
        receiver: Variable,
        first: a::TypeId,
        environment: &BTreeMap<String, Variable>,
        rigid: bool,
    ) -> Result<()> {
        let mut pending = vec![(first, environment.clone())];
        let mut seen: Vec<(a::DeclarationId, Vec<Variable>)> = Vec::new();
        while let Some((bound, substitutions)) = pending.pop() {
            let a::Type::Path(path) = self.source.types[bound].kind.clone() else { continue; };
            let Some((declaration, arguments, declared)) = self.trait_application(receiver, &path, &substitutions)? else { continue; };
            if seen.iter().any(|(owner, previous)| *owner == declaration && self.same_trait_arguments(previous, &arguments)) { continue; }
            seen.push((declaration, arguments));
            let a::Item::Trait(index) = self.source.declarations[declaration].item else { continue; };
            for binding in &path.bindings {
                let (declaration, arguments, _) = self.binding_application(receiver, &path, &binding.name, &substitutions, binding.span)?;
                let root = self.projection_receiver(receiver);
                let key = self.projection_key(root, declaration, &arguments, &binding.name);
                let value = self.source_type(binding.value, &substitutions)?;
                let previous = self.projections[root].get(&key).copied();
                if let Some(previous) = previous {
                    self.projection_bindings.insert(previous, binding.span);
                    let previous = self.root(previous);
                    let value = self.root(value);
                    if previous != value && rigid && matches!(self.shape(previous), Some(Shape::Projected(_, _) | Shape::Projection(_, _, _, _))) {
                        if self.occurs(previous, value) {
                            return Err(err(binding.span, "E_TYPE", "cyclic associated-type equality binding"));
                        }
                        let shape = self.shape(value);
                        let equations = self.join_roots(previous, value, shape);
                        for (left, right) in equations { self.unify(left, right, binding.span)?; }
                    } else {
                        if self.unify(previous, value, binding.span).is_err() {
                            return Err(err(binding.span, "E_TRAIT", "conflicting associated-type equality bindings"));
                        }
                    }
                } else {
                    self.projections[root].insert(key, value);
                }
            }
            for parent in &self.source.traits[index].bounds { pending.push((*parent, declared.clone())); }
        }
        Ok(())
    }

    pub(super) fn trait_equations(
        &mut self,
        receiver: Variable,
        alias: &str,
        bound: a::TypeId,
        environment: &mut BTreeMap<String, Variable>,
        rigid: bool,
    ) -> Result<()> {
        let mut pending = vec![(bound, environment.clone())];
        let mut seen: Vec<(a::DeclarationId, Vec<Variable>)> = Vec::new();
        while let Some((bound, outer)) = pending.pop() {
            let a::Type::Path(path) = self.source.types[bound].kind.clone() else { continue; };
            let Some((declaration, arguments, mut declared)) = self.trait_application(receiver, &path, &outer)? else { continue; };
            if seen.iter().any(|(owner, previous)| *owner == declaration && self.same_trait_arguments(previous, &arguments)) { continue; }
            seen.push((declaration, arguments.clone()));
            let a::Item::Trait(index) = self.source.declarations[declaration].item else { continue; };
            let definition = self.source.traits[index].clone();
            for associated in &definition.associated {
                if !associated.generics.is_empty() { continue; }
                let name = format!("{alias}::{}", associated.name);
                let root = self.projection_receiver(receiver);
                let key = self.projection_key(root, declaration, &arguments, &associated.name);
                let previous = self.projections[root].get(&key).copied();
                let value = if let Some(previous) = previous { previous } else {
                    let result = if rigid {
                        self.shaped(Shape::Projection(declaration, associated.name.clone(), receiver, arguments.clone()))
                    } else { self.operation_type() };
                    self.projections[root].insert(key, result);
                    if !rigid {
                        self.obligation(Obligation::Projection { receiver, declaration,
                            arguments: arguments.clone(), member: associated.name.clone(), result, span: associated.span });
                    }
                    result
                };
                declared.insert(format!("Self::{}", associated.name), value);
                // Only one exact applied owner establishes a shorthand member.
                let previous = environment.get(&name).copied();
                if let Some(previous) = previous {
                    if self.definition.root(previous) != self.definition.root(value) {
                        environment.insert(name, self.blocked());
                    }
                } else { environment.insert(name, value); }
            }
            self.trait_headers.push((receiver, bound, arguments, declared.clone()));
            for parent in &definition.bounds { pending.push((*parent, declared.clone())); }
        }
        Ok(())
    }

    pub(super) fn shape_head(&self, receiver: Variable) -> Option<String> {
        match self.shape(receiver) {
            Some(Shape::Nominal(declaration, _)) => {
                Some(self.source.declarations[declaration].name.clone())
            }
            Some(Shape::Vec(_)) => Some("Vec".to_string()),
            Some(Shape::Box(_)) => Some("Box".to_string()),
            Some(Shape::Atom(name)) => Some(name),
            _ => None,
        }
    }

    pub(super) fn watch_shape(&mut self, variable: Variable, obligation: usize) {
        let mut pending = vec![variable];
        let mut seen = BTreeSet::<Variable>::new();
        while let Some(variable) = pending.pop() {
            let root = self.root(variable);
            if !seen.insert(root) {
                continue;
            }
            self.watch(root, obligation);
            if let Some(shape) = self.shape(root) {
                for child in shape.children() {
                    pending.push(child);
                }
            }
        }
    }

    /// Only implementation variables are flexible. Unknown caller positions
    /// cannot be fixed to a concrete pattern merely to select its header.
    pub(super) fn implementation_environment(
        &mut self,
        index: usize,
        receiver: Variable,
    ) -> Result<Match> {
        self.implementation_application_environment(index, receiver, None)
    }

    fn implementation_application_environment(&mut self, index: usize, receiver: Variable,
        arguments: Option<&[Variable]>) -> Result<Match> {
        let implementation = self.source.impls[index].clone();
        let mut environment = BTreeMap::new();
        for parameter in &implementation.generics {
            if !parameter.lifetime {
                environment.insert(parameter.name.clone(), self.unknown());
            }
        }
        let mut flexible = BTreeSet::<Variable>::new();
        for value in environment.values() {
            flexible.insert(*value);
        }
        let target = self.source_type(implementation.target, &environment)?;
        let mut substitutions: BTreeMap<Variable, Variable> = BTreeMap::new();
        let mut pending = vec![(target, receiver)];
        if let Some(arguments) = arguments {
            let Some(bound) = implementation.trait_ty else { return Ok(Match::No); };
            let a::Type::Path(path) = self.source.types[bound].kind.clone() else { return Ok(Match::No); };
            if path.args.len() != arguments.len() { return Ok(Match::No); }
            for position in 0..arguments.len() {
                pending.push((self.source_type(path.args[position], &environment)?, arguments[position]));
            }
        }
        let mut deferred = false;
        while let Some((pattern, actual)) = pending.pop() {
            let pattern = self.definition.root(pattern);
            let actual = self.definition.root(actual);
            if flexible.contains(&pattern) {
                let previous = match substitutions.get(&pattern) {
                    Some(previous) => Some(*previous),
                    None => None,
                };
                if let Some(previous) = previous {
                    pending.push((previous, actual));
                } else {
                    substitutions.insert(pattern, actual);
                }
                continue;
            }
            if pattern == actual {
                continue;
            }
            match (self.shape(pattern), self.shape(actual)) {
                (None, _) | (_, None) => deferred = true,
                (Some(Shape::Vec(a)), Some(Shape::Vec(b)))
                | (Some(Shape::Box(a)), Some(Shape::Box(b)))
                | (Some(Shape::Slice(a)), Some(Shape::Slice(b))) => pending.push((a, b)),
                (Some(Shape::Ref(am, a)), Some(Shape::Ref(bm, b))) if am == bm => {
                    pending.push((a, b))
                }
                (Some(Shape::Array(a, an)), Some(Shape::Array(b, bn))) => {
                    pending.push((a, b)); pending.push((an, bn));
                }
                (Some(Shape::Tuple(a)), Some(Shape::Tuple(b))) if a.len() == b.len() => {
                    for index in 0..a.len() {
                        pending.push((a[index], b[index]));
                    }
                }
                (Some(Shape::Nominal(ad, a)), Some(Shape::Nominal(bd, b)))
                    if ad == bd && a.len() == b.len() =>
                {
                    for index in 0..a.len() {
                        pending.push((a[index], b[index]));
                    }
                }
                (Some(a), Some(b)) => {
                    if a != b {
                        return Ok(Match::No);
                    }
                }
            }
        }
        if deferred {
            return Ok(Match::Deferred);
        }
        let mut resolved = BTreeMap::new();
        for (name, value) in environment {
            let actual = match substitutions.get(&value) {
                Some(actual) => *actual,
                None => value,
            };
            resolved.insert(name, actual);
        }
        resolved.insert("Self".to_string(), receiver);
        resolved.insert(format!("$family::implementation:{index}"), receiver);
        Ok(Match::Yes(resolved))
    }

    pub(super) fn solve_projection(
        &mut self,
        id: usize,
        receiver: Variable,
        declaration: a::DeclarationId,
        trait_arguments: &[Variable],
        member: &str,
        result: Variable,
        span: a::Span,
    ) -> Result<bool> {
        let Some(shape) = self.shape(receiver) else {
            self.watch(receiver, id);
            return Ok(false);
        };
        if matches!(shape, Shape::Rigid(_) | Shape::Opaque(..)) {
            // Joining the receiver with a declared parameter has already joined
            // the corresponding projection slot; no concrete impl is guessed.
            return Ok(matches!(self.shape(result), Some(Shape::Projected(_, _) | Shape::Projection(_, _, _, _))));
        }
        let a::Item::Trait(trait_index) = self.source.declarations[declaration].item else {
            return Ok(false);
        };
        let count = self.source.traits[trait_index].generics.len();
        if trait_arguments.len() < count { return Ok(false); }
        let family_arguments = &trait_arguments[count..];
        let trait_arguments = &trait_arguments[..count];
        let head = self.shape_head(receiver);
        let head_view = match &head {
            Some(head) => Some(head.as_str()),
            None => None,
        };
        let candidates = self
            .implementations
            .trait_candidates_by_head(trait_index, head_view);
        let mut selected = None;
        for candidate in candidates {
            match self.implementation_application_environment(candidate, receiver, Some(trait_arguments))? {
                Match::No => {}
                Match::Deferred => {
                    self.watch_shape(receiver, id);
                    for argument in trait_arguments { self.watch_shape(*argument, id); }
                    return Ok(false);
                }
                Match::Yes(environment) => {
                    if selected.is_some() {
                        return Ok(false);
                    }
                    selected = Some((candidate, environment));
                }
            }
        }
        let Some((candidate, mut environment)) = selected else {
            return Ok(false);
        };
        let implementation = self.source.impls[candidate].clone();
        let mut arguments: Vec<Variable> = Vec::new();
        for parameter in &implementation.generics {
            if !parameter.lifetime {
                if let Some(argument) = environment.get(&parameter.name) { arguments.push(*argument); }
            }
        }
        arguments.extend_from_slice(family_arguments);
        let mut ancestry: Vec<(usize, String, Vec<Variable>)> = match self.projection_ancestry.get(&id) {
            Some(previous) => previous.clone(),
            None => Vec::new(),
        };
        for (previous, name, previous_arguments) in &ancestry {
            if *previous != candidate || name != member || previous_arguments.len() != arguments.len() { continue; }
            let mut contains = true;
            let mut larger = false;
            for position in 0..arguments.len() {
                contains = contains && self.projection_argument_contains(arguments[position], previous_arguments[position]);
                larger = larger || !self.same_projection_receiver(arguments[position], previous_arguments[position]);
            }
            if contains && larger {
                return Err(err(span, "E_RECURSION", "associated type arguments expand inside a recursive query"));
            }
        }
        ancestry.push((candidate, member.to_string(), arguments));
        let first_child = self.obligations.len();
        self.parameter_equations(&implementation.generics, &mut environment, false)?;
        self.predicate_equations(&implementation.predicates, &mut environment, false)?;
        if let Some(bound) = implementation.trait_ty {
            self.trait_equations(receiver, "Self", bound, &mut environment, false)?;
        }
        let mut associated = None;
        for item in &implementation.associated {
            if item.name == member {
                if item.generics.len() != family_arguments.len() { return Ok(false); }
                for position in 0..family_arguments.len() {
                    environment.insert(item.generics[position].name.clone(), family_arguments[position]);
                }
                associated = item.value;
                break;
            }
        }
        if associated.is_none() {
            let bound = implementation.trait_ty.unwrap();
            if let a::Type::Path(path) = self.source.types[bound].kind.clone() {
                if let Some((_, _, declared)) = self.trait_application(receiver, &path, &environment)? { environment = declared; }
            }
            for item in &self.source.traits[trait_index].associated {
                if item.name == member {
                    associated = item.value;
                    break;
                }
            }
        }
        let Some(associated) = associated else {
            return Ok(false);
        };
        let value = self.source_type(associated, &environment)?;
        for child in first_child..self.obligations.len() {
            if matches!(self.obligations[child], Some(Obligation::Projection { .. })) {
                self.projection_ancestry.insert(child, ancestry.clone());
            }
        }
        if let Err(problem) = self.unify(result, value, span) {
            if let Some(binding) = self.projection_bindings.get(&result) {
                return Err(err(*binding, "E_TRAIT",
                    "associated-type equality binding does not match the selected implementation"));
            }
            return Err(problem);
        }
        Ok(true)
    }
}

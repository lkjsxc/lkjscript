//! Source-type inference uses heap work frames, including transparent aliases.
//! Repeated syntax still creates fresh inference variables in its environment.
use super::{Infer, Result, Shape, Variable, a, integer_name, parameters};
use std::collections::BTreeMap;

enum Work {
    Source {
        id: a::TypeId,
        environment: usize,
    },
    Path {
        id: a::TypeId,
        path: a::Path,
        environment: usize,
        arguments: usize,
    },
    Default { id: a::TypeId, path: a::Path, environment: usize, arguments: Vec<Variable> },
    Qualified { id: a::TypeId, qualification: a::QualifiedPath, name: String, args: Vec<a::TypeId>, environment: usize },
    Reference(bool),
    Slice,
    Array(String, usize),
    Tuple(usize),
}

impl Infer<'_, '_> {
    pub(super) fn source_type(
        &mut self,
        id: a::TypeId,
        base_environment: &BTreeMap<String, Variable>,
    ) -> Result<Variable> {
        let mut pending = vec![Work::Source { id, environment: 0 }];
        // Zero names the borrowed input; only alias substitutions need owned maps.
        let mut environments: Vec<BTreeMap<String, Variable>> = Vec::new();
        let mut values: Vec<Variable> = Vec::new();
        while let Some(work) = pending.pop() {
            match work {
                Work::Source { id, environment } => match self.source.types[id].kind.clone() {
                    a::Type::Infer => values.push(self.unknown()),
                    a::Type::Never => values.push(self.shaped(Shape::Never)),
                    a::Type::Ref { mutable, inner, .. } => {
                        pending.push(Work::Reference(mutable));
                        pending.push(Work::Source {
                            id: inner,
                            environment,
                        });
                    }
                    a::Type::Slice(inner) => {
                        pending.push(Work::Slice);
                        pending.push(Work::Source {
                            id: inner,
                            environment,
                        });
                    }
                    a::Type::Array { inner, len } => {
                        pending.push(Work::Array(len, environment));
                        pending.push(Work::Source {
                            id: inner,
                            environment,
                        });
                    }
                    a::Type::Tuple(fields) => {
                        pending.push(Work::Tuple(fields.len()));
                        let mut fields = fields;
                        while let Some(id) = fields.pop() {
                            pending.push(Work::Source { id, environment });
                        }
                    }
                    a::Type::Path(path) => {
                        let argument = self.source.constant_arguments.get(&id).cloned();
                        if let Some(text) = argument {
                            let value = crate::generics::const_arguments::literal(&text).ok_or_else(||
                                a::Diagnostic::new(self.source.types[id].span, "E_TYPE", "const argument exceeds usize"))?;
                            values.push(self.shaped(Shape::Constant(value)));
                            continue;
                        }
                        if let Some(qualification) = &path.qualification {
                            pending.push(Work::Qualified { id, qualification: qualification.clone(), name: path.name, args: path.args, environment });
                            pending.push(Work::Source { id: qualification.receiver, environment });
                            continue;
                        }
                        let opaque = self.source.impl_traits.get(&id).is_some_and(|form| form.result.is_some());
                        if opaque {
                            let bindings = if environment == 0 { base_environment }
                                else { &environments[environment - 1] };
                            let mut names = Vec::new(); let mut captures = Vec::new();
                            for name in super::super::opaque::capture_names(self.source, id) {
                                if let Some(value) = bindings.get(&name) { names.push(name); captures.push(*value); }
                            }
                            let receiver = self.shaped(Shape::Opaque(id, names, captures));
                            self.opaque_bound_equations(id, receiver, bindings)?;
                            values.push(receiver);
                            continue;
                        }
                        if path.declaration.is_none() && path.args.is_empty() {
                            let bindings = if environment == 0 {
                                base_environment
                            } else {
                                &environments[environment - 1]
                            };
                            if let Some(value) = bindings.get(&path.name) {
                                values.push(*value);
                                continue;
                            }
                            if integer_name(&path.name)
                                || matches!(
                                    path.name.as_str(),
                                    "bool"
                                        | "char"
                                        | "f64"
                                        | "str"
                                        | "World"
                                        | "Arguments"
                                        | "Environment"
                                        | "ExitStatus"
                                        | "Stdout"
                                        | "Stdin"
                                        | "Stderr"
                                        | "Directory" | "ReadDirectory" | "ReadFile" | "Image" | "Channel" | "Worker" | "ReadRegion" | "ForeignCommand" | "ForeignSession" | "NullDevice"
                                        | "File"
                                        | "Process"
                                        | "Clock"
                                        | "Child"
                                        | "Listener"
                                        | "Connector"
                                        | "TcpPort"
                                        | "TemporaryFiles"
                                        | "Readiness"
                                        | "Entropy"
                                        | "Stop"
                                )
                            {
                                values.push(self.atom(&path.name));
                                continue;
                            }
                            if path.name.contains("::") {
                                values.push(self.blocked());
                                continue;
                            }
                        }
                        let mut arguments: Vec<a::TypeId> = Vec::new();
                        for arg in &path.args {
                            if !matches!(&self.source.types[*arg].kind,
                                    a::Type::Path(path) if path.name.starts_with('\''))
                            {
                                arguments.push(*arg);
                            }
                        }
                        pending.push(Work::Path {
                            id,
                            path,
                            environment,
                            arguments: arguments.len(),
                        });
                        while let Some(id) = arguments.pop() {
                            pending.push(Work::Source { id, environment });
                        }
                    }
                    a::Type::Function { .. } => values.push(self.blocked()),
                },
                Work::Qualified { id, qualification, name, args, environment } => {
                    let receiver = values.pop().expect("qualified inference receiver");
                    let outer = if environment == 0 { base_environment.clone() }
                        else { environments[environment - 1].clone() };
                    let application = match qualification.trait_ty {
                        Some(trait_ty) => match self.source.types[trait_ty].kind.clone() {
                            a::Type::Path(path) => self.trait_application(receiver, &path, &outer)?,
                            _ => None,
                        },
                        None => None,
                    };
                    let value = if let Some((declaration, arguments, mut bindings)) = application {
                        let span = self.source.types[id].span;
                        let mut family = Vec::new();
                        for argument in args { family.push(self.source_type(argument, &outer)?); }
                        let alias = super::super::semantic::source_type_name(self.source, id);
                        self.family_projection(receiver, declaration, &arguments, &name, &family, bindings, &alias, span)?
                    } else { self.blocked() };
                    values.push(value);
                }
                Work::Reference(mutable) => {
                    let inner = values.pop().expect("reference inference child");
                    values.push(self.shaped(Shape::Ref(mutable, inner)));
                }
                Work::Slice => {
                    let inner = values.pop().expect("slice inference child");
                    values.push(self.shaped(Shape::Slice(inner)));
                }
                Work::Array(len, environment) => {
                    let inner = values.pop().expect("array inference child");
                    let count = if let Some(len) = crate::generics::const_arguments::literal(&len) {
                        self.shaped(Shape::Constant(len))
                    } else {
                        let bindings = if environment == 0 { base_environment }
                            else { &environments[environment - 1usize] };
                        bindings.get(&len).copied().unwrap_or_else(|| self.blocked())
                    };
                    values.push(self.shaped(Shape::Array(inner, count)));
                }
                Work::Tuple(count) => {
                    let fields = take_values(&mut values, count);
                    values.push(if fields.is_empty() {
                        self.atom("()")
                    } else {
                        self.shaped(Shape::Tuple(fields))
                    });
                }
                Work::Path {
                    id,
                    path,
                    environment,
                    arguments,
                } => {
                    let arguments = take_values(&mut values, arguments);
                    if path.declaration.is_none() && path.name.contains("::") {
                        let outer = if environment == 0 { base_environment.clone() } else { environments[environment - 1usize].clone() };
                        let span = self.source.types[id].span;
                        if let Some(value) = self.named_family_projection(id, &path, &arguments, &outer, span)? { values.push(value); continue; }
                    }
                    if path.declaration.is_none() && arguments.len() == 1 {
                        if path.name == "Vec" {
                            values.push(self.shaped(Shape::Vec(arguments[0])));
                            continue;
                        }
                        if path.name == "Box" {
                            values.push(self.shaped(Shape::Box(arguments[0])));
                            continue;
                        }
                    }
                    if let Some(declaration) = path.declaration {
                        if path.name != self.source.declarations[declaration].name {
                            values.push(self.shaped(Shape::Source(id)));
                            continue;
                        }
                        let item = self.source.declarations[declaration].item;
                        let generics = crate::generics::defaults::parameters(self.source, declaration);
                        let mut declared = BTreeMap::new();
                        let mut position = 0;
                        let mut next: Option<(usize, a::TypeId)> = None;
                        for index in 0..generics.len() {
                            let parameter = &generics[index];
                            if parameter.lifetime { continue; }
                            if position == arguments.len() {
                                if let Some(default) = parameter.default { next = Some((index, default)); }
                                break;
                            }
                            declared.insert(parameter.name.clone(), arguments[position]);
                            position += 1;
                        }
                        if let Some((index, default)) = next {
                            self.parameter_equations(&generics[..index], &mut declared, false)?;
                            let default_environment = environments.len() + 1usize;
                            environments.push(declared);
                            pending.push(Work::Default { id, path, environment, arguments });
                            pending.push(Work::Source { id: default, environment: default_environment });
                            continue;
                        }
                        if let a::Item::Alias(index) = item {
                            let mut aliases = if environment == 0 {
                                base_environment.clone()
                            } else {
                                environments[environment - 1].clone()
                            };
                            let mut argument_index = 0;
                            for parameter in parameters(self.source, declaration) {
                                if argument_index >= arguments.len() {
                                    break;
                                }
                                let prefix = format!("{parameter}::");
                                let mut removed: Vec<String> = Vec::new();
                                for name in aliases.keys() {
                                    if name.starts_with(&prefix) {
                                        removed.push(name.clone());
                                    }
                                }
                                for name in removed {
                                    aliases.remove(&name);
                                }
                                aliases.insert(parameter, arguments[argument_index]);
                                argument_index += 1;
                            }
                            let generics = self.source.aliases[index].generics.clone();
                            self.parameter_equations(&generics, &mut aliases, false)?;
                            let predicates = self.source.aliases[index].predicates.clone();
                            self.predicate_equations(&predicates, &mut aliases, false)?;
                            let environment = environments.len() + 1;
                            environments.push(aliases);
                            pending.push(Work::Source {
                                id: self.source.aliases[index].ty,
                                environment,
                            });
                            continue;
                        }
                        if matches!(item, a::Item::Struct(_) | a::Item::Enum(_)) {
                            values.push(self.shaped(Shape::Nominal(declaration, arguments)));
                            continue;
                        }
                    }
                    values.push(self.shaped(Shape::Source(id)));
                }
                Work::Default { id, path, environment, mut arguments } => {
                    arguments.push(values.pop().expect("inferred type argument default"));
                    let count = arguments.len();
                    values.extend_from_slice(&arguments);
                    pending.push(Work::Path { id, path, environment, arguments: count });
                }
            }
        }
        Ok(values.pop().expect("source inference type"))
    }
}

fn take_values(values: &mut Vec<Variable>, count: usize) -> Vec<Variable> {
    let start = values.len() - count;
    let mut result = Vec::new();
    for index in start..values.len() {
        result.push(values[index]);
    }
    values.truncate(start);
    result
}

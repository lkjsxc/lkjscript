//! Declaration headers add equations before numeric fallback. Unconditional
//! inherent heads have precedence; one visible structural candidate can also
//! constrain a callable signature. Competing candidates stay with the selector.
use super::*;
use std::collections::BTreeSet;

impl Infer<'_, '_> {
    pub(super) fn opaque_environment(&mut self, ty: a::TypeId, names: &[String], values: &[Variable])
        -> Result<BTreeMap<String, Variable>> {
        let mut environment = BTreeMap::new();
        for index in 0..names.len() { environment.insert(names[index].clone(), values[index]); }
        let owner = self.source.impl_traits.get(&ty).unwrap().result.unwrap();
        if let a::FunctionOwner::Implementation(implementation) = self.source.function_owner(a::FunctionId { index: owner }) {
            let implementation = self.source.impls[implementation.index].clone();
            self.parameter_equations(&implementation.generics, &mut environment, false)?;
            self.predicate_equations(&implementation.predicates, &mut environment, false)?;
        }
        let function = self.source.functions[owner].clone();
        self.parameter_equations(&function.generics, &mut environment, false)?;
        self.predicate_equations(&function.predicates, &mut environment, false)?;
        Ok(environment)
    }

    pub(super) fn opaque_bound_equations(&mut self, ty: a::TypeId, receiver: Variable,
        producer: &BTreeMap<String, Variable>) -> Result<()> {
        let mut environment = producer.clone();
        let alias = format!("$opaque:{ty}");
        let bounds = self.source.impl_traits.get(&ty).unwrap().bounds.clone();
        for bound in &bounds {
            self.trait_equations(receiver, &alias, *bound, &mut environment, true)?;
        }
        // Equality RHS names belong to the producing function. In an inherent
        // method, `Item = Self` names its owner, not the opaque result receiver.
        for bound in &bounds {
            self.binding_equations(receiver, *bound, &environment, true)?;
        }
        let root = self.root(receiver);
        let projections = self.projections[root].clone();
        let span = self.source.types[ty].span;
        for ((declaration, arguments, member), _) in projections {
            self.qualified_projection(receiver, declaration, &arguments, &member, span);
        }
        Ok(())
    }

    /// An abstract receiver contributes only its written trait declarations.
    /// Concrete implementation heads must never determine its source interface.
    pub(super) fn bound_method_header(&mut self, receiver: Variable, name: &str,
        type_args: &[a::TypeId], arguments: &[Variable], result: Variable,
        location: (a::ModuleId, a::Span)) -> Result<bool> {
        let opaque = match self.shape(receiver) {
            Some(Shape::Opaque(ty, _, _)) => Some(ty),
            Some(Shape::Rigid(_) | Shape::Projected(_, _) | Shape::Projection(_, _, _, _)) => None,
            _ => return Ok(false),
        };
        let (scope, span) = location;
        let mut clone = false;
        if let Some(ty) = opaque {
            for bound in &self.source.impl_traits.get(&ty).unwrap().bounds {
                if matches!(&self.source.types[*bound].kind, a::Type::Path(path)
                    if path.declaration.is_none() && matches!(path.name.as_str(), "Clone" | "Copy")) { clone = true; }
            }
        }
        let mut seen: Vec<(a::DeclarationId, Vec<Variable>)> = Vec::new();
        let mut method: Option<(usize, BTreeMap<String, Variable>)> = None;
        for (target, bound, trait_arguments, environment) in self.trait_headers.clone() {
            if self.definition.root(target) != self.definition.root(receiver) { continue; }
            let a::Type::Path(path) = &self.source.types[bound].kind else { continue; };
            let Some(declaration) = path.declaration else { continue; };
            if seen.iter().any(|(owner, previous)| *owner == declaration && self.same_trait_arguments(previous, &trait_arguments)) { continue; }
            seen.push((declaration, trait_arguments));
            let a::Item::Trait(index) = self.source.declarations[declaration].item else { continue; };
            let definition = self.source.traits[index].clone();
            for parent in &definition.bounds {
                if matches!(&self.source.types[*parent].kind, a::Type::Path(path)
                    if path.declaration.is_none() && matches!(path.name.as_str(), "Clone" | "Copy")) { clone = true; }
            }
            if opaque.is_some() && !self.names.trait_in_scope(scope, declaration, span) { continue; }
            for candidate in &definition.methods {
                let function = &self.source.functions[*candidate];
                if function.name != name { continue; }
                if function.params.first().is_none_or(|parameter| parameter.name != "self")
                    || function.params.len() != arguments.len() + 1usize
                    || (!type_args.is_empty() && type_args.len() != type_parameter_count(&function.generics)) {
                    return Ok(false);
                }
                if method.is_some() { return Ok(false); }
                method = Some((*candidate, environment.clone()));
            }
        }
        if let Some((method, environment)) = method {
            let output = self.header_signature(method, type_args, arguments, environment, 1, span)?;
            self.unify(result, output, span)?;
            return Ok(true);
        }
        if clone && name == "clone" && arguments.is_empty() && type_args.is_empty() {
            self.unify(result, receiver, span)?;
            return Ok(true);
        }
        Ok(false)
    }

    pub(super) fn inherent_header(
        &mut self,
        receiver: Variable,
        name: &str,
        type_args: &[a::TypeId],
        arguments: &[Variable],
        result: Variable,
        location: (a::ModuleId, a::Span),
    ) -> Result<bool> {
        let (scope, span) = location;
        let Some(Shape::Nominal(declaration, receiver_arguments)) = self.shape(receiver) else {
            return Ok(false);
        };
        let head = self.source.declarations[declaration].name.as_str();
        let mut candidates = Vec::new();
        for index in self
            .implementations
            .method_candidates_by_head(Some(head), name)
        {
            if self.source.impls[index].trait_ty.is_none() {
                candidates.push(index);
            }
        }
        if candidates.len() != 1 {
            return Ok(false);
        }
        let implementation = self.source.impls[candidates[0]].clone();
        if !implementation.predicates.is_empty() { return Ok(false); }
        for parameter in &implementation.generics {
            if !parameter.bounds.is_empty() {
                return Ok(false);
            }
        }
        let mut methods = Vec::new();
        for index in &implementation.methods {
            if self.source.functions[*index].name == name {
                methods.push(*index);
            }
        }
        if methods.len() != 1 {
            return Ok(false);
        }
        let method = methods[0];
        let function = &self.source.functions[method];
        if !crate::resolve::visible(
            self.source,
            self.names.scope(&function.module),
            function.public,
            scope,
        ) || function.params.first().is_none_or(|p| p.name != "self")
            || function.params.len() != arguments.len() + 1
            || (!type_args.is_empty()
                && type_args.len() != type_parameter_count(&function.generics))
        {
            return Ok(false);
        }
        let mut environment = BTreeMap::new();
        for parameter in &implementation.generics {
            if !parameter.lifetime {
                environment.insert(parameter.name.clone(), self.unknown());
            }
        }
        let target = self.source_type(implementation.target, &environment)?;
        let Some(Shape::Nominal(target_declaration, target_arguments)) = self.shape(target) else {
            return Ok(false);
        };
        if target_declaration != declaration || target_arguments.len() != receiver_arguments.len() {
            return Ok(false);
        }
        // Owner<A, B> with each impl parameter used once covers the entire
        // canonical receiver head. Owner<Option<A>>, fixed arguments, repeated
        // parameters and unresolved prerequisites cannot establish this fact.
        let mut parameters = BTreeSet::<Variable>::new();
        for parameter in environment.values() {
            parameters.insert(*parameter);
        }
        let mut targets = BTreeSet::<Variable>::new();
        for argument in &target_arguments {
            targets.insert(*argument);
        }
        if targets != parameters || target_arguments.len() != parameters.len() {
            return Ok(false);
        }
        self.unify(target, receiver, span)?;
        environment.insert("Self".to_string(), receiver);
        let output = self.header_signature(method, type_args, arguments, environment, 1, span)?;
        self.unify(result, output, span)?;
        Ok(true)
    }
}

impl Infer<'_, '_> {
    /// A single visible structural candidate contributes conditional equations.
    /// Competing bounded headers stay unresolved: eligibility and inherent
    /// precedence still belong to the ordinary selector, not this graph.
    pub(super) fn contextual_header(
        &mut self,
        receiver: Variable,
        name: &str,
        type_args: &[a::TypeId],
        arguments: &[Variable],
        result: Variable,
        location: (usize, a::ExprId, a::ModuleId, a::Span),
    ) -> Result<bool> {
        let (id, expression, scope, span) = location;
        if matches!(self.shape(receiver), None | Some(Shape::Rigid(_) | Shape::Opaque(..))) {
            self.watch(receiver, id);
            return Ok(false);
        }
        let head = self.shape_head(receiver);
        let head_view = match &head {
            Some(head) => Some(head.as_str()),
            None => None,
        };
        let candidates = self
            .implementations
            .method_candidates_by_head(head_view, name);
        let mut selected: Option<(usize, usize, BTreeMap<String, Variable>)> = None;
        for candidate in candidates {
            let implementation = self.source.impls[candidate].clone();
            let trait_declaration =
                implementation
                    .trait_ty
                    .and_then(|ty| match &self.source.types[ty].kind {
                        a::Type::Path(path) => path.declaration,
                        _ => None,
                    });
            let unavailable = trait_declaration
                .is_some_and(|declaration| !self.names.trait_in_scope(scope, declaration, span));
            if unavailable {
                continue;
            }
            let environment = match self.implementation_environment(candidate, receiver)? {
                projection_equations::Match::No => continue,
                projection_equations::Match::Deferred => {
                    self.watch_shape(receiver, id);
                    return Ok(false);
                }
                projection_equations::Match::Yes(environment) => environment,
            };
            if unavailable {
                return Ok(false);
            }
            for method in &implementation.methods {
                let function = &self.source.functions[*method];
                if function.name != name {
                    continue;
                }
                if (trait_declaration.is_none()
                    && !crate::resolve::visible(
                        self.source,
                        self.names.scope(&function.module),
                        function.public,
                        scope,
                    ))
                    || function.params.first().is_none_or(|p| p.name != "self")
                    || function.params.len() != arguments.len() + 1
                    || (!type_args.is_empty()
                        && type_args.len() != type_parameter_count(&function.generics))
                {
                    return Ok(false);
                }
                if selected.is_some() {
                    return Ok(false);
                }
                selected = Some((candidate, *method, environment.clone()));
            }
        }
        let Some((candidate, method, mut environment)) = selected else {
            return Ok(false);
        };
        let generics = self.source.impls[candidate].generics.clone();
        self.parameter_equations(&generics, &mut environment, false)?;
        let predicates = self.source.impls[candidate].predicates.clone();
        self.predicate_equations(&predicates, &mut environment, false)?;
        if let Some(bound) = self.source.impls[candidate].trait_ty {
            self.trait_equations(receiver, "Self", bound, &mut environment, false)?;
        }
        self.method_application_header((candidate, method, expression),
            type_args, arguments, result, environment, span)?;
        Ok(true)
    }

    /// A selected source header contributes bindings to its exact application.
    /// The caller supplies conditional receiver and implementation equations;
    /// the ordinary selector still proves eligibility before lowering a call.
    /// These bindings never create an argument coercion or reborrow site.
    pub(super) fn method_application_header(
        &mut self,
        selection: (usize, usize, a::ExprId),
        type_args: &[a::TypeId],
        arguments: &[Variable],
        result: Variable,
        environment: BTreeMap<String, Variable>,
        span: a::Span,
    ) -> Result<()> {
        let (candidate, method, expression) = selection;
        let generics = self.source.impls[candidate].generics.clone();
        let (output, method_environment) = self.header_signature_environment(
            method, type_args, arguments, environment.clone(), 1, span)?;
        self.unify(result, output, span)?;
        let mut application = BTreeMap::new();
        for parameter in &generics {
            if !parameter.lifetime {
                if let Some(value) = environment.get(&parameter.name) {
                    application.insert(parameter.name.clone(), *value);
                }
            }
        }
        // Result context can determine a method-local argument even when no
        // value parameter names it, as in text.parse().ok(). Retain its
        // variable under this exact expression/implementation/method identity.
        // Lowering consumes these bindings only after evaluating arguments.
        for parameter in &self.source.functions[method].generics {
            if parameter.lifetime { continue; }
            if application.contains_key(&parameter.name) {
                return Err(err(parameter.span, "E_NAME",
                    "method generic parameter shadows an implementation parameter"));
            }
            if let Some(value) = method_environment.get(&parameter.name) {
                application.insert(parameter.name.clone(), *value);
            }
        }
        self.definition.method_applications.insert(expression, super::MethodApplication {
            implementation: candidate, method, arguments: application,
        });
        Ok(())
    }
}

impl Infer<'_, '_> {
    // A unique inherent associated header supplies equations for an omitted
    // owner type. Eligibility remains a later obligation of the normal selector.
    pub(super) fn associated_header(
        &mut self,
        path: &a::Path,
        arguments: &[Variable],
        scope: a::ModuleId,
        span: a::Span,
    ) -> Result<Option<Variable>> {
        let Some(separator) = path.name.rfind("::") else {
            return Ok(None);
        };
        let owner = &path.name.as_str()[..separator];
        let name = &path.name.as_str()[separator + 2..];
        let Some(declaration) = path.declaration else {
            return Ok(None);
        };
        let receiver_parameters = match self.source.declarations[declaration].item {
            a::Item::Struct(index) => &self.source.structs[index].generics,
            a::Item::Enum(index) => &self.source.enums[index].generics,
            _ => return Ok(None),
        };
        if !path.args.is_empty() && receiver_parameters.iter().any(|parameter| !parameter.lifetime) {
            return Ok(None);
        }
        let mut candidates = Vec::new();
        for index in self
            .implementations
            .method_candidates_by_head(Some(owner), name)
        {
            let implementation = &self.source.impls[index];
            if implementation.trait_ty.is_some() {
                continue;
            }
            for method in &implementation.methods {
                let function = &self.source.functions[*method];
                if function.name == name
                    && function.params.first().is_none_or(|p| p.name != "self")
                    && function.params.len() == arguments.len()
                    && crate::resolve::visible(
                        self.source,
                        self.names.scope(&function.module),
                        function.public,
                        scope,
                    )
                {
                    candidates.push((index, *method));
                }
            }
        }
        if candidates.len() != 1 {
            return Ok(None);
        }
        let (implementation, method) = candidates[0];
        let implementation = self.source.impls[implementation].clone();
        let mut environment = BTreeMap::new();
        for parameter in &implementation.generics {
            if !parameter.lifetime {
                environment.insert(parameter.name.clone(), self.unknown());
            }
        }
        let target = self.source_type(implementation.target, &environment)?;
        if !matches!(self.shape(target), Some(Shape::Nominal(found, _)) if found == declaration) {
            return Ok(None);
        }
        environment.insert("Self".to_string(), target);
        self.parameter_equations(&implementation.generics, &mut environment, false)?;
        self.predicate_equations(&implementation.predicates, &mut environment, false)?;
        Ok(Some(self.header_signature(
            method,
            &path.args,
            arguments,
            environment,
            0,
            span,
        )?))
    }
}

fn type_parameter_count(parameters: &[a::GenericParam]) -> usize {
    let mut count = 0;
    for parameter in parameters {
        if !parameter.lifetime && !parameter.implicit {
            count += 1;
        }
    }
    count
}

//! Qualified projections keep the receiver and declared trait through inference.
use super::*;
use std::collections::BTreeSet;

impl Infer<'_, '_> {
    pub(super) fn qualified_projection(
        &mut self, receiver: Variable, declaration: a::DeclarationId, member: &str, span: a::Span,
    ) -> Variable {
        let root = self.projection_receiver(receiver);
        let key = (declaration, member.to_string());
        let previous = match self.projections[root].get(&key) {
            Some(value) => Some(*value),
            None => None,
        };
        if let Some(value) = previous {
            let value = self.root(value);
            if matches!(self.shape(value), Some(Shape::Projected(_, _))) {
                self.definition.nodes[value].shape = Some(Shape::Projection(declaration, member.to_string(), receiver));
            }
            return value;
        }
        let value = if matches!(self.shape(receiver), Some(Shape::Rigid(_) | Shape::Projected(_, _) | Shape::Projection(_, _, _) | Shape::Opaque(..))) {
            self.shaped(Shape::Projection(declaration, member.to_string(), receiver))
        } else {
            let value = self.operation_type();
            self.obligation(Obligation::Projection { receiver, declaration, member: member.to_string(), result: value, span });
            value
        };
        self.projections[root].insert(key, value);
        value
    }

    pub(super) fn qualified_header(&mut self, path: &a::Path, arguments: &[Variable], scope: a::ModuleId, span: a::Span) -> Result<Variable> {
        let qualification = path.qualification.as_ref().unwrap();
        let outer = self.environment.clone();
        let receiver = self.source_type(qualification.receiver, &outer)?;
        let Some(trait_ty) = qualification.trait_ty else {
            let result = self.operation_type();
            self.obligation(Obligation::Associated { receiver, name: path.name.clone(),
                types: path.args.clone(), scope, arguments: arguments.to_vec(), result, span });
            return Ok(result);
        };
        let a::Type::Path(bound) = self.source.types[trait_ty].kind.clone() else {
            return Ok(self.blocked());
        };
        let Some(declaration) = bound.declaration else { return Ok(self.blocked()); };
        let a::Item::Trait(owner) = self.source.declarations[declaration].item else { return Ok(self.blocked()); };
        if !bound.args.is_empty() { return Ok(self.blocked()); }
        let definition = self.source.traits[owner].clone();
        let mut method = None;
        for index in &definition.methods {
            if self.source.functions[*index].name == path.name { method = Some(*index); break; }
        }
        let Some(method) = method else { return Ok(self.blocked()); };
        let mut environment = BTreeMap::new();
        environment.insert("Self".to_string(), receiver);
        self.trait_equations(receiver, "Self", trait_ty, &mut environment, false)?;
        self.binding_equations(receiver, trait_ty, &environment, false)?;
        for associated in &definition.associated {
            let value = self.qualified_projection(receiver, declaration, &associated.name, span);
            environment.insert(format!("Self::{}", associated.name), value);
        }
        self.header_signature(method, &path.args, arguments, environment, 0, span)
    }

    pub(super) fn associated_bound_headers(
        &mut self,
        source_receiver: Variable,
        receiver: Variable,
        declaration: a::DeclarationId,
        member: &str,
        alias: &str,
        environment: &mut BTreeMap<String, Variable>,
    ) -> Result<()> {
        // Re-entering the same projection reuses its existing equations. Mark
        // it before expanding a binding such as Next = <Self as Loop>::Next.
        // The original receiver and declared member distinguish equal results
        // whose different associated declarations contribute separate bounds.
        let root = self.projection_receiver(source_receiver);
        let key = (declaration, member.to_string());
        if !self.projection_headers[root].insert(key.clone()) { return Ok(()); }
        let result = self.associated_bound_equations(receiver, declaration, member, alias, environment);
        if result.is_err() {
            let root = self.projection_receiver(source_receiver);
            self.projection_headers[root].remove(&key);
        }
        result
    }

    fn associated_bound_equations(
        &mut self,
        receiver: Variable,
        declaration: a::DeclarationId,
        member: &str,
        alias: &str,
        environment: &mut BTreeMap<String, Variable>,
    ) -> Result<()> {
        let a::Item::Trait(owner) = self.source.declarations[declaration].item else { return Ok(()); };
        let mut bounds = Vec::new();
        for associated in &self.source.traits[owner].associated {
            if associated.name == member { bounds = associated.bounds.clone(); break; }
        }
        let rigid = matches!(self.shape(receiver), Some(Shape::Rigid(_) | Shape::Projected(_, _) | Shape::Projection(_, _, _) | Shape::Opaque(..)));
        for bound in &bounds {
            self.trait_equations(receiver, alias, *bound, environment, rigid)?;
        }
        for bound in &bounds {
            self.binding_equations(receiver, *bound, environment, rigid)?;
        }
        Ok(())
    }

    pub(super) fn associated_receiver_header(
        &mut self,
        receiver: Variable,
        name: &str,
        types: &[a::TypeId],
        arguments: &[Variable],
        result: Variable,
        location: (usize, a::ModuleId, a::Span),
    ) -> Result<bool> {
        let (id, scope, span) = location;
        let Some(shape) = self.shape(receiver) else {
            self.watch(receiver, id);
            return Ok(false);
        };
        if matches!(shape, Shape::Rigid(_) | Shape::Projected(_, _) | Shape::Projection(_, _, _) | Shape::Opaque(..)) {
            // These are declaration equations, not implementation evidence.
            // Definition checking still selects and proves the exact bound.
            let root = self.root(receiver);
            let headers = self.trait_headers.clone();
            let mut seen = BTreeSet::new();
            let mut selected = None;
            for (target, bound) in headers {
                if self.root(target) != root { continue; }
                let declaration = match &self.source.types[bound].kind {
                    a::Type::Path(path) if path.args.is_empty() => path.declaration,
                    _ => None,
                };
                let Some(declaration) = declaration else { continue; };
                if !self.names.trait_in_scope(scope, declaration, span) { continue; }
                if !seen.insert(declaration) { continue; }
                let a::Item::Trait(owner) = self.source.declarations[declaration].item else { continue; };
                for method in &self.source.traits[owner].methods {
                    let function = &self.source.functions[*method];
                    if function.name == name && function.params.len() == arguments.len()
                        && function.params.first().is_none_or(|parameter| parameter.name != "self") {
                        if selected.is_some() { return Ok(false); }
                        selected = Some((*method, bound));
                    }
                }
            }
            let Some((method, bound)) = selected else { return Ok(false); };
            let mut environment = BTreeMap::new();
            environment.insert("Self".to_string(), receiver);
            self.trait_equations(receiver, "Self", bound, &mut environment, false)?;
            self.binding_equations(receiver, bound, &environment, false)?;
            let output = self.header_signature(method, types, arguments, environment, 0, span)?;
            self.unify(result, output, span)?;
            return Ok(true);
        }
        let head = self.shape_head(receiver);
        let head_view = match &head { Some(head) => Some(head.as_str()), None => None };
        let implementations = self.implementations.associated_method_candidates_by_head(self.source, head_view, name);
        let mut candidates: Vec<(usize, usize, BTreeMap<String, Variable>)> = Vec::new();
        let mut inherent: Vec<(usize, usize, BTreeMap<String, Variable>)> = Vec::new();
        for candidate in implementations {
            let implementation = self.source.impls[candidate].clone();
            let trait_declaration = implementation.trait_ty.and_then(|ty| match &self.source.types[ty].kind {
                a::Type::Path(path) => path.declaration,
                _ => None,
            });
            if trait_declaration.is_some_and(|declaration| !self.names.trait_in_scope(scope, declaration, span)) {
                continue;
            }
            let environment = match self.implementation_environment(candidate, receiver)? {
                projection_equations::Match::No => continue,
                projection_equations::Match::Deferred => { self.watch_shape(receiver, id); return Ok(false); }
                projection_equations::Match::Yes(environment) => environment,
            };
            if let Some(method) = crate::generics::implementation_method(self.source, candidate, name) {
                let function = &self.source.functions[method];
                if function.name != name || function.params.len() != arguments.len()
                    || function.params.first().is_some_and(|parameter| parameter.name == "self") {
                    continue;
                }
                if implementation.trait_ty.is_none() {
                    if crate::resolve::visible(self.source, self.names.scope(&function.module), function.public, scope) {
                        inherent.push((candidate, method, environment.clone()));
                    }
                } else { candidates.push((candidate, method, environment.clone())); }
            }
        }
        if !inherent.is_empty() { candidates = inherent; }
        if candidates.len() != 1 { return Ok(false); }
        let (candidate, method, mut environment) = candidates.pop().unwrap();
        let implementation = self.source.impls[candidate].clone();
        self.parameter_equations(&implementation.generics, &mut environment, false)?;
        self.predicate_equations(&implementation.predicates, &mut environment, false)?;
        if let Some(bound) = implementation.trait_ty {
            self.trait_equations(receiver, "Self", bound, &mut environment, false)?;
            self.binding_equations(receiver, bound, &environment, false)?;
        }
        let output = self.header_signature(method, types, arguments, environment, 0, span)?;
        self.unify(result, output, span)?;
        Ok(true)
    }

    pub(super) fn predicate_equations(
        &mut self, predicates: &[a::WherePredicate], environment: &mut BTreeMap<String, Variable>, rigid: bool,
    ) -> Result<()> {
        for predicate in predicates {
            let receiver = self.source_type(predicate.target, environment)?;
            let alias = super::super::semantic::source_type_name(self.source, predicate.target);
            for bound in &predicate.bounds {
                self.trait_equations(receiver, &alias, *bound, environment, rigid)?;
            }
        }
        for predicate in predicates {
            let receiver = self.source_type(predicate.target, environment)?;
            for bound in &predicate.bounds {
                self.binding_equations(receiver, *bound, environment, rigid)?;
            }
        }
        for predicate in predicates {
            let receiver = self.source_type(predicate.target, environment)?;
            for bound in &predicate.bounds {
                self.callable_bound(receiver, *bound, environment)?;
            }
        }
        Ok(())
    }
}

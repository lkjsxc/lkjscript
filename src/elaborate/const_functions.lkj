//! Conservative source const-function qualification over ordinary lowering.
//! This untrusted producer check grants no IR authority and does not evaluate constants.
use super::{Bindings, Builder, Compiler, PendingFunction, Result, a, definition_types, err, ir, is_copy, place_type};
use crate::generics::TraitIdentity;
use std::collections::{BTreeMap, BTreeSet};

impl Compiler<'_> {
    pub(super) fn check_associated_constants(&mut self) -> Result<()> {
        for index in 0usize..self.source.impls.len() {
            let implementation = self.source.impls[index].clone();
            let Some(trait_ty) = implementation.trait_ty else { continue; };
            if implementation.constants.is_empty() { continue; }
            let a::Type::Path(path) = self.source.types[trait_ty].kind.clone() else { continue; };
            let TraitIdentity::Declared(trait_index) = crate::generics::bound_identity(self.source, &path) else { continue; };
            let receiver = self.resolve(implementation.target, &BTreeMap::new())?;
            let declared = self.trait_environment(receiver, &TraitIdentity::Declared(trait_index));
            let mut substitution = declared.clone();
            substitution.insert(format!("$family::implementation:{index}"), receiver);
            for constant in &implementation.constants {
                let constant = self.source.constants[*constant].clone();
                let mut member_type = None;
                for member in &self.source.traits[trait_index].constants {
                    if member.name == constant.name { member_type = Some(member.ty); break; }
                }
                let Some(member_type) = member_type else {
                    return Err(err(constant.span, "E_TRAIT", "constant is not declared by the trait"));
                };
                let expected = self.resolve(member_type, &declared)?;
                let actual = self.resolve(constant.ty, &substitution)?;
                if actual != expected {
                    return Err(err(constant.span, "E_TYPE", "implementation constant type differs from its exact trait member"));
                }
            }
        }
        for index in 0usize..self.source.constants.len() {
            if self.source.constants[index].owner.is_none() { continue; }
            let constant = self.source.constants[index].clone();
            let scope = self.names.scope(&constant.module);
            let mut scratch = ir::Function {
                file: constant.span.file, name: constant.name.clone(), params: 0,
                result: ir::UNIT, return_source: None, locals: Vec::new(), body: Vec::new(), test: false,
            };
            let mut builder = Builder {
                source_function: None, scope, file: constant.span.file, compiler: self, function: &mut scratch,
                return_annotated: true, scoped_body: super::scoped_locals::Body::default(), typed_bindings: Vec::new(),
                sub: BTreeMap::new(), bindings: Bindings::default(), guard_aliases: BTreeMap::new(),
                guard_shells: Vec::new(), capture_aliases: BTreeMap::new(), capture_locals: BTreeSet::new(),
                active_span: constant.span, active_expression: None, const_calls: BTreeMap::new(),
                const_constructors: BTreeSet::new(), references: super::Facts::new(0),
                reference_updates: super::Facts::new(0), reference_schedules: BTreeMap::new(), carriers: BTreeMap::new(),
                dependents: BTreeMap::new(), assignment_types: BTreeMap::new(), range_borrows: BTreeMap::new(),
                inferred: definition_types::Types::default(), live: super::Facts::new(0),
                definite_live: super::Facts::new(0), written: super::Facts::new(0), loops: Vec::new(), reachable: true,
            };
            let (_, ty) = builder.associated_constant(index)?;
            drop(builder);
            scratch.result = ty;
            self.check_sized_function(&scratch, constant.span)?;
        }
        Ok(())
    }
    pub(super) fn const_source_declaration(&self, function: usize) -> Option<usize> {
        for (index, pending) in &self.pending_functions {
            if *index != function { continue; }
            return match pending {
                PendingFunction::Source(instance) if self.source.functions[instance.source].const_qualified => Some(instance.source),
                _ => None,
            };
        }
        None
    }

    fn const_drop_trivial(&mut self, ty: usize) -> bool {
        let mut pending = vec![ty];
        let mut seen = BTreeSet::new();
        while let Some(ty) = pending.pop() {
            if !seen.insert(ty) { continue; }
            // A rigid stand-in's empty layout is not evidence that T has no Drop.
            let rigid = { self.contracts.as_ref().is_some_and(|contracts| contracts.rigid.contains_key(&ty)) };
            if rigid {
                if !self.satisfies_bound(ty, "Copy") { return false; }
                continue;
            }
            if !self.implementations.candidates(&self.types, &self.applications, ty,
                &TraitIdentity::Builtin("Drop".to_string())).is_empty() { return false; }
            if is_copy(&self.types, ty) { continue; }
            match &self.types[ty].kind {
                ir::TypeKind::Unit | ir::TypeKind::Bool | ir::TypeKind::Char
                | ir::TypeKind::Int { .. } | ir::TypeKind::F64 | ir::TypeKind::Ref { .. } => {}
                ir::TypeKind::Array { inner, .. } => pending.push(*inner),
                ir::TypeKind::Struct { fields, .. } => {
                    for field in fields { pending.push(field.ty); }
                }
                ir::TypeKind::Enum { variants, .. } => {
                    for variant in variants {
                        for field in &variant.fields { pending.push(field.ty); }
                    }
                }
                _ => return false,
            }
        }
        true
    }

    pub(super) fn check_const_function(&mut self, source: usize, function: &ir::Function,
        calls: &BTreeMap<a::ExprId, usize>, constructors: &BTreeSet<a::ExprId>) -> Result<()> {
        let declaration = self.source.functions[source].clone();
        if !declaration.const_qualified { return Ok(()); }
        let span = declaration.span;
        for instruction in &function.body {
            let reason = match &instruction.op {
                ir::Op::Call { function, .. } if self.const_source_declaration(*function).is_none() =>
                    Some("const fn cannot call a non-const function, trait method or dynamic callable"),
                ir::Op::Intrinsic { .. } =>
                    Some("intrinsic calls, allocation and external effects in const fn require a separate const contract"),
                ir::Op::Borrow { mutable: true, .. }
                | ir::Op::SliceBorrow { mutable: true, .. }
                | ir::Op::ViewRange { mutable: true, .. } =>
                    Some("mutable borrowing in const fn is not implemented"),
                ir::Op::Assign { place, .. } if place.projections.iter()
                    .any(|projection| matches!(projection, ir::Projection::Deref)) =>
                    Some("mutation through a reference in const fn is not implemented"),
                ir::Op::Drop { place } | ir::Op::DropIf { place } => {
                    let trivial = place_type(&self.types, function, place)
                        .is_some_and(|ty| self.const_drop_trivial(ty));
                    if trivial { None } else {
                        Some("const fn cannot implicitly destroy a value with non-const or unknown Drop")
                    }
                }
                _ => None,
            };
            if let Some(reason) = reason {
                let mut problem = err(span, "E_UNSUPPORTED", reason);
                problem.line = instruction.line;
                problem.column = instruction.column;
                return Err(problem);
            }
        }
        let body = match declaration.body {
            Some(body) => self.source.blocks[body].span,
            None => return Err(err(span, "E_TYPE", "const fn requires a body")),
        };
        for (expression_id, expression) in self.source.exprs.iter().enumerate() {
            let site = expression.span;
            if site.file != body.file || site.start < body.start || site.end > body.end { continue; }
            if matches!(expression.kind, a::Expr::Closure { .. } | a::Expr::Try(_)) {
                return Err(err(site, "E_UNSUPPORTED",
                    "closures and try expressions in const fn require a separate const contract"));
            }
            if !matches!(expression.kind, a::Expr::Call { .. } | a::Expr::Method { .. }) { continue; }
            // ExprId, not source coordinates, ties each call to its selected
            // declaration. Chained calls may start at the same line and column.
            let selected = calls.get(&expression_id).copied();
            let source_call = selected.is_some_and(|index| self.source.functions[index].const_qualified);
            let constructor = if constructors.contains(&expression_id) {
                match &expression.kind {
                    a::Expr::Call { callee, .. } => {
                        match &self.source.exprs[*callee].kind {
                            a::Expr::Path(path) => {
                                let resolved = self.names.value_path(self.source.exprs[*callee].scope, path, site)?;
                                crate::generics::const_data_constructor(self.source, &resolved)
                                    || resolved.name == "Self" || resolved.name.starts_with("Self::")
                            }
                            _ => false,
                        }
                    }
                    _ => false,
                }
            } else { false };
            let qualified = source_call || constructor;
            if !qualified {
                return Err(err(site, "E_UNSUPPORTED",
                    "const fn calls require a declared const source function or a data constructor"));
            }
        }
        Ok(())
    }
}

impl Builder<'_, '_> {
    pub(super) fn associated_constant(&mut self, index: usize) -> Result<(usize, usize)> {
        let constant = self.compiler.source.constants[index].clone();
        let mut substitution = BTreeMap::new();
        if let Some(owner) = constant.owner {
            let receiver = self.compiler.resolve(owner, &BTreeMap::new())?;
            substitution.insert("Self".to_string(), receiver);
            if let Some(implementation) = self.compiler.source.constant_implementation(index) {
                if self.compiler.source.impls[implementation].trait_ty.is_some() {
                    substitution.insert(format!("$family::implementation:{implementation}"), receiver);
                }
            }
        }
        let ty = self.compiler.resolve(constant.ty, &substitution)?;
        // A use constructs the same value in the declaration's lexical context.
        let previous_scope = self.scope;
        let previous_file = self.file;
        self.scope = self.compiler.names.scope(&constant.module);
        self.file = constant.span.file;
        let previous_sub = std::mem::replace(&mut self.sub, substitution);
        let previous_bindings = std::mem::replace(&mut self.bindings, Bindings::default());
        let previous_guards = std::mem::replace(&mut self.guard_aliases, BTreeMap::new());
        let result = self.expr(constant.value, Some(ty));
        self.scope = previous_scope;
        self.file = previous_file;
        self.sub = previous_sub;
        self.bindings = previous_bindings;
        self.guard_aliases = previous_guards;
        let result = result?;
        if result.1 != ty {
            return Err(err(constant.span, "E_TYPE", "associated constant initializer type differs from its declaration"));
        }
        Ok(result)
    }
}

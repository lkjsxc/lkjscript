//! Source rewrites accompany diagnostics; every rewritten program is checked anew.
use super::{Builder, a, err, ir};
use crate::diagnostic::Edit;
use crate::generics::TraitIdentity;

fn receiver_edits(span: a::Span, suffix: &str) -> Vec<Edit> {
    vec![
        Edit { start: span.start, end: span.start, replacement: "(".to_string() },
        Edit { start: span.end, end: span.end, replacement: format!("){suffix}") },
    ]
}

impl Builder<'_, '_> {
    pub(super) fn receiver_diagnostic(
        &mut self,
        expression: a::ExprId,
        receiver: a::ExprId,
        base: usize,
        name: &str,
        span: a::Span,
    ) -> Option<a::Diagnostic> {
        let (no_types, argument_count) = {
            let a::Expr::Method { types, args, .. } = &self.compiler.source.exprs[expression].kind else {
                return None;
            };
            (types.is_empty(), args.len())
        };
        let receiver_span = self.compiler.source.exprs[receiver].span;
        if name == "split" && no_types && argument_count == 1usize && self.library_string(base, span) {
            let mut problem = err(
                span,
                "E_UNSUPPORTED",
                "String.split requires a str receiver; help: write text.as_str().split(separator) (docs/language.md, Source library)",
            );
            problem.edits = receiver_edits(receiver_span, ".as_str()");
            self.split_count_diagnostic(expression, span, &mut problem);
            return Some(problem);
        }
        if name == "copy_from_slice" && no_types && argument_count == 1usize {
            if let ir::TypeKind::Array { inner, .. } = self.compiler.types[base].kind {
                if self.compiler.satisfies_identity(inner, &TraitIdentity::Builtin("Copy".to_string())) {
                    let mut problem = err(span, "E_UNSUPPORTED",
                        "array.copy_from_slice requires a mutable slice receiver and Copy elements; help: write bytes[..].copy_from_slice(source) (docs/language.md, Source library)");
                    problem.edits = receiver_edits(receiver_span, "[..]");
                    return Some(problem);
                }
            }
        }
        if name == "trim" && no_types && argument_count == 0usize
            && matches!(self.compiler.types[base].kind, ir::TypeKind::Str)
        {
            let mut problem = err(span, "E_UNSUPPORTED",
                "str.trim is unavailable; help: use std::str::trim_ascii(value) only when stripping ASCII whitespace bytes 9..13 and 32 is intended; non-breaking and other Unicode spaces are preserved (docs/language.md, Source library)");
            let a::Expr::String(value) = &self.compiler.source.exprs[receiver].kind else { return Some(problem); };
            for byte in value.as_bytes() { if *byte >= 128u8 { return Some(problem); } }
            let Ok(helper) = self.compiler.names.library_function("str", "trim_ascii", span) else { return Some(problem); };
            let path = a::Path { qualification: None, bindings: Vec::new(), declaration: None, name: "std::str::trim_ascii".to_string(), args: Vec::new() };
            let scope = self.compiler.source.exprs[expression].scope;
            let Ok(path) = self.compiler.names.value_path(scope, &path, span) else { return Some(problem); };
            let Some(declaration) = path.declaration else { return Some(problem); };
            if self.compiler.source.declarations[declaration].item != a::Item::Function(helper)
                || receiver_span.start != span.start || receiver_span.end + 7usize != span.end
            { return Some(problem); }
            // Tight literal extent avoids guessing parentheses discarded by the AST.
            problem.edits = vec![
                Edit { start: receiver_span.start, end: receiver_span.start, replacement: "std::str::trim_ascii(".to_string() },
                Edit { start: receiver_span.end, end: span.end, replacement: ")".to_string() },
            ];
            return Some(problem);
        }
        if argument_count != 0usize { return None; }
        if name == "to_vec" && no_types {
            if let ir::TypeKind::Array { inner, .. } = self.compiler.types[base].kind {
                if !self.compiler.satisfies_identity(inner, &TraitIdentity::Builtin("Clone".to_string())) {
                    return None;
                }
                let mut problem = err(
                    span,
                    "E_UNSUPPORTED",
                    "array.to_vec requires a slice receiver and Clone elements; help: write array[..].to_vec() (docs/language.md, Source library)",
                );
                problem.edits = receiver_edits(receiver_span, "[..]");
                return Some(problem);
            }
        }
        if name == "parse" && self.library_string(base, span) {
            let mut problem = err(
                span,
                "E_UNSUPPORTED",
                "String.parse requires a str receiver; help: write text.as_str().parse::<T>() (docs/language.md, Source library)",
            );
            problem.edits = receiver_edits(receiver_span, ".as_str()");
            return Some(problem);
        }
        None
    }

    fn primitive_edit_type(&self, ty: usize) -> Option<String> {
        match self.compiler.types[ty].kind {
            ir::TypeKind::Unit => Some("()".to_string()),
            ir::TypeKind::Bool => Some("bool".to_string()),
            ir::TypeKind::Char => Some("char".to_string()),
            ir::TypeKind::Int { .. } => Some(self.compiler.types[ty].name.clone()),
            ir::TypeKind::F64 => Some("f64".to_string()),
            _ => None,
        }
    }

    pub(super) fn method_context_diagnostic(
        &self,
        expression: a::ExprId,
        problem: a::Diagnostic,
    ) -> a::Diagnostic {
        if problem.code != "E_TYPE"
            || !problem.message.contains("closure parameter or result type needs context")
        {
            return problem;
        }
        let node = &self.compiler.source.exprs[expression];
        let a::Expr::Method { receiver, name, types, args } = &node.kind else {
            return problem;
        };
        if name != "map_err" || !types.is_empty() || args.len() != 1usize { return problem; }
        let closure = &self.compiler.source.exprs[args[0]];
        let a::Expr::Closure { params, patterns, result, body, .. } = &closure.kind else {
            return problem;
        };
        if params.len() != 1usize || patterns.len() != 1usize
            || problem.file != closure.span.file
            || problem.line != closure.span.line || problem.column != closure.span.column
        {
            return problem;
        }
        let Some(mut base) = self.inferred.expressions.get(receiver).copied() else {
            return problem;
        };
        let borrowed_receiver = matches!(self.compiler.types[base].kind, ir::TypeKind::Ref { .. });
        while let ir::TypeKind::Ref { inner, .. } = self.compiler.types[base].kind { base = inner; }
        let Some((application, arguments)) = self.compiler.applications.get(&base) else {
            return problem;
        };
        let declaration = self.compiler.names.library_type("prelude", "Result", node.span)
            .ok().and_then(|path| path.declaration);
        if declaration.is_none()
            || self.compiler.declaration_names.get(application).copied() != declaration
            || arguments.len() != 2usize
        {
            return problem;
        }
        let error_type = arguments[1];
        let input = self.inferred.bindings.get(&patterns[0]).copied();
        let output = self.inferred.expressions.get(body).copied();
        let input_text = match input {
            Some(ty) => self.compiler.display_type(ty),
            None => format!("unresolved (expected {})", self.compiler.display_type(error_type)),
        };
        let output_text = match output {
            Some(ty) => self.compiler.display_type(ty),
            None => "unresolved".to_string(),
        };
        let mut revised = err(
            closure.span,
            "E_TYPE",
            &format!(
                "Result::map_err closure needs known input and result types; input: {input_text}; result: {output_text}; help: annotate the missing closure type; a literal.to_string() body can use |_| -> std::String {{ literal.to_string() }} (docs/language.md, Source library)"
            ),
        );
        if input.is_none() && output.is_some()
            && matches!(self.compiler.source.types[params[0].ty].kind, a::Type::Infer)
        {
            if let Some(annotation) = self.primitive_edit_type(error_type) {
                let end = self.compiler.source.patterns[patterns[0]].span.end;
                revised.edits.push(Edit { start: end, end, replacement: format!(": {annotation}") });
                return revised;
            }
        }

        if borrowed_receiver {
            revised.message.push_str("; automatic result annotations are not offered for borrowed Result receivers");
            return revised;
        }

        // The existing text lowering always calls source String::from_str.
        // This exact body therefore has a known String result without inferring
        // arbitrary closure bodies or moving their captures/control-flow scope.
        let body = &self.compiler.source.exprs[*body];
        let a::Expr::Method { receiver: text, name, types, args } = &body.kind else {
            return revised;
        };
        if result.is_some() || !matches!(self.compiler.source.patterns[patterns[0]].kind, a::Pattern::Wild)
            || !matches!(self.compiler.source.types[params[0].ty].kind, a::Type::Infer)
            || name != "to_string" || !types.is_empty() || !args.is_empty()
            || !matches!(self.compiler.source.exprs[*text].kind, a::Expr::String(_))
        {
            return revised;
        }
        revised.edits = vec![
            Edit { start: body.span.start, end: body.span.start,
                replacement: "-> std::String { ".to_string() },
            Edit { start: body.span.end, end: body.span.end,
                replacement: " }".to_string() },
        ];
        revised
    }
}

impl Builder<'_, '_> {
    fn split_count_diagnostic(
        &self,
        expression: a::ExprId,
        span: a::Span,
        problem: &mut a::Diagnostic,
    ) {
        // Do not replace a user's count method, including a trait method whose
        // applicability becomes known only after repairing the split receiver.
        for index in 0..self.compiler.source.functions.len() {
            let function = &self.compiler.source.functions[index];
            if function.name == "count"
                && self.compiler.source.function_owner(a::FunctionId { index }) != a::FunctionOwner::Free
            {
                return;
            }
        }
        for node in &self.compiler.source.exprs {
            let a::Expr::Method { receiver, name, types, args } = &node.kind else { continue; };
            if *receiver == expression && name == "count" && types.is_empty() && args.is_empty()
                && node.span.file == span.file && node.span.start == span.start && node.span.end > span.end
            {
                problem.message.push_str("; source IteratorExt has no count method; use fold(0usize, |n: usize, _: &str| -> usize { n + 1usize })");
                problem.edits.push(Edit {
                    start: span.end,
                    end: node.span.end,
                    replacement: ".fold(0usize, |n: usize, _: &str| -> usize { n + 1usize })".to_string(),
                });
                return;
            }
        }
    }

    pub(super) fn empty_array_diagnostic(
        &self,
        expected: Option<usize>,
        span: a::Span,
    ) -> a::Diagnostic {
        let mut problem = err(
            span,
            "E_TYPE",
            "empty array literal [] needs an element type; help: annotate a [T; 0] binding, or write &[0u8; 0] for an empty &[u8] argument (docs/language.md, Scalars and evaluation)",
        );
        let inner = match expected {
            Some(ty) => match self.compiler.types[ty].kind {
                ir::TypeKind::Slice { inner, .. } => inner,
                _ => return problem,
            },
            None => return problem,
        };
        let Some(annotation) = self.primitive_edit_type(inner) else { return problem; };
        let value = match self.compiler.types[inner].kind {
            ir::TypeKind::Int { .. } => format!("0{annotation}"),
            ir::TypeKind::F64 => "0.0f64".to_string(),
            ir::TypeKind::Bool => "false".to_string(),
            ir::TypeKind::Char => "'\\0'".to_string(),
            ir::TypeKind::Unit => "()".to_string(),
            _ => return problem,
        };
        problem.message = format!(
            "empty array literal [] needs an element type; help: write &[{value}; 0] for an empty &[{annotation}] argument (docs/language.md, Scalars and evaluation)"
        );
        problem.edits.push(Edit {
            start: span.start,
            end: span.end,
            replacement: format!("[{value}; 0]"),
        });
        problem
    }

    pub(super) fn local_constant_diagnostic(&mut self, index: usize) -> a::Diagnostic {
        let constant = self.compiler.source.constants[index].clone();
        let mut problem = err(
            constant.span,
            "E_UNSUPPORTED",
            "local const declarations are unsupported; help: move the declaration to its containing module (docs/language.md, Statements, control and patterns)",
        );
        let source = self.compiler.source;
        let function = &source.functions[self.source_function()];
        let module = crate::resolve::module_scope(source, self.scope);
        if module != source.files[self.file].crate_root
            || constant.span.file != self.file || constant.module != function.module
            || !function.generics.is_empty()
            || source.function_owner(a::FunctionId { index: self.source_function() }) != a::FunctionOwner::Free
            || self.binding(&constant.name).is_some()
            || source.attrs.iter().any(|attribute| attribute.span.file == self.file)
        {
            return problem;
        }
        for declaration in &source.declarations {
            if declaration.scope == module && declaration.name == constant.name
                && declaration.item != a::Item::Constant(index)
            {
                return problem;
            }
        }
        let ty = match self.compiler.resolve(constant.ty, &self.sub) {
            Ok(ty) => ty,
            Err(_) => return problem,
        };
        let Some(annotation) = self.primitive_edit_type(ty) else { return problem; };
        let value = match (&self.compiler.types[ty].kind, &self.compiler.source.exprs[constant.value].kind) {
            (ir::TypeKind::Int { .. }, a::Expr::Int(text))
            | (ir::TypeKind::F64, a::Expr::Float(text)) => text.clone(),
            (ir::TypeKind::Bool, a::Expr::Bool(value)) => {
                if *value { "true".to_string() } else { "false".to_string() }
            },
            (ir::TypeKind::Char, a::Expr::Char(value)) => format!("'\\u{{{:x}}}'", *value as u32),
            _ => return problem,
        };
        // No source text or effectful initializer is moved speculatively.
        // The root-module restriction keeps names in their existing module,
        // and insertion before the file preserves function visibility/attributes.
        problem.edits = vec![
            Edit {
                start: 0usize,
                end: 0usize,
                replacement: format!("const {}: {annotation} = {value};\n", constant.name),
            },
            Edit {
                start: constant.span.start,
                end: constant.span.end,
                replacement: String::new(),
            },
        ];
        problem
    }

    pub(super) fn iterator_diagnostic(
        &self,
        target: usize,
        arguments: &[usize],
        values: &[usize],
        span: a::Span,
        problem: a::Diagnostic,
    ) -> a::Diagnostic {
        let problem = super::at_use_site(problem, span);
        if problem.code != "E_TRAIT"
            || problem.message != "associated projection needs its declared implementation witness"
            || arguments.len() != 1usize || values.len() != 1usize
            || self.compiler.names.library_function("iter", "__lkjscript_into_iter", span).ok() != Some(target)
        {
            return problem;
        }
        let ty = self.ty(values[0]);
        let shared_array = match self.compiler.types[ty].kind {
            ir::TypeKind::Ref { mutable: false, inner } => matches!(self.compiler.types[inner].kind, ir::TypeKind::Array { .. }),
            _ => false,
        };
        if shared_array {
            let mut revised = err(span, "E_TRAIT",
                "borrowed-array iteration has no applicable IntoIterator implementation for &[T; N]; help: iterate the existing array as a shared slice with &values[..] (docs/language.md, Source library)");
            let a::Expr::Borrow { mutable: false, value } = self.compiler.source.exprs[arguments[0]].kind else { return revised; };
            for function in &self.compiler.source.functions {
                if !function.module.starts_with("$std")
                    && matches!(function.name.as_str(), "into_iter" | "next" | "index" | "index_mut" | "deref" | "deref_mut")
                { return revised; }
            }
            revised.edits = receiver_edits(self.compiler.source.exprs[value].span, "[..]");
            return revised;
        }
        if !matches!(self.compiler.types[ty].kind, ir::TypeKind::Array { .. }) { return problem; }
        let mut revised = err(
            span,
            "E_TRAIT",
            "owned-array iteration requires an IntoIterator implementation; help: iterate by index, or use vec![elements] for owned literal elements (docs/language.md, Source library)",
        );
        let argument = &self.compiler.source.exprs[arguments[0]];
        if matches!(argument.kind, a::Expr::Array(_)) {
            revised.edits.push(Edit {
                start: argument.span.start,
                end: argument.span.start,
                replacement: "vec!".to_string(),
            });
        }
        revised
    }
}

//! Iterative elaboration of source types and nominal applications.
//!
//! Source edges, generic substitutions, nominal fields, and transparent aliases
//! use explicit work frames. In-progress nominal IDs are interned before their
//! fields, preserving recursive types through indirection without native recursion.
use super::{Compiler, Result, TypeKey, a, err, ir, is_copy};
use std::collections::BTreeMap;

enum Work {
    Source {
        id: a::TypeId,
        environment: usize,
    },
    Remember {
        id: a::TypeId,
        environment: usize,
    },
    Named {
        path: a::Path,
        environment: usize,
        span: a::Span,
    },
    Qualified {
        qualification: a::QualifiedPath,
        name: String,
        args: Vec<a::TypeId>,
        span: a::Span,
        environment: usize,
    },
    Apply {
        path: a::Path,
        environment: usize,
        span: a::Span,
        arguments: usize,
    },
    Instantiated {
        declaration: a::DeclarationId,
        arguments: Vec<usize>,
        span: a::Span,
    },
    Default {
        path: a::Path,
        environment: usize,
        span: a::Span,
        arguments: Vec<usize>,
    },
    Reference {
        mutable: bool,
        span: a::Span,
    },
    Slice { span: a::Span },
    Array {
        len: String,
        scope: a::ModuleId,
        span: a::Span,
        environment: usize,
    },
    Tuple {
        fields: usize,
        span: a::Span,
    },
    Struct {
        id: usize,
        source: usize,
        args: Vec<usize>,
        span: a::Span,
    },
    Enum {
        id: usize,
        source: usize,
        args: Vec<usize>,
        span: a::Span,
    },
    Alias {
        key: TypeKey,
    },
}

struct Resolution {
    pending: Vec<Work>,
    values: Vec<usize>,
    environments: Vec<BTreeMap<String, usize>>,
    resolved: BTreeMap<(a::TypeId, usize), usize>,
}

impl Resolution {
    fn new(start: Work, substitutions: &BTreeMap<String, usize>) -> Self {
        Resolution {
            pending: vec![start],
            values: Vec::new(),
            environments: vec![substitutions.clone()],
            resolved: BTreeMap::new(),
        }
    }

    fn take_values(&mut self, count: usize) -> Vec<usize> {
        let start = self.values.len() - count;
        let values = self.values[start..].to_vec();
        self.values.truncate(start);
        values
    }

    fn environment(&mut self, bindings: BTreeMap<String, usize>) -> usize {
        let id = self.environments.len();
        self.environments.push(bindings);
        id
    }
}

impl Compiler<'_> {
    // Inference and witness replay already know every nominal argument. These
    // are not written omissions and must never pick a declaration's defaults.
    pub(super) fn nominal_type(&mut self, declaration: a::DeclarationId,
        arguments: Vec<usize>, span: a::Span) -> Result<usize> {
        let parameters = crate::generics::defaults::parameters(self.source, declaration);
        let mut count = 0usize;
        for parameter in parameters { if !parameter.lifetime { count += 1usize; } }
        if arguments.len() != count {
            return Err(err(span, "E_TYPE", "instantiated nominal arguments differ from the declaration"));
        }
        self.resolve_work(Work::Instantiated { declaration, arguments, span }, &BTreeMap::new())
    }

    pub(super) fn resolve(
        &mut self,
        id: a::TypeId,
        sub: &BTreeMap<String, usize>,
    ) -> Result<usize> {
        self.resolve_work(Work::Source { id, environment: 0 }, sub)
    }

    pub(super) fn named_type(
        &mut self,
        path: &a::Path,
        sub: &BTreeMap<String, usize>,
        span: a::Span,
    ) -> Result<usize> {
        self.resolve_work(
            Work::Named {
                path: path.clone(),
                environment: 0,
                span,
            },
            sub,
        )
    }

    fn resolve_work(&mut self, start: Work, sub: &BTreeMap<String, usize>) -> Result<usize> {
        self.associated_queries.resolution_depth += 1;
        let result = self.resolve_frames(start, sub);
        self.associated_queries.resolution_depth -= 1;
        if self.associated_queries.resolution_depth == 0 && self.associated_queries.refresh_copy {
            if result.is_ok() { self.refresh_associated_tuple_copy(); }
            self.associated_queries.refresh_copy = false;
        }
        result
    }

    fn resolve_frames(&mut self, start: Work, sub: &BTreeMap<String, usize>) -> Result<usize> {
        let mut work = Resolution::new(start, sub);
        while let Some(frame) = work.pending.pop() {
            match frame {
                Work::Source { id, environment } => {
                    if let Some(ty) = work.resolved.get(&(id, environment)) {
                        work.values.push(*ty);
                        continue;
                    }
                    if self.source.constant_arguments.contains_key(&id) {
                        return Err(err(self.source.types[id].span, "E_TYPE", "a constant argument cannot occupy a type position"));
                    }
                    work.pending.push(Work::Remember { id, environment });
                    let opaque = self.source.impl_traits.get(&id).is_some_and(|form| form.result.is_some());
                    if opaque {
                        let ty = self.opaque_type(id, &work.environments[environment])?;
                        work.values.push(ty);
                        continue;
                    }
                    let node = &self.source.types[id];
                    match &node.kind {
                        a::Type::Infer => {
                            return Err(err(node.span, "E_TYPE", "type needs an annotation"));
                        }
                        a::Type::Path(path) => work.pending.push(Work::Named {
                            path: path.clone(),
                            environment,
                            span: node.span,
                        }),
                        a::Type::Ref { mutable, inner, .. } => {
                            work.pending.push(Work::Reference {
                                mutable: *mutable,
                                span: node.span,
                            });
                            work.pending.push(Work::Source {
                                id: *inner,
                                environment,
                            });
                        }
                        a::Type::Slice(inner) => {
                            work.pending.push(Work::Slice { span: node.span });
                            work.pending.push(Work::Source {
                                id: *inner,
                                environment,
                            });
                        }
                        a::Type::Array { inner, len } => {
                            work.pending.push(Work::Array {
                                len: len.clone(),
                                scope: node.scope,
                                span: node.span,
                                environment,
                            });
                            work.pending.push(Work::Source {
                                id: *inner,
                                environment,
                            });
                        }
                        a::Type::Tuple(fields) => {
                            work.pending.push(Work::Tuple {
                                fields: fields.len(),
                                span: node.span,
                            });
                            let mut index = fields.len();
                            while index != 0 {
                                index -= 1;
                                work.pending.push(Work::Source {
                                    id: fields[index],
                                    environment,
                                });
                            }
                        }
                        a::Type::Function { .. } => {
                            return Err(err(
                                node.span,
                                "E_UNSUPPORTED",
                                "function pointer types are not implemented",
                            ));
                        }
                        a::Type::Never => work.values.push(ir::UNIT),
                    }
                }
                Work::Remember { id, environment } => {
                    let value = *work.values.last().expect("completed source type");
                    work.resolved.insert((id, environment), value);
                }
                Work::Named {
                    path,
                    environment,
                    span,
                } => {
                    if let Some(value) = work.environments[environment].get(&path.name) {
                        if crate::generics::const_arguments::value(&self.types, *value).is_some() {
                            return Err(err(span, "E_TYPE", "a const parameter cannot occupy a type position"));
                        }
                    }
                    if !path.bindings.is_empty() {
                        return Err(err(path.bindings[0].span, "E_TRAIT",
                            "associated-type equality bindings are only accepted in trait bounds"));
                    }
                    if let Some(qualification) = &path.qualification {
                        work.pending.push(Work::Qualified { qualification: qualification.clone(), name: path.name, args: path.args, span, environment });
                        work.pending.push(Work::Source { id: qualification.receiver, environment });
                        continue;
                    }
                    if self.diagnostic_functions.is_some()
                        && path.declaration.is_some_and(|id| {
                            matches!(
                                self.source.declarations[id].item,
                                a::Item::Struct(_) | a::Item::Enum(_)
                            )
                        })
                    {
                        return Err(err(
                            span,
                            "E_BLOCKED",
                            "nominal layout requires its complete declaration contracts",
                        ));
                    }
                    let bindings = &work.environments[environment];
                    if path.args.is_empty() && self.names.generic_path(&path, span) {
                        if let Some(value) = bindings.get(&path.name) { work.values.push(*value); continue; }
                    }
                    if let Some(value) = self.named_family(&path, bindings, span)? {
                        work.values.push(value); continue;
                    }
                    if self.names.generic_path(&path, span) {
                        if !path.args.is_empty() {
                            return Err(err(
                                span,
                                "E_TYPE",
                                "generic parameter or projection cannot take type arguments",
                            ));
                        }
                        if let Some(id) = bindings.get(&path.name) {
                            work.values.push(*id);
                            continue;
                        }
                        if self.names.is_type_parameter(&path, span) {
                            return Err(err(
                                span,
                                "E_TYPE",
                                &format!("generic parameter {} needs a type argument", path.name),
                            ));
                        }
                        if let Some(id) = self.associated_contract(&path, bindings, span)? {
                            work.values.push(id);
                            continue;
                        }
                    }
                    if path.args.is_empty() && path.declaration.is_none() {
                        if let Some(id) = self.type_names.get(&path.name) {
                            work.values.push(*id);
                            continue;
                        }
                    }
                    let mut arguments: Vec<usize> = Vec::new();
                    for arg in &path.args {
                        if !matches!(&self.source.types[*arg].kind, a::Type::Path(p) if p.name.starts_with('\''))
                        {
                            arguments.push(*arg);
                        }
                    }
                    work.pending.push(Work::Apply {
                        path,
                        environment,
                        span,
                        arguments: arguments.len(),
                    });
                    while let Some(argument) = arguments.pop() {
                        work.pending.push(Work::Source {
                            id: argument,
                            environment,
                        });
                    }
                }
                Work::Qualified { qualification, name, args, span, environment } => {
                    let receiver = work.values.pop().expect("qualified path receiver");
                    let identity = self.qualified_trait(&qualification, &work.environments[environment], span)?;
                    let arguments = self.family_arguments(&args, &work.environments[environment])?;
                    let ty = self.associated_family_for_identity(receiver, &identity, &name, &arguments, qualification.member_span)?;
                    work.values.push(ty);
                }
                Work::Apply {
                    path,
                    environment,
                    span,
                    arguments,
                } => {
                    let args = work.take_values(arguments);
                    self.apply_named_type(path, args, environment, span, &mut work)?;
                }
                Work::Instantiated { declaration, arguments, span } => {
                    let path = a::Path { qualification: None, bindings: Vec::new(),
                        declaration: Some(declaration), name: self.source.declarations[declaration].name.clone(),
                        args: Vec::new() };
                    self.apply_named_type(path, arguments, 0, span, &mut work)?;
                }
                Work::Default { path, environment, span, mut arguments } => {
                    arguments.push(work.values.pop().expect("type argument default"));
                    self.apply_named_type(path, arguments, environment, span, &mut work)?;
                }
                Work::Reference { mutable, span } => {
                    let inner = work.values.pop().expect("reference child");
                    if mutable && matches!(self.types[inner].kind, ir::TypeKind::Str) {
                        return Err(err(
                            span,
                            "E_UNSUPPORTED",
                            "mutable str views are not implemented",
                        ));
                    }
                    work.values.push(self.reference(inner, mutable));
                }
                Work::Slice { span } => {
                    let inner = work.values.pop().expect("slice child");
                    self.require_source_sized(inner, span)?;
                    let id = self.intern(
                        String::new(),
                        ir::TypeKind::Slice {
                            inner,
                            mutable: false,
                        },
                    );
                    work.values.push(id);
                }
                Work::Array { len, scope, span, environment } => {
                    let inner = work.values.pop().expect("array child");
                    let constant = self.constant_length(&len, &work.environments[environment], scope, span)?;
                    self.check_owned_element(inner, span)?;
                    let id = self.array_type(inner, constant, span)?;
                    work.values.push(id);
                }
                Work::Tuple { fields, span } => {
                    let values = work.take_values(fields);
                    if values.is_empty() {
                        work.values.push(ir::UNIT);
                        continue;
                    }
                    let mut fields = Vec::new();
                    for (index, ty) in values.into_iter().enumerate() {
                        self.require_source_sized(ty, span)?;
                        fields.push(ir::Field {
                            name: format!("{index}"),
                            ty,
                        });
                    }
                    let copy = fields.iter().all(|field| is_copy(&self.types, field.ty));
                    let id = self.intern(String::new(), ir::TypeKind::Struct { fields, copy });
                    work.values.push(id);
                }
                Work::Struct {
                    id,
                    source,
                    args,
                    span,
                } => {
                    let definition = &self.source.structs[source];
                    let values = work.take_values(definition.fields.len());
                    let mut fields = Vec::new();
                    for (field, ty) in definition.fields.iter().zip(values) {
                        self.require_source_sized(ty, field.span)?;
                        fields.push(ir::Field {
                            name: field.name.clone(),
                            ty,
                        });
                    }
                    let requested_copy = definition.attrs.iter().any(|attr| {
                        attr.name == "derive" && attr.args.iter().any(|name| name == "Copy")
                    });
                    let fields_copy = fields.iter().all(|field| is_copy(&self.types, field.ty));
                    if requested_copy
                        && !fields_copy
                        && definition
                            .generics
                            .iter()
                            .all(|parameter| parameter.lifetime)
                    {
                        return Err(err(span, "E_TYPE", "Copy requires Copy fields"));
                    }
                    if crate::generics::phantom::is_name(&super::qualified(&definition.module, &definition.name)) {
                        // Existing [(); 0] storage has size zero and alignment one.
                        // The nominal TypeKey/applications retain source identity
                        // and ownership arguments; no array operation is exposed.
                        self.types[id].kind = ir::TypeKind::Array { inner: ir::UNIT, len: 0usize };
                        self.phantom_spans.insert(id, span);
                    } else {
                        self.types[id].kind = ir::TypeKind::Struct { fields, copy: requested_copy && fields_copy };
                    }
                    self.applications.insert(
                        id,
                        (super::qualified(&definition.module, &definition.name), args),
                    );
                    work.values.push(id);
                }
                Work::Enum {
                    id,
                    source,
                    args,
                    span,
                } => {
                    let definition = &self.source.enums[source];
                    let mut count = 0;
                    for variant in &definition.variants {
                        count += variant.fields.len();
                    }
                    let values = work.take_values(count);
                    let mut at = 0;
                    let mut variants = Vec::new();
                    for variant in &definition.variants {
                        let mut fields = Vec::new();
                        for field in &variant.fields {
                            self.require_source_sized(values[at], field.span)?;
                            fields.push(ir::Field {
                                name: field.name.clone(),
                                ty: values[at],
                            });
                            at += 1;
                        }
                        variants.push(ir::Variant {
                            name: variant.name.clone(),
                            fields,
                        });
                    }
                    let requested_copy = definition.attrs.iter().any(|attr| {
                        attr.name == "derive" && attr.args.iter().any(|name| name == "Copy")
                    });
                    let fields_copy = variants.iter().all(|variant| {
                        variant
                            .fields
                            .iter()
                            .all(|field| is_copy(&self.types, field.ty))
                    });
                    if requested_copy
                        && !fields_copy
                        && definition
                            .generics
                            .iter()
                            .all(|parameter| parameter.lifetime)
                    {
                        return Err(err(span, "E_TYPE", "Copy requires Copy fields"));
                    }
                    self.types[id].kind = ir::TypeKind::Enum {
                        variants,
                        copy: requested_copy && fields_copy,
                    };
                    self.applications.insert(
                        id,
                        (super::qualified(&definition.module, &definition.name), args),
                    );
                    work.values.push(id);
                }
                Work::Alias { key } => {
                    let id = *work.values.last().expect("alias target");
                    self.type_keys.insert(key, id);
                }
            }
        }
        Ok(work.values.pop().expect("resolved type"))
    }

    fn apply_named_type(
        &mut self,
        path: a::Path,
        mut args: Vec<usize>,
        environment: usize,
        span: a::Span,
        work: &mut Resolution,
    ) -> Result<()> {
        // Only unresolved builtin names select intrinsic representations.
        // Source declarations (including user types named Box or Vec) retain
        // their identity; synthetic nominal paths use the canonical map below.
        if path.declaration.is_none() && (path.name == "Vec" || path.name == "Box") {
            if args.len() != 1 {
                return Err(err(span, "E_TYPE", "collection requires one type argument"));
            }
            self.check_owned_element(args[0], span)?;
            let kind = if path.name == "Vec" {
                ir::TypeKind::Vec { inner: args[0] }
            } else {
                ir::TypeKind::Box { inner: args[0] }
            };
            work.values.push(self.intern(String::new(), kind));
            return Ok(());
        }
        if path.declaration.is_none() && path.name == "str" {
            if !args.is_empty() {
                return Err(err(span, "E_TYPE", "str takes no type arguments"));
            }
            work.values
                .push(self.intern(String::new(), ir::TypeKind::Str));
            return Ok(());
        }
        if path.declaration.is_none()
            && matches!(
                path.name.as_str(),
                "World"
                    | "Arguments"
                    | "Environment"
                    | "ExitStatus"
                    | "Stdout"
                    | "Stdin"
                    | "Stderr"
                    | "Directory" | "ReadDirectory" | "ReadFile" | "Image" | "Channel" | "Worker" | "ReadRegion" | "ForeignCommand" | "ForeignSession" | "NullDevice"
                    | "File"
                    | "Process"
                    | "Clock"
                    | "Child"
                    | "Listener"
                    | "Connector"
                    | "TcpPort"
                    | "TemporaryFiles"
                    | "Readiness"
                    | "Entropy"
                    | "Stop"
            )
        {
            if !args.is_empty() {
                return Err(err(
                    span,
                    "E_TYPE",
                    "capability types take no type arguments",
                ));
            }
            let kind = match path.name.as_str() {
                "World" => ir::TypeKind::World,
                "Arguments" => ir::TypeKind::Arguments,
                "Environment" => ir::TypeKind::Environment,
                "ExitStatus" => ir::TypeKind::ExitStatus,
                "Stdout" => ir::TypeKind::Stdout,
                "Stdin" => ir::TypeKind::Stdin,
                "Stderr" => ir::TypeKind::Stderr,
                "Directory" => ir::TypeKind::Directory,
                "ReadDirectory" => ir::TypeKind::ReadDirectory,
                "ReadFile" => ir::TypeKind::ReadFile,
                "Image" => ir::TypeKind::Image,
                "Channel" => ir::TypeKind::Channel,
                "Worker" => ir::TypeKind::Worker,
                "ReadRegion" => ir::TypeKind::ReadRegion,
                "ForeignCommand" => ir::TypeKind::ForeignCommand,
                "ForeignSession" => ir::TypeKind::ForeignSession,
                "NullDevice" => ir::TypeKind::NullDevice,
                "File" => ir::TypeKind::File,
                "Process" => ir::TypeKind::Process,
                "Clock" => ir::TypeKind::Clock,
                "Child" => ir::TypeKind::Child,
                "Listener" => ir::TypeKind::Listener,
                "Connector" => ir::TypeKind::Connector,
                "TcpPort" => ir::TypeKind::TcpPort,
                "TemporaryFiles" => ir::TypeKind::TemporaryFiles,
                "Readiness" => ir::TypeKind::Readiness,
                "Entropy" => ir::TypeKind::Entropy,
                "Stop" => ir::TypeKind::Stop,
                _ => unreachable!(),
            };
            work.values.push(self.intern(String::new(), kind));
            return Ok(());
        }
        let declaration = path
            .declaration
            .filter(|id| self.source.declarations[*id].name == path.name)
            .or_else(|| self.declaration_names.get(&path.name).copied());
        let item = declaration.map(|id| self.source.declarations[id].item);
        let parameters: Vec<a::GenericParam> = match item {
            Some(a::Item::Struct(index)) => self.source.structs[index].generics.clone(),
            Some(a::Item::Enum(index)) => self.source.enums[index].generics.clone(),
            Some(a::Item::Alias(index)) => self.source.aliases[index].generics.clone(),
            _ => Vec::new(),
        };
        if args.is_empty() && !parameters.iter().any(|parameter| parameter.default.is_some())
            && matches!(item, Some(a::Item::Struct(_)) | Some(a::Item::Enum(_))) {
            for parameter in &parameters {
                if !parameter.lifetime {
                    if let Some(ty) = work.environments[environment].get(&parameter.name) {
                        args.push(*ty);
                    }
                }
            }
        }
        let declaration = declaration
            .ok_or_else(|| err(span, "E_TYPE", &format!("unknown type {}", path.name)))?;
        if !matches!(item, Some(a::Item::Struct(_)) | Some(a::Item::Enum(_)) | Some(a::Item::Alias(_))) {
            return Err(err(span, "E_TYPE", &format!("unknown type {}", path.name)));
        }
        let mut position = 0;
        let mut declared = BTreeMap::new();
        for index in 0..parameters.len() {
            let parameter = &parameters[index];
            if parameter.lifetime { continue; }
            if position == args.len() {
                if let Some(default) = parameter.default {
                    self.prepare_parameter_associated(&parameters[..index], &mut declared)?;
                    let default_environment = work.environment(declared);
                    work.pending.push(Work::Default { path, environment, span, arguments: args });
                    work.pending.push(Work::Source { id: default, environment: default_environment });
                    return Ok(());
                }
                break;
            }
            declared.insert(parameter.name.clone(), args[position]);
            position += 1;
        }
        if crate::generics::phantom::is_name(&path.name) && args.len() == 1usize {
            self.check_phantom_argument(args[0], span)?;
        }
        let key = TypeKey::Nominal(declaration, args.clone());
        if let Some(id) = self.type_keys.get(&key) {
            work.values.push(*id);
            return Ok(());
        }
        if path.name == "$std::fmt::__FormatThunk" {
            if !args.is_empty() { return Err(err(span, "E_TYPE", "format thunk takes no type arguments")); }
            work.values.push(self.format_thunk_type(declaration, span)?);
            return Ok(());
        }
        let mut type_parameters: Vec<String> = Vec::new();
        for parameter in &parameters {
            if !parameter.lifetime {
                type_parameters.push(parameter.name.clone());
            }
        }
        if type_parameters.len() != args.len() {
            return Err(err(
                span,
                "E_TYPE",
                if matches!(item, Some(a::Item::Alias(_))) {
                    "wrong number of alias type arguments"
                } else {
                    "wrong number of type arguments"
                },
            ));
        }
        let mut bindings = work.environments[environment].clone();
        for (parameter, argument) in type_parameters.iter().zip(&args) {
            bindings.insert(parameter.clone(), *argument);
        }
        self.bounds(&parameters, &bindings).map_err(|problem| {
            if matches!(item, Some(a::Item::Alias(_)))
                && parameters.iter().any(|parameter| parameter.default.is_some())
                && crate::generics::defaults::deferred_obligation(&problem) {
                err(span, "E_UNSUPPORTED", &format!(
                    "type alias default application requires deferred well-formedness: {}", problem.message))
            } else { super::at_use_site(problem, span) }
        })?;
        let predicates = match item {
            Some(a::Item::Struct(index)) => self.source.structs[index].predicates.clone(),
            Some(a::Item::Enum(index)) => self.source.enums[index].predicates.clone(),
            Some(a::Item::Alias(index)) => self.source.aliases[index].predicates.clone(),
            _ => Vec::new(),
        };
        self.check_where_predicates(&predicates, &bindings)
            .map_err(|problem| super::at_use_site(problem, span))?;
        if self.has_type_families() {
            self.prepare_parameter_associated(&parameters, &mut bindings)?;
        }
        let environment = work.environment(bindings);
        if let Some(a::Item::Alias(index)) = item {
            work.pending.push(Work::Alias { key });
            work.pending.push(Work::Source {
                id: self.source.aliases[index].ty,
                environment,
            });
            return Ok(());
        }
        let canonical = &self.source.declarations[declaration].name;
        let description = if args.is_empty() {
            canonical.clone()
        } else {
            let mut description = canonical.clone();
            description.push('<');
            let mut index = 0;
            while index < args.len() {
                if index != 0 {
                    description.push(',');
                }
                description.push_str(&format!("t{}", args[index]));
                index += 1;
            }
            description.push('>');
            description
        };
        let id = self.types.len();
        self.type_keys.insert(key, id);
        self.types.push(ir::Type {
            name: description,
            kind: ir::TypeKind::Unit,
        });
        match item {
            Some(a::Item::Struct(index)) => {
                work.pending.push(Work::Struct {
                    id,
                    source: index,
                    args,
                    span,
                });
                let fields = &self.source.structs[index].fields;
                let mut field = fields.len();
                while field != 0 {
                    field -= 1;
                    work.pending.push(Work::Source {
                        id: fields[field].ty,
                        environment,
                    });
                }
            }
            Some(a::Item::Enum(index)) => {
                work.pending.push(Work::Enum {
                    id,
                    source: index,
                    args,
                    span,
                });
                let variants = &self.source.enums[index].variants;
                let mut variant = variants.len();
                while variant != 0 {
                    variant -= 1;
                    let fields = &variants[variant].fields;
                    let mut field = fields.len();
                    while field != 0 {
                        field -= 1;
                        work.pending.push(Work::Source {
                            id: fields[field].ty,
                            environment,
                        });
                    }
                }
            }
            _ => unreachable!("nominal declaration"),
        }
        Ok(())
    }
}

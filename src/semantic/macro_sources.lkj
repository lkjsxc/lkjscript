//! Macro source declarations and replay-validated expansion projections.
use super::*;

fn invocation_parent(catalog: &Catalog, program: &a::Program, invocation: &a::MacroInvocation) -> String {
    if let Some(parent) = invocation.parent { return origins::macros::expansion_identity(parent); }
    let mut found: Option<(usize, usize)> = None;
    if let Some(input) = &program.macro_input {
        for (index, function) in input.functions.iter().enumerate() {
            let span = function.span;
            if span.file == invocation.span.file && span.start <= invocation.span.start && invocation.span.end <= span.end {
                let width = span.end - span.start;
                if found.is_none_or(|(_, previous)| width < previous) { found = Some((index, width)); }
            }
        }
    }
    if let Some((index, _)) = found { return catalog.function_ids[index].clone(); }
    root_parent(&program.scopes[invocation.scope].path)
}

pub(super) fn append_entries(catalog: &mut Catalog, files: &[SourceText], program: &a::Program)
    -> Result<(), String> {
    for (index, definition) in program.macro_definitions.iter().enumerate() {
        let identity = origins::macros::definition_identity(program, index);
        append(catalog, files, identity.clone(), root_parent(&program.scopes[definition.scope].path),
            "macro-definition", &definition.name, definition.span, None, "macro_rules".to_string(), true)?;
        let item = *catalog.by_identity.get(&identity).unwrap();
        catalog.items[item].references_complete = false;
    }
    for (index, invocation) in program.macro_invocations.iter().enumerate() {
        let identity = origins::macros::invocation_identity(index);
        let parent = invocation_parent(catalog, program, invocation);
        append(catalog, files, identity.clone(), parent, "macro-invocation", &invocation.name,
            invocation.span, None, format!("{}!", invocation.name), false)?;
        if let Some(expansion) = invocation.parent {
            generated_projection(catalog, files, program, &identity,
                origins::Origin { declaration: None, expansion: origins::Expansion::Macro(expansion) },
                format!("{}!", invocation.name), false)?;
        }
        let item = *catalog.by_identity.get(&identity).unwrap();
        catalog.items[item].references_complete = false;
    }
    for (index, expansion) in program.macro_expansions.iter().enumerate() {
        let invocation = &program.macro_invocations[expansion.invocation];
        let identity = origins::macros::expansion_identity(index);
        let parent = origins::macros::invocation_identity(expansion.invocation);
        let definition = origins::macros::definition_identity(program, expansion.definition);
        append(catalog, files, identity.clone(), parent.clone(), "macro-expansion", "",
            invocation.span, None, format!("{}!", invocation.name), false)?;
        generated_projection(catalog, files, program, &identity,
            origins::Origin { declaration: None, expansion: origins::Expansion::Macro(index) },
            format!("{}! expansion", invocation.name), true)?;
        generated_reference(catalog, files, &identity, Some(definition), invocation.name_span, "macro-definition");
        // The invocation itself is the authored dependency of the expanded code.
        generated_reference(catalog, files, &identity, Some(parent), invocation.span, "macro-invocation");
    }
    Ok(())
}

fn pattern_expansions(program: &a::Program, root: usize,
    aliases: &BTreeMap<usize, (usize, usize)>) -> BTreeSet<usize> {
    let mut result = BTreeSet::new();
    let mut seen = BTreeSet::new();
    let mut pending = vec![root];
    while let Some(pattern) = pending.pop() {
        if !seen.insert(pattern) { continue; }
        if let Some((expansion, expanded)) = aliases.get(&pattern) {
            result.insert(*expansion); pending.push(*expanded);
        }
        match &program.patterns[pattern].kind {
            a::Pattern::Tuple(fields) | a::Pattern::Slice(fields) | a::Pattern::Or(fields)
            | a::Pattern::Variant { fields, .. } => {
                for field in fields { pending.push(*field); }
            }
            a::Pattern::Struct { fields, .. } => { for (_, field) in fields { pending.push(*field); } }
            a::Pattern::Ref { inner, .. } => pending.push(*inner),
            a::Pattern::At { binding, inner } => { pending.push(*binding); pending.push(*inner); }
            _ => {},
        }
    }
    result
}
fn epoch_edge(edges: &mut BTreeMap<usize, Vec<usize>>, from: usize, to: usize) {
    if !edges.contains_key(&from) { edges.insert(from, Vec::new()); }
    edges.get_mut(&from).unwrap().push(to);
}
pub(super) fn epoch(epoch: &mut Vec<u8>, files: &[SourceText], program: &a::Program, expansion: usize) {
    let mut calls = BTreeMap::new();
    let mut edges = BTreeMap::new();
    for (index, value) in program.macro_expansions.iter().enumerate() {
        calls.insert(value.invocation, index);
        if let Some(parent) = value.parent {
            epoch_edge(&mut edges, index, parent); epoch_edge(&mut edges, parent, index);
        }
    }
    let mut aliases = BTreeMap::new();
    for alias in &program.macro_pattern_aliases {
        if let Some(expansion) = calls.get(&alias.invocation) {
            aliases.insert(alias.pattern, (*expansion, alias.expanded));
        }
    }
    let mut exports = Vec::new();
    for export in &program.pattern_exports {
        let dependencies = pattern_expansions(program, export.source, &aliases);
        let first = dependencies.iter().next().copied();
        if let Some(first) = first {
            for dependency in &dependencies {
                epoch_edge(&mut edges, first, *dependency);
                epoch_edge(&mut edges, *dependency, first);
            }
        }
        exports.push((export.source, dependencies));
    }
    let mut selected = BTreeSet::new();
    let mut pending = vec![expansion];
    while let Some(index) = pending.pop() {
        if !selected.insert(index) { continue; }
        if let Some(neighbors) = edges.get(&index) {
            for neighbor in neighbors { pending.push(*neighbor); }
        }
    }
    bytes(epoch, b"lkjscript-macro-dependency-epoch-2");
    word(epoch, selected.len());
    for index in &selected {
        word(epoch, *index);
        let value = &program.macro_expansions[*index];
        let definition = &program.macro_definitions[value.definition];
        let invocation = &program.macro_invocations[value.invocation];
        let file = &files[definition.span.file];
        let start = preceding(&file.tokens, definition.span.start);
        bytes(epoch, origins::macros::definition_identity(program, value.definition).as_bytes());
        bytes(epoch, token_digest(&file.tokens, start, definition.span.end).as_bytes());
        bytes(epoch, format!("{}:{}", definition.exported, definition.local_inner).as_bytes());
        let file = &files[invocation.span.file];
        bytes(epoch, token_digest(&file.tokens, invocation.span.start, invocation.span.end).as_bytes());
    }
    for (source, dependencies) in exports {
        if !dependencies.iter().any(|dependency| selected.contains(dependency)) { continue; }
        bytes(epoch, b"pattern-export"); word(epoch, source);
        let span = program.patterns[source].span;
        bytes(epoch, token_digest(&files[span.file].tokens, span.start, span.end).as_bytes());
    }
    for (path, input) in &program.macro_inputs {
        bytes(epoch, path.as_bytes()); bytes(epoch, sha256::hex_digest(input).as_bytes());
    }
}

// Authored derives retain their existing epoch exactly. A derive emitted by a
// macro also depends on the authenticated template that created its nominal.
pub(super) fn derived_epoch(epoch: &mut Vec<u8>, files: &[SourceText], program: &a::Program,
    origin: origins::Origin) {
    let Some(declaration) = origin.declaration else { return; };
    let mut selected = None;
    for (index, expansion) in program.macro_expansions.iter().enumerate() {
        let included = match program.declarations[declaration].item {
            a::Item::Struct(id) => expansion.start.structs <= id && id < expansion.end.structs,
            a::Item::Enum(id) => expansion.start.enums <= id && id < expansion.end.enums,
            _ => false,
        };
        if included { selected = Some(index); }
    }
    if let Some(expansion) = selected { self::epoch(epoch, files, program, expansion); }
}

fn item_from_key(kind: usize, index: usize) -> a::Item {
    match kind {
        0usize => a::Item::Function(index), 1usize => a::Item::Struct(index),
        2usize => a::Item::Enum(index), 3usize => a::Item::Trait(index),
        4usize => a::Item::Impl(index), 5usize => a::Item::Use(index),
        6usize => a::Item::Module(index), 7usize => a::Item::Alias(index),
        _ => a::Item::Constant(index),
    }
}
pub(super) fn project_items(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    origins: &origins::Origins) -> Result<(), String> {
    for ((kind, index), origin) in &origins.macros.items {
        if *kind == 5usize { continue; }
        let identity = item_identity(program, item_from_key(*kind, *index), &catalog.function_ids);
        let item = match catalog.by_identity.get(&identity) { Some(item) => *item, None => continue };
        if !catalog.items[item].generated_from.is_empty() { continue; }
        let signature = format!("{} {}: {}", catalog.items[item].kind, source_path(&identity), catalog.items[item].type_name);
        generated_projection(catalog, files, program, &identity, *origin, signature, false)?;
    }
    // Fields, variants, parameters and associated members inherit their actual
    // expansion owner even when their parent was appended later in the catalog.
    loop {
        let mut changed = false;
        for index in 0usize..catalog.items.len() {
            if !catalog.items[index].generated_from.is_empty() { continue; }
            let parent = catalog.items[index].parent.clone();
            let parent = match catalog.by_identity.get(&parent) { Some(parent) => *parent, None => continue };
            if catalog.items[parent].generated_from.is_empty() { continue; }
            let from = catalog.items[parent].generated_from.clone();
            let expansion = catalog.items[parent].generated_expansion.clone();
            let item = &mut catalog.items[index];
            item.generated_from = from; item.generated_expansion = expansion;
            item.signature = item.type_name.clone();
            item.signature_digest = normalized_digest(&item.signature)?;
            item.text.clear(); item.text_digest = sha256::hex_digest(b"");
            item.name_start = item.start; item.name_end = item.start;
            item.body = None; item.body_digest.clear(); item.references_complete = false;
            changed = true;
        }
        if !changed { break; }
    }
    Ok(())
}

// A transcribed import has no authored use-tree spelling. Resolve its actual
// namespace and value dependencies from the replayed AST, retaining only the
// invocation anchor and expansion owner. Prefix dependencies prevent a module
// rename from pretending the template's qualification is editable.
pub(super) fn generated_imports(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, origins: &origins::Origins) {
    for (index, imported) in program.uses.iter().enumerate() {
        let Some(origin) = origins.macros.items.get(&(5usize, index)) else { continue; };
        let origins::Expansion::Macro(expansion) = origin.expansion else { continue; };
        let owner = origins::macros::expansion_identity(expansion);
        let scope = resolve::module(program, &imported.module);
        let mut parts: Vec<String> = Vec::new();
        for part in imported.path.as_str().split("::") { if !part.is_empty() { parts.push(part.to_string()); } }
        let mut prefix = String::new();
        for (position, part) in parts.iter().enumerate() {
            if !prefix.is_empty() { prefix.push_str("::"); }
            prefix.push_str(part);
            let terminal = position + 1usize == parts.len();
            let mut targets: BTreeSet<String> = BTreeSet::new();
            if terminal && !imported.glob {
                let path = a::Path { qualification: None, bindings: Vec::new(), declaration: None,
                    name: prefix.clone(), args: Vec::new() };
                if let Ok(resolved) = resolver.value_path(scope, &path, imported.span) {
                    if let Some(target) = value_identity(program, &resolved, &catalog.function_ids) { targets.insert(target); }
                }
            }
            if let Ok(path) = resolve::semantic_type_path(resolver, scope, &prefix, imported.span) {
                if let Some(target) = value_identity(program, &path, &catalog.function_ids) { targets.insert(target); }
            }
            let kind = if terminal { if imported.glob { "glob-import" } else { "import" } }
                else { "import-qualification" };
            if targets.is_empty() { generated_reference(catalog, files, &owner, None, imported.span, kind); }
            for target in targets { generated_reference(catalog, files, &owner, Some(target), imported.span, kind); }
        }
    }
}

pub(super) fn generated_nodes(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, origins: &origins::Origins,
    calls: &mut BTreeMap<String, usize>, evidence: &Option<crate::elaborate::semantic::Evidence>)
    -> Result<(), String> {
    for (expression, expansion) in &origins.macros.expressions {
        if origins.expressions.contains_key(expression) || !origins.macros.live_expressions.contains(expression) { continue; }
        let owner = origins::macros::expansion_identity(*expansion);
        generated_expression_owned(catalog, files, program, resolver, *expression, &owner, None, true, calls, evidence)?;
    }
    for (pattern, expansion) in &origins.macros.patterns {
        if origins.patterns.contains_key(pattern) || !origins.macros.live_patterns.contains(pattern) { continue; }
        let node = &program.patterns[*pattern];
        if let a::Pattern::Path(path) | a::Pattern::Variant { path, .. } | a::Pattern::Struct { path, .. } = &node.kind {
            let owner = origins::macros::expansion_identity(*expansion);
            let target = value_identity(program, path, &catalog.function_ids);
            generated_reference(catalog, files, &owner, target, node.span, "pattern");
        }
    }
    Ok(())
}

/// Header patterns keep their lexical block. Their semantic function owner is
/// instead recovered from the sparse signature graph, including replaced roots.
pub(super) fn pattern_function_owners(program: &a::Program) -> BTreeMap<usize, usize> {
    let mut aliases = BTreeMap::new();
    for alias in &program.macro_pattern_aliases { aliases.insert(alias.pattern, alias.expanded); }
    let mut result = BTreeMap::new();
    for (function, parameters) in &program.function_patterns {
        let mut pending = Vec::new();
        for (_, pattern) in parameters { pending.push(*pattern); }
        let mut seen = BTreeSet::new();
        while let Some(pattern) = pending.pop() {
            if !seen.insert(pattern) { continue; }
            result.insert(pattern, *function);
            if let Some(expanded) = aliases.get(&pattern) { pending.push(*expanded); }
            match &program.patterns[pattern].kind {
                a::Pattern::Tuple(fields) | a::Pattern::Slice(fields) | a::Pattern::Or(fields)
                | a::Pattern::Variant { fields, .. } => { for field in fields { pending.push(*field); } }
                a::Pattern::Struct { fields, .. } => { for (_, field) in fields { pending.push(*field); } }
                a::Pattern::Ref { inner, .. } => pending.push(*inner),
                a::Pattern::At { binding, inner } => { pending.push(*binding); pending.push(*inner); }
                _ => {},
            }
        }
    }
    result
}
pub(super) fn pattern_function_owner(program: &a::Program, roots: &BTreeMap<usize, usize>,
    parameters: &BTreeMap<usize, usize>, pattern: usize) -> Option<usize> {
    parameters.get(&pattern).copied()
        .or_else(|| function_owner(program, roots, program.patterns[pattern].block))
}

/// A deferred let-else export is the same authored binding as its success arm.
pub(super) fn canonical_binding(program: &a::Program, mut pattern: usize) -> usize {
    let mut seen = BTreeSet::new();
    while seen.insert(pattern) {
        let mut original = None;
        for export in &program.pattern_exports {
            let a::Pattern::Tuple(fields) = &program.patterns[export.outer].kind else { continue; };
            for (position, field) in fields.iter().enumerate() {
                if *field == pattern { original = export.sources.get(position).copied(); }
            }
        }
        let Some(original) = original else { break; };
        pattern = original;
    }
    pattern
}
/// A spelling is editable only when one original caller token owns it. Template
/// marks, widened anchors, repeated names and incomplete source ranges grant no site.
pub(super) fn binding_token(program: &a::Program, pattern: usize) -> Option<(usize, usize, a::Span)> {
    let input = program.macro_input.as_ref()?;
    let node = &program.patterns[canonical_binding(program, pattern)];
    let a::Pattern::Bind { name, .. } = &node.kind else { return None; };
    if a::macros::source_name(name) != name { return None; }
    let mut found = None;
    for (call, invocation) in input.macro_invocations.iter().enumerate() {
        for (index, token) in invocation.tokens.iter().enumerate() {
            if token.kind != 0u8 || token.context != 0usize || token.span != token.origin
                || token.span.file != node.span.file || token.span.start < node.span.start
                || token.span.end > node.span.end || crate::syntax::identifier_name(&token.text) != name { continue; }
            if found.is_some() { return None; }
            found = Some((call, index, token.span));
        }
    }
    found
}
/// Template binders remain projections. Caller-owned tokens may identify a
/// binding, but editing still requires the complete capture-role/replay proof.
pub(super) fn generated_bindings(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    origins: &origins::Origins, bindings: &mut BTreeMap<usize, String>,
    evidence: &Option<crate::elaborate::semantic::Evidence>) -> Result<(), String> {
    let mut counts: BTreeMap<(usize, String), usize> = BTreeMap::new();
    let parameters = pattern_function_owners(program);
    let mut roots = BTreeMap::new();
    for (function, value) in program.functions.iter().enumerate() {
        if let Some(body) = value.body { roots.insert(body, function); }
    }
    for (pattern, expansion) in &origins.macros.patterns {
        if origins.patterns.contains_key(pattern) || !origins.macros.live_patterns.contains(pattern) { continue; }
        if !matches!(program.patterns[*pattern].kind, a::Pattern::Bind { .. }) { continue; }
        let source = canonical_binding(program, *pattern);
        let existing = bindings.get(&source).cloned();
        if let Some(identity) = existing {
            bindings.insert(*pattern, identity); continue;
        }
        let node = &program.patterns[source];
        let a::Pattern::Bind { name, .. } = &node.kind else { continue; };
        let name = a::macros::source_name(name).to_string();
        let expansion = origins.macros.patterns.get(&source).copied().unwrap_or(*expansion);
        let owner = origins::macros::expansion_identity(expansion);
        let index = *catalog.by_identity.get(&owner).unwrap();
        let epoch = catalog.items[index].body_digest.clone();
        let key = (expansion, name.clone());
        let ordinal = counts.get(&key).copied().unwrap_or(0usize);
        counts.insert(key, ordinal + 1usize);
        let ty = evidence.as_ref().and_then(|value| value.bindings.get(&source)).cloned();
        let function = pattern_function_owner(program, &roots, &parameters, source);
        let position = program.macro_invocations[program.macro_expansions[expansion].invocation].position;
        let authored = if position == a::MacroPosition::Pattern {
            function.and_then(|function| {
                let identity = &catalog.function_ids[function];
                let index = *catalog.by_identity.get(identity)?;
                if !catalog.items[index].generated_from.is_empty()
                    || !evidence.as_ref().is_some_and(|value| value.definitions.contains(&function)) { return None; }
                binding_token(program, source).map(|(call, token, span)| (function, call, token, span))
            })
        } else { None };
        let identity: String;
        if let Some((function, call, token, span)) = authored {
            let parent = catalog.function_ids[function].clone();
            identity = format!("{parent}::capture:{call}:{token}::binding:{name}:{source}");
            append(catalog, files, identity.clone(), parent, "binding", &name, span, None,
                ty.clone().unwrap_or_else(|| -> String { "inferred type is unavailable".to_string() }), false)?;
            catalog.references.push(Reference { owner: identity.clone(), target: owner,
                file: files[span.file].path.clone(), kind: "macro-capture".to_string(), start: span.start, end: span.end });
        } else {
            identity = format!("{owner}::derived:{epoch}::binding:{name}:{ordinal}");
            append(catalog, files, identity.clone(), owner, "binding", &name, node.span, None,
                ty.clone().unwrap_or_else(|| -> String { "inferred type is unavailable".to_string() }), false)?;
            generated_projection(catalog, files, program, &identity,
                origins::Origin { declaration: None, expansion: origins::Expansion::Macro(expansion) }, name, false)?;
        }
        bindings.insert(source, identity.clone()); bindings.insert(*pattern, identity.clone());
        let index = *catalog.by_identity.get(&identity).unwrap();
        if let Some(ty) = ty {
            catalog.items[index].type_name = display_type_evidence(&ty)?;
            catalog.items[index].canonical_type = ty; catalog.items[index].type_resolved = true;
        }
    }
    // Ordinary siblings of a macro in a deferred let-else have the same
    // source/export identity, even though neither binding has a macro owner.
    for export in &program.pattern_exports {
        let a::Pattern::Tuple(fields) = &program.patterns[export.outer].kind else { continue; };
        for field in fields {
            let source = canonical_binding(program, *field);
            let identity = bindings.get(&source).cloned();
            if let Some(identity) = identity { bindings.insert(*field, identity); }
        }
    }
    Ok(())
}

pub(super) fn function_owner(program: &a::Program, roots: &BTreeMap<usize, usize>,
    mut block: Option<usize>) -> Option<usize> {
    let mut seen: BTreeSet<usize> = BTreeSet::new();
    while let Some(id) = block {
        if !seen.insert(id) { return None; }
        if let Some(function) = roots.get(&id) { return Some(*function); }
        block = program.blocks.get(id)?.parent;
    }
    None
}

pub(super) fn local_identity(catalog: &Catalog, program: &a::Program, bindings: &BTreeMap<usize, String>,
    function: Option<usize>, target: crate::elaborate::semantic::LocalTarget) -> Option<String> {
    match target {
        crate::elaborate::semantic::LocalTarget::Pattern(pattern) => bindings.get(&pattern).cloned(),
        crate::elaborate::semantic::LocalTarget::Parameter(position) => {
            let function = function?;
            let parameter = program.functions[function].params.get(position)?;
            Some(parameter_identity(&catalog.function_ids[function], &parameter.name, position))
        }
        crate::elaborate::semantic::LocalTarget::Unavailable => None,
    }
}

/// Let-else exports bridge an internal match binding to its continuation.
/// Their path nodes have no source spelling; full capture replay still checks
/// their targets, but source-reference queries must not invent an edit site.
pub(super) fn pattern_export_values(program: &a::Program) -> BTreeSet<usize> {
    let mut result = BTreeSet::new();
    for export in &program.pattern_exports {
        if let a::Expr::Tuple(values) = &program.exprs[export.result].kind {
            for value in values { result.insert(*value); }
        }
    }
    result
}

pub(super) fn generated_locals(catalog: &mut Catalog, files: &[SourceText], program: &a::Program,
    origins: &origins::Origins, bindings: &BTreeMap<usize, String>,
    evidence: &Option<crate::elaborate::semantic::Evidence>) {
    let Some(evidence) = evidence else { return; };
    let mut roots: BTreeMap<usize, usize> = BTreeMap::new();
    for (function, value) in program.functions.iter().enumerate() { if let Some(body) = value.body { roots.insert(body, function); } }
    let synthetic = pattern_export_values(program);
    for (expression, expansion) in &origins.macros.expressions {
        if origins.expressions.contains_key(expression) || !origins.macros.live_expressions.contains(expression)
            || synthetic.contains(expression) { continue; }
        let Some(target) = evidence.locals.get(expression).copied() else { continue; };
        let node = &program.exprs[*expression];
        let a::Expr::Path(_) = &node.kind else { continue; };
        let function = function_owner(program, &roots, node.block);
        let target = local_identity(catalog, program, bindings, function, target);
        generated_reference(catalog, files, &origins::macros::expansion_identity(*expansion), target, node.span, "local-value");
    }
}

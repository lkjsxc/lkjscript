//! Exact spelling sites from resolved AST edges; no textual symbol search.
use super::*;
use crate::elaborate::semantic::{Evidence, LocalTarget, MethodTarget};

pub(super) fn value_identity(program: &a::Program, path: &a::Path, functions: &[String]) -> Option<String> {
    let declaration = path.declaration?;
    let target = declaration_identity(program, declaration, functions)?;
    match program.declarations[declaration].item {
        a::Item::Enum(index) => {
            let name = leaf_name(&path.name);
            for variant in &program.enums[index].variants {
                if variant.name == name { return Some(format!("{}::variant:{}", target, name)); }
            }
            if module_name(&path.name) == target { Some(target) } else { None }
        }
        a::Item::Struct(_) | a::Item::Alias(_) | a::Item::Trait(_) => {
            if module_name(&path.name) == target { Some(target) } else { None }
        }
        _ => Some(target),
    }
}
fn path_token(file: &SourceText, span: a::Span) -> Option<usize> {
    let mut at = path_start(file, span);
    let token = file.tokens.get(at)?;
    if token.kind != 0u8 || token.span.end > span.end ||
        matches!(token.text.as_str(), "for" | "if" | "match" | "let" | "while" | "loop" | "return" | "break" | "fn" | "use") { return None; }
    let mut selected = at; at += 1usize;
    while at < file.tokens.len() && file.tokens[at].span.start < span.end && file.tokens[at].text == "::" {
        at += 1usize;
        let token = file.tokens.get(at)?;
        if token.text == "<" { break; }
        if token.kind != 0u8 || token.span.end > span.end { return None; }
        selected = at; at += 1usize;
    }
    if at < file.tokens.len() && file.tokens[at].span.start < span.end && file.tokens[at].text == "!" { return None; }
    Some(selected)
}
pub(super) fn record_site(result: &mut Catalog, files: &[SourceText], owner: String,
    target: String, span: a::Span, kind: &str, proven: bool) {
    let reference = Reference { owner: owner.clone(), target, file: files[span.file].path.clone(),
        kind: kind.to_string(), start: span.start, end: span.end };
    if proven && span.start < span.end { result.references.push(reference); }
    else {
        if let Some(index) = result.by_identity.get(&owner) { result.items[*index].references_complete = false; }
        result.unresolved.push(reference);
    }
}
pub(super) fn path_reference(result: &mut Catalog, files: &[SourceText], owner: String,
    target: String, span: a::Span, kind: &str, resolver: &resolve::Resolver<'_>, scope: a::ModuleId, type_namespace: bool) {
    let file = &files[span.file];
    if let Some(index) = path_token(file, span) {
        let token = &file.tokens[index];
        let written = written_path(file, span, index);
        let alias = match resolve::semantic_path_alias(resolver, scope, &written, !type_namespace, span) {
            Ok(value) => value,
            Err(_) => {
                record_site(result, files, owner, target, a::Span { file: span.file, ..token.span }, "alias-origin", false);
                return;
            }
        };
        let canonical: Option<String> = result.by_identity.get(&target).map(|index: &usize| -> String { result.items[*index].name.clone() });
        let actual_kind = if alias || canonical.as_ref().is_some_and(|name| *name != token.text) {
            format!("alias-{kind}")
        } else { kind.to_string() };
        record_site(result, files, owner, target, a::Span { file: span.file, ..token.span }, &actual_kind, canonical.is_some());
    } else {
        record_site(result, files, owner, target, a::Span { end: span.start, ..span }, "implicit-source", false);
    }
}
pub(super) fn import_reference(result: &mut Catalog, files: &[SourceText], owner: String,
    target: String, imported: &a::Use, alias: bool) {
    let file = &files[imported.span.file];
    let Some((index, _)) = import_token(file, imported) else {
        record_site(result, files, owner, target, a::Span { end: imported.span.start, ..imported.span }, "implicit-source", false);
        return;
    };
    let token = &file.tokens[index];
    let proven = token.text == leaf_name(&imported.path);
    record_site(result, files, owner, target, a::Span { file: imported.span.file, ..token.span }, if alias { "alias-import" } else { "import" }, proven);
}
fn field_label(file: &SourceText, outer: a::Span, value: a::Span, name: &str) -> Option<(a::Span, bool)> {
    if value.file != outer.file || value.start < outer.start || value.start >= outer.end { return None; }
    let at = token_at(&file.tokens, value.start);
    if at >= 2usize && file.tokens[at - 1usize].text == ":" && file.tokens[at - 2usize].text == name
        && file.tokens[at - 2usize].span.start >= outer.start {
        return Some((a::Span { file: outer.file, ..file.tokens[at - 2usize].span }, false));
    }
    // Shorthand Bind spans retain only the first token. Follow the parser's
    // exact optional ref/mut prefix, then require the field name and delimiter.
    let mut scan = at;
    if scan < file.tokens.len() && file.tokens[scan].text == "ref" { scan += 1usize; }
    if scan < file.tokens.len() && file.tokens[scan].text == "mut" { scan += 1usize; }
    let token = file.tokens.get(scan)?;
    if token.kind != 0u8 || token.text != name || token.span.end > outer.end { return None; }
    if scan == at && token.span.end > value.end { return None; }
    let next = file.tokens.get(scan + 1usize)?;
    if next.span.end > outer.end || !matches!(next.text.as_str(), "," | "}") { return None; }
    Some((a::Span { file: outer.file, ..token.span }, true))
}
fn field_reference(result: &mut Catalog, files: &[SourceText], owner: &str, target: &Option<String>,
    outer: a::Span, value: a::Span, name: &str, pattern: bool) {
    let identity = target.as_ref().map_or_else(|| name.to_string(), |parent| format!("{parent}::field:{name}"));
    let known = result.by_identity.contains_key(&identity);
    match field_label(&files[outer.file], outer, value, name) {
        Some((span, shorthand)) => {
            let kind = if pattern {
                if shorthand { "pattern-field-shorthand" } else { "pattern-field" }
            } else if shorthand { "field-shorthand" } else { "constructor-field" };
            record_site(result, files, owner.to_string(), identity, span, kind, known);
        }
        None => record_site(result, files, owner.to_string(), identity,
            a::Span { end: outer.start, ..outer }, if pattern { "pattern-field" } else { "constructor-field" }, false),
    }
}
pub(super) fn pattern_references(result: &mut Catalog, files: &[SourceText], program: &a::Program, owners: &Owners, resolver: &resolve::Resolver<'_>) {
    for node in &program.patterns {
        let path = match &node.kind {
            a::Pattern::Path(path) | a::Pattern::Variant { path, .. } | a::Pattern::Struct { path, .. } => path,
            _ => continue,
        };
        let Some(owner) = owners.get(&files[node.span.file].path, node.span.start, node.span.end) else { continue; };
        path_qualifications(result, files, program, resolver, &owner, node.scope, node.span);
        let target = value_identity(program, path, &result.function_ids);
        match &target {
            Some(target) => path_reference(result, files, owner.clone(), target.clone(), node.span, "pattern", resolver, node.scope, matches!(node.kind, a::Pattern::Struct { .. })),
            None => record_site(result, files, owner.clone(), path.name.clone(),
                a::Span { end: node.span.start, ..node.span }, "pattern-constructor", false),
        }
        if let a::Pattern::Struct { fields, .. } = &node.kind {
            for (name, pattern) in fields {
                field_reference(result, files, &owner, &target, node.span, program.patterns[*pattern].span, name, true);
            }
        }
    }
}
pub(super) fn constructor_fields(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    owner: &str, node: &a::ExprNode, target: &Option<String>) {
    if let a::Expr::Struct { fields, .. } = &node.kind {
        for (name, expression) in fields {
            field_reference(result, files, owner, target, node.span, program.exprs[*expression].span, name, false);
        }
    }
}
pub(super) fn typed_member(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    evidence: &Evidence, expression: usize, owner: &str) -> bool {
    let node = &program.exprs[expression];
    match &node.kind {
        a::Expr::Method { receiver, name, .. } => {
            let Some(method) = evidence.methods.get(&expression) else { return false; };
            let target = match method {
                MethodTarget::Source(index) => result.function_ids[*index].clone(),
                MethodTarget::Trait(index) => {
                    let trait_value = &program.traits[*index];
                    format!("{}::{}", qualified(&trait_value.module, &trait_value.name), name)
                }
                MethodTarget::Builtin | MethodTarget::BuiltinTrait(_) => return true,
                MethodTarget::InstanceDependent => return false,
            };
            let span = a::Span { start: program.exprs[*receiver].span.end, ..node.span };
            add_reference(result, files, owner.to_string(), target, span, name, "method", true); true
        }
        a::Expr::Field { value, name } => {
            if evidence.builtin_fields.contains(&expression) { return true; }
            let Some(declaration) = evidence.fields.get(&expression) else { return false; };
            let Some(parent) = declaration_identity(program, *declaration, &result.function_ids) else { return false; };
            let target = format!("{parent}::field:{name}");
            let known = result.by_identity.contains_key(&target);
            let span = a::Span { start: program.exprs[*value].span.end, ..node.span };
            add_reference(result, files, owner.to_string(), target, span, name, "field", known); true
        }
        _ => false,
    }
}
pub(super) fn local_reference(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    bindings: &BTreeMap<usize, String>, functions: &BTreeMap<String, usize>, owner: &str,
    node: &a::ExprNode, name: &str, target: LocalTarget) {
    let identity = match target {
        LocalTarget::Pattern(pattern) => bindings.get(&pattern).cloned(),
        LocalTarget::Parameter(position) => functions.get(&owner.to_string()).and_then(|function| {
            program.functions[*function].params.get(position).map(|parameter| parameter_identity(owner, &parameter.name, position))
        }),
        LocalTarget::Unavailable => None,
    };
    match identity {
        Some(identity) => add_reference(result, files, owner.to_string(), identity, node.span, name, "local-value", true),
        None => add_reference(result, files, owner.to_string(), name.to_string(), node.span, name, "local-origin", false),
    }
}

fn written_path(file: &SourceText, span: a::Span, last: usize) -> String {
    let mut at = path_start(file, span);
    let mut result = String::new();
    while at <= last && at < file.tokens.len() { result.push_str(&file.tokens[at].text); at += 1usize; }
    result
}

fn qualification_site(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, owner: &str, scope: a::ModuleId, prefix: &str, span: a::Span, spelling: &str) {
    if matches!(spelling, "crate" | "self" | "super" | "Self") { return; }
    // Only an exact following identifier proves that this spelling occupies
    // a namespace role. Grouped self, glob and turbofish prefixes do not.
    let namespace = namespace_following(&files[span.file], span);
    let unresolved = if namespace { "unresolved-namespace-qualification" } else { "unresolved-qualification" };
    match resolve::semantic_type_path(resolver, scope, prefix, span) {
        Ok(path) => {
            let Some(declaration) = path.declaration else {
                let kind = if namespace { "intrinsic-qualification" } else { unresolved };
                record_site(result, files, owner.to_string(), prefix.to_string(), span, kind, false);
                return;
            };
            let Some(target) = declaration_identity(program, declaration, &result.function_ids) else {
                record_site(result, files, owner.to_string(), prefix.to_string(), span, unresolved, false);
                return;
            };
            if module_name(&path.name) != target {
                let kind = if namespace { "associated-qualification" } else { unresolved };
                record_site(result, files, owner.to_string(), prefix.to_string(), span, kind, false);
                return;
            }
            let canonical: Option<String> = result.by_identity.get(&target).map(|index: &usize| -> String { result.items[*index].name.clone() });
            let alias = match resolve::semantic_path_alias(resolver, scope, prefix, false, span) {
                Ok(value) => value,
                Err(_) => { record_site(result, files, owner.to_string(), target, span, "alias-origin", false); return; }
            };
            let kind = if alias || canonical.as_ref().is_some_and(|name| *name != spelling) { "alias-qualification" } else { "qualification" };
            record_site(result, files, owner.to_string(), target, span, kind, canonical.is_some());
        }
        Err(_) => {
            // The standard-library root has no source item. A local declaration
            // called std would have resolved above and remains a real reference.
            if prefix != "std" {
                record_site(result, files, owner.to_string(), prefix.to_string(), span, unresolved, false);
            }
        }
    }
}

pub(super) fn path_qualifications(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>, owner: &str, scope: a::ModuleId, span: a::Span) {
    let file = &files[span.file];
    let mut at = path_start(file, span);
    let mut prefix = String::new();
    while at < file.tokens.len() {
        let token = &file.tokens[at];
        if token.span.end > span.end || token.kind != 0u8 { break; }
        if !prefix.is_empty() { prefix.push_str("::"); }
        prefix.push_str(&token.text);
        if at + 2usize >= file.tokens.len() || file.tokens[at + 1usize].text != "::" ||
            file.tokens[at + 2usize].kind != 0u8 || file.tokens[at + 2usize].span.end > span.end { break; }
        qualification_site(result, files, program, resolver, owner, scope, &prefix,
            a::Span { file: span.file, ..token.span }, &token.text);
        at += 2usize;
    }
}

pub(super) fn import_qualifications(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    resolver: &resolve::Resolver<'_>) {
    // One scan per use tree, retaining inherited group prefixes. Each Use span
    // starts at the same use keyword and ends at its particular leaf or alias.
    let mut trees: BTreeMap<(usize, usize), (usize, a::ModuleId, String)> = BTreeMap::new();
    let mut self_values: BTreeSet<(usize, usize)> = BTreeSet::new();
    for imported in &program.uses {
        let scope = resolve::module(program, &imported.module);
        if !imported.glob {
            if let Some((at, inherited)) = import_token(&files[imported.span.file], imported) {
                let token = &files[imported.span.file].tokens[at];
                if inherited && token.text == leaf_name(&imported.path)
                    && resolve::semantic_type_path(resolver, scope, &imported.path, imported.span).is_err() {
                    let path = a::Path { declaration: None, name: imported.path.clone(), args: Vec::new() };
                    if let Ok(resolved) = resolver.value_path(scope, &path, imported.span) {
                        if let Some(target) = value_identity(program, &resolved, &result.function_ids) {
                            if result.by_identity.contains_key(&target) {
                                // import_reference publishes this exact value binding.
                                // It is not an unresolved type-namespace prefix.
                                self_values.insert((imported.span.file, token.span.start));
                            }
                        }
                    }
                }
            }
        }
        let key = (imported.span.file, imported.span.start);
        if trees.contains_key(&key) {
            let tree = trees.get_mut(&key).unwrap(); tree.0 = tree.0.max(imported.span.end);
        } else { trees.insert(key, (imported.span.end, scope, root_parent(&imported.module))); }
    }
    for ((file_id, start), (end, scope, owner)) in trees {
        let file = &files[file_id];
        let mut at = token_at(&file.tokens, start);
        if at < file.tokens.len() && file.tokens[at].text == "use" { at += 1usize; }
        let mut prefix = String::new();
        let mut groups: Vec<String> = Vec::new();
        while at < file.tokens.len() && file.tokens[at].span.start < end {
            let token = &file.tokens[at];
            match token.text.as_str() {
                "{" => { groups.push(prefix.clone()); at += 1usize; continue; }
                "}" => { groups.pop(); prefix = groups.last().cloned().unwrap_or(String::new()); at += 1usize; continue; }
                "," => { prefix = groups.last().cloned().unwrap_or(String::new()); at += 1usize; continue; }
                "as" => { at += 2usize; continue; }
                "::" | "*" => { at += 1usize; continue; }
                _ => {}
            }
            if token.kind != 0u8 { at += 1usize; continue; }
            if !(token.text == "self" && !prefix.is_empty()) {
                if !prefix.is_empty() { prefix.push_str("::"); }
                prefix.push_str(&token.text);
            }
            if at + 1usize < file.tokens.len() && file.tokens[at + 1usize].text == "::"
                && !self_values.contains(&(file_id, token.span.start)) {
                qualification_site(result, files, program, resolver, &owner, scope, &prefix,
                    a::Span { file: file_id, ..token.span }, &token.text);
            }
            at += 1usize;
        }
    }
}

pub(super) fn visibility_qualifications(result: &mut Catalog, files: &[SourceText], owners: &Owners) {
    // Visibility paths resolve by ancestor scope rather than use aliases.
    // Until that relation is retained, expose the exact missing sites.
    for (file_id, file) in files.iter().enumerate() {
        let mut at = 0usize;
        while at + 3usize < file.tokens.len() {
            if file.tokens[at].text != "pub" || file.tokens[at + 1usize].text != "(" ||
                file.tokens[at + 2usize].text != "in" { at += 1usize; continue; }
            let owner = owners.get(&file.path, file.tokens[at].span.start, file.tokens[at].span.end);
            at += 3usize;
            while at < file.tokens.len() && file.tokens[at].text != ")" {
                let token = &file.tokens[at];
                if token.kind == 0u8 && !matches!(token.text.as_str(), "crate" | "self" | "super") {
                    if let Some(owner) = &owner {
                        record_site(result, files, owner.clone(), token.text.clone(),
                            a::Span { file: file_id, ..token.span }, "visibility-qualification", false);
                    }
                }
                at += 1usize;
            }
        }
    }
}

fn path_start(file: &SourceText, span: a::Span) -> usize {
    let mut at = token_at(&file.tokens, span.start);
    // The iterative type parser retains the outer reference's diagnostic span
    // on its inner Path. Recover only the exact parsed reference prefix.
    while at < file.tokens.len() && file.tokens[at].span.start < span.end
        && matches!(file.tokens[at].text.as_str(), "&" | "&&") {
        at += 1usize;
        if at < file.tokens.len() && file.tokens[at].kind == 5u8 { at += 1usize; }
        if at < file.tokens.len() && file.tokens[at].text == "mut" { at += 1usize; }
    }
    if at < file.tokens.len() && file.tokens[at].text == "::" { at += 1usize; }
    at
}

fn import_token(file: &SourceText, imported: &a::Use) -> Option<(usize, bool)> {
    let start = token_at(&file.tokens, imported.span.start);
    let end = token_at(&file.tokens, imported.span.end);
    if end <= start { return None; }
    let mut at = end - 1usize;
    if at >= start + 2usize && file.tokens[at - 1usize].text == "as" { at -= 2usize; }
    if file.tokens[at].text != "self" { return Some((at, false)); }
    // A flattened self leaf inherits the last real identifier of its parsed
    // prefix. Walk only enclosing use groups, balancing completed siblings.
    loop {
        if at >= start + 2usize && file.tokens[at - 1usize].text == "::" {
            at -= 2usize;
            let token = &file.tokens[at];
            if token.kind != 0u8 { return None; }
            if token.text == "self" { continue; }
            if matches!(token.text.as_str(), "crate" | "super" | "Self") { return None; }
            return Some((at, true));
        }
        let mut depth = 0usize;
        let mut scan = at;
        let mut group = None;
        while scan > start {
            scan -= 1usize;
            match file.tokens[scan].text.as_str() {
                "}" => depth += 1usize,
                "{" => {
                    if depth == 0usize { group = Some(scan); break; }
                    depth -= 1usize;
                }
                _ => {}
            }
        }
        at = group?;
    }
}

fn namespace_following(file: &SourceText, span: a::Span) -> bool {
    let at = token_at(&file.tokens, span.start);
    at + 2usize < file.tokens.len()
        && file.tokens[at].span.start == span.start
        && file.tokens[at].span.end == span.end
        && file.tokens[at + 1usize].text == "::"
        && file.tokens[at + 2usize].kind == 0u8
        && file.tokens[at + 2usize].text != "self"
}

pub(super) fn untyped_local(program: &a::Program, bindings: &BTreeMap<(String, String), usize>,
    function: usize, owner: &str, name: &str, span: a::Span) -> Option<LocalTarget> {
    // The caller selected this exact innermost declaration through Owners.
    // A nested function has its own environment; other item owners cannot call
    // this fallback. This proves lexical identity only, never an inferred type.
    let function = &program.functions[function];
    let body = &program.blocks[function.body?];
    if span.file != body.span.file || span.start < body.span.start || span.end > body.span.end { return None; }
    let count = bindings.get(&(owner.to_string(), name.to_string())).copied().unwrap_or(0usize);
    let mut parameter = None;
    for (index, value) in function.params.iter().enumerate() {
        if value.name != name { continue; }
        if parameter.is_some() { return None; }
        parameter = Some(index);
    }
    if count == 0usize { return parameter.map(|position: usize| LocalTarget::Parameter(position)); }
    // All patterns, including closure parameters, contribute to count. Even a
    // shadow in an unrelated branch leaves the exact binding unproved here.
    if count != 1usize || parameter.is_some() { return None; }
    for statement in &body.statements {
        let a::Stmt::Let { pattern, span: declaration, .. } = statement else { continue; };
        let a::Pattern::Bind { name: binding, .. } = &program.patterns[*pattern].kind else { continue; };
        if binding == name && declaration.file == span.file && declaration.end <= span.start {
            return Some(LocalTarget::Pattern(*pattern));
        }
    }
    None
}

pub(super) fn self_constructor(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    function: usize, owner: &str, node: &a::ExprNode) -> Option<(String, String)> {
    // Self is bound by the resolved method owner, never by enclosing text.
    let a::FunctionOwner::Implementation(implementation) = program.function_owner(a::FunctionId { index: function }) else { return None; };
    let a::Type::Path(receiver) = &program.types[program.impls[implementation.index].target].kind else { return None; };
    let declaration = receiver.declaration?;
    if !matches!(program.declarations[declaration].item, a::Item::Struct(_)) { return None; }
    let target = declaration_identity(program, declaration, &result.function_ids)?;
    let span = path_token(&files[node.span.file], node.span).and_then(|index| {
        let token = &files[node.span.file].tokens[index];
        if token.text == "Self" { Some(a::Span { file: node.span.file, ..token.span }) } else { None }
    });
    match span {
        Some(span) => record_site(result, files, owner.to_string(), target.clone(), span, "alias-constructor", true),
        None => record_site(result, files, owner.to_string(), target.clone(),
            a::Span { end: node.span.start, ..node.span }, "implicit-source", false),
    }
    Some((target, type_name(program, program.impls[implementation.index].target)))
}

pub(super) fn typed_associated(result: &mut Catalog, files: &[SourceText], program: &a::Program,
    evidence: &Evidence, expression: usize, owner: &str, closed_owner: bool) -> bool {
    let node = &program.exprs[expression];
    let a::Expr::Path(path) = &node.kind else { return false; };
    let Some(selection) = evidence.methods.get(&expression) else { return false; };
    let name = leaf_name(&path.name);
    let source = match selection {
        MethodTarget::Source(index) if closed_owner => Some(*index),
        MethodTarget::Trait(index) => {
            let mut selected: Option<usize> = None;
            for method in &program.traits[*index].methods {
                let function = &program.functions[*method];
                if function.name == name && function.params.first().is_none_or(|parameter| parameter.name != "self") {
                    if selected.is_some() { return false; }
                    selected = Some(*method);
                }
            }
            selected
        }
        _ => None,
    };
    let Some(source) = source else {
        add_reference(result, files, owner.to_string(), path.name.clone(), node.span, name, "associated-function", false);
        return true;
    };
    let target = result.function_ids[source].clone();
    // The owner may be an alias; only the selector's exact member token is edited.
    // The ordinary prefix references retain that owner's independent provenance.
    let token = path_token(&files[node.span.file], node.span).map(|index| &files[node.span.file].tokens[index]);
    if let Some(token) = token {
        if token.text == program.functions[source].name && result.by_identity.contains_key(&target) {
            record_site(result, files, owner.to_string(), target,
                a::Span { file: node.span.file, ..token.span }, "associated-call", true);
            return true;
        }
    }
    record_site(result, files, owner.to_string(), target,
        a::Span { end: node.span.start, ..node.span }, "implicit-source", false);
    true
}

    fn readiness_unwatch_listener(&mut self, _readiness: u64, _handle: u64) -> Result<(), i64> { Err(38) }
    fn readiness_wait(&mut self, _readiness: u64, _deadline_ns: usize) -> Result<Vec<(usize, u8)>, i64> { self.0.push(b'W'); Err(38) }
    fn connect_socket(&mut self, _address: &[u8]) -> Result<u64, i64> {
        self.0.push(b'N');
        Err(38)
    }
    fn open_listener(&mut self, _address: &[u8]) -> Result<u64, i64> {
        self.0.push(b'L');
        Err(38)
    }
    fn accept_listener(&mut self, _listener: u64) -> Result<u64, i64> {
        Err(38)
    }
    fn accept_listener_nodelay(&mut self, _listener: u64) -> Result<u64, i64> {
        Err(38)
    }
    fn listener_address(&mut self, _listener: u64, _bytes: &mut [u8]) -> Result<(), i64> {
        Err(38)
    }
    fn open_subdirectory(&mut self, _directory: u64, _path: &[u8]) -> Result<u64, i64> {
        Err(38)
    }
    fn read_directory(&mut self, _directory: u64, _bytes: &mut [u8]) -> Result<usize, i64> {
        Err(38)
    }
    fn rewind_handle(&mut self, _handle: u64) -> Result<(), i64> {
        Err(38)
    }
    fn create_directory(&mut self, _directory: u64, _name: &[u8]) -> Result<(), i64> {
        Err(38)
    }
    fn remove_entry(
        &mut self,
        _directory: u64,
        _name: &[u8],
        _is_directory: bool,
    ) -> Result<(), i64> {
        Err(38)
    }
    fn rename_entry(
        &mut self,
        _from: u64,
        _old_name: &[u8],
        _to: u64,
        _new_name: &[u8],
    ) -> Result<(), i64> {
        Err(38)
    }
    fn file_seal(&mut self, _file: u64) -> Result<(), i64> { Err(38) }
    fn file_executable(&mut self, _file: u64) -> Result<(), i64> {
        Err(38)
    }
    fn monotonic_time(&mut self, _bytes: &mut [u8]) -> Result<(), i64> {
        Err(38)
    }
    fn spawn_process(
        &mut self,
        _executable: u64,
        _arguments: &[u8],
        _stdin: u64,
        _stdout: u64,
        _stderr: u64,
        _result: u64,
    ) -> Result<u64, i64> {
        self.0.push(b'B'); Ok(4)
    }
    fn wait_process(&mut self, _child: u64, _nonblocking: bool) -> Result<Option<i64>, i64> {
        Err(38)
    }
    fn terminate_process(&mut self, _child: u64) -> Result<(), i64> {
        Err(38)
    }
    fn drop_process(&mut self, child: u64) { assert_eq!(child, 4u64); self.0.push(b'b'); }

    fn write_stdout(&mut self, bytes: &[u8]) -> Result<(), i64> {
        if !self.0.is_empty() {
            return Err(5);
        }
        self.0.extend_from_slice(bytes);
        Ok(())
    }
}

fn model_host_failure_keeps_previous_output_and_has_its_own_trap_kind() {
    let mut host = FailingHost(Vec::<u8>::new());
    let error = run_output("pub fn main(mut world:World){let mut out=world.stdout();out.write(\"a\".as_bytes());out.write(\"b\".as_bytes());}", &mut host).err().expect("expected a interpreter failure");
    assert!(error.kind == ErrorKind::Trap(7), "{}", error.message);
    assert_eq!(host.0, "a".as_bytes().to_vec());
    let failure = error.host.unwrap();
    assert_eq!(failure.identity[..failure.length], b"Stdout 1"[..]);
    assert_eq!(failure.errno, 5i64);
    assert_eq!(failure.operation, 1u64);
}

fn conditional_projected_drop_clears_moves_while_strict_drop_rejects_repeated_destruction() {
    let types = vec![
        ir::Type {
            name: "Box".to_string(),
            kind: ir::TypeKind::Box { inner: ir::I64 },
        },
        ir::Type {
            name: "Pair".to_string(),
            kind: ir::TypeKind::Struct {
                fields: vec![ir::Field {
                    name: "left".to_string(),
                    ty: 7,
                }],
                copy: false,
            },
        },
    ];
    let field = ir::Place {
        local: 2,
        projections: vec![ir::Projection::Field(0)],
    };
    let mut ops = vec![
        ir::Op::Int { dst: 0, value: 1 },
        ir::Op::Intrinsic {
            dst: 1,
            name: ir::IntrinsicOp::BoxNew,
            args: vec![0],
        },
        ir::Op::Struct {
            dst: 2,
            fields: vec![1],
        },
        ir::Op::Read {
            dst: 6,
            place: field.clone(),
            moving: true,
        },
        ir::Op::DropIf {
            place: field.clone(),
        },
        ir::Op::Int { dst: 3, value: 2 },
        ir::Op::Intrinsic {
            dst: 4,
            name: ir::IntrinsicOp::BoxNew,
            args: vec![3],
        },
        ir::Op::Assign {
            place: field.clone(),
            src: 4,
        },
        ir::Op::Drop {
            place: field.clone(),
        },
    ];
    let mut forged = ops.clone();
    forged.push(ir::Op::Drop { place: field });
    fails(
        raw(
            types.clone(),
            &[ir::I64, 7, 8, ir::I64, 7, ir::UNIT, 7],
            ir::UNIT,
            forged,
        ),
        InterpreterError::DoubleDrop,
    );
    for op in vec![
        drop_local(6),
        drop_local(2),
        ir::Op::Unit { dst: 5 },
        ir::Op::Return { src: 5 },
    ] {
        ops.push(op);
    }
    let valid = raw(
        types,
        &[ir::I64, 7, 8, ir::I64, 7, ir::UNIT, 7],
        ir::UNIT,
        ops,
    );
    assert!(
        must_run(crate::semantic_tests::residual::observed_run(
            &valid,
            0,
            &[0u64; 0],
            &mut Vec::<u8>::new(),
        ))
        .value
            == Scalar::Unit
    );
}

fn model_checks_signed_minimum_overflow_and_invalid_raw_integer_widths() {
    let cases: Vec<(String, u64)> = vec![
        ("fn probe(x:i8)->i8{-x}".to_string(), (-128i64) as u64),
        (
            "fn probe(x:i16)->i16{x / -1i16}".to_string(),
            (-32768i64) as u64,
        ),
        (
            "fn probe(x:i32)->i32{x % -1i32}".to_string(),
            (-2147483648i64) as u64,
        ),
        (
            "fn probe(x:i64)->i64{x / -1i64}".to_string(),
            (-9223372036854775808i64) as u64,
        ),
    ];
    for (text, argument) in cases {
        assert!(
            execute(&text, "probe", &[argument])
                .err()
                .expect("expected a interpreter failure")
                .kind
                == ErrorKind::Trap(1)
        );
    }
    fails(
        raw(
            vec![ir::Type {
                name: "invalid".to_string(),
                kind: ir::TypeKind::Int {
                    bits: 0,
                    signed: true,
                },
            }],
            &[7],
            7,
            vec![ir::Op::Int { dst: 0, value: 0 }],
        ),
        InterpreterError::InvalidIr,
    );
}

fn read_program(text: &str) -> ir::Program {
    crate::ir_text::read(text)
        .unwrap_or_else(|problem| panic!("{}: {}", problem.code, problem.message))
}
fn strict_and_conditional_drops_have_independent_static_and_dynamic_checks() {
    let accepted = read_program(include_str!(
        "../../tests/conformance/ir/drop_if_owned.lkjir"
    ));
    crate::check::check(accepted.clone())
        .unwrap_or_else(|problem| panic!("{}: {}", problem.code, problem.message));
    assert!(
        must_run(crate::semantic_tests::residual::observed_run(
            &accepted,
            0,
            &[0u64; 0],
            &mut Vec::<u8>::new(),
        ))
        .value
            == Scalar::Int {
                value: 42,
                bits: 64,
                signed: true,
            }
    );
    let cases: Vec<(String, String, InterpreterError, String)> = vec![
        (
            include_str!("../../tests/conformance/ir/double_projected_drop.lkjir").to_string(),
            "E_MOVE".to_string(),
            InterpreterError::DoubleDrop,
            "pair.left".to_string(),
        ),
        (
            include_str!("../../tests/conformance/ir/drop_after_projected_move.lkjir").to_string(),
            "E_MOVE".to_string(),
            InterpreterError::DoubleDrop,
            "pair.left".to_string(),
        ),
        (
            include_str!("../../tests/conformance/ir/drop_if_absent_ancestor.lkjir").to_string(),
            "E_MOVE".to_string(),
            InterpreterError::UseAfterMove,
            "outer.*".to_string(),
        ),
        (
            include_str!("../../tests/conformance/ir/drop_if_borrowed_owner.lkjir").to_string(),
            "E_BORROW".to_string(),
            InterpreterError::UseAfterMove,
            "slot.*".to_string(),
        ),
        (
            include_str!("../../tests/conformance/ir/drop_if_indexed_owner.lkjir").to_string(),
            "E_BORROW".to_string(),
            InterpreterError::UseAfterMove,
            "array[index]".to_string(),
        ),
    ];
    for (text, code, fault, place) in cases {
        let raw = read_program(&text);
        let problem = crate::check::check(raw.clone())
            .err()
            .expect("forged drop passed the checker");
        assert_eq!(problem.code, code);
        assert!(problem.message.contains(&place), "{}", problem.message);
        fails(raw, fault);
    }
}

fn shared_reference_copy_keeps_real_carrier_and_exclusive_parent_conflicts() {
    let cases: Vec<(String, usize)> = vec![
        (
            include_str!("../../tests/conformance/ir/borrowed_reference_carrier_drop.lkjir")
                .to_string(),
            6,
        ),
        (
            include_str!("../../tests/conformance/ir/shared_reborrow_parent_write.lkjir")
                .to_string(),
            9,
        ),
    ];
    for (text, line) in cases {
        let program = crate::ir_text::read(&text).unwrap();
        let diagnostic = crate::check::check(program.clone()).err().unwrap();
        assert_eq!(diagnostic.code, "E_BORROW");
        let error = crate::semantic_tests::residual::observed_run(&program, 0, &[0u64; 0], &mut Vec::<u8>::new())
            .err()
            .unwrap();
        assert!(
            error.kind == ErrorKind::Interpreter(InterpreterError::ConflictingAccess),
            "{}",
            error.message
        );
        assert_eq!(error.line, line);
    }
}

fn range_views_validate_types_loans_and_utf8_without_the_checker() {
    let cases: Vec<(String, ErrorKind)> = vec![
        (
            include_str!("../../tests/conformance/ir/range_wrong_bound.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::InvalidIr),
        ),
        (
            include_str!("../../tests/conformance/ir/range_wrong_source.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::InvalidIr),
        ),
        (
            include_str!("../../tests/conformance/ir/range_wrong_element.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::InvalidIr),
        ),
        (
            include_str!("../../tests/conformance/ir/range_immutable_mut.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::ConflictingAccess),
        ),
        (
            include_str!("../../tests/conformance/ir/range_consumed_bound.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::DoubleDrop),
        ),
        (
            include_str!("../../tests/conformance/ir/range_live_owner_drop.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::ConflictingAccess),
        ),
        (
            include_str!("../../tests/conformance/ir/range_owner_write.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::ConflictingAccess),
        ),
        (
            include_str!("../../tests/conformance/ir/range_mutable_text.lkjir").to_string(),
            ErrorKind::Interpreter(InterpreterError::InvalidIr),
        ),
        (
            include_str!("../../tests/conformance/ir/range_end_past.lkjir").to_string(),
            ErrorKind::Trap(3),
        ),
        (
            include_str!("../../tests/conformance/ir/range_utf8_start.lkjir").to_string(),
            ErrorKind::Trap(3),
        ),
    ];
    for (text, expected) in cases {
        let program = crate::ir_text::read(&text).unwrap();
        let error = crate::semantic_tests::residual::observed_run(&program, 0, &[0u64; 0], &mut Vec::<u8>::new())
            .err()
            .unwrap();
        assert!(
            error.kind == expected,
            "{}: {}",
            error.code(),
            error.message
        );
    }
}

fn temporary_files_intrinsics_reject_selector_and_wrong_authority() {
    let checked = compiled("fn main(mut storage: TemporaryFiles) { let _file = storage.temporary_file(); }");
    let entry = function_index(checked.program(), "main");
    let grants = vec![ir::EntryGrant::TemporaryFiles];
    let mut host = FailingHost(Vec::new());
    crate::semantic_tests::residual::observed_run_granted(checked.program(), entry, &grants, &mut host).unwrap();
    assert_eq!(host.0.as_slice(), b"FC");

    // Even selector zero is invalid on the narrow receiver. Selectors 1..4 must
    // never reach inherited streams or the running executable in the host.
    for selector in 0u8..5u8 {
        let mut program = checked.program().clone();
        let function = &mut program.functions[entry];
        let selector_local = function.locals.len();
        function.locals.push(ir::Local {
            name: "forged selector".to_string(), ty: ir::U8, mutable: false,
        });
        let mut body = Vec::new();
        let mut changed = 0usize;
        for instruction in &function.body {
            if let ir::Op::Intrinsic { dst, name, args } = &instruction.op {
                if *name == ir::IntrinsicOp::WorldFile {
                    let mut selected = args.clone();
                    selected.push(selector_local);
                    body.push(ir::Instruction {
                        op: ir::Op::Int { dst: selector_local, value: selector as i64 },
                        file: instruction.file, line: instruction.line, column: instruction.column,
                    });
                    let mut altered = instruction.clone();
                    altered.op = ir::Op::Intrinsic { dst: *dst, name: *name, args: selected };
                    body.push(altered);
                    changed += 1;
                    continue;
                }
            }
            body.push(instruction.clone());
        }
        function.body = body;
        assert_eq!(changed, 1usize);
        assert_eq!(crate::check::check(program.clone()).err().unwrap().code, "E_TYPE");
        let mut host = FailingHost(Vec::new());
        // Deliberately bypass the checker: dynamic authority is independently enforced.
        let failure = crate::semantic_tests::residual::observed_run_granted(&program, entry, &grants, &mut host).err().unwrap();
        assert!(failure.kind == ErrorKind::Interpreter(InterpreterError::InvalidIr), "{}", failure.message);
        assert!(host.0.is_empty(), "selector reached a host operation");
    }

    for mode in 0usize..2usize {
        let mut program = checked.program().clone();
        let grant = if mode == 0 {
            for index in 0usize..program.types.len() {
                if matches!(program.types[index].kind, ir::TypeKind::TemporaryFiles) {
                    program.types[index].kind = ir::TypeKind::Clock;
                }
            }
            ir::EntryGrant::Clock
        } else {
            for index in 0usize..program.functions[entry].body.len() {
                if let ir::Op::Intrinsic { name, args, .. } = &mut program.functions[entry].body[index].op {
                    if *name == ir::IntrinsicOp::WorldFile { args.clear(); }
                }
            }
            ir::EntryGrant::TemporaryFiles
        };
        assert_eq!(crate::check::check(program.clone()).err().unwrap().code, "E_TYPE");
        let mut host = FailingHost(Vec::new());
        let failure = crate::semantic_tests::residual::observed_run_granted(&program, entry, &[grant], &mut host).err().unwrap();
        let expected = if mode == 0 { InterpreterError::InvalidIr } else { InterpreterError::Unsupported };
        assert!(failure.kind == ErrorKind::Interpreter(expected), "{}", failure.message);
        assert!(host.0.is_empty(), "wrong authority or arity reached a host operation");
    }
}

fn storage_intrinsics_validate_before_host_effects() {
    let cases = vec![
        ("fn main(mut world: World) { let mut directory = world.directory(\".\").unwrap(); let _result = directory.create_new(\"record\"); }".to_string(), ir::IntrinsicOp::DirectoryCreateNew, b'O'),
        ("fn main(mut world: World) { let mut directory = world.directory(\".\").unwrap(); let _result = directory.open_append(\"record\"); }".to_string(), ir::IntrinsicOp::DirectoryOpenAppend, b'O'),
        ("fn main(mut world: World) { let mut directory = world.directory(\".\").unwrap(); let _result = directory.sync(); }".to_string(), ir::IntrinsicOp::DirectorySync, b'S'),
        ("fn main(mut world: World) { let mut file = world.temporary_file().unwrap(); let _result = file.sync(); }".to_string(), ir::IntrinsicOp::FileSync, b'S'),
        ("fn main(mut world: World) { let mut file = world.temporary_file().unwrap(); let _result = file.truncate(4usize); }".to_string(), ir::IntrinsicOp::FileTruncate, b'T'),
        ("fn main(mut world: World) { let mut file = world.temporary_file().unwrap(); let _result = file.lock_exclusive(); }".to_string(), ir::IntrinsicOp::FileLockExclusive, b'L'),
    ];
    for (source, operation, marker) in cases {
        let checked = compiled(&source);
        let entry = function_index(checked.program(), "main");
        let mut host = FailingHost(Vec::new());
        crate::semantic_tests::residual::observed_run(checked.program(), entry, &[0u64; 0], &mut host).unwrap();
        assert!(host.0.contains(&marker));
        for mode in 0usize..4usize {
            let mut program = checked.program().clone();
            let mut result = 0usize;
            let mut changed = 0usize;
            for function_index in 0usize..program.functions.len() {
                let function = &mut program.functions[function_index];
                for instruction_index in 0usize..function.body.len() {
                    if let ir::Op::Intrinsic { dst, name, args } = &mut function.body[instruction_index].op {
                        if *name == operation {
                            result = function.locals[*dst].ty;
                            if mode == 2 { args.pop(); }
                            if mode == 3 {
                                if args.len() == 2 {
                                    let first = args[0];
                                    args[0] = args[1];
                                    args[1] = first;
                                }
                                else {
                                    *name = if operation == ir::IntrinsicOp::DirectorySync {
                                        ir::IntrinsicOp::FileSync
                                    } else { ir::IntrinsicOp::DirectorySync };
                                }
                            }
                            changed += 1;
                        }
                    }
                }
            }
            assert_eq!(changed, 1usize);
            if mode < 2 {
                if let ir::TypeKind::Enum { variants, .. } = &mut program.types[result].kind {
                    if mode == 0 { variants[0].fields[0].ty = ir::U8; }
                    else { variants[1].fields[0].ty = ir::U64; }
                }
            }
            assert_eq!(crate::check::check(program.clone()).err().unwrap().code, "E_TYPE");
            let mut host = FailingHost(Vec::new());
            let error = crate::semantic_tests::residual::observed_run(&program, entry, &[0u64; 0], &mut host).err().unwrap();
            assert!(error.kind == ErrorKind::Interpreter(InterpreterError::InvalidIr), "{}", error.message);
            assert!(!host.0.contains(&marker));
        }
    }
}

fn lifecycle_intrinsics_validate_before_host_effects() {
    let cases = vec![
        ("fn main(mut world: World) { let mut entropy = world.entropy(); let mut bytes = [0u8; 1]; let _result = entropy.fill(&mut bytes); }".to_string(), ir::IntrinsicOp::WorldEntropy, b'E'),
        ("fn main(mut world: World) { let mut entropy = world.entropy(); let mut bytes = [0u8; 1]; let _result = entropy.fill(&mut bytes); }".to_string(), ir::IntrinsicOp::EntropyFill, b'E'),
        ("fn main(mut world: World) { let mut clock = world.clock(); let _result = clock.unix_seconds(); }".to_string(), ir::IntrinsicOp::ClockUnixSeconds, b'K'),
        ("fn main(mut world: World) { let mut file = world.temporary_file().unwrap(); let _result = file.set_private(); }".to_string(), ir::IntrinsicOp::FileSetPrivate, b'P'),
        ("fn main(mut world: World) { let _result = world.stop(); }".to_string(), ir::IntrinsicOp::WorldStop, b'Q'),
        ("fn main(mut world: World) { let mut stop = world.stop().unwrap(); let _result = stop.requested(); }".to_string(), ir::IntrinsicOp::StopRequested, b'J'),
        ("fn main(mut world: World) { let mut stop = world.stop().unwrap(); let _result = stop.target(); }".to_string(), ir::IntrinsicOp::StopTarget, b'I'),
        ("fn main(mut world: World) { let mut ready = world.readiness().unwrap(); let mut stop = world.stop().unwrap(); let _result = ready.watch_stop(&mut stop, 3usize); }".to_string(), ir::IntrinsicOp::ReadinessWatchStop, b'w'),
        ("fn main(mut world: World) { let mut ready = world.readiness().unwrap(); let mut stop = world.stop().unwrap(); let _result = ready.unwatch_stop(&mut stop); }".to_string(), ir::IntrinsicOp::ReadinessUnwatchStop, b'u'),
        ("fn main(mut world: World) { let mut directory = world.directory(\".\").unwrap(); let _result = directory.create_private(\"key\"); }".to_string(), ir::IntrinsicOp::DirectoryCreatePrivate, b'V'),
        ("fn main(mut world: World) { let mut process = world.process(); let file = world.temporary_file().unwrap(); let args: Vec<Vec<u8>> = Vec::new(); let mut child = process.spawn_file(&file, &args, &file, &file, &file, &file).unwrap(); let _result = child.request_stop(); }".to_string(), ir::IntrinsicOp::ChildRequestStop, b'G'),
    ];
    for (source, operation, marker) in cases {
        let checked = compiled(&source);
        let entry = function_index(checked.program(), "main");
        let mut host = FailingHost(Vec::new());
        crate::semantic_tests::residual::observed_run(checked.program(), entry, &[0u64; 0], &mut host).unwrap();
        assert!(host.0.contains(&marker));
        for mode in 0usize..4usize {
            if operation == ir::IntrinsicOp::WorldEntropy && mode == 1 { continue; }
            let mut program = checked.program().clone();
            let mut result = 0usize;
            let mut changed = 0usize;
            for function_index in 0usize..program.functions.len() {
                let function = &mut program.functions[function_index];
                for instruction_index in 0usize..function.body.len() {
                    if let ir::Op::Intrinsic { dst, name, args } = &mut function.body[instruction_index].op {
                        if *name == operation {
                            result = function.locals[*dst].ty;
                            if mode == 2 { args.pop(); }
                            if mode == 3 {
                                if args.len() >= 2 {
                                    let first = args[0]; args[0] = args[1]; args[1] = first;
                                } else { *name = ir::IntrinsicOp::DirectorySync; }
                            }
                            changed += 1;
                        }
                    }
                }
            }
            assert_eq!(changed, 1usize);
            if mode < 2 {
                if operation == ir::IntrinsicOp::WorldEntropy {
                    program.types[result].kind = ir::TypeKind::Bool;
                } else if let ir::TypeKind::Enum { variants, .. } = &mut program.types[result].kind {
                    if mode == 0 { variants[0].fields[0].ty = ir::U8; }
                    else { variants[1].fields[0].ty = ir::U64; }
                }
            }
            assert_eq!(crate::check::check(program.clone()).err().unwrap().code, "E_TYPE");
            let mut host = FailingHost(Vec::new());
            let error = crate::semantic_tests::residual::observed_run(&program, entry, &[0u64; 0], &mut host).err().unwrap();
            assert!(error.kind == ErrorKind::Interpreter(InterpreterError::InvalidIr), "{}", error.message);
            assert!(!host.0.contains(&marker));
        }
    }
    // A failed random fill preserves its written prefix and the untouched tail.
    let checked = compiled("fn main(mut world: World) { let mut entropy=world.entropy(); let mut bytes=[7u8;2]; assert_eq!(entropy.fill(&mut bytes), Err(13i64)); assert_eq!(bytes[0],42u8); assert_eq!(bytes[1],7u8); let mut clock=world.clock(); assert_eq!(clock.unix_seconds(),Ok(-1i64)); }");
    let entry = function_index(checked.program(), "main");
    let mut host = FailingHost(Vec::new());
    crate::semantic_tests::residual::observed_run(checked.program(), entry, &[0u64; 0], &mut host).unwrap();
}

fn readiness_wait_rejects_forged_event_shapes_before_waiting() {
    let checked = compiled("fn main(mut world: World) { let mut ready = world.readiness().unwrap(); let mut clock = world.clock(); let _events = ready.wait(&mut clock, 0usize); }");
    let entry = function_index(checked.program(), "main");
    let mut result = 0usize;
    for function in &checked.program().functions {
        for instruction in &function.body {
            if let ir::Op::Intrinsic { dst, name: ir::IntrinsicOp::ReadinessWait, .. } = instruction.op {
                result = function.locals[dst].ty;
            }
        }
    }
    let vector = match &checked.program().types[result].kind {
        ir::TypeKind::Enum { variants, .. } => variants[0].fields[0].ty,
        _ => panic!("readiness result is not an enum"),
    };
    let pair = match checked.program().types[vector].kind {
        ir::TypeKind::Vec { inner } => inner,
        _ => panic!("readiness result is not a vector"),
    };
    for mode in 0usize..3usize {
        let mut program = checked.program().clone();
        if let ir::TypeKind::Struct { fields, copy } = &mut program.types[pair].kind {
            if mode == 0 { fields[0].ty = ir::I64; }
            else if mode == 1 { fields[1].ty = ir::I64; }
            else { *copy = false; }
        }
        assert_eq!(crate::check::check(program.clone()).err().unwrap().code, "E_TYPE");
        let mut host = FailingHost(Vec::new());
        let error = crate::semantic_tests::residual::observed_run(&program, entry, &[0u64; 0], &mut host).err().unwrap();
        assert!(error.kind == ErrorKind::Interpreter(InterpreterError::InvalidIr), "{}", error.message);
        assert!(!host.0.contains(&b'W'));
    }
}
fn listener_intrinsics_reject_wrong_signatures_without_host_effects() {

    let cases: Vec<(String, ir::IntrinsicOp, ir::IntrinsicOp, bool)> = vec![
        (
            "fn main(mut world: World) { let _directory = world.__lkjscript_directory(b\".\\0\"); }".to_string(),
            ir::IntrinsicOp::WorldDirectory,
            ir::IntrinsicOp::WorldListen,
            false,
        ),
        (
            "fn main(mut world: World) { let _directory = world.__lkjscript_directory(b\".\\0\"); }".to_string(),
            ir::IntrinsicOp::WorldDirectory,
            ir::IntrinsicOp::WorldReadiness,
            true,
        ),
        (
            "fn main(mut world: World) { let mut clock = world.clock(); let mut bytes = [0u8; 16]; let _status = clock.__lkjscript_read(&mut bytes); }".to_string(),
            ir::IntrinsicOp::ClockRead,
            ir::IntrinsicOp::FileSetNonblocking,
            false,
        ),
        (
            "fn main(mut world: World) { let mut clock = world.clock(); let mut bytes = [0u8; 16]; let _status = clock.__lkjscript_read(&mut bytes); }".to_string(),
            ir::IntrinsicOp::ClockRead,
            ir::IntrinsicOp::ListenerSetNonblocking,
            false,
        ),
        (
            "fn main(mut world: World) { let _directory = world.__lkjscript_directory(b\".\\0\"); }".to_string(),
            ir::IntrinsicOp::WorldDirectory,
            ir::IntrinsicOp::ListenerAccept,
            true,
        ),
        (
            "fn main(mut world: World) { let _directory = world.__lkjscript_directory(b\".\\0\"); }".to_string(),
            ir::IntrinsicOp::WorldDirectory,
            ir::IntrinsicOp::ListenerAcceptNoDelay,
            true,
        ),
        (
            "fn main(mut world: World) { let mut clock = world.clock(); let mut bytes = [0u8; 16]; let _status = clock.__lkjscript_read(&mut bytes); }".to_string(),
            ir::IntrinsicOp::ClockRead,
            ir::IntrinsicOp::ListenerAddress,
            false,
        ),
    ];
    for (source, before, after, trim) in cases {
        let checked = compiled(&source);
        let mut program = checked.program().clone();
        let entry = function_index(&program, "main");
        let mut changed = 0usize;
        for function_index in 0..program.functions.len() {
            let function = &mut program.functions[function_index];
            for instruction_index in 0..function.body.len() {
                if let ir::Op::Intrinsic { name, args, .. } = &mut function.body[instruction_index].op {
                    if *name == before {
                        *name = after;
                        if trim { args.pop(); }
                        changed += 1;
                    }
                }
            }
        }
        assert_eq!(changed, 1);
        let rejected = crate::check::check(program.clone()).err().unwrap();
        assert_eq!(rejected.code, "E_TYPE");
        let failure = crate::semantic_tests::residual::observed_run(&program, entry, &[0u64; 0], &mut Vec::<u8>::new()).err().unwrap();
        assert!(failure.kind == ErrorKind::Interpreter(InterpreterError::InvalidIr), "{}", failure.message);
    }
}

pub fn run() -> usize {
    model_runs_values_moves_borrows_collections_and_source_library();
    model_float_negation_preserves_payload_bits();
    model_runs_custom_drop_in_source_order();
    model_uses_an_explicit_stack_for_non_tail_calls_and_deep_cleanup();
    model_reports_program_traps_separately_from_machine_errors();
    raw_ir_detects_moves_double_drop_and_conflicting_access_without_checker();
    raw_ir_detects_frame_escape_and_inactive_variant_without_checker();
    raw_ir_cannot_fabricate_host_authority_or_supply_it_as_integer_argument();
    model_output_preserves_bytes_drop_order_and_trap_prefix();
    model_host_failure_keeps_previous_output_and_has_its_own_trap_kind();
    conditional_projected_drop_clears_moves_while_strict_drop_rejects_repeated_destruction();
    model_checks_signed_minimum_overflow_and_invalid_raw_integer_widths();
    strict_and_conditional_drops_have_independent_static_and_dynamic_checks();
    shared_reference_copy_keeps_real_carrier_and_exclusive_parent_conflicts();
    range_views_validate_types_loans_and_utf8_without_the_checker();
    listener_intrinsics_reject_wrong_signatures_without_host_effects();
    readiness_wait_rejects_forged_event_shapes_before_waiting();
    temporary_files_intrinsics_reject_selector_and_wrong_authority();
    storage_intrinsics_validate_before_host_effects();
    lifecycle_intrinsics_validate_before_host_effects();
    20
}

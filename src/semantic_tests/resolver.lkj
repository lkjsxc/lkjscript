use crate::ast::{Path, Span};
use crate::resolve::Resolver;

fn lookup_keeps_file_name_and_enclosing_span_boundaries() {
    let source = crate::syntax::parse("  fn first<T>() {} fn second<U>() {}").unwrap();
    let resolver = Resolver::new(&source).unwrap();
    let range = source.functions[0].span;
    assert!(generic(&resolver, range, "T"));
    assert!(generic(
        &resolver,
        Span {
            end: range.start,
            ..range
        },
        "T"
    ));
    assert!(generic(
        &resolver,
        Span {
            start: range.end,
            ..range
        },
        "T"
    ));
    assert!(!generic(
        &resolver,
        Span {
            start: range.start - 1,
            ..range
        },
        "T"
    ));
    assert!(!generic(
        &resolver,
        Span {
            end: range.end + 1,
            ..range
        },
        "T"
    ));
    assert!(!generic(
        &resolver,
        Span {
            file: range.file + 1,
            ..range
        },
        "T"
    ));
    assert!(!generic(&resolver, range, "U"));
    assert!(!generic(&resolver, range, "TT"));
    assert!(!generic(&resolver, source.functions[1].span, "T"));
    assert!(generic(&resolver, source.functions[1].span, "U"));
    assert!(generic(&resolver, Span::default(), "Self"));
    assert!(generic(&resolver, Span::default(), "'a"));
}

fn nested_method_and_impl_ranges_both_supply_parameters() {
    let source = crate::syntax::parse(
            "struct Holder<T>{value:T} impl<T> Holder<T>{fn pair<U>(self,extra:U)->(T,U){(self.value,extra)}}",
        ).unwrap();
    let resolver = Resolver::new(&source).unwrap();
    let method = source.functions[0].span;
    let implementation = source.impls[0].span;
    assert!(generic(&resolver, method, "T"));
    assert!(generic(&resolver, method, "U"));
    assert!(generic(&resolver, implementation, "T"));
    assert!(!generic(&resolver, implementation, "U"));
}

fn generic(resolver: &Resolver<'_>, span: Span, name: &str) -> bool {
    resolver.generic(span, name)
}

fn open_range_values_call_the_library_declaration_once() {
    let parsed = crate::source::parse_bundle(&crate::source::SourceBundle {
        configuration: crate::ast::BuildConfiguration::default(),
        root: "range.lkj".to_string(),
        library: Some("library.lkj".to_string()),
        files: vec![
            crate::source::SourceInput {
                path: "range.lkj".to_string(),
                text: "fn range_from(_:usize)->usize{999usize} fn start(calls:&mut usize)->usize{*calls+=1usize;40usize} pub fn probe()->usize{let mut calls=0usize;let result=(start(&mut calls)..);result+calls}".to_string(),
            },
            crate::source::SourceInput {
                path: "library.lkj".to_string(),
                text: "pub mod range {pub fn range_from(start:usize)->usize{start+1usize}}".to_string(),
            },
        ],
    }).unwrap();
    let checked = crate::frontend::check_source(&parsed).unwrap();
    let program = checked.program();
    let entry = program.functions.iter().position(|function| function.name == "probe").unwrap();
    let result = crate::interpreter::run(program, entry, &[0u64;0], &mut Vec::<u8>::new()).unwrap();
    assert!(matches!(result.value, crate::interpreter::Scalar::Int { value: 42, .. }));
}


fn open_range_slices_need_no_range_library_and_local_names_cannot_supply_it() {
    let source = crate::syntax::parse(
        "pub fn probe()->i64{let values=[1i64,42i64];let tail=&values[1usize..];tail[0usize]}"
    ).unwrap();
    assert!(crate::frontend::check_source(&source).is_ok());
    let source = crate::syntax::parse(
        "mod range{pub fn range_from(start:usize)->usize{start}} pub fn probe()->usize{(1usize..)}"
    ).unwrap();
    let problem = crate::resolve::resolve(&source).err().unwrap();
    assert_eq!(problem.code, "E_UNSUPPORTED");
}

pub fn run() -> usize {
    lookup_keeps_file_name_and_enclosing_span_boundaries();
    nested_method_and_impl_ranges_both_supply_parameters();
    open_range_values_call_the_library_declaration_once();
    open_range_slices_need_no_range_library_and_local_names_cannot_supply_it();
    4
}

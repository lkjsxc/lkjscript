//! Static panic text is source elaboration; both checked execution routes agree.
use crate::{frontend, interpreter, ir, native, runtime, source};

fn compiled(world: &mut World, text: &str) -> ir::CheckedProgram {
    let checked = frontend::check_bundle(&source::SourceBundle {
        root: "panic.lkj".to_string(), library: None,
        files: vec![source::SourceInput { path: "panic.lkj".to_string(), text: text.to_string() }],
    });
    if let Err(problem) = &checked {
        world.stdout().write(format!("panic source check: {} {}\n{text}\n", problem.code, problem.message).as_bytes());
    }
    checked.unwrap()
}
fn prepared_runtime() -> runtime::Runtime {
    runtime::seal(frontend::check_bundle(&source::SourceBundle {
        root: "runtime.lkj".to_string(), library: None,
        files: vec![source::SourceInput {
            path: "runtime.lkj".to_string(), text: include_str!("../../library/runtime.lkj").to_string(),
        }],
    }).unwrap()).unwrap()
}
fn probe(program: &ir::Program) -> usize {
    for (index, function) in program.functions.iter().enumerate() {
        if function.name == "probe" { return index; }
    }
    panic!("missing panic test entry")
}
fn exact(world: &mut World, runtime: &runtime::Runtime, text: &str, expected: &str) {
    exact_path(world, runtime, text, expected, "panic.lkj");
}
fn exact_path(world: &mut World, runtime: &runtime::Runtime, text: &str, expected: &str, path: &str) {
    let original = compiled(world, text);
    let mut program = original.program().clone(); program.sources[0] = path.to_string();
    let checked = crate::check::check(program).unwrap();
    let entry = probe(checked.program());
    let arguments: Vec<u64> = Vec::new();
    let mut observed: Vec<u8> = Vec::new();
    let failure = crate::semantic_tests::residual::observed_run(checked.program(), entry, &arguments, &mut observed).err().unwrap();
    assert!(matches!(failure.kind, interpreter::ErrorKind::Trap(_)));
    assert_eq!(failure.message, expected);
    assert!(observed.is_empty());
    let wire = format!("{}\n", crate::runtime_diagnostics::located(path, failure.line, &failure.code(), expected));
    let grants: Vec<ir::EntryGrant> = Vec::new();
    let image = native::encode_granted(&checked, runtime, entry, &grants, Some(3), None).unwrap();
    let mut executable = world.temporary_file().unwrap();
    executable.write_all(&image.bytes).unwrap();
    executable.set_executable().unwrap();
    let input = world.temporary_file().unwrap();
    let mut output = world.temporary_file().unwrap();
    let mut errors = world.temporary_file().unwrap();
    let mut result = world.temporary_file().unwrap();
    let arguments: Vec<Vec<u8>> = Vec::new();
    let mut process = world.process();
    let mut child = process.spawn_file(&executable, &arguments, &input, &output, &errors, &result).unwrap();
    assert_eq!(child.wait().unwrap(), 1);
    result.rewind().unwrap();
    let raw = result.read_to_end().unwrap();
    assert!(raw.len() >= 32 && raw.len() <= 2080);
    assert_eq!(raw[32..], wire.as_bytes()[..]);
    let decoded = crate::runtime_diagnostics::decode(path, checked.program(), runtime, &raw).unwrap();
    assert_eq!(decoded.2, expected);
    crate::residual::witness(&checked, entry, path, &decoded.1).unwrap();
    let mut malformed = raw.clone(); for index in 16..24 { malformed[index] = 255u8; }
    assert!(crate::runtime_diagnostics::decode(path, checked.program(), runtime, &malformed).is_none());

    assert!(crate::runtime_diagnostics::decode(path, checked.program(), runtime, &raw[..raw.len() - 1]).is_none());
    output.rewind().unwrap();
    errors.rewind().unwrap();
    assert!(output.read_to_end().unwrap().is_empty());
    assert!(errors.read_to_end().unwrap().is_empty());
}
fn help() -> &'static str {
    "explicit panic; help: write format!(...) bytes through an already granted output capability before panic!() (docs/language.md, Statements, control and patterns)"
}

fn literal_payloads_and_escapes(world: &mut World, runtime: &runtime::Runtime) {
    exact(world, runtime, "pub fn probe() { panic!(\"journal stopped\"); }", "journal stopped");
    exact(world, runtime, "pub fn probe() { panic!(); }", "explicit panic");
    exact(world, runtime, "pub fn probe() { unreachable!(\"unchanged\"); }", "explicit panic");
    exact(world, runtime, "pub fn probe() { panic!(\"\"); }", "");
    exact(world, runtime, r#"pub fn probe() { panic!("{{journal}}: \"雪\"\\\n"); }"#,
        "{journal}: \"雪\"\\\n");
    exact(world, runtime,
        r#"pub fn probe() { panic!("a closed semantic trap\nR0006 is message text"); }"#,
        "a closed semantic trap\nR0006 is message text");
    let mut prefix = String::new(); for _ in 0..1200 { prefix.push('x'); }
    for suffix in vec!["A".to_string(), "B".to_string()] {
        let message = format!("{prefix}{suffix}");
        exact(world, runtime, &format!("pub fn probe() {{ panic!(\"{message}\"); }}"), &message);
    }
    exact_path(world, runtime, "pub fn probe() { panic!(\"visible\\nmessage\"); }", "visible\nmessage", "R0006 path\n:雪.lkj");
    let mut long_path = String::new(); for _ in 0..300 { long_path.push_str("雪/"); }
    exact_path(world, runtime, "pub fn probe() { panic!(\"long path\"); }", "long path", &long_path);
    // Application names do not receive the explicit runtime input's seal.
    exact(world, runtime,
        r#"fn raw_load64(_address: u64) -> u64 { panic!("unsealed runtime primitive") } pub fn probe() { raw_load64(0u64); }"#,
        "unsealed runtime primitive");
}
fn immutable_literal_captures(world: &mut World, runtime: &runtime::Runtime) {
    exact(world, runtime,
        r#"pub fn probe() { let problem = "lock journal: errno 11"; panic!("journal recovery: {problem}"); }"#,
        "journal recovery: lock journal: errno 11");
    exact(world, runtime,
        r#"pub fn probe() { let one = "first"; let two = "second"; panic!("{one}/{two}/{one}"); }"#,
        "first/second/first");
    exact(world, runtime,
        r#"pub fn probe() { let problem = "lock\\journal\n\"雪\""; panic!("{{{problem}}}"); }"#,
        "{lock\\journal\n\"雪\"}");
}
fn mutable_and_shadowed_bindings_do_not_fold(world: &mut World, runtime: &runtime::Runtime) {
    let cases: Vec<String> = vec![
        r#"pub fn probe() { let mut problem = "old"; problem = "new"; panic!("{problem}"); }"#.to_string(),
        r#"pub fn probe() { let mut problem = "literal"; panic!("{problem}"); }"#.to_string(),
        r#"pub fn probe() { let problem = "outer"; { let problem = "inner"; panic!("{problem}"); } }"#.to_string(),
        r#"pub fn probe() { let problem = "outer"; { let problem = "inner"; } panic!("{problem}"); }"#.to_string(),
        r#"pub fn probe() { let problem = "outer"; panic!("{problem}"); let problem = "later"; }"#.to_string(),
        r#"fn stop(problem: &str) { panic!("{problem}"); } pub fn probe() { stop("argument"); }"#.to_string(),
    ];
    for text in cases { exact(world, runtime, &text, help()); }
}
fn dynamic_or_custom_arguments_remain_unevaluated(world: &mut World, runtime: &runtime::Runtime) {
    let cases: Vec<String> = vec![
        r#"fn detail() -> &'static str { "computed" } pub fn probe() { let problem = detail(); panic!("{problem}"); }"#.to_string(),
        r#"pub fn probe() { let problem = "literal"; panic!("{problem:?}"); }"#.to_string(),
        r#"pub fn probe() { let problem = "literal"; panic!("{problem:>20}"); }"#.to_string(),
        r#"pub fn probe() { panic!("{missing}"); }"#.to_string(),
        r#"fn detail() -> &'static str { panic!("argument was evaluated"); "unreachable" } pub fn probe() { panic!("{}", detail()); }"#.to_string(),
        r#"pub fn probe() { let problem = "literal"; panic!("{}", problem); }"#.to_string(),
        r#"pub fn probe() { panic!("{unclosed"); }"#.to_string(),
    ];
    for text in cases { exact(world, runtime, &text, help()); }
}

pub fn run(world: &mut World, trace: bool) -> usize {
    let runtime = prepared_runtime();
    if trace { world.stdout().write(b"panic_literal_payloads_and_escapes\n"); }
    literal_payloads_and_escapes(world, &runtime);
    if trace { world.stdout().write(b"panic_immutable_literal_captures\n"); }
    immutable_literal_captures(world, &runtime);
    if trace { world.stdout().write(b"panic_mutable_and_shadowed_bindings_do_not_fold\n"); }
    mutable_and_shadowed_bindings_do_not_fold(world, &runtime);
    if trace { world.stdout().write(b"panic_dynamic_or_custom_arguments_remain_unevaluated\n"); }
    dynamic_or_custom_arguments_remain_unevaluated(world, &runtime);
    4
}

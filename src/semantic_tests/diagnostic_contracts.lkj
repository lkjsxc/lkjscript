use crate::diagnostics;
use crate::source::{self, SourceBundle, SourceInput};
use crate::{frontend as compiler, syntax};

fn bundle(files: &[(String, String)]) -> SourceBundle {
    let mut inputs = Vec::new();
    for (path, text) in files {
        inputs.push(SourceInput {
            path: path.clone(),
            text: text.clone(),
        });
    }
    SourceBundle {
        configuration: crate::ast::BuildConfiguration::default(),
        root: "case/main.lkj".to_string(),
        library: None,
        files: inputs,
    }
}
fn one(text: &str) -> SourceBundle {
    bundle(&vec![("case/main.lkj".to_string(), text.to_string())])
}

fn recovery_reaches_independent_statements_items_and_nested_methods() {
    let input = one(r#"
        fn broken() { let = 1; mystery!(); let Some(x) = unknown else {}; }
        fn good() -> i64 { 42 }
        mod nested { fn broken() { other!(); } fn good() -> i64 { 7 } }
        struct Item;
        impl Item {
            static BAD: i64 = 0;
            fn broken() { third!(); }
            fn good() -> i64 { 9 }
        }
    "#);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 5);
    let mut good = 0usize;
    let mut root_good = false;
    let mut nested_good = false;
    for function in &report.program.functions {
        if function.name == "good" {
            good += 1;
            if function.module.is_empty() {
                root_good = true;
            }
            if function.module == "nested" {
                nested_good = true;
            }
        }
    }
    assert!(root_good && nested_good && good == 3usize);
    assert!(report.diagnostics.iter().all(|e| e.path == "case/main.lkj"));
    assert_eq!(blocked_count(&report.blocked, "statement"), 4);
    assert!(report.blocked.iter().any(|region| region.kind == "item"));
    assert!(
        report
            .blocked
            .iter()
            .any(|region| region.kind == "semantic phase")
    );
    assert!(compiler::check_bundle(&input).is_err());
    assert!(!report.program.macros_expanded);
    for name in vec!["mystery!".to_string(), "other!".to_string(), "third!".to_string()] {
        assert_eq!(diagnostic_message_count(&report, name.as_str()), 1usize);
    }
    macro_recovery_rules_and_calls();
    macro_recovery_modules_and_discarded_captures();
    macro_recovery_rolls_back_failed_items();
    macro_recovery_rolls_back_failed_statements();
    macro_recovery_rolls_back_forwarded_expression();
}

fn diagnostic_code_count(report: &source::SourceReport, code: &str) -> usize {
    let mut count = 0usize;
    for problem in &report.diagnostics { if problem.code == code { count += 1usize; } }
    count
}
fn diagnostic_message_count(report: &source::SourceReport, message: &str) -> usize {
    let mut count = 0usize;
    for problem in &report.diagnostics { if problem.message.contains(message) { count += 1usize; } }
    count
}

fn macro_recovery_rules_and_calls() {
    let input = one(r#"
        macro_rules! malformed { ($value:expr) { $value }; }
        macro_rules! repeat { ($($name:ident),+) => { 0i64 }; }
        macro_rules! cycle { () => { cycle!() }; }
        macro_rules! invalid_output { () => { let = 1 }; }
        macro_rules! good { () => { 41i64 }; }
        fn broken() {
            malformed!(not_materialized!());
            repeat!();
            cycle!();
            invalid_output!();
            missing!();
        }
        fn independent() -> i64 { good!() + 1i64 }
    "#);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 5usize);
    for code in vec!["E_MACRO_RULE".to_string(), "E_MACRO_MATCH".to_string(), "E_MACRO_RECURSION".to_string(), "E_PARSE".to_string(), "E_UNSUPPORTED_MACRO".to_string()] {
        assert_eq!(diagnostic_code_count(&report, code.as_str()), 1usize);
    }
    assert!(report.diagnostics.iter().all(|problem| problem.path == "case/main.lkj"));
    assert_eq!(blocked_count(&report.blocked, "statement"), 5usize);
    assert_eq!(blocked_count(&report.blocked, "item"), 1usize);
    assert!(!report.program.macros_expanded);
    // A recursive generated leaf is blocked, but its successful parent expansion
    // remains part of the completed depth-first recovery prefix.
    assert_eq!(report.program.macro_expansions.len(), 2usize);
    let mut retained: Vec<String> = Vec::new();
    for expansion in &report.program.macro_expansions {
        retained.push(report.program.macro_definitions[expansion.definition].name.clone());
    }
    assert_eq!(retained, vec!["cycle".to_string(), "good".to_string()]);
    assert_eq!(report.program.macro_aliases.len(), 1usize);
    assert!(report.program.macro_captures.is_empty());
    assert!(!report.program.macro_invocations.iter().any(|call| call.name == "not_materialized"));
    assert!(syntax::macros::provenance::validate(&report.program).is_err());
    assert!(compiler::check_bundle(&input).is_err());
}

fn macro_recovery_modules_and_discarded_captures() {
    let input = bundle(&vec![
        ("case/main.lkj".to_string(), r#"
            #[macro_use] mod definitions;
            macro_rules! discard { ($value:expr) => { 0i64 }; }
            macro_rules! generated {
                () => {
                    mod generated {
                        pub fn first() { missing_left!(); }
                        pub fn second() { missing_right!(); }
                        pub fn text() -> &'static str { include_str!("payload.txt") }
                        pub fn ignored() -> i64 { discard!(not_materialized!(include_str!("absent.txt"))) }
                    }
                };
            }
            generated!();
            fn root() { missing_root!(); }
            fn valid() -> i64 { imported!() }
        "#.to_string()),
        ("case/definitions.lkj".to_string(), r#"
            macro_rules! imported { () => { 42i64 }; }
            fn broken() { missing_file!(); }
        "#.to_string()),
        ("case/payload.txt".to_string(), "kept payload".to_string()),
    ]);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 4usize);
    assert!(report.diagnostics.iter().all(|problem| problem.code == "E_UNSUPPORTED_MACRO"));
    for name in vec!["missing_left!".to_string(), "missing_right!".to_string(), "missing_root!".to_string(), "missing_file!".to_string()] {
        assert_eq!(diagnostic_message_count(&report, name.as_str()), 1usize);
    }
    assert!(report.diagnostics.iter().any(|problem| problem.path == "case/definitions.lkj" && problem.message.contains("missing_file!")));
    assert_eq!(blocked_count(&report.blocked, "statement"), 4usize);
    assert!(!report.program.macros_expanded);
    assert_eq!(report.program.files.len(), 2usize);
    assert_eq!(report.program.macro_inputs.len(), 1usize);
    assert_eq!(report.program.macro_inputs[0usize].0, "case/payload.txt");
    assert_eq!(report.program.macro_inputs[0usize].1, b"kept payload"[..].to_vec());
    assert_eq!(report.program.macro_captures.len(), 1usize);
    assert!(report.program.macro_captures[0usize].materializations.is_empty());
    assert!(!report.program.macro_invocations.iter().any(|call| call.name == "not_materialized"));
    assert!(report.program.functions.iter().any(|function| function.module == "generated" && function.name == "second"));
    assert!(report.program.functions.iter().any(|function| function.name == "valid"));
    assert!(compiler::check_bundle(&input).is_err());
}

fn macro_recovery_rolls_back_failed_items() {
    let input = one(r#"
        macro_rules! failed {
            () => {
                #[derive(Default, Debug)] struct Transient { code: i64 }
                mod transient { pub fn hidden() -> i64 { 1i64 } }
                use transient::hidden;
                fn broken(value:) {}
            };
        }
        macro_rules! generated_definition { () => { macro_rules! escaped { () => { 1i64 }; } }; }
        macro_rules! external { () => { mod hidden_external; }; }
        macro_rules! kept { () => { struct Kept; }; }
        failed!();
        generated_definition!();
        external!();
        missing_item!();
        kept!();
        fn good() -> i64 { 42i64 }
    "#);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 4usize);
    assert_eq!(blocked_count(&report.blocked, "item"), 4usize);
    assert!(report.diagnostics.iter().any(|problem| problem.message.contains("generated macro definitions")));
    assert!(report.diagnostics.iter().any(|problem| problem.message.contains("external source module")));
    assert_eq!(report.program.files.len(), 1usize);
    assert_eq!(report.program.macro_definitions.len(), 4usize);
    assert!(!report.program.macro_definitions.iter().any(|definition| definition.name == "escaped"));
    assert!(!report.program.macros_expanded);
    assert_eq!(report.program.structs.len(), 1usize);
    assert_eq!(report.program.structs[0usize].name, "Kept");
    assert!(report.program.modules.is_empty());
    assert!(report.program.uses.is_empty());
    assert!(report.program.impls.is_empty());
    assert!(report.program.attrs.is_empty());
    assert_eq!(report.program.functions.len(), 1usize);
    assert_eq!(report.program.functions[0usize].name, "good");
    assert_eq!(report.program.macro_expansions.len(), 1usize);
    assert_eq!(report.macro_expansion_attempts, 5usize);
    assert_eq!(report.program.macro_definitions[report.program.macro_expansions[0usize].definition].name, "kept");
    assert!(report.program.macro_captures.is_empty());
    assert!(report.program.macro_aliases.is_empty());
    assert!(compiler::check_bundle(&input).is_err());
}

fn loading_continues_independent_modules_after_missing_and_invalid_sources() {
    let input = bundle(&vec![
        (
            "case/main.lkj".to_string(),
            "mod missing; mod bad; mod good;".to_string(),
        ),
        (
            "case/bad.lkj".to_string(),
            "fn broken() { mystery!(); }".to_string(),
        ),
        (
            "case/good.lkj".to_string(),
            "pub fn answer() -> i64 { 42 }".to_string(),
        ),
    ]);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 2);
    assert_eq!(report.diagnostics[0].code, "E_MODULE_MISSING");
    assert!(
        report
            .diagnostics
            .iter()
            .any(|e| e.path == "case/bad.lkj" && e.code == "E_UNSUPPORTED_MACRO")
    );
    assert!(
        report
            .program
            .functions
            .iter()
            .any(|f| f.module == "good" && f.name == "answer")
    );
    assert_eq!(report.program.files.len(), 3);
    assert!(source::parse_bundle(&input).is_err());
}

fn poisoning_reports_blocked_semantics_instead_of_invented_name_errors() {
    let input = one("fn broken() { let x = ; x.absent(); } fn other() -> i64 { unknown }");
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 1);
    assert_eq!(report.diagnostics[0].code, "E_PARSE");
    assert!(report.blocked.iter().any(|r| r.kind == "semantic phase"));
    assert!(
        !report
            .diagnostics
            .iter()
            .any(|e| e.code == "E_NAME" || e.code == "E_TYPE")
    );
    assert_eq!(compiler::check_bundle(&input).unwrap_err().code, "E_PARSE");
}

fn unsupported_diagnostics_use_parsed_constructs_and_ignore_literal_text() {
    let input = one(r#"
        fn probe() {
            let text = "? if let static format! closure"; // while let dyn ?
            let byte = b'?';
            let character = '?';
            if let Some(value) = unknown {}
            while let Some(value) = unknown {}
            let result = unknown()?;
            let closure = |x: i64| x + 1;
            let string = format!("{}", 1);
            match 0 { 0 | 1 if true => 0, _ => 1 };
            for value in values {}
            let slice = &bytes[1..3];
            let repeated = vec![0; 3];
            let pointer: fn(i64) -> i64;
            loop { break 7; }
        }
    "#);
    let mut report = source::parse_bundle_report(&input);
    assert!(report.diagnostics.is_empty(), "{:?}", report.diagnostics);
    diagnostics::complete_unsupported(&mut report);
    assert_eq!(report.diagnostics.len(), 1);
    assert_eq!(report.diagnostics[0].code, "E_UNSUPPORTED");
    assert_eq!(
        report.diagnostics[0].message,
        "unsupported construct: function pointer"
    );
    assert!(report.blocked.is_empty());
}

fn unknown_lexical_boundaries_and_unbalanced_input_are_blocked() {
    let lexical = source::parse_bundle_report(&one("fn before() {} /* missing"));
    assert_eq!(lexical.diagnostics.len(), 1);
    assert_eq!(lexical.diagnostics[0].code, "E_LEX");
    assert_eq!(blocked_count(&lexical.blocked, "file"), 1);
    let unbalanced = source::parse_bundle_report(&one("fn broken() { let x = missing("));
    assert!(!unbalanced.diagnostics.is_empty());
    assert!(unbalanced.blocked.iter().any(|r| r.kind == "item"));
    assert!(source::parse_bundle(&one("fn broken() { let x = missing(")).is_err());
}

fn the_same_recovering_parser_preserves_valid_compilation() {
    let text = "fn square(x: i64) -> i64 { x * x } fn probe() -> i64 { square(6) + 6 }";
    let report = source::parse_bundle_report(&one(text));
    assert!(report.diagnostics.is_empty());
    assert!(report.blocked.is_empty());
    assert_eq!(syntax::parse(text).unwrap().functions.len(), 2);
    assert!(compiler::check_bundle(&one(text)).is_ok());
}

fn missing_semicolon_does_not_hide_later_independent_statements() {
    let report = source::parse_bundle_report(&one(
        "fn broken() { let x = 1 let y = ; let z = ; } fn good() -> i64 { 42 }",
    ));
    assert_eq!(report.diagnostics.len(), 3);
    assert!(report.diagnostics[0].message.contains("expected `;`"));
    assert_eq!(blocked_count(&report.blocked, "statement"), 3);
    assert!(report.program.functions.iter().any(|f| f.name == "good"));
}

fn semantic_definition_errors_accumulate_without_poisoning_call_signatures() {
    let input = bundle(&vec![
        (
            "case/main.lkj".to_string(),
            "mod child; fn first() -> i64 { true } fn dependent() -> i64 { first() }".to_string(),
        ),
        (
            "case/child.lkj".to_string(),
            "pub fn second() -> bool { 1i64 }".to_string(),
        ),
    ]);
    let parsed = source::parse_bundle(&input).unwrap();
    let errors = match crate::elaborate::elaborate_all(&parsed) {
        Ok(_) => panic!("invalid definitions accepted"),
        Err(errors) => errors,
    };
    assert_eq!(errors.len(), 2, "{errors:?}");
    assert!(
        errors.iter().all(|error| error.code == "E_TYPE"
            && error.message.contains("function result type differs"))
    );
    assert_ne!(errors[0].file, errors[1].file);
    assert_eq!(
        compiler::check_bundle(&input).unwrap_err().path,
        "case/main.lkj"
    );
}

fn invalid_shared_signatures_block_semantic_recovery_before_body_checks() {
    let parsed = source::parse_bundle(&one(
        "fn first(x: Missing) -> i64 { true } fn second() -> bool { 1i64 }",
    ))
    .unwrap();
    let errors = match crate::elaborate::elaborate_all(&parsed) {
        Ok(_) => panic!("unresolved signature accepted"),
        Err(errors) => errors,
    };
    assert_eq!(errors.len(), 1);
    assert_eq!(errors[0].code, "E_NAME");
    assert!(errors[0].message.contains("Missing"));
}

fn uninitialized_function(name: &str, file: usize, line: usize) -> crate::ir::Function {
    use crate::ir;
    ir::Function {
        file,
        name: name.to_string(),
        params: 0,
        result: ir::I64,
        return_source: None,
        locals: vec![ir::Local {
            name: "value".to_string(),
            ty: ir::I64,
            mutable: false,
        }],
        body: vec![ir::Instruction {
            file: None,
            column: 1,
            op: ir::Op::Return { src: 0 },
            line,
        }],
        test: false,
    }
}

fn independent_ir_body_errors_never_construct_checked_program_authority() {
    use crate::{check, ir};
    let program = ir::Program {
        sources: Vec::new(), types: ir::primitives(),
        functions: vec![
            uninitialized_function("first", 0, 7),
            uninitialized_function("second", 1, 9),
        ],
        destructors: Vec::new(),
    };
    let errors = match check::check_all(program.clone()) {
        Ok(_) => panic!("invalid IR bodies accepted"),
        Err(errors) => errors,
    };
    assert_eq!(errors.len(), 2);
    assert!(errors.iter().all(|error| error.code == "E_MOVE"));
    assert_eq!((errors[0].file, errors[0].line), (0, 7));
    assert_eq!((errors[1].file, errors[1].line), (1, 9));
    let first = match check::check(program) {
        Ok(_) => panic!("single-error API bypassed failure"),
        Err(error) => error,
    };
    assert_eq!(first, errors[0]);
}

fn malformed_ir_structure_blocks_all_body_checks() {
    use crate::{check, ir};
    let mut first = uninitialized_function("bad_signature", 0, 7);
    first.locals[0].ty = !0usize;
    let program = ir::Program {
        sources: Vec::new(), types: ir::primitives(),
        functions: vec![first, uninitialized_function("blocked", 1, 9)],
        destructors: Vec::new(),
    };
    let errors = match check::check_all(program) {
        Ok(_) => panic!("invalid common structure accepted"),
        Err(errors) => errors,
    };
    assert_eq!(errors.len(), 1);
    assert_eq!(errors[0].code, "E_IR");
    assert!(errors[0].message.contains("unknown local type"));
}

fn unsupported_diagnostics_preserve_specific_existing_errors() {
    for (text, kind) in vec![
        (
            "fn consume(callback: fn(i64) -> i64) {}".to_string(),
            "function pointer".to_string(),
        ),
        (
            "fn probe() { let v: Vec<i64> = Vec::new(); for x in &v {} }".to_string(),
            "source library module $std::iter is not loaded".to_string(),
        ),
    ] {
        let mut report = source::parse_bundle_report(&one(&text));
        assert!(report.diagnostics.is_empty());
        let errors = match crate::elaborate::elaborate_all(&report.program) {
            Ok(_) => panic!("unsupported definition accepted: {kind}"),
            Err(errors) => errors,
        };
        assert!(
            errors.iter().any(|error| error.code == "E_UNSUPPORTED"),
            "{kind}: {errors:?}"
        );
        for error in errors {
            report.diagnostics.push(error);
        }
        let mut existing: Vec<String> = Vec::new();
        for problem in &report.diagnostics {
            existing.push(problem.message.clone());
        }
        diagnostics::complete_unsupported(&mut report);
        let mut current: Vec<String> = Vec::new();
        for problem in &report.diagnostics {
            current.push(problem.message.clone());
        }
        assert!(current == existing);
    }
}

fn unsized_source_locals_keep_their_module_and_construction_location() {
    for (text, line, column, local) in vec![
        (
            "\nfn consume(text: &str) {\n    let value = *text;\n}\n".to_string(),
            3,
            17,
            "$".to_string(),
        ),
        (
            "\n\nfn consume(value: str) {}\n".to_string(),
            3usize,
            1usize,
            "value".to_string(),
        ),
    ] {
        let input = bundle(&vec![
            ("case/main.lkj".to_string(), "mod nested;".to_string()),
            ("case/nested.lkj".to_string(), text.clone()),
        ]);
        let problem = compiler::check_bundle(&input).err().unwrap();
        assert_eq!(problem.code, "E_UNSUPPORTED");
        assert_eq!(problem.path, "case/nested.lkj");
        assert_eq!((problem.line, problem.column), (line, column));
        assert!(problem.message.contains(&format!("local {local} (str)")));
        assert!(problem.message.contains("function nested::consume"));
    }
}

fn blocked_count(regions: &[diagnostics::BlockedRegion], kind: &str) -> usize {
    let mut count = 0usize;
    for region in regions {
        if region.kind == kind {
            count += 1;
        }
    }
    count
}

pub fn run() -> usize {
    recovery_reaches_independent_statements_items_and_nested_methods();
    loading_continues_independent_modules_after_missing_and_invalid_sources();
    poisoning_reports_blocked_semantics_instead_of_invented_name_errors();
    unsupported_diagnostics_use_parsed_constructs_and_ignore_literal_text();
    unknown_lexical_boundaries_and_unbalanced_input_are_blocked();
    the_same_recovering_parser_preserves_valid_compilation();
    missing_semicolon_does_not_hide_later_independent_statements();
    semantic_definition_errors_accumulate_without_poisoning_call_signatures();
    invalid_shared_signatures_block_semantic_recovery_before_body_checks();
    independent_ir_body_errors_never_construct_checked_program_authority();
    malformed_ir_structure_blocks_all_body_checks();
    unsupported_diagnostics_preserve_specific_existing_errors();
    unsized_source_locals_keep_their_module_and_construction_location();
    macro_provider_replays_exact_source_and_capture();
    14usize
}

fn macro_provider_replays_exact_source_and_capture() {
    let inputs = vec![
        ("case/main.lkj".to_string(), b"#[macro_use] extern crate counters as chosen; fn probe() -> i32 { incr!(40) }"[..].to_vec()),
        ("case/provider.lkj".to_string(), b"
            pub fn sum(value: i32) -> i32 { value + 2 }
            #[macro_export] macro_rules! count { ($value:expr) => { $crate::sum($value) }; }
            #[macro_export] macro_rules! incr { ($value:expr) => { count!($value) }; }
        "[..].to_vec()),
    ];
    let providers = vec![crate::ast::macros::MacroProviderInput {
        name: "counters".to_string(), alias: "chosen".to_string(), path: "case/provider.lkj".to_string(),
    }];
    let program = source::load_report_with_providers("case/main.lkj", None, &providers, crate::ast::BuildConfiguration::default(), &mut |path: &str|
        -> Result<Option<Vec<u8>>, String> {
        Ok(inputs.iter().find(|entry| entry.0 == path).map(|entry| entry.1.clone()))
    }).into_result().unwrap();
    assert_eq!(program.macro_expansions.len(), 2usize);
    for expansion in &program.macro_expansions {
        let definition = &program.macro_definitions[expansion.definition];
        assert_eq!(program.files[definition.name_span.file].path, "case/provider.lkj");
    }
    let capture = &program.macro_captures[0usize];
    assert_eq!(capture.tokens[0usize].text, "40");
    assert_eq!(capture.tokens[0usize].origin.file, 0usize);
    assert_eq!(capture.tokens[0usize].context, 0usize);
    let resolved = crate::resolve::resolve(&program).unwrap();
    syntax::macros::provenance::validate(&resolved).unwrap();
    syntax::macros::provenance::validate_inputs(&resolved, &inputs).unwrap();
    let mut changed = inputs.clone();
    changed[1usize].1 = b"#[macro_export] macro_rules! incr { ($value:expr) => { 42 }; }"[..].to_vec();
    assert!(syntax::macros::provenance::validate_inputs(&resolved, &changed).is_err());
}

fn macro_recovery_rolls_back_failed_statements() {
    let input = one(r#"
        macro_rules! broken { ($name:ident, $value:expr) => { let $name = $value; let = 1; }; }
        macro_rules! keep { ($name:ident) => { let $name = 42i64; }; }
        macro_rules! outer { () => { broken!(lost, 99i64); keep!(kept); }; }
        fn root() { outer!(); missing_root!(); keep!(after); }
    "#);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 2usize);
    assert_eq!(diagnostic_code_count(&report, "E_PARSE"), 1usize);
    assert_eq!(diagnostic_code_count(&report, "E_UNSUPPORTED_MACRO"), 1usize);
    assert_eq!(blocked_count(&report.blocked, "statement"), 2usize);
    assert!(!report.program.macros_expanded);
    assert_eq!(report.program.macro_expansions.len(), 3usize);
    assert_eq!(report.macro_expansion_attempts, 5usize);
    // Identifiers stay as tokens; the failed expression capture must disappear.
    assert!(report.program.macro_captures.is_empty());
    let mut names: Vec<String> = Vec::new();
    for pattern in &report.program.patterns {
        if let crate::ast::Pattern::Bind { name, .. } = &pattern.kind {
            names.push(crate::ast::macros::source_name(name).to_string());
        }
    }
    assert!(names.contains(&"kept".to_string()));
    assert!(names.contains(&"after".to_string()));
    assert!(!names.contains(&"lost".to_string()));
    assert!(!report.program.exprs.iter().any(|node|
        matches!(&node.kind, crate::ast::Expr::Int(value) if value == "99i64")));
    assert!(syntax::macros::provenance::validate(&report.program).is_err());
    assert!(compiler::check_bundle(&input).is_err());
}

fn macro_recovery_rolls_back_forwarded_expression() {
    let input = one(r#"
        macro_rules! invalid { ($value:expr) => { $value + }; }
        macro_rules! identity { ($value:expr) => { $value }; }
        macro_rules! triple { ($value:expr) => {
            (identity!($value), invalid!($value), identity!($value))
        }; }
        fn broken() -> (i64, i64, i64) { triple!(41i64) }
        fn clean() -> i64 { identity!(42i64) }
    "#);
    let report = source::parse_bundle_report(&input);
    assert_eq!(report.diagnostics.len(), 1usize);
    assert_eq!(report.diagnostics[0usize].code, "E_PARSE");
    assert_eq!(report.macro_expansion_attempts, 5usize);
    assert_eq!(report.program.macro_expansions.len(), 4usize);
    assert_eq!(report.program.macro_captures.len(), 4usize);
    assert_eq!(report.program.macro_captures[0usize].materializations.len(), 2usize);
    assert!(report.program.macro_parse_writes.is_empty());
    let failed = &report.recovery[0usize];
    assert_eq!(failed.span, report.program.macro_invocations[0usize].span);
    assert_eq!(report.program.macro_aliases.len(), 4usize);
    assert!(syntax::macros::provenance::validate(&report.program).is_err());
}

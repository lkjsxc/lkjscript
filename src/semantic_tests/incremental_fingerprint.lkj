        11usize => "case 11 unparsed-order\nsome f071a7991b04c00f6c0e035f78d0565d202d6b905b11fb3dfbe0f43f457be747 6\nbody 0 empty\nbody 1 4cbba832175686dacb7e8f39a244ed8b4f33239a65f284e31c1253848d318e95\nbody 2 3ef043c83bc7c7e5f1646595d391eeded8d1501ef6628cbcd5e0cf9dd4176579\nbody 3 366d80ad3b958cbdd4249af7ba4b709b9b6fa55b504ee045cf2ef842bc8c0a3a\nbody 4 9f3ca80399c69a3f9a93915e5754ffa5e21bd62e17bc94e8f76f6ce130307551\nbody 5 f04df8fd64b957042c2b62f3ca5821196676aa7024b94e7c45a68dc4558a41e1\nend\n".to_string(),
        12usize => "case 12 unparsed-duplicate\nsome 079ba4c103b232b5ba2f7d931b024bdc827d6354a34cf3c4a1b390926dc95891 6\nbody 0 empty\nbody 1 4cbba832175686dacb7e8f39a244ed8b4f33239a65f284e31c1253848d318e95\nbody 2 3ef043c83bc7c7e5f1646595d391eeded8d1501ef6628cbcd5e0cf9dd4176579\nbody 3 366d80ad3b958cbdd4249af7ba4b709b9b6fa55b504ee045cf2ef842bc8c0a3a\nbody 4 9f3ca80399c69a3f9a93915e5754ffa5e21bd62e17bc94e8f76f6ce130307551\nbody 5 f04df8fd64b957042c2b62f3ca5821196676aa7024b94e7c45a68dc4558a41e1\nend\n".to_string(),
        13usize => "case 13 include-base\nsome ac484578d82feab17328f2e60bef5c7ed83873218aabbedea2556631d2486b4c 2\nbody 0 1086b8a175d4faf302d9cba3952e6c5993afba025c2123560d2f0b6bdfbe979b\nbody 1 6de380ea28ddebf42cafa84572c96a2784d6421fb89134ebd0daca249516e6ee\nend\n".to_string(),
        14usize => "case 14 include-parsed-body\nsome c2c6a0fa49abd1f8c47ddafc3a7f9a608757f4332f0aca00e5198e944082d539 2\nbody 0 1086b8a175d4faf302d9cba3952e6c5993afba025c2123560d2f0b6bdfbe979b\nbody 1 7c661f9a5e9dbdc8c3c46376af8060132c245f34dd18859e01cfaa6e9ffbfb49\nend\n".to_string(),
        15usize => "case 15 include-binary-payload\nsome cf10ac3927aa2875fd60b7b3228baf9b8097193507b32e55f422a621511f8a20 2\nbody 0 1086b8a175d4faf302d9cba3952e6c5993afba025c2123560d2f0b6bdfbe979b\nbody 1 6de380ea28ddebf42cafa84572c96a2784d6421fb89134ebd0daca249516e6ee\nend\n".to_string(),
        16usize => "case 16 include-string-payload\nsome f28ee30828676170dfec5df7cd61150f04acb9abf169da381a4e0044a83a1fc9 2\nbody 0 1086b8a175d4faf302d9cba3952e6c5993afba025c2123560d2f0b6bdfbe979b\nbody 1 6de380ea28ddebf42cafa84572c96a2784d6421fb89134ebd0daca249516e6ee\nend\n".to_string(),
        _ => panic!("unknown fingerprint golden {case}"),
    }
}

fn assert_case(case: usize) {
    assert_eq!(record(case), expected(case), "fixed complete fingerprint vector");
}

fn fixed_topology_vectors() {
    lexical_topology();
    for case in vec![0usize, 1usize, 6usize] {
        assert_case(case);
    }
    // Independently encoded off-mode vector: only the explicit mode word changes.
    let (mut program, inputs) = fixture(0usize);
    let enabled = elaborate::incremental::fingerprint(&program, &inputs).unwrap();
    program.configuration.debug_assertions = false;
    let disabled = elaborate::incremental::fingerprint(&program, &inputs).unwrap();
    assert_eq!(disabled.shape, "e649e2af72ca656c5aad995b63136f365a31a5419e9f5c2e5deb78be3aeeffeb", "explicit debug assertions off topology");
    assert_eq!(enabled.bodies, disabled.bodies, "configuration preserves body hashes");
    // Doctest is independently bound even though ordinary commands disable it.
    program.configuration.doctest = true;
    let doctest_off = elaborate::incremental::fingerprint(&program, &inputs).unwrap();
    assert_eq!(doctest_off.shape, "d3193f35d9dfb4422c1a1bcd68ab707e63ed6e4ca26748ec0a2dad63bf37b216", "explicit doctest with debug assertions off topology");
    assert_eq!(disabled.bodies, doctest_off.bodies, "doctest preserves body hashes");
    program.configuration.debug_assertions = true;
    let doctest_on = elaborate::incremental::fingerprint(&program, &inputs).unwrap();
    assert_eq!(doctest_on.shape, "082929be7ed1d7e3b78d9a18ce5ad0b13e70f01d96012e648662c2eda271d27e", "explicit doctest with debug assertions on topology");
    assert_eq!(enabled.bodies, doctest_on.bodies, "doctest preserves body hashes");
}
fn input_selection_and_extra_order() {
    for case in vec![2usize, 3usize, 4usize, 5usize, 11usize, 12usize] {
        assert_case(case);
    }
}
fn region_and_type_refusals() {
    for case in vec![7usize, 8usize, 9usize, 10usize] {
        assert_case(case);
    }
}
fn expanded_include_vectors() {
    for case in vec![13usize, 14usize, 15usize, 16usize] {
        assert_case(case);
    }
}
pub fn run() -> usize {
    fixed_topology_vectors();
    input_selection_and_extra_order();
    region_and_type_refusals();
    expanded_include_vectors();
    4usize
}

fn lexical_topology() {
    let inputs = vec![("scope.lkj".to_string(),
        "mod a { pub fn value() -> i64 { 1i64 } } mod b { pub fn value() -> i64 { 2i64 } } pub fn main() -> i64 { use a::value; { use b::value; value() } }".as_bytes().to_vec())];
    let program = resolved("scope.lkj", &inputs);
    let before = elaborate::incremental::fingerprint(&program, &inputs).unwrap();
    let mut nested = None;
    for (id, block) in program.blocks.iter().enumerate() {
        if block.parent.is_some() { nested = Some(id); }
    }
    let edited = vec![("scope.lkj".to_string(),
        "mod a { pub fn value() -> i64 { 1i64 } } mod b { pub fn value() -> i64 { 2i64 } } pub fn main() -> i64 { use a::value; { use a::value; value() } }".as_bytes().to_vec())];
    let after = elaborate::incremental::fingerprint(&resolved("scope.lkj", &edited), &edited).unwrap();
    assert_eq!(before.shape, after.shape, "same-width local import preserves topology");
    for (index, function) in program.functions.iter().enumerate() {
        if function.name == "main" { assert_ne!(before.bodies[index], after.bodies[index]); }
        else { assert_eq!(before.bodies[index], after.bodies[index]); }
    }
    let id = nested.unwrap();
    let mut changed = program.clone();
    changed.blocks[id].parent = None;
    assert_ne!(before.shape, elaborate::incremental::fingerprint(&changed, &inputs).unwrap().shape);
    changed = program.clone();
    changed.blocks[id].scope = program.scopes.len();
    assert_ne!(before.shape, elaborate::incremental::fingerprint(&changed, &inputs).unwrap().shape);
    changed = program.clone();
    let mut expression = None;
    for (index, node) in program.exprs.iter().enumerate() {
        if node.block == Some(id) { expression = Some(index); }
    }
    changed.exprs[expression.unwrap()].block = None;
    assert_ne!(before.shape, elaborate::incremental::fingerprint(&changed, &inputs).unwrap().shape);
}

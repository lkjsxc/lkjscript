//! Review identities over admitted IR. Admission/reuse still binds exact bytes.
//! This projection drops diagnostic labels/positions, never operations, literal
//! trap text, authority kinds, ownership contracts, type graphs or call edges.
use crate::{ir, ir_binary, semantic, sha256};
use std::collections::BTreeSet;

pub fn projection(program: &ir::Program) -> ir::Program {
    let mut value = program.clone();
    let mut sources: Vec<String> = Vec::new();
    sources.push(String::new());
    value.sources = sources;
    for index in 0usize..value.types.len() {
        let ty = &mut value.types[index];
        ty.name = String::new();
        match &mut ty.kind {
            ir::TypeKind::Struct { fields, .. } => {
                for index in 0usize..fields.len() { fields[index].name = String::new(); }
            }
            ir::TypeKind::Enum { variants, .. } => {
                for index in 0usize..variants.len() {
                    let variant = &mut variants[index];
                    variant.name = String::new();
                    for field in 0usize..variant.fields.len() { variant.fields[field].name = String::new(); }
                }
            }
            _ => {}
        }
    }
    for index in 0usize..value.functions.len() {
        let function = &mut value.functions[index];
        function.file = 0usize;
        function.name = String::new();
        for local in 0usize..function.locals.len() { function.locals[local].name = String::new(); }
        for at in 0usize..function.body.len() {
            let instruction = &mut function.body[at];
            instruction.file = None;
            instruction.line = 0usize;
            instruction.column = 0usize;
        }
    }
    value
}
pub fn identity(checked: &ir::CheckedProgram) -> String {
    let projected = projection(checked.program());
    let mut bytes = b"lkjscript-checked-meaning-1\0"[..].to_vec();
    bytes.extend_from_slice(&ir_binary::write(&projected));
    sha256::hex_digest(&bytes)
}
pub fn exact_identity(checked: &ir::CheckedProgram) -> String {
    let mut bytes = b"lkjscript-checked-exact-1\0"[..].to_vec();
    bytes.extend_from_slice(&ir_binary::write(checked.program()));
    sha256::hex_digest(&bytes)
}
fn field(out: &mut String, name: &str) {
    if !out.is_empty() { out.push(','); }
    out.push_str(name);
}
pub fn item_delta(before: &semantic::Item, after: &semantic::Item) -> String {
    let mut out = String::new();
    if before.signature_digest != after.signature_digest { field(&mut out, "signature"); }
    if before.body_digest != after.body_digest { field(&mut out, "body"); }
    if before.text_digest != after.text_digest && out.is_empty() { field(&mut out, "text-only"); }
    out
}

pub(crate) mod verified {
    use crate::{authority, entry_grants, ir, ir_binary, native, semantic, sha256};
    use std::collections::{BTreeMap, BTreeSet};
    pub struct Fact {
        pub identity: String,
        pub kind: String,
        pub before: String,
        pub after: String,
    }
    fn word(out: &mut Vec<u8>, value: u64) {
        for shift in 0usize..8usize { out.push((value >> (shift * 8usize)) as u8); }
    }
    fn text(out: &mut Vec<u8>, value: &str) {
        word(out, value.len() as u64); out.extend_from_slice(value.as_bytes());
    }
    fn layout(out: &mut Vec<u8>, value: &native::semantic::Layout) {
        word(out, value.bytes); word(out, value.alignment as u64);
        word(out, if value.cleanup { 1u64 } else { 0u64 });
        word(out, value.fields.len() as u64);
        for offset in &value.fields { word(out, *offset); }
        word(out, value.variants.len() as u64);
        for fields in &value.variants {
            word(out, fields.len() as u64);
            for offset in fields { word(out, *offset); }
        }
    }
    fn remap(ty: &mut ir::Type, mapping: &BTreeMap<usize, usize>, labels: bool) {
        if !labels { ty.name = String::new(); }
        match &mut ty.kind {
            ir::TypeKind::Function { params, result } => {
                for index in 0usize..params.len() { params[index] = *mapping.get(&params[index]).unwrap(); }
                *result = *mapping.get(result).unwrap();
            }
            ir::TypeKind::Struct { fields, .. } => {
                for at in 0usize..fields.len() {
                    if !labels { fields[at].name = String::new(); }
                    fields[at].ty = *mapping.get(&fields[at].ty).unwrap();
                }
            }
            ir::TypeKind::Enum { variants, .. } => {
                for at in 0usize..variants.len() {
                    let variant = &mut variants[at];
                    if !labels { variant.name = String::new(); }
                    for field in 0usize..variant.fields.len() {
                        if !labels { variant.fields[field].name = String::new(); }
                        variant.fields[field].ty = *mapping.get(&variant.fields[field].ty).unwrap();
                    }
                }
            }
            ir::TypeKind::Ref { inner, .. } | ir::TypeKind::Slice { inner, .. }
            | ir::TypeKind::Array { inner, .. } | ir::TypeKind::Vec { inner }
            | ir::TypeKind::Box { inner } => *inner = *mapping.get(inner).unwrap(),
            _ => {}
        }
    }
    // Iterative Kosaraju walks each graph edge twice. Components are ordered
    // from callers/owners to their dependencies, so reverse order hashes leaves
    // first. Cycles are encoded once, never expanded once per reachable root.
    fn components(edges: &[Vec<usize>]) -> (Vec<Vec<usize>>, Vec<usize>) {
        let mut reverse: Vec<Vec<usize>> = vec![Vec::new(); edges.len()];
        for from in 0usize..edges.len() {
            for to in &edges[from] { reverse[*to].push(from); }
        }
        let mut seen = vec![false; edges.len()];
        let mut finished = Vec::new();
        for root in 0usize..edges.len() {
            if seen[root] { continue; }
            let mut stack = vec![(root, 0usize)];
            seen[root] = true;
            while !stack.is_empty() {
                let top = stack.len() - 1usize;
                let (node, next) = stack[top];
                if next == edges[node].len() {
                    stack.pop(); finished.push(node);
                } else {
                    let child = edges[node][next];
                    stack[top].1 += 1usize;
                    if !seen[child] { seen[child] = true; stack.push((child, 0usize)); }
                }
            }
        }
        let mut groups: Vec<Vec<usize>> = Vec::new();
        let mut membership = vec![edges.len(); edges.len()];
        while let Some(root) = finished.pop() {
            if membership[root] != edges.len() { continue; }
            let group = groups.len();
            let mut members = Vec::new();
            let mut pending = vec![root];
            membership[root] = group;
            while let Some(node) = pending.pop() {
                members.push(node);
                for predecessor in &reverse[node] {
                    if membership[*predecessor] == edges.len() {
                        membership[*predecessor] = group;
                        pending.push(*predecessor);
                    }
                }
            }
            groups.push(members);
        }
        (groups, membership)
    }
    fn fingerprints(program: &ir::Program, names: &[String], layouts: &[native::semantic::Layout],
        labels: bool) -> Vec<String> {
        let mut edges = Vec::new();
        for ty in &program.types { edges.push(super::children(&ty.kind)); }
        let (groups, membership) = components(&edges);
        let mut hashes = vec![String::new(); program.types.len()];
        let mut remaining = groups.len();
        while remaining != 0usize {
            remaining -= 1usize;
            let mut ordered: Vec<(String, usize)> = Vec::new();
            for index in &groups[remaining] { ordered.push((names[*index].clone(), *index)); }
            ordered.sort();
            let mut mapping: BTreeMap<usize, usize> = BTreeMap::new();
            for at in 0usize..ordered.len() { mapping.insert(ordered[at].1, at); }
            let mut external: BTreeSet<String> = BTreeSet::new();
            for (_, index) in &ordered {
                for child in &edges[*index] {
                    if membership[*child] != remaining { external.insert(hashes[*child].clone()); }
                }
            }
            let mut external_ids = BTreeMap::new();
            for digest in &external {
                let at = ordered.len() + external_ids.len();
                external_ids.insert(digest.clone(), at);
            }
            for (_, index) in &ordered {
                for child in &edges[*index] {
                    if membership[*child] != remaining {
                        mapping.insert(*child, *external_ids.get(&hashes[*child]).unwrap());
                    }
                }
            }
            let mut projected = ir::Program { sources: Vec::new(), types: Vec::new(),
                functions: Vec::new(), destructors: Vec::new() };
            let mut bytes = if labels { b"lkjscript-ir-type-identity-linux-x86_64-1\0"[..].to_vec() }
                else { b"lkjscript-ir-type-shape-linux-x86_64-1\0"[..].to_vec() };
            word(&mut bytes, ordered.len() as u64);
            for (_, original) in &ordered {
                let mut ty = program.types[*original].clone();
                ty.name = names[*original].clone();
                remap(&mut ty, &mapping, labels);
                projected.types.push(ty);
                layout(&mut bytes, &layouts[*original]);
            }
            // These are encoded dependency digests, not checked placeholder types.
            for digest in external { projected.types.push(ir::Type { name: digest, kind: ir::TypeKind::Unit }); }
            bytes.extend_from_slice(&ir_binary::write(&projected));
            let component = sha256::hex_digest(&bytes);
            for at in 0usize..ordered.len() {
                let mut root = b"lkjscript-ir-type-component-root-1\0"[..].to_vec();
                text(&mut root, &component); word(&mut root, at as u64);
                hashes[ordered[at].1] = sha256::hex_digest(&root);
            }
        }
        hashes
    }
    pub fn type_identities(checked: &ir::CheckedProgram) -> Result<Vec<String>, String> {
        let layouts = native::semantic::layouts(checked).map_err(|problem| -> String { problem.message })?;
        let mut names = Vec::new();
        for index in 0usize..checked.program().types.len() {
            names.push(semantic::ir_identity_type_name(checked.program(), index));
        }
        Ok(fingerprints(checked.program(), &names, &layouts, true))
    }
    fn instance(program: &ir::Program, catalog: &semantic::Catalog, shapes: &[String], index: usize) -> String {
        let original = &program.functions[index];
        let mut type_names: BTreeSet<String> = BTreeSet::new();
        type_names.insert(shapes[original.result].clone());
        for local in &original.locals { type_names.insert(shapes[local.ty].clone()); }
        let mut callees: BTreeSet<String> = BTreeSet::new();
        for instruction in &original.body {
            if let ir::Op::Call { function, .. } | ir::Op::Bind { function, .. } = instruction.op {
                callees.insert(catalog.instance_ids[function].clone());
            }
        }
        let mut type_ids: BTreeMap<String, usize> = BTreeMap::new();
        let mut call_ids: BTreeMap<String, usize> = BTreeMap::new();
        let mut bytes = b"lkjscript-ir-instance-body-1\0"[..].to_vec();
        word(&mut bytes, type_names.len() as u64);
        for name in type_names { text(&mut bytes, &name); let at = type_ids.len(); type_ids.insert(name, at); }
        word(&mut bytes, callees.len() as u64);
        for name in callees { text(&mut bytes, &name); let at = call_ids.len(); call_ids.insert(name, at); }
        let mut value = original.clone();
        value.name = String::new(); value.file = 0usize;
        value.result = *type_ids.get(&shapes[value.result]).unwrap();
        for at in 0usize..value.locals.len() {
            value.locals[at].name = String::new();
            value.locals[at].ty = *type_ids.get(&shapes[value.locals[at].ty]).unwrap();
        }
        for at in 0usize..value.body.len() {
            let instruction = &mut value.body[at];
            instruction.file = None; instruction.line = 0usize; instruction.column = 0usize;
            if let ir::Op::Call { function, .. } | ir::Op::Bind { function, .. } = &mut instruction.op {
                *function = *call_ids.get(&catalog.instance_ids[*function]).unwrap();
            }
        }
        bytes.extend_from_slice(&ir_binary::write_function(&value));
        sha256::hex_digest(&bytes)
    }
    fn join(values: &BTreeSet<String>) -> String {
        let mut out = String::new();
        for value in values { if !out.is_empty() { out.push(','); } out.push_str(value); }
        out
    }
    pub fn authority_sets(checked: &ir::CheckedProgram, catalog: &semantic::Catalog) -> BTreeMap<String, BTreeSet<String>> {
        let relations = authority::relations(checked);
        let mut edges: Vec<Vec<usize>> = Vec::new();
        for relation in &relations {
            let mut children = Vec::new();
            for (callee, _) in &relation.calls { children.push(*callee); }
            edges.push(children);
        }
        let (groups, membership) = components(&edges);
        let mut effects: Vec<BTreeSet<String>> = vec![BTreeSet::new(); groups.len()];
        let mut remaining = groups.len();
        while remaining != 0usize {
            remaining -= 1usize;
            let mut values: BTreeSet<String> = BTreeSet::new();
            for function in &groups[remaining] {
                for operation in &relations[*function].operations {
                    values.insert(format!("effect:{}", operation.name));
                }
                for callee in &edges[*function] {
                    let group = membership[*callee];
                    if group != remaining {
                        for effect in &effects[group] { values.insert(effect.clone()); }
                    }
                }
            }
            effects[remaining] = values;
        }
        let mut result = BTreeMap::new();
        for index in 0usize..checked.program().functions.len() {
            let mut values = effects[membership[index]].clone();
            if entry_grants::validate(checked.program(), index).is_ok() {
                let manifest = match authority::manifest(checked, index) { Ok(value) => value, Err(_) => continue };
                if manifest.full_world { values.insert("grant:World".to_string()); }
                for grant in &manifest.requirements {
                    values.insert(format!("grant:{}:{}", grant.parameter, grant.capability));
                }
            } else if let Ok(manifest) = crate::child_image::manifest(checked, index) {
                for (parameter, slot) in manifest.slots.iter().enumerate() {
                    values.insert(format!("grant:{}:{}", parameter, slot.kind.name()));
                }
            } else { continue; }
            result.insert(catalog.instance_ids[index].clone(), values);
        }
        result
    }
    pub fn authorities(checked: &ir::CheckedProgram, catalog: &semantic::Catalog) -> BTreeMap<String, String> {
        let mut result = BTreeMap::new();
        for (name, values) in authority_sets(checked, catalog) { result.insert(name, join(&values)); }
        result
    }
    fn delta(out: &mut Vec<Fact>, kind: &str, old: &BTreeMap<String, String>, new: &BTreeMap<String, String>) {
        let mut names: BTreeSet<String> = BTreeSet::new();
        for (name, _) in old { names.insert(name.clone()); }
        for (name, _) in new { names.insert(name.clone()); }
        for name in names {
            if old.get(&name) == new.get(&name) { continue; }
            let before = match old.get(&name) { Some(value) => value.clone(), None => "absent".to_string() };
            let after = match new.get(&name) { Some(value) => value.clone(), None => "absent".to_string() };
            out.push(Fact { identity: name, kind: kind.to_string(), before, after });
        }
    }
    fn shapes(checked: &ir::CheckedProgram) -> Result<(Vec<String>, BTreeMap<String, String>, BTreeMap<String, String>), String> {
        let program = checked.program();
        let layouts = native::semantic::layouts(checked).map_err(|problem| -> String { problem.message })?;
        let mut names = Vec::new();
        for index in 0usize..program.types.len() { names.push(semantic::ir_identity_type_name(program, index)); }
        let shapes = fingerprints(program, &names, &layouts, false);
        let identities = fingerprints(program, &names, &layouts, true);
        let mut physical = BTreeMap::new();
        let mut nominal = BTreeMap::new();
        for index in 0usize..program.types.len() {
            let identity = format!("ir:type:{}", names[index]);
            let mut bytes = Vec::new(); layout(&mut bytes, &layouts[index]);
            physical.insert(identity.clone(), format!("bytes={} alignment={} layout={}",
                layouts[index].bytes, layouts[index].alignment, sha256::hex_digest(&bytes)));
            nominal.insert(identity, identities[index].clone());
        }
        Ok((shapes, physical, nominal))
    }
    fn destructors(checked: &ir::CheckedProgram, catalog: &semantic::Catalog) -> BTreeMap<String, String> {
        let mut values = BTreeMap::new();
        for (ty, function) in &checked.program().destructors {
            values.insert(format!("ir:type:{}", semantic::ir_identity_type_name(checked.program(), *ty)), catalog.instance_ids[*function].clone());
        }
        values
    }
    pub fn changes(before: &semantic::Catalog, old: &ir::CheckedProgram,
        after: &semantic::Catalog, new: &ir::CheckedProgram) -> Result<Vec<Fact>, String> {
        let mut out = Vec::new();
        delta(&mut out, "authority", &authorities(old, before), &authorities(new, after));
        let (old_shapes, old_layouts, old_types) = shapes(old)?;
        let (new_shapes, new_layouts, new_types) = shapes(new)?;
        delta(&mut out, "layout", &old_layouts, &new_layouts);
        delta(&mut out, "type-identity", &old_types, &new_types);
        delta(&mut out, "destructor", &destructors(old, before), &destructors(new, after));
        let mut old_instances = BTreeMap::new();
        let mut new_instances = BTreeMap::new();
        for index in 0usize..old.program().functions.len() {
            old_instances.insert(before.instance_ids[index].clone(), instance(old.program(), before, &old_shapes, index));
        }
        for index in 0usize..new.program().functions.len() {
            new_instances.insert(after.instance_ids[index].clone(), instance(new.program(), after, &new_shapes, index));
        }
        delta(&mut out, "instance", &old_instances, &new_instances);
        Ok(out)
    }
}


fn authority_fact(fact: &verified::Fact) -> String {
    let mut before: BTreeSet<String> = BTreeSet::new();
    let mut after: BTreeSet<String> = BTreeSet::new();
    if fact.before != "absent" {
        for value in fact.before.as_str().split(',') { if !value.is_empty() { before.insert(value.to_string()); } }
    }
    if fact.after != "absent" {
        for value in fact.after.as_str().split(',') { if !value.is_empty() { after.insert(value.to_string()); } }
    }
    let mut gained = String::new();
    let mut lost = String::new();
    for value in &after {
        if !before.contains(value) {
            if !gained.is_empty() { gained.push(','); }
            gained.push_str(value);
        }
    }
    for value in &before {
        if !after.contains(value) {
            if !lost.is_empty() { lost.push(','); }
            lost.push_str(value);
        }
    }
    format!("{} level=checked-ir changed=authority authority-gained={} authority-lost={} entry-before={} entry-after={}\n",
        semantic::quote(&fact.identity), semantic::quote(&gained), semantic::quote(&lost),
        fact.before != "absent", fact.after != "absent")
}
pub fn compare(before: &semantic::Catalog, old: &ir::CheckedProgram,
    after: &semantic::Catalog, new: &ir::CheckedProgram, text_identical: bool, limit: usize, detail: &str) -> Result<String, String> {
    let mut selected = detail.to_string();
    if !detail.is_empty() {
        let mut found = Vec::new(); let mut choices = String::new();
        for candidate in semantic::selector_candidates(detail, "COMPARE")? {
            let kind = match before.selector_kinds.get(&candidate) {
                Some(kind) => Some(kind), None => after.selector_kinds.get(&candidate),
            };
            if let Some(kind) = kind {
                if !choices.is_empty() { choices.push_str(", "); }
                choices.push_str(&format!("{} ({kind})", semantic::quote(&candidate)));
                found.push(candidate);
            }
        }
        if found.len() > 1usize {
            return Err(format!("{} E_COMPARE_AMBIGUOUS select one canonical identity: {choices}", semantic::quote(detail)));
        }
        if let Some(identity) = found.pop() {
            if identity.contains('@') && !before.by_identity.contains_key(&identity) && !after.by_identity.contains_key(&identity) {
                return Err(format!("{} E_COMPARE_IDENTITY selected metadata has no comparable source item", semantic::quote(&identity)));
            }
            selected = identity;
        }
        else if detail.contains('@') {
            return Err(format!("{} E_COMPARE_IDENTITY no matching canonical source identity", semantic::quote(detail)));
        }
    }
    let detail = selected.as_str();
    let old_meaning = identity(old);
    let new_meaning = identity(new);
    let old_exact = exact_identity(old);
    let new_exact = exact_identity(new);
    let mut out = format!("program level=checked-ir identity-domain=lkjscript-checked-meaning-1 before={} after={} exact-before={} exact-after={}\n",
        old_meaning, new_meaning, old_exact, new_exact);
    let verdict = if old_meaning == new_meaning {
        if text_identical { "text identical, checked IR identical" }
        else { "text differs, checked IR identical" }
    } else { "checked IR differs" };
    out.push_str(&format!("program level=checked-ir verdict={} diagnostic-metadata={}\n",
        semantic::quote(verdict), if old_exact == new_exact { "identical" } else { "differs" }));
    let verified = verified::changes(before, old, after, new)?;
    let mut names: BTreeSet<String> = BTreeSet::new();
    for value in &before.items { names.insert(value.identity.clone()); }
    for value in &after.items { names.insert(value.identity.clone()); }
    let mut source: Vec<(String, String)> = Vec::new();
    for name in names {
        if !detail.is_empty() && detail != name { continue; }
        let old_item = before.by_identity.get(&name).map(|index| &before.items[*index]);
        let new_item = after.by_identity.get(&name).map(|index| &after.items[*index]);
        let delta = match (old_item, new_item) {
            (Some(left), Some(right)) => item_delta(left, right),
            (Some(_), None) => "removed".to_string(),
            (None, Some(_)) => "added".to_string(),
            _ => String::new(),
        };
        if !delta.is_empty() { source.push((name, delta)); }
    }
    // Review samples every category before one large category can exhaust the
    // bound. Generated IR names follow named facts; all remain addressable.
    // This is presentation order only, never an identity or proof projection.
    let mut groups: Vec<Vec<usize>> = vec![Vec::new(), Vec::new(), Vec::new(), Vec::new()];
    for index in 0usize..source.len() { groups[1usize].push(index); }
    let mut layout_changes = 0usize;
    let mut type_changes = 0usize;
    let mut destructor_changes = 0usize;
    for generated in 0usize..2usize {
        for index in 0usize..verified.len() {
            let fact = &verified[index];
            if !detail.is_empty() && detail != fact.identity { continue; }
            if fact.identity.contains('$') != (generated == 1usize) { continue; }
            let group = match fact.kind.as_str() {
                "authority" => 0usize,
                "instance" => 3usize,
                "layout" => { layout_changes += 1usize; 2usize },
                "type-identity" => { type_changes += 1usize; 2usize },
                _ => { destructor_changes += 1usize; 2usize },
            };
            groups[group].push(index);
        }
    }
    let verified_changes = groups[0usize].len() + groups[2usize].len() + groups[3usize].len();
    let changed = verified_changes + source.len();
    let mut positions: Vec<usize> = vec![0usize; 4usize];
    let mut emitted = 0usize;
    while emitted < limit && emitted < changed {
        for group in 0usize..4usize {
            if emitted == limit { break; }
            let at = positions[group];
            if at == groups[group].len() { continue; }
            let index = groups[group][at];
            positions[group] += 1usize;
            if group == 1usize {
                out.push_str(&format!("{} level=source-claim changed={}\n",
                    semantic::quote(&source[index].0), source[index].1));
            } else {
                let fact = &verified[index];
                if fact.kind == "authority" { out.push_str(&authority_fact(fact)); }
                else {
                    out.push_str(&format!("{} level=checked-ir changed={} before={} after={}\n",
                        semantic::quote(&fact.identity), fact.kind, semantic::quote(&fact.before), semantic::quote(&fact.after)));
                }
            }
            emitted += 1usize;
        }
    }
    out.push_str(&format!("program changed-facts={} checked-facts={} source-facts={} shown={} omitted={} authority-facts={} layout-facts={} type-identity-facts={} destructor-facts={} instance-facts={} detail=--id identity\n",
        changed, verified_changes, source.len(), emitted, changed - emitted,
        groups[0usize].len(), layout_changes, type_changes, destructor_changes, groups[3usize].len()));
    Ok(out)
}


// Canonical numbering is discovered from one checked root in instruction/local
// order. Unrelated functions/types cannot renumber this closure. Every owning
// type's destructor is included conservatively, even if a path is unreachable.
fn include(map: &mut Vec<Option<usize>>, order: &mut Vec<usize>, index: usize) {
    if map[index].is_none() {
        map[index] = Some(order.len());
        order.push(index);
    }
}
fn children(kind: &ir::TypeKind) -> Vec<usize> {
    let mut out = Vec::new();
    match kind {
        ir::TypeKind::Function { params, result } => { out.extend_from_slice(params); out.push(*result); }
        ir::TypeKind::Struct { fields, .. } => {
            for field in fields { out.push(field.ty); }
        }
        ir::TypeKind::Enum { variants, .. } => {
            for variant in variants { for field in &variant.fields { out.push(field.ty); } }
        }
        ir::TypeKind::Ref { inner, .. } | ir::TypeKind::Slice { inner, .. }
        | ir::TypeKind::Array { inner, .. } | ir::TypeKind::Vec { inner }
        | ir::TypeKind::Box { inner } => out.push(*inner),
        _ => {}
    }
    out
}
fn remap_type(value: &mut ir::Type, types: &[Option<usize>], diagnostic_metadata: bool) {
    if !diagnostic_metadata { value.name = String::new(); }
    match &mut value.kind {
        ir::TypeKind::Function { params, result } => {
            for index in 0usize..params.len() { params[index] = types[params[index]].unwrap(); }
            *result = types[*result].unwrap();
        }
        ir::TypeKind::Struct { fields, .. } => {
            for index in 0usize..fields.len() {
                if !diagnostic_metadata { fields[index].name = String::new(); }
                fields[index].ty = types[fields[index].ty].unwrap();
            }
        }
        ir::TypeKind::Enum { variants, .. } => {
            for index in 0usize..variants.len() {
                let variant = &mut variants[index];
                if !diagnostic_metadata { variant.name = String::new(); }
                for field in 0usize..variant.fields.len() {
                    if !diagnostic_metadata { variant.fields[field].name = String::new(); }
                    variant.fields[field].ty = types[variant.fields[field].ty].unwrap();
                }
            }
        }
        ir::TypeKind::Ref { inner, .. } | ir::TypeKind::Slice { inner, .. }
        | ir::TypeKind::Array { inner, .. } | ir::TypeKind::Vec { inner }
        | ir::TypeKind::Box { inner } => *inner = types[*inner].unwrap(),
        _ => {}
    }
}
pub struct ClosureIdentity {
    pub digest: String,
    pub functions: Vec<usize>,
    pub types: Vec<usize>,
}
pub fn closure_identity(checked: &ir::CheckedProgram, entry: usize, diagnostic_metadata: bool) -> Result<ClosureIdentity, String> {
    let program = checked.program();
    if entry >= program.functions.len() { return Err("E_ENTRY unknown checked function".to_string()); }
    let mut functions: Vec<Option<usize>> = vec![None; program.functions.len()];
    let mut types: Vec<Option<usize>> = vec![None; program.types.len()];
    let mut function_order: Vec<usize> = Vec::new();
    let mut type_order: Vec<usize> = Vec::new();
    let mut destructors: std::collections::BTreeMap<usize, usize> = std::collections::BTreeMap::new();
    for (ty, function) in &program.destructors { destructors.insert(*ty, *function); }
    include(&mut functions, &mut function_order, entry);
    let mut function_at = 0usize;
    let mut type_at = 0usize;
    while function_at < function_order.len() || type_at < type_order.len() {
        while function_at < function_order.len() {
            let function = &program.functions[function_order[function_at]];
            include(&mut types, &mut type_order, function.result);
            for local in &function.locals { include(&mut types, &mut type_order, local.ty); }
            for instruction in &function.body {
                if let ir::Op::Call { function, .. } | ir::Op::Bind { function, .. } = instruction.op {
                    include(&mut functions, &mut function_order, function);
                }
            }
            function_at += 1usize;
        }
        while type_at < type_order.len() {
            let ty = type_order[type_at];
            for child in children(&program.types[ty].kind) { include(&mut types, &mut type_order, child); }
            if let Some(function) = destructors.get(&ty) { include(&mut functions, &mut function_order, *function); }
            type_at += 1usize;
        }
    }
    let mut projected = ir::Program { sources: Vec::new(), types: Vec::new(), functions: Vec::new(), destructors: Vec::new() };
    let mut source_ids: std::collections::BTreeMap<usize, usize> = std::collections::BTreeMap::new();
    for original in &type_order {
        let mut value = program.types[*original].clone();
        remap_type(&mut value, &types, diagnostic_metadata);
        projected.types.push(value);
        if let Some(function) = destructors.get(original) {
            projected.destructors.push((types[*original].unwrap(), functions[*function].unwrap()));
        }
    }
    for original in &function_order {
        let mut function = program.functions[*original].clone();
        if diagnostic_metadata {
            if !source_ids.contains_key(&function.file) {
                source_ids.insert(function.file, projected.sources.len());
                projected.sources.push(program.sources[function.file].clone());
            }
            function.file = *source_ids.get(&function.file).unwrap();
        } else {
            function.file = 0usize;
            function.name = String::new();
        }
        function.result = types[function.result].unwrap();
        for index in 0usize..function.locals.len() {
            function.locals[index].ty = types[function.locals[index].ty].unwrap();
            if !diagnostic_metadata { function.locals[index].name = String::new(); }
        }
        for at in 0usize..function.body.len() {
            let instruction = &mut function.body[at];
            if let ir::Op::Call { function, .. } | ir::Op::Bind { function, .. } = &mut instruction.op {
                *function = functions[*function].unwrap();
            }
            if diagnostic_metadata {
                if let Some(file) = instruction.file {
                    if !source_ids.contains_key(&file) {
                        source_ids.insert(file, projected.sources.len());
                        projected.sources.push(program.sources[file].clone());
                    }
                    instruction.file = Some(*source_ids.get(&file).unwrap());
                }
            } else {
                instruction.file = None;
                instruction.line = 0usize;
                instruction.column = 0usize;
            }
        }
        projected.functions.push(function);
    }
    let mut bytes = if diagnostic_metadata { b"lkjscript-checked-closure-diagnostics-1\0"[..].to_vec() }
        else { b"lkjscript-checked-closure-1\0"[..].to_vec() };
    bytes.extend_from_slice(&ir_binary::write(&projected));
    Ok(ClosureIdentity { digest: sha256::hex_digest(&bytes), functions: function_order, types: type_order })
}

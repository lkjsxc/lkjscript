declarations.begin
(units (module create sequence-memory
  (external create length (visibility public) (implementation core.buffer.length)
    (parameter create value (type ByteBuffer) (use borrow)) (returns I64))
  (external create discard (visibility private) (implementation core.buffer.discard)
    (parameter create value (type ByteBuffer) (use consume)) (returns Unit))
  (function create dispose-sequence (visibility private) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use consume))
    (returns I64) (body (i64 0)))
  (function create empty (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (returns (owned-sequence T))
    (body (sequence-empty (type (owned-sequence T)))))
  (function create push (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create value (type T) (use consume))
    (parameter create seq (type (owned-sequence T)) (use consume))
    (returns (owned-sequence T))
    (body (sequence-push (type (owned-sequence T)) (local value) (local seq))))
  (function create pop (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create seq (type (owned-sequence T)) (use consume))
    (returns (owned-choice
      (case empty (owned-sequence T))
      (case item (owned-product (field rest (owned-sequence T)) (field value T)))))
    (body (sequence-pop (type (owned-sequence T)) (local seq))))
  (function create count (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create seq (type (owned-sequence T)) (use borrow))
    (returns I64)
    (body (sequence-length (type (owned-sequence T)) (local seq))))
  (function create buffer-count (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use borrow))
    (returns I64) (body (call count (types ByteBuffer) (local seq))))
  (function create cell-count (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence OwnedI64Cell)) (use borrow))
    (returns I64) (body (call count (types OwnedI64Cell) (local seq))))
  (function create relay (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create seq (type (owned-sequence T)) (use consume))
    (returns (owned-sequence T))
    (body (sequence
      (borrow-owned-item (type (owned-sequence T)) (local seq)
        (index (i64 0)) (binding view (type T)) (in (unit)))
      (borrow-owned-item (type (owned-sequence T)) (local seq)
        (index (i64 1)) (binding view (type T)) (in (unit)))
      (local seq))))
  (function create read (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use consume))
    (returns I64)
    (body (borrow-owned-item (type (owned-sequence ByteBuffer)) (local seq)
      (index (i64 0)) (binding view (type ByteBuffer))
      (in (call length (local view))))))
  (function create borrowed (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use borrow))
    (returns I64)
    (body (borrow-owned-item (type (owned-sequence ByteBuffer)) (local seq)
      (index (i64 0)) (binding view (type ByteBuffer))
      (in (call length (local view))))))
  (function create nested (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence (owned-sequence ByteBuffer))) (use borrow))
    (returns I64)
    (body (borrow-owned-item (type (owned-sequence (owned-sequence ByteBuffer))) (local seq)
      (index (i64 0)) (binding inner (type (owned-sequence ByteBuffer)))
      (in (borrow-owned-item (type (owned-sequence ByteBuffer)) (local inner)
        (index (i64 0)) (binding view (type ByteBuffer))
        (in (sequence (sequence-length (type (owned-sequence ByteBuffer)) (local inner))
          (call length (local view)))))))))
  (function create ancestor (visibility public) (effect pure)
    (parameter create packet (type (owned-product
      (field items (owned-sequence ByteBuffer)) (field tag I64))) (use consume))
    (returns I64)
    (body (borrow-owned-field (type (owned-product
      (field items (owned-sequence ByteBuffer)) (field tag I64))) (local packet)
      (field items (binding items (type (owned-sequence ByteBuffer))))
      (in (borrow-owned-item (type (owned-sequence ByteBuffer)) (local items)
        (index (field (local packet) (name tag))) (binding view (type ByteBuffer))
        (in (call length (local view))))))))
  (function create independent-result (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use borrow))
    (parameter create other (type ByteBuffer) (use consume))
    (returns ByteBuffer)
    (body (borrow-owned-item (type (owned-sequence ByteBuffer)) (local seq)
      (index (i64 0)) (binding view (type ByteBuffer))
      (in (sequence (call length (local view)) (local other))))))
  (function create unrelated-consume (visibility public) (effect pure)
    (parameter create seq (type (owned-sequence ByteBuffer)) (use borrow))
    (parameter create other (type ByteBuffer) (use consume))
    (returns I64)
    (body (borrow-owned-item (type (owned-sequence ByteBuffer)) (local seq)
      (index (i64 0)) (binding view (type ByteBuffer))
      (in (sequence (call discard (local other)) (call length (local view)))))))
  (function create mark (visibility private) (effect (task))
    (returns Unit) (body (unit)))
  (function create effect-body (visibility public) (effect (task))
    (parameter create seq (type (owned-sequence ByteBuffer)) (use consume))
    (returns I64)
    (body (borrow-owned-item (type (owned-sequence ByteBuffer)) (local seq)
      (index (sequence (call mark) (i64 0))) (binding view (type ByteBuffer))
      (in (sequence (call mark) (call length (local view)))))))))
declarations.end

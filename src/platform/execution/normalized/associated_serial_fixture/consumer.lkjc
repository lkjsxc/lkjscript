      (method method_c7000000000000000000000000000002 block-at
        (parameters (I64 unrestricted) (Self borrow))
        (returns (associated-contract-member BlockRead assoc_type_c7000000000000000000000000000001)
          (borrow-from 1)) (effect pure))
      (method method_c7000000000000000000000000000003 block-length

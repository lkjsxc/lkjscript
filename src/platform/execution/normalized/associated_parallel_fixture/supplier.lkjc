declarations.begin
(units
  (module create associated-parallel-supplier
    (owned-record create Cargo (visibility public)
      (field create scalar (type OwnedI64Cell))
      (field create octets (type ByteBuffer)))
    (external create new-cell (visibility private) (implementation core.cell.create)
      (parameter create n (type I64)) (returns OwnedI64Cell))
    (external create empty (visibility private) (implementation core.buffer.empty)
      (returns ByteBuffer))
    (external create push (visibility private) (implementation core.buffer.push)
      (parameter create n (type I64))
      (parameter create value (type ByteBuffer) (use consume)) (returns ByteBuffer))
    (external create read-cell (visibility private) (implementation core.cell.read)
      (parameter create value (type OwnedI64Cell) (use borrow)) (returns I64))
    (external create length (visibility private) (implementation core.buffer.length)
      (parameter create value (type ByteBuffer) (use borrow)) (returns I64))
    (external create divide (visibility private) (implementation core.i64.divide)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (external create less (visibility private) (implementation core.i64.less)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns Bool))
    (external create subtract (visibility private) (implementation core.i64.subtract)
      (parameter create a (type I64)) (parameter create b (type I64)) (returns I64))
    (function create burn (visibility private) (effect pure)
      (parameter create rounds (type I64)) (returns Unit)
      (body (if (call less (local rounds) (i64 1)) (unit)
        (call burn (call subtract (local rounds) (i64 1))))))
    (function create make (visibility public) (effect pure)
      (parameter create n (type I64)) (parameter create final-octet (type I64)) (returns Cargo)
      (body (let
        (binding scalar (type OwnedI64Cell) (call new-cell (local n)))
        (binding b0 (type ByteBuffer) (call empty))
        (binding b1 (type ByteBuffer) (call push (i64 0) (local b0)))
        (binding b2 (type ByteBuffer) (call push (i64 255) (local b1)))
        (binding b3 (type ByteBuffer) (call push (i64 128) (local b2)))
        (binding b4 (type ByteBuffer) (call push (local final-octet) (local b3)))
        (in (pack-owned (type Cargo)
          (field scalar (local scalar)) (field octets (local b4)))))))
    (function create take-cell (visibility public) (effect pure)
      (parameter create fail (type Bool)) (parameter create rounds (type I64))
      (parameter create source (type Cargo) (use consume)) (returns OwnedI64Cell)
      (body (unpack-owned (type Cargo) (local source)
        (field scalar (binding scalar (type OwnedI64Cell)))
        (field octets (binding unused (type ByteBuffer)))
        (in (sequence (call burn (local rounds))
          (if (local fail)
            (sequence (call divide (i64 1) (i64 0)) (local scalar))
            (local scalar)))))))
    (function create take-buffer (visibility public) (effect pure)
      (parameter create fail (type Bool)) (parameter create rounds (type I64))
      (parameter create source (type Cargo) (use consume)) (returns ByteBuffer)
      (body (unpack-owned (type Cargo) (local source)
        (field scalar (binding unused (type OwnedI64Cell)))
        (field octets (binding bytes (type ByteBuffer)))
        (in (sequence (call burn (local rounds))
          (if (local fail)
            (sequence (call divide (i64 1) (i64 0)) (local bytes))
            (local bytes)))))))
    (function create inspect-cell (visibility public) (effect pure)
      (parameter create fail (type Bool)) (parameter create rounds (type I64))
      (parameter create block (type OwnedI64Cell) (use borrow)) (returns I64)
      (body (sequence (call burn (local rounds))
        (if (local fail) (call divide (i64 1) (i64 0)) (call read-cell (local block))))))
    (function create inspect-buffer (visibility public) (effect pure)
      (parameter create fail (type Bool)) (parameter create rounds (type I64))
      (parameter create block (type ByteBuffer) (use borrow)) (returns I64)
      (body (sequence (call burn (local rounds))
        (if (local fail) (call divide (i64 1) (i64 0)) (call length (local block))))))
    (owned-implementation create CellOut (visibility public)
      (contract associated-parallel-consumer::Take) (self Cargo)
      (associated-type assoc_type_c9000000000000000000000000000001 OwnedI64Cell)
      (method method_c9000000000000000000000000000001 take-cell)
      (method method_c9000000000000000000000000000002 inspect-cell))
    (owned-implementation create BufferOut (visibility public)
      (contract associated-parallel-consumer::Take) (self Cargo)
      (associated-type assoc_type_c9000000000000000000000000000001 ByteBuffer)
      (method method_c9000000000000000000000000000001 take-buffer)
      (method method_c9000000000000000000000000000002 inspect-buffer))))
declarations.end

request base=BASE

declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Headers (list Header))
  (type-alias Response (record (body Bytes) (headers Headers) (status I64)))
  (type-alias BodyStream (stream Bytes))
  (type-alias TextValues (list Text))
  (type-alias Query (map Text TextValues))
  (type-alias Request (record (body BodyStream) (headers Headers) (method Text) (path Text) (query Text) (query_parameters Query)))
  (type-alias Handler (task-function (Request) Response (row (requirement $requirement-relay) (requirement $requirement-streams))))
  (module create application (as $module-application)
    (function create content-type-is-nostr (as $function-content-type-is-nostr)
      (visibility private)
      (returns Bool (value))
      (effect pure)
      (body (call std::bool-or (scopes) (local matched) (call std::bool-and (scopes) (call std::text-equal
              (scopes) (field (local header) (name name)) (text "content-type")) (call std::media-type-is
              (scopes) (field (local header) (name value)) (text "application/nostr+json")))))
      (parameter create matched (as $parameter-matched)
        (type Bool)
        (use unrestricted))
      (parameter create header (as $parameter-header)
        (type Header)
        (use unrestricted)))
    (function create handle (as $function-handle)
      (visibility private)
      (returns Response (value))
      (effect (task (requirement $requirement-relay) (requirement $requirement-streams)))
      (body (let (binding remote-response (as $remote-response) (type Response)
            (capability-call $requirement-relay std::HttpClient::get (list Header (record structural (field name (text "accept"))
                  (field value (call std::bytes-from-text (scopes) (text "application/nostr+json")))))))
          (in (if (call std::bool-and (scopes) (call std::i64-equal (scopes) (field (local remote-response)
                    (name status)) (i64 200)) (call std::list-fold-left (types Header Bool) (scopes)
                  (field (local remote-response) (name headers)) (bool false) (function-value $function-content-type-is-nostr
                    (scopes)))) (record structural (field body (field (local remote-response) (name body)))
                (field headers (list Header (record structural (field name (text "content-type")) (field value
                        (call std::bytes-from-text (scopes) (text "application/nostr+json")))))) (field status
                  (i64 200))) (record structural (field body (call std::bytes-from-text (scopes) (text "bad gateway")))
                (field headers (list Header)) (field status (i64 502)))))))
      (parameter create request (as $parameter-request)
        (type Request)
        (use unrestricted)))
    (component create application (as $component-application)
      (visibility package)
      (requirement create relay (as $requirement-relay)
        (interface std::HttpClient)
        (operations std::HttpClient::get)
        (limits (maximum_calls 64 calls)))
      (requirement create streams (as $requirement-streams)
        (interface std::ByteStream)
        (operations std::ByteStream::close std::ByteStream::read-all std::ByteStream::read)
        (limits (maximum_calls 10000 calls)))
      (port create http (as $port-http)
        (type Handler)
        (function $function-handle)))
  )
  (target create serve (as $target-serve)
    (component $component-application)
    (runner http)
    (route create route
      (method GET)
      (path "/relay-info")
      (port $port-http)))
)
declarations.end

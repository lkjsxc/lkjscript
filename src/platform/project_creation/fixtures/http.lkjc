request base=BASE

declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Headers (list Header))
  (type-alias Response (record (body Bytes) (headers Headers) (status I64)))
  (type-alias BodyStream (stream Bytes))
  (type-alias TextValues (list Text))
  (type-alias Query (map Text TextValues))
  (type-alias Request (record (body BodyStream) (headers Headers) (method Text) (path Text) (query Text) (query_parameters Query)))
  (type-alias Handler (task-function (Request) Response (row (requirement $requirement-streams))))
  (module create application (as $module-application)
    (function create status-code (as $function-status-code)
      (visibility private)
      (returns I64 (value))
      (effect pure)
      (body (i64 200)))
    (function create handle (as $function-handle)
      (visibility private)
      (returns Response (value))
      (effect (task (requirement $requirement-streams)))
      (body (record structural (field body (call std::bytes-from-text (scopes) (call std::text-from-static
                (scopes) (call $function-response-text (scopes))))) (field headers (list Header)) (field status
            (call $function-status-code (scopes)))))
      (parameter create request (as $parameter-request)
        (type Request)
        (use unrestricted)))
    (function create response-text (as $function-response-text)
      (visibility private)
      (returns StaticText (value))
      (effect pure)
      (body (static-text "hello from lkjscript")))
    (component create application (as $component-application)
      (visibility package)
      (requirement create streams (as $requirement-streams)
        (interface std::ByteStream)
        (operations std::ByteStream::close std::ByteStream::read-all std::ByteStream::read)
        (limits (maximum_calls 10000 calls)))
      (port create http (as $port-http)
        (type Handler)
        (function $function-handle)))
    (test create status-is-200 (as $test-status-is-200)
      (visibility private)
      (actual (call $function-status-code (scopes)))
      (expected (i64 200)))
  )
  (target create serve (as $target-serve)
    (component $component-application)
    (runner http)
    (route create route
      (method GET)
      (path "/")
      (port $port-http)))
)
declarations.end

  "consumer_cutover": {
    "bbs": "one primary post space plus (created-at,id) index keys, atomically maintained; create expects missing, update exact revision, delete primary and index together, list scans the index and resolves primary records in one snapshot",
    "lkjournal": "actor, session, resource, immutable snapshot, object metadata, lookup, and reconciliation facts moved to explicit graph-owned spaces and indexes; service and worker share one root through distinct namespaces",
    "durable_queue": "separate internal namespace in the same engine with idempotent enqueue, ready order, exact lease/attempt, heartbeat, stale completion rejection, retry, cancellation, inspect, restart, and independent bounds",
    "objects": "200000-byte acceptance object remained in object storage while metadata and reconciliation facts used data"
  },

  "public_contract": {
    "lifecycle_grammar": "data initialize --root PATH | data verify --root PATH | data backup --root PATH --output PATH | data restore --backup PATH --root PATH",
    "lifecycle": {
      "initialize": "validates one root and atomically creates only absent state; matching valid state is unchanged",
      "verify": "reconstructs and validates the complete retained accepted closure without mutation",
      "backup": "pins one head and publishes one create-new canonical logical backup with schema and sorted facts",
      "restore": "accepts a strict backup and absent destination, creates a new physical identity, verifies it, and publishes once"
    },
    "standard_interface": "DataStore",
    "standard_types": [
      "DataKeyPart",
      "DataEntry",
      "DataExpectation",
      "DataScanDirection",
      "DataScanItem",
      "DataScanPage",
      "DataSchema",
      "DataSchemaExpectation"
    ],
    "pure_codec_functions": [
      "data-encode<T>",
      "data-decode-or<T>"
    ],
    "key_parts": {
      "tags": [
        "Bool",
        "I64",
        "Text",
        "Bytes"
      ],
      "order": "lexicographic sequence order; tag order Bool, I64, Text, Bytes; false before true; signed numeric order; UTF-8 byte order; unsigned byte order; strict prefix before extension"
    },
    "operations": [
      "schema-read",
      "schema-set",
      "get",
      "scan",
      "transaction",
      "put",
      "delete"
    ],
    "deployment_adapters": [
      "data",
      "durable_queue_data"
    ],
    "continuation": "opaque and stateless; binds store, revision, namespace/space/prefix selector, direction, limits, and exclusive resume key",
    "entry_revision": "opaque identity prevents ABA; delete and recreate do not satisfy an old expectation"
  },
  "physical_store": {
    "format": "immutable complete revision objects plus one atomic durable HEAD",
    "identity_domain": "separate random physical store identity; never graph, package, artifact, or semantic revision identity",
    "publication": "private staging, create-new immutable object, file and directory synchronization, cross-process writer lock, exact-base recheck, one HEAD visibility change",
    "readers": "pin immutable revisions",
    "history": "all reachable history retained; no compaction, garbage collection, destructive repair, or accepted-file rewrite",
    "catalog": "derived; missing, stale, or corrupt catalog is ignored and rebuilt from verified immutable authority",
    "corruption": "canonical damage, foreign domains, missing reachable objects, malformed links, symlinks, nonregular files, traversal, duplicates, trailing bytes, and exhaustion fail closed",
    "recovery": "backup, restore to an absent new root, verify, then explicit descriptor switch"
  },
  "limits": {

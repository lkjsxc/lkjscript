  (module edit mod_c25e1735449d57cce6fde6804d06edd7 orbloam
    (record create InventorySummary (visibility private)
      (field create nonzero_kinds (type I64))
      (field create total_units (type I64)))
    (function create inventory-step (visibility private)
      (parameter create state (type InventorySummary))
      (parameter create entry (type (record (key Text) (value I64))))
      (returns InventorySummary) (effect pure)
      (body
        (record InventorySummary
          (field InventorySummary::nonzero_kinds
            (if (call std::i64-equal (field (local entry) (name value)) (i64 0))
              (field (local state) InventorySummary::nonzero_kinds)
              (call std::add (field (local state) InventorySummary::nonzero_kinds) (i64 1))))
          (field InventorySummary::total_units
            (call std::add (field (local state) InventorySummary::total_units) (field (local entry) (name value)))))))
    (function create summarize-inventory (visibility private)
      (parameter create inventory (type Inventory))
      (returns InventorySummary) (effect pure)
      (body
        (call std::list-fold-left (types (record (key Text) (value I64)) InventorySummary)
          (call std::map-entries (types Text I64) (local inventory))
          (record InventorySummary (field InventorySummary::nonzero_kinds (i64 0)) (field InventorySummary::total_units (i64 0)))
          (function-value inventory-step))))
    (test create inventory-empty (visibility private)
      (actual (call summarize-inventory (map Text I64)))
      (expected (record InventorySummary (field InventorySummary::nonzero_kinds (i64 0)) (field InventorySummary::total_units (i64 0)))))
    (test create inventory-nonzero (visibility private)
      (actual (call summarize-inventory (map Text I64 (entry (text "wood") (i64 3)) (entry (text "stone") (i64 4)) (entry (text "spent") (i64 0)))))
      (expected (record InventorySummary (field InventorySummary::nonzero_kinds (i64 2)) (field InventorySummary::total_units (i64 7)))))
    (test create inventory-signed (visibility private)

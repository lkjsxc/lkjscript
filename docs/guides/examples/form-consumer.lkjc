request base=CONSUMER_BASE
add.dependency package=LIBRARY_PACKAGE semantic-revision=LIBRARY_REVISION package-revision=LIBRARY_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (use forms LIBRARY_PACKAGE LIBRARY_PACKAGE_REVISION)
  (type-alias Field (record (name Text) (value Text)))
  (type-alias Report (record (valid Bool) (fields (list Field)) (error Text)))
  (type-alias Encoding (record (valid Bool) (body Bytes) (error Text)))
  (type-alias EncodingInput (record (fields (list Field)) (maximum-bytes I64) (maximum-fields I64)))
  (type-alias Selection (record (state Text) (value Text)))
  (type-alias SelectionInput (record (body Bytes) (name Text)))
  (module create consumer
    (function create plain-field (visibility private)
      (parameter create field (type forms::field)) (returns Field) (effect pure)
      (body (record structural (field name (field (local field) forms::field::name))
        (field value (field (local field) forms::field::value)))))
    (function create report (visibility public)
      (parameter create body (type Bytes)) (parameter create maximum-bytes (type I64))
      (parameter create maximum-fields (type I64)) (returns Report) (effect pure)
      (body (match (call forms::decode (local body) (local maximum-bytes) (local maximum-fields))
        (arm forms::result::valid (payload fields (list forms::field))
          (record structural (field valid (bool true))
            (field fields (call std::list-map (types forms::field Field)
              (local fields) (function-value plain-field)))
            (field error (text ""))))
        (arm forms::result::invalid (payload error Text)
          (record structural (field valid (bool false)) (field fields (list Field))
            (field error (local error)))))))
    (function create one (visibility private)
      (parameter create body (type Bytes)) (returns Report) (effect pure)
      (body (call report (local body) (i64 8192) (i64 64))))
    (function create batch (visibility public)
      (parameter create bodies (type (list Bytes))) (returns (list Report)) (effect pure)
      (body (call std::list-map (types Bytes Report) (local bodies) (function-value one))))
    (function create native-field (visibility private)
      (parameter create item (type Field)) (returns forms::field) (effect pure)
      (body (record forms::field
        (field forms::field::name (field (local item) (name name)))
        (field forms::field::value (field (local item) (name value))))))
    (function create encode (visibility public)
      (parameter create fields (type (list Field))) (parameter create maximum-bytes (type I64))
      (parameter create maximum-fields (type I64)) (returns Encoding) (effect pure)
      (body (match (call forms::encode
          (call std::list-map (types Field forms::field) (local fields) (function-value native-field))
          (local maximum-bytes) (local maximum-fields))
        (arm forms::encoding::valid (payload body Bytes)
          (record structural (field valid (bool true)) (field body (local body)) (field error (text ""))))
        (arm forms::encoding::invalid (payload error Text)
          (record structural (field valid (bool false))
            (field body (call std::bytes-from-text (text ""))) (field error (local error)))))))
    (function create encode-one (visibility private)
      (parameter create input (type EncodingInput)) (returns Encoding) (effect pure)
      (body (call encode (field (local input) (name fields))
        (field (local input) (name maximum-bytes)) (field (local input) (name maximum-fields)))))
    (function create encode-batch (visibility public)
      (parameter create inputs (type (list EncodingInput))) (returns (list Encoding)) (effect pure)
      (body (call std::list-map (types EncodingInput Encoding) (local inputs) (function-value encode-one))))
    (function create selected (visibility private)
      (parameter create value (type forms::selection)) (returns Selection) (effect pure)
      (body (match (local value)
        (arm forms::selection::missing
          (record structural (field state (text "missing")) (field value (text ""))))
        (arm forms::selection::present (payload text Text)
          (record structural (field state (text "present")) (field value (local text))))
        (arm forms::selection::repeated
          (record structural (field state (text "repeated")) (field value (text "")))))))
    (function create lookup (visibility public)
      (parameter create fields (type (list Field))) (parameter create name (type Text))
      (returns Selection) (effect pure)
      (body (call selected (call forms::lookup
        (call std::list-map (types Field forms::field) (local fields) (function-value native-field))
        (local name)))))
    (function create select-one (visibility private)
      (parameter create input (type SelectionInput)) (returns Selection) (effect pure)
      (body (match (call forms::decode (field (local input) (name body)) (i64 8192) (i64 64))
        (arm forms::result::valid (payload fields (list forms::field))
          (call selected (call forms::lookup (local fields) (field (local input) (name name)))))
        (arm forms::result::invalid (payload error Text)
          (record structural (field state (text "invalid")) (field value (local error)))))))
    (function create select-batch (visibility public)
      (parameter create inputs (type (list SelectionInput))) (returns (list Selection)) (effect pure)
      (body (call std::list-map (types SelectionInput Selection)
        (local inputs) (function-value select-one))))
    (component create console (visibility private)
      (port create lookup (type (function ((list Field) Text) Selection)) (function lookup))
      (port create select-batch (type (function ((list SelectionInput)) (list Selection))) (function select-batch))
      (port create encode (type (function ((list Field) I64 I64) Encoding)) (function encode))
      (port create encode-batch (type (function ((list EncodingInput)) (list Encoding))) (function encode-batch))
      (port create report (type (function (Bytes I64 I64) Report)) (function report))
      (port create batch (type (function ((list Bytes)) (list Report))) (function batch))))
  (target create lookup (component consumer::console) (runner command) (port consumer::console::lookup))
  (target create select-batch (component consumer::console) (runner command) (port consumer::console::select-batch))
  (target create encode (component consumer::console) (runner command) (port consumer::console::encode))
  (target create encode-batch (component consumer::console) (runner command) (port consumer::console::encode-batch))
  (target create report (component consumer::console) (runner command) (port consumer::console::report))
  (target create batch (component consumer::console) (runner command) (port consumer::console::batch)))
declarations.end

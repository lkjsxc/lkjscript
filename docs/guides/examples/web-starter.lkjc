request base=STARTER_BASE

declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (module create web
    (function create page-title (visibility private)
      (returns Text) (effect pure)
      (body (text "My lkjscript app")))
    (function create query-value (visibility private)
      (parameter create query (type (map Text (list Text))))
      (parameter create name (type Text)) (parameter create fallback (type Text))
      (returns Text) (effect pure)
      (body (let (binding values (call std::map-get-or (types Text (list Text))
        (local query) (local name) (list Text)))
        (in (if (call std::less (i64 0) (call std::list-length (types Text) (local values)))
          (call std::list-get (types Text) (local values) (i64 0)) (local fallback))))))
    (function create selected-theme (visibility private)
      (parameter create name (type Text)) (returns ui::theme) (effect pure)
      (body (if (call std::text-equal (local name) (text "dark"))
        (variant ui::theme::dark) (variant ui::theme::light))))
    (function create greeting (visibility private)
      (parameter create name (type Text)) (returns Text) (effect pure)
      (body (call std::text-concat (text "Hello, ") (local name))))
    (function create controls (visibility private)
      (parameter create name (type Text)) (returns ui::query-form) (effect pure)
      (body (record ui::query-form
        (field ui::query-form::title (text "Make this page yours"))
        (field ui::query-form::inputs (list ui::input
          (record ui::input (field ui::input::name (text "name"))
            (field ui::input::label (text "Your name"))
            (field ui::input::value (local name)))))
        (field ui::query-form::buttons (list ui::button
          (record ui::button (field ui::button::name (text "theme"))
            (field ui::button::value (text "light")) (field ui::button::label (text "Apply light theme")))
          (record ui::button (field ui::button::name (text "theme"))
            (field ui::button::value (text "dark")) (field ui::button::label (text "Apply dark theme"))))))))
    (function create screen (visibility private)
      (parameter create name (type Text)) (parameter create theme (type ui::theme))
      (returns Text) (effect pure)
      (body (call ui::document (text "en") (call page-title) (local theme) (list ui::node
        (variant ui::node::paragraph (text "An editable web app, built with ordinary lkjscript."))
        (variant ui::node::card (list ui::node
          (variant ui::node::heading (call greeting (local name)))
          (variant ui::node::query-form (call controls (local name)))))
        (variant ui::node::paragraph (text "Submit to rebuild this page from its URL. No JavaScript or saved server state."))
        (variant ui::node::paragraph (text "Do not enter secrets: form values appear in the URL."))))))
    (function create header (visibility private)
      (parameter create name (type Text)) (parameter create value (type Text))
      (returns Header) (effect pure)
      (body (record structural (field name (local name))
        (field value (call std::bytes-from-text (local value))))))
    (function create response-headers (visibility private)
      (returns (list Header)) (effect pure)
      (body (list Header
        (call header (text "content-type") (text "text/html; charset=utf-8"))
        (call header (text "x-content-type-options") (text "nosniff"))
        (call header (text "content-security-policy")
          (text "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"))
        (call header (text "referrer-policy") (text "same-origin"))
        (call header (text "cache-control") (text "no-store")))))
    (function create response (visibility private)
      (parameter create query (type (map Text (list Text)))) (returns Response) (effect pure)
      (body (record structural
        (field body (call std::bytes-from-text (call screen
          (call query-value (local query) (text "name") (text "friend"))
          (call selected-theme (call query-value (local query) (text "theme") (text "light"))))))
        (field headers (call response-headers))
        (field status (i64 200)))))
    (function create home (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::streams)))
      (body (call response (field (local request) (name query_parameters)))))
    (component create server (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (port create home (type (task-function (Request) Response (row (requirement streams))))
        (function home)))
    (test create missing-value (visibility private)
      (actual (call query-value (map Text (list Text)) (text "name") (text "friend")))
      (expected (text "friend")))
    (test create first-and-empty-value (visibility private)
      (actual (call query-value (map Text (list Text)
        (entry (text "name") (list Text (text "") (text "ignored"))))
        (text "name") (text "friend"))) (expected (text "")))
    (test create empty-list-value (visibility private)
      (actual (call query-value (map Text (list Text)
        (entry (text "name") (list Text))) (text "name") (text "friend")))
      (expected (text "friend")))
    (test create unicode-name (visibility private)
      (actual (call query-value (map Text (list Text)
        (entry (text "name") (list Text (text "日本語🌱")))) (text "name") (text "friend")))
      (expected (text "日本語🌱")))
    (test create dark-selected (visibility private)
      (actual (call selected-theme (text "dark"))) (expected (variant ui::theme::dark)))
    (test create unknown-theme (visibility private)
      (actual (call selected-theme (text "other"))) (expected (variant ui::theme::light)))
    (test create empty-theme (visibility private)
      (actual (call selected-theme (text ""))) (expected (variant ui::theme::light)))
    (test create case-sensitive-theme (visibility private)
      (actual (call selected-theme (text "DARK"))) (expected (variant ui::theme::light)))
    (test create greeting-name (visibility private)
      (actual (call greeting (text "friend"))) (expected (text "Hello, friend")))
    (test create greeting-empty (visibility private)
      (actual (call greeting (text ""))) (expected (text "Hello, ")))
    (test create header-bytes (visibility private)
      (actual (call header (text "test") (text "value")))
      (expected (record structural (field name (text "test"))
        (field value (call std::bytes-from-text (text "value"))))))
    (test create ok-status (visibility private)
      (actual (field (call response (map Text (list Text))) (name status))) (expected (i64 200)))
    (test create fixed-headers (visibility private)
      (actual (call response-headers))
      (expected (list Header
        (call header (text "content-type") (text "text/html; charset=utf-8"))
        (call header (text "x-content-type-options") (text "nosniff"))
        (call header (text "content-security-policy")
          (text "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"))
        (call header (text "referrer-policy") (text "same-origin"))
        (call header (text "cache-control") (text "no-store"))))))
  (target create serve (component web::server) (runner http)
    (route create home (method GET) (path "/") (port web::server::home))))
declarations.end

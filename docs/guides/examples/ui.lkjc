request base=LIBRARY_BASE

declarations.begin
(units
  (use std builtin)
  (module create ui
    (variant create theme (visibility public)
      (case create light) (case create dark))
    (variant create spacing (visibility public)
      (case create compact) (case create comfortable))
    (record create input (visibility public)
      (field create name (type Text)) (field create label (type Text))
      (field create value (type Text)))
    (record create button (visibility public)
      (field create name (type Text)) (field create value (type Text))
      (field create label (type Text)))
    (record create query-form (visibility public)
      (field create title (type Text)) (field create inputs (type (list input)))
      (field create buttons (type (list button))))
    (record create hidden-input (visibility public)
      (field create name (type Text)) (field create value (type Text)))
    (record create action-form (visibility public)
      (field create title (type Text)) (field create inputs (type (list input)))
      (field create multiline (type (list input)))
      (field create hidden (type (list hidden-input)))
      (field create buttons (type (list button))))
    (record create stack (visibility public)
      (field create spacing (type spacing)) (field create children (type (list node))))
    (variant create node (visibility public)
      (case create heading (payload Text)) (case create paragraph (payload Text))
      (case create stack (payload stack)) (case create card (payload (list node)))
      (case create query-form (payload query-form))
      (case create action-form (payload action-form)) (case create text-block (payload Text)))
    (function create join-range (visibility private)
      (parameter create chunks (type (list Text)))
      (parameter create start (type I64)) (parameter create count (type I64))
      (returns Text) (effect pure)
      (body (if (call std::i64-equal (local count) (i64 0)) (text "")
        (if (call std::i64-equal (local count) (i64 1))
          (call std::list-get (types Text) (local chunks) (local start))
          (let (binding half (call std::divide (local count) (i64 2)))
            (in (call std::text-concat
              (call join-range (local chunks) (local start) (local half))
              (call join-range (local chunks) (call std::add (local start) (local half))
                (call std::subtract (local count) (local half))))))))))
    (function create join (visibility private)
      (parameter create chunks (type (list Text))) (returns Text) (effect pure)
      (body (call join-range (local chunks) (i64 0)
        (call std::list-length (types Text) (local chunks)))))
    (function create render-input (visibility public)
      (parameter create value (type input)) (returns Text) (effect pure)
      (body (call join (list Text (text "<label><span>")
        (call std::html-escape-text (field (local value) input::label))
        (text "</span><input type=\"text\" name=\"")
        (call std::html-escape-text (field (local value) input::name))
        (text "\" value=\"")
        (call std::html-escape-text (field (local value) input::value))
        (text "\"></label>")))))
    (function create render-button (visibility public)
      (parameter create value (type button)) (returns Text) (effect pure)
      (body (call join (list Text (text "<button type=\"submit\" name=\"")
        (call std::html-escape-text (field (local value) button::name))
        (text "\" value=\"")
        (call std::html-escape-text (field (local value) button::value))
        (text "\">")
        (call std::html-escape-text (field (local value) button::label))
        (text "</button>")))))
    (function create render-form (visibility public)
      (parameter create value (type query-form)) (returns Text) (effect pure)
      (body (call join (list Text
        (text "<form method=\"get\" accept-charset=\"UTF-8\"><fieldset><legend>")
        (call std::html-escape-text (field (local value) query-form::title))
        (text "</legend><div class=\"stack comfortable\">")
        (call join (call std::list-map (types input Text)
          (field (local value) query-form::inputs) (function-value render-input)))
        (text "<div class=\"actions\">")
        (call join (call std::list-map (types button Text)
          (field (local value) query-form::buttons) (function-value render-button)))
        (text "</div></div></fieldset></form>")))))
    (function create render-hidden (visibility public)
      (parameter create value (type hidden-input)) (returns Text) (effect pure)
      (body (call join (list Text (text "<input type=\"hidden\" name=\"")
        (call std::html-escape-text (field (local value) hidden-input::name))
        (text "\" value=\"")
        (call std::html-escape-text (field (local value) hidden-input::value)) (text "\">")))))
    (function create render-multiline (visibility public)
      (parameter create value (type input)) (returns Text) (effect pure)
      (body (call join (list Text (text "<label><span>")
        (call std::html-escape-text (field (local value) input::label))
        (text "</span><textarea rows=\"12\" name=\"")
        (call std::html-escape-text (field (local value) input::name)) (text "\">\n")
        (call std::html-escape-text (field (local value) input::value))
        (text "</textarea></label>")))))
    (function create render-action-form (visibility public)
      (parameter create value (type action-form)) (returns Text) (effect pure)
      (body (call join (list Text
        (text "<form method=\"post\" accept-charset=\"UTF-8\">")
        (call join (call std::list-map (types hidden-input Text)
          (field (local value) action-form::hidden) (function-value render-hidden)))
        (text "<fieldset><legend>")
        (call std::html-escape-text (field (local value) action-form::title))
        (text "</legend><div class=\"stack comfortable\">")
        (call join (call std::list-map (types input Text)
          (field (local value) action-form::inputs) (function-value render-input)))
        (call join (call std::list-map (types input Text)
          (field (local value) action-form::multiline) (function-value render-multiline)))
        (text "<div class=\"actions\">")
        (call join (call std::list-map (types button Text)
          (field (local value) action-form::buttons) (function-value render-button)))
        (text "</div></div></fieldset></form>")))))
    (function create spacing-name (visibility public)
      (parameter create value (type spacing)) (returns Text) (effect pure)
      (body (match (local value)
        (arm spacing::compact (text "compact"))
        (arm spacing::comfortable (text "comfortable")))))
    (function create theme-name (visibility public)
      (parameter create value (type theme)) (returns Text) (effect pure)
      (body (match (local value)
        (arm theme::light (text "light")) (arm theme::dark (text "dark")))))
    (function create render-node (visibility public)
      (parameter create value (type node)) (returns Text) (effect pure)
      (body (match (local value)
        (arm node::heading (payload value Text)
          (call join (list Text (text "<h2>") (call std::html-escape-text (local value)) (text "</h2>"))))
        (arm node::paragraph (payload value Text)
          (call join (list Text (text "<p>") (call std::html-escape-text (local value)) (text "</p>"))))
        (arm node::card (payload nodes (list node))
          (call join (list Text (text "<section class=\"card stack comfortable\">")
            (call render-nodes (local nodes)) (text "</section>"))))
        (arm node::stack (payload value stack)
          (call join (list Text (text "<div class=\"stack ")
            (call spacing-name (field (local value) stack::spacing))
            (text "\">") (call render-nodes (field (local value) stack::children))
            (text "</div>"))))
        (arm node::query-form (payload value query-form) (call render-form (local value)))
        (arm node::action-form (payload value action-form) (call render-action-form (local value)))
        (arm node::text-block (payload value Text)
          (call join (list Text (text "<pre class=\"text-block\">\n")
            (call std::html-escape-text (local value)) (text "</pre>")))))))
    (function create render-nodes (visibility public)
      (parameter create values (type (list node))) (returns Text) (effect pure)
      (body (call join (call std::list-map (types node Text)
        (local values) (function-value render-node)))))
    (function create stylesheet (visibility public)
      (returns Text) (effect pure)
      (body (call join (list Text
        (text "*{box-sizing:border-box}body{margin:0;font:1rem/1.6 system-ui,sans-serif;background:var(--page);color:var(--ink)}")
        (text ".light{color-scheme:light;--page:#f3f5f8;--card:#fff;--ink:#172333;--muted:#41536b;--line:#8795a8;--accent:#2356b3;--button:#fff}")
        (text ".dark{color-scheme:dark;--page:#111823;--card:#1c2838;--ink:#f0f4fa;--muted:#bccbe0;--line:#8295ae;--accent:#b5d0ff;--button:#142036}")
        (text "main{width:min(100%,52rem);margin-inline:auto;padding:clamp(1rem,4vw,3rem)}h1,h2,p{margin:0;overflow-wrap:anywhere}h1{font-size:clamp(1.8rem,5vw,2.7rem);line-height:1.2}h2{font-size:1.25rem}p{color:var(--muted)}")
        (text ".stack{display:flex;flex-direction:column;min-width:0}.compact{gap:.5rem}.comfortable{gap:1.25rem}.card{background:var(--card);border:1px solid var(--line);border-radius:1rem;padding:clamp(1rem,3vw,1.75rem)}")
        (text "fieldset{min-width:0;margin:0;padding:0;border:0}legend{font-weight:650;margin-bottom:1rem;overflow-wrap:anywhere}label{display:flex;flex-direction:column;gap:.4rem;min-width:0}label span{overflow-wrap:anywhere}")
        (text "input,textarea,button{font:inherit;border:1px solid var(--line);border-radius:.5rem;padding:.7rem .9rem;min-height:2.75rem}input,textarea{width:100%;min-width:0;background:var(--card);color:var(--ink)}textarea{resize:vertical}.text-block{font:inherit;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}button{background:var(--accent);color:var(--button);cursor:pointer;max-width:100%;overflow-wrap:anywhere}")
        (text ".actions{display:flex;flex-wrap:wrap;gap:.75rem}input:focus-visible,textarea:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}@media(forced-colors:active){input,textarea,button,.card{border:1px solid CanvasText}}")))))
    (function create document (visibility public)
      (parameter create language (type Text)) (parameter create title (type Text))
      (parameter create theme (type theme)) (parameter create nodes (type (list node)))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<!doctype html><html lang=\"")
        (call std::html-escape-text (local language))
        (text "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>")
        (call std::html-escape-text (local title)) (text "</title><style>")
        (call stylesheet) (text "</style></head><body class=\"")
        (call theme-name (local theme)) (text "\"><main class=\"stack comfortable\"><h1>")
        (call std::html-escape-text (local title)) (text "</h1>")
        (call render-nodes (local nodes)) (text "</main></body></html>")))))))
declarations.end

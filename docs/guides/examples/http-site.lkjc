request base=SITE_BASE
add.dependency package=LIBRARY_PACKAGE semantic-revision=LIBRARY_REVISION package-revision=LIBRARY_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (use replies LIBRARY_PACKAGE LIBRARY_PACKAGE_REVISION)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Request (record
    (body (stream Bytes)) (headers (list Header)) (method Text)
    (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (module create site
    (function create first-name (visibility private)
      (parameter create query (type (map Text (list Text))))
      (returns Text) (effect pure)
      (body (let
        (binding names (call std::map-get-or (types Text (list Text))
          (local query) (text "name") (list Text)))
        (in (if (call std::less (i64 0) (call std::list-length (types Text) (local names)))
          (call std::list-get (types Text) (local names) (i64 0))
          (text "world"))))))
    (function create greeting (visibility private)
      (parameter create name (type Text))
      (returns Response) (effect pure)
      (body (call replies::plain (i64 200)
        (call std::text-concat (text "Hello, ") (local name)))))
    (function create home (visibility private)
      (parameter create request (type Request))
      (returns Response) (effect (task))
      (body (call replies::respond (i64 200) (text "text/html; charset=utf-8")
        (call std::bytes-from-text
          (text "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><title>Native lkjscript HTTP</title><main><h1>Native lkjscript HTTP</h1><p>This service is authored with ordinary native declarations and an imported response library.</p><p><a href=\"/health\">Health</a> · <a href=\"/greet?name=lkjscript\">Greeting</a></p><form action=\"/greet\" method=\"get\"><label>Name <input name=\"name\" value=\"world\"></label><button>Greet</button></form><p>POST bytes to <code>/echo</code> to receive them unchanged. The request-body limit is 1 MiB.</p></main></html>")))))
    (function create health (visibility private)
      (parameter create request (type Request))
      (returns Response) (effect (task))
      (body (call replies::with-header (call replies::plain (i64 200) (text "ready"))
        (text "cache-control") (text "no-store"))))
    (function create greet (visibility private)
      (parameter create request (type Request))
      (returns Response) (effect (task))
      (body (call greeting (call first-name (field (local request) (name query_parameters))))))
    (function create echo (visibility private)
      (parameter create request (type Request))
      (returns Response) (effect (task (requirement server::streams)))
      (body (call replies::respond (i64 200) (text "application/octet-stream")
        (capability-call server::streams std::ByteStream::read-all
          (field (local request) (name body)) (i64 1048576)))))
    (component create server (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (port create home (type (task-function (Request) Response (row))) (function home))
      (port create health (type (task-function (Request) Response (row))) (function health))
      (port create greet (type (task-function (Request) Response (row))) (function greet))
      (port create echo (type (task-function (Request) Response (row (requirement streams))))
        (function echo)))
    (test create absent-name (visibility private)
      (actual (call first-name (map Text (list Text)))) (expected (text "world")))
    (test create first-repeated-name (visibility private)
      (actual (call first-name (map Text (list Text)
        (entry (text "name") (list Text (text "Ada") (text "Grace"))))))
      (expected (text "Ada")))
    (test create explicit-empty-name (visibility private)
      (actual (call first-name (map Text (list Text)
        (entry (text "name") (list Text (text ""))))))
      (expected (text "")))
    (test create empty-list-name (visibility private)
      (actual (call first-name (map Text (list Text)
        (entry (text "name") (list Text))))) (expected (text "world")))
    (test create greeting-preserves-text (visibility private)
      (actual (field (call greeting (text "<script>&日本語")) (name body)))
      (expected (call std::bytes-from-text (text "Hello, <script>&日本語")))))
  (target create web (component site::server) (runner http)
    (route create home (method GET) (path "/") (port site::server::home))
    (route create health (method GET) (path "/health") (port site::server::health))
    (route create greet (method GET) (path "/greet") (port site::server::greet))
    (route create echo (method POST) (path "/echo") (port site::server::echo))))
declarations.end

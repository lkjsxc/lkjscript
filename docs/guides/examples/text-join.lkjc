request base=BASE

declarations.begin
(units
  (use std builtin)
  (module create text-output
    (record create JoinInput (visibility public)
      (field create items (type (list Text)))
      (field create separator (type Text)))
    (function create join (visibility public)
      (parameter create items (type (list Text)))
      (parameter create separator (type Text))
      (returns Text) (effect pure)
      (body (call std::text-join (local items) (local separator))))
    (function create join-input (visibility private)
      (parameter create input (type JoinInput))
      (returns Text) (effect pure)
      (body (call join (field (local input) JoinInput::items)
        (field (local input) JoinInput::separator))))
    (function create batch (visibility public)
      (parameter create inputs (type (list JoinInput)))
      (returns (list Text)) (effect pure)
      (body (call std::list-map (types JoinInput Text) (local inputs)
        (function-value join-input))))
    (function create escaped (visibility public)
      (parameter create items (type (list Text)))
      (returns Text) (effect pure)
      (body (call join (call std::list-map (types Text Text) (local items)
        (function-value std::html-escape-text)) (text "<br>"))))
    (test create literal-separators (visibility private)
      (actual (call join (list Text (text "") (text "日本語") (text "")) (text ":")))
      (expected (text ":日本語:")))
    (test create separate-escaping-policy (visibility private)
      (actual (call escaped (list Text (text "<tag>") (text "&"))))
      (expected (text "&lt;tag&gt;<br>&amp;")))
    (component create console (visibility private)
      (port create join (type (function ((list Text) Text) Text)) (function join))
      (port create batch (type (function ((list JoinInput)) (list Text))) (function batch))
      (port create escaped (type (function ((list Text)) Text)) (function escaped))))
  (target create join (component text-output::console) (runner command) (port text-output::console::join))
  (target create batch (component text-output::console) (runner command) (port text-output::console::batch))
  (target create escaped (component text-output::console) (runner command) (port text-output::console::escaped)))
declarations.end

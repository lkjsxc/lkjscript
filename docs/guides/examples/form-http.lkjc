request base=SITE_BASE
add.dependency package=CONSUMER_PACKAGE semantic-revision=CONSUMER_REVISION package-revision=CONSUMER_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (use decoder CONSUMER_PACKAGE CONSUMER_PACKAGE_REVISION)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (type-alias Field (record (name Text) (value Text)))
  (type-alias Report (record (valid Bool) (fields (list Field)) (error Text)))
  (module create form-service
    (function create header (visibility private)
      (parameter create name (type Text)) (parameter create value (type Text))
      (returns Header) (effect pure)
      (body (record structural (field name (local name))
        (field value (call std::bytes-from-text (local value))))))
    (function create reply (visibility private)
      (parameter create status (type I64)) (parameter create report (type Report))
      (returns Response) (effect pure)
      (body (record structural
        (field status (local status)) (field body (call std::json-encode (types Report) (local report)))
        (field headers (list Header
          (call header (text "content-type") (text "application/json; charset=utf-8"))
          (call header (text "cache-control") (text "no-store"))
          (call header (text "x-content-type-options") (text "nosniff")))))))
    (function create count-type (visibility private)
      (parameter create count (type I64)) (parameter create item (type Header))
      (returns I64) (effect pure)
      (body (if (call std::text-equal (field (local item) (name name)) (text "content-type"))
        (if (call std::i64-equal (local count) (i64 0))
          (if (call std::bool-or
            (call std::bytes-equal (field (local item) (name value))
              (call std::bytes-from-text (text "application/x-www-form-urlencoded")))
            (call std::bytes-equal (field (local item) (name value))
              (call std::bytes-from-text (text "application/x-www-form-urlencoded; charset=UTF-8"))))
            (i64 1) (i64 -1)) (i64 -1)) (local count))))
    (function create handle (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::streams)))
      (body (if (call std::i64-equal (call std::list-fold-left (types Header I64)
          (field (local request) (name headers)) (i64 0) (function-value count-type)) (i64 1))
        (let
          (binding body (capability-call server::streams std::ByteStream::read-all
            (field (local request) (name body)) (i64 8192)))
          (binding report (call decoder::report (local body) (i64 8192) (i64 64)))
          (in (call reply (if (field (local report) (name valid)) (i64 200) (i64 400)) (local report))))
        (call reply (i64 415) (record structural (field valid (bool false))
          (field fields (list Field)) (field error (text "unsupported content type")))))))
    (component create server (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (port create handle (type (task-function (Request) Response (row (requirement streams))))
        (function handle)))
    (test create supported-type (visibility private)
      (actual (call count-type (i64 0)
        (call header (text "content-type") (text "application/x-www-form-urlencoded"))))
      (expected (i64 1)))
    (test create duplicate-type (visibility private)
      (actual (call count-type (i64 1)
        (call header (text "content-type") (text "application/x-www-form-urlencoded"))))
      (expected (i64 -1)))
    (test create foreign-type (visibility private)
      (actual (call count-type (i64 0) (call header (text "content-type") (text "application/json"))))
      (expected (i64 -1))))
  (target create form-http (component form-service::server) (runner http)
    (route create decode (method POST) (path "/decode") (port form-service::server::handle))))
declarations.end

request base=LIBRARY_BASE

declarations.begin
(units
  (use std builtin)
  (module create forms
    (record create field (visibility public)
      (field create name (type Text)) (field create value (type Text)))
    (variant create result (visibility public)
      (case create valid (payload (list field))) (case create invalid (payload Text)))
    (function create hex (visibility private)
      (parameter create octet (type I64)) (returns I64) (effect pure)
      (body (if (call std::bool-and (call std::less-equal (i64 48) (local octet))
                  (call std::less-equal (local octet) (i64 57)))
        (call std::subtract (local octet) (i64 48))
        (if (call std::bool-and (call std::less-equal (i64 65) (local octet))
              (call std::less-equal (local octet) (i64 70)))
          (call std::subtract (local octet) (i64 55))
          (if (call std::bool-and (call std::less-equal (i64 97) (local octet))
                (call std::less-equal (local octet) (i64 102)))
            (call std::subtract (local octet) (i64 87)) (i64 -1))))))
    (function create finish (visibility private)
      (parameter create body (type Bytes)) (parameter create next (type I64))
      (parameter create limit (type I64)) (parameter create fields (type (list field)))
      (parameter create name (type (list I64))) (parameter create value (type (list I64)))
      (parameter create present (type Bool)) (returns result) (effect pure)
      (body (if (local present)
        (if (call std::less (call std::list-length (types field) (local fields)) (local limit))
          (let
            (binding key (call std::bytes-to-text-result (call std::bytes-from-list (local name))))
            (binding item (call std::bytes-to-text-result (call std::bytes-from-list (local value))))
            (in (if (call std::bool-and (field (local key) (name valid))
                      (field (local item) (name valid)))
              (call start (local body) (local next) (local limit)
                (call std::list-append (types field) (local fields)
                  (record field (field field::name (field (local key) (name value)))
                    (field field::value (field (local item) (name value))))))
              (variant result::invalid (text "invalid UTF-8")))))
          (variant result::invalid (text "too many fields")))
        (call start (local body) (local next) (local limit) (local fields)))))
    (function create start (visibility private)
      (parameter create body (type Bytes)) (parameter create index (type I64))
      (parameter create limit (type I64)) (parameter create fields (type (list field)))
      (returns result) (effect pure)
      (body (if (call std::less (local index) (call std::bytes-length (local body)))
        (call read (local body) (local index) (local limit) (local fields)
          (list I64) (list I64) (bool false) (bool false))
        (variant result::valid (local fields)))))
    (function create append (visibility private)
      (parameter create body (type Bytes)) (parameter create next (type I64))
      (parameter create limit (type I64)) (parameter create fields (type (list field)))
      (parameter create name (type (list I64))) (parameter create value (type (list I64)))
      (parameter create in-value (type Bool)) (parameter create octet (type I64))
      (returns result) (effect pure)
      (body (if (local in-value)
        (call read (local body) (local next) (local limit) (local fields) (local name)
          (call std::list-append (types I64) (local value) (local octet)) (bool true) (bool true))
        (call read (local body) (local next) (local limit) (local fields)
          (call std::list-append (types I64) (local name) (local octet)) (local value)
          (bool false) (bool true)))))
    (function create escaped (visibility private)
      (parameter create body (type Bytes)) (parameter create index (type I64))
      (parameter create limit (type I64)) (parameter create fields (type (list field)))
      (parameter create name (type (list I64))) (parameter create value (type (list I64)))
      (parameter create in-value (type Bool)) (returns result) (effect pure)
      (body (if (call std::less (call std::add (local index) (i64 2))
                  (call std::bytes-length (local body)))
        (let
          (binding high (call hex (call std::bytes-get (local body) (call std::add (local index) (i64 1)))))
          (binding low (call hex (call std::bytes-get (local body) (call std::add (local index) (i64 2)))))
          (in (if (call std::bool-and (call std::less-equal (i64 0) (local high))
                    (call std::less-equal (i64 0) (local low)))
            (call append (local body) (call std::add (local index) (i64 3)) (local limit)
              (local fields) (local name) (local value) (local in-value)
              (call std::add (call std::multiply (local high) (i64 16)) (local low)))
            (variant result::invalid (text "invalid percent escape")))))
        (variant result::invalid (text "invalid percent escape")))))
    (function create read (visibility private)
      (parameter create body (type Bytes)) (parameter create index (type I64))
      (parameter create limit (type I64)) (parameter create fields (type (list field)))
      (parameter create name (type (list I64))) (parameter create value (type (list I64)))
      (parameter create in-value (type Bool)) (parameter create present (type Bool))
      (returns result) (effect pure)
      (body (if (call std::less (local index) (call std::bytes-length (local body)))
        (let (binding octet (call std::bytes-get (local body) (local index)))
          (binding next (call std::add (local index) (i64 1)))
          (in (if (call std::i64-equal (local octet) (i64 38))
            (call finish (local body) (local next) (local limit) (local fields)
              (local name) (local value) (local present))
            (if (call std::bool-and (call std::i64-equal (local octet) (i64 61))
                  (call std::bool-not (local in-value)))
              (call read (local body) (local next) (local limit) (local fields)
                (local name) (local value) (bool true) (bool true))
              (if (call std::i64-equal (local octet) (i64 37))
                (call escaped (local body) (local index) (local limit) (local fields)
                  (local name) (local value) (local in-value))
                (call append (local body) (local next) (local limit) (local fields)
                  (local name) (local value) (local in-value)
                  (if (call std::i64-equal (local octet) (i64 43)) (i64 32) (local octet))))))))
        (call finish (local body) (local index) (local limit) (local fields)
          (local name) (local value) (local present)))))
    (function create decode (visibility public)
      (parameter create body (type Bytes)) (parameter create maximum-bytes (type I64))
      (parameter create maximum-fields (type I64)) (returns result) (effect pure)
      (body (if (call std::bool-and (call std::less-equal (i64 0) (local maximum-bytes))
                  (call std::less-equal (i64 0) (local maximum-fields)))
        (if (call std::less-equal (call std::bytes-length (local body)) (local maximum-bytes))
          (call start (local body) (i64 0) (local maximum-fields) (list field))
          (variant result::invalid (text "body too large")))
        (variant result::invalid (text "invalid limits")))))
    (function create single (visibility private)
      (parameter create name (type Text)) (parameter create value (type Text))
      (returns result) (effect pure)
      (body (variant result::valid (list field
        (record field (field field::name (local name)) (field field::value (local value)))))))
    (function create sample (visibility private)
      (parameter create input (type Text)) (returns result) (effect pure)
      (body (call decode (call std::bytes-from-text (local input)) (i64 8192) (i64 16))))
    (test create empty (visibility private)
      (actual (call sample (text ""))) (expected (variant result::valid (list field))))
    (test create empty-segments (visibility private)
      (actual (call sample (text "&&&"))) (expected (variant result::valid (list field))))
    (test create bare-name (visibility private)
      (actual (call sample (text "name"))) (expected (call single (text "name") (text ""))))
    (test create empty-value (visibility private)
      (actual (call sample (text "name="))) (expected (call single (text "name") (text ""))))
    (test create empty-name (visibility private)
      (actual (call sample (text "=value"))) (expected (call single (text "") (text "value"))))
    (test create both-empty (visibility private)
      (actual (call sample (text "="))) (expected (call single (text "") (text ""))))
    (test create only-first-equals (visibility private)
      (actual (call sample (text "name=a=b=c"))) (expected (call single (text "name") (text "a=b=c"))))
    (test create encoded-delimiters (visibility private)
      (actual (call sample (text "n%3Da=a%26b%3dc"))) (expected (call single (text "n=a") (text "a&b=c"))))
    (test create plus-and-percent (visibility private)
      (actual (call sample (text "a+b=+%2b%25%252B"))) (expected (call single (text "a b") (text " +%%2B"))))
    (test create unicode-raw (visibility private)
      (actual (call sample (text "名前=猫"))) (expected (call single (text "名前") (text "猫"))))
    (test create unicode-encoded (visibility private)
      (actual (call sample (text "note=%E6%97%A5%E6%9C%AC%E8%AA%9E")))
      (expected (call single (text "note") (text "日本語"))))
    (test create emoji-encoded (visibility private)
      (actual (call sample (text "note=%f0%9F%98%80"))) (expected (call single (text "note") (text "😀"))))
    (test create controls-preserved (visibility private)
      (actual (call sample (text "a=%00%0d%0A"))) (expected (call single (text "a") (text "\u{0}\r\n"))))
    (test create duplicate-order (visibility private)
      (actual (call sample (text "a=first&&a=last&")))
      (expected (variant result::valid (list field
        (record field (field field::name (text "a")) (field field::value (text "first")))
        (record field (field field::name (text "a")) (field field::value (text "last")))))))
    (test create percent-incomplete (visibility private)
      (actual (call sample (text "a=%"))) (expected (variant result::invalid (text "invalid percent escape"))))
    (test create percent-one-digit (visibility private)
      (actual (call sample (text "a=%2"))) (expected (variant result::invalid (text "invalid percent escape"))))
    (test create percent-invalid-digit (visibility private)
      (actual (call sample (text "a=%0z"))) (expected (variant result::invalid (text "invalid percent escape"))))
    (test create percent-cannot-cross-field (visibility private)
      (actual (call sample (text "a=%2&b=0"))) (expected (variant result::invalid (text "invalid percent escape"))))
    (test create invalid-utf8 (visibility private)
      (actual (call sample (text "a=%ff"))) (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create invalid-key (visibility private)
      (actual (call sample (text "%80=a"))) (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create surrogate-rejected (visibility private)
      (actual (call sample (text "a=%ed%a0%80"))) (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create overlong-rejected (visibility private)
      (actual (call sample (text "a=%c0%af"))) (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create truncated-utf8 (visibility private)
      (actual (call sample (text "a=%e2%82"))) (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create raw-invalid-utf8 (visibility private)
      (actual (call decode (call std::bytes-from-list (list I64 (i64 97) (i64 61) (i64 255))) (i64 3) (i64 1)))
      (expected (variant result::invalid (text "invalid UTF-8"))))
    (test create exact-body-limit (visibility private)
      (actual (call decode (call std::bytes-from-text (text "a=b")) (i64 3) (i64 1)))
      (expected (call single (text "a") (text "b"))))
    (test create exceeded-body-limit (visibility private)
      (actual (call decode (call std::bytes-from-text (text "a=b")) (i64 2) (i64 1)))
      (expected (variant result::invalid (text "body too large"))))
    (test create exceeded-field-limit (visibility private)
      (actual (call decode (call std::bytes-from-text (text "a=b&a=c")) (i64 7) (i64 1)))
      (expected (variant result::invalid (text "too many fields"))))
    (test create zero-fields-empty (visibility private)
      (actual (call decode (call std::bytes-from-text (text "&&")) (i64 2) (i64 0)))
      (expected (variant result::valid (list field))))
    (test create zero-fields-nonempty (visibility private)
      (actual (call decode (call std::bytes-from-text (text "=")) (i64 1) (i64 0)))
      (expected (variant result::invalid (text "too many fields"))))
    (test create negative-limit (visibility private)
      (actual (call decode (call std::bytes-from-text (text "")) (i64 -1) (i64 1)))
      (expected (variant result::invalid (text "invalid limits"))))
))
declarations.end

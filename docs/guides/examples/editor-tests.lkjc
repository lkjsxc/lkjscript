request base=EDITOR_BASE

declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (module create editor-tests
    (function create accepted (visibility private)
      (parameter create body (type Text)) (returns Bool) (effect pure)
      (body (field (call editor::submission (call std::bytes-from-text (local body))) (name valid))))
    (function create base (visibility private)
      (parameter create text (type Text)) (returns Bool) (effect pure)
      (body (call editor::valid-base (call std::bytes-from-text (local text)))))
    (function create entry (visibility private)
      (parameter create value (type Bytes)) (returns std::DataEntry) (effect pure)
      (body (record std::DataEntry
        (field std::DataEntry::revision (call std::bytes-from-text (text "test revision")))
        (field std::DataEntry::value (local value)))))
    (test create ordered-form (visibility private)
      (actual (call editor::submission
        (call std::bytes-from-text (text "intent=save&text=hello+world+%26%2B&base=0"))))
      (expected (record structural (field valid (bool true)) (field base (text "0"))
        (field text (text "hello world &+")) (field error (text "")))))
    (test create empty-note (visibility private)
      (actual (call accepted (text "base=0&text=&intent=save"))) (expected (bool true)))
    (test create normalize-form-lines (visibility private)
      (actual (field (call editor::submission
        (call std::bytes-from-text (text "base=4&text=%0D%0Aa%0Db%09c&intent=save"))) (name text)))
      (expected (text "\na\nb\tc")))
    (test create duplicate-base (visibility private)
      (actual (call accepted (text "base=0&base=1&text=a&intent=save"))) (expected (bool false)))
    (test create duplicate-text (visibility private)
      (actual (call accepted (text "base=0&text=a&text=b&intent=save"))) (expected (bool false)))
    (test create duplicate-replaces-missing (visibility private)
      (actual (call accepted (text "base=0&base=1&intent=save"))) (expected (bool false)))
    (test create unknown-field (visibility private)
      (actual (call accepted (text "base=0&text=a&action=save"))) (expected (bool false)))
    (test create missing-field (visibility private)
      (actual (call accepted (text "base=0&text=a"))) (expected (bool false)))
    (test create wrong-action (visibility private)
      (actual (call accepted (text "base=0&text=a&intent=delete"))) (expected (bool false)))
    (test create invalid-encoding (visibility private)
      (actual (call accepted (text "base=0&text=%ff&intent=save"))) (expected (bool false)))
    (test create rejected-control (visibility private)
      (actual (call accepted (text "base=0&text=%00&intent=save"))) (expected (bool false)))
    (test create rejected-del (visibility private)
      (actual (call accepted (text "base=0&text=%7f&intent=save"))) (expected (bool false)))
    (test create zero-base (visibility private)
      (actual (call base (text "0"))) (expected (bool true)))
    (test create largest-base (visibility private)
      (actual (call base (text "9223372036854775807"))) (expected (bool true)))
    (test create nineteen-digits-are-text-not-arithmetic (visibility private)
      (actual (call base (text "9999999999999999999"))) (expected (bool true)))
    (test create too-many-digits (visibility private)
      (actual (call base (text "10000000000000000000"))) (expected (bool false)))
    (test create leading-zero (visibility private)
      (actual (call base (text "01"))) (expected (bool false)))
    (test create negative-base (visibility private)
      (actual (call base (text "-1"))) (expected (bool false)))
    (test create empty-base (visibility private)
      (actual (call base (text ""))) (expected (bool false)))
    (test create sign-base (visibility private)
      (actual (call base (text "+1"))) (expected (bool false)))
    (test create unicode-and-newline (visibility private)
      (actual (call editor::clean-text (text "\n日本語🌱\r\nsecond\rthird\ttab")))
      (expected (record structural (field valid (bool true))
        (field value (text "\n日本語🌱\nsecond\nthird\ttab")))))
    (test create empty-text-is-valid (visibility private)
      (actual (call editor::clean-text (text "")))
      (expected (record structural (field valid (bool true)) (field value (text "")))))
    (test create host-exact (visibility private)
      (actual (call editor::host-matches (text "https://notes.test")
        (list Header (call editor::header (text "host") (text "notes.test")))))
      (expected (bool true)))
    (test create host-foreign (visibility private)
      (actual (call editor::host-matches (text "https://notes.test")
        (list Header (call editor::header (text "host") (text "other.test")))))
      (expected (bool false)))
    (test create host-duplicate (visibility private)
      (actual (call editor::host-matches (text "https://notes.test")
        (list Header (call editor::header (text "host") (text "notes.test"))
          (call editor::header (text "host") (text "notes.test")))))
      (expected (bool false)))
    (test create host-missing-forwarded-is-not-authority (visibility private)
      (actual (call editor::host-matches (text "https://notes.test")
        (list Header (call editor::header (text "x-forwarded-host") (text "notes.test")))))
      (expected (bool false)))
    (test create origin-exact (visibility private)
      (actual (call editor::origin-matches (text "https://notes.test")
        (list Header (call editor::header (text "origin") (text "https://notes.test")))))
      (expected (bool true)))
    (test create origin-missing (visibility private)
      (actual (call editor::origin-matches (text "https://notes.test") (list Header)))
      (expected (bool false)))
    (test create origin-null (visibility private)
      (actual (call editor::origin-matches (text "https://notes.test")
        (list Header (call editor::header (text "origin") (text "null")))))
      (expected (bool false)))
    (test create origin-duplicate (visibility private)
      (actual (call editor::origin-matches (text "https://notes.test")
        (list Header (call editor::header (text "origin") (text "https://notes.test"))
          (call editor::header (text "origin") (text "https://notes.test")))))
      (expected (bool false)))
    (test create type-exact (visibility private)
      (actual (call editor::supported-type (list Header
        (call editor::header (text "content-type") (text "application/x-www-form-urlencoded; charset=UTF-8")))))
      (expected (bool true)))
    (test create type-duplicate (visibility private)
      (actual (call editor::supported-type (list Header
        (call editor::header (text "content-type") (text "application/x-www-form-urlencoded"))
        (call editor::header (text "content-type") (text "application/x-www-form-urlencoded")))))
      (expected (bool false)))
    (test create missing-storage (visibility private)
      (actual (call editor::decode-note (list std::DataEntry)))
      (expected (record structural (field version (i64 0)) (field text (text "")))))
    (test create malformed-storage-does-not-become-empty (visibility private)
      (actual (call editor::decode-note (list std::DataEntry
        (call entry (call std::bytes-from-text (text "not typed data"))))))
      (expected (record structural (field version (i64 -1)) (field text (text "")))))
    (test create wrong-storage-type-does-not-become-empty (visibility private)
      (actual (call editor::decode-note (list std::DataEntry
        (call entry (call std::data-encode (types I64) (i64 1))))))
      (expected (record structural (field version (i64 -1)) (field text (text "")))))
    (test create stored-negative-version (visibility private)
      (actual (call editor::note-usable (call editor::note (i64 -1) (text ""))))
      (expected (bool false)))
    (test create stored-noncanonical-newline (visibility private)
      (actual (call editor::note-usable (call editor::note (i64 1) (text "a\rb"))))
      (expected (bool false)))
    (test create stored-canonical-note (visibility private)
      (actual (call editor::note-usable (call editor::note (i64 1) (text "a\nb"))))
      (expected (bool true)))))
declarations.end

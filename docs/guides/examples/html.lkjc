request base=LIBRARY_BASE
add.dependency package=pkg_10000000000000000000000000000001 semantic-revision=STANDARD_REVISION package-revision=STANDARD_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (module create html
    (variant create inline (visibility public)
      (case create text (payload Text))
      (case create strong (payload (list inline)))
      (case create emphasis (payload (list inline)))
      (case create code (payload Text))
      (case create line-break))
    (variant create block (visibility public)
      (case create paragraph (payload (list inline)))
      (case create heading (payload Text))
      (case create code-block (payload Text))
      (case create unordered-list (payload (list (list block))))
      (case create section (payload (list block))))
    (function create join-range (visibility private)
      (parameter create chunks (type (list Text)))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (returns Text) (effect pure)
      (body
        (if (call std::i64-equal (local count) (i64 0)) (text "")
          (if (call std::i64-equal (local count) (i64 1))
            (call std::list-get (types Text) (local chunks) (local start))
            (let (binding half (call std::divide (local count) (i64 2)))
              (in (call std::text-concat
                (call join-range (local chunks) (local start) (local half))
                (call join-range (local chunks) (call std::add (local start) (local half))
                  (call std::subtract (local count) (local half))))))))))
    (function create join (visibility private)
      (parameter create chunks (type (list Text)))
      (returns Text) (effect pure)
      (body (call join-range (local chunks) (i64 0)
        (call std::list-length (types Text) (local chunks)))))
    (function create wrap (visibility private)
      (parameter create tag (type Text))
      (parameter create content (type Text))
      (returns Text) (effect pure)
      (body (call join (list Text (text "<") (local tag) (text ">")
        (local content) (text "</") (local tag) (text ">")))))
    (function create render-inline (visibility public)
      (parameter create node (type inline))
      (returns Text) (effect pure)
      (body (match (local node)
        (arm inline::text (payload value Text) (call std::html-escape-text (local value)))
        (arm inline::strong (payload nodes (list inline))
          (call wrap (text "strong") (call render-inlines (local nodes))))
        (arm inline::emphasis (payload nodes (list inline))
          (call wrap (text "em") (call render-inlines (local nodes))))
        (arm inline::code (payload value Text)
          (call wrap (text "code") (call std::html-escape-text (local value))))
        (arm inline::line-break (text "<br>")))))
    (function create render-inlines (visibility public)
      (parameter create nodes (type (list inline)))
      (returns Text) (effect pure)
      (body (call join (call std::list-map (types inline Text)
        (local nodes) (function-value render-inline)))))
    (function create render-item (visibility private)
      (parameter create nodes (type (list block)))
      (returns Text) (effect pure)
      (body (call wrap (text "li") (call render-blocks (local nodes)))))
    (function create render-block (visibility public)
      (parameter create node (type block))
      (returns Text) (effect pure)
      (body (match (local node)
        (arm block::paragraph (payload nodes (list inline))
          (call wrap (text "p") (call render-inlines (local nodes))))
        (arm block::heading (payload value Text)
          (call wrap (text "h2") (call std::html-escape-text (local value))))
        (arm block::code-block (payload value Text)
          (call wrap (text "pre") (call wrap (text "code")
            (call std::html-escape-text (local value)))))
        (arm block::unordered-list (payload items (list (list block)))
          (call wrap (text "ul") (call join (call std::list-map
            (types (list block) Text) (local items) (function-value render-item)))))
        (arm block::section (payload nodes (list block))
          (call wrap (text "section") (call render-blocks (local nodes)))))))
    (function create render-blocks (visibility public)
      (parameter create nodes (type (list block)))
      (returns Text) (effect pure)
      (body (call join (call std::list-map (types block Text)
        (local nodes) (function-value render-block)))))
    (function create document (visibility public)
      (parameter create language (type Text))
      (parameter create title (type Text))
      (parameter create nodes (type (list block)))
      (returns Text) (effect pure)
      (body (call join (list Text
        (text "<!doctype html><html lang=\"")
        (call std::html-escape-text (local language))
        (text "\"><head><meta charset=\"utf-8\"><title>")
        (call std::html-escape-text (local title))
        (text "</title></head><body>") (call render-blocks (local nodes))
        (text "</body></html>")))))
    (test create empty-inlines (visibility private)
      (actual (call render-inlines (list inline))) (expected (text "")))
    (test create escaped-text (visibility private)
      (actual (call render-inline (variant inline::text (text "<>&\"'"))))
      (expected (text "&lt;&gt;&amp;&quot;&#39;")))
    (test create entity-is-data (visibility private)
      (actual (call render-inline (variant inline::text (text "&lt;&#39;&"))))
      (expected (text "&amp;lt;&amp;#39;&amp;")))
    (test create unicode-and-nul (visibility private)
      (actual (call render-inline (variant inline::text (text "日本語🌱\u{0}"))))
      (expected (text "日本語🌱\u{0}")))
    (test create nested-inline (visibility private)
      (actual (call render-inline (variant inline::strong (list inline
        (variant inline::text (text "a"))
        (variant inline::emphasis (list inline (variant inline::text (text "<b>"))))))))
      (expected (text "<strong>a<em>&lt;b&gt;</em></strong>")))
    (test create line-break (visibility private)
      (actual (call render-inlines (list inline (variant inline::text (text "a"))
        (variant inline::line-break) (variant inline::text (text "b")))))
      (expected (text "a<br>b")))
    (test create inline-code (visibility private)
      (actual (call render-inline (variant inline::code (text "<i>"))))
      (expected (text "<code>&lt;i&gt;</code>")))
    (test create empty-blocks (visibility private)
      (actual (call render-blocks (list block))) (expected (text "")))
    (test create empty-paragraph (visibility private)
      (actual (call render-block (variant block::paragraph (list inline))))
      (expected (text "<p></p>")))
    (test create escaped-heading (visibility private)
      (actual (call render-block (variant block::heading (text "A&B"))))
      (expected (text "<h2>A&amp;B</h2>")))
    (test create code-leading-newline (visibility private)
      (actual (call render-block (variant block::code-block (text "\n<x>\n"))))
      (expected (text "<pre><code>\n&lt;x&gt;\n</code></pre>")))
    (test create empty-list (visibility private)
      (actual (call render-block (variant block::unordered-list (list (list block)))))
      (expected (text "<ul></ul>")))
    (test create ordered-list-items (visibility private)
      (actual (call render-block (variant block::unordered-list (list (list block)
        (list block) (list block (variant block::heading (text "one")))
        (list block (variant block::unordered-list (list (list block) (list block))))))))
      (expected (text "<ul><li></li><li><h2>one</h2></li><li><ul><li></li></ul></li></ul>")))
    (test create nested-section (visibility private)
      (actual (call render-block (variant block::section (list block
        (variant block::heading (text "title"))
        (variant block::section (list block (variant block::paragraph (list inline))))))))
      (expected (text "<section><h2>title</h2><section><p></p></section></section>")))
    (test create empty-document (visibility private)
      (actual (call document (text "ja") (text "") (list block)))
      (expected (text "<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\"><title></title></head><body></body></html>")))
    (test create document-contexts (visibility private)
      (actual (call document (text "\" title=\"x&") (text "</title><script>")
        (list block (variant block::heading (text "<img>")))))
      (expected (text "<!doctype html><html lang=\"&quot; title=&quot;x&amp;\"><head><meta charset=\"utf-8\"><title>&lt;/title&gt;&lt;script&gt;</title></head><body><h2>&lt;img&gt;</h2></body></html>")))))
declarations.end

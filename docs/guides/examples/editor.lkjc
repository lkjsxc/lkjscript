request base=EDITOR_BASE
add.dependency package=UI_PACKAGE semantic-revision=UI_REVISION package-revision=UI_PACKAGE_REVISION
add.dependency package=FORMS_PACKAGE semantic-revision=FORMS_REVISION package-revision=FORMS_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (use ui UI_PACKAGE UI_PACKAGE_REVISION)
  (use forms FORMS_PACKAGE FORMS_PACKAGE_REVISION)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias HeaderValue (record (valid Bool) (value Bytes)))
  (type-alias TextResult (record (valid Bool) (value Text)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (type-alias Note (record (version I64) (text Text)))
  (type-alias Submission (record (valid Bool) (base Text) (text Text) (error Text)))
  (module create editor
    (constant create key (visibility private) (type (list std::DataKeyPart))
      (value (list std::DataKeyPart (variant std::DataKeyPart::Text (text "note")))))
    (function create header (visibility public)
      (parameter create name (type Text)) (parameter create value (type Text))
      (returns Header) (effect pure)
      (body (record structural (field name (local name))
        (field value (call std::bytes-from-text (local value))))))
    (function create select-header (visibility private)
      (parameter create name (type Text)) (parameter create headers (type (list Header)))
      (parameter create index (type I64)) (parameter create count (type I64))
      (parameter create value (type Bytes)) (returns HeaderValue) (effect pure)
      (body (if (call std::less (local index) (call std::list-length (types Header) (local headers)))
        (let (binding item (call std::list-get (types Header) (local headers) (local index)))
          (binding matches (call std::text-equal (local name) (field (local item) (name name))))
          (in (call select-header (local name) (local headers) (call std::add (local index) (i64 1))
            (if (local matches) (call std::add (local count) (i64 1)) (local count))
            (if (local matches) (field (local item) (name value)) (local value)))))
        (record structural (field valid (call std::i64-equal (local count) (i64 1)))
          (field value (local value))))))
    (function create header-value (visibility public)
      (parameter create name (type Text)) (parameter create headers (type (list Header)))
      (returns HeaderValue) (effect pure)
      (body (call select-header (local name) (local headers) (i64 0) (i64 0)
        (call std::bytes-from-text (text "")))))
    (function create host-matches (visibility public)
      (parameter create origin (type Text)) (parameter create headers (type (list Header)))
      (returns Bool) (effect pure)
      (body (let (binding host (call header-value (text "host") (local headers)))
        (binding decoded (call std::bytes-to-text-result (field (local host) (name value))))
        (in (if (call std::bool-and (field (local host) (name valid)) (field (local decoded) (name valid)))
          (call std::bool-or
            (call std::text-equal (local origin)
              (call std::text-concat (text "http://") (field (local decoded) (name value))))
            (call std::text-equal (local origin)
              (call std::text-concat (text "https://") (field (local decoded) (name value)))))
          (bool false))))))
    (function create origin-matches (visibility public)
      (parameter create origin (type Text)) (parameter create headers (type (list Header)))
      (returns Bool) (effect pure)
      (body (let (binding value (call header-value (text "origin") (local headers)))
        (in (call std::bool-and (field (local value) (name valid))
          (call std::bytes-equal (field (local value) (name value))
            (call std::bytes-from-text (local origin))))))))
    (function create supported-type (visibility public)
      (parameter create headers (type (list Header))) (returns Bool) (effect pure)
      (body (let (binding value (call header-value (text "content-type") (local headers)))
        (in (call std::bool-and (field (local value) (name valid))
          (call std::bool-or
            (call std::bytes-equal (field (local value) (name value))
              (call std::bytes-from-text (text "application/x-www-form-urlencoded")))
            (call std::bytes-equal (field (local value) (name value))
              (call std::bytes-from-text (text "application/x-www-form-urlencoded; charset=UTF-8")))))))))
    (function create permission (visibility private)
      (parameter create origin (type Text)) (parameter create headers (type (list Header)))
      (returns I64) (effect (task (requirement server::auth)))
      (body (if (call host-matches (local origin) (local headers))
        (let (binding candidate (call header-value (text "authorization") (local headers)))
          (in (if (call std::bool-and (field (local candidate) (name valid))
                (call std::less-equal (call std::bytes-length (field (local candidate) (name value))) (i64 4096)))
            (if (capability-call server::auth std::SecretVerifier::matches
                  (field (local candidate) (name value))) (i64 0) (i64 401)) (i64 401))))
        (i64 400))))
    (function create clean-result (visibility private)
      (parameter create valid (type Bool)) (parameter create text (type Text))
      (returns TextResult) (effect pure)
      (body (record structural (field valid (local valid)) (field value (local text)))))
    (function create clean-walk (visibility private)
      (parameter create bytes (type Bytes)) (parameter create index (type I64))
      (parameter create output (type (list I64))) (returns TextResult) (effect pure)
      (body (if (call std::less (local index) (call std::bytes-length (local bytes)))
        (let (binding byte (call std::bytes-get (local bytes) (local index)))
          (binding next (call std::add (local index) (i64 1)))
          (in (if (call std::i64-equal (local byte) (i64 13))
            (call clean-walk (local bytes)
              (if (call std::less (local next) (call std::bytes-length (local bytes)))
                (if (call std::i64-equal (call std::bytes-get (local bytes) (local next)) (i64 10))
                  (call std::add (local next) (i64 1)) (local next)) (local next))
              (call std::list-append (types I64) (local output) (i64 10)))
            (if (call std::bool-or (call std::i64-equal (local byte) (i64 127))
                  (call std::bool-and (call std::less (local byte) (i64 32))
                    (call std::bool-not (call std::bool-or
                      (call std::i64-equal (local byte) (i64 9))
                      (call std::i64-equal (local byte) (i64 10))))))
              (call clean-result (bool false) (text ""))
              (call clean-walk (local bytes) (local next)
                (call std::list-append (types I64) (local output) (local byte)))))))
        (call clean-result (bool true)
          (call std::bytes-to-text (call std::bytes-from-list (local output)))))))
    (function create clean-text (visibility public)
      (parameter create text (type Text)) (returns TextResult) (effect pure)
      (body (let (binding bytes (call std::bytes-from-text (local text)))
        (in (if (call std::less-equal (call std::bytes-length (local bytes)) (i64 4096))
          (call clean-walk (local bytes) (i64 0) (list I64))
          (call clean-result (bool false) (text "")))))))
    (function create digits (visibility private)
      (parameter create bytes (type Bytes)) (parameter create index (type I64))
      (returns Bool) (effect pure)
      (body (if (call std::less (local index) (call std::bytes-length (local bytes)))
        (let (binding byte (call std::bytes-get (local bytes) (local index)))
          (in (if (call std::bool-and (call std::less-equal (i64 48) (local byte))
                (call std::less-equal (local byte) (i64 57)))
            (call digits (local bytes) (call std::add (local index) (i64 1))) (bool false))))
        (bool true))))
    (function create valid-base (visibility public)
      (parameter create bytes (type Bytes)) (returns Bool) (effect pure)
      (body (let (binding size (call std::bytes-length (local bytes)))
        (in (if (call std::bool-and (call std::less (i64 0) (local size))
              (call std::less-equal (local size) (i64 19)))
          (if (call std::bool-and (call std::less (i64 1) (local size))
                (call std::i64-equal (call std::bytes-get (local bytes) (i64 0)) (i64 48)))
            (bool false) (call digits (local bytes) (i64 0))) (bool false))))))
    (function create invalid-form (visibility private)
      (parameter create error (type Text)) (returns Submission) (effect pure)
      (body (record structural (field valid (bool false)) (field base (text ""))
        (field text (text "")) (field error (local error)))))
    (function create form-header (visibility private)
      (parameter create value (type forms::field)) (returns Header) (effect pure)
      (body (call header (field (local value) forms::field::name)
        (field (local value) forms::field::value))))
    (function create fields (visibility private)
      (parameter create values (type (list forms::field))) (returns Submission) (effect pure)
      (body (let
        (binding headers (call std::list-map (types forms::field Header) (local values) (function-value form-header)))
        (binding base (call header-value (text "base") (local headers)))
        (binding text (call header-value (text "text") (local headers)))
        (binding intent (call header-value (text "intent") (local headers)))
        (in (if (call std::bool-and
              (call std::i64-equal (call std::list-length (types forms::field) (local values)) (i64 3))
              (call std::bool-and (field (local base) (name valid))
                (call std::bool-and (field (local text) (name valid)) (field (local intent) (name valid)))))
          (if (call std::bool-and (call valid-base (field (local base) (name value)))
                (call std::bytes-equal (field (local intent) (name value)) (call std::bytes-from-text (text "save"))))
            (let (binding cleaned (call clean-text (call std::bytes-to-text (field (local text) (name value)))))
              (in (if (field (local cleaned) (name valid))
                (record structural (field valid (bool true))
                  (field base (call std::bytes-to-text (field (local base) (name value))))
                  (field text (field (local cleaned) (name value))) (field error (text "")))
                (call invalid-form (text "Use at most 4096 UTF-8 bytes; only tab and line breaks are allowed as control characters.")))))
            (call invalid-form (text "Invalid save action or base revision.")))
          (call invalid-form (text "Supply exactly one base, text and intent field.")))))))
    (function create submission (visibility public)
      (parameter create body (type Bytes)) (returns Submission) (effect pure)
      (body (match (call forms::decode (local body) (i64 16384) (i64 3))
        (arm forms::result::valid (payload values (list forms::field)) (call fields (local values)))
        (arm forms::result::invalid (payload error Text) (call invalid-form (local error))))))
    (function create note (visibility public)
      (parameter create version (type I64)) (parameter create text (type Text))
      (returns Note) (effect pure)
      (body (record structural (field version (local version)) (field text (local text)))))
    (function create decode-note (visibility public)
      (parameter create entries (type (list std::DataEntry))) (returns Note) (effect pure)
      (body (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
        (call note (i64 0) (text ""))
        (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 1))
          (call std::data-decode-or (types Note)
            (field (call std::list-get (types std::DataEntry) (local entries) (i64 0)) std::DataEntry::value)
            (call note (i64 -1) (text ""))) (call note (i64 -1) (text ""))))))
    (function create note-usable (visibility public)
      (parameter create value (type Note)) (returns Bool) (effect pure)
      (body (let (binding cleaned (call clean-text (field (local value) (name text))))
        (in (call std::bool-and (call std::less-equal (i64 0) (field (local value) (name version)))
          (call std::bool-and (field (local cleaned) (name valid))
            (call std::text-equal (field (local cleaned) (name value)) (field (local value) (name text)))))))))
    (function create read-note (visibility private)
      (returns Note) (effect (task (requirement server::data)))
      (body (call decode-note (capability-call server::data std::DataStore::get
        (static-text "native-editor") (constant key)))))
    (function create page (visibility private)
      (parameter create saved (type Note)) (parameter create draft (type Text))
      (parameter create conflict (type Bool)) (returns Text) (effect pure)
      (body (call ui::document (text "en") (text "Native notes") (variant ui::theme::light)
        (list ui::node
          (variant ui::node::paragraph (text "One shared note. Written, rendered and saved by lkjscript."))
          (variant ui::node::card (list ui::node
            (variant ui::node::heading (if (local conflict) (text "Not saved: the note changed") (text "Your note")))
            (variant ui::node::paragraph (call std::text-concat (text "Saved revision ")
              (call std::i64-to-text (field (local saved) (name version)))))
            (if (local conflict)
              (variant ui::node::card (list ui::node
                (variant ui::node::heading (text "Current saved text"))
                (variant ui::node::text-block (field (local saved) (name text)))))
              (variant ui::node::paragraph (text "Save explicitly. Line endings are stored as LF.")))
            (variant ui::node::action-form (record ui::action-form
              (field ui::action-form::title (if (local conflict)
                (text "Your draft: compare above, then review before saving again") (text "Edit note")))
              (field ui::action-form::inputs (list ui::input))
              (field ui::action-form::multiline (list ui::input (record ui::input
                (field ui::input::name (text "text")) (field ui::input::label (text "Note (up to 4096 UTF-8 bytes)"))
                (field ui::input::value (local draft)))))
              (field ui::action-form::hidden (list ui::hidden-input (record ui::hidden-input
                (field ui::hidden-input::name (text "base"))
                (field ui::hidden-input::value (call std::i64-to-text (field (local saved) (name version)))))))
              (field ui::action-form::buttons (list ui::button (record ui::button
                (field ui::button::name (text "intent")) (field ui::button::value (text "save"))
                (field ui::button::label (if (local conflict) (text "Save reviewed draft") (text "Save note"))))))))))
          (variant ui::node::paragraph (text "After a connection error, copy your draft and reload to inspect the saved version. A missing response does not prove that a save failed."))
          (variant ui::node::query-form (record ui::query-form
            (field ui::query-form::title (text "Reloading discards the unsaved draft"))
            (field ui::query-form::inputs (list ui::input))
            (field ui::query-form::buttons (list ui::button (record ui::button
              (field ui::button::name (text "reload")) (field ui::button::value (text "true"))
              (field ui::button::label (text "Read latest saved note")))))))))))
    (function create response (visibility private)
      (parameter create status (type I64)) (parameter create body (type Text))
      (returns Response) (effect pure)
      (body (let (binding headers (list Header
          (call header (text "content-type") (text "text/html; charset=utf-8"))
          (call header (text "cache-control") (text "no-store"))
          (call header (text "x-content-type-options") (text "nosniff"))
          (call header (text "referrer-policy") (text "same-origin"))
          (call header (text "x-frame-options") (text "DENY"))
          (call header (text "content-security-policy")
            (text "default-src 'none'; style-src 'unsafe-inline'; script-src 'none'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"))))
        (in (record structural (field status (local status))
          (field body (call std::bytes-from-text (local body)))
          (field headers (if (call std::i64-equal (local status) (i64 303))
            (call std::list-append (types Header) (local headers) (call header (text "location") (text "/")))
            (if (call std::i64-equal (local status) (i64 401))
              (call std::list-append (types Header) (local headers)
                (call header (text "www-authenticate") (text "Basic realm=\"Native notes\", charset=\"UTF-8\"")))
              (local headers)))))))))
    (function create error-page (visibility private)
      (parameter create status (type I64)) (parameter create message (type Text))
      (returns Response) (effect pure)
      (body (call response (local status)
        (call ui::document (text "en") (text "Native notes") (variant ui::theme::light)
          (list ui::node (variant ui::node::heading (text "Request not accepted"))
            (variant ui::node::paragraph (local message)))))))
    (function create attempt (visibility private)
      (parameter create input (type Submission)) (returns (std::TransactionOutcome I64))
      (effect (task (requirement server::data)))
      (body (transaction-outcome server::data (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason
          std::TransactionOutcome::Committed std::TransactionOutcome::Aborted
          std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding save)
        (let (binding entries (capability-call server::data std::DataStore::get
            (static-text "native-editor") (constant key)))
          (binding current (call decode-note (local entries)))
          (in (if (call note-usable (local current))
            (if (call std::less (field (local current) (name version)) (i64 9223372036854775807))
              (if (call std::text-equal (field (local input) (name base))
                    (call std::i64-to-text (field (local current) (name version))))
                (sequence
                  (capability-call server::data std::DataStore::put (static-text "native-editor") (constant key)
                    (call std::data-encode (types Note) (call note
                      (call std::add (field (local current) (name version)) (i64 1))
                      (field (local input) (name text))))
                    (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
                      (variant std::DataExpectation::Missing)
                      (variant std::DataExpectation::Exact
                        (field (call std::list-get (types std::DataEntry) (local entries) (i64 0)) std::DataEntry::revision))))
                  (i64 303)) (i64 409)) (i64 503)) (i64 503)))))))
    (function create save-input (visibility private)
      (parameter create input (type Submission)) (returns Response)
      (effect (task (requirement server::data)))
      (body (if (field (local input) (name valid))
        (let (binding status (match (call attempt (local input))
            (arm std::TransactionOutcome::Committed (payload value I64) (local value))
            (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 409))))
          (in (if (call std::i64-equal (local status) (i64 303))
            (call response (i64 303) (text ""))
            (if (call std::i64-equal (local status) (i64 409))
              (let (binding saved (call read-note))
                (in (if (call note-usable (local saved))
                  (call response (i64 409) (call page (local saved) (field (local input) (name text)) (bool true)))
                  (call error-page (i64 503) (text "Stored data needs operator attention; it was not overwritten.")))))
              (call error-page (i64 503) (text "Stored data or its revision needs operator attention; it was not overwritten."))))))
        (call error-page (i64 400) (field (local input) (name error))))))
    (function create view (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::config) (requirement server::auth) (requirement server::data)))
      (body (let (binding origin (capability-call server::config std::Configuration::text (static-text "origin")))
        (binding allowed (call permission (local origin) (field (local request) (name headers))))
        (in (if (call std::i64-equal (local allowed) (i64 0))
          (let (binding saved (call read-note))
            (in (if (call note-usable (local saved))
              (call response (i64 200) (call page (local saved) (field (local saved) (name text)) (bool false)))
              (call error-page (i64 503) (text "Stored data needs operator attention; it was not overwritten.")))))
          (call error-page (local allowed) (text "Use the configured host and the shared editor credential.")))))))
    (function create save (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::config) (requirement server::auth)
        (requirement server::streams) (requirement server::data)))
      (body (let (binding origin (capability-call server::config std::Configuration::text (static-text "origin")))
        (binding headers (field (local request) (name headers)))
        (binding allowed (call permission (local origin) (local headers)))
        (in (if (call std::i64-equal (local allowed) (i64 0))
          (if (call origin-matches (local origin) (local headers))
            (if (call supported-type (local headers))
              (call save-input (call submission (capability-call server::streams std::ByteStream::read-all
                (field (local request) (name body)) (i64 16384))))
              (call error-page (i64 415) (text "Use one UTF-8 application/x-www-form-urlencoded Content-Type header.")))
            (call error-page (i64 403) (text "A single exact configured Origin is required for saving.")))
          (call error-page (local allowed) (text "Use the configured host and the shared editor credential.")))))))
    (component create server (visibility private)
      (requirement create config (interface std::Configuration)
        (operations std::Configuration::text) (limits (maximum_calls 1 calls)))
      (requirement create auth (interface std::SecretVerifier)
        (operations std::SecretVerifier::matches) (limits (maximum_calls 1 calls)))
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (requirement create data (interface std::DataStore)
        (operations std::DataStore::get std::DataStore::put std::DataStore::transaction)
        (limits (maximum_calls 8 calls)))
      (port create view (type (task-function (Request) Response
        (row (requirement config) (requirement auth) (requirement data)))) (function view))
      (port create save (type (task-function (Request) Response
        (row (requirement config) (requirement auth) (requirement streams) (requirement data)))) (function save))))
  (target create editor (component editor::server) (runner http)
    (route create view (method GET) (path "/") (port editor::server::view))
    (route create save (method POST) (path "/") (port editor::server::save))))
declarations.end

request base=BASE
declarations.begin
(units
  (use std builtin)
  (module create ranking
    (function create merge (visibility private)
      (type-parameter create Item)
      (parameter create left (type (list Item)))
      (parameter create right (type (list Item)))
      (parameter create i (type I64))
      (parameter create j (type I64))
      (parameter create left-length (type I64))
      (parameter create right-length (type I64))
      (parameter create selected (type (list Item)))
      (parameter create precedes (type (function (Item Item) Bool)))
      (parameter create remaining (type I64))
      (returns (list Item)) (effect pure)
      (body
        (if (call std::less (i64 0) (local remaining))
          (if (call std::less (local i) (local left-length))
          (let
            (binding first (call std::list-get (types Item) (local left) (local i)))
            (in
              (if (call std::less (local j) (local right-length))
                (let
                  (binding second (call std::list-get (types Item) (local right) (local j)))
                  (in
                    (if (invoke (local precedes) (local second) (local first))
                      (call merge (types Item) (local left) (local right)
                        (local i) (call std::add (local j) (i64 1))
                        (local left-length) (local right-length)
                        (call std::list-append (types Item) (local selected) (local second)) (local precedes)
                        (call std::subtract (local remaining) (i64 1)))
                      (call merge (types Item) (local left) (local right)
                        (call std::add (local i) (i64 1)) (local j)
                        (local left-length) (local right-length)
                        (call std::list-append (types Item) (local selected) (local first)) (local precedes)
                        (call std::subtract (local remaining) (i64 1))))))
                (call merge (types Item) (local left) (local right)
                  (call std::add (local i) (i64 1)) (local j)
                  (local left-length) (local right-length)
                  (call std::list-append (types Item) (local selected) (local first)) (local precedes)
                  (call std::subtract (local remaining) (i64 1))))))
          (if (call std::less (local j) (local right-length))
            (call merge (types Item) (local left) (local right)
              (local i) (call std::add (local j) (i64 1))
              (local left-length) (local right-length)
              (call std::list-append (types Item) (local selected)
                (call std::list-get (types Item) (local right) (local j))) (local precedes)
              (call std::subtract (local remaining) (i64 1)))
            (local selected)))
          (local selected))))
    (function create sort-by (visibility public)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (let
          (binding length (call std::list-length (types Item) (local items)))
          (in
            (if (call std::less (local length) (i64 2)) (local items)
              (let
                (binding half (call std::divide (local length) (i64 2)))
                (binding left
                  (call sort-by (types Item)
                    (call std::list-window (types Item) (local items) (i64 0) (local half)) (local precedes)))
                (binding right
                  (call sort-by (types Item)
                    (call std::list-window (types Item) (local items) (local half) (local length)) (local precedes)))
                (in
                  (call merge (types Item) (local left) (local right) (i64 0) (i64 0)
                    (call std::list-length (types Item) (local left))
                    (call std::list-length (types Item) (local right)) (list Item) (local precedes) (local length)))))))))
    (function create select-range (visibility private)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create start (type I64))
      (parameter create length (type I64))
      (parameter create count (type I64))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (if (call std::less (local length) (i64 2))
          (list Item (call std::list-get (types Item) (local items) (local start)))
          (let
            (binding half (call std::divide (local length) (i64 2)))
            (binding left
              (call select-range (types Item) (local items) (local start) (local half)
                (local count) (local precedes)))
            (binding right
              (call select-range (types Item) (local items)
                (call std::add (local start) (local half))
                (call std::subtract (local length) (local half)) (local count) (local precedes)))
            (in
              (call merge (types Item) (local left) (local right) (i64 0) (i64 0)
                (call std::list-length (types Item) (local left))
                (call std::list-length (types Item) (local right))
                (list Item) (local precedes) (local count)))))))
    (function create select-by (visibility public)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create count (type I64))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (let
          (binding length (call std::list-length (types Item) (local items)))
          (binding actual
            (if (call std::less (local count) (i64 0)) (i64 0)
              (if (call std::less (local length) (local count)) (local length) (local count))))
          (in
            (if (call std::less (i64 0) (local actual))
              (call select-range (types Item) (local items) (i64 0) (local length)
                (local actual) (local precedes))
              (list Item))))))
    (function create flush-buffer (visibility private)
      (type-parameter create Item)
      (parameter create best (type (list Item)))
      (parameter create buffer (type (list Item)))
      (parameter create buffer-length (type I64))
      (parameter create count (type I64))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (if (call std::less (i64 0) (local buffer-length))
          (call merge (types Item) (local best)
            (call select-range (types Item) (local buffer) (i64 0) (local buffer-length) (local count) (local precedes))
            (i64 0) (i64 0) (local count) (local buffer-length) (list Item) (local precedes) (local count))
          (local best))))
    (function create scan-buffered (visibility private)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create position (type I64))
      (parameter create length (type I64))
      (parameter create count (type I64))
      (parameter create best (type (list Item)))
      (parameter create buffer (type (list Item)))
      (parameter create buffer-length (type I64))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (if (call std::less (local position) (local length))
          (let
            (binding value (call std::list-get (types Item) (local items) (local position)))
            (binding next-position (call std::add (local position) (i64 1)))
            (in
              (if (invoke (local precedes) (local value)
                    (call std::list-get (types Item) (local best) (call std::subtract (local count) (i64 1))))
                (let
                  (binding next-buffer (call std::list-append (types Item) (local buffer) (local value)))
                  (binding next-length (call std::add (local buffer-length) (i64 1)))
                  (in
                    (if (call std::less (local next-length) (local count))
                      (call scan-buffered (types Item) (local items) (local next-position) (local length) (local count)
                        (local best) (local next-buffer) (local next-length) (local precedes))
                      (call scan-buffered (types Item) (local items) (local next-position) (local length) (local count)
                        (call flush-buffer (types Item) (local best) (local next-buffer) (local next-length) (local count) (local precedes))
                        (list Item) (i64 0) (local precedes)))))
                (call scan-buffered (types Item) (local items) (local next-position) (local length) (local count)
                  (local best) (local buffer) (local buffer-length) (local precedes)))))
          (call flush-buffer (types Item) (local best) (local buffer) (local buffer-length) (local count) (local precedes)))))
    (function create select-buffered-by (visibility public)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create count (type I64))
      (parameter create precedes (type (function (Item Item) Bool)))
      (returns (list Item)) (effect pure)
      (body
        (let
          (binding length (call std::list-length (types Item) (local items)))
          (binding actual
            (if (call std::less (local count) (i64 0)) (i64 0)
              (if (call std::less (local length) (local count)) (local length) (local count))))
          (in
            (if (call std::less (i64 0) (local actual))
              (call scan-buffered (types Item) (local items) (local actual) (local length) (local actual)
                (call select-range (types Item) (local items) (i64 0) (local actual) (local actual) (local precedes))
                (list Item) (i64 0) (local precedes))
              (list Item))))))
    (function create count-step (visibility private)
      (parameter create totals (type (map Text I64)))
      (parameter create item (type Text))
      (returns (map Text I64)) (effect pure)
      (body
        (call std::map-insert (types Text I64) (local totals) (local item)
          (call std::add
            (call std::map-get-or (types Text I64) (local totals) (local item) (i64 0)) (i64 1)))))
    (function create hotter (visibility private)
      (parameter create left (type (record (key Text) (value I64))))
      (parameter create right (type (record (key Text) (value I64))))
      (returns Bool) (effect pure)
      (body (call std::less (field (local right) (name value)) (field (local left) (name value)))))
    (function create top (visibility public)
      (parameter create items (type (list Text)))
      (parameter create count (type I64))
      (returns (list (record (key Text) (value I64)))) (effect pure)
      (body
        (call select-by (types (record (key Text) (value I64)))
          (call std::map-entries (types Text I64)
            (call std::list-fold-left (types Text (map Text I64))
              (local items) (map Text I64) (function-value count-step)))
          (local count) (function-value hotter))))
    (function create top-buffered (visibility public)
      (parameter create items (type (list Text)))
      (parameter create count (type I64))
      (returns (list (record (key Text) (value I64)))) (effect pure)
      (body
        (call select-buffered-by (types (record (key Text) (value I64)))
          (call std::map-entries (types Text I64)
            (call std::list-fold-left (types Text (map Text I64))
              (local items) (map Text I64) (function-value count-step)))
          (local count) (function-value hotter))))
    (test create buffered-zero (visibility private)
      (actual (call select-buffered-by (types I64) (list I64 (i64 3) (i64 2)) (i64 0) (function-value broken-comparison)))
      (expected (list I64)))
    (test create buffered-negative-extreme (visibility private)
      (actual (call select-buffered-by (types I64) (list I64 (i64 3) (i64 2)) (i64 -9223372036854775808) (function-value broken-comparison)))
      (expected (list I64)))
    (test create buffered-singleton (visibility private)
      (actual (call select-buffered-by (types I64) (list I64 (i64 7)) (i64 9223372036854775807) (function-value broken-comparison)))
      (expected (list I64 (i64 7))))
    (test create buffered-complete (visibility private)
      (actual (call select-buffered-by (types I64) (list I64 (i64 3) (i64 -2) (i64 3) (i64 0)) (i64 9223372036854775807) (function-value std::less)))
      (expected (list I64 (i64 -2) (i64 0) (i64 3) (i64 3))))
    (test create buffered-counts (visibility private)
      (actual (call top-buffered (list Text (text "pear") (text "apple") (text "pear") (text "plum") (text "plum")) (i64 2)))
      (expected (list (record (key Text) (value I64))
        (record structural (field key (text "pear")) (field value (i64 2)))
        (record structural (field key (text "plum")) (field value (i64 2))))))
    (function create numbers (visibility public)
      (parameter create items (type (list I64)))
      (returns (list I64)) (effect pure)
      (body (call sort-by (types I64) (local items) (function-value std::less))))
    (function create broken-comparison (visibility private)
      (parameter create left (type I64))
      (parameter create right (type I64))
      (returns Bool) (effect pure)
      (body (call std::less (call std::divide (local left) (i64 0)) (local right))))
    (function create select-numbers (visibility public)
      (parameter create items (type (list I64)))
      (parameter create count (type I64))
      (returns (list I64)) (effect pure)
      (body (call select-by (types I64) (local items) (local count) (function-value std::less))))
    (test create select-empty-with-broken-comparison (visibility private)
      (actual (call select-by (types I64) (list I64) (i64 3) (function-value broken-comparison)))
      (expected (list I64)))
    (test create select-zero-with-broken-comparison (visibility private)
      (actual (call select-by (types I64) (list I64 (i64 3) (i64 2)) (i64 0) (function-value broken-comparison)))
      (expected (list I64)))
    (test create select-negative-with-broken-comparison (visibility private)
      (actual (call select-by (types I64) (list I64 (i64 3) (i64 2)) (i64 -9223372036854775808) (function-value broken-comparison)))
      (expected (list I64)))
    (test create select-singleton-with-broken-comparison (visibility private)
      (actual (call select-by (types I64) (list I64 (i64 7)) (i64 9223372036854775807) (function-value broken-comparison)))
      (expected (list I64 (i64 7))))
    (test create select-prefix (visibility private)
      (actual (call select-numbers (list I64 (i64 5) (i64 1) (i64 3) (i64 1) (i64 0)) (i64 3)))
      (expected (list I64 (i64 0) (i64 1) (i64 1))))
    (test create select-all (visibility private)
      (actual (call select-numbers (list I64 (i64 5) (i64 1) (i64 3) (i64 1) (i64 0)) (i64 9223372036854775807)))
      (expected (list I64 (i64 0) (i64 1) (i64 1) (i64 3) (i64 5))))
    (test create empty-with-broken-comparison (visibility private)
      (actual (call sort-by (types I64) (list I64) (function-value broken-comparison)))
      (expected (list I64)))
    (test create singleton-with-broken-comparison (visibility private)
      (actual (call sort-by (types I64) (list I64 (i64 7)) (function-value broken-comparison)))
      (expected (list I64 (i64 7))))
    (test create numeric-order (visibility private)
      (actual (call numbers (list I64 (i64 4) (i64 -1) (i64 4) (i64 2) (i64 0))))
      (expected (list I64 (i64 -1) (i64 0) (i64 2) (i64 4) (i64 4))))
    (test create empty-top (visibility private)
      (actual (call top (list Text) (i64 3)))
      (expected (list (record (key Text) (value I64)))))
    (test create stable-tie (visibility private)
      (actual (call top (list Text (text "pear") (text "apple") (text "pear") (text "apple") (text "猫")) (i64 3)))
      (expected (list (record (key Text) (value I64))
        (record structural (field key (text "apple")) (field value (i64 2)))
        (record structural (field key (text "pear")) (field value (i64 2)))
        (record structural (field key (text "猫")) (field value (i64 1))))))
    (test create bounded-top (visibility private)
      (actual (call top (list Text (text "pear") (text "apple") (text "pear")) (i64 1)))
      (expected (list (record (key Text) (value I64))
        (record structural (field key (text "pear")) (field value (i64 2))))))
    (component create console (visibility private)
      (port create top (type (function ((list Text) I64) (list (record (key Text) (value I64))))) (function top))
      (port create top-buffered (type (function ((list Text) I64) (list (record (key Text) (value I64))))) (function top-buffered))
      (port create select-numbers (type (function ((list I64) I64) (list I64))) (function select-numbers))
      (port create numbers (type (function ((list I64)) (list I64))) (function numbers))))
  (target create top (component ranking::console) (runner command) (port ranking::console::top))
  (target create top-buffered (component ranking::console) (runner command) (port ranking::console::top-buffered))
  (target create select-numbers (component ranking::console) (runner command) (port ranking::console::select-numbers))
  (target create numbers (component ranking::console) (runner command) (port ranking::console::numbers)))
declarations.end

request base=SITE_BASE
add.dependency package=HTML_PACKAGE semantic-revision=HTML_REVISION package-revision=HTML_PACKAGE_REVISION
add.dependency package=RESPONSES_PACKAGE semantic-revision=RESPONSES_REVISION package-revision=RESPONSES_PACKAGE_REVISION

declarations.begin
(units
  (use std builtin)
  (use html HTML_PACKAGE HTML_PACKAGE_REVISION)
  (use replies RESPONSES_PACKAGE RESPONSES_PACKAGE_REVISION)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Query (map Text (list Text)))
  (type-alias Request (record (body (stream Bytes)) (headers (list Header))
    (method Text) (path Text) (query Text) (query_parameters Query)))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (module create catalog
    (variant create index-number (visibility private)
      (case create valid (payload I64)) (case create invalid))
    (function create digits (visibility private)
      (parameter create bytes (type Bytes)) (parameter create at (type I64))
      (parameter create accumulated (type I64))
      (returns index-number) (effect pure)
      (body (if (call std::i64-equal (local at) (call std::bytes-length (local bytes)))
        (variant index-number::valid (local accumulated))
        (let (binding digit (call std::subtract
          (call std::bytes-get (local bytes) (local at)) (i64 48)))
          (in (if (call std::less (local digit) (i64 0)) (variant index-number::invalid)
            (if (call std::less (i64 9) (local digit)) (variant index-number::invalid)
              (if (call std::less (call std::divide
                (call std::subtract (i64 9223372036854775807) (local digit)) (i64 10))
                (local accumulated)) (variant index-number::invalid)
                (call digits (local bytes) (call std::add (local at) (i64 1))
                  (call std::add (call std::multiply (local accumulated) (i64 10))
                    (local digit)))))))))))
    (function create parse-index (visibility private)
      (parameter create text (type Text))
      (returns index-number) (effect pure)
      (body (let (binding bytes (call std::bytes-from-text (local text)))
        (in (if (call std::i64-equal (call std::bytes-length (local bytes)) (i64 0))
          (variant index-number::invalid)
          (if (call std::less (i64 19) (call std::bytes-length (local bytes)))
            (variant index-number::invalid) (call digits (local bytes) (i64 0) (i64 0))))))))
    (function create number-or-invalid (visibility private)
      (parameter create text (type Text)) (returns I64) (effect pure)
      (body (match (call parse-index (local text))
        (arm index-number::valid (payload value I64) (local value))
        (arm index-number::invalid (i64 -1)))))
    (function create numbers (visibility public)
      (parameter create values (type (list Text))) (returns (list I64)) (effect pure)
      (body (call std::list-map (types Text I64) (local values)
        (function-value number-or-invalid))))
    (function create values (visibility private)
      (parameter create query (type Query)) (parameter create name (type Text))
      (returns (list Text)) (effect pure)
      (body (call std::map-get-or (types Text (list Text)) (local query)
        (local name) (list Text))))
    (function create option (visibility private)
      (parameter create query (type Query)) (parameter create name (type Text))
      (parameter create fallback (type I64)) (returns index-number) (effect pure)
      (body (let (binding entries (call values (local query) (local name)))
        (in (if (call std::i64-equal (call std::list-length (types Text) (local entries)) (i64 0))
          (variant index-number::valid (local fallback))
          (if (call std::i64-equal (call std::list-length (types Text) (local entries)) (i64 1))
            (call parse-index (call std::list-get (types Text) (local entries) (i64 0)))
            (variant index-number::invalid)))))))
    (function create title (visibility private)
      (parameter create query (type Query)) (returns Text) (effect pure)
      (body (let (binding entries (call values (local query) (text "title")))
        (in (if (call std::i64-equal (call std::list-length (types Text) (local entries)) (i64 0))
          (text "Native list") (call std::list-get (types Text) (local entries) (i64 0)))))))
    (function create item (visibility private)
      (parameter create text (type Text)) (returns (list html::block)) (effect pure)
      (body (list html::block (variant html::block::paragraph
        (list html::inline (variant html::inline::text (local text)))))))
    (function create document (visibility private)
      (parameter create title (type Text)) (parameter create entries (type (list Text)))
      (parameter create start (type I64)) (parameter create count (type I64))
      (returns Text) (effect pure)
      (body (let (binding selected (call std::list-window (types Text)
        (local entries) (local start) (local count)))
        (in (call html::document (text "en") (local title) (list html::block
          (variant html::block::heading (local title))
          (variant html::block::paragraph (list html::inline (variant html::inline::text
            (call std::text-join (list Text (text "Showing")
              (call std::i64-to-text (call std::list-length (types Text) (local selected)))
              (text "of") (call std::i64-to-text (call std::list-length (types Text) (local entries)))
              (text "items; start") (call std::i64-to-text (local start))) (text " ")))))
          (variant html::block::unordered-list (call std::list-map
            (types Text (list html::block)) (local selected) (function-value item)))))))))
    (function create bad-request (visibility private)
      (returns Response) (effect pure)
      (body (call replies::plain (i64 400)
        (text "start and count require one unsigned ASCII decimal (1-19 bytes); count must not exceed 100"))))
    (function create page (visibility public)
      (parameter create query (type Query)) (returns Response) (effect pure)
      (body (match (call option (local query) (text "start") (i64 0))
        (arm index-number::invalid (call bad-request))
        (arm index-number::valid (payload start I64)
          (match (call option (local query) (text "count") (i64 10))
            (arm index-number::invalid (call bad-request))
            (arm index-number::valid (payload count I64)
              (if (call std::less (i64 100) (local count)) (call bad-request)
                (call replies::with-header
                  (call replies::respond (i64 200) (text "text/html; charset=utf-8")
                    (call std::bytes-from-text (call document (call title (local query))
                      (call values (local query) (text "item")) (local start) (local count))))
                  (text "x-content-type-options") (text "nosniff")))))))))
    (function create home (visibility private)
      (parameter create request (type Request)) (returns Response)
      (effect (task (requirement server::streams)))
      (body (call page (field (local request) (name query_parameters)))))
    (component create server (visibility private)
      (requirement create streams (interface std::ByteStream)
        (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
      (port create home (type (task-function (Request) Response (row (requirement streams))))
        (function home)))
    (component create console (visibility private)
      (port create numbers (type (function ((list Text)) (list I64))) (function numbers))
      (port create preview (type (function (Query) Response)) (function page)))
    (test create zero-and-leading-zeroes (visibility private)
      (actual (call numbers (list Text (text "0") (text "00012"))))
      (expected (list I64 (i64 0) (i64 12))))
    (test create adjacent-i64-boundary (visibility private)
      (actual (call numbers (list Text (text "9223372036854775807") (text "9223372036854775808"))))
      (expected (list I64 (i64 9223372036854775807) (i64 -1))))
    (test create reject-signs-and-empty (visibility private)
      (actual (call numbers (list Text (text "") (text "+1") (text "-1"))))
      (expected (list I64 (i64 -1) (i64 -1) (i64 -1))))
    (test create reject-nonascii-and-spacing (visibility private)
      (actual (call numbers (list Text (text "１") (text "1 ") (text " 1") (text "1e2"))))
      (expected (list I64 (i64 -1) (i64 -1) (i64 -1) (i64 -1))))
    (test create bounded-zero-width (visibility private)
      (actual (call numbers (list Text (text "0000000000000000000") (text "00000000000000000000"))))
      (expected (list I64 (i64 0) (i64 -1))))
    (test create empty-page (visibility private)
      (actual (field (call page (map Text (list Text))) (name status))) (expected (i64 200)))
    (test create duplicate-start-rejected (visibility private)
      (actual (field (call page (map Text (list Text)
        (entry (text "start") (list Text (text "0") (text "0"))))) (name status)))
      (expected (i64 400)))
    (test create count-bound-rejected (visibility private)
      (actual (field (call page (map Text (list Text)
        (entry (text "count") (list Text (text "101"))))) (name status))) (expected (i64 400)))
    (test create middle-page-escaped (visibility private)
      (actual (call document (text "<List>") (list Text (text "a") (text "<&") (text "")) (i64 1) (i64 2)))
      (expected (text "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>&lt;List&gt;</title></head><body><h2>&lt;List&gt;</h2><p>Showing 2 of 3 items; start 1</p><ul><li><p>&lt;&amp;</p></li><li><p></p></li></ul></body></html>")))
    (test create maximum-start-empty-window (visibility private)
      (actual (call document (text "") (list Text (text "a")) (i64 9223372036854775807) (i64 100)))
      (expected (text "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title></title></head><body><h2></h2><p>Showing 0 of 1 items; start 9223372036854775807</p><ul></ul></body></html>"))))
  (target create paged-web (component catalog::server) (runner http)
    (route create home (method GET) (path "/") (port catalog::server::home)))
  (target create numbers (component catalog::console) (runner command) (port catalog::console::numbers))
  (target create preview (component catalog::console) (runner command) (port catalog::console::preview)))
declarations.end

request base=BASE
declarations.begin
(units
  (use std builtin)
  (module create counts
    (function create window-loop (visibility private)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create position (type I64))
      (parameter create end (type I64))
      (parameter create selected (type (list Item)))
      (returns (list Item)) (effect pure)
      (body
        (if (call std::less (local position) (local end))
          (call window-loop (types Item) (local items)
            (call std::add (local position) (i64 1)) (local end)
            (call std::list-append (types Item) (local selected)
              (call std::list-get (types Item) (local items) (local position))))
          (local selected))))
    (function create window (visibility public)
      (type-parameter create Item)
      (parameter create items (type (list Item)))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (returns (list Item)) (effect pure)
      (body
        (let
          (binding length (call std::list-length (types Item) (local items)))
          (binding lower
            (if (call std::less (local start) (i64 0)) (i64 0)
              (if (call std::less (local length) (local start)) (local length) (local start))))
          (binding remaining (call std::subtract (local length) (local lower)))
          (binding actual
            (if (call std::less (local count) (i64 0)) (i64 0)
              (if (call std::less (local remaining) (local count)) (local remaining) (local count))))
          (in
            (call window-loop (types Item) (local items) (local lower)
              (call std::add (local lower) (local actual)) (list Item))))))
    (function create count-step (visibility private)
      (parameter create totals (type (map Text I64)))
      (parameter create item (type Text))
      (returns (map Text I64)) (effect pure)
      (body
        (call std::map-insert (types Text I64) (local totals) (local item)
          (call std::add
            (call std::map-get-or (types Text I64) (local totals) (local item) (i64 0))
            (i64 1)))))
    (function create page (visibility public)
      (parameter create items (type (list Text)))
      (parameter create start (type I64))
      (parameter create count (type I64))
      (returns (list (record (key Text) (value I64)))) (effect pure)
      (body
        (call window (types (record (key Text) (value I64)))
          (call std::map-entries (types Text I64)
            (call std::list-fold-left (types Text (map Text I64))
              (local items) (map Text I64) (function-value count-step)))
          (local start) (local count))))
    (test create window-middle (visibility private)
      (actual (call window (types I64) (list I64 (i64 1) (i64 2) (i64 3) (i64 4)) (i64 1) (i64 2)))
      (expected (list I64 (i64 2) (i64 3))))
    (test create window-negative-start (visibility private)
      (actual (call window (types I64) (list I64 (i64 1) (i64 2) (i64 3)) (i64 -9223372036854775808) (i64 2)))
      (expected (list I64 (i64 1) (i64 2))))
    (test create window-past-end (visibility private)
      (actual (call window (types I64) (list I64 (i64 1)) (i64 9223372036854775807) (i64 9223372036854775807)))
      (expected (list I64)))
    (test create window-large-count (visibility private)
      (actual (call window (types I64) (list I64 (i64 1) (i64 2) (i64 3)) (i64 1) (i64 9223372036854775807)))
      (expected (list I64 (i64 2) (i64 3))))
    (test create window-negative-count (visibility private)
      (actual (call window (types I64) (list I64 (i64 1)) (i64 0) (i64 -9223372036854775808)))
      (expected (list I64)))
    (test create window-empty (visibility private)
      (actual (call window (types Text) (list Text) (i64 0) (i64 1)))
      (expected (list Text)))
    (test create page-first (visibility private)
      (actual (call page (list Text (text "pear") (text "apple") (text "pear")) (i64 0) (i64 1)))
      (expected (list (record (key Text) (value I64))
        (record structural (field key (text "apple")) (field value (i64 1))))))
    (test create page-second (visibility private)
      (actual (call page (list Text (text "pear") (text "apple") (text "pear")) (i64 1) (i64 1)))
      (expected (list (record (key Text) (value I64))
        (record structural (field key (text "pear")) (field value (i64 2))))))
    (component create console (visibility private)
      (port create page (type (function ((list Text) I64 I64) (list (record (key Text) (value I64)))))
        (function page))))
  (target create page (component counts::console) (runner command) (port counts::console::page)))
declarations.end

request base=LIBRARY_BASE

declarations.begin
(units
  (use std builtin)
  (type-alias Header (record (name Text) (value Bytes)))
  (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
  (module create responses
    (function create header (visibility public)
      (parameter create name (type Text))
      (parameter create value (type Text))
      (returns Header) (effect pure)
      (body (record structural
        (field name (local name))
        (field value (call std::bytes-from-text (local value))))))
    (function create respond (visibility public)
      (parameter create status (type I64))
      (parameter create content-type (type Text))
      (parameter create body (type Bytes))
      (returns Response) (effect pure)
      (body (record structural
        (field body (local body))
        (field headers (list Header (call header (text "content-type") (local content-type))))
        (field status (local status)))))
    (function create plain (visibility public)
      (parameter create status (type I64))
      (parameter create body (type Text))
      (returns Response) (effect pure)
      (body (call respond (local status) (text "text/plain; charset=utf-8")
        (call std::bytes-from-text (local body)))))
    (function create with-header (visibility public)
      (parameter create response (type Response))
      (parameter create name (type Text))
      (parameter create value (type Text))
      (returns Response) (effect pure)
      (body (record structural
        (field body (field (local response) (name body)))
        (field headers (call std::list-append (types Header)
          (field (local response) (name headers)) (call header (local name) (local value))))
        (field status (field (local response) (name status))))))
    (test create empty-body (visibility private)
      (actual (field (call plain (i64 200) (text "")) (name body)))
      (expected (call std::bytes-from-text (text ""))))
    (test create status-preserved (visibility private)
      (actual (field (call plain (i64 201) (text "created")) (name status)))
      (expected (i64 201)))
    (test create unicode-and-nul-preserved (visibility private)
      (actual (field (call plain (i64 200) (text "日本語\u{0}&<>")) (name body)))
      (expected (call std::bytes-from-text (text "日本語\u{0}&<>"))))
    (test create binary-content-type (visibility private)
      (actual (field (call respond (i64 200) (text "application/octet-stream")
        (call std::bytes-from-text (text "data"))) (name headers)))
      (expected (list Header (record structural
        (field name (text "content-type"))
        (field value (call std::bytes-from-text (text "application/octet-stream")))))))
    (test create appended-header-order (visibility private)
      (actual (field (call with-header (call plain (i64 200) (text "ready"))
        (text "cache-control") (text "no-store")) (name headers)))
      (expected (list Header
        (record structural (field name (text "content-type"))
          (field value (call std::bytes-from-text (text "text/plain; charset=utf-8"))))
        (record structural (field name (text "cache-control"))
          (field value (call std::bytes-from-text (text "no-store")))))))
    (test create decoration-preserves-body (visibility private)
      (actual (field (call with-header (call plain (i64 202) (text "accepted"))
        (text "x-example") (text "one")) (name body)))
      (expected (call std::bytes-from-text (text "accepted"))))
    (test create decoration-preserves-status (visibility private)
      (actual (field (call with-header (call plain (i64 202) (text "accepted"))
        (text "x-example") (text "one")) (name status)))
      (expected (i64 202)))))
declarations.end

  "measurement_timer_source": "import fs from 'node:fs';\nimport {spawn} from 'node:child_process';\nconst suffix=process.argv[2];\nconst sizes=process.argv.slice(3).map(Number);\nconst budget=process.env.LKJ_BENCH_MEMORY_BYTES||\"268435456\";\nfor(const size of (sizes.length?sizes:[25000,50000])){\n const samples=[];\n for(let repeat=0;repeat<3;repeat++){\n  const start=performance.now(),child=spawn('prlimit',['--as='+budget,`target/library-next/map-${size}-${suffix}.elf`]);\n  let error='',peak=0;\n  child.stderr.on('data',chunk=>error+=chunk);\n  const timer=setTimeout(()=>child.kill('SIGKILL'),30000);\n  const sample=setInterval(()=>{try{const text=fs.readFileSync(`/proc/${child.pid}/status`,'utf8'),match=text.match(/^VmHWM:\\s+(\\d+)/m);if(match)peak=Math.max(peak,Number(match[1]));}catch{}},10);\n  const code=await new Promise(resolve=>child.once('exit',resolve));\n  clearTimeout(timer);clearInterval(sample);\n  if(code!==0)throw new Error(`map ${size} ${suffix}: ${code} ${error}`);\n  samples.push({milliseconds:performance.now()-start,sampled_peak_kib:peak});\n }\n fs.writeFileSync(`target/library-next/map-${size}-${suffix}.json`,JSON.stringify(samples,null,2)+'\\n');\n console.log(JSON.stringify({size,suffix,samples}));\n}\n"
}

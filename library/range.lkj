//! Ordinary range values. Integer iteration uses checked arithmetic.
use crate::iter::{IntoIterator, Iterator};
use crate::Option;
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub enum Bound<T> { Included(T), Excluded(T), Unbounded }
#[derive(Clone, PartialEq, Eq, Default)]
pub struct Range<T> { pub start: T, pub end: T }
#[derive(Clone, PartialEq, Eq)]
pub struct RangeFrom<T> { pub start: T }
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct RangeTo<T> { pub end: T }
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct RangeToInclusive<T> { pub end: T }
#[derive(Clone, Copy, PartialEq, Eq, Default)]
pub struct RangeFull;
#[derive(Clone, PartialEq, Eq)]
pub struct RangeInclusive<T> { start: T, end: T, exhausted: bool }
impl<T> RangeInclusive<T> {
    pub fn new(start: T, end: T) -> Self { Self { start, end, exhausted: false } }
    pub fn start(&self) -> &T { &self.start }
    pub fn end(&self) -> &T { &self.end }
}
impl<T: PartialOrd> RangeInclusive<T> {
    pub fn contains(&self, item: &T) -> bool {
        !self.exhausted && self.start <= *item && *item <= self.end
    }
    pub fn is_empty(&self) -> bool { self.exhausted || !(self.start <= self.end) }
}
pub trait RangeBounds<T: PartialOrd + ?Sized> {
    fn start_bound(&self) -> Bound<&T>;
    fn end_bound(&self) -> Bound<&T>;
    fn contains(&self, item: &T) -> bool {
        let after = match self.start_bound() {
            Bound::Included(start) => *item >= *start,
            Bound::Excluded(start) => *item > *start,
            Bound::Unbounded => true,
        };
        let before = match self.end_bound() {
            Bound::Included(end) => *item <= *end,
            Bound::Excluded(end) => *item < *end,
            Bound::Unbounded => true,
        };
        after && before
    }
}
impl<T: PartialOrd> RangeBounds<T> for Range<T> {
    fn start_bound(&self) -> Bound<&T> { Bound::Included(&self.start) }
    fn end_bound(&self) -> Bound<&T> { Bound::Excluded(&self.end) }
}
impl<T: PartialOrd> RangeBounds<T> for RangeFrom<T> {
    fn start_bound(&self) -> Bound<&T> { Bound::Included(&self.start) }
    fn end_bound(&self) -> Bound<&T> { Bound::Unbounded }
}
impl<T: PartialOrd> RangeBounds<T> for RangeTo<T> {
    fn start_bound(&self) -> Bound<&T> { Bound::Unbounded }
    fn end_bound(&self) -> Bound<&T> { Bound::Excluded(&self.end) }
}
impl<T: PartialOrd> RangeBounds<T> for RangeToInclusive<T> {
    fn start_bound(&self) -> Bound<&T> { Bound::Unbounded }
    fn end_bound(&self) -> Bound<&T> { Bound::Included(&self.end) }
}
impl<T: PartialOrd + ?Sized> RangeBounds<T> for RangeFull {
    fn start_bound(&self) -> Bound<&T> { Bound::Unbounded }
    fn end_bound(&self) -> Bound<&T> { Bound::Unbounded }
}
impl<T: PartialOrd> RangeBounds<T> for RangeInclusive<T> {
    fn start_bound(&self) -> Bound<&T> { Bound::Included(&self.start) }
    fn end_bound(&self) -> Bound<&T> {
        if self.exhausted { Bound::Excluded(&self.end) } else { Bound::Included(&self.end) }
    }
}
pub fn range<T>(start: T, end: T) -> Range<T> { Range { start, end } }
pub fn range_from<T>(start: T) -> RangeFrom<T> { RangeFrom { start } }
pub fn range_to<T>(end: T) -> RangeTo<T> { RangeTo { end } }
pub fn range_to_inclusive<T>(end: T) -> RangeToInclusive<T> { RangeToInclusive { end } }
pub fn range_inclusive<T>(start: T, end: T) -> RangeInclusive<T> { RangeInclusive::new(start, end) }
pub fn range_full() -> RangeFull { RangeFull }

impl Iterator for Range<u8> {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        if self.start >= self.end { return Option::None; }
        let value = self.start;
        self.start += 1u8;
        Option::Some(value)
    }
}
impl IntoIterator for Range<u8> {
    type IntoIter = Self;
    fn into_iter(self) -> Self { self }
}
impl Iterator for RangeInclusive<u8> {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        if self.exhausted || self.start > self.end { self.exhausted = true; return Option::None; }
        let value = self.start;
        if self.start == self.end { self.exhausted = true; } else { self.start += 1u8; }
        Option::Some(value)
    }
}
impl IntoIterator for RangeInclusive<u8> {
    type IntoIter = Self;
    fn into_iter(self) -> Self { self }
}
impl Iterator for RangeFrom<u8> {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        let value = self.start;
        self.start += 1u8;
        Option::Some(value)
    }
}
impl IntoIterator for RangeFrom<u8> {
    type IntoIter = Self;
    fn into_iter(self) -> Self { self }
}


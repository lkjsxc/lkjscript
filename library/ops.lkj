//! Operators are ordinary source contracts and checked source calls.
//! This slice gives AddAssign its standard omitted-argument Self RHS; explicit
//! heterogeneous AddAssign<Rhs> and trait parameter defaults are not admitted.
pub use crate::range::{Bound, Range, RangeFrom, RangeTo, RangeToInclusive,
    RangeFull, RangeInclusive, RangeBounds};

pub trait AddAssign: Sized {
    fn add_assign(&mut self, rhs: Self);
}
pub trait Shl<Rhs>: Sized {
    type Output;
    fn shl(self, rhs: Rhs) -> Self::Output;
}
pub trait Shr<Rhs>: Sized {
    type Output;
    fn shr(self, rhs: Rhs) -> Self::Output;
}
pub trait Div<Rhs>: Sized {
    type Output;
    fn div(self, rhs: Rhs) -> Self::Output;
}

// Primitive bodies use the existing primitive operation vocabulary.
impl AddAssign for i8 {
    fn add_assign(&mut self, rhs: i8) { *self = *self + rhs; }
}
impl Shl<usize> for i8 {
    type Output = i8;
    fn shl(self, rhs: usize) -> i8 { self << rhs }
}
impl Shr<usize> for i8 {
    type Output = i8;
    fn shr(self, rhs: usize) -> i8 { self >> rhs }
}
impl Div<i8> for i8 {
    type Output = i8;
    fn div(self, rhs: i8) -> i8 { self / rhs }
}

}

pub fn __lkjscript_directory_rename_new(
    directory: &mut Directory,
    old: &str,
    new: &str,
) -> Result<(), i64> {
    let old = path_bytes(old)?;
    let new = path_bytes(new)?;
    unit_result(directory.__lkjscript_rename_new(&old, &new))
}

pub fn __lkjscript_directory_open_regular(directory: &mut Directory, name: &str) -> Result<File, i64> {
    directory.__lkjscript_open_regular(&path_bytes(name)?)
}

pub fn directory_identity(directory: &mut Directory) -> Result<[u8; 16], i64> {
    let mut bytes = [0u8; 16];
    unit_result(directory.__lkjscript_identity(&mut bytes))?;
    Result::Ok(bytes)
}

/// Connect only the explicit absolute Unix path; the result is an ordinary owned File.
pub fn __lkjscript_unix_connect(world: &mut World, path: &str) -> Result<File, i64> {
    let bytes = path_bytes(path)?; world.__lkjscript_unix_connect(&bytes)
}
/// Resolve beneath the held Directory, retain the socket inode, then connect to that inode.
pub fn __lkjscript_directory_unix_connect(directory: &mut Directory, path: &str) -> Result<File, i64> {
    let bytes = path_bytes(path)?; directory.__lkjscript_unix_connect(&bytes)
}

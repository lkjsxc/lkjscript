impl Debug for i8 {
    fn fmt(&self, formatter: &mut Formatter) -> Result {
        let value = *self as i64;
        let negative = value < 0i64;
        let magnitude = if negative { (-(value + 1i64)) as u64 + 1u64 } else { value as u64 };
        formatter.number(magnitude, negative, 10u64, false)
    }
}


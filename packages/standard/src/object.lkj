; Named object storage keeps application ownership and visibility policy outside the adapter.
(module object
  (export ObjectStorage)
  (interface ObjectStorage
    (operation put-new
      ((key Text) (body (Stream Bytes)) (content-type StaticText))
      (Record
        (key Text) (size I64) (blake3 Text) (version Text) (cleanup_pending Bool))
      idempotent-with-key possible-visibility)
    (operation get ((key Text) (maximum-bytes I64)) Bytes idempotent no-visibility)
    (operation range ((key Text) (start I64) (length I64)) Bytes idempotent no-visibility)
    (operation head ((key Text))
      (Record (key Text) (size I64) (etag Text) (version Text) (modified_milliseconds I64))
      idempotent no-visibility)
    (operation reconcile-put ((key Text))
      (List (Record
        (key Text) (size I64) (blake3 Text) (version Text) (cleanup_pending Bool)))
      idempotent no-visibility)
    (operation delete ((key Text)) Unit idempotent-with-key possible-visibility)))

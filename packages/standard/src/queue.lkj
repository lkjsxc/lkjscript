; Job payload and retry policy are application meaning; claims and leases are generic mechanics.
(module queue
  (export DurableQueue)
  (interface DurableQueue
    (operation initialize () Unit idempotent-with-key possible-visibility)
    (operation enqueue
      ((job-id Text) (idempotency-key Text) (payload Bytes)
       (available-at-milliseconds I64) (created-at-milliseconds I64))
      Bool
      idempotent-with-key possible-visibility)
    (operation claim
      ((worker-id Text) (now-milliseconds I64) (lease-milliseconds I64))
      (List (Record
        (job_id Text) (attempt_id Text) (payload Bytes)
        (attempt_number I64) (lease_until_milliseconds I64)))
      idempotent-with-key possible-visibility)
    (operation heartbeat
      ((job-id Text) (attempt-id Text) (worker-id Text)
       (now-milliseconds I64) (lease-milliseconds I64))
      Bool
      idempotent-with-key possible-visibility)
    (operation complete
      ((job-id Text) (attempt-id Text) (worker-id Text)
       (now-milliseconds I64) (result Bytes))
      Bool
      idempotent-with-key possible-visibility)
    (operation fail
      ((job-id Text) (attempt-id Text) (worker-id Text) (now-milliseconds I64)
       (retry Bool) (retry-at-milliseconds I64) (error-class Text))
      Bool
      idempotent-with-key possible-visibility)
    (operation cancel ((job-id Text) (now-milliseconds I64)) Bool idempotent-with-key possible-visibility)
    (operation inspect ((job-id Text))
      (List (Record
        (job_id Text) (state Text) (attempt_count I64)
        (available_at_milliseconds I64) (lease_until_milliseconds I64)
        (result Bytes) (last_error_class Text)))
      idempotent no-visibility)))

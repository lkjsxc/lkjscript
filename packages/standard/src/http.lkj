; Standards-shaped HTTP value helpers. Transport and route policy remain outside this package.
(module http
  (export bearer-token)

  ; Returns the token from exactly one canonical `Authorization: Bearer <token>` field.
  ; Missing, duplicate, malformed, non-UTF-8, empty, or excessive fields return empty Text.
  (extern bearer-token
    ((headers (List (Record (name Text) (value Bytes)))))
    Text
    core.http.bearer-token)

  (test bearer-token-valid
    (call bearer-token
      (list (Record (name Text) (value Bytes))
        (record _ (name "authorization") (value (call bytes-from-text "Bearer session-token")))))
    "session-token")
  (test bearer-token-malformed
    (call bearer-token
      (list (Record (name Text) (value Bytes))
        (record _ (name "authorization") (value (call bytes-from-text "Basic value")))))
    "")
  (test bearer-token-duplicate
    (call bearer-token
      (list (Record (name Text) (value Bytes))
        (record _ (name "authorization") (value (call bytes-from-text "Bearer first")))
        (record _ (name "Authorization") (value (call bytes-from-text "Bearer second")))))
    "")

  (extern bytes-from-text ((value Text)) Bytes core.bytes.from-text))

; Streams are task-scoped resources and cannot enter durable values.
(module stream
  (export ByteChunk ByteStream)
  (record ByteChunk (done Bool) (chunk Bytes))
  (interface ByteStream
    (operation read ((stream (Stream Bytes)))
      (Record (done Bool) (chunk Bytes))
      non-idempotent no-visibility)
    (operation close ((stream (Stream Bytes))) Unit idempotent no-visibility)))

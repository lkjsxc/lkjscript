request base=rev_321acc95265487d1cb77d5d54daabdab3cf3b887d53cab7ae04d2c50cb08d6b3 idempotency=standard-byte-conversion
reference.owner as=$core package=local class=module name=core
reference.owner as=$from-text package=local class=declaration parent=$core name=bytes-from-text
reference.owner as=$get package=local class=declaration parent=$core name=bytes-get
declarations.begin
(units
  (external create bytes-from-list (in $core) (visibility public)
    (implementation core.bytes.from-list)
    (parameter create octets (type (list I64))) (returns Bytes))
  (external create bytes-to-text-result (in $core) (visibility public)
    (implementation core.bytes.to-text-result)
    (parameter create bytes (type Bytes)) (returns (record (valid Bool) (value Text))))
  (test create byte-construction-empty (in $core) (visibility private)
    (actual (call bytes-from-list (list I64))) (expected (call $from-text (text ""))))
  (test create byte-construction-controls (in $core) (visibility private)
    (actual (call bytes-from-list (list I64 (i64 0) (i64 65) (i64 13) (i64 10))))
    (expected (call $from-text (text "\u{0}A\r\n"))))
  (test create byte-construction-utf8 (in $core) (visibility private)
    (actual (call bytes-from-list (list I64 (i64 231) (i64 140) (i64 171))))
    (expected (call $from-text (text "猫"))))
  (test create byte-construction-high (in $core) (visibility private)
    (actual (call $get (call bytes-from-list (list I64 (i64 0) (i64 128) (i64 255))) (i64 2)))
    (expected (i64 255)))
  (test create byte-decoding-empty-valid (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64))) (name valid)))
    (expected (bool true)))
  (test create byte-decoding-empty-value (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64))) (name value)))
    (expected (text "")))
  (test create byte-decoding-bom (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call $from-text (text "\u{feff}日本語"))) (name value)))
    (expected (text "\u{feff}日本語")))
  (test create byte-decoding-controls (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64 (i64 0) (i64 13) (i64 10)))) (name value)))
    (expected (text "\u{0}\r\n")))
  (test create byte-decoding-supplementary (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list
      (list I64 (i64 240) (i64 159) (i64 152) (i64 128)))) (name value)))
    (expected (text "😀")))
  (test create byte-decoding-invalid-leading (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64 (i64 255)))) (name valid)))
    (expected (bool false)))
  (test create byte-decoding-invalid-whole-value (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64 (i64 65) (i64 128) (i64 66)))) (name value)))
    (expected (text "")))
  (test create byte-decoding-surrogate (in $core) (visibility private)
    (actual (field (call bytes-to-text-result (call bytes-from-list (list I64 (i64 237) (i64 160) (i64 128)))) (name valid)))
    (expected (bool false))))
declarations.end

request base=rev_85b2be44a8deca911fc6bdf4efdd4fb7b510f53e4a39723fbee263dff4b3a9b2 idempotency=standard-owned-sequences
reference.owner as=$core package=local class=module name=core
reference.owner as=$buffer-empty package=local class=declaration parent=$core name=buffer-empty
reference.owner as=$buffer-push package=local class=declaration parent=$core name=buffer-push
reference.owner as=$buffer-get package=local class=declaration parent=$core name=buffer-get
reference.owner as=$buffer-freeze package=local class=declaration parent=$core name=buffer-freeze
reference.owner as=$from-list package=local class=declaration parent=$core name=bytes-from-list
reference.owner as=$append package=local class=declaration parent=$core name=list-append
declarations.begin
(units
  (type-alias BufferSequence (owned-sequence ByteBuffer))
  (type-alias BufferItem (owned-product (field rest BufferSequence) (field value ByteBuffer)))
  (type-alias BufferPop (owned-choice (case empty BufferSequence) (case item BufferItem)))
  (type-alias NestedSequence (owned-sequence BufferSequence))
  (function create sequence-empty (in $core) (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (returns (owned-sequence T))
    (body (sequence-empty (type (owned-sequence T)))))
  (function create sequence-length (in $core) (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create items (type (owned-sequence T)) (use borrow))
    (returns I64)
    (body (sequence-length (type (owned-sequence T)) (local items))))
  (function create sequence-push (in $core) (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create value (type T) (use consume))
    (parameter create items (type (owned-sequence T)) (use consume))
    (returns (owned-sequence T))
    (body (sequence-push (type (owned-sequence T)) (local value) (local items))))
  (function create sequence-pop (in $core) (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create items (type (owned-sequence T)) (use consume))
    (returns (owned-choice
      (case empty (owned-sequence T))
      (case item (owned-product (field rest (owned-sequence T)) (field value T)))))
    (body (sequence-pop (type (owned-sequence T)) (local items))))
  (function create sequence-discard (in $core) (visibility public) (effect pure)
    (type-parameter create T (constraint owned))
    (parameter create items (type (owned-sequence T)) (use consume))
    (returns Unit) (body (unit)))
  (function create sequence-test-octet (in $core) (visibility private) (effect pure)
    (parameter create octet (type I64)) (returns ByteBuffer)
    (body (let (binding value (type ByteBuffer) (call $buffer-empty))
      (in (call $buffer-push (local octet) (local value))))))
  (function create sequence-test-three (in $core) (visibility private) (effect pure)
    (returns BufferSequence)
    (body (let
      (binding items (type BufferSequence) (call sequence-empty (types ByteBuffer)))
      (binding a (type ByteBuffer) (call sequence-test-octet (i64 0)))
      (binding items (type BufferSequence) (call sequence-push (types ByteBuffer) (local a) (local items)))
      (binding b (type ByteBuffer) (call sequence-test-octet (i64 255)))
      (binding items (type BufferSequence) (call sequence-push (types ByteBuffer) (local b) (local items)))
      (binding c (type ByteBuffer) (call sequence-test-octet (i64 128)))
      (in (call sequence-push (types ByteBuffer) (local c) (local items))))))
  (function create sequence-test-drain (in $core) (visibility private) (effect pure)
    (parameter create output (type (list Bytes)))
    (parameter create items (type BufferSequence) (use consume)) (returns (list Bytes))
    (body (let (binding popped (type BufferPop) (call sequence-pop (types ByteBuffer) (local items)))
      (in (match-owned (type BufferPop) (local popped)
        (case empty (binding rest (type BufferSequence)) (in (local output)))
        (case item (binding result (type BufferItem))
          (in (unpack-owned (type BufferItem) (local result)
            (field rest (binding rest (type BufferSequence)))
            (field value (binding value (type ByteBuffer)))
            (in (let (binding frozen (type Bytes) (call $buffer-freeze (local value)))
              (in (call sequence-test-drain
                (call $append (types Bytes) (local output) (local frozen)) (local rest)))))))))))))
  (test create sequence-empty-length (in $core) (visibility private)
    (actual (let (binding items (type BufferSequence) (call sequence-empty (types ByteBuffer)))
      (in (call sequence-length (types ByteBuffer) (local items)))))
    (expected (i64 0)))
  (test create sequence-empty-pop-reuse (in $core) (visibility private)
    (actual (let
      (binding items (type BufferSequence) (call sequence-empty (types ByteBuffer)))
      (binding popped (type BufferPop) (call sequence-pop (types ByteBuffer) (local items)))
      (in (match-owned (type BufferPop) (local popped)
        (case empty (binding rest (type BufferSequence))
          (in (let
            (binding value (type ByteBuffer) (call sequence-test-octet (i64 7)))
            (binding items (type BufferSequence) (call sequence-push (types ByteBuffer) (local value) (local rest)))
            (in (record structural
              (field length (call sequence-length (types ByteBuffer) (local items)))
              (field value (borrow-owned-item (type BufferSequence) (local items) (index (i64 0))
                (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view))))))))))
        (case item (binding result (type BufferItem))
          (in (record structural (field length (i64 -1)) (field value (i64 -1)))))))))
    (expected (record structural (field length (i64 1)) (field value (i64 7)))))
  (test create sequence-indexed-repeat (in $core) (visibility private)
    (actual (let (binding items (type BufferSequence) (call sequence-test-three))
      (in (record structural
        (field length (call sequence-length (types ByteBuffer) (local items)))
        (field first (borrow-owned-item (type BufferSequence) (local items) (index (i64 0))
          (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))
        (field second (borrow-owned-item (type BufferSequence) (local items) (index (i64 1))
          (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))
        (field third (borrow-owned-item (type BufferSequence) (local items) (index (i64 2))
          (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))
        (field again (borrow-owned-item (type BufferSequence) (local items) (index (i64 1))
          (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))))))
    (expected (record structural (field length (i64 3)) (field first (i64 0))
      (field second (i64 255)) (field third (i64 128)) (field again (i64 255)))))
  (test create sequence-lifo-drain (in $core) (visibility private)
    (actual (let (binding items (type BufferSequence) (call sequence-test-three))
      (in (call sequence-test-drain (list Bytes) (local items)))))
    (expected (list Bytes
      (call $from-list (list I64 (i64 128)))
      (call $from-list (list I64 (i64 255)))
      (call $from-list (list I64 (i64 0))))))
  (test create sequence-pop-replace (in $core) (visibility private)
    (actual (let
      (binding items (type BufferSequence) (call sequence-test-three))
      (binding popped (type BufferPop) (call sequence-pop (types ByteBuffer) (local items)))
      (in (match-owned (type BufferPop) (local popped)
        (case empty (binding rest (type BufferSequence)) (in (list Bytes)))
        (case item (binding result (type BufferItem))
          (in (unpack-owned (type BufferItem) (local result)
            (field rest (binding rest (type BufferSequence)))
            (field value (binding removed (type ByteBuffer)))
            (in (let
              (binding replacement (type ByteBuffer) (call sequence-test-octet (i64 11)))
              (binding items (type BufferSequence)
                (call sequence-push (types ByteBuffer) (local replacement) (local rest)))
              (in (call sequence-test-drain (list Bytes) (local items))))))))))))
    (expected (list Bytes
      (call $from-list (list I64 (i64 11)))
      (call $from-list (list I64 (i64 255)))
      (call $from-list (list I64 (i64 0))))))
  (test create sequence-nested-read (in $core) (visibility private)
    (actual (let
      (binding inner (type BufferSequence) (call sequence-test-three))
      (binding outer (type NestedSequence) (call sequence-empty (types BufferSequence)))
      (binding outer (type NestedSequence)
        (call sequence-push (types BufferSequence) (local inner) (local outer)))
      (in (borrow-owned-item (type NestedSequence) (local outer) (index (i64 0))
        (binding inner (type BufferSequence))
        (in (record structural
          (field length (call sequence-length (types ByteBuffer) (local inner)))
          (field value (borrow-owned-item (type BufferSequence) (local inner) (index (i64 2))
            (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))))))))
    (expected (record structural (field length (i64 3)) (field value (i64 128)))))
  (test create sequence-discard-populated (in $core) (visibility private)
    (actual (let (binding items (type BufferSequence) (call sequence-test-three))
      (in (call sequence-discard (types ByteBuffer) (local items)))))
    (expected (unit))))
declarations.end

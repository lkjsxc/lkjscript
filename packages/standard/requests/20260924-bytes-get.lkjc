request base=rev_0c24feeba2cf086edecde1241930f4a8019f0c1c7f5a6dfe72b187f02662a5bb idempotency=standard-byte-index
reference.owner as=$core package=local class=module name=core
reference.owner as=$from-text package=local class=declaration parent=$core name=bytes-from-text
declarations.begin
(units
  (external create bytes-get (in $core) (visibility public)
    (implementation core.bytes.get)
    (parameter create bytes (type Bytes))
    (parameter create index (type I64))
    (returns I64))
  (test create bytes-get-first (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "ABC")) (i64 0)))
    (expected (i64 65)))
  (test create bytes-get-last (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "ABC")) (i64 2)))
    (expected (i64 67)))
  (test create bytes-get-zero (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "\u{0}")) (i64 0)))
    (expected (i64 0)))
  (test create bytes-get-utf8-leading (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "猫")) (i64 0)))
    (expected (i64 231)))
  (test create bytes-get-utf8-continuation (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "猫")) (i64 1)))
    (expected (i64 140)))
  (test create bytes-get-utf8-last (in $core) (visibility private)
    (actual (call bytes-get (call $from-text (text "猫")) (i64 2)))
    (expected (i64 171))))
declarations.end

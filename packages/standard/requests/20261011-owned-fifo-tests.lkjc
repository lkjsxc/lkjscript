request base=rev_03ffe011a1c099f30c130017043f8afaa842b2a7b1674ba973639f4736991a25 idempotency=standard-owned-fifo-tests
reference.owner as=$core package=local class=module name=core
reference.owner as=$empty package=local class=declaration parent=$core name=fifo-empty
reference.owner as=$length package=local class=declaration parent=$core name=fifo-length
reference.owner as=$push package=local class=declaration parent=$core name=fifo-push
reference.owner as=$pop package=local class=declaration parent=$core name=fifo-pop
reference.owner as=$front package=local class=declaration parent=$core name=fifo-front
reference.owner as=$discard package=local class=declaration parent=$core name=fifo-discard
reference.owner as=$buffer-empty package=local class=declaration parent=$core name=buffer-empty
reference.owner as=$buffer-push package=local class=declaration parent=$core name=buffer-push
reference.owner as=$buffer-get package=local class=declaration parent=$core name=buffer-get
reference.owner as=$freeze package=local class=declaration parent=$core name=buffer-freeze
reference.owner as=$octets package=local class=declaration parent=$core name=bytes-from-list
reference.owner as=$append package=local class=declaration parent=$core name=list-append
declarations.begin
(units
  (type-alias Queue (owned-product (field incoming (owned-sequence ByteBuffer)) (field outgoing (owned-sequence ByteBuffer))))
  (type-alias Item (owned-product (field rest Queue) (field value ByteBuffer)))
  (type-alias Pop (owned-choice (case empty Queue) (case item Item)))
  (type-alias Drain (owned-product (field rest Queue) (field values (list Bytes))))
  (type-alias Nested (owned-product (field incoming (owned-sequence Queue)) (field outgoing (owned-sequence Queue))))
  (function create fifo-test-buffer (in $core) (visibility private) (effect pure)
    (parameter create n (type I64)) (returns ByteBuffer)
    (body (let (binding b (type ByteBuffer) (call $buffer-empty))
      (in (call $buffer-push (local n) (local b))))))
  (function create fifo-test-three (in $core) (visibility private) (effect pure) (returns Queue)
    (body (let
      (binding q (type Queue) (call $empty (types ByteBuffer)))
      (binding a (type ByteBuffer) (call fifo-test-buffer (i64 0)))
      (binding q (type Queue) (call $push (types ByteBuffer) (local a) (local q)))
      (binding b (type ByteBuffer) (call fifo-test-buffer (i64 255)))
      (binding q (type Queue) (call $push (types ByteBuffer) (local b) (local q)))
      (binding c (type ByteBuffer) (call fifo-test-buffer (i64 128)))
      (in (call $push (types ByteBuffer) (local c) (local q))))))
  (function create fifo-test-front (in $core) (visibility private) (effect pure)
    (parameter create q (type Queue) (use borrow)) (returns I64)
    (body (borrow-call (call $front (types ByteBuffer) (local q))
      (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view))))))
  (function create fifo-test-drain (in $core) (visibility private) (effect pure)
    (parameter create values (type (list Bytes))) (parameter create q (type Queue) (use consume)) (returns Drain)
    (body (let (binding popped (type Pop) (call $pop (types ByteBuffer) (local q)))
      (in (match-owned (type Pop) (local popped)
        (case empty (binding rest (type Queue))
          (in (pack-owned (type Drain) (field rest (local rest)) (field values (local values)))))
        (case item (binding item (type Item))
          (in (unpack-owned (type Item) (local item)
            (field rest (binding rest (type Queue))) (field value (binding value (type ByteBuffer)))
            (in (let (binding bytes (type Bytes) (call $freeze (local value)))
              (in (call fifo-test-drain (call $append (types Bytes) (local values) (local bytes)) (local rest)))))))))))))
  (function create fifo-test-values (in $core) (visibility private) (effect pure)
    (parameter create q (type Queue) (use consume)) (returns (list Bytes))
    (body (let (binding drained (type Drain) (call fifo-test-drain (list Bytes) (local q)))
      (in (field (local drained) (name values))))))
  (test create fifo-empty-length (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call $empty (types ByteBuffer))) (in (call $length (types ByteBuffer) (local q)))))
    (expected (i64 0)))
  (test create fifo-empty-pop-reuse (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call $empty (types ByteBuffer)))
      (binding popped (type Pop) (call $pop (types ByteBuffer) (local q)))
      (in (match-owned (type Pop) (local popped)
        (case empty (binding rest (type Queue))
          (in (let (binding value (type ByteBuffer) (call fifo-test-buffer (i64 7)))
            (binding q (type Queue) (call $push (types ByteBuffer) (local value) (local rest)))
            (in (call fifo-test-values (local q))))))
        (case item (binding item (type Item)) (in (list Bytes)))))))
    (expected (list Bytes (call $octets (list I64 (i64 7))))))
  (test create fifo-insertion-order (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call fifo-test-three)) (in (call fifo-test-values (local q)))))
    (expected (list Bytes (call $octets (list I64 (i64 0))) (call $octets (list I64 (i64 255))) (call $octets (list I64 (i64 128))))))
  (test create fifo-front-repeat-before-refill (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call fifo-test-three))
      (binding first (type I64) (call fifo-test-front (local q)))
      (binding again (type I64) (call fifo-test-front (local q)))
      (binding count (type I64) (call $length (types ByteBuffer) (local q)))
      (in (record structural (field first (local first)) (field again (local again)) (field count (local count))
        (field values (call fifo-test-values (local q)))))))
    (expected (record structural (field first (i64 0)) (field again (i64 0)) (field count (i64 3))
      (field values (list Bytes (call $octets (list I64 (i64 0))) (call $octets (list I64 (i64 255))) (call $octets (list I64 (i64 128))))))))
  (test create fifo-interleaved-refill-order (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call fifo-test-three))
      (binding popped (type Pop) (call $pop (types ByteBuffer) (local q)))
      (in (match-owned (type Pop) (local popped)
        (case empty (binding q (type Queue))
          (in (record structural (field removed (call $octets (list I64))) (field front (i64 -1)) (field count (i64 -1)) (field values (list Bytes)))))
        (case item (binding item (type Item))
          (in (unpack-owned (type Item) (local item)
            (field rest (binding q (type Queue))) (field value (binding value (type ByteBuffer)))
            (in (let
              (binding removed (type Bytes) (call $freeze (local value)))
              (binding a (type ByteBuffer) (call fifo-test-buffer (i64 7)))
              (binding q (type Queue) (call $push (types ByteBuffer) (local a) (local q)))
              (binding b (type ByteBuffer) (call fifo-test-buffer (i64 11)))
              (binding q (type Queue) (call $push (types ByteBuffer) (local b) (local q)))
              (binding front (type I64) (call fifo-test-front (local q)))
              (binding count (type I64) (call $length (types ByteBuffer) (local q)))
              (in (record structural (field removed (local removed)) (field front (local front)) (field count (local count))
                (field values (call fifo-test-values (local q))))))))))))))
    (expected (record structural (field removed (call $octets (list I64 (i64 0)))) (field front (i64 255)) (field count (i64 4))
      (field values (list Bytes (call $octets (list I64 (i64 255))) (call $octets (list I64 (i64 128)))
        (call $octets (list I64 (i64 7))) (call $octets (list I64 (i64 11))))))))
  (test create fifo-drain-retains-empty-owner (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call fifo-test-three))
      (binding drained (type Drain) (call fifo-test-drain (list Bytes) (local q)))
      (in (unpack-owned (type Drain) (local drained)
        (field rest (binding q (type Queue))) (field values (binding values (type (list Bytes))))
        (in (let (binding empty (type I64) (call $length (types ByteBuffer) (local q)))
          (binding value (type ByteBuffer) (call fifo-test-buffer (i64 42)))
          (binding q (type Queue) (call $push (types ByteBuffer) (local value) (local q)))
          (in (record structural (field empty (local empty)) (field reused (call fifo-test-values (local q)))))))))))
    (expected (record structural (field empty (i64 0)) (field reused (list Bytes (call $octets (list I64 (i64 42))))))))
  (test create fifo-empty-buffer-is-an-item (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call $empty (types ByteBuffer)))
      (binding value (type ByteBuffer) (call $buffer-empty))
      (binding q (type Queue) (call $push (types ByteBuffer) (local value) (local q)))
      (in (call fifo-test-values (local q)))))
    (expected (list Bytes (call $octets (list I64)))))
  (test create fifo-nested-front-provenance (in $core) (visibility private)
    (actual (let (binding inner (type Queue) (call fifo-test-three))
      (binding outer (type Nested) (call $empty (types Queue)))
      (binding outer (type Nested) (call $push (types Queue) (local inner) (local outer)))
      (binding observed (type I64) (borrow-call (call $front (types Queue) (local outer))
        (binding inner (type Queue)) (in (call fifo-test-front (local inner)))))
      (in (sequence (call $discard (types Queue) (local outer)) (local observed)))))
    (expected (i64 0)))
  (test create fifo-discard-populated (in $core) (visibility private)
    (actual (let (binding q (type Queue) (call fifo-test-three)) (in (call $discard (types ByteBuffer) (local q)))))
    (expected (unit)))
  (test create fifo-discards-nested-populated (in $core) (visibility private)
    (actual (let (binding inner (type Queue) (call fifo-test-three))
      (binding outer (type Nested) (call $empty (types Queue)))
      (binding outer (type Nested) (call $push (types Queue) (local inner) (local outer)))
      (in (call $discard (types Queue) (local outer)))))
    (expected (unit))))
declarations.end

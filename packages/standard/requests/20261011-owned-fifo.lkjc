    (body (unpack-owned
      (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T)))) (local queue)
      (field incoming (binding incoming (type (owned-sequence T))))
      (field outgoing (binding outgoing (type (owned-sequence T))))
      (in (let (binding popped
        (type (owned-choice (case empty (owned-sequence T))
          (case item (owned-product (field rest (owned-sequence T)) (field value T)))))
        (sequence-pop (type (owned-sequence T)) (local outgoing)))
        (in (match-owned
          (type (owned-choice (case empty (owned-sequence T))
            (case item (owned-product (field rest (owned-sequence T)) (field value T))))) (local popped)
          (case empty (binding outgoing (type (owned-sequence T)))
            (in (if (call $less (i64 0) (sequence-length (type (owned-sequence T)) (local incoming)))
              (let (binding ready
                (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                (call fifo-reverse (types T) (local incoming) (local outgoing)))
                (in (call fifo-pop (types T) (local ready))))
              (let (binding rest
                (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                (pack-owned
                  (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                  (field incoming (local incoming)) (field outgoing (local outgoing))))
                (in (choose-owned (type (owned-choice
                  (case empty (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                  (case item (owned-product
                    (field rest (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                    (field value T))))) (case empty) (local rest)))))))
          (case item (binding item (type (owned-product (field rest (owned-sequence T)) (field value T))))
            (in (unpack-owned (type (owned-product (field rest (owned-sequence T)) (field value T))) (local item)
              (field rest (binding outgoing (type (owned-sequence T)))) (field value (binding value (type T)))
              (in (let
                (binding rest
                  (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                  (pack-owned
                    (type (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                    (field incoming (local incoming)) (field outgoing (local outgoing))))
                (binding result (type (owned-product
                  (field rest (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                  (field value T)))
                  (pack-owned (type (owned-product
                    (field rest (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                    (field value T))) (field rest (local rest)) (field value (local value))))
                (in (choose-owned (type (owned-choice
                  (case empty (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                  (case item (owned-product
                    (field rest (owned-product (field incoming (owned-sequence T)) (field outgoing (owned-sequence T))))
                    (field value T))))) (case item) (local result))))))))))))))))

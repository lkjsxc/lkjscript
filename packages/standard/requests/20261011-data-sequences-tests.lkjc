request base=rev_d6b47613b78562f3bbd2f7dbfddc34689105fe655d9ba7609bab270809c2a879 idempotency=standard-data-sequence-tests
reference.owner as=$core package=local class=module name=core
reference.owner as=$empty package=local class=declaration parent=$core name=data-sequence-empty
reference.owner as=$length package=local class=declaration parent=$core name=data-sequence-length
reference.owner as=$push package=local class=declaration parent=$core name=data-sequence-push
reference.owner as=$pop package=local class=declaration parent=$core name=data-sequence-pop
reference.owner as=$get package=local class=declaration parent=$core name=data-sequence-get
reference.owner as=$replace package=local class=declaration parent=$core name=data-sequence-replace
reference.owner as=$discard package=local class=declaration parent=$core name=data-sequence-discard
reference.owner as=$owned-replace package=local class=declaration parent=$core name=sequence-replace
reference.owner as=$buffer-empty package=local class=declaration parent=$core name=buffer-empty
reference.owner as=$buffer-push package=local class=declaration parent=$core name=buffer-push
reference.owner as=$buffer-get package=local class=declaration parent=$core name=buffer-get
reference.owner as=$buffer-freeze package=local class=declaration parent=$core name=buffer-freeze
reference.owner as=$bytes-from-list package=local class=declaration parent=$core name=bytes-from-list
declarations.begin
(units
  (type-alias DataInts (owned-sequence I64))
  (type-alias DataIntItem (owned-product (field rest DataInts) (field value I64)))
  (type-alias DataIntPop (owned-choice (case empty DataInts) (case item DataIntItem)))
  (type-alias DataFlags (owned-sequence Bool))
  (type-alias DataFlagItem (owned-product (field rest DataFlags) (field value Bool)))
  (type-alias DataRow (record (label Text) (values (list I64))))
  (type-alias DataRows (owned-sequence DataRow))
  (type-alias DataRowItem (owned-product (field rest DataRows) (field value DataRow)))
  (type-alias DataRowPop (owned-choice (case empty DataRows) (case item DataRowItem)))
  (type-alias DataBuffers (owned-sequence ByteBuffer))
  (type-alias DataBufferItem (owned-product (field rest DataBuffers) (field value ByteBuffer)))
  (function create data-sequence-test-three (in $core) (visibility private) (effect pure)
    (returns DataInts)
    (body (let
      (binding items (type DataInts) (call $empty (types I64)))
      (binding items (type DataInts) (call $push (types I64) (i64 7) (local items)))
      (binding items (type DataInts) (call $push (types I64) (i64 11) (local items)))
      (in (call $push (types I64) (i64 19) (local items))))))
  (function create data-sequence-test-old-row (in $core) (visibility private) (effect pure)
    (returns DataRow)
    (body (record structural (field label (text "old")) (field values (list I64 (i64 2) (i64 3))))))
  (function create data-sequence-test-new-row (in $core) (visibility private) (effect pure)
    (returns DataRow)
    (body (record structural (field label (text "new")) (field values (list I64 (i64 5) (i64 8))))))
  (test create data-sequence-empty-length (in $core) (visibility private)
    (actual (let (binding items (type DataInts) (call $empty (types I64)))
      (in (call $length (types I64) (local items)))))
    (expected (i64 0)))
  (test create data-sequence-empty-pop-reuse (in $core) (visibility private)
    (actual (let
      (binding items (type DataInts) (call $empty (types I64)))
      (binding popped (type DataIntPop) (call $pop (types I64) (local items)))
      (in (match-owned (type DataIntPop) (local popped)
        (case empty (binding rest (type DataInts))
          (in (let (binding items (type DataInts) (call $push (types I64) (i64 23) (local rest)))
            (in (record structural (field length (call $length (types I64) (local items)))
              (field value (call $get (types I64) (i64 0) (local items))))))))
        (case item (binding item (type DataIntItem))
          (in (record structural (field length (i64 -1)) (field value (i64 -1)))))))))
    (expected (record structural (field length (i64 1)) (field value (i64 23)))))
  (test create data-sequence-repeat-get (in $core) (visibility private)
    (actual (let (binding items (type DataInts) (call data-sequence-test-three))
      (in (list I64 (call $get (types I64) (i64 1) (local items))
        (call $get (types I64) (i64 0) (local items))
        (call $get (types I64) (i64 1) (local items))))))
    (expected (list I64 (i64 11) (i64 7) (i64 11))))
  (test create data-sequence-replace-returns-displaced (in $core) (visibility private)
    (actual (let
      (binding items (type DataInts) (call data-sequence-test-three))
      (binding saved (type I64) (call $get (types I64) (i64 1) (local items)))
      (binding replaced (type DataIntItem) (call $replace (types I64) (i64 1) (i64 31) (local items)))
      (in (unpack-owned (type DataIntItem) (local replaced)
        (field rest (binding rest (type DataInts))) (field value (binding old (type I64)))
        (in (list I64 (local saved) (local old) (call $length (types I64) (local rest))
          (call $get (types I64) (i64 0) (local rest))
          (call $get (types I64) (i64 1) (local rest))
          (call $get (types I64) (i64 2) (local rest))))))))
    (expected (list I64 (i64 11) (i64 11) (i64 3) (i64 7) (i64 31) (i64 19))))
  (test create data-sequence-extreme-scalars (in $core) (visibility private)
    (actual (let
      (binding items (type DataInts) (call $empty (types I64)))
      (binding items (type DataInts) (call $push (types I64) (i64 -9223372036854775808) (local items)))
      (binding items (type DataInts) (call $push (types I64) (i64 9223372036854775807) (local items)))
      (binding replaced (type DataIntItem) (call $replace (types I64) (i64 0) (i64 0) (local items)))
      (in (unpack-owned (type DataIntItem) (local replaced)
        (field rest (binding rest (type DataInts))) (field value (binding old (type I64)))
        (in (list I64 (local old) (call $get (types I64) (i64 0) (local rest))
          (call $get (types I64) (i64 1) (local rest))))))))
    (expected (list I64 (i64 -9223372036854775808) (i64 0) (i64 9223372036854775807))))
  (test create data-sequence-flag-replacement (in $core) (visibility private)
    (actual (let
      (binding items (type DataFlags) (call $empty (types Bool)))
      (binding items (type DataFlags) (call $push (types Bool) (bool false) (local items)))
      (binding replaced (type DataFlagItem) (call $replace (types Bool) (i64 0) (bool true) (local items)))
      (in (unpack-owned (type DataFlagItem) (local replaced)
        (field rest (binding rest (type DataFlags))) (field value (binding old (type Bool)))
        (in (record structural (field previous (local old))
          (field current (call $get (types Bool) (i64 0) (local rest)))))))))
    (expected (record structural (field previous (bool false)) (field current (bool true)))))
  (test create data-sequence-aggregate-snapshot-survives-replace-and-discard (in $core) (visibility private)
    (actual (let
      (binding items (type DataRows) (call $empty (types DataRow)))
      (binding items (type DataRows) (call $push (types DataRow) (call data-sequence-test-old-row) (local items)))
      (binding saved (type DataRow) (call $get (types DataRow) (i64 0) (local items)))
      (binding replaced (type DataRowItem)
        (call $replace (types DataRow) (i64 0) (call data-sequence-test-new-row) (local items)))
      (in (unpack-owned (type DataRowItem) (local replaced)
        (field rest (binding rest (type DataRows))) (field value (binding old (type DataRow)))
        (in (let (binding current (type DataRow) (call $get (types DataRow) (i64 0) (local rest)))
          (in (sequence (call $discard (types DataRow) (local rest))
            (record structural (field saved (local saved)) (field displaced (local old))
              (field current (local current)))))))))))
    (expected (record structural (field saved (call data-sequence-test-old-row))
      (field displaced (call data-sequence-test-old-row)) (field current (call data-sequence-test-new-row)))))
  (test create data-sequence-aggregate-pop-retains-snapshot (in $core) (visibility private)
    (actual (let
      (binding items (type DataRows) (call $empty (types DataRow)))
      (binding items (type DataRows) (call $push (types DataRow) (call data-sequence-test-old-row) (local items)))
      (binding saved (type DataRow) (call $get (types DataRow) (i64 0) (local items)))
      (binding popped (type DataRowPop) (call $pop (types DataRow) (local items)))
      (in (match-owned (type DataRowPop) (local popped)
        (case empty (binding rest (type DataRows)) (in (list DataRow)))
        (case item (binding item (type DataRowItem))
          (in (unpack-owned (type DataRowItem) (local item)
            (field rest (binding rest (type DataRows))) (field value (binding value (type DataRow)))
            (in (sequence (call $discard (types DataRow) (local rest))
              (list DataRow (local saved) (local value)))))))))))
    (expected (list DataRow (call data-sequence-test-old-row) (call data-sequence-test-old-row))))
  (test create data-sequence-discard-populated (in $core) (visibility private)
    (actual (let (binding items (type DataInts) (call data-sequence-test-three))
      (in (call $discard (types I64) (local items)))))
    (expected (unit)))
  (test create sequence-indexed-replace-returns-owned-payload (in $core) (visibility private)
    (actual (let
      (binding items (type DataBuffers) (sequence-empty (type DataBuffers)))
      (binding original (type ByteBuffer) (call $buffer-empty))
      (binding original (type ByteBuffer) (call $buffer-push (i64 7) (local original)))
      (binding items (type DataBuffers) (sequence-push (type DataBuffers) (local original) (local items)))
      (binding replacement (type ByteBuffer) (call $buffer-empty))
      (binding replacement (type ByteBuffer) (call $buffer-push (i64 31) (local replacement)))
      (binding replaced (type DataBufferItem)
        (call $owned-replace (types ByteBuffer) (i64 0) (local replacement) (local items)))
      (in (unpack-owned (type DataBufferItem) (local replaced)
        (field rest (binding rest (type DataBuffers))) (field value (binding old (type ByteBuffer)))
        (in (record structural (field displaced (call $buffer-freeze (local old)))
          (field current (borrow-owned-item (type DataBuffers) (local rest) (index (i64 0))
            (binding view (type ByteBuffer)) (in (call $buffer-get (i64 0) (local view)))))))))))
    (expected (record structural (field displaced (call $bytes-from-list (list I64 (i64 7))))
      (field current (i64 31))))))
declarations.end

pub fn sources(shard: usize, workers: usize) -> (usize, Vec<String>) {
    let mut errors = Vec::new();
    let count = source_cases::run(shard, workers, &mut errors);
    (count, errors)
}
pub fn core() -> usize {
    let mut count = units::run();
    count += diagnostic_contracts::run();
    count += function_owners::run();
    count += library_demand::run();
    count += reference_capture::run();
    count += source_contracts::run();
    count += return_contracts::run();
    count += array_repeat::run();
    count += scalar_clone::run();
    count += interpreter_contracts::run();
    count += entry_grants::run();
    count += allocator::run();
    count += resolver::run();
    count += reuse::run();
    count += ir_binary_admission::run();
    count += recheck::run();
    crate::interpreter::assert_reference_reuse();
    count += 1;
    count
}
pub fn closed() -> (usize, Vec<String>) {
    let (count, errors) = sources(0usize, 1usize);
    (count + core(), errors)
}
pub fn live(world: &mut World, trace: bool) -> usize {
    allocator::observe(world) + optimizer::run(world, trace) + panic_messages::run(world, trace)
}

fn source_case(
//! Source-reference recording is optional work, never a change to checked IR.
use crate::{ast, check, elaborate, interpreter, ir, ir_binary, resolve, source};
use crate::elaborate::semantic::{Evidence, LocalTarget, MethodTarget};

fn resolved(user: &str, library: &str) -> ast::Program {
    let parsed = source::parse_bundle(&source::SourceBundle {
        root: "case/main.lkj".to_string(),
        library: Some("dependencies/library.lkj".to_string()),
        files: vec![
            source::SourceInput {
                path: "case/main.lkj".to_string(),
                text: user.to_string(),
            },
            source::SourceInput {
                path: "dependencies/library.lkj".to_string(),
                text: library.to_string(),
            },
        ],
    }).unwrap();
    resolve::resolve(&parsed).unwrap()
}

fn local_source() -> &'static str {
    "struct Pair { left:i64, right:i64 }
     fn pick(value:i64) -> i64 {
         let value=value+1i64;
         let pair=Pair { left:value, right:2i64 };
         let projected=pair.left;
         let Pair { left, right }=pair;
         let (left,right)=(left,right);
         let inner={ let left=3i64; left+right };
         left+inner+projected-projected
     }
     fn main() -> i64 { pick(36i64) }"
}

fn generic_library() -> &'static str {
    "pub trait Read { fn read(&self) -> i64; }
     pub fn choose<T:Read>(value:T) -> i64 {
         let call=|| value.read();
         call()
     }
     pub fn unused() -> i64 { let value=9i64; value }"
}

fn generic_user() -> &'static str {
    "struct Token;
     impl Token { fn read(&self) -> i64 { 7 } }
     impl std::Read for Token { fn read(&self) -> i64 { 42 } }
     fn main() -> i64 { std::choose(Token) }"
}

fn checked(
    program: &ast::Program,
    all_library: bool,
    capture_references: bool,
) -> Result<ir::CheckedProgram, Vec<ast::Diagnostic>> {
    let definitions = elaborate::infer_resolved_report_with_capture(
        program, all_library, capture_references,
    )?;
    check::check_all(elaborate::lower_definitions(definitions)?)
}

fn same_checked(program: &ast::Program, all_library: bool) -> ir::CheckedProgram {
    let off = checked(program, all_library, false).unwrap();
    let on = checked(program, all_library, true).unwrap();
    assert_eq!(
        ir_binary::write(off.program()),
        ir_binary::write(on.program()),
        "reference recording changed independently checked IR"
    );
    on
}

fn value_is_42(checked: &ir::CheckedProgram) {
    let program = checked.program();
    let entry = program.functions.iter()
        .position(|function| function.name == "main").unwrap();
    let result = interpreter::run(program, entry, &[0u64; 0], &mut Vec::<u8>::new())
        .unwrap_or_else(|error| panic!("{}: {}", error.code(), error.message));
    match result.value {
        interpreter::Scalar::Int { value, .. } => assert_eq!(value, 42u64),
        _ => panic!("expected integer result"),
    }
}

fn locals_shadowing_and_destructuring_preserve_ir() {
    let program = resolved(
        local_source(),
        "pub fn unused() -> i64 { let value=9i64; value }",

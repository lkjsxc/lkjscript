//! Native semantic gate over the compiler's actual source modules.
pub mod ast;
pub mod backend;
pub mod child_image;
pub mod check;
pub mod diagnostic;
pub mod diagnostics;
pub mod elaborate;
pub mod embedded;
pub mod entry_grants;
pub(crate) mod facts;
pub mod frontend;
pub mod generics;
pub mod interpreter;
pub mod ir;
pub mod ir_text;
pub mod ir_binary;
pub mod json;
pub mod names;
pub mod native;
pub mod optimizer;
pub mod resolve;
pub mod reuse;
pub mod runtime;
pub mod runtime_memory;
pub mod runtime_diagnostics;
pub use std::sha256;
mod semantic_tests;
pub mod source;
pub mod syntax;
pub mod x86;

pub fn main(mut world: World) {
    let args = world.args();
    if !args.is_empty() && args[0].as_slice() == b"closed-report" {
        let (count, errors) = semantic_tests::closed();
        for error in &errors { world.stderr().write(format!("{error}\n").as_bytes()); }
        if !errors.is_empty() { world.set_exit_status(1u8); }
        world.stderr().write(format!("closed semantics {count} contracts, {} failures\n", errors.len()).as_bytes());
        return;
    }
    let count = semantic_tests::live(&mut world, !args.is_empty());
    assert_eq!(count, 25usize);
    world.stdout().write(format!("ok live semantics {count} native-observation contracts\n").as_bytes());
}

fn closed_sources(shard: usize) {
    let (count, errors) = semantic_tests::sources(shard, 4usize);
    assert!(errors.is_empty());
    assert_eq!(count, 134usize);
}
pub fn closed_core() { assert_eq!(semantic_tests::core(), 185usize); }
pub fn closed_source_0() { closed_sources(0usize); }
pub fn closed_source_1() { closed_sources(1usize); }
pub fn closed_source_2() { closed_sources(2usize); }
pub fn closed_source_3() { closed_sources(3usize); }
//! Source/IR contracts; these helpers use the production compiler modules.
mod allocator;
mod array_repeat;
mod diagnostic_contracts;
mod entry_grants;
mod function_owners;
mod interpreter_contracts;
mod library_demand;
mod optimizer;
mod panic_messages;
mod resolver;

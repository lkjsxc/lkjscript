fn edit(world: &mut World, request: &Request, stats: &mut Stats) -> Result<u8, String> {
    if !request.request.is_empty() && !request.against.is_empty() {
        return Err("E_USAGE edit accepts either --request or --against, not both".to_string());
    }
    if request.recover && (!request.request.is_empty() || !request.against.is_empty()) {
        return Err("E_USAGE --recover does not accept a new transaction".to_string());
    }
    if request.options.path.starts_with('/') {
        return Err("E_EDIT_ROOT use a relative source path with --source-dir PROJECT_ROOT".to_string());
    }
    let scope = request.options.source_directory.as_ref().map_or(".", |value| value.as_str());
    let mut writer = if request.dry {
        if request.recover { return Err("E_USAGE --recover cannot be combined with --dry-run".to_string()); }
        None
    } else {
        let key = request.options.store_key.as_ref().ok_or("E_EDIT_KEY apply/recovery requires --store-key PRIVATE_KEY outside source roots")?;
        Some(structure_write::Writer::open(world, scope, key)?)
    };
    if let Some(writer) = writer.as_mut() {
        let count = writer.recover()?;
        if request.recover {
            world.stdout().write(format!("transaction recovered-files={count}\n").as_bytes());
            return Ok(0u8);
        }
    }
    if request.request.is_empty() && request.against.is_empty() {
        return Err("E_USAGE edit requires --request JSON_FILE or --against DESIRED_SOURCE".to_string());
    }
    let mut operations = if request.against.is_empty() {
        structure_edit::parse(&super::read_path(world, &request.request)?)?
    } else { structure_edit::Request { snapshot: String::new(), operations: Vec::new() } };
    let mut desired_identity = String::new();
    let mut desired_read: Option<Memo> = None;
    let mut items_only = true;
    let mut preserving: Vec<structure_edit::Operation> = Vec::new();
    for operation in &operations.operations {
        if !matches!(operation.kind.as_str(), "replace-body" | "replace-item" | "add-item" | "remove-item") { items_only = false; }
        if matches!(operation.kind.as_str(), "rename" | "move") { preserving.push(operation.clone()); }
    }
    let mut active_options = request.options.clone();
    let mut before = Memo::new(world, &active_options);
    before.catalog_items_only = items_only;
    before.capture_catalog = true;
    if let Some(writer) = writer.as_ref() { before.private_source_digest = Some(writer.private_source_digest()); }
    let mut old = super::compile(world, &active_options, stats, &mut before)?;

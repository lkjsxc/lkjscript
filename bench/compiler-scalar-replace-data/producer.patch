index 000000000..75c6adc9b
--- /dev/null
+++ b/src/semantic_tests/optimizer/scalar.lkj
@@ -0,0 +1,188 @@
+//! Observe the original interpreter, then independently admitted field IR and
+//! native execution. Cleanup order and complete private trap records are values.
+use super::*;
+
+fn native_observation(
+    world: &mut World, program: &reuse::Checked, runtime: &runtime::Runtime,
+) -> (u8, Vec<u8>, Vec<u8>) {
+    let entry = index(program.program(), "probe");
+    let grants = if program.program().functions[entry].params == 1usize {
+        vec![ir::EntryGrant::World]
+    } else { Vec::new() };
+    let image = native::encode_granted(program.checked(), runtime, entry, &grants, Some(3), None).unwrap();
+    let mut executable = world.temporary_file().unwrap();
+    executable.write_all(&image.bytes).unwrap();
+    executable.set_executable().unwrap();
+    let input = world.temporary_file().unwrap();
+    let mut output = world.temporary_file().unwrap();
+    let errors = world.temporary_file().unwrap();
+    let mut result = world.temporary_file().unwrap();
+    let mut process = world.process();
+    let arguments: Vec<Vec<u8>> = Vec::new();
+    let mut child = process.spawn_file(&executable, &arguments, &input, &output, &errors, &result).unwrap();
+    let status = child.wait().unwrap() as u8;
+    output.rewind().unwrap();
+    result.rewind().unwrap();
+    (status, output.read_to_end().unwrap(), result.read_to_end().unwrap())
+}
+
+fn selected(text: &str, inline: bool) -> (reuse::Checked, reuse::Checked) {
+    let original = compiled(text);
+    let before = ir_text::write(original.program());
+    let inlined = if inline { optimizer::inline(original.program(), 64usize).program } else { None };
+    let input = match &inlined { Some(program) => program, None => original.program() };
+    let rewrite = optimizer::scalar::replace(input);
+    assert!(rewrite.aggregates > 0usize, "scalar fixture was not transformed");
+    assert_eq!(before, ir_text::write(original.program()));
+    let candidate = admitted(rewrite.program.unwrap()).unwrap();
+    (original, candidate)
+}
+fn observe(
+    world: &mut World, runtime: &runtime::Runtime, text: &str,
+    expected_value: i64, expected_output: &[u8], trap: bool, inline: bool,
+) {
+    let (original, candidate) = selected(text, inline);
+    let mut output: Vec<u8> = Vec::new();
+    let model = interpreter::run(original.program(), index(original.program(), "probe"), &[0u64;0], &mut output);
+    assert_eq!(output.as_slice(), expected_output);
+    let expected_diagnostic = match model {
+        Ok(result) => {
+            assert!(!trap);
+            assert!(matches!(result.value, interpreter::Scalar::Int { value, .. } if value as i64 == expected_value));
+            String::new()
+        }
+        Err(error) => {
+            assert!(trap);
+            assert!(matches!(error.kind, interpreter::ErrorKind::Trap(_)));
+            crate::runtime_diagnostics::located(&original.program().sources[error.file], error.line, &error.code(), &error.message)
+        }
+    };
+    let before = native_observation(world, &original, runtime);
+    let after = native_observation(world, &candidate, runtime);
+    assert_eq!(before, after, "field rewrite changed complete native observation");
+    assert_eq!(after.1.as_slice(), expected_output);
+    if trap {
+        assert_eq!(after.0, 1u8);
+        let diagnostic = crate::runtime_diagnostics::decode("scalar.lkj", candidate.program(), runtime, &after.2).unwrap().1;
+        assert_eq!(diagnostic, expected_diagnostic);
+    } else {
+        assert_eq!(after.0, 0u8);
+        assert_eq!(after.2.len(), 8usize);
+        let mut bits = 0u64;
+        for at in 0usize..8usize { bits |= (after.2[at] as u64) << (at * 8usize); }
+        assert_eq!(bits as i64, expected_value);
+    }
+}
+
+fn affine_partial_cleanup_and_loops(world: &mut World, runtime: &runtime::Runtime) {
+    observe(world, runtime, r#"
+        struct Mark { output: Stdout, tag: u8 }
+        impl Drop for Mark { fn drop(&mut self) { self.output.write(&[self.tag]); } }
+        struct Bundle { first: Mark, number: i64, last: Mark }
+        pub fn probe(mut world: World) -> i64 {
+            let mut result = 0i64;
+            for turn in 0usize..2usize {
+                let bundle = Bundle {
+                    first: Mark { output: world.stdout(), tag: b'A' },
+                    number: 21i64,
+                    last: Mark { output: world.stdout(), tag: b'B' },
+                };
+                if turn == 0usize { let first = bundle.first; drop(first); }
+                world.stdout().write(b"x");
+                result += bundle.number;
+            }
+            result
+        }
+    "#, 42i64, b"AxBxAB", false, false);
+}
+fn whole_escapes_keep_snapshot_values(world: &mut World, runtime: &runtime::Runtime) {
+    let source = r#"
+        struct Pair { left: i64, right: Box<i64> }
+        fn make(value: i64) -> Pair { Pair { left: value, right: Box::new(value) } }
+        fn total(pair: Pair) -> i64 { pair.left + *pair.right }
+        pub fn probe() -> i64 {
+            let mut pair = make(20i64);
+            let saved = pair.left;
+            pair.left = 22i64;
+            assert_eq!(saved, 20i64);
+            total(pair)
+        }
+    "#;
+    observe(world, runtime, source, 42i64, b"", false, false);
+    observe(world, runtime, source, 42i64, b"", false, true);
+}
+fn projected_loans_and_returned_view_origins(world: &mut World, runtime: &runtime::Runtime) {
+    observe(world, runtime, r#"
+        struct Pair { left: i64, right: i64 }
+        struct View<'a> { first: &'a i64, checked: i64 }
+        fn view<'a>(value: &'a i64) -> View<'a> {
+            let result = View { first: value, checked: 1i64 };
+            assert_eq!(result.checked, 1i64);
+            result
+        }
+        fn increment(value: &mut i64) { *value += 1i64; }
+        pub fn probe() -> i64 {
+            let mut pair = Pair { left: 20i64, right: 21i64 };
+            { let first = &mut pair.left; increment(first); }
+            let result = view(&pair.right);
+            pair.left + *result.first
+        }
+    "#, 42i64, b"", false, false);
+}
+fn copied_fields_are_snapshots_before_mutation(world: &mut World, runtime: &runtime::Runtime) {
+    observe(world, runtime, r#"
+        #[derive(Clone, Copy)]
+        struct Pair { values: [i64; 2], tag: i64 }
+        pub fn probe() -> i64 {
+            let mut original = Pair { values: [20i64, 22i64], tag: 7i64 };
+            let saved = original;
+            original.values[0usize] = 99i64;
+            original.tag = 8i64;
+            assert_eq!(saved.tag, 7i64);
+            saved.values[0usize] + saved.values[1usize]
+        }
+    "#, 42i64, b"", false, false);
+}
+fn traps_preserve_source_message_and_private_record(world: &mut World, runtime: &runtime::Runtime) {
+    observe(world, runtime, r#"
+        struct Holder { values: [i64; 2], wanted: usize }
+        pub fn probe() -> i64 {
+            let value = Holder { values: [20i64, 22i64], wanted: 2usize };
+            value.values[value.wanted]
+        }
+    "#, 0i64, b"", true, false);
+    observe(world, runtime, r#"
+        struct Holder { value: i64, message: i64 }
+        pub fn probe() -> i64 {
+            let value = Holder { value: 42i64, message: 1i64 };
+            assert_eq!(value.message, 1i64);
+            if value.value == 42i64 { panic!("field replacement preserves this message"); }
+            0i64
+        }
+    "#, 0i64, b"", true, false);
+}
+fn custom_destructor_roots_stay_whole(world: &mut World, runtime: &runtime::Runtime) {
+    observe(world, runtime, r#"
+        struct Owner { output: Stdout, tag: u8 }
+        impl Drop for Owner { fn drop(&mut self) { self.output.write(&[self.tag]); } }
+        struct Plain { value: i64, other: i64 }
+        pub fn probe(mut world: World) -> i64 {
+            let mut owner = Owner { output: world.stdout(), tag: b'A' };
+            owner.tag = b'B';
+            let plain = Plain { value: 40i64, other: 2i64 };
+            let result = plain.value + plain.other;
+            drop(owner);
+            result
+        }
+    "#, 42i64, b"B", false, false);
+}
+
+pub fn run(world: &mut World, runtime: &runtime::Runtime) -> usize {
+    affine_partial_cleanup_and_loops(world, runtime);
+    whole_escapes_keep_snapshot_values(world, runtime);
+    projected_loans_and_returned_view_origins(world, runtime);
+    copied_fields_are_snapshots_before_mutation(world, runtime);
+    traps_preserve_source_message_and_private_record(world, runtime);
+    custom_destructor_roots_stay_whole(world, runtime);
+    6usize
+}

+++ b/src/optimizer/scalar.lkj
@@ -0,0 +1,298 @@
+//! Untrusted field decomposition. Function signatures, type declarations and
+//! destructor definitions are unchanged; the driver must recheck the result.
+use crate::ir::{self, Function, Instruction, Local, Op, Place, Program, Projection, TypeKind};
+
+pub struct Rewrite {
+    pub program: Option<Program>,
+    pub aggregates: usize,
+    pub functions: usize,
+}
+
+fn observe(place: &Place, address: bool, needed: &mut [bool], blocked: &mut [bool]) {
+    if place.projections.is_empty() {
+        if address { blocked[place.local] = true; }
+    } else if matches!(place.projections.first(), Some(Projection::Field(_))) {
+        needed[place.local] = true;
+    }
+}
+fn family(function: &Function, custom: &[bool], program: &Program) -> Vec<bool> {
+    let count = function.locals.len();
+    let mut eligible = vec![false; count];
+    for index in function.params..count {
+        let ty = function.locals[index].ty;
+        if let TypeKind::Struct { fields, .. } = &program.types[ty].kind {
+            eligible[index] = !fields.is_empty() && !custom[ty];
+        }
+    }
+    let mut needed = vec![false; count];
+    let mut blocked = vec![false; count];
+    for instruction in &function.body {
+        match &instruction.op {
+            Op::Borrow { place, .. } | Op::SliceBorrow { place, .. }
+                | Op::ViewRange { place, .. } => observe(place, true, &mut needed, &mut blocked),
+            Op::Read { dst, place, .. } => {
+                observe(place, false, &mut needed, &mut blocked);
+                if *dst == place.local { blocked[*dst] = true; }
+            }
+            Op::Assign { place, src } => {
+                observe(place, false, &mut needed, &mut blocked);
+                if *src == place.local { blocked[*src] = true; }
+            }
+            Op::Drop { place } | Op::DropIf { place } | Op::TagTest { place, .. } =>
+                observe(place, false, &mut needed, &mut blocked),
+            _ => {}
+        }
+    }
+    for index in 0usize..count { eligible[index] &= !blocked[index]; }
+    let mut edges: Vec<Vec<usize>> = vec![Vec::new(); count];
+    for instruction in &function.body {
+        let transfer = match &instruction.op {
+            Op::Read { dst, place, .. } if place.projections.is_empty() => Some((*dst, place.local)),
+            Op::Assign { place, src } if place.projections.is_empty() => Some((place.local, *src)),
+            _ => None,
+        };
+        if let Some((left, right)) = transfer {
+            if eligible[left] && eligible[right] {
+                edges[left].push(right);
+                edges[right].push(left);
+            }
+        }
+    }
+    let mut pending = Vec::new();
+    for index in 0usize..count { if eligible[index] && needed[index] { pending.push(index); } }
+    while let Some(index) = pending.pop() {
+        for next in &edges[index] {
+            if !needed[*next] { needed[*next] = true; pending.push(*next); }
+        }
+    }
+    for index in 0usize..count { eligible[index] &= needed[index]; }
+    eligible
+}
+
+struct Builder<'a> {
+    original: &'a Function,
+    fields: Vec<Vec<usize>>,
+    output: Function,
+}
+impl Builder<'_> {
+    fn expanded(&self, local: usize) -> bool {
+        local < self.fields.len() && !self.fields[local].is_empty()
+    }
+    fn emit(&mut self, site: &Instruction, op: Op) {
+        self.output.body.push(Instruction {
+            op, file: site.file, line: site.line, column: site.column,
+        });
+    }
+    fn temporary(&mut self, ty: usize) -> usize {
+        let index = self.output.locals.len();
+        self.output.locals.push(Local { name: format!("$scalar:{index}"), ty, mutable: true });
+        index
+    }
+    fn place(&self, original: &Place) -> Place {
+        if self.expanded(original.local) {
+            if let Some(Projection::Field(index)) = original.projections.first() {
+                return Place {
+                    local: self.fields[original.local][*index],
+                    projections: original.projections[1usize..].to_vec(),
+                };
+            }
+        }
+        original.clone()
+    }
+    fn field(&self, original: &Place, index: usize) -> Place {
+        let mut place = original.clone();
+        place.projections.push(Projection::Field(index));
+        self.place(&place)
+    }
+    fn materialize(&mut self, local: usize, site: &Instruction) -> usize {
+        if !self.expanded(local) { return local; }
+        let ty = self.original.locals[local].ty;
+        let destination = self.temporary(ty);
+        let fields = self.fields[local].clone();
+        self.emit(site, Op::Struct { dst: destination, fields });
+        destination
+    }
+    fn arguments(&mut self, args: &[usize], site: &Instruction) -> Vec<usize> {
+        let mut result = Vec::new();
+        for arg in args {
+            let value = self.materialize(*arg, site);
+            result.push(value);
+        }
+        result
+    }
+    fn read(&mut self, dst: usize, place: &Place, moving: bool, site: &Instruction) {
+        if self.expanded(dst) {
+            let fields = self.fields[dst].clone();
+            for (index, destination) in fields.iter().enumerate() {
+                let source = self.field(place, index);
+                self.emit(site, Op::Read { dst: *destination, place: source, moving });
+            }
+            if moving && !(place.projections.is_empty() && self.expanded(place.local)) {
+                let place = self.place(place);
+                // Retire the now-empty aggregate shell after all fields moved.
+                self.emit(site, Op::DropIf { place });
+            }
+        } else if place.projections.is_empty() && self.expanded(place.local) {
+            let sources = self.fields[place.local].clone();
+            let mut fields = Vec::new();
+            for source in sources {
+                let ty = self.output.locals[source].ty;
+                let destination = self.temporary(ty);
+                self.emit(site, Op::Read { dst: destination, place: Place::local(source), moving });
+                fields.push(destination);
+            }
+            self.emit(site, Op::Struct { dst, fields });
+        } else {
+            let place = self.place(place);
+            self.emit(site, Op::Read { dst, place, moving });
+        }
+    }
+    fn assign(&mut self, place: &Place, src: usize, site: &Instruction) {
+        if place.projections.is_empty() && self.expanded(place.local) {
+            let destinations = self.fields[place.local].clone();
+            if self.expanded(src) {
+                let sources = self.fields[src].clone();
+                for index in 0usize..destinations.len() {
+                    self.emit(site, Op::Assign { place: Place::local(destinations[index]), src: sources[index] });
+                }
+            } else {
+                for (index, destination) in destinations.iter().enumerate() {
+                    let ty = self.output.locals[*destination].ty;
+                    let value = self.temporary(ty);
+                    let source = self.field(&Place::local(src), index);
+                    self.emit(site, Op::Read { dst: value, place: source, moving: true });
+                    self.emit(site, Op::Assign { place: Place::local(*destination), src: value });
+                }
+                self.emit(site, Op::DropIf { place: Place::local(src) });
+            }
+        } else {
+            let src = self.materialize(src, site);
+            let place = self.place(place);
+            self.emit(site, Op::Assign { place, src });
+        }
+    }
+    fn construct(&mut self, dst: usize, args: &[usize], site: &Instruction) {
+        let fields = self.arguments(args, site);
+        if self.expanded(dst) {
+            let destinations = self.fields[dst].clone();
+            for index in 0usize..destinations.len() {
+                self.emit(site, Op::Assign { place: Place::local(destinations[index]), src: fields[index] });
+            }
+        } else {
+            self.emit(site, Op::Struct { dst, fields });
+        }
+    }
+    fn cleanup(&mut self, original: &Place, conditional: bool, site: &Instruction) {
+        if original.projections.is_empty() && self.expanded(original.local) {
+            // A structural drop skips already moved fields, in declaration
+            // order. Each field retains its own independent initialization.
+            let fields = self.fields[original.local].clone();
+            for field in fields { self.emit(site, Op::DropIf { place: Place::local(field) }); }
+        } else {
+            let place = self.place(original);
+            self.emit(site, if conditional { Op::DropIf { place } } else { Op::Drop { place } });
+        }
+    }
+    fn instruction(&mut self, site: &Instruction) {
+        match &site.op {
+            Op::Read { dst, place, moving } => self.read(*dst, place, *moving, site),
+            Op::Assign { place, src } => self.assign(place, *src, site),
+            Op::Struct { dst, fields } => self.construct(*dst, fields, site),
+            Op::Drop { place } => self.cleanup(place, false, site),
+            Op::DropIf { place } => self.cleanup(place, true, site),
+            Op::Borrow { dst, place, mutable } => {
+                let place = self.place(place);
+                self.emit(site, Op::Borrow { dst: *dst, place, mutable: *mutable });
+            }
+            Op::SliceBorrow { dst, place, mutable } => {
+                let place = self.place(place);
+                self.emit(site, Op::SliceBorrow { dst: *dst, place, mutable: *mutable });
+            }
+            Op::ViewRange { dst, place, start, end, inclusive, mutable } => {
+                let place = self.place(place);
+                self.emit(site, Op::ViewRange { dst: *dst, place, start: *start, end: *end, inclusive: *inclusive, mutable: *mutable });
+            }
+            Op::TagTest { dst, place, variant } => {
+                let place = self.place(place);
+                self.emit(site, Op::TagTest { dst: *dst, place, variant: *variant });
+            }
+            Op::Call { dst, function, args } => {
+                let args = self.arguments(args, site);
+                let ty = self.original.locals[*dst].ty;
+                let destination = if self.expanded(*dst) { self.temporary(ty) } else { *dst };
+                self.emit(site, Op::Call { dst: destination, function: *function, args });
+                if destination != *dst { self.read(*dst, &Place::local(destination), true, site); }
+            }
+            Op::Intrinsic { dst, name, args } => {
+                let args = self.arguments(args, site);
+                let ty = self.original.locals[*dst].ty;
+                let destination = if self.expanded(*dst) { self.temporary(ty) } else { *dst };
+                self.emit(site, Op::Intrinsic { dst: destination, name: *name, args });
+                if destination != *dst { self.read(*dst, &Place::local(destination), true, site); }
+            }
+            Op::Array { dst, elements } => {
+                let elements = self.arguments(elements, site);
+                self.emit(site, Op::Array { dst: *dst, elements });
+            }
+            Op::Variant { dst, variant, fields } => {
+                let fields = self.arguments(fields, site);
+                self.emit(site, Op::Variant { dst: *dst, variant: *variant, fields });
+            }
+            Op::Return { src } => {
+                let src = self.materialize(*src, site);
+                self.emit(site, Op::Return { src });
+            }
+            // These either have no local operand, or the original checker
+            // requires scalar/enum/reference types, so no selected Struct can
+            // occur. Keep this exhaustive when the IR gains an instruction.
+            Op::Text { .. } | Op::Int { .. } | Op::Float { .. } | Op::Unit { .. }
+                | Op::Unary { .. } | Op::Binary { .. } | Op::Discriminant { .. }
+                | Op::If { .. } | Op::Else | Op::End | Op::Loop
+                | Op::Break | Op::Continue | Op::BreakTo { .. }
+                | Op::ContinueTo { .. } | Op::Trap { .. } => self.emit(site, site.op.clone()),
+        }
+    }
+}
+fn rewrite(function: &Function, selected: &[bool], program: &Program) -> Option<(Function, usize)> {
+    if !selected.iter().any(|value| *value) { return None; }
+    let mut builder = Builder {
+        original: function, fields: vec![Vec::new(); function.locals.len()], output: function.clone(),
+    };
+    builder.output.body.clear();
+    let mut count = 0usize;
+    for index in 0usize..function.locals.len() {
+        if !selected[index] { continue; }
+        let TypeKind::Struct { fields, .. } = &program.types[function.locals[index].ty].kind
+        else { return None; };
+        for (field, definition) in fields.iter().enumerate() {
+            let local = builder.output.locals.len();
+            builder.output.locals.push(Local {
+                name: format!("$scalar:{index}:{field}"),
+                ty: definition.ty, mutable: function.locals[index].mutable,
+            });
+            builder.fields[index].push(local);
+        }
+        // Signature locals are never selected. The unused former root needs
+        // neither aggregate storage nor cleanup; every use is rewritten below.
+        builder.output.locals[index].ty = ir::UNIT;
+        count += 1usize;
+    }
+    for instruction in &function.body { builder.instruction(instruction); }
+    Some((builder.output, count))
+}
+
+pub fn replace(program: &Program) -> Rewrite {
+    let mut result = Rewrite { program: None, aggregates: 0usize, functions: 0usize };
+    let mut custom = vec![false; program.types.len()];
+    for (ty, _) in &program.destructors { custom[*ty] = true; }
+    for (index, function) in program.functions.iter().enumerate() {
+        let selected = family(function, &custom, program);
+        if let Some((function, count)) = rewrite(function, &selected, program) {
+            if result.program.is_none() { result.program = Some(program.clone()); }
+            result.program.as_mut().unwrap().functions[index] = function;
+            result.aggregates += count;
+            result.functions += 1usize;
+        }
+    }
+    result
+}

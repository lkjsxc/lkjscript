"ir::Op"	level=source-claim	fact=text	chunk=0000000000000000 value="#[derive(Clone, PartialEq)]\u000apub enum Op {\u000a    /// Immutable module-long bytes: a UTF-8 str or an exact-length u8 array.\u000a    Text {\u000a        dst: usize,\u000a        bytes: Vec<u8>,\u000a    },\u000a    Int {\u000a        dst: usize,\u000a        value: i64,\u000a    },\u000a    Float {\u000a        dst: usize,\u000a        bits: u64,\u000a    },\u000a    Unit {\u000a        dst: usize,\u000a    },\u000a    Read {\u000a        dst: usize,\u000a        place: Place,\u000a        moving: bool,\u000a    },\u000a    Borrow {\u000a        dst: usize,\u000a        place: Place,\u000a        mutable: bool,\u000a    },\u000a    SliceBorrow {\u000a        dst: usize,\u000a        place: Place,\u000a        mutable: bool,\u000a    },\u000a    /// Borrow a checked subrange without narrowing its static alias footprint.\u000a    /// Bounds are consumed usize values; failure traps with the bounds code.\u000a    ViewRange {\u000a        dst: usize,\u000a        place: Place,\u000a        start: usize,\u000a        end: usize,\u000a        inclusive: bool,\u000a        mutable: bool,\u000a    },\u000a    Array {\u000a        dst: usize,\u000a        elements: Vec<usize>,\u000a    },\u000a    Assign {\u000a        place: Place,\u000a        src: us"
"ir::Op"	level=source-claim	fact=text	chunk=0000000000000001 value="ize,\u000a    },\u000a    Drop {\u000a        place: Place,\u000a    },\u000a    /// Destroy this place only when its own storage is initialized. Every\u000a    /// projected ancestor must still exist; this does not authorize a hole\u000a    /// through a reference or an indexed container.\u000a    DropIf {\u000a        place: Place,\u000a    },\u000a    Unary {\u000a        dst: usize,\u000a        op: UnaryOp,\u000a        src: usize,\u000a    },\u000a    Binary {\u000a        dst: usize,\u000a        op: BinaryOp,\u000a        left: usize,\u000a        right: usize,\u000a    },\u000a    Call {\u000a        dst: usize,\u000a        function: usize,\u000a        args: Vec<usize>,\u000a    },\u000a    Struct {\u000a        dst: usize,\u000a        fields: Vec<usize>,\u000a    },\u000a    Variant {\u000a        dst: usize,\u000a        variant: usize,\u000a        fields: Vec<usize>,\u000a    },\u000a    Discriminant {\u000a        dst: usize,\u000a        src: usize,\u000a    },\u000a    TagTest {\u000a        dst: usize,\u000a        place: Place,\u000a        variant: usize,\u000a    },\u000a    Intrinsic {\u000a        dst: usize,\u000a        name: IntrinsicOp,\u000a        args: Vec<usize>,\u000a    },\u000a    If {\u000a        condition: usize,\u000a    },\u000a"

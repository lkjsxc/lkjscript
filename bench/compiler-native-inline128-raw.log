808e13dfeea120ab8668358cecbcf3f8d33898862ec2b527b83d7a8539939a92  target/compiler-native-inline128-audit.pl
#!/usr/bin/env perl
# Read-only attribution of the reconstructed producer's diagnostic filename pool.
use strict;
use warnings;
use Digest::SHA qw(sha256_hex);
my ($oldmeta_path,$newmeta_path,$oldraw_path,$oldrows_path,$prefix,$fixture)=@ARGV;
defined $fixture or die "expected oldmeta newmeta oldraw oldrows prefix fixture\n";
sub bytes { my ($path)=@_; open my $f,'<:raw',$path or die "$path: $!"; local $/; return <$f>; }
sub metadata { my ($path)=@_; my %m; for(split /\n/,bytes($path)) { my ($k,$v)=split /=/,$_,2; $m{$k}=$v; } return \%m; }
sub word { my ($b,$at)=@_; $at>=0 && $at+8<=length($$b) or die "invalid word offset\n"; return unpack('Q<',substr($$b,$at,8)); }
my $old=metadata($oldmeta_path); my $new=metadata($newmeta_path);
for my $key (qw(revision source_tree library_tree emitter_sha256 emitter_bytes runtime_source_sha256 frozen_optimizer_sha256 source_argument library_selector runtime_selector)) {
    $old->{$key} eq $new->{$key} or die "input metadata differs: $key\n";
}
my $oldroot=$old->{source_root}; my $newroot=$new->{source_root};
(my $oldfixture=$oldroot)=~s{/source$}{};
(my $newfixture=$newroot)=~s{/source$}{};
my $oldraw=bytes($oldraw_path);
my ($oldargs)=$oldraw=~/^\[construct\.inline64\.1\]\n.*?^arguments bytes=\d+\n(.*?)^stdout bytes=/ms;
defined $oldargs or die "old argument block missing\n";
my $newargs=bytes("$prefix.raw/construct.inline64.1.arguments");
my $oldnormalized=$oldargs; $oldnormalized=~s/\Q$oldfixture\E/<FIXTURE>/g;
my $newnormalized=$newargs; $newnormalized=~s/\Q$newfixture\E/<FIXTURE>/g;
$oldnormalized eq $newnormalized or die "normalized construction arguments differ\n";
my $candidateargs=bytes("$prefix.raw/construct.inline128.1.arguments");
$candidateargs=~s/(--inline-limit\n)128\n/$1 . "64\n"/e;
$candidateargs=~s{/producer-128\n$}{/producer-64\n};
$candidateargs eq $newargs or die "current construction paths or flags differ beyond policy/output\n";
my %source;
for (split /\n/,bytes("target/compiler-native-inline128-source-blobs.tsv")) {
    my ($path,$expected,$actual)=split /\t/;
    $expected eq $actual or die "source blob differs\n"; $source{$path}=1;
}
open my $maps,'>',"target/compiler-native-inline128-paths.tsv" or die $!;
print {$maps} "policy\ttable_offset\tfile_offset\tbytes\tpath\n";
my @tables;
for my $policy (64,128) {
    my $path="$fixture/producer-$policy";
    my $b=bytes($path);
    substr($b,0,6) eq "\x7fELF\x02\x01" or die "not little-endian ELF64\n";
    my $phoff=word(\$b,32);
    my $phsize=unpack('v',substr($b,54,2)); my $phcount=unpack('v',substr($b,56,2));
    my $first=index($b,$newroot); $first>=0 or die "missing diagnostic root\n";
    my @segments;
    for my $i (0..$phcount-1) {
        my $at=$phoff+$i*$phsize;
        my ($type,$flags)=unpack('V V',substr($b,$at,8));
        my $offset=word(\$b,$at+8); my $address=word(\$b,$at+16); my $size=word(\$b,$at+32);
        push @segments,[$offset,$address,$size] if $type==1 && $flags==6 && $first>=$offset && $first<$offset+$size;
    }
    @segments==1 or die "diagnostic root has no unique RW segment\n";
    my ($rw,$address,$size)=@{$segments[0]}; my $base=$address-$rw;
    my @matches;
    for my $n (1..int(($first-$rw-8)/16)) {
        my $table=$first-8-$n*16;
        next unless word(\$b,$table)==$n && word(\$b,$table+8)==$base+$first;
        my @paths; my $end=$first; my $valid=1;
        for my $i (0..$n-1) {
            my $pointer=word(\$b,$table+8+$i*16);
            my $length=word(\$b,$table+16+$i*16);
            if ($pointer!=$base+$end || $length>512 || $end+$length>$rw+$size) { $valid=0; last; }
            my $text=substr($b,$end,$length);
            push @paths,[$end,$length,$text]; $end+=$length;
        }
        push @matches,[$table,$end,\@paths] if $valid;
    }
    @matches==1 or die "diagnostic pointer/length table is not unique\n";
    my ($table,$end,$paths)=@{$matches[0]};
    my $rooted=0;
    for my $row (@$paths) {
        my ($offset,$length,$text)=@$row;
        if (index($text,"$newroot/")==0) {
            ++$rooted; my $relative=substr($text,length($newroot)+1);
            $source{$relative} or die "diagnostic filename not in the verified source/library tree: $relative\n";
        }
        print {$maps} join("\t",$policy,$table,$offset,$length,$text),"\n";
    }
    my $occurrences=0; my $at=0;
    while(($at=index($b,$newroot,$at))>=0) { ++$occurrences; $at+=length($newroot); }
    $occurrences==$rooted or die "fixture root also occurs outside the diagnostic table\n";
    push @tables,{policy=>$policy,table=>$table,pool_start=>$first,pool_end=>$end,rows=>scalar(@$paths),rooted=>$rooted,
        rw_offset=>$rw,rw_bytes=>$size,image_bytes=>length($b),image_sha256=>sha256_hex($b),paths=>[map { $_->[2] } @$paths]};
}
close $maps;
join("\0",@{$tables[0]{paths}}) eq join("\0",@{$tables[1]{paths}}) or die "current diagnostic path lists differ\n";
my ($oldsize);
for(split /\n/,bytes($oldrows_path)) { my @f=split /\t/; $oldsize=$f[8] if $f[0] eq 'construct' && $f[1] eq 'inline64'; }
defined $oldsize or die "old producer64 size missing\n";
open my $out,'>',"target/compiler-native-inline128-path-audit.log" or die $!;
print {$out} "metadata_identity_fields_match=true\nnormalized_old_new_producer64_argv_equal=true\ncurrent64_128_argv_differ_only_in_inline_limit_and_output=true\nverified_source_library_files=",scalar(keys %source),"\n";
print {$out} "old_source_root=$oldroot\nnew_source_root=$newroot\nold_root_bytes=",length($oldroot),"\nnew_root_bytes=",length($newroot),"\n";
for my $t (@tables) {
    print {$out} "policy=$t->{policy} image_bytes=$t->{image_bytes} sha256=$t->{image_sha256} rw_offset=$t->{rw_offset} rw_bytes=$t->{rw_bytes} table_offset=$t->{table} pool_start=$t->{pool_start} pool_end=$t->{pool_end} table_rows=$t->{rows} rooted_paths=$t->{rooted}\n";
}
print {$out} "current_diagnostic_path_lists_identical=true\nold_producer64_bytes=$oldsize\nobserved_producer64_byte_delta=",$tables[0]{image_bytes}-$oldsize,"\npath_length_byte_delta=",$tables[0]{rooted}*(length($newroot)-length($oldroot)),"\n";
print {$out} "old_binary_available=false\nold_new_binary_byte_identity_claim=false\nnormalized_constructor_argv:\n$oldnormalized";
close $out;


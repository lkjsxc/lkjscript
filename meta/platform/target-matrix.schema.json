{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lkjscript.target-matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "targets"],
  "properties": {
    "schema": { "const": "lkjscript.target-matrix" },
    "contract": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target", "instruction_set", "operating_system_abi", "status",
          "vm", "native_backend", "node", "evidence"
        ],
        "properties": {
          "target": { "type": "string" },
          "instruction_set": { "type": "string" },
          "operating_system_abi": { "type": "string" },
          "status": {
            "enum": ["accepted", "tested", "builds", "experimental", "unsupported"]
          },
          "vm": { "type": "string" },
          "native_backend": { "type": "string" },
          "node": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lkjscript.unsafe-boundary-registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "boundaries"],
  "properties": {
    "schema": { "const": "lkjscript.unsafe-boundary-registry" },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/boundary" }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "responsibility", "safe_caller_contract", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "responsibility": { "type": "string", "minLength": 1, "maxLength": 256 },
        "safe_caller_contract": { "type": "string", "minLength": 1, "maxLength": 256 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*[.]rs$"
          }
        }
      }
    }
  }
}

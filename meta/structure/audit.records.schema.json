{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lkjscript.structure.audit.records.v1",
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "lines",
        "max_line_scalars",
        "class",
        "capsule"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "max_line_scalars": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "string"
        },
        "capsule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entries",
        "depth"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "files"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "rule",
        "path",
        "observed",
        "limit",
        "message",
        "provenance",
        "sort_key"
      ],
      "properties": {
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "rule": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "observed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort_key": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "class",
        "sha256",
        "generator"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lkjscript.repository-audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "revision",
    "policy_identity",
    "files",
    "directories",
    "classifications",
    "capsules",
    "findings",
    "provenance",
    "unsupported"
  ],
  "properties": {
    "schema": {
      "const": "lkjscript.repository-audit"
    },
    "contract": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "audit.records.schema.json#/$defs/file"
      }
    },
    "directories": {
      "type": "array",
      "items": {
        "$ref": "audit.records.schema.json#/$defs/directory"
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "$ref": "audit.records.schema.json#/$defs/classification"
      }
    },
    "capsules": {
      "type": "array",
      "items": {
        "$ref": "capsule.schema.json"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "audit.records.schema.json#/$defs/finding"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "audit.records.schema.json#/$defs/provenance"
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
